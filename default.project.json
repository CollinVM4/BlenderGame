{
  "name": "BlenderGame",
  "tree": {
    "$className": "DataModel",
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "CustomerNPCs": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "Framewisp_CCVVMF": {
        "$path": "Framewisp_CCWMF.rbxmx"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "AutoJumpEnabled": false
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "Health": {
          "$path": "src/character/Health.server.luau"
        }
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
