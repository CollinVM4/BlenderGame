          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">SmoothiePickupPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local Definitions = require(game:GetService("ReplicatedStorage").Shared.Constants.Ingredients)
local Input = require(script.Parent.InteractionPromptPresentation)
local IngredientPresentation = require(script.Parent.IngredientPickupPromptPresentation)
local Style = require(script.Parent.IngredientPickupPromptStyle)
local Presentation = { Width = 460, Height = 160 }
type Row = { Id: string, Name: string, Rarity: string }

-- Display-only ordered metadata. Never aggregate duplicate ingredients.
function Presentation.Rows(object: Instance): { Row }?
    local rows: { Row } = {}
    for index = 1, 3 do
        local id = object:GetAttribute("IngredientId" .. index)
        local definition = if typeof(id) == "string" then Definitions[id] else nil
        if not definition then
            return nil
        end
        local rarity = Style.Resolve(definition)
        table.insert(rows, { Id = definition.Id, Name = definition.DisplayName or definition.Id, Rarity = rarity })
    end
    return rows
end

function Presentation.Create(
    prompt: ProximityPrompt,
    object: BasePart | Model,
    rows: { Row },
    parent: Instance,
    inputType: Enum.ProximityPromptInputType
): (() -> (), () -> ())
    local anchor = if object:IsA("BasePart")
        then object
        else object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    assert(anchor and anchor:IsA("BasePart"))
    local cleanup, gui = Input.Create(prompt, anchor, parent, inputType, {
        InputOnly = true,
        Width = Presentation.Width,
        Height = Presentation.Height,
        TextSize = Style.InputTextSize,
        MaxDistance = Style.MaxDistance,
    })
    gui.Name = "SmoothiePickupPromptDisplay"
    gui.SizeOffset = Vector2.new(0, 0.5)
    for index = 1, 3 do
        local row = rows[index]
        local palette = (Style.RarityStyles :: any)[row.Rarity]
        local container = Instance.new("Frame")
        container.Name = "IngredientRow" .. index
        container.Position = UDim2.fromOffset(0, (index - 1) * 38)
        container.Size = UDim2.new(1, 0, 0, 36)
        container.BackgroundTransparency = 1
        container.Parent = gui
        for _, column in
            {
                {
                    Name = "Rarity",
                    Text = row.Rarity,
                    X = 0,
                    Width = 170,
                    Color = palette.TextColor,
                    Stroke = palette.StrokeColor,
                    Align = Enum.TextXAlignment.Right,
                },
                {
                    Name = "IngredientName",
                    Text = row.Name,
                    X = 186,
                    Width = Presentation.Width - 186,
                    Color = Style.NameColor,
                    Stroke = Style.StrokeColor,
                    Align = Enum.TextXAlignment.Left,
                },
            }
        do
            local label = Instance.new("TextLabel")
            label.Name, label.Text = column.Name, column.Text
            label.Position = UDim2.fromOffset(column.X, 0)
            label.Size = UDim2.fromOffset(column.Width, 36)
            label.BackgroundTransparency = 1
            label.Font, label.TextSize, label.TextScaled = Style.Font, 25, true
            label.TextColor3, label.TextXAlignment = column.Color, column.Align
            local limit = Instance.new("UITextSizeConstraint")
            limit.MinTextSize, limit.MaxTextSize, limit.Parent = 12, 25, label
            local stroke = Instance.new("UIStroke")
            stroke.Color, stroke.Thickness = column.Stroke, Style.StrokeThickness
            stroke.Transparency, stroke.Parent = Style.TextStrokeTransparency, label
            label.Parent = container
        end
    end
    local action = gui:FindFirstChild("Action") :: TextButton
    action.Position = UDim2.fromOffset(0, 120)
    action.Size = UDim2.new(1, 0, 0, Style.InputHeight)
    local function update()
        gui.StudsOffsetWorldSpace = IngredientPresentation.Top(object) - anchor.Position + Style.PromptStudsOffset
    end
    update()
    return cleanup, update
end
return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">UpgradeDisplay</string>
              <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Upgrades = require(Shared.Constants.Upgrades)
local SprintConfig = require(Shared.Constants.SprintConfig)

local Display = {}
Display.Tracks = {
    { Id = "CarryCapacity", Name = "CARRY CAPACITY", Attribute = "CarryCapacity" },
    { Id = "MovementSpeed", Name = "MOVEMENT SPEED", Attribute = "BaseWalkSpeed" },
    { Id = "SprintStamina", Name = "SPRINT STAMINA", Attribute = "StaminaMax" },
    { Id = "Jump", Name = "JUMP", Attribute = "JumpLevel" },
}
local tiers: { [string]: { { Cost: number, Value: number } } } = {
    CarryCapacity = Upgrades.CarryCapacity,
    MovementSpeed = Upgrades.MovementSpeed,
    SprintStamina = Upgrades.SprintStamina,
    Jump = Upgrades.Jump,
}

function Display.Stat(id: string, value: number): string
    if id == "SprintStamina" then
        return string.format("%.0fs", value / SprintConfig.STAMINA_DRAIN_RATE)
    end
    return tostring(value)
end

function Display.Row(
    id: string,
    level: number?,
    current: number?
): { Level: number, Stat: string, Price: number?, Max: boolean }?
    local track = tiers[id]
    if not track or level == nil or level % 1 ~= 0 or not track[level + 1] then
        return nil
    end
    if id == "Jump" then
        current = track[level + 1].Value
    end
    if current == nil then
        return nil
    end
    local nextTier = track[level + 2]
    return {
        Level = level,
        Stat = Display.Stat(id, current) .. (if nextTier
            then " → " .. Display.Stat(id, nextTier.Value)
            else (if id == "CarryCapacity" then " / 3" else "")),
        Price = if nextTier then nextTier.Cost else nil,
        Max = nextTier == nil,
    }
end

function Display.Feedback(success: boolean, reason: string?): string
    if success then
        return "UPGRADED!"
    elseif reason == "InsufficientCash" then
        return "NOT ENOUGH CASH"
    elseif reason == "MaxLevel" then
        return "MAX"
    elseif reason == "InvalidUpgrade" then
        return "UNAVAILABLE"
    end
    return "PLEASE TRY AGAIN"
end

return Display
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">UpgradesGui</string>
              <string name="Source"><![CDATA[--!strict
local Display = require(script.Parent.UpgradeDisplay)
local Gui = {}
local ink = Color3.fromRGB(245, 248, 255)
local muted = Color3.fromRGB(186, 198, 216)
local accent = Color3.fromRGB(57, 119, 83)

local function round(object: GuiObject)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = object
end

local function label(parent: Instance, name: string, text: string, size: number): TextLabel
    local result = Instance.new("TextLabel")
    result.Name = name
    result.BackgroundTransparency = 1
    result.Size = UDim2.new(1, 0, 0, size + 8)
    result.Font = Enum.Font.GothamBold
    result.TextSize = size
    result.TextColor3 = ink
    result.TextXAlignment = Enum.TextXAlignment.Left
    result.Text = text
    result.Parent = parent
    return result
end

local function button(parent: Instance, name: string, text: string): TextButton
    local result = Instance.new("TextButton")
    result.Name = name
    result.Size = UDim2.new(1, 0, 0, 36)
    result.BackgroundColor3 = accent
    result.Font = Enum.Font.GothamBold
    result.TextColor3 = ink
    result.TextSize = 14
    result.Text = text
    result.AutoButtonColor = true
    round(result)
    result.Parent = parent
    return result
end

local function stack(parent: Instance, padding: number)
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, padding)
    layout.Parent = parent
end

local function pad(parent: Instance, amount: number)
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, amount)
    padding.PaddingBottom = UDim.new(0, amount)
    padding.PaddingLeft = UDim.new(0, amount)
    padding.PaddingRight = UDim.new(0, amount)
    padding.Parent = parent
end

function Gui.Create(playerGui: PlayerGui)
    local screen = Instance.new("ScreenGui")
    screen.Name = "UpgradesGui"
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.DisplayOrder = 10

    local hud = Instance.new("Frame")
    hud.Name = "CashHud"
    hud.AnchorPoint = Vector2.new(1, 0)
    hud.Position = UDim2.new(1, -16, 0, 12)
    hud.Size = UDim2.fromOffset(174, 96)
    hud.BackgroundColor3 = Color3.fromRGB(28, 36, 50)
    round(hud)
    pad(hud, 10)
    stack(hud, 4)
    hud.Parent = screen
    local cash = label(hud, "Cash", "$ —", 24)
    cash.TextScaled = true
    local cashTextBounds = Instance.new("UITextSizeConstraint")
    cashTextBounds.MinTextSize = 12
    cashTextBounds.MaxTextSize = 24
    cashTextBounds.Parent = cash
    cash.LayoutOrder = 1
    local toggle = button(hud, "Toggle", "UPGRADES")
    toggle.LayoutOrder = 2

    local panel = Instance.new("Frame")
    panel.Name = "Panel"
    panel.AnchorPoint = Vector2.new(1, 0)
    panel.Position = UDim2.new(1, -16, 0, 120)
    panel.Size = UDim2.new(1, -32, 1, -136)
    panel.BackgroundColor3 = Color3.fromRGB(28, 36, 50)
    panel.Visible = false
    round(panel)
    local bounds = Instance.new("UISizeConstraint")
    bounds.MaxSize = Vector2.new(352, 490)
    bounds.Parent = panel
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(83, 100, 120)
    stroke.Transparency = 0.4
    stroke.Parent = panel
    pad(panel, 12)
    panel.Parent = screen
    local title = label(panel, "Title", "UPGRADES", 22)
    title.Size = UDim2.new(1, -44, 0, 36)
    local close = button(panel, "Close", "X")
    close.AnchorPoint = Vector2.new(1, 0)
    close.Position = UDim2.fromScale(1, 0)
    close.Size = UDim2.fromOffset(36, 36)

    local list = Instance.new("ScrollingFrame")
    list.Name = "Rows"
    list.Position = UDim2.fromOffset(0, 46)
    list.Size = UDim2.new(1, 0, 1, -46)
    list.BackgroundTransparency = 1
    list.BorderSizePixel = 0
    list.ScrollBarThickness = 4
    list.ScrollingDirection = Enum.ScrollingDirection.Y
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.CanvasSize = UDim2.new()
    stack(list, 10)
    list.Parent = panel
    local rows: { [string]: { Level: TextLabel, Stat: TextLabel, Purchase: TextButton } } = {}
    for index, track in Display.Tracks do
        local row = Instance.new("Frame")
        row.Name = track.Id
        row.LayoutOrder = index
        row.Size = UDim2.new(1, -8, 0, 132)
        row.BackgroundColor3 = Color3.fromRGB(41, 52, 70)
        round(row)
        pad(row, 10)
        stack(row, 2)
        row.Parent = list
        local name = label(row, "Name", track.Name, 15)
        name.LayoutOrder = 1
        local level = label(row, "Level", "Loading…", 12)
        level.TextColor3 = muted
        level.LayoutOrder = 2
        local stat = label(row, "Stat", "—", 18)
        stat.LayoutOrder = 3
        local purchase = button(row, "Purchase", "LOADING…")
        purchase.LayoutOrder = 4
        rows[track.Id] = { Level = level, Stat = stat, Purchase = purchase }
    end
    toggle.Activated:Connect(function()
        panel.Visible = not panel.Visible
    end)
    close.Activated:Connect(function()
        panel.Visible = false
    end)
    screen.Parent = playerGui
    return { Screen = screen, Cash = cash, Rows = rows }
end

return Gui
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">WorldBillboardStyle</string>
              <string name="Source"><![CDATA[--!strict
-- Appearance only. Callers own content, parenting, input, and lifetime.
local Style = {}

export type Settings = {
    Width: number?,
    Height: number?,
    TextSize: number?,
    MaxDistance: number?,
}

function Style.ApplyBillboard(gui: BillboardGui, settings: Settings)
    gui.Size = UDim2.fromOffset(settings.Width or 300, settings.Height or 56)
    gui.AlwaysOnTop = true
    gui.ResetOnSpawn = false
    gui.MaxDistance = settings.MaxDistance or math.huge
end

function Style.ApplyText(object: TextLabel | TextButton, settings: Settings)
    -- Luau cannot assign shared properties through this engine-class union.
    -- Both accepted classes expose every text/GuiObject property used below.
    local text = object :: TextLabel
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.BorderSizePixel = 0
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.TextStrokeTransparency = 0.2
    text.Font = Enum.Font.GothamBold
    text.TextSize = settings.TextSize or 24
    text.TextScaled = false
    text.TextWrapped = true
    text.TextXAlignment = Enum.TextXAlignment.Center
    text.TextYAlignment = Enum.TextYAlignment.Center
end

return Style
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">WorldTextPresentation</string>
              <string name="Source"><![CDATA[--!strict
local Style = require(script.Parent.WorldBillboardStyle)
local Presentation = {}

export type Settings = Style.Settings & {
    Origin: Instance?,
    Text: string?,
    StudsOffset: Vector3?,
}

export type Handle = {
    SetText: (self: Handle, text: string) -> (),
    SetVisible: (self: Handle, visible: boolean) -> (),
    Destroy: (self: Handle) -> (),
}

-- Call from client code. One handle owns one GUI; updates never allocate views.
-- Invalid/missing origins return nil and a reason without creating any instances.
function Presentation.Create(settings: Settings?): (Handle?, string?)
    local origin = if settings then settings.Origin else nil
    if typeof(origin) ~= "Instance" or not origin:IsA("Attachment") then
        return nil, "WorldTextPresentation requires an Attachment Origin"
    end
    if not origin:IsDescendantOf(workspace) then
        return nil, "WorldTextPresentation Origin must be in Workspace"
    end
    local config = settings :: Settings
    local gui = Instance.new("BillboardGui")
    gui.Name = "WorldTextDisplay"
    gui.Adornee = origin
    Style.ApplyBillboard(gui, config)
    gui.StudsOffset = config.StudsOffset or Vector3.zero
    gui.Active = false
    gui.Enabled = true

    local text = Instance.new("TextLabel")
    text.Name = "Text"
    Style.ApplyText(text, config)
    text.Active = false
    text.Selectable = false
    text.Text = config.Text or ""
    text.Parent = gui
    -- Client-created child: no server replication; origin destruction owns cleanup.
    gui.Parent = origin

    local destroyed = false
    local destroying: RBXScriptConnection? = nil
    local function disconnect()
        if destroying then
            destroying:Disconnect()
            destroying = nil
        end
    end
    destroying = gui.Destroying:Connect(function()
        destroyed = true
        disconnect()
    end)
    local handle: Handle = {
        SetText = function(_self: Handle, value: string)
            if not destroyed then
                text.Text = value
            end
        end,
        SetVisible = function(_self: Handle, visible: boolean)
            if not destroyed then
                gui.Enabled = visible
            end
        end,
        Destroy = function(_self: Handle)
            if destroyed then
                return
            end
            destroyed = true
            disconnect()
            gui:Destroy()
        end,
    }
    return handle, nil
end

return Presentation
]]></string>
            </Properties>
          </Item>
