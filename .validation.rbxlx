            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[-- Handles customer speech bubbles for smoothie orders 

]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="629">
            <Properties>
              <string name="Name">UpgradesController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Display = require(script.Parent.Parent.UI.UpgradeDisplay)
local Gui = require(script.Parent.Parent.UI.UpgradesGui)
local MoneyFormat = require(ReplicatedStorage.Shared.MoneyFormat)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
        local view: Gui.View? = nil
        local remote: RemoteEvent? = nil
        local pending: string? = nil
        local generation = 0
        local membershipGeneration = 0
        local membershipUpdating = false
        local feedback: { [string]: string } = {}
        local feedbackVersion: { [string]: number } = {}
        local serverMax: { [string]: boolean } = {}

        local function numberAttribute(name: string): number?
            local value = player:GetAttribute(name)
            return if typeof(value) == "number" then value else nil
        end
        local function rowState(track: { Id: string, Name: string, Attribute: string })
            return if membershipUpdating
                then nil
                else Display.Row(
                    track.Id,
                    numberAttribute(track.Id .. (if track.Id == "CarryCapacity" then "Level" else "PurchasedLevel")),
                    numberAttribute(track.Attribute)
                )
        end
        local function refresh()
            local currentView = view
            if not currentView then
                return
            end
            local cash = numberAttribute("playerCash")
            if currentView.Cash then
                currentView.Cash.Text = if cash then MoneyFormat.Full(cash) else "$\u{2014}"
            end
            for _, track in Display.Tracks do
                local row = currentView.Rows[track.Id]
                if not row then
                    continue
                end
                local state = rowState(track)
                local isMax = serverMax[track.Id] or (state ~= nil and state.Max)
                local enabled = remote ~= nil
                    and pending == nil
                    and state ~= nil
                    and not isMax
                    and feedback[track.Id] ~= "PURCHASED!"
                local affordable = cash ~= nil and state ~= nil and state.Price ~= nil and cash >= state.Price
                -- Keep authored colors, backgrounds, typography and FX. Dim only
                -- price/BUY text, retaining server rejection feedback on activation.
                row.Price.TextTransparency = if state
                        and not isMax
                        and not affordable
                    then math.max(row.PriceTransparency, 0.4)
                    else row.PriceTransparency
                row.BuyLabel.TextTransparency = if enabled and not affordable
                    then math.max(row.BuyTransparency, 0.4)
                    else row.BuyTransparency
                row.Title.Text = track.Name
                row.Current.Text = if state then state.Current else "LOADING..."
                row.Next.Text = if isMax then "MAX" elseif state then state.Next else "-"
                row.Price.Text = if state and state.Price and not isMax then MoneyFormat.Compact(state.Price) else ""
                row.BuyLabel.Text = if remote == nil
                        or state == nil
                        or pending == track.Id
                    then "..."
                    elseif feedback[track.Id] == "PURCHASED!" then "PURCHASED!"
                    elseif isMax then "MAX"
                    elseif feedback[track.Id] then feedback[track.Id]
                    else "BUY"
                row.Purchase.Interactable = enabled
            end
        end
        local function showFeedback(id: string, message: string)
            local version = (feedbackVersion[id] or 0) + 1
            feedbackVersion[id] = version
            feedback[id] = message
            local membershipToken = membershipGeneration
            task.delay(if message == "PURCHASED!" then 0.8 else 1.5, function()
                if membershipGeneration == membershipToken and feedbackVersion[id] == version then
                    feedback[id] = nil
                    refresh()
                end
            end)
        end
        player:GetAttributeChangedSignal("playerCash"):Connect(refresh)
        local function membershipChanged()
            generation += 1
            pending = nil
            membershipGeneration += 1
            local token = membershipGeneration
            membershipUpdating = true
            table.clear(serverMax)
            table.clear(feedback)
            refresh()
            -- Membership identity is published before the upgrade projection.
            task.defer(function()
                if membershipGeneration == token then
                    membershipUpdating = false
                    refresh()
                end
            end)
        end
        player:GetAttributeChangedSignal("PlotSessionId"):Connect(membershipChanged)
        player:GetAttributeChangedSignal("PlotMembershipRevision"):Connect(membershipChanged)
        for _, track in Display.Tracks do
            player
                :GetAttributeChangedSignal(
                    track.Id .. (if track.Id == "CarryCapacity" then "Level" else "PurchasedLevel")
                )
                :Connect(function()
                    serverMax[track.Id] = nil
                    refresh()
                end)
            if track.Attribute ~= track.Id .. (if track.Id == "CarryCapacity" then "Level" else "PurchasedLevel") then
                player:GetAttributeChangedSignal(track.Attribute):Connect(refresh)
            end
        end
        Gui.Observe(playerGui, function(nextView)
            view = nextView
            refresh()
        end, function(id)
            local track
            for _, candidate in Display.Tracks do
                if candidate.Id == id then
                    track = candidate
                    break
                end
            end
            if not track or not view then
                return
            end
            local state = rowState(track)
            local request = remote
            if
                not request
                or pending
                or not state
                or state.Max
                or serverMax[track.Id]
                or feedback[track.Id] == "PURCHASED!"
            then
                return
            end
            feedbackVersion[track.Id] = (feedbackVersion[track.Id] or 0) + 1
            feedback[track.Id] = nil
            pending = track.Id
            generation += 1
            local token = generation
            refresh()
            request:FireServer("PurchaseUpgrade", track.Id, state.Level + 2, {
                PlotSessionId = player:GetAttribute("PlotSessionId"),
                MembershipRevision = player:GetAttribute("PlotMembershipRevision"),
            })
            -- The shared server throttle can drop a request without a response.
            task.delay(5, function()
                if generation == token and pending == track.Id then
                    pending = nil
                    showFeedback(track.Id, "TRY AGAIN")
                    refresh()
                end
            end)
        end)
        refresh()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local request = events:WaitForChild("GameplayRequest")
        assert(request:IsA("RemoteEvent"), "GameplayRequest must be a RemoteEvent")
        request.OnClientEvent:Connect(function(action: any, result: any)
            if action ~= "PurchaseUpgradeResult" or type(result) ~= "table" then
                return
            end
            if
                result.PlotSessionId ~= player:GetAttribute("PlotSessionId")
                or result.MembershipRevision ~= player:GetAttribute("PlotMembershipRevision")
            then
                return
            end
            if result.reason == "InvalidUpgrade" then
                warn("Upgrade purchase rejected: InvalidUpgrade")
            end
            local id = result.upgradeId
            if type(id) ~= "string" or not Display.Row(id, 0) or type(result.success) ~= "boolean" then
                return
            end
            if pending ~= id then
                return
            end
            pending = nil
            generation += 1
            if result.reason == "MaxLevel" then
                serverMax[id] = true
            end
            showFeedback(id, Display.Feedback(result.success, result.reason))
            -- Response levels never replace replicated player state.
            refresh()
        end)
        remote = request
        refresh()
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="630">
            <Properties>
              <string name="Name">WorldTextController</string>
              <string name="Source"><![CDATA[--!strict
local Presentation = require(script.Parent.Parent.UI.WorldTextPresentation)
local Controller = {}
local started = false

type Entry = {
    Connection: RBXScriptConnection?,
    Handle: Presentation.Handle?,
    MaxDistance: number?,
    TextSize: number?,
}

local function positiveNumber(value: any): number?
    return if typeof(value) == "number" and value > 0 and value < math.huge then value else nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local tracked: { [Attachment]: Entry } = {}
    local function clear(entry: Entry)
        local handle = entry.Handle
        entry.Handle = nil
        if handle then
            handle:Destroy()
        end
    end
    local function refresh(origin: Attachment, entry: Entry)
        local text = origin:GetAttribute("WorldText")
        if not origin:IsDescendantOf(workspace) or typeof(text) ~= "string" or text == "" then
            clear(entry)
            return
        end
        local distance = positiveNumber(origin:GetAttribute("WorldTextMaxDistance"))
        local textSize = positiveNumber(origin:GetAttribute("WorldTextTextSize"))
        if entry.MaxDistance ~= distance or entry.TextSize ~= textSize then
            clear(entry)
        end
        entry.MaxDistance, entry.TextSize = distance, textSize
        local handle = entry.Handle
        if not handle then
            local settings: Presentation.Settings = {
                Origin = origin,
                Text = text,
                MaxDistance = distance,
                TextSize = textSize,
            }
            handle = Presentation.Create(settings)
            entry.Handle = handle
        else
            handle:SetText(text)
        end
        if handle then
            handle:SetVisible(origin:GetAttribute("WorldTextVisible") ~= false)
        end
    end
    local function track(object: Instance)
        if not object:IsA("Attachment") or tracked[object] or not object:IsDescendantOf(workspace) then
            return
        end
        local entry: Entry = {}
        tracked[object] = entry
        -- Track bare Attachments too: attributes may replicate or be authored later.
        entry.Connection = object.AttributeChanged:Connect(function(attribute)
            if
                attribute == "WorldText"
                or attribute == "WorldTextVisible"
                or attribute == "WorldTextMaxDistance"
                or attribute == "WorldTextTextSize"
            then
                refresh(object, entry)
            end
        end)
        refresh(object, entry)
    end
    workspace.DescendantAdded:Connect(track)
    workspace.DescendantRemoving:Connect(function(object)
        if not object:IsA("Attachment") then
            return
        end
        local entry = tracked[object]
        if not entry then
            return
        end
        tracked[object] = nil
        if entry.Connection then
            entry.Connection:Disconnect()
        end
        clear(entry)
    end)
    -- Connect first so objects arriving during startup cannot be missed.
    for _, object in workspace:GetDescendants() do
        track(object)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="631">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="632">
            <Properties>
              <string name="Name">FramewispMenus</string>
              <string name="Source"><![CDATA[--!strict
-- Called by FramewispActions through tools/prepare_framewisp_ui.py. Its existing
-- wiring path delegates major menus here; generated action tweens do not compete.
local PanelManager = require(script.Parent.PanelManager)
local Menus = {}
local Registry = require(script.Parent.UIRegistry)
local names = Registry.Panels
local contentOf = Registry.ContentOf
local panelId = Registry.PanelId
local attached: { [Instance]: { Wire: (Instance) -> boolean } } = setmetatable({}, { __mode = "k" }) :: any

function Menus.Attach(gui: Instance, player: Player)
    if attached[gui] then
        return attached[gui]
    end
    local panels: { [Instance]: PanelManager.Handle } = {}
    local wired: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
    local connections: { RBXScriptConnection } = {}
    local buttons: { [Instance]: RBXScriptConnection } = {}
    local stopped = false
    local playerGui = player:FindFirstChild("PlayerGui")

    local function initialize(instance: Instance)
        if stopped then
            return
        end
        local id = panelId(instance)
        if id and not panels[instance] then
            local panel = instance :: GuiObject
            panel.Visible = false
            panels[instance] = PanelManager.Register(id, {
                Open = function()
                    panel.Visible = true
                end,
                Close = function()
                    panel.Visible = false
                end,
            })
        end
    end
    local function wire(button: Instance): boolean
        if stopped then
            -- A retained FramewispActions hook may outlive a detached root.
            -- Explicit reattachment must delegate into the new binding.
            local current = attached[gui]
            return if current then current.Wire(button) else true
        end
        if not button:IsA("GuiButton") then
            return false
        end
        local content = contentOf(button)
        if not content then
            return false
        end
        local close: GuiObject? = nil
        local ancestor = button.Parent
        while ancestor and ancestor ~= content do
            if panelId(ancestor) then
                close = ancestor :: GuiObject
                break
            end
            ancestor = ancestor.Parent
        end
        local action = button:GetAttribute("FigmaAction")
        local param = button:GetAttribute("FigmaActionParam")
        local semantic = button:GetAttribute("BlenderUI")
        local id = if type(semantic) == "string"
            then semantic:match("^Toggle:(%w+)$")
            elseif type(param) == "string" then param:gsub("_panel$", "")
            else button.Name:match("^(%w+)")
        local isClose = close ~= nil
            and (semantic == "Close" or action == "close" or button.Name:match("^Close") ~= nil)
        local navigation = false
        local container = button.Parent
        while container and container ~= content do
            if
                Registry.Matches(container, "LeftMenu", { "LeftMenu" })
                or Registry.Matches(container, "RightMenu", { "RightMenu" })
            then
                navigation = true
                break
            end
            container = container.Parent
        end
        local isMenu = close == nil
            and id ~= nil
            and names[id] == true
            and (navigation or (type(semantic) == "string" and semantic:match("^Toggle:") ~= nil))
        if not isClose and not isMenu then
            return false
        end
        if wired[button] then
            return true
        end
        wired[button] = true
        buttons[button] = button.Activated:Connect(function()
            if not button:IsDescendantOf(gui) then
                return
            end
            if isClose and close then
                local handle = panels[close]
                if handle then
                    handle.Close()
                end
                return
            end
            local selected: GuiObject? = nil
            for _, child in content:GetChildren() do
                if panelId(child) == id then
                    if selected then
                        warn("FramewispMenus: ambiguous panel target " .. tostring(id))
                        return -- Do not guess between duplicate imported panels.
                    end
                    selected = child :: GuiObject
                end
            end
            if not selected then
                warn("FramewispMenus: missing panel target " .. tostring(id))
            end
            if selected then
                local handle = panels[selected]
                if handle then
                    handle.Toggle()
                end
            end
        end)
        return true
    end
    local function added(instance: Instance)
        if stopped then
            return
        end
        initialize(instance)
        wire(instance)
        -- Also handles a complete subtree inserted in one operation.
        for _, descendant in instance:GetDescendants() do
            initialize(descendant)
            wire(descendant)
        end
    end
    table.insert(connections, gui.DescendantAdded:Connect(added))
    table.insert(
        connections,
        gui.DescendantRemoving:Connect(function(instance)
            for panel, handle in panels do
                if panel == instance or panel:IsDescendantOf(instance) then
                    handle.Destroy()
                    panels[panel] = nil
                end
            end
            for button, connection in buttons do
                if button == instance or button:IsDescendantOf(instance) then
                    connection:Disconnect()
                    buttons[button] = nil
                    wired[button] = nil
                end
            end
        end)
    )
    for _, descendant in gui:GetDescendants() do
        initialize(descendant)
    end
    for _, descendant in gui:GetDescendants() do
        wire(descendant)
    end
    table.insert(
        connections,
        player.CharacterAdded:Connect(function()
            for _, handle in panels do
                handle.Close()
            end
        end)
    )
    local function stop()
        if stopped then
            return
        end
        stopped = true
        for _, handle in panels do
            handle.Destroy()
        end
        table.clear(panels)
        for _, connection in buttons do
            connection:Disconnect()
        end
        table.clear(buttons)
        table.clear(wired)
        for _, connection in connections do
            connection:Disconnect()
        end
        table.clear(connections)
        attached[gui] = nil
    end
    table.insert(connections, gui.Destroying:Connect(stop))
    table.insert(
        connections,
        gui.AncestryChanged:Connect(function(_, parent)
            if parent == nil or (playerGui and not gui:IsDescendantOf(playerGui)) then
                stop()
            end
        end)
    )
    local binding = { Wire = wire }
    attached[gui] = binding
    return binding
end

return Menus
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="633">
            <Properties>
              <string name="Name">IngredientPickupPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local InputPresentation = require(script.Parent.InteractionPromptPresentation)
local Style = require(script.Parent.IngredientPickupPromptStyle)
local Shared = game:GetService("ReplicatedStorage").Shared
local Ingredients = require(Shared.Constants.Ingredients)
local MoneyFormat = require(Shared.MoneyFormat)
local IngredientName = require(Shared.IngredientName)
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local Presentation = {}

-- Rotated-part extents keep the label above the actual visible geometry,
-- excluding the invisible pivot root created for multipart ingredients.
function Presentation.Bounds(object: BasePart | Model): (Vector3, Vector3)
    local minimum = Vector3.new(math.huge, math.huge, math.huge)
    local maximum = Vector3.new(-math.huge, -math.huge, -math.huge)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    local found = false
    for _, part in parts do
        if part:IsA("BasePart") and part.Transparency < 1 then
            local cf, half = part.CFrame, part.Size / 2
            local extent = cf.RightVector:Abs() * half.X + cf.UpVector:Abs() * half.Y + cf.LookVector:Abs() * half.Z
            minimum = minimum:Min(part.Position - extent)
            maximum = maximum:Max(part.Position + extent)
            found = true
        end
    end
    if not found then
        minimum = object:GetPivot().Position
        maximum = minimum
    end
    return minimum, maximum
end

function Presentation.Top(object: BasePart | Model): Vector3
    local minimum, maximum = Presentation.Bounds(object)
    return Vector3.new((minimum.X + maximum.X) / 2, maximum.Y, (minimum.Z + maximum.Z) / 2)
end

function Presentation.MobilePosition(minimum: Vector3, maximum: Vector3): Vector3
    local center = (minimum + maximum) / 2
    local height = maximum.Y - minimum.Y
    local clearance = math.min(Style.MobileGroundClearance, height / 2)
    return Vector3.new(
        center.X,
        math.max(
            minimum.Y + clearance,
            center.Y - math.min(height * Style.MobileLowerFraction, Style.MobileMaxLowerStuds)
        ),
        center.Z
    )
end

function Presentation.Create(
    prompt: ProximityPrompt,
    object: BasePart | Model,
    definition: Ingredients.IngredientDefinition,
    parent: Instance,
    inputType: Enum.ProximityPromptInputType
): (() -> (), () -> ())
    local mobile = inputType == Enum.ProximityPromptInputType.Touch
    local inputY = Style.TitleHeight + Style.NameHeight + Style.ValueHeight + 2 * Style.RowSpacing + Style.InputSpacing
    local inputCenter = inputY + Style.InputHeight / 2
    local canvasHeight = if mobile then Style.MobileCanvasHeight else Style.BillboardSize.Y
    local rarity, name = Style.Resolve(definition)
    local palette = (Style.RarityStyles :: any)[rarity]
    local anchor = if object:IsA("BasePart")
        then object
        else object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    assert(anchor and anchor:IsA("BasePart"), "Ingredient presentation requires a physical part")
    -- Reuse the existing keyboard/gamepad/touch and hold lifecycle implementation.
    local cleanup, gui = InputPresentation.Create(prompt, anchor, parent, inputType, {
        InputOnly = true,
        Width = Style.BillboardSize.X,
        Height = canvasHeight,
        Available = function()
            local owner = object:GetAttribute("OwnerUserId")
            return object:IsDescendantOf(workspace)
                and CollectionService:HasTag(object, "IngredientWorldItem")
                and object:GetAttribute("IngredientId") == definition.Id
                and (typeof(owner) ~= "number" or owner == 0 or owner == Players.LocalPlayer.UserId)
        end,
        TouchWidth = if mobile then Style.MobileTouchSize else nil,
        TouchHeight = if mobile then Style.MobileTouchSize else nil,
        TouchCenterY = if mobile then inputCenter else nil,
        TextSize = Style.InputTextSize,
        MaxDistance = Style.MaxDistance,
    })
    gui.Name = "IngredientPickupPromptDisplay"
    gui.SizeOffset = Vector2.new(0, if mobile then (inputCenter - canvasHeight / 2) / canvasHeight else 0.5)
    local function formatText(
        text: TextLabel | TextButton,
        y: number,
        height: number,
        size: number,
        color: Color3,
        strokeColor: Color3
    )
        local label = text :: TextLabel
        label.Position = UDim2.fromOffset(0, y)
        label.Size = UDim2.new(1, 0, 0, height)
        label.BackgroundTransparency = 1
        label.Font = Style.Font
        label.TextSize = size
        label.TextColor3 = color
        label.TextStrokeTransparency = 1
        label.TextScaled = true
        local limit = Instance.new("UITextSizeConstraint")
        limit.MinTextSize = 12
        limit.MaxTextSize = size
        limit.Parent = label
        local stroke = Instance.new("UIStroke")
        stroke.Color = strokeColor
        stroke.Thickness = Style.StrokeThickness
        stroke.Transparency = Style.TextStrokeTransparency
        stroke.Parent = label
    end
    local title = Instance.new("TextLabel")
    title.Name = "Rarity"
    title.RichText = true
    local function rarityText(): string
        local ripe = object:GetAttribute("IsRipe") == true
        local stateColor = if ripe then "#FFDE73" else "#D2D6D5"
        return string.upper(rarity)
            .. ' <font color="#D2D6D5">•</font> <font color="'
            .. stateColor
            .. '">'
            .. (if ripe then "Ripe" else "Unripe")
            .. "</font>"
    end
    title.Text = rarityText()
    formatText(title, 0, Style.TitleHeight, Style.TitleTextSize, palette.TextColor, palette.StrokeColor)
    title.Parent = gui
    local label = Instance.new("TextLabel")
    label.Name, label.Text = "IngredientName", name
    local nameY = Style.TitleHeight + Style.RowSpacing
    formatText(label, nameY, Style.NameHeight, Style.NameTextSize, Style.NameColor, Style.StrokeColor)
    label.Parent = gui
    local value = Instance.new("TextLabel")
    value.Name, value.Text =
        "IngredientValue",
        MoneyFormat.Compact((object:GetAttribute("EffectiveIngredientValue") :: number?) or definition.Value)
    local valueY = nameY + Style.NameHeight + Style.RowSpacing
    formatText(value, valueY, Style.ValueHeight, Style.ValueTextSize, Style.ValueColor, Style.StrokeColor)
    value.Parent = gui
    local input = gui:FindFirstChild("Action") :: TextLabel
    formatText(
        input,
        valueY + Style.ValueHeight + Style.InputSpacing,
        Style.InputHeight,
        Style.InputTextSize,
        palette.TextColor,
        palette.StrokeColor
    )
    local function update()
        if definition.Id == "PlayerHead" then
            label.Text = IngredientName.Resolve(
                definition.Id,
                name,
                object:GetAttribute("SourceUserId"),
                object:GetAttribute("SourceDisplayName")
            )
        end
        title.Text = rarityText()
        value.Text =
            MoneyFormat.Compact((object:GetAttribute("EffectiveIngredientValue") :: number?) or definition.Value)
        if mobile then
            local minimum, maximum = Presentation.Bounds(object)
            local position = Presentation.MobilePosition(minimum, maximum)
            gui.StudsOffsetWorldSpace = position - anchor.Position
            -- Keep the visible row above the ingredient's bottom/contact plane even
            -- when a tiny ingredient or a steep camera angle compresses its height.
            local lift = 0
            local camera = workspace.CurrentCamera
            if camera then
                local point, visible = camera:WorldToViewportPoint(position)
                local bottom = camera:WorldToViewportPoint(Vector3.new(position.X, minimum.Y, position.Z))
                if visible and bottom.Z > 0 then
                    lift = math.max(0, point.Y + Style.InputHeight / 2 + 2 - bottom.Y)
                end
            end
            gui.SizeOffset = Vector2.new(0, (inputCenter - canvasHeight / 2 + lift) / canvasHeight)
        else
            gui.StudsOffsetWorldSpace = Presentation.Top(object) - anchor.Position + Style.PromptStudsOffset
        end
    end
    update()
    return cleanup, update
end

return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="634">
            <Properties>
              <string name="Name">IngredientPickupPromptStyle</string>
              <string name="Source"><![CDATA[--!strict
-- All ingredient pickup appearance tuning lives here; no gameplay effects.
local Style = {
    RarityStyles = {
        Common = { TextColor = Color3.fromRGB(240, 240, 235), StrokeColor = Color3.fromRGB(20, 20, 24) },
        Uncommon = { TextColor = Color3.fromRGB(135, 245, 145), StrokeColor = Color3.fromRGB(15, 35, 22) },
        Rare = { TextColor = Color3.fromRGB(255, 212, 85), StrokeColor = Color3.fromRGB(45, 28, 12) },
        Mystery = { TextColor = Color3.fromRGB(225, 155, 255), StrokeColor = Color3.fromRGB(37, 13, 55) },
    },
    TitleTextSize = 23,
    NameTextSize = 29,
    ValueTextSize = 23,
    InputTextSize = 21,
    TitleHeight = 28,
    NameHeight = 38,
    ValueHeight = 28,
    InputHeight = 34,
    RowSpacing = 2,
    InputSpacing = 6,
    BillboardSize = Vector2.new(320, 142),
    PromptStudsOffset = Vector3.new(0, 0.35, 0),
    MobileTouchSize = 80,
    MobileCanvasHeight = 184,
    MobileLowerFraction = 0.30,
    MobileMaxLowerStuds = 2.5,
    MobileGroundClearance = 0.15,
    -- Camera-distance cull only; Roblox still owns prompt activation range.
    MaxDistance = math.huge,
    HideMysteryNames = true,
    Font = Enum.Font.GothamBold,
    NameColor = Color3.fromRGB(255, 250, 235),
    ValueColor = Color3.fromRGB(100, 235, 120),
    StrokeColor = Color3.fromRGB(16, 16, 20),
    TextStrokeTransparency = 0.05,
    StrokeThickness = 2,
}

function Style.Resolve(definition: { Id: string, DisplayName: string?, Rarity: string? }): (string, string)
    local rarity = definition.Rarity or "Common"
    if not (Style.RarityStyles :: any)[rarity] then
        rarity = "Common"
    end
    local name = definition.DisplayName or definition.Id
    if rarity == "Mystery" and Style.HideMysteryNames then
        name = "???"
    end
    return rarity, name
end

return Style
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="635">
            <Properties>
              <string name="Name">InteractionPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")
local Style = require(script.Parent.WorldBillboardStyle)
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local TouchTargets = require(script.Parent.MobilePromptTouchTargets)
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local Presentation = {}

export type Settings = {
    ActionText: string?,
    KeyText: string?,
    MaxDistance: number?,
    Width: number?,
    Height: number?,
    TextSize: number?,
    InputOnly: boolean?,
    CustomerAction: string?,
    TouchWidth: number?,
    TouchHeight: number?,
    TouchCenterY: number?,
    Available: (() -> boolean)?,
}

-- One visible view; the caller owns PromptShown/PromptHidden and calls cleanup.
function Presentation.Create(
    prompt: ProximityPrompt,
    origin: Attachment | BasePart | Model,
    parent: Instance,
    inputType: Enum.ProximityPromptInputType,
    settings: Settings?
): (() -> (), BillboardGui)
    local config: Settings = settings or {}
    local stashPrompt = prompt:GetAttribute("PlayerStashPrompt") == true
    local gui = Instance.new("BillboardGui")
    gui.Name = "InteractionPromptDisplay"
    gui.Adornee = origin
    Style.ApplyBillboard(gui, config)
    gui.Active = true

    -- A transparent button preserves touch/click input through the prompt's API.
    local paddedTouch = inputType == Enum.ProximityPromptInputType.Touch and config.TouchWidth ~= nil
    local inputButton = if paddedTouch then nil else Instance.new("TextButton")
    local text = (inputButton or Instance.new("TextLabel")) :: TextLabel
    text.Name = "Action"
    if paddedTouch then
        text.Active = false
    end
    Style.ApplyText(text, config)
    if origin.Name == "DispenserTextOrigin" or stashPrompt or prompt:GetAttribute("JackedNoobPrompt") == true then
        TextStyle.Apply(text, config.TextSize or 24)
    end
    if config.CustomerAction and not stashPrompt then
        -- Shared input behavior, with a compact customer-only visual treatment.
        local billboard = gui :: BillboardGui
        billboard.Size = UDim2.fromOffset(220, 44)
        billboard.StudsOffset = Vector3.zero
        billboard.SizeOffset = Vector2.new(0, -(22 + 12) / 44) -- Top edge 12px below the shared rig anchor.
        if config.CustomerAction == "Serve" and origin:IsA("Attachment") then
            local root = origin.Parent
            if root and root:IsA("BasePart") then
                -- Center at the waist, scaled with the rig, without moving the shared anchor.
                billboard.StudsOffsetWorldSpace = Vector3.new(0, root.Size.Y * 0.25 - origin.Position.Y, 0)
                billboard.SizeOffset = Vector2.new(0, 0)
            end
        end
        text.Font = TextStyle.Font
        text.TextSize = 21
        text.TextColor3 = if config.CustomerAction == "TakeOrder" then TextStyle.Gold else Color3.fromRGB(120, 235, 255)
        TextStyle.Outline(text)
    end
    if inputButton then
        inputButton.AutoButtonColor = false
    end
    text.Parent = gui
    gui.Parent = parent

    local connections: { RBXScriptConnection } = {}
    local holding = false
    local function refresh()
        local key = config.KeyText
        if not key then
            if inputType == Enum.ProximityPromptInputType.Touch then
                key = "TAP"
            elseif inputType == Enum.ProximityPromptInputType.Gamepad then
                key = prompt.GamepadKeyCode.Name
            else
                key = UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
                if key == "" then
                    key = prompt.KeyboardKeyCode.Name
                end
            end
        end
        text.Text = string.format(
            "[%s] %s%s",
            key or "",
            if holding then "HOLD " else "",
            config.ActionText or prompt.ActionText
        )
        if config.InputOnly then
            text.Text = string.format("%s[%s]", if holding then "HOLD " else "", key or "")
        end
    end
    for _, property in { "ActionText", "KeyboardKeyCode", "GamepadKeyCode" } do
        table.insert(connections, prompt:GetPropertyChangedSignal(property):Connect(refresh))
    end
    table.insert(
        connections,
        prompt.PromptButtonHoldBegan:Connect(function()
            holding = true
            refresh()
        end)
    )
    table.insert(
        connections,
        prompt.PromptButtonHoldEnded:Connect(function()
            holding = false
            refresh()
        end)
    )
    local activeInput: InputObject? = nil
    local alive = true
    local function release()
        if activeInput then
            activeInput = nil
            if paddedTouch then
                text.TextTransparency = 0
            end
            if prompt.Parent then
                prompt:InputHoldEnd()
            end
        end
    end
    local function begin(input: InputObject)
        local reason: string? = nil
        if not alive then
            reason = "hidden view"
        elseif activeInput then
            reason = "prompt already held by another finger"
        elseif not prompt.Enabled then
            reason = "disabled prompt"
        elseif not prompt:IsDescendantOf(workspace) then
            reason = "invalid source: prompt outside Workspace"
        elseif config.Available and not config.Available() then
            reason = "invalid source: ingredient registration, identity or ownership changed"
        end
        if reason then
            if paddedTouch then
                Debug.Log(prompt, "REJECTED", reason)
            end
            return
        end
        activeInput = input
        -- Immediate, display-only feedback. Inventory still waits for the server.
        if paddedTouch then
            text.TextTransparency = 0.25
        end
        if paddedTouch then
            Debug.Log(prompt, "HOLD BEGIN", "client HoldDuration=" .. tostring(prompt.HoldDuration))
        end
        prompt:InputHoldBegin()
    end
    local unregister: (() -> ())? = nil
    if paddedTouch then
        local target = Instance.new("TextButton")
        target.Name = "TouchTarget"
        target.Text = ""
        target.BackgroundTransparency = 1
        target.AutoButtonColor = false
        target.Active = true
        target.Selectable = false
        target.ZIndex = text.ZIndex + 1
        target.AnchorPoint = Vector2.new(0.5, 0.5)
        target.Position = UDim2.new(0.5, 0, 0, config.TouchCenterY or (config.Height or 56) / 2)
        target.Size = UDim2.fromOffset(assert(config.TouchWidth), config.TouchHeight or 80)
        target.Parent = gui
        unregister = TouchTargets.Register(prompt, gui, target, begin, config.Available)
    else
        table.insert(
            connections,
            text.InputBegan:Connect(function(input)
                local touch = input.UserInputType == Enum.UserInputType.Touch
                local click = input.UserInputType == Enum.UserInputType.MouseButton1 and prompt.ClickablePrompt
                if touch or click then
                    begin(input)
                end
            end)
        )
    end
    table.insert(
        connections,
        UserInputService.InputEnded:Connect(function(input)
            if input == activeInput then
                release()
            end
        end)
    )
    if paddedTouch then
        table.insert(
            connections,
            UserInputService.InputChanged:Connect(function(input)
                if input == activeInput and input.UserInputState == Enum.UserInputState.Cancel then
                    release()
                end
            end)
        )
        table.insert(
            connections,
            prompt.Triggered:Connect(function()
                Debug.Log(prompt, "TRIGGERED", "client native event; server dispatch is logged separately")
            end)
        )
    end
    table.insert(connections, UserInputService.WindowFocusReleased:Connect(release))
    refresh()
    return function()
        alive = false
        if unregister then
            unregister()
        end
        for _, connection in connections do
            connection:Disconnect()
        end
        release()
        gui:Destroy()
    end,
        gui
end

return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="636">
            <Properties>
              <string name="Name">MobileControlLayout</string>
              <string name="Source"><![CDATA[--!strict
-- Presentation only: CAS still owns the buttons and all action input.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Layout = {}
local OFFSETS = { SprintHeld = Vector2.new(-1.25, 0), ThrowHeld = Vector2.new(-0.95, -0.95) }
local ACTIONS = { "SprintHeld", "ThrowHeld" }
local PADDING = 8
local GAP = 2
local registered: { [string]: boolean } = {}
local connections: { RBXScriptConnection } = {}
local guiConnections: { RBXScriptConnection } = {}
local observed: { [Instance]: { RBXScriptConnection } } = {}
local playerGui: PlayerGui? = nil
local started = false
local queued = false
local generation = 0

local function disconnect(list: { RBXScriptConnection })
    for _, connection in list do
        connection:Disconnect()
    end
    table.clear(list)
end

-- Clamp the entire square hit target, then choose the closest unoccupied position.
-- Obstacle edges provide candidates when clamping would overlap Jump or the other action.
local function place(preferred: Vector2, size: number, bounds: Rect, obstacles: { Rect }): Vector2?
    local half = size / 2
    local low = bounds.Min + Vector2.new(half + PADDING, half + PADDING)
    local high = bounds.Max - Vector2.new(half + PADDING, half + PADDING)
    if low.X > high.X or low.Y > high.Y then
        return nil
    end
    local xs = { math.clamp(preferred.X, low.X, high.X), low.X, high.X }
    local ys = { math.clamp(preferred.Y, low.Y, high.Y), low.Y, high.Y }
    for _, obstacle in obstacles do
        table.insert(xs, math.clamp(obstacle.Min.X - half - GAP, low.X, high.X))
        table.insert(xs, math.clamp(obstacle.Max.X + half + GAP, low.X, high.X))
        table.insert(ys, math.clamp(obstacle.Min.Y - half - GAP, low.Y, high.Y))
        table.insert(ys, math.clamp(obstacle.Max.Y + half + GAP, low.Y, high.Y))
    end
    local best: Vector2? = nil
    local distance = math.huge
    for _, x in xs do
        for _, y in ys do
            local clear = true
            for _, obstacle in obstacles do
                if
                    x + half + GAP > obstacle.Min.X
                    and x - half - GAP < obstacle.Max.X
                    and y + half + GAP > obstacle.Min.Y
                    and y - half - GAP < obstacle.Max.Y
                then
                    clear = false
                    break
                end
            end
            local delta = Vector2.new(x, y) - preferred
            local cost = delta:Dot(delta)
            if clear and cost < distance then
                best, distance = Vector2.new(x, y), cost
            end
        end
    end
    return best
end

local function visible(object: Instance, root: PlayerGui): boolean
    local ancestor: Instance? = object
    while ancestor and ancestor ~= root do
        if ancestor:IsA("GuiObject") and not ancestor.Visible then
            return false
        end
        if ancestor:IsA("ScreenGui") and not ancestor.Enabled then
            return false
        end
        ancestor = ancestor.Parent
    end
    return ancestor == root
end

local update: () -> ()
local function schedule()
    if queued or not started then
        return
    end
    queued = true
    local version = generation
    task.defer(function()
        if version ~= generation then
            return
        end
        queued = false
        update()
    end)
end

local function watch(wanted: { [Instance]: boolean }, object: Instance, properties: { string })
    wanted[object] = true
    if observed[object] then
        return
    end
    local list = { object.AncestryChanged:Connect(schedule) }
    for _, property in properties do
        table.insert(list, object:GetPropertyChangedSignal(property):Connect(schedule))
    end
    observed[object] = list
end

local function watchAncestors(wanted: { [Instance]: boolean }, object: Instance, root: PlayerGui)
    local ancestor = object.Parent
    while ancestor and ancestor ~= root do
        if ancestor:IsA("GuiObject") then
            watch(wanted, ancestor, { "AbsolutePosition", "AbsoluteSize", "Visible" })
        elseif ancestor:IsA("ScreenGui") then
            watch(wanted, ancestor, { "Enabled", "ScreenInsets", "IgnoreGuiInset" })
        end
        ancestor = ancestor.Parent
    end
end

local function clearUnused(wanted: { [Instance]: boolean })
    for object, list in observed do
        if not wanted[object] then
            disconnect(list)
            observed[object] = nil
        end
    end
end

local function relevant(object: Instance)
    -- Only a name hint for native discovery; no WaitForChild chain or CoreGui access.
    if object:IsA("GuiButton") or object:IsA("ScreenGui") or object.Name == "ContextButtonFrame" then
        schedule()
    end
end

update = function()
    local player = Players.LocalPlayer
    local root = if UserInputService.TouchEnabled then player:FindFirstChildOfClass("PlayerGui") else nil
    if root ~= playerGui then
        disconnect(guiConnections)
        clearUnused({})
        playerGui = root
        if root then
            table.insert(guiConnections, root.DescendantAdded:Connect(relevant))
            table.insert(guiConnections, root.DescendantRemoving:Connect(relevant))
        end
    end
    if not root then
        return
    end

    local wanted: { [Instance]: boolean } = {}
    local camera = workspace.CurrentCamera
    if camera then
        watch(wanted, camera, { "ViewportSize" })
    end
    local jump: GuiButton? = nil
    local touchGui = root:FindFirstChild("TouchGui")
    if touchGui then
        for _, object in touchGui:GetDescendants() do
            if object.Name == "JumpButton" and object:IsA("GuiButton") then
                watch(wanted, object, { "AbsolutePosition", "AbsoluteSize", "Visible" })
                watchAncestors(wanted, object, root)
                if visible(object, root) and object.AbsoluteSize.X > 0 and object.AbsoluteSize.Y > 0 then
                    jump = object
                    break
                end
            end
        end
    end

    -- AbsolutePosition and GetInsetArea both use CoreUISafeInsets coordinates.
    -- Subtracting the live CAS parent origin accounts for each ScreenGui's insets.
    local ok, area = pcall(function()
        return GuiService:GetInsetArea(Enum.ScreenInsets.CoreUISafeInsets)
    end)
    local bounds: Rect
    if ok then
        bounds = area
    elseif camera then
        local topLeft, bottomRight = GuiService:GetGuiInset()
        bounds = Rect.new(Vector2.zero, camera.ViewportSize - topLeft - bottomRight)
    else
        clearUnused(wanted)
        return
    end
    local available = bounds.Max - bounds.Min
    if available.X <= PADDING * 2 or available.Y <= PADDING * 2 then
        clearUnused(wanted)
        return
    end
    local diameter = math.clamp(math.min(available.X, available.Y) * 0.18, 70, 120)
    local jumpSize = Vector2.new(diameter, diameter)
    local center = bounds.Max - jumpSize / 2 - Vector2.new(PADDING, PADDING)
    if jump then
        jumpSize = jump.AbsoluteSize
        diameter = math.min(jumpSize.X, jumpSize.Y)
        center = jump.AbsolutePosition + jumpSize / 2
    end
    local size = math.max(44, diameter * 0.83)
    local obstacles = { Rect.new(center - jumpSize / 2, center + jumpSize / 2) }
    for _, action in ACTIONS do
        if not registered[action] then
            continue
        end
        local button = ContextActionService:GetButton(action)
        if not button or not button:IsDescendantOf(root) then
            continue
        end
        watch(wanted, button, { "AbsoluteSize", "AnchorPoint" })
        watchAncestors(wanted, button, root)
        local parent = button.Parent
        if not parent or not parent:IsA("GuiObject") then
            continue
        end
        local parentSize = parent.AbsoluteSize
        if parentSize.X <= 0 or parentSize.Y <= 0 then
            continue
        end
        local offset = OFFSETS[action]
        local position = place(center + offset * diameter, size, bounds, obstacles)
        if position then
            local half = Vector2.new(size / 2, size / 2)
            table.insert(obstacles, Rect.new(position - half, position + half))
            -- Scale ratios also handle a UIScale on the CAS parent. Preserve AnchorPoint.
            local localPosition = position
                - parent.AbsolutePosition
                + (button.AnchorPoint - Vector2.new(0.5, 0.5)) * size
            local buttonSize = UDim2.fromScale(size / parentSize.X, size / parentSize.Y)
            local buttonPosition = UDim2.fromScale(localPosition.X / parentSize.X, localPosition.Y / parentSize.Y)
            if button.Size ~= buttonSize then
                button.Size = buttonSize
            end
            if button.Position ~= buttonPosition then
                ContextActionService:SetPosition(action, buttonPosition)
            end
        end
    end
    clearUnused(wanted)
end

function Layout.Destroy()
    started = false
    queued = false
    generation += 1
    disconnect(connections)
    disconnect(guiConnections)
    clearUnused({})
    playerGui = nil
    table.clear(registered)
end

function Layout.Register(action: string)
    assert(OFFSETS[action], "Unknown mobile action")
    registered[action] = true
    if not started then
        started = true
        local player = Players.LocalPlayer
        table.insert(connections, UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(schedule))
        table.insert(connections, GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(schedule))
        table.insert(connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(schedule))
        table.insert(connections, player.ChildAdded:Connect(schedule))
        table.insert(connections, player.ChildRemoved:Connect(schedule))
        table.insert(connections, script.Destroying:Connect(Layout.Destroy))
    end
    schedule()
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="637">
            <Properties>
              <string name="Name">MobilePromptTouchTargets</string>
              <string name="Source"><![CDATA[--!strict
local ProximityPromptService = game:GetService("ProximityPromptService")
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local Targets = {}
local claimed = setmetatable({} :: { [InputObject]: boolean }, { __mode = "k" })

-- Roblox has already hit-tested this actual transparent button before InputBegan.
-- Do not compare its inset-aware InputObject.Position to a second viewport rectangle.
-- Native GUI stacking chooses the source; the finger claim prevents double dispatch.
function Targets.Register(
    prompt: ProximityPrompt,
    gui: BillboardGui,
    button: TextButton,
    begin: (InputObject) -> (),
    available: (() -> boolean)?
): () -> ()
    Debug.Log(
        prompt,
        "REGISTERED",
        "native button " .. tostring(button.Size.X.Offset) .. "x" .. tostring(button.Size.Y.Offset)
    )
    local registered = true
    local connection = button.InputBegan:Connect(function(input)
        Debug.Log(
            prompt,
            "TOUCH RECEIVED",
            tostring(input.UserInputType)
                .. " input="
                .. tostring(input.Position)
                .. " buttonPosition="
                .. tostring(button.AbsolutePosition)
                .. " buttonSize="
                .. tostring(button.AbsoluteSize)
        )
        local reason: string? = nil
        local touch = input.UserInputType == Enum.UserInputType.Touch
        local click = input.UserInputType == Enum.UserInputType.MouseButton1 and prompt.ClickablePrompt
        if not touch and not click then
            reason = "wrong input type"
        elseif claimed[input] then
            reason = "finger already claimed"
        elseif not registered or not gui.Parent or not gui.Enabled or not gui.Active then
            reason = "hidden view"
        elseif button.Parent ~= gui or not button.Visible or not button.Active then
            reason = "inactive touch button"
        elseif not prompt:IsDescendantOf(workspace) then
            reason = "invalid source: prompt outside Workspace"
        elseif not prompt.Enabled then
            reason = "disabled prompt"
        elseif not ProximityPromptService.Enabled then
            reason = "prompt service disabled"
        elseif available and not available() then
            reason = "invalid source: ingredient registration, identity or ownership changed"
        end
        if reason then
            Debug.Log(prompt, "REJECTED", reason)
            return
        end
        -- Claim before begin: a synchronous Triggered callback may retire the view.
        claimed[input] = true
        Debug.Log(prompt, "TARGET SELECTED", "native GUI hit; no coordinate re-test")
        begin(input)
    end)
    return function()
        registered = false
        connection:Disconnect()
    end
end
return Targets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="638">
            <Properties>
              <string name="Name">PanelManager</string>
              <string name="Source"><![CDATA[--!strict
-- One visibility owner for major menus, independent of GUI/import identities.
-- Open/Close callbacks may yield for animations, but must finish their transition
-- before returning. Requests during a transition coalesce to the latest intent.
local PanelManager = {}

export type Callbacks = {
    Open: () -> (),
    Close: () -> (),
}
export type Handle = {
    Open: () -> (),
    Close: () -> (),
    Toggle: () -> (),
    Destroy: () -> (),
}
type Entry = { Id: string, Callbacks: Callbacks }
local registered: { [string]: Entry } = {}
local active: Entry? = nil
local requested: Entry? = nil
local transitioning = false

local function reconcile()
    if transitioning then
        return
    end
    transitioning = true
    local ok, message = xpcall(function()
        while active ~= requested do
            local previous = active
            if previous then
                previous.Callbacks.Close()
                active = nil
            end
            -- Read again after Close: it may yield while newer requests arrive.
            local nextPanel = requested
            if nextPanel then
                active = nextPanel
                nextPanel.Callbacks.Open()
            end
        end
    end, debug.traceback)
    transitioning = false
    if not ok then
        -- A failed close must never let another panel overlap the current one.
        requested = active
        warn("[PanelManager] " .. tostring(message))
    end
end

function PanelManager.Register(id: string, callbacks: Callbacks): Handle
    callbacks.Close() -- Registered views always start hidden, including replacements.
    local previous = registered[id]
    if previous and requested == previous then
        requested = nil
    end
    local entry: Entry = { Id = id, Callbacks = callbacks }
    registered[id] = entry
    reconcile()

    local function isRegistered(): boolean
        return registered[id] == entry
    end
    local function open()
        if isRegistered() then
            requested = entry
            reconcile()
        end
    end
    local function close()
        if requested == entry then
            requested = nil
            reconcile()
        end
    end
    return {
        Open = open,
        Close = close,
        Toggle = function()
            if requested == entry then
                close()
            else
                open()
            end
        end,
        Destroy = function()
            if isRegistered() then
                registered[id] = nil
            end
            close()
        end,
    }
end

function PanelManager.CloseAll()
    requested = nil
    reconcile()
end

function PanelManager.GetActive(): string?
    return if active then active.Id else nil
end

return PanelManager
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="639">
            <Properties>
              <string name="Name">RadialProgress</string>
              <string name="Source"><![CDATA[--!strict
-- A circular fill built from two clipped halves of one gradient-masked disc.
local RadialProgress = {}

export type View = { Root: Frame, Right: UIGradient, Left: UIGradient }

local diameter = 22
local half = diameter / 2
local mask = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0),
    NumberSequenceKeypoint.new(0.499, 0),
    NumberSequenceKeypoint.new(0.5, 1),
    NumberSequenceKeypoint.new(1, 1),
})

local function circle(parent: Instance, name: string, size: number, color: Color3): Frame
    local frame = Instance.new("Frame")
    frame.Name = name
    frame.Size = UDim2.fromOffset(size, size)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.fromOffset(half, half)
    frame.BackgroundColor3 = color
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = frame
    frame.Parent = parent
    return frame
end

local function fillHalf(parent: Frame, name: string, x: number, gold: Color3): UIGradient
    local clip = Instance.new("Frame")
    clip.Name = name
    clip.BackgroundTransparency = 1
    clip.ClipsDescendants = true
    clip.Position = UDim2.fromOffset(x, 0)
    clip.Size = UDim2.fromOffset(half, diameter)
    clip.Parent = parent

    local disc = circle(clip, "Fill", diameter, gold)
    disc.Position = UDim2.fromOffset(half - x, half)
    local gradient = Instance.new("UIGradient")
    gradient.Transparency = mask
    gradient.Parent = disc
    return gradient
end

function RadialProgress.Create(parent: Frame, gold: Color3, track: Color3): View
    local root = Instance.new("Frame")
    root.Name = "RadialProgress"
    root.BackgroundTransparency = 1
    root.Size = UDim2.fromOffset(diameter, diameter)
    root.Parent = parent
    circle(root, "Track", diameter, track)
    local right = fillHalf(root, "RightHalf", half, gold)
    local left = fillHalf(root, "LeftHalf", 0, gold)
    circle(root, "InnerCutout", 16, track)
    local view = { Root = root, Right = right, Left = left }
    RadialProgress.SetProgress(view, 0)
    return view
end

function RadialProgress.SetProgress(view: View, progress: number)
    local angle = math.clamp(progress, 0, 1) * 360
    view.Right.Rotation = math.min(angle, 180)
    view.Left.Rotation = math.max(angle, 180)
end

return RadialProgress
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="640">
            <Properties>
              <string name="Name">RipenessDisplayState</string>
              <string name="Source"><![CDATA[--!strict
local Ripeness = require(game:GetService("ReplicatedStorage").Shared.Constants.Ripeness)
local State = {}

export type ItemView = { Id: string, Index: number, Ripe: boolean, Progress: number }

function State.Progress(pad: BasePart, index: number, now: number): number
    local prefix = "StashItem" .. index
    if pad:GetAttribute(prefix .. "IsRipe") == true then
        return 1
    end
    local storedSeconds = pad:GetAttribute(prefix .. "StoredSeconds")
    local accumulated = if typeof(storedSeconds) == "number" then storedSeconds else 0
    local storedAt = pad:GetAttribute(prefix .. "StoredAt")
    local elapsed = if typeof(storedAt) == "number" then math.max(0, now - storedAt) else 0
    local duration = pad:GetAttribute("RipenessSeconds")
    return math.clamp((accumulated + elapsed) / (if typeof(duration) == "number" then duration else Ripeness.RipenessSeconds), 0, 1)
end

function State.Read(pad: BasePart, now: number): ({ ItemView }, string)
    local slotCount = pad:GetAttribute("StashCount")
    local count = if typeof(slotCount) == "number" then slotCount else 0
    local items: { ItemView } = {}
    local signature: { string } = {}
    for index = 1, count do
        local prefix = "StashItem" .. index
        local id = pad:GetAttribute(prefix .. "Id")
        if typeof(id) == "string" then
            local ripe = pad:GetAttribute(prefix .. "IsRipe") == true
            table.insert(items, { Id = id, Index = index, Ripe = ripe, Progress = State.Progress(pad, index, now) })
            table.insert(signature, id .. ":" .. tostring(ripe))
        end
    end
    table.sort(items, function(a, b)
        if a.Ripe ~= b.Ripe then
            return a.Ripe
        end
        if a.Progress ~= b.Progress then
            return a.Progress > b.Progress
        end
        return a.Id < b.Id
    end)
    return items, table.concat(signature, "|")
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="641">
            <Properties>
              <string name="Name">RipenessTutorialText</string>
              <string name="Source"><![CDATA[--!strict
local Text = {}
Text.Copy = "Ingredients can RIPEN while stored.\nRIPE Ingredients are worth +25%"

function Text.Rich(): string
    local message = Text.Copy:gsub("RIPEN", '<font color="#FFDE73">RIPEN</font>')
    message = message:gsub("RIPE Ingredients", '<font color="#FFDE73">RIPE</font> Ingredients')
    message = message:gsub("%+25%%", '<font color="#FFDE73">+25%%</font>')
    return message
end

return Text
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="642">
            <Properties>
              <string name="Name">ScrapbookPresentation</string>
              <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Catalog = require(Shared.Constants.DiscoveryCatalog)
local Artwork = require(Shared.Constants.ScrapbookArtwork)
local MoneyFormat = require(Shared.MoneyFormat)
local Types = require(Shared.Types)
local Presentation = {}
export type Tab = "Ingredients" | "Customers"
export type View = {
    SetWindow: (boolean, Tab) -> (),
    RenderState: (Types.DiscoveryState) -> (),
    UpdateDiscovery: (Types.DiscoveryEvent) -> (),
}

function Presentation.FormatValue(value: number): string
    return MoneyFormat.Announcement(value)
end

-- Preserve the catalog's ordering, including the ordering within each section.
function Presentation.Group<T>(entries: { T }, key: (T) -> string): { { Key: string, Entries: { T } } }
    local groups: { { Key: string, Entries: { T } } } = {}
    local byKey: { [string]: { Key: string, Entries: { T } } } = {}
    for _, entry in entries do
        local id = key(entry)
        local group: { Key: string, Entries: { T } }? = byKey[id]
        if group then
            table.insert(group.Entries, entry)
        else
            local newGroup: { Key: string, Entries: { T } } = { Key = id, Entries = { entry } }
            byKey[id] = newGroup
            table.insert(groups, newGroup)
        end
    end
    return groups
end

local function required(root: Instance, path: string, className: string): Instance
    local current = root
    local fullPath = root:GetFullName()
    for part in path:gmatch("[^.]+") do
        fullPath ..= "." .. part
        local child = current:FindFirstChild(part)
        assert(child, fullPath .. " missing")
        current = child
    end
    assert(current:IsA(className), fullPath .. " must be a " .. className)
    return current
end

function Presentation.Create(
    gui: ScreenGui,
    state: Types.DiscoveryState,
    actions: { Open: () -> (), Close: () -> (), SelectTab: (Tab) -> () }
): View
    local window = required(gui, "Window", "Frame") :: Frame
    window.Visible = false
    local open = required(gui, "OpenButton", "ImageButton") :: ImageButton
    local close = required(window, "CloseButton", "ImageButton") :: ImageButton
    local ingredientsButton = required(window, "Tabs.IngredientsButton", "TextButton") :: TextButton
    local customersButton = required(window, "Tabs.CustomersButton", "TextButton") :: TextButton
    local ingredientsPage = required(window, "Pages.IngredientsPage", "Frame") :: Frame
    local customersPage = required(window, "Pages.CustomersPage", "Frame") :: Frame
    local ingredientsScroll = required(ingredientsPage, "Scroll", "ScrollingFrame") :: ScrollingFrame
    local customersScroll = required(customersPage, "Scroll", "ScrollingFrame") :: ScrollingFrame
    local rarityTemplate = required(ingredientsScroll, "RaritySectionTemplate", "Frame") :: Frame
    local jumpTemplate = required(customersScroll, "JumpSectionTemplate", "Frame") :: Frame

    -- Validate everything before cloning so setup errors cannot leave half-built pages.
    for _, config in
        {
            { Template = rarityTemplate, Card = "IngredientCardTemplate", Image = "Artwork" },
            { Template = jumpTemplate, Card = "CustomerCardTemplate", Image = "Portrait" },
        }
    do
        local template = config.Template
        local cardName = config.Card
        required(template, "Header.Title", "TextLabel")
        required(template, "Grid", "Frame")
        required(template, "Grid.UIGridLayout", "UIGridLayout")
        local card = required(template, "Grid." .. cardName, "Frame") :: Frame
        required(card, config.Image, "ImageLabel")
        required(card, "Name", "TextLabel")
        if cardName == "IngredientCardTemplate" then
            required(card, "Rarity", "TextLabel")
            required(card, "Value", "TextLabel")
        end
        template.Visible = false
        card.Visible = false
    end
    for _, scroll in { ingredientsScroll, customersScroll } do
        local list = required(scroll, "UIListLayout", "UIListLayout") :: UIListLayout
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.FillDirection = Enum.FillDirection.Vertical
        list.Padding = UDim.new(0, 12)
        scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
        scroll.CanvasSize = UDim2.fromOffset(0, 0)
        scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    end
    gui.ResetOnSpawn = false
    local ingredientCardsById: { [string]: (boolean) -> () } = {}
    local specialCustomerCardsById: { [string]: (boolean) -> () } = {}

    local function section(template: Frame, parent: ScrollingFrame, title: string, order: number): Frame
        local clone = template:Clone()
        clone.Name = "Section_" .. title
        clone.LayoutOrder = order
        clone.Size = UDim2.new(1, -12, 0, 0)
        clone.AutomaticSize = Enum.AutomaticSize.Y
        local header = required(clone, "Header", "Frame") :: Frame
        header.LayoutOrder = 1
        header.Size = UDim2.new(1, 0, 0, 30)
        local titleLabel = required(header, "Title", "TextLabel") :: TextLabel
        titleLabel.Text = title
        local list = clone:FindFirstChildOfClass("UIListLayout") or Instance.new("UIListLayout")
        list.SortOrder = Enum.SortOrder.LayoutOrder
        list.FillDirection = Enum.FillDirection.Vertical
        list.Padding = UDim.new(0, 8)
        list.Parent = clone
        local grid = required(clone, "Grid", "Frame") :: Frame
        grid.LayoutOrder = 2
        grid.AutomaticSize = Enum.AutomaticSize.None
        local layout = required(grid, "UIGridLayout", "UIGridLayout") :: UIGridLayout
        layout.FillDirection = Enum.FillDirection.Horizontal
        layout.FillDirectionMaxCells = 4
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.CellPadding = UDim2.fromOffset(6, 6)
        local function resize()
            local width = math.max(1, math.floor((grid.AbsoluteSize.X - 18) / 4))
            layout.CellSize = UDim2.fromOffset(width, math.floor(width * 1.35))
        end
        local function fitGrid()
            grid.Size = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y)
        end
        -- Grid content height is engine-measured; the scroll canvas remains automatic.
        grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(resize)
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitGrid)
        fitGrid()
        clone.Visible = true
        clone.Parent = parent
        resize()
        return grid
    end

    local function bindCard(card: Frame, imageName: string, asset: string, displayName: string): (boolean) -> ()
        local image = required(card, imageName, "ImageLabel") :: ImageLabel
        local name = required(card, "Name", "TextLabel") :: TextLabel
        local tint = image.ImageColor3
        image.Image = asset
        image.ScaleType = Enum.ScaleType.Fit
        return function(discovered: boolean)
            image.ImageColor3 = if discovered then tint else Color3.new(0, 0, 0)
            name.Text = if discovered then displayName else "???"
        end
    end

    for order, group in
        Presentation.Group(Catalog.GetIngredients(), function(entry)
            return entry.Rarity
        end)
    do
        local grid = section(rarityTemplate, ingredientsScroll, string.upper(group.Key), order)
        local template = required(grid, "IngredientCardTemplate", "Frame") :: Frame
        for index, entry in group.Entries do
            local card = template:Clone()
            card.Name = "Ingredient_" .. entry.Id
            card.LayoutOrder = index
            local reveal = bindCard(card, "Artwork", Artwork.GetIngredient(entry.Id), entry.DisplayName)
            local rarityLabel = required(card, "Rarity", "TextLabel") :: TextLabel
            rarityLabel.Text = entry.Rarity
            local value = required(card, "Value", "TextLabel") :: TextLabel
            local function update(discovered: boolean)
                reveal(discovered)
                value.Text = if discovered then Presentation.FormatValue(entry.Value) else "$???"
            end
            ingredientCardsById[entry.Id] = update
            update(state.Ingredients[entry.Id] == true)
            card.Visible = true
            card.Parent = grid
        end
    end
    for order, group in
        Presentation.Group(Catalog.GetSpecialCustomers(), function(entry)
            return tostring(entry.MinJumpTier)
        end)
    do
        local grid = section(jumpTemplate, customersScroll, "JUMP " .. group.Key, order)
        local template = required(grid, "CustomerCardTemplate", "Frame") :: Frame
        for index, entry in group.Entries do
            local card = template:Clone()
            -- An ordinal name avoids showing a locked customer's identity in UI tooling.
            card.Name = "Customer_" .. tostring(index)
            card.LayoutOrder = index
            local update = bindCard(card, "Portrait", Artwork.GetSpecialCustomer(entry.Id), entry.DisplayName)
            specialCustomerCardsById[entry.Id] = update
            update(state.SpecialCustomers[entry.Id] == true)
            card.Visible = true
            card.Parent = grid
        end
    end
    open.Activated:Connect(actions.Open)
    close.Activated:Connect(actions.Close)
    ingredientsButton.Activated:Connect(function()
        actions.SelectTab("Ingredients")
    end)
    customersButton.Activated:Connect(function()
        actions.SelectTab("Customers")
    end)
    local ingredientsColor, customersColor = ingredientsButton.BackgroundColor3, customersButton.BackgroundColor3
    return {
        SetWindow = function(isOpen: boolean, tab: Tab)
            window.Visible = isOpen
            ingredientsPage.Visible = tab == "Ingredients"
            customersPage.Visible = tab == "Customers"
            ingredientsButton.BackgroundColor3 = if tab == "Ingredients"
                then ingredientsColor:Lerp(Color3.new(1, 1, 1), 0.25)
                else ingredientsColor
            customersButton.BackgroundColor3 = if tab == "Customers"
                then customersColor:Lerp(Color3.new(1, 1, 1), 0.25)
                else customersColor
        end,
        RenderState = function(discoveries: Types.DiscoveryState)
            for id, update in ingredientCardsById do
                update(discoveries.Ingredients[id] == true)
            end
            for id, update in specialCustomerCardsById do
                update(discoveries.SpecialCustomers[id] == true)
            end
        end,
        UpdateDiscovery = function(event: Types.DiscoveryEvent)
            local cards: { [string]: (boolean) -> () } = if event.Kind == "Ingredient"
                then ingredientCardsById
                else specialCustomerCardsById
            local update = cards[event.Id]
            if update then
                update(true)
            end
        end,
    }
end

return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="643">
            <Properties>
              <string name="Name">ScreenGuis</string>
