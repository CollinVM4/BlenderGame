          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">UpgradesController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Display = require(script.Parent.Parent.UI.UpgradeDisplay)
local Gui = require(script.Parent.Parent.UI.UpgradesGui)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
        local view = Gui.Create(playerGui)
        local remote: RemoteEvent? = nil
        local pending: string? = nil
        local generation = 0
        local feedback: { [string]: string } = {}
        local feedbackVersion: { [string]: number } = {}
        local serverMax: { [string]: boolean } = {}

        local function numberAttribute(name: string): number?
            local value = player:GetAttribute(name)
            return if typeof(value) == "number" then value else nil
        end
        local function rowState(track: { Id: string, Name: string, Attribute: string })
            return Display.Row(track.Id, numberAttribute(track.Id .. "Level"), numberAttribute(track.Attribute))
        end
        local function refresh()
            local cash = numberAttribute("playerCash")
            view.Cash.Text = if cash then "$ " .. tostring(cash) else "$ —"
            for _, track in Display.Tracks do
                local row = view.Rows[track.Id]
                local state = rowState(track)
                local isMax = serverMax[track.Id] or (state ~= nil and state.Max)
                local enabled = remote ~= nil and pending == nil and state ~= nil and not isMax
                row.Level.Text = if state
                    then "Level " .. tostring(state.Level + (if track.Id == "CarryCapacity" then 1 else 0))
                    else "Loading…"
                row.Stat.Text = if state then state.Stat else "—"
                row.Purchase.Text = if pending == track.Id
                    then "UPGRADING…"
                    elseif isMax then "MAX"
                    elseif feedback[track.Id] then feedback[track.Id]
                    elseif state and state.Price then "$" .. tostring(state.Price) .. " UPGRADE"
                    else "LOADING…"
                row.Purchase.Interactable = enabled
                row.Purchase.AutoButtonColor = enabled
                row.Purchase.BackgroundColor3 = if enabled
                    then Color3.fromRGB(57, 119, 83)
                    else Color3.fromRGB(66, 76, 90)
            end
        end
        local function showFeedback(id: string, message: string)
            local version = (feedbackVersion[id] or 0) + 1
            feedbackVersion[id] = version
            feedback[id] = message
            task.delay(2, function()
                if feedbackVersion[id] == version then
                    feedback[id] = nil
                    refresh()
                end
            end)
        end
        player:GetAttributeChangedSignal("playerCash"):Connect(refresh)
        for _, track in Display.Tracks do
            player:GetAttributeChangedSignal(track.Id .. "Level"):Connect(function()
                serverMax[track.Id] = nil
                refresh()
            end)
            if track.Attribute ~= track.Id .. "Level" then
                player:GetAttributeChangedSignal(track.Attribute):Connect(refresh)
            end
            view.Rows[track.Id].Purchase.Activated:Connect(function()
                local state = rowState(track)
                local request = remote
                if not request or pending or not state or state.Max or serverMax[track.Id] then
                    return
                end
                pending = track.Id
                generation += 1
                local token = generation
                refresh()
                request:FireServer("PurchaseUpgrade", track.Id, state.Level + 2)
                -- The shared server throttle can drop a request without a response.
                task.delay(5, function()
                    if generation == token and pending == track.Id then
                        pending = nil
                        showFeedback(track.Id, "PLEASE TRY AGAIN")
                        refresh()
                    end
                end)
            end)
        end
        refresh()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local request = events:WaitForChild("GameplayRequest")
        assert(request:IsA("RemoteEvent"), "GameplayRequest must be a RemoteEvent")
        request.OnClientEvent:Connect(function(action: any, result: any)
            if action ~= "PurchaseUpgradeResult" or type(result) ~= "table" then
                return
            end
            if result.reason == "InvalidUpgrade" then
                warn("Upgrade purchase rejected: InvalidUpgrade")
            end
            local id = result.upgradeId
            if type(id) ~= "string" or not view.Rows[id] or type(result.success) ~= "boolean" then
                return
            end
            if pending == id then
                pending = nil
                generation += 1
            end
            if result.reason == "MaxLevel" then
                serverMax[id] = true
            end
            showFeedback(id, Display.Feedback(result.success, result.reason))
            -- Response levels never replace replicated player state.
            refresh()
        end)
        remote = request
        refresh()
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">WorldTextController</string>
              <string name="Source"><![CDATA[--!strict
local Presentation = require(script.Parent.Parent.UI.WorldTextPresentation)
local Controller = {}
local started = false

type Entry = {
    Connection: RBXScriptConnection?,
    Handle: Presentation.Handle?,
    MaxDistance: number?,
    TextSize: number?,
}

local function positiveNumber(value: any): number?
    return if typeof(value) == "number" and value > 0 and value < math.huge then value else nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local tracked: { [Attachment]: Entry } = {}
    local function clear(entry: Entry)
        local handle = entry.Handle
        entry.Handle = nil
        if handle then
            handle:Destroy()
        end
    end
    local function refresh(origin: Attachment, entry: Entry)
        local text = origin:GetAttribute("WorldText")
        if not origin:IsDescendantOf(workspace) or typeof(text) ~= "string" or text == "" then
            clear(entry)
            return
        end
        local distance = positiveNumber(origin:GetAttribute("WorldTextMaxDistance"))
        local textSize = positiveNumber(origin:GetAttribute("WorldTextTextSize"))
        if entry.MaxDistance ~= distance or entry.TextSize ~= textSize then
            clear(entry)
        end
        entry.MaxDistance, entry.TextSize = distance, textSize
        local handle = entry.Handle
        if not handle then
            local settings: Presentation.Settings = {
                Origin = origin,
                Text = text,
                MaxDistance = distance,
                TextSize = textSize,
            }
            handle = Presentation.Create(settings)
            entry.Handle = handle
        else
            handle:SetText(text)
        end
        if handle then
            handle:SetVisible(origin:GetAttribute("WorldTextVisible") ~= false)
        end
    end
    local function track(object: Instance)
        if not object:IsA("Attachment") or tracked[object] or not object:IsDescendantOf(workspace) then
            return
        end
        local entry: Entry = {}
        tracked[object] = entry
        -- Track bare Attachments too: attributes may replicate or be authored later.
        entry.Connection = object.AttributeChanged:Connect(function(attribute)
            if
                attribute == "WorldText"
                or attribute == "WorldTextVisible"
                or attribute == "WorldTextMaxDistance"
                or attribute == "WorldTextTextSize"
            then
                refresh(object, entry)
            end
        end)
        refresh(object, entry)
    end
    workspace.DescendantAdded:Connect(track)
    workspace.DescendantRemoving:Connect(function(object)
        if not object:IsA("Attachment") then
            return
        end
        local entry = tracked[object]
        if not entry then
            return
        end
        tracked[object] = nil
        if entry.Connection then
            entry.Connection:Disconnect()
        end
        clear(entry)
    end)
    -- Connect first so objects arriving during startup cannot be missed.
    for _, object in workspace:GetDescendants() do
        track(object)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="86">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">IngredientPickupPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local InputPresentation = require(script.Parent.InteractionPromptPresentation)
local Style = require(script.Parent.IngredientPickupPromptStyle)
local Presentation = {}

-- Rotated-part extents keep the label above the actual visible geometry,
-- excluding the invisible pivot root created for multipart ingredients.
function Presentation.Top(object: BasePart | Model): Vector3
    local minimum = Vector3.new(math.huge, math.huge, math.huge)
    local maximum = Vector3.new(-math.huge, -math.huge, -math.huge)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    local found = false
    for _, part in parts do
        if part:IsA("BasePart") and part.Transparency < 1 then
            local cf, half = part.CFrame, part.Size / 2
            local extent = cf.RightVector:Abs() * half.X + cf.UpVector:Abs() * half.Y + cf.LookVector:Abs() * half.Z
            minimum = minimum:Min(part.Position - extent)
            maximum = maximum:Max(part.Position + extent)
            found = true
        end
    end
    return if found
        then Vector3.new((minimum.X + maximum.X) / 2, maximum.Y, (minimum.Z + maximum.Z) / 2)
        else object:GetPivot().Position
end

function Presentation.Create(
    prompt: ProximityPrompt,
    object: BasePart | Model,
    definition: { Id: string, DisplayName: string?, Rarity: string? },
    parent: Instance,
    inputType: Enum.ProximityPromptInputType
): (() -> (), () -> ())
    local rarity, name = Style.Resolve(definition)
    local palette = (Style.RarityStyles :: any)[rarity]
    local anchor = if object:IsA("BasePart")
        then object
        else object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    assert(anchor and anchor:IsA("BasePart"), "Ingredient presentation requires a physical part")
    -- Reuse the existing keyboard/gamepad/touch and hold lifecycle implementation.
    local cleanup, gui = InputPresentation.Create(prompt, anchor, parent, inputType, {
        InputOnly = true,
        Width = Style.BillboardSize.X,
        Height = Style.BillboardSize.Y,
        TextSize = Style.InputTextSize,
        MaxDistance = Style.MaxDistance,
    })
    gui.Name = "IngredientPickupPromptDisplay"
    gui.SizeOffset = Vector2.new(0, 0.5)
    local function formatText(
        text: TextLabel | TextButton,
        y: number,
        height: number,
        size: number,
        color: Color3,
        strokeColor: Color3
    )
        local label = text :: TextLabel
        label.Position = UDim2.fromOffset(0, y)
        label.Size = UDim2.new(1, 0, 0, height)
        label.BackgroundTransparency = 1
        label.Font = Style.Font
        label.TextSize = size
        label.TextColor3 = color
        label.TextStrokeTransparency = 1
        label.TextScaled = true
        local limit = Instance.new("UITextSizeConstraint")
        limit.MinTextSize = 12
        limit.MaxTextSize = size
        limit.Parent = label
        local stroke = Instance.new("UIStroke")
        stroke.Color = strokeColor
        stroke.Thickness = Style.StrokeThickness
        stroke.Transparency = Style.TextStrokeTransparency
        stroke.Parent = label
    end
    local title = Instance.new("TextLabel")
    title.Name, title.Text = "Rarity", string.upper(rarity)
    formatText(title, 0, Style.TitleHeight, Style.TitleTextSize, palette.TextColor, palette.StrokeColor)
    title.Parent = gui
    local label = Instance.new("TextLabel")
    label.Name, label.Text = "IngredientName", name
    local nameY = Style.TitleHeight + Style.RowSpacing
    formatText(label, nameY, Style.NameHeight, Style.NameTextSize, Style.NameColor, Style.StrokeColor)
    label.Parent = gui
    local input = gui:FindFirstChild("Action") :: TextButton
    formatText(
        input,
        nameY + Style.NameHeight + Style.InputSpacing,
        Style.InputHeight,
        Style.InputTextSize,
        palette.TextColor,
        palette.StrokeColor
    )
    local function update()
        gui.StudsOffsetWorldSpace = Presentation.Top(object) - anchor.Position + Style.PromptStudsOffset
    end
    update()
    return cleanup, update
end

return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">IngredientPickupPromptStyle</string>
              <string name="Source"><![CDATA[--!strict
-- All ingredient pickup appearance tuning lives here; no gameplay effects.
local Style = {
    RarityStyles = {
        Common = { TextColor = Color3.fromRGB(240, 240, 235), StrokeColor = Color3.fromRGB(20, 20, 24) },
        Uncommon = { TextColor = Color3.fromRGB(135, 245, 145), StrokeColor = Color3.fromRGB(15, 35, 22) },
        Rare = { TextColor = Color3.fromRGB(255, 212, 85), StrokeColor = Color3.fromRGB(45, 28, 12) },
        Mystery = { TextColor = Color3.fromRGB(225, 155, 255), StrokeColor = Color3.fromRGB(37, 13, 55) },
    },
    TitleTextSize = 23,
    NameTextSize = 29,
    InputTextSize = 21,
    TitleHeight = 28,
    NameHeight = 38,
    InputHeight = 34,
    RowSpacing = 2,
    InputSpacing = 6,
    BillboardSize = Vector2.new(320, 112),
    PromptStudsOffset = Vector3.new(0, 0.35, 0),
    -- Camera-distance cull only; Roblox still owns prompt activation range.
    MaxDistance = math.huge,
    HideMysteryNames = true,
    Font = Enum.Font.GothamBold,
    NameColor = Color3.fromRGB(255, 250, 235),
    StrokeColor = Color3.fromRGB(16, 16, 20),
    TextStrokeTransparency = 0.05,
    StrokeThickness = 2,
}

function Style.Resolve(definition: { Id: string, DisplayName: string?, Rarity: string? }): (string, string)
    local rarity = definition.Rarity or "Common"
    if not (Style.RarityStyles :: any)[rarity] then
        rarity = "Common"
    end
    local name = definition.DisplayName or definition.Id
    if rarity == "Mystery" and Style.HideMysteryNames then
        name = "???"
    end
    return rarity, name
end

return Style
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">InteractionPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")
local Style = require(script.Parent.WorldBillboardStyle)
local Presentation = {}

export type Settings = {
    ActionText: string?,
    KeyText: string?,
    MaxDistance: number?,
    Width: number?,
    Height: number?,
    TextSize: number?,
    InputOnly: boolean?,
    CustomerAction: string?,
}

-- One visible view; the caller owns PromptShown/PromptHidden and calls cleanup.
function Presentation.Create(
    prompt: ProximityPrompt,
    origin: Attachment | BasePart | Model,
    parent: Instance,
    inputType: Enum.ProximityPromptInputType,
    settings: Settings?
): (() -> (), BillboardGui)
    local config: Settings = settings or {}
    local gui = Instance.new("BillboardGui")
    gui.Name = "InteractionPromptDisplay"
    gui.Adornee = origin
    Style.ApplyBillboard(gui, config)
    gui.Active = true

    -- A transparent button preserves touch/click input through the prompt's API.
    local text = Instance.new("TextButton")
    text.Name = "Action"
    Style.ApplyText(text, config)
    if config.CustomerAction then
        -- Shared input behavior, with a compact customer-only visual treatment.
        gui.Size = UDim2.fromOffset(220, 44)
        gui.StudsOffset = Vector3.zero
        gui.SizeOffset = Vector2.new(0, -(22 + 12) / 44) -- Top edge 12px below the shared rig anchor.
        text.Font = Enum.Font.FredokaOne
        text.TextSize = 21
        text.TextColor3 = if config.CustomerAction == "TakeOrder"
            then Color3.fromRGB(255, 222, 115)
            else Color3.fromRGB(120, 235, 255)
        text.TextStrokeTransparency = 1
        local outline = Instance.new("UIStroke")
        outline.Color = Color3.fromRGB(18, 22, 30)
        outline.Thickness = 2.5
        outline.Parent = text
    end
    text.AutoButtonColor = false
    text.Parent = gui
    gui.Parent = parent

    local connections: { RBXScriptConnection } = {}
    local holding = false
    local function refresh()
        local key = config.KeyText
        if not key then
            if inputType == Enum.ProximityPromptInputType.Touch then
                key = "TAP"
            elseif inputType == Enum.ProximityPromptInputType.Gamepad then
                key = prompt.GamepadKeyCode.Name
            else
                key = UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
                if key == "" then
                    key = prompt.KeyboardKeyCode.Name
                end
            end
        end
        text.Text = string.format(
            "[%s] %s%s",
            key or "",
            if holding then "HOLD " else "",
            config.ActionText or prompt.ActionText
        )
        if config.InputOnly then
            text.Text = string.format("%s[%s]", if holding then "HOLD " else "", key or "")
        end
    end
    for _, property in { "ActionText", "KeyboardKeyCode", "GamepadKeyCode" } do
        table.insert(connections, prompt:GetPropertyChangedSignal(property):Connect(refresh))
    end
    table.insert(
        connections,
        prompt.PromptButtonHoldBegan:Connect(function()
            holding = true
            refresh()
        end)
    )
    table.insert(
        connections,
        prompt.PromptButtonHoldEnded:Connect(function()
            holding = false
            refresh()
        end)
    )
    local activeInput: InputObject? = nil
    local function release()
        if activeInput then
            activeInput = nil
            prompt:InputHoldEnd()
        end
    end
    table.insert(
        connections,
        text.InputBegan:Connect(function(input)
            local touch = input.UserInputType == Enum.UserInputType.Touch
            local click = input.UserInputType == Enum.UserInputType.MouseButton1 and prompt.ClickablePrompt
            if not activeInput and (touch or click) then
                activeInput = input
                prompt:InputHoldBegin()
            end
        end)
    )
    table.insert(
        connections,
        UserInputService.InputEnded:Connect(function(input)
            if input == activeInput then
                release()
            end
        end)
    )
    table.insert(connections, UserInputService.WindowFocusReleased:Connect(release))
    refresh()
    return function()
        for _, connection in connections do
            connection:Disconnect()
        end
        release()
        gui:Destroy()
    end,
        gui
end

return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
