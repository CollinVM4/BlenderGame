                  </Properties>
                  <Item class="NumberValue" referent="591">
                    <Properties>
                      <string name="Name">k_text</string>
                      <BinaryString name="AttributesSerialize">AQAAAAgAAABGV19Pd25lZAMB</BinaryString>
                      <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
                      <bool name="DefinesCapabilities">false</bool>
                      <BinaryString name="SerializedOverrides">
                      </BinaryString>
