        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">DialogueTextStyle</string>
            <string name="Source"><![CDATA[--!strict
-- Appearance only, shared by NPC lettering and plot/world presentation.
local Style = {
    Font = Enum.Font.FredokaOne,
    White = Color3.new(1, 1, 1),
    Dark = Color3.fromRGB(18, 22, 30),
    Gold = Color3.fromRGB(255, 222, 115),
    Green = Color3.new(0.45, 1, 0.55),
}

function Style.Outline(object: TextLabel | TextButton): UIStroke
    local text = object :: TextLabel
    text.TextStrokeColor3 = Style.Dark
    text.TextStrokeTransparency = 1 -- UIStroke supplies the thicker, opaque text outline.
    local existing = text:FindFirstChild("DialogueOutline")
    local stroke = if existing and existing:IsA("UIStroke") then existing else Instance.new("UIStroke")
    stroke.Name = "DialogueOutline"
    stroke.Color = Style.Dark
    stroke.Thickness = 2.5
    stroke.Transparency = 0
    stroke.Parent = text
    return stroke
end

function Style.Apply(object: TextLabel | TextButton, size: number)
    local text = object :: TextLabel
    text.Font = Style.Font
    text.TextSize = size
    text.TextScaled = false
    text.TextWrapped = false
    text.TextColor3 = Style.White
    Style.Outline(object)
end

return Style
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">DiscoveryCatalog</string>
            <string name="Source"><![CDATA[--!strict
local Ingredients = require(script.Parent.Ingredients)
local CustomerRequests = require(script.Parent.CustomerRequests)
local DiscoveryCatalog = {}
DiscoveryCatalog.RarityOrder = table.freeze({ Common = 1, Uncommon = 2, Rare = 3, Mystery = 4 })
export type IngredientEntry = { Id: string, DisplayName: string, Rarity: string, Value: number, JumpLocation: number }
export type SpecialCustomerEntry = { Id: string, DisplayName: string, MinJumpTier: number }

function DiscoveryCatalog.GetSpecialCustomer(id: string): SpecialCustomerEntry?
    local mapping = CustomerRequests.NPCs[id]
    if not mapping or not (mapping.Type == "Special" or (not mapping.Type and mapping.RequestId)) then
        return nil
    end
    local request, reason = CustomerRequests.GetForNPC(id)
    if reason then
        return nil
    end
    return { Id = id, DisplayName = mapping.DisplayName or id, MinJumpTier = if request then request.MinJumpTier else 0 }
end

-- Complete ordered catalogs, independent of any player's unlocked entries.
function DiscoveryCatalog.GetIngredients(): { IngredientEntry }
    local entries: { IngredientEntry } = {}
    for id, definition in Ingredients do
        local entry: IngredientEntry = {
            Id = id,
            DisplayName = definition.DisplayName or id,
            Rarity = definition.Rarity or "Common",
            Value = definition.Value,
            JumpLocation = definition.JumpLocation,
        }
        table.insert(entries, entry)
    end
    local order: { [string]: number } = DiscoveryCatalog.RarityOrder
    table.sort(entries, function(a, b)
        local left, right = order[a.Rarity], order[b.Rarity]
        return if left == right then a.Id < b.Id else left < right
    end)
    return entries
end

function DiscoveryCatalog.GetSpecialCustomers(): { SpecialCustomerEntry }
    local entries: { SpecialCustomerEntry } = {}
    for id in CustomerRequests.NPCs do
        local entry = DiscoveryCatalog.GetSpecialCustomer(id)
        if entry then
            table.insert(entries, entry)
        end
    end
    table.sort(entries, function(a, b)
        return if a.MinJumpTier == b.MinJumpTier then a.Id < b.Id else a.MinJumpTier < b.MinJumpTier
    end)
    return entries
end
return DiscoveryCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
local rarityWeights: { [string]: number } = { Common = 75, Uncommon = 20, Rare = 5 }
return {
    MaxCustomersPerPlot = 3,
    InitialCustomerDelayMin = 2,
    InitialCustomerDelayMax = 5,
    CustomerSpawnMinSeconds = 25,
    CustomerSpawnMaxSeconds = 45,
    CustomerFullRetryMinSeconds = 3,
    CustomerFullRetryMaxSeconds = 5,
    SpecialCustomerCooldownSeconds = 300,
    BasePayout = 25,
    CashScale = 20, -- Legacy CalculatePayout compatibility only; live orders use ingredient dollars.
    GradeMultiplier = { A = 1.25, B = 1.1, C = 0.9, D = 0.15 },
    GradeScore = { A = 4, B = 3, C = 2, D = 1 },
    MaxIngredients = 3,
    RequiredProgress = 65,
    BlendProgressScale = 3, -- Progress per radian of physical blade rotation.
    InteractionDistance = 12,
    NormalStash = {
        Slots = 5,
        Protected = 2,
        IngredientCapacity = 3,
        RaidWindowSeconds = 6,
        RaidProtectionSeconds = 30,
    },
    VIPStash = { Slots = 10, Protected = 5 },
    StealCooldown = 3,
    VictimProtection = 5,
    DropProtection = 4,
    SlapCooldown = 0.8,
    SlapRange = 8,
    StunSeconds = 0.5,
    MarketRespawnSeconds = 12,
    WorldIngredientCleanupInterval = 360,
    WorldIngredientCleanupWarningSeconds = 60,
    WorldIngredientCleanupCountdownSeconds = 5,
    RarityWeights = rarityWeights,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">FallDamage</string>
            <string name="Source"><![CDATA[--!strict
-- Tuning for FallDamageService. Velocities are studs/sec of downward speed at
-- landing, after subtracting the character's own current jump power (so a
-- normal jump-and-land on the same level never counts as a fall).
-- Thresholds are the original tuning divided by ~1.3 (and non-lethal damage
-- multiplied by ~1.3) for ~30% more sensitivity; jump safety is unaffected
-- because the jump-power subtraction already nets ~0 effective velocity.
return {
    SafeImpactVelocity = 54,
    LightImpactVelocity = 69,
    HeavyImpactVelocity = 85,
    LethalImpactVelocity = 96,

    -- Damage applied at each named threshold; values between thresholds are
    -- smoothly interpolated rather than stepped.
    LightDamage = 16,
    HeavyDamage = 72,
    LethalDamage = 200, -- Deliberately exceeds max health to guarantee a kill.

    -- Landing detection only; these do not change the damage curve.
    ImpactProbePadding = 0.3,
    MinimumGroundNormalY = 0.5,
    ImpactSpeedDrop = 8,
    SettleVerticalSpeed = 4,
    SettleSeconds = 0.25,
    RepositionTolerance = 12, -- Extra studs beyond plausible per-step travel.
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">FarmConfig</string>
            <string name="Source"><![CDATA[--!strict
return {
    RowPrices = { 20000, 100000, 350000 },
    GrowSeconds = { Common = 60, Uncommon = 90, Rare = 120, Mystery = 210 },
    PlantDistance = 10,
    RevealSeconds = 0.5,
    RevealDepth = 3.5,
    HarvestVerticalOffset = 0,
    HarvestPopDepth = 0.65,
    HarvestPopSeconds = 0.32,
}
]]></string>
          </Properties>
