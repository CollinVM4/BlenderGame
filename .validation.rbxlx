          <string name="Name">FramewispSpin</string>
          <BinaryString name="AttributesSerialize">AwAAAAgAAABGV19Pd25lZAMBBgAAAEZXX1NyYwYAAADLST7pQQMAAABGV3YGAAAAAAAAAEA=</BinaryString>
