          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">IngredientPickupPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Definitions = require(game:GetService("ReplicatedStorage").Shared.Constants.Ingredients)
local Presentation = require(script.Parent.Parent.UI.IngredientPickupPromptPresentation)
local Controller = {}
local started = false

-- Client mirror of IngredientService's ancestor resolution, using only its
-- replicated registration metadata. The server still validates its private record.
function Controller.Resolve(prompt: ProximityPrompt): (BasePart | Model)?
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        if CollectionService:HasTag(ancestor, "IngredientWorldItem") then
            if ancestor:IsA("BasePart") or ancestor:IsA("Model") then
                return ancestor
            end
            return nil
        end
        ancestor = ancestor.Parent
    end
    return nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    type Entry = {
        InputType: Enum.ProximityPromptInputType,
        Object: Instance?,
        Id: string?,
        Cleanup: (() -> ())?,
        Update: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Entry } = {}
    local function clear(entry: Entry)
        if entry.Cleanup then
            entry.Cleanup()
        end
        entry.Cleanup, entry.Update, entry.Object, entry.Id = nil, nil, nil, nil
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if entry then
            visible[prompt] = nil
            for _, connection in entry.Connections do
                connection:Disconnect()
            end
            clear(entry)
        end
    end
    local function refresh(prompt: ProximityPrompt, entry: Entry)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled or not ProximityPromptService.Enabled then
            hide(prompt)
            return
        end
        local object = Controller.Resolve(prompt)
        local id = object and object:GetAttribute("IngredientId")
        local definition = if typeof(id) == "string" then Definitions[id] else nil
        if object and object:IsA("Model") and not object:FindFirstChildWhichIsA("BasePart", true) then
            clear(entry)
            return
        end
        if
            prompt.Style ~= Enum.ProximityPromptStyle.Custom
            or prompt:GetAttribute("IngredientPickupPrompt") ~= true
            or not definition
            or not object
        then
            clear(entry)
            return
        end
        if entry.Object ~= (object :: Instance) or entry.Id ~= id then
            clear(entry)
            entry.Object, entry.Id = object, definition.Id
            entry.Cleanup, entry.Update = Presentation.Create(prompt, object, definition, playerGui, entry.InputType)
        elseif entry.Update then
            entry.Update()
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        hide(prompt)
        -- Track shown prompts only. No distance checks, pickup remotes, or scans.
        if prompt:GetAttribute("IngredientPickupPrompt") ~= true and prompt.Name ~= "CarryPrompt" then
            return
        end
        local entry: Entry = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.Destroying:Connect(function()
                hide(prompt)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(hide)
    -- Only engine-visible prompts: tracks rolling/dropped geometry and tolerates
    -- tags/IngredientId arriving after PromptShown during replication/streaming.
    RunService.RenderStepped:Connect(function()
        for prompt, entry in visible do
            refresh(prompt, entry)
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">InteractionPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Presentation = require(script.Parent.Parent.UI.InteractionPromptPresentation)
local Controller = {}
local started = false

-- Never recursively search a plot/workspace and accidentally bind another interactable.
local function findOrigin(prompt: ProximityPrompt): (Attachment?, string?)
    local name = prompt:GetAttribute("InteractionOrigin")
    if typeof(name) ~= "string" or name == "" then
        return nil, "InteractionOrigin must be a nonempty string"
    end
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        local marker = ancestor:FindFirstChild(name)
        if marker and marker:IsA("Attachment") then
            return marker
        end
        if marker then
            return nil, marker:GetFullName() .. " is " .. marker.ClassName .. "; expected Attachment"
        end
        if ancestor:IsA("Model") then
            local found: Attachment? = nil
            for _, descendant in ancestor:GetDescendants() do
                if descendant.Name == name and descendant:IsA("Attachment") then
                    if found then
                        return nil, "Ambiguous InteractionOrigin beneath " .. ancestor:GetFullName()
                    end
                    found = descendant
                end
            end
            if found then
                return found
            end
            return nil, "Attachment " .. name .. " not found beneath containing Model " .. ancestor:GetFullName()
        end
        ancestor = ancestor.Parent
    end
    return nil, "Attachment " .. name .. " not found beneath prompt's containing interactable"
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    -- ServerStorage's debug flag does not replicate. Use the same Studio-only
    -- convention on local PlayerGui, without introducing a server bridge.
    local function debugging(): boolean
        return RunService:IsStudio() and playerGui:GetAttribute("DebugFilmLoop") == true
    end
    local function log(prompt: ProximityPrompt, message: string)
        if debugging() then
            print("[InteractionPrompt] " .. prompt:GetFullName() .. " | " .. message)
        end
    end
    local shownCounts = setmetatable({} :: { [ProximityPrompt]: number }, { __mode = "k" })
    local function snapshot(prompt: ProximityPrompt)
        if not debugging() then
            return
        end
        local parent = prompt.Parent
        local placement = "Invalid: parent must be BasePart, Attachment, or Model with PrimaryPart"
        if parent then
            if parent:IsA("Model") then
                placement = if parent.PrimaryPart
                    then "Model PrimaryPart=" .. parent.PrimaryPart:GetFullName()
                    else "Invalid: Model.PrimaryPart is nil; engine cannot show this prompt"
            elseif parent:IsA("BasePart") then
                placement = "BasePart=" .. parent:GetFullName()
            elseif parent:IsA("Attachment") then
                placement = "Attachment=" .. parent:GetFullName() .. "; parent=" .. tostring(parent.Parent)
            end
        end
        local origin, reason = findOrigin(prompt)
        log(
            prompt,
            string.format(
                "snapshot | PromptShownCount=%d | InteractionOrigin=%s | InteractionActionText=%s | ResolvedOrigin=%s | OriginReason=%s | MaxActivationDistance=%s | RequiresLineOfSight=%s | HoldDuration=%s | Style=%s | Enabled=%s | ParentClass=%s | Placement=%s | InWorkspace=%s | Exclusivity=%s | ServiceEnabled=%s | MaxPromptsVisible=%s",
                shownCounts[prompt] or 0,
                tostring(prompt:GetAttribute("InteractionOrigin")),
                tostring(prompt:GetAttribute("InteractionActionText")),
                if origin then origin:GetFullName() else "nil",
                reason or "resolved",
                tostring(prompt.MaxActivationDistance),
                tostring(prompt.RequiresLineOfSight),
                tostring(prompt.HoldDuration),
                tostring(prompt.Style),
                tostring(prompt.Enabled),
                if parent then parent.ClassName else "nil",
                placement,
                tostring(prompt:IsDescendantOf(workspace)),
                tostring(prompt.Exclusivity),
                tostring(ProximityPromptService.Enabled),
                tostring(ProximityPromptService.MaxPromptsVisible)
            )
        )
    end
    local function dump()
        if not debugging() then
            return
        end
        for _, object in workspace:GetDescendants() do
            if object:IsA("ProximityPrompt") and object:GetAttribute("InteractionOrigin") ~= nil then
                snapshot(object)
            end
        end
    end
    playerGui:GetAttributeChangedSignal("DebugFilmLoop"):Connect(dump)
    type Visible = {
        InputType: Enum.ProximityPromptInputType,
        Origin: Attachment?,
        Cleanup: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Visible } = {}
    local function clearView(entry: Visible)
        local cleanup = entry.Cleanup
        entry.Cleanup = nil
        entry.Origin = nil
        if cleanup then
            cleanup()
        end
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if not entry then
            return
        end
        visible[prompt] = nil
        for _, connection in entry.Connections do
            connection:Disconnect()
        end
        clearView(entry)
    end
    local function refresh(prompt: ProximityPrompt, entry: Visible)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled then
            log(prompt, "Rejected: " .. (if not prompt.Enabled then "Enabled=false" else "prompt is outside Workspace"))
            hide(prompt)
            return
        end
        local origin, reason = findOrigin(prompt)
        if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
            origin = nil
            reason = "Style is not Custom"
        end
        local customerAction = prompt:GetAttribute("InteractionCustomerAction")
        if customerAction and prompt:GetAttribute("InteractionOwnerUserId") ~= Players.LocalPlayer.UserId then
            origin = nil
            reason = "Customer prompt belongs to another player"
        end
        if not origin then
            log(prompt, "Rejected: " .. (reason or "origin unavailable"))
        end
        if origin == entry.Origin then
            return
        end
        clearView(entry)
        if origin then
            local action = prompt:GetAttribute("InteractionActionText")
            local key = prompt:GetAttribute("InteractionKeyText")
            local distance = prompt:GetAttribute("InteractionMaxDistance")
            entry.Origin = origin
            log(
                prompt,
                "Presentation.Create | origin="
                    .. origin:GetFullName()
                    .. " | InteractionActionText="
                    .. tostring(action)
            )
            local cleanup, gui = Presentation.Create(prompt, origin, playerGui, entry.InputType, {
                CustomerAction = if typeof(customerAction) == "string" then customerAction else nil,
                ActionText = if typeof(action) == "string" then action else nil,
                KeyText = if typeof(key) == "string" then key else nil,
                MaxDistance = if typeof(distance) == "number" and distance > 0 then distance else nil,
            })
            entry.Cleanup = cleanup
            log(prompt, "BillboardGui created=" .. gui:GetFullName() .. " | Adornee=" .. origin:GetFullName())
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        shownCounts[prompt] = (shownCounts[prompt] or 0) + 1
        log(prompt, "PromptShown received by controller | InputType=" .. tostring(inputType))
        snapshot(prompt)
        hide(prompt)
        local entry: Visible = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AttributeChanged:Connect(function(attribute)
                if string.sub(attribute, 1, 11) == "Interaction" then
                    clearView(entry)
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(function(prompt)
        log(prompt, "PromptHidden received by controller")
        hide(prompt)
    end)
    dump()
    -- Replication/streaming may deliver a marker after its already-visible prompt.
    workspace.DescendantAdded:Connect(function(object)
        if object:IsA("ProximityPrompt") then
            snapshot(object)
        end
        if object:IsA("Attachment") then
            for prompt, entry in visible do
                refresh(prompt, entry)
            end
        end
    end)
    workspace.DescendantRemoving:Connect(function(object: Instance)
        for prompt, entry in visible do
            if object == prompt then
                hide(prompt)
            elseif object == entry.Origin then
                clearView(entry)
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">RareIngredientPresentationController</string>
              <string name="Source"><![CDATA[--!strict
--! This script controls the display of rare ingredient spawns in the player's GUI.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local remote = events:WaitForChild("RareIngredientSpawned")
        assert(remote:IsA("RemoteEvent"), "RareIngredientSpawned must be a RemoteEvent")
        local gui = Instance.new("ScreenGui")
        gui.Name = "RareIngredientAnnouncement"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 20
        gui.Parent = playerGui
        local banner = Instance.new("TextLabel")
        banner.AnchorPoint = Vector2.new(0.5, 0)
        banner.Position = UDim2.fromScale(0.5, 0.12)
        banner.Size = UDim2.new(0.8, 0, 0, 64)
        banner.BackgroundColor3 = Color3.fromRGB(35, 28, 55)
        banner.BackgroundTransparency = 0.15
        banner.TextColor3 = Color3.fromRGB(255, 228, 125)
        banner.Font = Enum.Font.GothamBold
        banner.TextSize = 22
        banner.TextWrapped = true
        banner.Visible = false
        banner.Parent = gui
        local version = 0
        remote.OnClientEvent:Connect(function(payload: any)
            if
                typeof(payload) ~= "table"
                or payload.Type ~= "RareIngredientSpawned"
                or typeof(payload.DisplayName) ~= "string"
                or typeof(payload.LocationName) ~= "string"
            then
                return
            end
            version += 1
            local shown = version
            banner.Text = payload.DisplayName .. " appeared at " .. payload.LocationName .. "!"
            banner.Visible = true
            task.delay(8, function()
                if shown == version then
                    banner.Visible = false
                end
            end)
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">SmoothiePickupPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Presentation = require(script.Parent.Parent.UI.SmoothiePickupPromptPresentation)
local Controller = {}
local started = false

-- Resolve display metadata only; the server validates its private smoothie record.
function Controller.Resolve(prompt: ProximityPrompt): (BasePart | Model)?
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        if CollectionService:HasTag(ancestor, "SmoothieWorldItem") then
            if ancestor:IsA("BasePart") or ancestor:IsA("Model") then
                return ancestor
            end
            return nil
        end
        ancestor = ancestor.Parent
    end
    return nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    type Entry = {
        InputType: Enum.ProximityPromptInputType,
        Object: Instance?,
        Id: string?,
        Cleanup: (() -> ())?,
        Update: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Entry } = {}
    local function clear(entry: Entry)
        if entry.Cleanup then
            entry.Cleanup()
        end
        entry.Cleanup, entry.Update, entry.Object, entry.Id = nil, nil, nil, nil
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if entry then
            visible[prompt] = nil
            for _, connection in entry.Connections do
                connection:Disconnect()
            end
            clear(entry)
        end
    end
    local function refresh(prompt: ProximityPrompt, entry: Entry)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled or not ProximityPromptService.Enabled then
            hide(prompt)
            return
        end
        local object = Controller.Resolve(prompt)
        local rows = if object then Presentation.Rows(object) else nil
        local id = if rows then rows[1].Id .. "/" .. rows[2].Id .. "/" .. rows[3].Id else nil
        if object and object:IsA("Model") and not object:FindFirstChildWhichIsA("BasePart", true) then
            clear(entry)
            return
        end
        if
            prompt.Style ~= Enum.ProximityPromptStyle.Custom
            or prompt:GetAttribute("SmoothiePickupPrompt") ~= true
            or not rows
            or not object
        then
            clear(entry)
            return
        end
        if entry.Object ~= (object :: Instance) or entry.Id ~= id then
            clear(entry)
            entry.Object, entry.Id = object, id
            entry.Cleanup, entry.Update = Presentation.Create(prompt, object, rows, playerGui, entry.InputType)
        elseif entry.Update then
            entry.Update()
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        hide(prompt)
        -- Track shown prompts only. No distance checks, pickup remotes, or scans.
        if prompt:GetAttribute("SmoothiePickupPrompt") ~= true and prompt.Name ~= "SmoothieCarryPrompt" then
            return
        end
        local entry: Entry = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.Destroying:Connect(function()
                hide(prompt)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(hide)
    -- Only engine-visible prompts: tracks rolling/dropped geometry and tolerates
    -- tags/ingredient rows arriving after PromptShown during replication/streaming.
    RunService.RenderStepped:Connect(function()
        for prompt, entry in visible do
            refresh(prompt, entry)
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">SprintController</string>
              <string name="Source"><![CDATA[--!strict
-- Detects sprint input (keyboard Shift) and requests sprint start/stop from the server
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local getSprintEvent = require(ReplicatedStorage.Shared.Events.SprintEvents)

local SprintController = {}
local started = false
local requested = false
local heldShift: { [Enum.KeyCode]: boolean } = {}

local function requestSprint(sprintEvent: RemoteEvent, wantsToSprint: boolean)
    if requested == wantsToSprint then
        return
    end
    requested = wantsToSprint
    sprintEvent:FireServer(wantsToSprint)
end

function SprintController.Init()
    if started then
        return
    end
    started = true
    local sprintEvent = getSprintEvent()

    UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessedEvent: boolean)
        if gameProcessedEvent then
            return
        end
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = true
            requestSprint(sprintEvent, true)
        end
    end)

    UserInputService.InputEnded:Connect(function(input: InputObject)
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = nil
            requestSprint(sprintEvent, next(heldShift) ~= nil)
        end
    end)

    UserInputService.WindowFocusReleased:Connect(function()
        table.clear(heldShift)
        requestSprint(sprintEvent, false)
    end)

    -- TODO: mobile onscreen sprint button and console/gamepad input (e.g. thumbstick click) should
    -- also call requestSprint(sprintEvent, true/false) here once those input modalities are built

    -- Presentation reads the server-replicated StaminaCurrent/StaminaMax/IsSprinting attributes.
end

return SprintController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">StashPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Definitions = require(game:GetService("ReplicatedStorage").Shared.Constants.Ingredients)
local Controller = {}
local started = false
function Controller.Init()
    if started then
        return
    end
    started = true
    local visible: { [ProximityPrompt]: boolean } = {}
    local function label(id: string): string
        local definition = Definitions[id]
        return if definition then definition.DisplayName or id else id
    end
    local function update(prompt: ProximityPrompt)
        local slot = prompt.Parent
        if not slot then
            visible[prompt] = nil
            return
        end
        local player = Players.LocalPlayer
        local heldAttribute = player:GetAttribute("HeldIngredientId")
        local held = if typeof(heldAttribute) == "string" then heldAttribute else nil
        local heldType = player:GetAttribute("HeldItemType")
        local slotType = slot:GetAttribute("StashItemType")
        local idAttribute = slot:GetAttribute("StashIngredientId")
        local id = if typeof(idAttribute) == "string" then idAttribute else nil
        local countAttribute = slot:GetAttribute("StashCount")
        local count = if typeof(countAttribute) == "number" then countAttribute else 0
        if slot:GetAttribute("StashOwnerUserId") ~= player.UserId then
            prompt.ActionText = "Owner only"
        elseif heldType == "Smoothie" then
            prompt.ActionText = if count > 0 then "Slot occupied" else "Store smoothie"
        elseif held and slotType == "Smoothie" then
            prompt.ActionText = "Slot occupied"
        elseif held then
            if count >= 5 then
                prompt.ActionText = "Slot full (5/5)"
            elseif id and id ~= held then
                prompt.ActionText = "Different ingredient"
            else
                prompt.ActionText = "Store " .. label(held) .. (if count > 0 then " (" .. count .. "/5)" else "")
            end
        elseif slotType == "Smoothie" and count > 0 then
            prompt.ActionText = "Take smoothie"
        elseif id and count > 0 then
            prompt.ActionText = "Take " .. label(id) .. " (" .. count .. "/5)"
        else
            prompt.ActionText = "Hold an item to store"
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt)
        if prompt:GetAttribute("PlayerStashPrompt") then
            visible[prompt] = true
            update(prompt)
        end
    end)
    ProximityPromptService.PromptHidden:Connect(function(prompt)
        visible[prompt] = nil
    end)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        for prompt in visible do
            update(prompt)
        end
    end)
end
return Controller
]]></string>
            </Properties>
