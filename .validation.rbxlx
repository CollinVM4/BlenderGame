        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">SprintEvents</string>
            <string name="Source"><![CDATA[--!strict
-- Client -> server sprint intent (boolean). Server-owned Player attributes replicate state.
local remoteEvent: RemoteEvent? = nil
local RunService = game:GetService("RunService")

return function(): RemoteEvent
    if remoteEvent == nil then
        local existing = script:FindFirstChild("SprintRequest")
        if existing and existing:IsA("RemoteEvent") then
            remoteEvent = existing
        else
            if not RunService:IsServer() then
                remoteEvent = script:WaitForChild("SprintRequest") :: RemoteEvent
                return remoteEvent :: RemoteEvent
            end
            local newEvent = Instance.new("RemoteEvent")
            newEvent.Name = "SprintRequest"
            newEvent.Parent = script
            remoteEvent = newEvent
        end
    end

    return remoteEvent :: RemoteEvent
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">UnstuckEvents</string>
            <string name="Source"><![CDATA[--!strict
-- Intent boolean or destination-free recovery request. Server publishes eligibility.
local remoteEvent: RemoteEvent? = nil
local RunService = game:GetService("RunService")

return function(): RemoteEvent
    if remoteEvent == nil then
        local existing = script:FindFirstChild("UnstuckRequest")
        if existing and existing:IsA("RemoteEvent") then
            remoteEvent = existing
        else
            if not RunService:IsServer() then
                remoteEvent = script:WaitForChild("UnstuckRequest") :: RemoteEvent
                return remoteEvent :: RemoteEvent
            end
            local newEvent = Instance.new("RemoteEvent")
            newEvent.Name = "UnstuckRequest"
            newEvent.Parent = script
            remoteEvent = newEvent
        end
    end

    return remoteEvent :: RemoteEvent
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">FilmCamPath</string>
          <string name="Source"><![CDATA[--!strict
-- Numeric, JSON-safe tracks. No services or engine instances; reusable by CLI tests.
local Path = {}
export type Key = { Time: number, Position: { number }, Rotation: { number }, Fov: number }
export type Take = { Version: number, Name: string, Duration: number, Keys: { Key } }
type Segment = { Start: number, Length: number, Coefficients: { { number } }, A: Key, B: Key, Dot: number }
export type Track = { Duration: number, Segments: { Segment } }

function Path.Allowed(studio: boolean, userId: number, ids: { number }): boolean
    return studio or table.find(ids, userId) ~= nil
end

function Path.ShouldSample(previous: Key, nextKey: Key, positionThreshold: number, rotationThreshold: number): boolean
    local distance, dot = 0, 0
    for i = 1, 3 do
        distance += (previous.Position[i] - nextKey.Position[i]) ^ 2
    end
    for i = 1, 4 do
        dot += previous.Rotation[i] * nextKey.Rotation[i]
    end
    return distance > positionThreshold ^ 2
        or 2 * math.acos(math.clamp(math.abs(dot), 0, 1)) > rotationThreshold
        or math.abs(previous.Fov - nextKey.Fov) > 0.01
end

local function finite(value: any): boolean
    return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Path.Validate(value: any): (boolean, string)
    if type(value) ~= "table" or value.Version ~= 1 or type(value.Name) ~= "string" or #value.Name > 100 then
        return false, "Invalid take header"
    end
    if not finite(value.Duration) or value.Duration <= 0 or value.Duration > 300 then
        return false, "Duration must be within 5 minutes"
    end
    if type(value.Keys) ~= "table" or #value.Keys < 2 or #value.Keys > 3002 then
        return false, "Take needs 2..3002 keys"
    end
    local last = -1
    for _, key in value.Keys do
        if type(key) ~= "table" or not finite(key.Time) or key.Time <= last or key.Time > value.Duration then
            return false, "Key times must increase"
        end
        if not finite(key.Fov) or key.Fov < 1 or key.Fov > 120 then
            return false, "Invalid FOV"
        end
        for _, field in { "Position", "Rotation" } do
            local array = key[field]
            local size = if field == "Position" then 3 else 4
            if type(array) ~= "table" or #array ~= size then
                return false, "Invalid transform"
            end
            for _, number in array do
                if not finite(number) then
                    return false, "Non-finite transform"
                end
            end
        end
        local q = key.Rotation
        if math.abs(q[1] ^ 2 + q[2] ^ 2 + q[3] ^ 2 + q[4] ^ 2 - 1) > 0.001 then
            return false, "Quaternion must be normalized"
        end
        last = key.Time
    end
    if value.Keys[1].Time ~= 0 or last ~= value.Duration then
        return false, "Track must include both endpoints"
    end
    return true, ""
end

local function samePosition(a: Key, b: Key): boolean
    return a.Position[1] == b.Position[1] and a.Position[2] == b.Position[2] and a.Position[3] == b.Position[3]
end

function Path.Compile(take: Take): Track
    local valid, message = Path.Validate(take)
    assert(valid, message)
    local segments: { Segment } = {}
    for i = 1, #take.Keys - 1 do
        local a, b = take.Keys[i], take.Keys[i + 1]
        local previous = take.Keys[math.max(1, i - 1)]
        local following = take.Keys[math.min(#take.Keys, i + 2)]
        local p0, p3 = previous.Position, following.Position
        local coefficients = {}
        for axis = 1, 3 do
            local x0, x1, x2, x3 = p0[axis], a.Position[axis], b.Position[axis], p3[axis]
            -- Timestamp-aware Catmull-Rom tangents keep velocity continuous
            -- when delta filtering leaves unequally spaced key times.
            local length = b.Time - a.Time
            local m1 = if i == 1 then (x2 - x1) / 2 else (x2 - x0) * length / (b.Time - previous.Time)
            local m2 = if i == #take.Keys - 1 then (x2 - x1) / 2 else (x3 - x1) * length / (following.Time - a.Time)
            -- Explicit hold anchors must remain still, without spline overshoot.
            if samePosition(a, b) then
                m1, m2 = 0, 0
            end
            if i > 1 and samePosition(previous, a) then
                m1 = 0
            end
            if i < #take.Keys - 1 and samePosition(b, following) then
                m2 = 0
            end
            coefficients[axis] = { x1, m1, 3 * (x2 - x1) - 2 * m1 - m2, 2 * (x1 - x2) + m1 + m2 }
        end
        local dot = 0
        for axis = 1, 4 do
            dot += a.Rotation[axis] * b.Rotation[axis]
        end
        table.insert(segments, {
            Start = a.Time,
            Length = b.Time - a.Time,
            Coefficients = coefficients,
            A = a,
            B = b,
            Dot = math.clamp(dot, -1, 1),
        })
    end
    return { Duration = take.Duration, Segments = segments }
end

local function polynomial(c: { number }, t: number): number
    return ((c[4] * t + c[3]) * t + c[2]) * t + c[1]
end

-- Scalar returns keep the render loop free of Lua table allocations (including seek).
function Path.Evaluate(track: Track, time: number): (number, number, number, number, number, number, number, number)
    local segments = track.Segments
    local low, high = 1, #segments
    while low < high do
        local mid = math.floor((low + high + 1) / 2)
        if segments[mid].Start <= time then
            low = mid
        else
            high = mid - 1
        end
    end
    local segment = segments[low]
    local t = math.clamp((time - segment.Start) / segment.Length, 0, 1)
    local dot = math.abs(segment.Dot)
    local sign = if segment.Dot < 0 then -1 else 1
    local a, b = 1 - t, t
    if dot < 0.9995 then
        local angle = math.acos(dot)
        local denominator = math.sin(angle)
        a, b = math.sin((1 - t) * angle) / denominator, math.sin(t * angle) / denominator
    end
    b *= sign
    local q0, q1 = segment.A.Rotation, segment.B.Rotation
    local x, y, z, w = a * q0[1] + b * q1[1], a * q0[2] + b * q1[2], a * q0[3] + b * q1[3], a * q0[4] + b * q1[4]
    local norm = math.sqrt(x * x + y * y + z * z + w * w)
    return polynomial(segment.Coefficients[1], t),
        polynomial(segment.Coefficients[2], t),
        polynomial(segment.Coefficients[3], t),
        x / norm,
        y / norm,
        z / norm,
        w / norm,
        segment.A.Fov + (segment.B.Fov - segment.A.Fov) * t
end

local function startIntegral(v: number, edge: number): number
    local u = v / edge
    return edge * (u ^ 3 - u ^ 4 / 2)
end

-- Integrates a smooth speed ramp at either end, preserving exact endpoints/duration.
function Path.EasedTime(time: number, duration: number, enabled: boolean): number
    local t = math.clamp(time, 0, duration)
    if not enabled then
        return t
    end
    local edge = math.min(0.5, duration / 2)
    local area = duration - edge
    if t < edge then
        return startIntegral(t, edge) * duration / area
    end
    if t > duration - edge then
        return duration - startIntegral(duration - t, edge) * duration / area
    end
    return (t - edge / 2) * duration / area
end

return Path
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">IngredientItem</string>
          <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Config = require(Shared.Constants.Ripeness)
local Ingredients = require(Shared.Constants.Ingredients)
local Item = {}

function Item.New(id: string, itemId: string, origin: Types.IngredientOrigin?): Types.IngredientItem
    return {
        IngredientId = id,
        ItemId = itemId,
        Origin = origin or "Unknown",
        RipenessStoredSeconds = 0,
        IsRipe = false,
    }
end

function Item.ApplySourceMetadata(object: Instance, item: Types.IngredientItem)
    if item.IngredientId == "PlayerHead" then
        object:SetAttribute("SourceUserId", item.SourceUserId)
        object:SetAttribute("SourceDisplayName", item.SourceDisplayName)
        object:SetAttribute("SourceUsername", item.SourceUsername)
    end
end

function Item.GetStoredRipenessSeconds(item: Types.IngredientItem, now: number): number
    if item.IsRipe then
        return Config.RipenessSeconds
    end
    return math.clamp(
        item.RipenessStoredSeconds + (if item.RipenessStoredAt then math.max(0, now - item.RipenessStoredAt) else 0),
        0,
        Config.RipenessSeconds
    )
end

function Item.GetRipenessProgress(item: Types.IngredientItem, now: number): number
    return Item.GetStoredRipenessSeconds(item, now) / Config.RipenessSeconds
end

function Item.IsRipe(item: Types.IngredientItem, now: number): boolean
    return item.IsRipe or Item.GetRipenessProgress(item, now) >= 1
end

-- Mutations are server-owned; clients can use the pure timing helpers above.
function Item.Resolve(item: Types.IngredientItem, now: number)
    if Item.IsRipe(item, now) then
        item.IsRipe = true
        item.RipenessStoredSeconds = Config.RipenessSeconds
        item.RipenessStoredAt = nil
    end
end

function Item.EnterStash(item: Types.IngredientItem, now: number)
    Item.Resolve(item, now)
    if not item.IsRipe and not item.RipenessStoredAt then
        item.RipenessStoredAt = now
    end
end

function Item.ExitStash(item: Types.IngredientItem, now: number)
    item.RipenessStoredSeconds = Item.GetStoredRipenessSeconds(item, now)
    item.RipenessStoredAt = nil
    Item.Resolve(item, now)
end

function Item.GetIngredientValue(item: Types.IngredientItem, now: number): number
    return Ingredients[item.IngredientId].Value * (if Item.IsRipe(item, now) then Config.RipenessValueMultiplier else 1)
end

function Item.CopyAll(items: { Types.IngredientItem }?): { Types.IngredientItem }?
    if not items then
        return nil
    end
    local copy = {}
    for _, item in items do
        table.insert(copy, table.clone(item))
    end
    return copy
end

-- Legacy ID-only smoothies represent fresh ingredients. New smoothies retain units.
function Item.GetSmoothieIngredientValue(
    data: { Ingredients: { string }, IngredientItems: { Types.IngredientItem }? },
    index: number,
    now: number
): number
    local unit = data.IngredientItems and data.IngredientItems[index]
    return if unit then Item.GetIngredientValue(unit, now) else Ingredients[data.Ingredients[index]].Value
end

function Item.GetSmoothieValue(
    data: { Ingredients: { string }, IngredientItems: { Types.IngredientItem }? },
    now: number
): number
    local total = 0
    for index in data.Ingredients do
        total += Item.GetSmoothieIngredientValue(data, index, now)
    end
    return total
end

return Item
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">IngredientName</string>
          <string name="Source"><![CDATA[--!strict
-- Instance identity never changes the shared ingredient definition.
local IngredientName = {}

function IngredientName.Resolve(id: string, fallback: string, sourceUserId: any, sourceDisplayName: any): string
    if
        id == "PlayerHead"
        and typeof(sourceUserId) == "number"
        and sourceUserId > 0
        and typeof(sourceDisplayName) == "string"
        and string.find(sourceDisplayName, "%S")
    then
        return sourceDisplayName .. "'s Head"
    end
    return fallback
end

return IngredientName
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">IngredientPreviewGeometry</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Geometry = {}

-- An allowlist of geometry classes excludes scripts, joints, constraints, audio,
-- prompts, effects and object references before the copy enters a live tree.
function Geometry.Clone(source: Instance?): Model?
    if not source or not (source:IsA("BasePart") or source:IsA("Model")) then
        return nil
    end
    local clone: Instance? = nil
    local ok = pcall(function()
        clone = source:Clone()
    end)
    if not ok or not clone then
        return nil
    end
    local copy = clone :: Instance
    local descendants = copy:GetDescendants()
    table.insert(descendants, 1, copy)
    local parts = 0
    for _, object in descendants do
        if object ~= copy and not object:IsDescendantOf(copy) then
            continue
        end
        if
            not (
                object:IsA("Model")
                or object:IsA("Folder")
                or object:IsA("BasePart")
                or object:IsA("DataModelMesh")
                or object:IsA("Decal")
                or object:IsA("Texture")
                or object:IsA("SurfaceAppearance")
                or object:IsA("Bone")
            )
        then
            object:Destroy()
            continue
        end
        for _, tag in CollectionService:GetTags(object) do
            CollectionService:RemoveTag(object, tag)
        end
        for key in object:GetAttributes() do
            object:SetAttribute(key, nil)
        end
        if object:IsA("BasePart") then
            parts += 1
            object.Anchored = true
            object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
            object.AssemblyLinearVelocity, object.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
        end
    end
    if parts == 0 then
        copy:Destroy()
        return nil
    end
    local model = Instance.new("Model")
    model.Name = "PreviewGeometry"
    copy.Parent = model
    return model
end

-- Fit the bounding sphere in both camera axes with a 12% margin. A sphere
-- conservatively encloses every corner regardless of the three-quarter angle.
function Geometry.Distance(size: Vector3, aspect: number, fieldOfView: number): number
    local halfVertical = math.rad(fieldOfView) / 2
    local halfHorizontal = math.atan(math.tan(halfVertical) * math.max(aspect, 0.01))
    return math.max(0.1, size.Magnitude / 2) * 1.12 / math.sin(math.min(halfVertical, halfHorizontal))
end

return Geometry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">LuckyBlockRewardVisual</string>
          <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.LuckyBlockPresentation)
local Visual = {}

function Visual.Pose(position: Vector3): CFrame
    return CFrame.new(position + Vector3.new(0, Config.HeightOffset, 0))
        * CFrame.Angles(math.rad(Config.TiltDegrees), math.rad(Config.RevealYawDegrees), 0)
end

local function prepare(copy: Instance, model: Model, silhouette: boolean): Model?
    local descendants = copy:GetDescendants()
    table.insert(descendants, 1, copy)
    local parts = 0
    for _, object in descendants do
        if object ~= copy and not object:IsDescendantOf(copy) then
            continue
        end
        local geometry = object:IsA("Model")
            or object:IsA("Folder")
            or object:IsA("BasePart")
            or object:IsA("DataModelMesh")
            or object:IsA("Bone")
        local appearance = object:IsA("Decal") or object:IsA("Texture") or object:IsA("SurfaceAppearance")
        local effect = object:IsA("Attachment")
            or object:IsA("ParticleEmitter")
            or object:IsA("Light")
            or object:IsA("Trail")
            or object:IsA("Beam")
        if not (geometry or (not silhouette and (appearance or effect))) then
            object:Destroy()
            continue
        end
        for _, tag in CollectionService:GetTags(object) do
            CollectionService:RemoveTag(object, tag)
        end
        -- Native Clone preserves authored attributes. Never manually write/clear RBX_ attributes:
        -- imported metadata such as RBX_ReimportId requires CoreScript permission.
        if object:IsA("BasePart") then
            parts += 1
            object.Anchored = true
            object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
            object.AssemblyLinearVelocity, object.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            if silhouette then
                object.Color = Color3.new(0, 0, 0)
                object.Material = Enum.Material.SmoothPlastic
                object.MaterialVariant = ""
                object.Transparency = 0
                object.LocalTransparencyModifier = 0
                object.Reflectance = 0
                if object:IsA("PartOperation") then
                    object.UsePartColor = true
                end
                if object:IsA("MeshPart") then
                    object.TextureID = ""
                end
            end
        elseif silhouette and object:IsA("SpecialMesh") then
            object.TextureId = ""
            object.VertexColor = Vector3.zero
        end
    end
    if parts == 0 then
        copy:Destroy()
        return nil
    end
    model.Name = "LuckyBlockRewardVisual"
    copy.Parent = model
    local _, size = model:GetBoundingBox()
    model:ScaleTo(model:GetScale() * Config.ModelSize / math.max(size.X, size.Y, size.Z, 0.001))
    local bounds = model:GetBoundingBox()
    model:PivotTo(model:GetPivot() - bounds.Position)
    return model
end

-- Clone imported art without gameplay, physics, or inherited world-item tags.
function Visual.Clone(source: Instance?, silhouette: boolean): Model?
    if not source or not (source:IsA("BasePart") or source:IsA("Model")) then
        return nil
    end
    local ok, cloned = pcall(function()
        return source:Clone()
    end)
    if not ok or not cloned then
        return nil
    end
    local copy = cloned :: Instance
    local model = Instance.new("Model")
    local prepared, result = pcall(prepare, copy, model, silhouette)
    if not prepared or not result then
        copy:Destroy()
        model:Destroy()
        return nil
    end
    return result
end

return Visual
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">MobilePromptDebug</string>
          <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Debug = {}
-- Set on the server in Studio; Workspace replicates the flag to playtest clients.
-- Nil/false by default. Never emit diagnostics in a published server.
function Debug.Log(prompt: ProximityPrompt, stage: string, detail: string?)
    if not RunService:IsStudio() or workspace:GetAttribute("DebugMobilePrompts") ~= true then
        return
    end
    print("[MobilePrompt] " .. stage .. " | " .. prompt:GetFullName() .. (if detail then " | " .. detail else ""))
end
return Debug
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">MoneyFormat</string>
          <string name="Source"><![CDATA[--!strict
local MoneyFormat = {}

-- Full whole-dollar cash HUD display; never abbreviates large balances.
function MoneyFormat.Full(value: number): string
    local digits = string.format("%.0f", math.floor(math.abs(value)))
    local grouped = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return (if value < 0 then "-$" else "$") .. grouped
end

-- Announcement precision is independent of the established world-label rounding.
function MoneyFormat.Announcement(value: number): string
    local magnitude = math.abs(value)
    local divisor = if magnitude >= 1e6 then 1e6 elseif magnitude >= 1e3 then 1e3 else 1
    local suffix = if divisor == 1e6 then "M" elseif divisor == 1e3 then "K" else ""
    local amount = string.format("%.2f", magnitude / divisor):gsub("0+$", ""):gsub("%.$", "")
    return (if value < 0 then "-$" else "$") .. amount .. suffix
end

-- Display-only rounding to the nearest $500 (halfway values round away from zero).
function MoneyFormat.Compact(value: number): string
    local rounded = math.floor(math.abs(value) / 500 + 0.5) * 500
    if rounded == 0 then
        return "$0K"
    end
    return MoneyFormat.Announcement(if value < 0 then -rounded else rounded)
end

return MoneyFormat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">TutorialTargets</string>
          <string name="Source"><![CDATA[--!strict
-- Paths are plot-relative except the shared Central Market. Folder assemblies expand into visible parts.
local CollectionService = game:GetService("CollectionService")
local Targets = {}
local paths: { [string]: { { string } } } = {
    ClaimPlot = { { "PlotIdentity", "ClaimVisual" } },
    Ladder = { { "Ladder" } },
    Blender = { { "Blender", "Glass" } },
    Turbine = {
        { "Turbine Wheel", "turbine", "anchor" },
        { "Turbine Wheel", "turbine", "blade" },
        { "Turbine Wheel", "turbine", "stem" },
    },
    Dispenser = { { "Dispenser" } },
    BuyRow = { { "Farm", "Row1", "PurchasePoint1" } },
    Counter = { { "Customer Area", "Counter", "Base Structure", "Base" } },
}
-- Raw authored roots are also available to the opt-in presentation diagnostics.
function Targets.GetRoots(plot: Instance?, stage: string, stashSlot: number?): { Instance }
    local roots: { Instance } = {}
    if stage == "Market" or stage == "MarketJump" then
        local market = workspace:FindFirstChild("Central Market")
        local base = if market
            then market:FindFirstChild(if stage == "MarketJump" then "JUMP1HIGHLIGHT" else "CentralMarketBase")
            else nil
        return if base and base:IsA("BasePart") then { base } else roots
    end
    if not plot or not plot:IsDescendantOf(workspace) then
        return roots
    end
    if stage == "Plant" or stage == "Harvest" then
        local farm = plot:FindFirstChild("Farm")
        local row = if farm then farm:FindFirstChild("Row1") else nil
        if stage == "Harvest" and row then
            for _, reference in row:GetChildren() do
                if reference.Name == "TutorialHarvestTarget" and reference:IsA("ObjectValue") then
                    local product = reference.Value
                    if product and product:IsDescendantOf(workspace) and not table.find(roots, product) then
                        table.insert(roots, product)
                    end
                end
            end
            if #roots > 0 then
                return roots
            end
        end
        local visual = if row then row:FindFirstChild("Visual") else nil
        if visual then
            for _, name in { "Pebble", "plank2", "Pebble & plank2" } do
                local spot = visual:FindFirstChild(name)
                if spot then
                    table.insert(roots, spot)
                end
            end
            if #roots == 0 then
                table.insert(roots, visual)
            end
        end
        return roots
    end
    if stage == "Stash" then
        if not stashSlot then
            return roots
        end
        local fixtures = {}
        for _, fixture in CollectionService:GetTagged("PlayerStash") do
            if fixture:IsDescendantOf(plot) then
                table.insert(fixtures, fixture)
            end
        end
        local stash = if #fixtures == 1 then fixtures[1] else plot:FindFirstChild("Stash")
        if not stash then
            return roots
        end
        local slots = {}
        for _, part in stash:GetDescendants() do
            if part:IsA("BasePart") and part:GetAttribute("SlotIndex") == stashSlot then
                table.insert(slots, part)
            end
        end
        local authoredSlot = stash:FindFirstChild("Slot" .. stashSlot)
        if
            #slots ~= 1
            or not authoredSlot
            or (slots[1] ~= authoredSlot and not slots[1]:IsDescendantOf(authoredSlot))
        then
            return roots
        end
        -- Exact authored slot and nested lowercase base. A slot Model already
        -- includes its base, so it receives just one local gleam.
        local slotTarget = if authoredSlot:IsA("Model") or authoredSlot:IsA("BasePart") then authoredSlot else slots[1]
        table.insert(roots, slotTarget)
        local base = authoredSlot:FindFirstChild("base")
        if base and base:IsA("BasePart") and base ~= slotTarget and not slotTarget:IsA("Model") then
            table.insert(roots, base)
        end
        return roots
    end
    local targetStage = if stage == "DrainBatch" then "Dispenser" elseif stage == "FinishBatch" then "Turbine" else stage
    local stagePaths: { { string } } = paths[targetStage] or {}
    for _, path in stagePaths do
        local object: Instance? = plot
        for _, name in path do
            object = if object then object:FindFirstChild(name) else nil
        end
        if object then
            table.insert(roots, object)
        end
    end
    return roots
end
function Targets.Resolve(plot: Instance?, stage: string, stashSlot: number?, customer: Instance?): { Instance }
    local result: { Instance } = {}
    if stage ~= "Market" and stage ~= "MarketJump" and (not plot or not plot:IsDescendantOf(workspace)) then
        return result
    end
    if stage == "Serve" or stage == "Order" or stage == "NextCustomer" then
        if
            customer
            and customer:IsDescendantOf(workspace)
            and customer:GetAttribute("PlotSessionId") == plot:GetAttribute("PlotSessionId")
        then
            table.insert(result, customer)
        end
        return result
    end
    local function add(object: Instance?)
        if not object then
            return
        end
        if object:IsA("Model") or object:IsA("BasePart") then
            table.insert(result, object)
        else
            for _, part in object:GetDescendants() do
                if part:IsA("BasePart") and part.Transparency < 1 then
                    table.insert(result, part)
                end
            end
        end
    end
    for _, object in Targets.GetRoots(plot, stage, stashSlot) do
        add(object)
    end
    return result
end
local function stationary(object: Instance?): boolean
    if not object or not object:IsA("BasePart") then
        return false
    end
    local root = object.AssemblyRootPart
    return object.Anchored or (root and root.Anchored) == true
end
local function stableMarker(object: Instance?): (BasePart | Attachment)?
    if object and object:IsA("Attachment") and stationary(object.Parent) then
        return object
    elseif object and object:IsA("BasePart") and stationary(object) then
        return object
    end
    return nil
end
local function stemTarget(plot: Instance): (BasePart | Attachment)?
    local wheel = plot:FindFirstChild("Turbine Wheel")
        or plot:FindFirstChild("Turbine", true)
        or plot:FindFirstChild("turbine", true)
    if not wheel then
        return nil
    end
    -- Never use the TurbineWheel tag: it intentionally identifies spinning geometry.
    for _, name in { "stem", "Stem", "shaft", "Shaft" } do
        local stem = wheel:FindFirstChild(name, true)
        if stem and stem:IsA("BasePart") and stationary(stem) then
            for _, markerName in { "TurbineBeamTarget", "TurbinePromptOrigin" } do
                local marker = stableMarker(stem:FindFirstChild(markerName))
                if marker then
                    return marker
                end
            end
            return stem
        end
    end
    return nil -- Retry when the stationary stem replicates; never substitute a blade/proxy.
end
local function dispenserTarget(plot: Instance): (BasePart | Attachment)?
    local marker = stableMarker(plot:FindFirstChild("DispenserTextOrigin", true))
    if marker then
        return marker
    end
    local dispenser = plot:FindFirstChild("Dispenser")
    if not dispenser then
        return nil
    end
    for _, child in dispenser:GetDescendants() do
        if child:IsA("ProximityPrompt") and child.Parent and child.Parent:IsA("Attachment") then
            local origin = stableMarker(child.Parent)
            if origin then
                return origin
            end
        end
    end
    if dispenser:IsA("BasePart") and stationary(dispenser) then
        return dispenser
    end
    for _, child in dispenser:GetDescendants() do
        if child:IsA("BasePart") and stationary(child) then
            return child
        end
    end
    return nil
end
-- Resolve inside the validated plot, or the exact shared Market root.
function Targets.ResolveBeam(
    plot: Instance?,
    stage: string,
    stashSlot: any,
    objective: Instance?
): (BasePart | Attachment)?
    if stage == "Market" or stage == "MarketJump" then
        local base = Targets.GetRoots(nil, stage)[1]
        return if base == objective and base and base:IsA("BasePart") then base else nil
    end
    if not plot or not plot:IsDescendantOf(workspace) then
        return nil
    end
    if stage == "Turbine" or stage == "FinishBatch" then
        return stemTarget(plot)
    elseif stage == "Dispenser" or stage == "DrainBatch" then
        return dispenserTarget(plot)
    end
    if not objective or not objective:IsDescendantOf(workspace) then
        return nil
    end
    if stage == "Order" or stage == "Serve" or stage == "NextCustomer" then
        if objective:GetAttribute("PlotSessionId") ~= plot:GetAttribute("PlotSessionId") then
            return nil
        end
    elseif stage == "Harvest" then
        if not table.find(Targets.GetRoots(plot, stage), objective) then
            return nil
        end
    elseif not objective:IsDescendantOf(plot) then
        return nil
    end
    local target = objective
    if stage == "Blender" then
        for _, input in CollectionService:GetTagged("BlenderInput") do
            if input:IsA("BasePart") and input:IsDescendantOf(plot) then
                local marker = input:FindFirstChild("VacuumTarget")
                return if marker and marker:IsA("Attachment") then marker else input
            end
        end
    elseif stage == "Stash" then
        if type(stashSlot) ~= "number" or Targets.GetRoots(plot, stage, stashSlot)[1] ~= objective then
            return nil
        end
    end
    if target:IsA("Attachment") and target.Parent and target.Parent:IsA("BasePart") then
        return target
    end
    -- Reuse the attachment actually used by a prompt before choosing geometry.
    for _, child in target:GetDescendants() do
        if
            child:IsA("ProximityPrompt")
            and child.Parent
            and child.Parent:IsA("Attachment")
            and child.Parent.Parent
            and child.Parent.Parent:IsA("BasePart")
        then
            return child.Parent
        end
    end
    if target:IsA("BasePart") then
        return target
    end
    local root = target:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        return root
    end
    local part = target:FindFirstChildWhichIsA("BasePart", true)
    return if part and part:IsA("BasePart") then part else nil
end
return Targets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
export type BlendState = "EMPTY" | "LOADING" | "READY" | "BLENDING" | "COMPLETE" | "DISPENSED"
export type DayState = "PREP" | "SERVING" | "FINISHED"
export type Grade = "A" | "B" | "C" | "D"
export type IngredientOrigin = "Market" | "Farm" | "Muncher" | "Event" | "Unknown"
export type IngredientItem = {
    IngredientId: string,
    ItemId: string,
    Origin: IngredientOrigin,
    RipenessStoredSeconds: number,
    RipenessStoredAt: number?,
    IsRipe: boolean,
    SourceUserId: number?,
    SourceDisplayName: string?,
    SourceUsername: string?,
    -- Opaque server-only appearance identity; never contains an Instance.
    VisualKey: {}?,
    AnnouncementOwnership: AnnouncementOwnership?,
}
export type SmoothieData = { BlendId: string, Ingredients: { string }, IngredientItems: { IngredientItem }? }
export type AnnouncementOwnership = { LastOwnerUserId: number? }
export type StashSlot = {
    Value: number?,
    Ingredients: { IngredientItem },
    SlotIndex: number,
    ItemType: ("Ingredient" | "Smoothie")?,
    IngredientId: string?,
    Smoothie: SmoothieData?,
    Count: number,
    Capacity: number,
    Protected: boolean,
}
export type Stack = { IngredientId: string, Count: number }
export type Smoothie = {
    BlendId: string?,
    Ingredients: { string },
    IngredientItems: { IngredientItem }?,
    Tags: { string },
    Color: Color3,
    Discovery: string?,
}
export type DiscoveryState = {
    Ingredients: { [string]: boolean },
    SpecialCustomers: { [string]: boolean },
}
export type DiscoveryEvent = { Kind: "Ingredient" | "SpecialCustomer", Id: string }
export type PersonalPlayerData = {
    Upgrades: { CarryCapacity: number, StackSize: number },
    Discoveries: { [string]: boolean },
    Discovery: DiscoveryState,
    Stats: { CustomersServed: number, SmoothiesMade: number, PlayersSlapped: number, IngredientsStolen: number },
}
-- Compatibility snapshot: shared fields are projections, never a stored personal record.
export type PlayerData = {
    Cash: number,
    Upgrades: {
        Bat: number,
        Hand: number,
        CarryCapacity: number,
        StackSize: number,
        BlendSpeed: number,
        Payout: number,
        MovementSpeed: number,
        Jump: number,
        SprintStamina: number,
    },
    Discoveries: { [string]: boolean },
    Discovery: DiscoveryState,
    Stats: { CustomersServed: number, SmoothiesMade: number, PlayersSlapped: number, IngredientsStolen: number },
}
export type PlotRequestContext = { PlotSessionId: string, MembershipRevision: number }
export type PlotSessionState = {
    PlotId: string,
    PlotSessionId: string,
    OwnerUserId: number,
    TeammateUserId: number?,
    JoinMode: string,
    StandName: string,
    StandNameRevision: number,
    SharedCash: number,
    SharedUpgrades: { [string]: number },
    Status: string,
    MembershipRevision: number,
}
return {}
]]></string>
        </Properties>
