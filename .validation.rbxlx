        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">JackedNoobLogic</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.JackedNoob)
local Logic = {}

export type State = { [Player]: number }

function Logic.TryReward(
    deadlines: State,
    player: Player,
    now: number,
    hasSpace: () -> boolean,
    grant: () -> boolean
): string
    if now < (deadlines[player] or 0) then
        return "Greedy.. Come back later.."
    end
    if not hasSpace() then
        return "Your hands are full, buddy."
    end
    if not grant() then
        return "Can't grab it right now, buddy."
    end
    deadlines[player] = now + Config.ProteinCooldownSeconds
    return "lil bro, you look like you need this."
end

function Logic.LocalTarget(size: Vector3, margin: number, random: Random): Vector3
    local x = math.max(0, size.X / 2 - margin)
    local z = math.max(0, size.Z / 2 - margin)
    return Vector3.new(random:NextNumber(-x, x), 0, random:NextNumber(-z, z))
end

function Logic.ReturnTarget(localPosition: Vector3, size: Vector3, margin: number): Vector3
    local x = math.max(0, size.X / 2 - margin)
    local z = math.max(0, size.Z / 2 - margin)
    return Vector3.new(math.clamp(localPosition.X, -x, x), 0, math.clamp(localPosition.Z, -z, z))
end

return Logic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">JackedNoobService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Constants.JackedNoob)
local Logic = require(script.Parent.JackedNoobLogic)
local WorldUtil = require(script.Parent.WorldUtil)

local Service = {}
local deadlines: Logic.State = {}
local busy: { [Player]: boolean } = {}
local talkDeadlines: { [Player]: number } = {}
local active: Model? = nil
local template: Model? = nil
local spawn: CFrame? = nil
local response: RemoteEvent
local inventory: any
local random = Random.new()

local function validRig(model: Model): (Humanoid?, BasePart?, BasePart?)
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    local head = model:FindFirstChild("Head")
    if humanoid and root and root:IsA("BasePart") and head and head:IsA("BasePart") then
        return humanoid, root, head
    end
    return nil, nil, nil
end

local function disableLegacy(model: Model)
    for _, name in { "Move", "Respawn" } do
        local old = model:FindFirstChild(name, true)
        if old and (old:IsA("Script") or old:IsA("LocalScript")) then
            old.Disabled = true
        end
    end
end

local bind: (Model) -> ()
bind = function(model: Model)
    if active or model:GetAttribute("NPCId") ~= Config.NPCId then
        return
    end
    local humanoid, root, head = validRig(model)
    local zone = workspace:FindFirstChild("NoobRoam")
    if not humanoid or not root or not head or not zone or not zone:IsA("BasePart") then
        warn("[JackedNoob] Requires a tagged R6 NPC and Workspace.NoobRoam BasePart")
        return
    end
    active = model
    if not template then
        spawn = model:GetPivot()
        disableLegacy(model)
        model.Archivable = true
        template = model:Clone()
    end
    disableLegacy(model)
    if root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end

    local origin = head:FindFirstChild("JackedNoobTalkOrigin")
    if not origin or not origin:IsA("Attachment") then
        origin = Instance.new("Attachment")
        origin.Name = "JackedNoobTalkOrigin"
        origin.Position = Vector3.new(0, head.Size.Y * 0.55, 0)
        origin.Parent = head
    end
    local prompt = WorldUtil.Prompt(head, "JackedNoobTalk", "TALK")
    prompt.Style = Enum.ProximityPromptStyle.Custom
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.MaxActivationDistance = Config.InteractionDistance
    prompt:SetAttribute("JackedNoobPrompt", true)
    prompt:SetAttribute("InteractionOrigin", origin.Name)
    prompt:SetAttribute("InteractionActionText", "TALK")
    local promptConnection = prompt.Triggered:Connect(function(player: Player)
        if busy[player] or not player:IsDescendantOf(Players) or active ~= model or humanoid.Health <= 0 then
            return
        end
        if not WorldUtil.Near(player, head, Config.InteractionDistance) then
            return
        end
        local now = workspace:GetServerTimeNow()
        if now < (talkDeadlines[player] or 0) then
            return
        end
        talkDeadlines[player] = now + 1
        busy[player] = true
        local ok, line = pcall(Logic.TryReward, deadlines, player, now, function()
            return inventory.GetCarryCount(player) < inventory.GetCarryCapacity(player)
        end, function()
            return inventory.GrantIngredient(player, Config.ProteinIngredientId)
        end)
        busy[player] = nil
        if not ok then
            warn("[JackedNoob] Reward failed: " .. tostring(line))
            line = "Can't grab it right now, buddy."
        end
        response:FireClient(player, head, line)
    end)

    local alive = true
    task.spawn(function()
        while alive and active == model and humanoid.Health > 0 do
            task.wait(random:NextNumber(Config.RoamIdleMinSeconds, Config.RoamIdleMaxSeconds))
            if not alive or active ~= model or humanoid.Health <= 0 then
                break
            end
            local localPosition = zone.CFrame:PointToObjectSpace(root.Position)
            local halfX = zone.Size.X / 2
            local halfZ = zone.Size.Z / 2
            local outside = math.abs(localPosition.X) > halfX + Config.RoamEdgeMargin
                or math.abs(localPosition.Z) > halfZ + Config.RoamEdgeMargin
            local localTarget = if outside
                then Logic.ReturnTarget(localPosition, zone.Size, Config.RoamEdgeMargin)
                else Logic.LocalTarget(zone.Size, Config.RoamEdgeMargin, random)
            local worldTarget = zone.CFrame:PointToWorldSpace(localTarget)
            humanoid:MoveTo(Vector3.new(worldTarget.X, root.Position.Y, worldTarget.Z))
            humanoid.MoveToFinished:Wait()
        end
    end)

    humanoid.Died:Connect(function()
        if active ~= model then
            return
        end
        alive = false
        promptConnection:Disconnect()
        prompt:Destroy()
        active = nil
        task.delay(Config.RespawnSeconds, function()
            if active or not template or not spawn then
                return
            end
            model:Destroy()
            local replacement = template:Clone()
            replacement:PivotTo(spawn)
            active = replacement -- Guard DescendantAdded while parenting the clone.
            replacement.Parent = workspace
            active = nil
            bind(replacement)
        end)
    end)
end

function Service.Init(services: any)
    inventory = services.InventoryService
    response = Instance.new("RemoteEvent")
    response.Name = "JackedNoobResponse"
    response.Parent = ReplicatedStorage
    Players.PlayerRemoving:Connect(function(player)
        deadlines[player] = nil
        talkDeadlines[player] = nil
        busy[player] = nil
    end)
    workspace.DescendantAdded:Connect(function(object)
        if object:IsA("Model") and object:GetAttribute("NPCId") == Config.NPCId then
            task.defer(bind, object)
        end
    end)
    for _, object in workspace:GetDescendants() do
        if object:IsA("Model") and object:GetAttribute("NPCId") == Config.NPCId then
            bind(object)
            break
        end
    end
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local WorldUtil = require(script.Parent.WorldUtil)
local MarketService = {}
local CollectionService = game:GetService("CollectionService")
local deps: any
local pedestals: { [BasePart]: { Item: Instance?, RespawnAt: number, Id: string, Seconds: number } } = {}
function MarketService.Init(services)
    deps = services
end
function MarketService.Register(pedestal: BasePart)
    if
        CollectionService:HasTag(pedestal, "IngredientSpawn")
        or CollectionService:HasTag(pedestal, "AnnouncedIngredientSpawn")
    then
        warn("[MarketService] Use only one spawn tag: " .. pedestal:GetFullName())
        return
    end
    if not pedestals[pedestal] then
        local id = pedestal:GetAttribute("IngredientId")
        if typeof(id) ~= "string" or not deps.IngredientService.GetDefinition(id) then
            warn("[MarketService] Set an explicit valid IngredientId: " .. pedestal:GetFullName())
            return
        end
        local seconds = pedestal:GetAttribute("RespawnSeconds")
        if typeof(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 or seconds == math.huge then
            seconds = Economy.MarketRespawnSeconds
        end
        pedestals[pedestal] = { Item = nil, RespawnAt = 0, Id = id, Seconds = seconds :: number }
    end
end
function MarketService.Unregister(pedestal: BasePart)
    local state = pedestals[pedestal]
    pedestals[pedestal] = nil
    pedestal:SetAttribute("StockIngredientId", nil)
    if state and state.Item then
        state.Item:Destroy()
    end
end
function MarketService.Step()
    local now = os.clock()
    for pedestal, state in pedestals do
        if state.Item and not deps.IngredientService.GetRecord(state.Item) then
            -- Retire stock moved out of Workspace before allowing a replacement.
            state.Item:Destroy()
            state.Item = nil
            state.RespawnAt = now + state.Seconds
            pedestal:SetAttribute("StockIngredientId", nil)
        end
        if pedestal:IsDescendantOf(workspace) and not state.Item and now >= state.RespawnAt then
            local id = state.Id
            state.Item =
                deps.IngredientService.Spawn(id, pedestal.CFrame * CFrame.new(0, pedestal.Size.Y / 2 + 1, 0), nil, true)
            if state.Item then
                pedestal:SetAttribute("StockIngredientId", id)
            else
                state.RespawnAt = now + state.Seconds
            end
        end
    end
end
function MarketService.Claim(player: Player, pedestal: BasePart): boolean
    local state = pedestals[pedestal]
    if not state or not state.Item or not WorldUtil.Near(player, pedestal, Economy.InteractionDistance) then
        return false
    end
    if not deps.InventoryService.CarryWorldItem(player, state.Item) then
        return false
    end
    state.Item = nil
    state.RespawnAt = os.clock() + state.Seconds
    pedestal:SetAttribute("StockIngredientId", nil)
    return true
end
-- Server-only drop boundary for future ant defeat handlers.
function MarketService.SpawnDrop(at: CFrame, id: string): Instance?
    return deps.IngredientService.Spawn(id, at, nil)
end
return require(script.Parent.StudioServices).Wrap("MarketService", MarketService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local RunService = game:GetService("RunService")
local Upgrades = require(Shared.Constants.Upgrades)
local SprintConfig = require(Shared.Constants.SprintConfig)
local MovementService = {}
local data: any
local stunned: { [Player]: boolean? } = {}
type Stats = { BaseWalkSpeed: number, SprintWalkSpeed: number, MaxStamina: number, JumpPower: number }
local resolved: { [Player]: Stats } = {}
local overrides: { [Player]: { [string]: number? } } = {}
local changed = Instance.new("BindableEvent")
MovementService.Changed = changed.Event

function MovementService.Init(dependencies)
    data = dependencies.TycoonService
end

function MovementService.IsInitialized(player: Player): boolean
    return resolved[player] ~= nil
end

function MovementService.GetBaseWalkSpeed(player: Player): number
    return resolved[player].BaseWalkSpeed
end
function MovementService.GetSprintWalkSpeed(player: Player): number
    return resolved[player].SprintWalkSpeed
end
function MovementService.GetMaxStamina(player: Player): number
    return resolved[player].MaxStamina
end
function MovementService.GetJumpPower(player: Player): number
    return resolved[player].JumpPower
end

local function applyJump(player: Player, humanoid: Humanoid)
    local power = if MovementService.IsStunned(player) then 0 else MovementService.GetJumpPower(player)
    if humanoid.UseJumpPower then
        humanoid.JumpPower = power
    else
        humanoid.JumpHeight = power * power / (2 * workspace.Gravity)
    end
end

function MovementService.IsStunned(player: Player): boolean
    return stunned[player] == true
end

function MovementService.CanPerformGameplayAction(player: Player): boolean
    return not MovementService.IsStunned(player)
end

function MovementService.SetStunned(player: Player, value: boolean)
    stunned[player] = if value then true else nil
    player:SetAttribute("Stunned", value)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid and resolved[player] then
        applyJump(player, humanoid)
        if value then
            humanoid.Jump = false
            humanoid.WalkSpeed = 0
        end
    end
    if resolved[player] then
        changed:Fire(player)
    end
end

function MovementService.RefreshPlayer(player: Player)
    local speedIndex = data.GetUpgrade(player, "MovementSpeed")
    local jumpIndex = data.GetUpgrade(player, "Jump")
    local staminaIndex = data.GetUpgrade(player, "SprintStamina")
    local debugLevels: { [string]: number? } = overrides[player] or {}
    local effectiveSpeed = if debugLevels.MovementSpeed ~= nil then debugLevels.MovementSpeed + 1 else speedIndex
    local effectiveJump = if debugLevels.Jump ~= nil then debugLevels.Jump + 1 else jumpIndex
    local effectiveStamina = if debugLevels.SprintStamina ~= nil then debugLevels.SprintStamina + 1 else staminaIndex
    local speed = Upgrades.MovementSpeed[effectiveSpeed].Value
    resolved[player] = {
        BaseWalkSpeed = speed,
        SprintWalkSpeed = speed * SprintConfig.SPRINT_SPEED_MULTIPLIER,
        MaxStamina = Upgrades.SprintStamina[effectiveStamina].Value,
        JumpPower = Upgrades.Jump[effectiveJump].Value,
    }
    player:SetAttribute("MovementSpeedLevel", effectiveSpeed - 1)
    player:SetAttribute("JumpLevel", effectiveJump - 1)
    player:SetAttribute("SprintStaminaLevel", effectiveStamina - 1)
    player:SetAttribute("BaseWalkSpeed", speed)
    player:SetAttribute("SprintWalkSpeed", resolved[player].SprintWalkSpeed)
    player:SetAttribute("StaminaMax", resolved[player].MaxStamina)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    end
    changed:Fire(player)
end

-- Bootstrap owns the sole CharacterAdded connection. Never block its other resets.
function MovementService.ApplyCharacter(player: Player, character: Model)
    MovementService.RefreshPlayer(player)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    else
        task.spawn(function()
            local pending = character:WaitForChild("Humanoid", 5)
            if pending and pending:IsA("Humanoid") and player.Character == character and resolved[player] then
                applyJump(player, pending)
            end
        end)
    end
end

local function assertStudioServer()
    assert(RunService:IsServer() and RunService:IsStudio() and RunService:IsRunning(), "Studio Play server only")
end

function MovementService.SetStudioLevel(player: Player, track: string, level: number?)
    assertStudioServer()
    assert(track == "MovementSpeed" or track == "Jump" or track == "SprintStamina", "Invalid movement track")
    assert(
        level == nil or (type(level) == "number" and level >= 0 and level <= 3 and level == math.floor(level)),
        "Invalid displayed level; expected 0-3"
    )
    assert(resolved[player] ~= nil, "Movement player is not initialized")
    local levels = overrides[player] or {}
    levels[track] = level
    overrides[player] = levels
    MovementService.RefreshPlayer(player)
end

function MovementService.ResetStudioOverrides(player: Player)
    assertStudioServer()
    overrides[player] = nil
    MovementService.RefreshPlayer(player)
end

function MovementService.GetStudioSnapshot(player: Player)
    assertStudioServer()
    local result = table.clone(resolved[player])
    return result, table.clone(overrides[player] or {})
end

function MovementService.RemovePlayer(player: Player)
    stunned[player] = nil
    resolved[player] = nil
    overrides[player] = nil
end
return require(script.Parent.StudioServices).Wrap("MovementService", MovementService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">MuncherService</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Muncher)
local WorldUtil = require(script.Parent.WorldUtil)
local MovementService = require(script.Parent.MovementService)
local Service = {}
local deps: any
type State = {
    Progress: number,
    Multiplier: number,
    ExpiresAt: number,
    ActiveBuff: string?,
    Purchased: boolean,
    Revealed: boolean,
    ReadyAt: number,
}
local states: { [string]: State } = {}
local nextFeed: { [Player]: number } = {}
local random = Random.new()

function Service.Init(services: any)
    deps = services
end

function Service.Reset(player: Player)
    local id = deps.TycoonService.GetSessionId(player)
    if id then
        states[id] = { Progress = 0, Multiplier = 1, ExpiresAt = 0, Purchased = false, Revealed = false, ReadyAt = 0 }
    end
end

function Service.CleanupSession(id: string)
    states[id] = nil
end

function Service.RemovePlayer(player: Player)
    nextFeed[player] = nil
end

local function activate(state: State)
    local buff = Config.Buffs[random:NextInteger(1, #Config.Buffs)]
    state.ActiveBuff = buff.Id
    state.Multiplier = buff.CashMultiplier
    state.ExpiresAt = workspace:GetServerTimeNow() + Config.BuffDuration
    state.Progress = 0
end

local function expire(state: State)
    if state.ActiveBuff and workspace:GetServerTimeNow() >= state.ExpiresAt then
        state.ActiveBuff, state.Multiplier, state.ExpiresAt = nil, 1, 0
        if state.Progress == Config.Required then
            activate(state)
        end
    end
end

function Service.GetSnapshot(player: Player): any
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    if not state then
        return nil
    end
    expire(state)
    return {
        Progress = state.Progress,
        Target = Config.Required,
        Multiplier = state.Multiplier,
        ExpiresAt = state.ExpiresAt,
        ActiveBuff = state.ActiveBuff,
        BuffExpiresAt = state.ExpiresAt,
        Purchased = state.Purchased,
        Active = state.Revealed,
        ReadyAt = state.ReadyAt,
    }
end

-- Reuse the existing shared-cash cost/callback transaction adapter. Its name is
-- historical; it debits the plot session ledger, including for teammates.
function Service.TryPurchase(player: Player, pad: BasePart, context: any): (boolean, string?)
    local plot = deps.TycoonService.GetPlot(player)
    local model = plot and plot:FindFirstChild("Muncher")
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    if
        not state
        or not model
        or model:FindFirstChild("PurchasePoint1") ~= pad
        or not WorldUtil.Near(player, pad, Config.FeedDistance)
    then
        return false, "InvalidPurchase"
    end
    if state.Purchased then
        return false, "AlreadyPurchased"
    end
    return deps.TycoonService.PurchasePersonalUpgrade(
        player,
        context or deps.TycoonService.GetRequestContext(player),
        Config.PurchaseCost,
        function()
            state.Purchased = true
            state.ReadyAt = workspace:GetServerTimeNow() + Config.RevealSeconds
        end
    )
end

-- Called only by the server assembly presenter after placing every part at rest.
function Service.CompleteReveal(player: Player, model: Instance): boolean
    local plot = deps.TycoonService.GetPlot(player)
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    if
        not state
        or not plot
        or plot:FindFirstChild("Muncher") ~= model
        or not state.Purchased
        or workspace:GetServerTimeNow() < state.ReadyAt
    then
        return false
    end
    state.Revealed = true
    return true
end

function Service.GetCashMultiplier(player: Player): number
    local snapshot = Service.GetSnapshot(player)
    return if snapshot then snapshot.Multiplier else 1
end

local function inputFor(player: Player): BasePart?
    local plot = deps.TycoonService.GetPlot(player)
    local muncher = plot and plot:FindFirstChild("Muncher")
    local input = muncher and muncher:FindFirstChild("InputZone")
    return if input and input:IsA("BasePart") then input else nil
end

local function advance(state: State)
    state.Progress += 1
    if state.Progress == Config.Required and not state.ActiveBuff then
        activate(state)
    end
end

-- Both intake paths commit synchronously under the plot's existing lifecycle lock.
-- Returns only cosmetic data after authoritative removal has succeeded.
function Service.TryFeed(player: Player, input: BasePart, object: Instance?, context: any): (boolean, string?, CFrame?)
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    if state then
        expire(state)
    end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not state
        or not state.Revealed
        or state.Progress >= Config.Required
        or inputFor(player) ~= input
        or not MovementService.CanPerformGameplayAction(player)
        or not humanoid
        or humanoid.Health <= 0
    then
        return false
    end
    local ingredientId: string?
    local at: CFrame?
    if object then
        local record = deps.IngredientService.GetRecord(object)
        local part = WorldUtil.Part(object)
        if
            not record
            or not part
            or object:GetAttribute("FrozenUntilPickup") == true
            or (record.Owner ~= nil and record.Owner ~= player)
            or (record.Owner == nil and not record.Claimable)
            or not deps.IngredientService.GetDefinition(record.Id)
        then
            return false
        end
        local overlaps = false
        for _, touching in workspace:GetPartsInPart(input) do
            if deps.IngredientService.Resolve(touching) == object then
                overlaps = true
                break
            end
        end
        if not overlaps then
            return false
        end
        ingredientId, at = record.Id, part.CFrame
    else
        if
            not WorldUtil.Near(player, input, Config.FeedDistance)
            or workspace:GetServerTimeNow() < (nextFeed[player] or 0)
        then
            return false
        end
        ingredientId = deps.InventoryService.GetHeldIngredientId(player)
        if not ingredientId or not deps.IngredientService.GetDefinition(ingredientId) then
            return false
        end
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        at = if root and root:IsA("BasePart") then root.CFrame * CFrame.new(0, 4, 0) else input.CFrame
    end
    local token = deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not token then
        return false
    end
    local consumed = if object
        then deps.IngredientService.Consume(object)
        else deps.InventoryService.ConsumeHeldIngredient(player, ingredientId)
    if consumed then
        advance(state)
        if not object then
            nextFeed[player] = workspace:GetServerTimeNow() + Config.FeedCooldown
        end
    end
    deps.TycoonService.EndTransaction(token)
    return consumed ~= nil, consumed, at
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">PhysicsService</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local PhysicsService = {}

function PhysicsService.GetSpinStrength(part: BasePart): number
    if not part or not part:IsA("BasePart") then
        return 0
    end

    local angularVelocity = part.AssemblyAngularVelocity
    return angularVelocity.Magnitude
end

function PhysicsService.GetBlendDelta(part: BasePart, deltaTime: number?): number
    -- Preserve the old one-argument API; dt-aware callers no longer depend on framerate.
    return PhysicsService.GetSpinStrength(part) * Economy.BlendProgressScale * (deltaTime or 1 / 60)
end

-- Display/debugging only; gameplay uses angular speed directly.
function PhysicsService.GetRPM(part: BasePart): number
    return PhysicsService.GetSpinStrength(part) * 60 / (2 * math.pi)
end

return PhysicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local Upgrades = require(game:GetService("ReplicatedStorage").Shared.Constants.Upgrades)
local PlayerDataService = {}
local records: { [Player]: Types.PersonalPlayerData } = {}
local runtime: any
function PlayerDataService.BindRuntimeAuthority(authority: any)
    runtime = authority
end
local entitlements: { [Player]: { [string]: boolean } } = {}

local function data(player: Player): Types.PersonalPlayerData
    assert(records[player], "PlayerDataService: player is not initialized")
    return records[player]
end
function PlayerDataService.AddPlayer(player: Player)
    records[player] = {
        Upgrades = {
            CarryCapacity = 1,
            StackSize = 1,
        },
        Discoveries = {},
        Discovery = { Ingredients = {}, SpecialCustomers = {} },
        Stats = { CustomersServed = 0, SmoothiesMade = 0, PlayersSlapped = 0, IngredientsStolen = 0 },
    }
    entitlements[player] = { VIPStorage = false, DoubleCash = false }
    player:SetAttribute("playerCash", 0)
    player:SetAttribute("HasSmoothie", false)
    player:SetAttribute("CarryCapacity", Upgrades.CarryCapacity[1].Value)
    player:SetAttribute("CarryCapacityLevel", 0)
    for _, id in { "Bat", "MovementSpeed", "Jump", "SprintStamina" } do
        player:SetAttribute(id .. "Level", 0)
    end
end
-- Server-only mutable save-data boundary. Older in-memory profiles may omit Discovery.
function PlayerDataService.GetDiscoveryState(player: Player): Types.DiscoveryState?
    local record = records[player]
    if not record then
        return nil
    end
    local discovery: Types.DiscoveryState = record.Discovery or { Ingredients = {}, SpecialCustomers = {} }
    discovery.Ingredients = discovery.Ingredients or {}
    discovery.SpecialCustomers = discovery.SpecialCustomers or {}
    record.Discovery = discovery
    return discovery
end
function PlayerDataService.GetSnapshot(player: Player): Types.PlayerData
    local source = data(player)
    local discovery = PlayerDataService.GetDiscoveryState(player) :: Types.DiscoveryState
    return {
        Discovery = {
            Ingredients = table.clone(discovery.Ingredients),
            SpecialCustomers = table.clone(discovery.SpecialCustomers),
        },
        Cash = PlayerDataService.GetCash(player),
        Upgrades = {
            Bat = PlayerDataService.GetUpgrade(player, "Bat"),
            Hand = PlayerDataService.GetUpgrade(player, "Hand"),
            CarryCapacity = PlayerDataService.GetUpgrade(player, "CarryCapacity"),
            StackSize = PlayerDataService.GetUpgrade(player, "StackSize"),
            BlendSpeed = PlayerDataService.GetUpgrade(player, "BlendSpeed"),
            Payout = PlayerDataService.GetUpgrade(player, "Payout"),
            MovementSpeed = PlayerDataService.GetUpgrade(player, "MovementSpeed"),
            Jump = PlayerDataService.GetUpgrade(player, "Jump"),
            SprintStamina = PlayerDataService.GetUpgrade(player, "SprintStamina"),
        },
        Discoveries = table.clone(source.Discoveries),
        Stats = table.clone(source.Stats),
    }
end
-- Compatibility projection only: no personal cash or shared-upgrade copies are stored.
function PlayerDataService.GetCash(player: Player): number
    return if runtime then runtime.GetCash(player) else 0
end
function PlayerDataService.SetCash(player: Player, amount: number): number
    assert(runtime, "Session authority is not bound")
    return runtime.SetCash(player, amount)
end
function PlayerDataService.AddCash(player: Player, amount: number): number
    assert(runtime, "Session authority is not bound")
    return runtime.AddCash(player, amount)
end
function PlayerDataService.GetUpgrade(player: Player, id: string): number
    if id ~= "CarryCapacity" and id ~= "StackSize" then
        return if runtime then runtime.GetUpgrade(player, id) else 1
    end
    return (data(player).Upgrades :: any)[id] or 1
end
function PlayerDataService.PurchaseUpgrade(
    player: Player,
    id: string,
    requestedLevel: number?,
    context: any
): (boolean, string?)
    if not runtime then
        return false, "NoSession"
    end
    if runtime.IsSharedUpgrade(id) then
        return runtime.PurchaseUpgrade(player, id, requestedLevel, context)
    end
    if id ~= "CarryCapacity" and id ~= "StackSize" then
        return false, "InvalidUpgrade"
    end
    local levels = (Upgrades :: any)[id]
    local nextLevel = PlayerDataService.GetUpgrade(player, id) + 1
    if requestedLevel ~= nextLevel then
        return false, "InvalidLevel"
    end
    local definition = levels[nextLevel]
    if not definition then
        return false, "MaxLevel"
    end
    return runtime.PurchasePersonalUpgrade(player, context, definition.Cost, function()
        (data(player).Upgrades :: any)[id] = nextLevel
        if id == "CarryCapacity" then
            player:SetAttribute("CarryCapacity", definition.Value)
            player:SetAttribute("CarryCapacityLevel", nextLevel - 1)
        end
    end)
end
function PlayerDataService.HasEntitlement(player: Player, id: string): boolean
    return entitlements[player] ~= nil and entitlements[player][id] == true
end
-- Server-only boundary for a future verified MarketplaceService entitlement adapter.
function PlayerDataService.SetEntitlement(player: Player, id: string, enabled: boolean)
    assert(id == "VIPStorage" or id == "DoubleCash", "Unknown entitlement")
    entitlements[player][id] = enabled
end
function PlayerDataService.RecordDiscovery(player: Player, id: string)
    data(player).Discoveries[id] = true
end
function PlayerDataService.IncrementStat(player: Player, id: string)
    local stats = data(player).Stats :: any
    assert(stats[id] ~= nil, "Unknown stat")
    stats[id] += 1
end
function PlayerDataService.RemovePlayer(player: Player)
    -- TODO: persist a snapshot before releasing state; no DataStore writes in this skeleton.
    records[player] = nil
    entitlements[player] = nil
end
return require(script.Parent.StudioServices).Wrap("PlayerDataService", PlayerDataService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">PlayerHeadDropService</string>
            <string name="Source"><![CDATA[--!strict
-- Observe actual character death; damage and ingredient ownership stay in their services.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Item = require(game:GetService("ReplicatedStorage").Shared.IngredientItem)
local Service = {}
local deps: any
local states: { [Player]: { Character: Model, Connections: { RBXScriptConnection } } } = {}
-- Retain the guard through teardown/rebinding, without keeping old characters alive.
local observed = setmetatable({} :: { [Model]: boolean }, { __mode = "k" })

function Service.Init(services: any)
    deps = services
end

function Service.RemovePlayer(player: Player)
    local state = states[player]
    if state then
        states[player] = nil
        for _, connection in state.Connections do
            connection:Disconnect()
        end
    end
end

function Service.ApplyCharacter(player: Player, character: Model)
    if player.Character ~= character or Players:GetPlayerFromCharacter(character) ~= player then
        return
    end
    if states[player] and states[player].Character == character then
        return
    end
    Service.RemovePlayer(player)
    if observed[character] then
        return
    end
    observed[character] = true
    local state = { Character = character, Connections = {} :: { RBXScriptConnection } }
    states[player] = state
    local bound, dropped = false, false
    local function bind(humanoid: Humanoid)
        if bound or states[player] ~= state then
            return
        end
        bound = true
        table.insert(
            state.Connections,
            humanoid.Died:Connect(function()
                if
                    dropped
                    or states[player] ~= state
                    or player.Character ~= character
                    or Players:GetPlayerFromCharacter(character) ~= player
                then
                    return
                end
                dropped = true -- Reserve before spawning or publishing any world item.
                local at = character:GetPivot()
                for _, name in { "Head", "UpperTorso", "HumanoidRootPart" } do
                    local part = character:FindFirstChild(name)
                    if part and part:IsA("BasePart") then
                        at = part.CFrame
                        break
                    end
                end
                local unit = Item.New("PlayerHead", HttpService:GenerateGUID(false))
                unit.SourceUserId = player.UserId
                unit.SourceDisplayName = player.DisplayName
                unit.SourceUsername = player.Name
                deps.IngredientService.Spawn(
                    "PlayerHead",
                    CFrame.new(at.Position + Vector3.new(0.75, 0.5, 0)),
                    nil,
                    true,
                    {
                        Item = unit,
                        VisualTemplate = character:FindFirstChild("Head"),
                    }
                )
            end)
        )
    end
    table.insert(
        state.Connections,
        player.CharacterRemoving:Connect(function(removing: Model)
            if removing == character and states[player] == state then
                Service.RemovePlayer(player)
            end
        end)
    )
    -- CharacterAdded may arrive before the Humanoid. Bind without blocking bootstrap.
    table.insert(
        state.Connections,
        character.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then
                bind(child)
            end
        end)
    )
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        bind(humanoid)
    end
end

return require(script.Parent.StudioServices).Wrap("PlayerHeadDropService", Service)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">PlayerOnlyCollisionService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")

local PlayerOnlyCollisionService = { PlayerGroup = "Players" }
local HELPER_GROUP = "PlayerOnly"
local TAG = "PlayerOnlyCollision"
local initialized = false

local function configurePart(instance: Instance)
    if instance:IsA("BasePart") then
        instance.CollisionGroup = HELPER_GROUP
        instance.CanCollide = true
    end
end

function PlayerOnlyCollisionService.Init()
    if initialized then
        return
    end
    for _, name in { PlayerOnlyCollisionService.PlayerGroup, HELPER_GROUP } do
        if not PhysicsService:IsCollisionGroupRegistered(name) then
            PhysicsService:RegisterCollisionGroup(name)
        end
    end
    -- Only the new helper's relationships change; all existing pairs stay intact.
    -- This includes any ingredient/world-item groups authored in Studio.
    for _, group in PhysicsService:GetRegisteredCollisionGroups() do
        PhysicsService:CollisionGroupSetCollidable(HELPER_GROUP, group.name, false)
    end
    PhysicsService:CollisionGroupSetCollidable(HELPER_GROUP, PlayerOnlyCollisionService.PlayerGroup, true)
    initialized = true

    CollectionService:GetInstanceAddedSignal(TAG):Connect(configurePart)
    for _, instance in CollectionService:GetTagged(TAG) do
        configurePart(instance)
    end
end

return PlayerOnlyCollisionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">PlotClaimZones</string>
            <string name="Source"><![CDATA[--!strict
-- Server samples live character roots in authored oriented boxes. No client entry
-- report or Touched callback can authorize a claim. Session creation never yields.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Constants.StandIdentity)
local Sign = require(script.Parent.StandSignPresentation)
local MovementService = require(script.Parent.MovementService)
local Zones = {}
local authority: any
local claimed: RemoteEvent
local visuals: { [BasePart]: number } = setmetatable({}, { __mode = "k" }) :: any
local styled: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local entered: { [BasePart]: { [Player]: Model } } = {}
local pendingEntry: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any

function Zones.Inside(zone: BasePart, position: Vector3): boolean
    local point = zone.CFrame:PointToObjectSpace(position)
    local half = zone.Size * 0.5
    return math.abs(point.X) <= half.X and math.abs(point.Y) <= half.Y and math.abs(point.Z) <= half.Z
end

function Zones.Enter(player: Player, plot: Instance, zone: BasePart): boolean
    local identity = plot:FindFirstChild("PlotIdentity")
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    if
        not MovementService.CanPerformGameplayAction(player)
        or not player:IsDescendantOf(Players)
        or not character
        or not character:IsDescendantOf(workspace)
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
        or not CollectionService:HasTag(plot, "PlayerPlot")
        or not plot:IsDescendantOf(workspace)
        or not identity
        or zone.Parent ~= identity
        or not Zones.Inside(zone, root.Position)
    then
        return false
    end
    if identity:FindFirstChild("ClaimZone") == zone then
        local success =
            authority.ClaimPlot(player, plot, { ClaimRevision = plot:GetAttribute("PlotClaimRevision") or 0 })
        if success and authority.GetOwner(plot) == player then
            local context = authority.GetRequestContext(player)
            claimed:FireClient(player, plot, context.PlotSessionId, context.MembershipRevision)
        end
        return success
    elseif identity:FindFirstChild("TeammateZone") == zone then
        local owner = authority.GetOwner(plot)
        return owner ~= nil
            and owner ~= player
            and authority.RequestJoin(player, plot, authority.GetRequestContext(owner))
    end
    return false
end

local function showVisual(object: Instance?, active: boolean)
    if not object then
        return
    end
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            if visuals[part] == nil then
                -- Hidden authored pads still need a visible active appearance.
                -- ActiveTransparency also lets nested invisible helpers stay invisible.
                local authored = part:GetAttribute("ActiveTransparency")
                visuals[part] = if type(authored) == "number"
                        and authored >= 0
                        and authored <= 1
                    then authored
                    elseif part.Transparency < 1 then part.Transparency
                    else 0
            end
            part.Transparency = if active then visuals[part] else 1
        end
    end
end

function Zones.Refresh(plot: Instance)
    local occupancy = plot:GetAttribute("PlotOccupancy") or 0
    local identity = plot:FindFirstChild("PlotIdentity")
    if identity then
        for _, role in { "Claim", "Teammate" } do
            local active = if role == "Claim" then occupancy == 0 else occupancy == 1
            local zone = identity:FindFirstChild(role .. "Zone")
            if zone and zone:IsA("BasePart") then
                zone.Transparency, zone.CanCollide, zone.CanTouch, zone.CanQuery = 1, false, false, false
                zone:SetAttribute("PlotZoneActive", active)
            end
            showVisual(identity:FindFirstChild(role .. "Visual"), active)
        end
    end
    local area = plot:FindFirstChild("Customer Area")
    local sign = if area then area:FindFirstChild("Dynamic Sign Text") else nil
    if sign then
        local gui = sign:FindFirstChild("SurfaceGui")
        if gui and not styled[gui] then
            Sign.Style(sign)
            styled[gui] = true
        end
        Sign.SetStandName(sign, tostring(plot:GetAttribute("StandName") or ""))
    end
end

function Zones.Step()
    local live: { [BasePart]: boolean } = {}
    for _, plot in CollectionService:GetTagged("PlayerPlot") do
        if not plot:IsDescendantOf(workspace) then
            continue
        end
        Zones.Refresh(plot)
        local identity = plot:FindFirstChild("PlotIdentity")
        if not identity then
            continue
        end
        for _, name in { "ClaimZone", "TeammateZone" } do
            local zone = identity:FindFirstChild(name)
            if not zone or not zone:IsA("BasePart") then
                continue
            end
            live[zone] = true
            local previous = entered[zone] or {}
            local current: { [Player]: Model } = {}
            local arrivals: { Player } = {}
            for _, player in Players:GetPlayers() do
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") and Zones.Inside(zone, root.Position) then
                    current[player] = player.Character :: Model
                    if previous[player] ~= player.Character and zone:GetAttribute("PlotZoneActive") then
                        table.insert(arrivals, player)
                    end
                end
            end
            entered[zone] = current
            -- Record entry before dispatch. Friendship policies can yield; the
            -- heartbeat must keep sampling without launching duplicate joins.
            for _, player in arrivals do
                if not pendingEntry[player] then
                    pendingEntry[player] = true
                    task.spawn(function()
                        local ok, message = pcall(Zones.Enter, player, plot, zone)
                        pendingEntry[player] = nil
                        if not ok then
                            warn("[PlotClaimZones] " .. tostring(message))
                        end
                        if plot:IsDescendantOf(workspace) then
                            Zones.Refresh(plot)
                        end
                    end)
                end
            end
        end
    end
    for zone in entered do
        if not live[zone] then
            entered[zone] = nil
        end
    end
end

function Zones.Init(services: any)
    authority = services.TycoonService
    claimed = Instance.new("RemoteEvent")
    claimed.Name = "PlotClaimed"
    claimed.Parent = ReplicatedStorage.Shared.Events
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed >= Config.ZoneInterval then
            elapsed = 0
            Zones.Step()
        end
    end)
end

return Zones
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">RagdollService</string>
            <string name="Source"><![CDATA[--!strict
-- Native Avatar Joint Upgrade R15 physics only. No combat, input, inventory or gameplay stun dependencies.
local RunService = game:GetService("RunService")
local RagdollService = {}
type JointState = {
    IsKinematic: boolean,
    MaxForce: number,
    MaxTorque: number,
    LinearStrength: number,
    LinearDamping: number,
    AngularStrength: number,
    AngularDamping: number,
}
type Joint = { Constraint: AnimationConstraint, Saved: JointState }
type Rig = {
    Humanoid: Humanoid,
    Root: AnimationConstraint,
    Joints: { Joint },
    Sockets: { BallSocketConstraint },
    TorsoCollision: { [BasePart]: boolean },
    Connections: { RBXScriptConnection },
    Active: boolean,
    PlatformStand: boolean,
    AutoRotate: boolean,
}
local rigs: { [Model]: Rig } = {}
-- Expected avatar body pairs. Root is validated separately and never modified.
local joints: { [string]: { string } } = {
    Neck = { "UpperTorso", "Head" },
    Waist = { "LowerTorso", "UpperTorso" },
    LeftShoulder = { "UpperTorso", "LeftUpperArm" },
    LeftElbow = { "LeftUpperArm", "LeftLowerArm" },
    LeftWrist = { "LeftLowerArm", "LeftHand" },
    RightShoulder = { "UpperTorso", "RightUpperArm" },
    RightElbow = { "RightUpperArm", "RightLowerArm" },
    RightWrist = { "RightLowerArm", "RightHand" },
    LeftHip = { "LowerTorso", "LeftUpperLeg" },
    LeftKnee = { "LeftUpperLeg", "LeftLowerLeg" },
    LeftAnkle = { "LeftLowerLeg", "LeftFoot" },
    RightHip = { "LowerTorso", "RightUpperLeg" },
    RightKnee = { "RightUpperLeg", "RightLowerLeg" },
    RightAnkle = { "RightLowerLeg", "RightFoot" },
}

-- Optional read-only Studio inventory, retained for inspecting runtime failures.
function RagdollService.InspectCharacter(character: Model)
    assert(RunService:IsStudio() and RunService:IsServer(), "Use the Studio Server Command Bar")
    local function path(object: Instance?): string
        return if object then object:GetFullName() else "nil"
    end
    local function property(object: Instance, name: string): string
        local ok, value = pcall(function()
            return (object :: any)[name]
        end)
        return if ok then tostring(value) else "unavailable"
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    print(
        string.format(
            "[Ragdoll] inspect character=%s rig=%s StarterPlayer.AvatarJointUpgrade=%s",
            path(character),
            if humanoid then tostring(humanoid.RigType) else "missing Humanoid",
            property(game:GetService("StarterPlayer"), "AvatarJointUpgrade")
        )
    )
    local counts: { [string]: number } = {
        AnimationConstraint = 0,
        Motor6D = 0,
        BallSocketConstraint = 0,
        NoCollisionConstraint = 0,
    }
    local discovered: { [string]: { string } } = {}
    local descendants = character:GetDescendants()
    table.sort(descendants, function(a, b)
        return a:GetFullName() < b:GetFullName()
    end)
    for _, object in descendants do
        local class = object.ClassName
        if counts[class] ~= nil then
            counts[class] += 1
        end
        local a: Instance? = nil
        local b: Instance? = nil
        if object:IsA("Motor6D") or object:IsA("NoCollisionConstraint") then
            a, b = object.Part0, object.Part1
            print(
                string.format(
                    "[Ragdoll] %s %s Part0=%s Part1=%s Enabled=%s",
                    class,
                    path(object),
                    path(a),
                    path(b),
                    tostring(object.Enabled)
                )
            )
        elseif object:IsA("Constraint") then
            local first, second = object.Attachment0, object.Attachment1
            a, b = if first then first.Parent else nil, if second then second.Parent else nil
            print(
                string.format(
                    "[Ragdoll] %s %s Attachment0=%s parent0=%s Attachment1=%s parent1=%s Enabled=%s",
                    class,
                    path(object),
                    path(first),
                    path(a),
                    path(second),
                    path(b),
                    tostring(object.Enabled)
                )
            )
            if class == "AnimationConstraint" then
                for _, name in
                    {
                        "IsKinematic",
                        "MaxForce",
                        "MaxTorque",
                        "LinearStrength",
                        "LinearDamping",
                        "AngularStrength",
                        "AngularDamping",
                    }
                do
                    print("[Ragdoll]   " .. name .. "=" .. property(object, name))
                end
            elseif object:IsA("BallSocketConstraint") then
                print(
                    string.format(
                        "[Ragdoll]   LimitsEnabled=%s UpperAngle=%s TwistLimitsEnabled=%s TwistLowerAngle=%s TwistUpperAngle=%s",
                        tostring(object.LimitsEnabled),
                        tostring(object.UpperAngle),
                        tostring(object.TwistLimitsEnabled),
                        tostring(object.TwistLowerAngle),
                        tostring(object.TwistUpperAngle)
                    )
                )
            end
        end
        if a and b and a.Parent == character and b.Parent == character then
            local key = a.Name .. "/" .. b.Name
            discovered[key] = discovered[key] or {}
            table.insert(discovered[key], class .. ":" .. object.Name)
        end
    end
    for class, count in counts do
        print(string.format("[Ragdoll] %s count=%d", class, count))
    end
    local expected = table.clone(joints)
    expected.Root = { "HumanoidRootPart", "LowerTorso" }
    for name, pair in expected do
        local forward = discovered[pair[1] .. "/" .. pair[2]] or {}
        local reverse = discovered[pair[2] .. "/" .. pair[1]] or {}
        print(
            string.format(
                "[Ragdoll] expected=%s pair=%s/%s forward=[%s] reverse=[%s]",
                name,
                pair[1],
                pair[2],
                table.concat(forward, ", "),
                table.concat(reverse, ", ")
            )
        )
    end
    print("[Ragdoll] inspection complete; no character properties changed")
end

local function capture(joint: AnimationConstraint): JointState
    return {
        IsKinematic = joint.IsKinematic,
        MaxForce = joint.MaxForce,
        MaxTorque = joint.MaxTorque,
        LinearStrength = joint.LinearStrength,
        LinearDamping = joint.LinearDamping,
        AngularStrength = joint.AngularStrength,
        AngularDamping = joint.AngularDamping,
    }
end

local function reject(reason: string): boolean
    warn("[Ragdoll] rejected jointSystem=AnimationConstraint: " .. reason)
    return false
end

-- Resolve the owning body part, including Roblox's nested JointRotation attachments.
local function bodyOf(attachment: Attachment?): BasePart?
    local object: Instance? = attachment
    while object do
        if object:IsA("BasePart") then
            return object
        end
        object = object.Parent
    end
    return nil
end

local function matches(character: Model, constraint: AnimationConstraint, pair: { string }): boolean
    local a, b = bodyOf(constraint.Attachment0), bodyOf(constraint.Attachment1)
    return a ~= nil
        and b ~= nil
        and a.Parent == character
        and b.Parent == character
        and ((a.Name == pair[1] and b.Name == pair[2]) or (a.Name == pair[2] and b.Name == pair[1]))
end

function RagdollService.IsRagdolled(character: Model): boolean
    local rig = rigs[character]
    return rig ~= nil and rig.Active
end

function RagdollService.PrepareCharacter(character: Model): boolean
    assert(RunService:IsServer(), "RagdollService is server-only")
    if rigs[character] then
        return true
    end
    local h = character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 or h.RigType ~= Enum.HumanoidRigType.R15 then
        return reject("a living R15 Humanoid is required")
    end
    local found: { [string]: AnimationConstraint } = {}
    local sockets: { [string]: BallSocketConstraint } = {}
    for _, object in character:GetDescendants() do
        if object:IsA("AnimationConstraint") and (object.Name == "Root" or joints[object.Name]) then
            local pair = if object.Name == "Root" then { "HumanoidRootPart", "LowerTorso" } else joints[object.Name]
            if not matches(character, object, pair) or not object.Enabled then
                return reject("invalid/disabled avatar AnimationConstraint " .. object.Name)
            end
            if found[object.Name] then
                return reject("duplicate avatar AnimationConstraint " .. object.Name)
            end
            found[object.Name] = object
        elseif object:IsA("BallSocketConstraint") then
            -- Validate the built-in named sockets without demanding identical attachments
            -- or rebuilding their articulation. Shoulders can use nested JointRotation.
            sockets[object.Name] = object
        end
    end
    local root = found.Root
    if not root or not root.IsKinematic then
        return reject("enabled kinematic Root AnimationConstraint required")
    end
    local rig: Rig = {
        Humanoid = h,
        Root = root,
        Joints = {},
        Sockets = {},
        TorsoCollision = {},
        Connections = {},
        Active = false,
        PlatformStand = h.PlatformStand,
        AutoRotate = h.AutoRotate,
    }
    for name in joints do
        local joint, socket = found[name], sockets[name .. "BallSocket"]
        if not joint then
            return reject("missing body AnimationConstraint " .. name)
        end
        if
            not socket
            or not socket.Enabled
            or not socket.Attachment0
            or not socket.Attachment1
            or not socket.Attachment0:IsDescendantOf(character)
            or not socket.Attachment1:IsDescendantOf(character)
        then
            return reject("missing/disabled built-in " .. name .. "BallSocket or its attachments")
        end
        table.insert(rig.Joints, { Constraint = joint, Saved = capture(joint) })
        table.insert(rig.Sockets, socket)
    end
    rigs[character] = rig
    table.insert(
        rig.Connections,
        h.Died:Connect(function()
            RagdollService.CleanupCharacter(character)
        end)
    )
    table.insert(
        rig.Connections,
        character.Destroying:Connect(function()
            RagdollService.CleanupCharacter(character)
        end)
    )
    table.insert(
        rig.Connections,
        character.AncestryChanged:Connect(function()
            if not character:IsDescendantOf(workspace) then
                RagdollService.CleanupCharacter(character)
            end
        end)
    )
    if RunService:IsStudio() then
        print("[Ragdoll] prepared rig=R15 jointSystem=AnimationConstraint bodyJoints=14 root=Root")
    end
    return true
end

function RagdollService.SetRagdolled(character: Model, enabled: boolean): boolean
    assert(RunService:IsServer(), "RagdollService is server-only")
    if enabled and not RagdollService.PrepareCharacter(character) then
        return false
    end
    local rig = rigs[character]
    if not rig or rig.Active == enabled then
        return true
    end
    local h = rig.Humanoid
    local changed = 0
    if enabled then
        -- Reject a rig changed since preparation before altering any physical state.
        if
            h.Health <= 0
            or not rig.Root:IsDescendantOf(character)
            or not rig.Root.Enabled
            or not rig.Root.IsKinematic
        then
            return reject("rig no longer has a living Humanoid and kinematic Root")
        end
        for _, joint in rig.Joints do
            if not joint.Constraint:IsDescendantOf(character) or not joint.Constraint.Enabled then
                return reject("body AnimationConstraint removed/disabled since preparation")
            end
        end
        for _, socket in rig.Sockets do
            if not socket:IsDescendantOf(character) or not socket.Enabled then
                return reject("built-in BallSocket removed/disabled since preparation")
            end
        end
        -- Refresh snapshots at each OFF -> ON edge; repeated ON cannot overwrite them.
        local upper, lower = character:FindFirstChild("UpperTorso"), character:FindFirstChild("LowerTorso")
        if not upper or not upper:IsA("BasePart") or not lower or not lower:IsA("BasePart") then
            return reject("UpperTorso and LowerTorso required for core world collision")
        end
        rig.TorsoCollision = { [upper] = upper.CanCollide, [lower] = lower.CanCollide }
        rig.PlatformStand, rig.AutoRotate = h.PlatformStand, h.AutoRotate
        for _, joint in rig.Joints do
            joint.Saved = capture(joint.Constraint)
        end
        rig.Active = true
        h.AutoRotate, h.PlatformStand = false, true
        for torso in rig.TorsoCollision do
            torso.CanCollide = true
        end
        for _, joint in rig.Joints do
            local constraint = joint.Constraint
            constraint.MaxForce, constraint.MaxTorque = 0, 0
            constraint.IsKinematic = false
            changed += 1
        end
        h:ChangeState(Enum.HumanoidStateType.Physics)
    else
        for _, joint in rig.Joints do
            local constraint, saved = joint.Constraint, joint.Saved
            if constraint.Parent then
                constraint.MaxForce, constraint.MaxTorque = saved.MaxForce, saved.MaxTorque
                constraint.LinearStrength, constraint.LinearDamping = saved.LinearStrength, saved.LinearDamping
                constraint.AngularStrength, constraint.AngularDamping = saved.AngularStrength, saved.AngularDamping
                constraint.IsKinematic = saved.IsKinematic
                changed += 1
            end
        end
        for torso, canCollide in rig.TorsoCollision do
            if torso.Parent then
                torso.CanCollide = canCollide
            end
        end
        if h.Parent then
            h.PlatformStand, h.AutoRotate = rig.PlatformStand, rig.AutoRotate
            if h.Health > 0 and not rig.PlatformStand then
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
        rig.Active = false
    end
    if RunService:IsStudio() then
        if enabled then
            print(string.format("[Ragdoll] ON changed=%d RootKinematic=%s", changed, tostring(rig.Root.IsKinematic)))
        else
            print(string.format("[Ragdoll] OFF restored=%d", changed))
        end
    end
    return true
end

function RagdollService.CleanupCharacter(character: Model)
    local rig = rigs[character]
    if not rig then
        return
    end
    RagdollService.SetRagdolled(character, false)
    rigs[character] = nil
    for _, connection in rig.Connections do
        connection:Disconnect()
    end
end

return require(script.Parent.StudioServices).Wrap("RagdollService", RagdollService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">RejectFloorButton</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local FloorButton = {}

-- A downward ground query verifies actual support, rather than counting limb
-- touches from someone brushing past the plate or standing beside it.
local function standing(actor: Player, button: BasePart): boolean
    local character = actor.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
        return false
    end
    if root.AssemblyLinearVelocity.Y > 2 then
        return false
    end
    local leg = character and character:FindFirstChild("Left Leg")
    local legHeight = if leg and leg:IsA("BasePart") then leg.Size.Y else 0
    local distance = root.Size.Y / 2 + humanoid.HipHeight + legHeight + 0.5
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character :: Model }
    params.RespectCanCollide = true
    local hit = workspace:Raycast(root.Position, Vector3.new(0, -distance, 0), params)
    return hit ~= nil and hit.Instance == button
end

function FloorButton.Bind(
    button: BasePart,
    origin: Attachment,
    getOwner: () -> Player?,
    canActivate: (Player) -> boolean,
    activate: (Player) -> boolean
): () -> ()
    local display = Instance.new("BillboardGui")
    display.Name = "RejectFloorDisplay"
    display.Adornee = origin
    display.Size = UDim2.fromOffset(220, 56)
    display.AlwaysOnTop = true
    display.MaxDistance = 20
    display.Parent = button
    local label = Instance.new("TextLabel")
    label.Name = "Action"
    label.Size = UDim2.fromOffset(260, 48)
    label.BackgroundTransparency = 1
    label.Text = "REJECT"
    TextStyle.Apply(label, 22)
    label.TextColor3 = Color3.fromRGB(255, 95, 95)
    label.Parent = display
    local line = Instance.new("Frame")
    line.Name = "Progress"
    line.Position = UDim2.fromOffset(50, 44)
    line.Size = UDim2.fromOffset(0, 6)
    line.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    line.BorderSizePixel = 0
    line.Parent = display

    local holdDuration = 2.5
    local actor: Player? = nil
    local character: Model? = nil
    local started: number? = nil
    local latched = false
    local function reset()
        started = nil
        line.Size = UDim2.fromOffset(0, 6)
        label.Text = "REJECT"
    end
    local connection = RunService.Heartbeat:Connect(function()
        local owner = getOwner()
        if owner ~= actor or (owner and owner.Character ~= character) then
            actor = owner
            character = if owner then owner.Character else nil
            latched = false
            reset()
        end
        if not button:IsDescendantOf(workspace) or not owner or not standing(owner, button) then
            latched = false
            reset()
            return
        end
        if latched then
            return
        end
        if not canActivate(owner) then
            reset()
            return
        end
        local holdStarted = started or os.clock()
        started = holdStarted
        local progress = math.clamp((os.clock() - holdStarted) / holdDuration, 0, 1)
        line.Size = UDim2.fromOffset(120 * progress, 6)
        if progress >= 1 then
            -- Latch before gameplay callbacks, which can synchronously change
            -- the queue. Staying on the plate never rejects multiple customers.
            latched = true
            if activate(owner) then
                label.Text = "STEP OFF"
            else
                latched = false
                reset()
            end
        end
    end)
    local cleaned = false
    return function()
        if cleaned then
            return
        end
        cleaned = true
        connection:Disconnect()
        display:Destroy()
    end
end

return FloorButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">SmoothieGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetic geometry only. The source Tool never becomes an inventory authority.
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local SmoothieItem = require(script.Parent.SmoothieItem)
local Geometry = {}

function Geometry.CreateTool(data: Types.SmoothieData): Tool?
    local template = ServerStorage:FindFirstChild("Smoothie")
    if not template or not template:IsA("Tool") or not template.Archivable then
        return nil
    end
    local clone = template:Clone()
    local handle = clone:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        clone:Destroy()
        return nil
    end
    -- Keep nested geometry, meshes and appearance, but rebuild all assembly joints.
    -- No scripts, prompts, live component tags or authored external welds escape.
    for _, child in clone:GetDescendants() do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        if
            child:IsA("LuaSourceContainer")
            or child:IsA("ProximityPrompt")
            or child:IsA("ClickDetector")
            or child:IsA("JointInstance")
            or child:IsA("Constraint")
            or child:IsA("WeldConstraint")
        then
            child:Destroy()
        elseif child:IsA("BasePart") then
            child.Anchored = false
            child.CanCollide = false
            child.CanTouch = false
            child.CanQuery = false
            child.Massless = true
        end
    end
    for _, tag in CollectionService:GetTags(clone) do
        CollectionService:RemoveTag(clone, tag)
    end
    clone.Enabled, clone.ManualActivationOnly = true, false
    clone.RequiresHandle, clone.CanBeDropped = true, false
    handle.Color = SmoothieItem.Result(data).Color
    for _, part in clone:GetDescendants() do
        if part:IsA("BasePart") and part ~= handle then
            local weld = Instance.new("WeldConstraint")
            weld.Name = "SmoothieAssembly"
            weld.Part0, weld.Part1 = handle, part
            weld.Parent = handle
        end
    end
    return clone
end

function Geometry.CreateVisual(data: Types.SmoothieData): Model?
    local tool = Geometry.CreateTool(data)
    if not tool then
        return nil
    end
    local handle = tool:FindFirstChild("Handle") :: BasePart
    local model = Instance.new("Model")
    model.Name = "SmoothieVisual"
    for _, child in tool:GetChildren() do
        child.Parent = model
    end
    tool:Destroy()
    handle.Name = "SmoothieRoot"
    model.PrimaryPart = handle
    return model
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">SmoothieItem</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Ingredients = require(Shared.Constants.Ingredients)
local Item = require(Shared.IngredientItem)
local SmoothieItem = {}

function SmoothieItem.Valid(data: Types.SmoothieData): boolean
    if
        type(data) ~= "table"
        or type(data.BlendId) ~= "string"
        or data.BlendId == ""
        or type(data.Ingredients) ~= "table"
    then
        return false
    end
    local count = 0
    for index, id in data.Ingredients do
        if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 3 or not Ingredients[id] then
            return false
        end
        count += 1
    end
    return count == 3
end

function SmoothieItem.Copy(data: Types.SmoothieData): Types.SmoothieData
    return {
        BlendId = data.BlendId,
        Ingredients = table.clone(data.Ingredients),
        IngredientItems = Item.CopyAll(data.IngredientItems),
    }
end

-- IDs remain compatible with grading; physical unit metadata survives cup transfers.
function SmoothieItem.Result(data: Types.SmoothieData): Types.Smoothie
    local sum = Vector3.zero
    local tags = {}
    for _, id in data.Ingredients do
        local definition = Ingredients[id]
        local color = definition.BlendColor
        sum += Vector3.new(color.R, color.G, color.B)
        for _, tag in definition.Tags do
            if not table.find(tags, tag) then
                table.insert(tags, tag)
            end
        end
    end
    sum /= 3
    return {
        BlendId = data.BlendId,
        Ingredients = table.clone(data.Ingredients),
        IngredientItems = Item.CopyAll(data.IngredientItems),
        Tags = tags,
        Color = Color3.new(sum.X, sum.Y, sum.Z),
        Discovery = nil,
    }
end

return SmoothieItem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">SmoothieWorldItemService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local SmoothieItem = require(script.Parent.SmoothieItem)
local Geometry = require(script.Parent.SmoothieGeometry)
local Service = {}
type Record = { Data: Types.SmoothieData, Claiming: boolean }
local records: { [Instance]: Record } = {}

function Service.GetData(object: Instance): Types.SmoothieData?
    local record = records[object]
    return if record
            and not record.Claiming
            and object:IsDescendantOf(workspace)
        then SmoothieItem.Copy(record.Data)
        else nil
end

function Service.Spawn(data: Types.SmoothieData, at: CFrame): Model?
    if not SmoothieItem.Valid(data) then
        return nil
    end
    local object = Geometry.CreateVisual(data)
    if not object then
        return nil
    end
    object.Name = "SmoothieWorldItem"
    object:SetAttribute("BlendId", data.BlendId)
    for index = 1, 3 do
        object:SetAttribute("IngredientId" .. index, data.Ingredients[index])
    end
    object:PivotTo(at)
    local root = object.PrimaryPart :: BasePart
    root.CanCollide, root.CanQuery, root.Massless = true, true, false
    records[object] = { Data = SmoothieItem.Copy(data), Claiming = false }
    object.Destroying:Connect(function()
        records[object] = nil
    end)
    object.Parent = workspace
    if root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end
    CollectionService:AddTag(object, "SmoothieWorldItem")
    return object
end

-- Server-only transaction. The callback must not yield. Lock before inventory
-- signals can reenter; failure retains the same object and authoritative data.
function Service.Claim(object: Instance, receive: (Types.SmoothieData) -> boolean): boolean
    local data = Service.GetData(object)
    if not data then
        return false
    end
    local record = records[object]
    record.Claiming = true
    if not receive(data) then
        record.Claiming = false
        return false
    end
    records[object] = nil
    object:Destroy()
    return true
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">SprintService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SprintConfig = require(ReplicatedStorage.Shared.Constants.SprintConfig)
local getSprintEvent = require(ReplicatedStorage.Shared.Events.SprintEvents)

local SprintService = {}
local movement: any
local started = false

local staminaCurrent: { [Player]: number } = {}
local staminaMax: { [Player]: number } = {}
local isSprinting: { [Player]: boolean } = {}

local function ensurePlayer(player: Player)
    if staminaMax[player] == nil then
        staminaMax[player] = movement.GetMaxStamina(player)
    end
    if staminaCurrent[player] == nil then
        staminaCurrent[player] = staminaMax[player]
    end
    if isSprinting[player] == nil then
        isSprinting[player] = false
    end

    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
end

local function getHumanoid(player: Player): Humanoid?
    local character = player.Character
    if character == nil then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function setSprinting(player: Player, wantsToSprint: boolean)
    if not movement.IsInitialized(player) then
        return
    end
    ensurePlayer(player)

    if wantsToSprint and (staminaCurrent[player] <= 0 or not movement.CanPerformGameplayAction(player)) then
        wantsToSprint = false
    end

    local humanoid = getHumanoid(player)
    isSprinting[player] = wantsToSprint and humanoid ~= nil and humanoid.Health > 0
end

function SprintService.ApplySpeed(player: Player)
    local humanoid = getHumanoid(player)
    if movement.IsStunned(player) then
        isSprinting[player] = false
        player:SetAttribute("IsSprinting", false)
    end
    if humanoid then
        humanoid.WalkSpeed = if movement.IsStunned(player)
            then 0
            elseif isSprinting[player] then movement.GetSprintWalkSpeed(player)
            else movement.GetBaseWalkSpeed(player)
    end
end

function SprintService.ResetCharacter(player: Player)
    ensurePlayer(player)
    isSprinting[player] = false
    staminaMax[player] = movement.GetMaxStamina(player)
    staminaCurrent[player] = staminaMax[player]
    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
    player:SetAttribute("IsSprinting", false)
    SprintService.ApplySpeed(player)
end

-- Copy authoritative runtime values for server diagnostics; never read UI attributes.
function SprintService.GetSnapshot(player: Player)
    ensurePlayer(player)
    return {
        StaminaCurrent = staminaCurrent[player],
        StaminaMax = staminaMax[player],
        IsSprinting = isSprinting[player],
    }
end

function SprintService.RemovePlayer(player: Player)
    staminaCurrent[player] = nil
    staminaMax[player] = nil
    isSprinting[player] = nil
end

function SprintService.Init(dependencies)
    if started then
        return
    end
    started = true
    movement = dependencies.MovementService
    local sprintEvent = getSprintEvent()
    movement.Changed:Connect(function(player: Player)
        -- Deferred character/stun notifications can arrive after player cleanup.
        if not movement.IsInitialized(player) then
            return
        end
        SprintService.SetStaminaMax(player, movement.GetMaxStamina(player))
        SprintService.ApplySpeed(player)
    end)

    sprintEvent.OnServerEvent:Connect(function(player: Player, wantsToSprint: boolean)
        if type(wantsToSprint) ~= "boolean" then
            return
        end
        setSprinting(player, wantsToSprint)
    end)

    RunService.Heartbeat:Connect(function(deltaTime: number)
        for _, player in Players:GetPlayers() do
            if not movement.IsInitialized(player) then
                continue
            end
            ensurePlayer(player)

            local humanoid = getHumanoid(player)
            if not humanoid or humanoid.Health <= 0 or movement.IsStunned(player) then
                isSprinting[player] = false
            end
            if isSprinting[player] then
                staminaCurrent[player] =
                    math.max(0, staminaCurrent[player] - SprintConfig.STAMINA_DRAIN_RATE * deltaTime)
                if staminaCurrent[player] <= 0 then
                    isSprinting[player] = false
                end
            else
                staminaCurrent[player] =
                    math.min(staminaMax[player], staminaCurrent[player] + SprintConfig.STAMINA_REGEN_RATE * deltaTime)
            end

            -- Player attributes replicate authoritative state; SprintRequest is input only.
            player:SetAttribute("StaminaCurrent", staminaCurrent[player])

            player:SetAttribute("IsSprinting", isSprinting[player])
            SprintService.ApplySpeed(player)
        end
    end)
end

-- Extension point for future upgrades that increase a player's stamina capacity
function SprintService.SetStaminaMax(player: Player, newMax: number)
    assert(
        type(newMax) == "number" and newMax == newMax and newMax > 0 and newMax < math.huge,
        "Invalid stamina maximum"
    )
    ensurePlayer(player)
    local increase = math.max(0, newMax - staminaMax[player])
    staminaMax[player] = newMax
    staminaCurrent[player] = math.clamp(staminaCurrent[player] + increase, 0, newMax)
    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
end

return require(script.Parent.StudioServices).Wrap("SprintService", SprintService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">StandIdentityService</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local Config = require(ReplicatedStorage.Shared.Constants.StandIdentity)
local Sanitizer = require(script.Parent.StandNameSanitizer)
local Service = {}
local authority: any
local pending: { [Player]: boolean } = {}
local nextSave: { [Player]: number } = {}

local function valid(player: Player, plot: any, context: any): boolean
    return player.Parent ~= nil
        and typeof(plot) == "Instance"
        and authority.GetPlot(player) == plot
        and authority.GetOwner(plot) == player
        and authority.ValidateActor(player, context)
        and type(context) == "table"
        and context.StandNameRevision == plot:GetAttribute("StandNameRevision")
end

function Service.RequestName(player: Player, plot: any, value: any, context: any): (boolean, string)
    local text = Config.Normalize(value)
    if not text then
        return false, string.format("Enter a name of 1–%d characters.", Config.MaxCharacters)
    end
    if not valid(player, plot, context) then
        return false, "Stand ownership changed."
    end
    if pending[player] or os.clock() < (nextSave[player] or 0) then
        return false, "Please wait before saving again."
    end
    -- Copy submitted context across the yielding filter, never repair it afterward.
    local captured = table.clone(context)
    pending[player] = true
    nextSave[player] = os.clock() + Config.SaveCooldown
    local ok, result = pcall(function()
        -- Four stars can expand a short token. Fit only after raw validation;
        -- this never lets an oversized client submission bypass the limit.
        return TextService:FilterStringAsync(
            Config.Truncate(Sanitizer.Mask(text)),
            player.UserId,
            Enum.TextFilterContext.PublicChat
        ):GetNonChatStringForBroadcastAsync()
    end)
    pending[player] = nil
    local filtered = if ok
            and type(result) == "string"
            and #result <= Config.MaxInputBytes
        then Config.Normalize(Config.Truncate(Sanitizer.BroadcastDisplay(result)))
        else nil
    if not filtered then
        return false, "Name unavailable. Try another name."
    end
    if not valid(player, plot, captured) or not authority.CommitFilteredStandName(player, plot, filtered, captured) then
        return false, "Stand ownership changed."
    end
    return true, filtered
end

function Service.Init(services: any)
    authority = services.TycoonService
    local remote = Instance.new("RemoteFunction")
    remote.Name = "SetStandName"
    remote.OnServerInvoke = Service.RequestName
    remote.Parent = ReplicatedStorage.Shared.Events
    game:GetService("Players").PlayerRemoving:Connect(function(player)
        pending[player], nextSave[player] = nil, nil
    end)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">StandNameSanitizer</string>
            <string name="Source"><![CDATA[--!strict
-- Conservative presentation mask; Roblox TextService remains the moderation authority.
local Sanitizer = {}
local terms = {
    "fuck",
    "fucks",
    "fucked",
    "fucker",
    "fuckers",
    "fucking",
    "shit",
    "shits",
    "shitty",
    "bullshit",
    "bitch",
    "bitches",
    "ass",
    "asshole",
    "assholes",
    "bastard",
    "bastards",
    "cunt",
    "cunts",
    "dick",
    "dicks",
    "cock",
    "cocks",
    "motherfucker",
    "motherfucking",
}
-- Match inflections before their shorter roots, including separated spellings.
table.sort(terms, function(a, b)
    return #a > #b
end)

function Sanitizer.Mask(text: string): string
    for _, term in terms do
        -- ASCII token boundaries include digits/underscore/non-ASCII bytes to
        -- avoid masking inside longer names. Only punctuation, never spaces,
        -- may separate letters (f.u.c.k); do not join unrelated words.
        local letters = {}
        for index = 1, #term do
            local letter = string.sub(term, index, index)
            table.insert(letters, "[" .. letter .. string.upper(letter) .. "]")
        end
        local pattern = "%f[%w_\128-\255]" .. table.concat(letters, "[%p]*") .. "%f[^%w_\128-\255]"
        text = string.gsub(text, pattern, "****")
    end
    return text
end

function Sanitizer.BroadcastDisplay(text: string): string
    return (string.gsub(text, "#+", "****"))
end

return Sanitizer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">StandSignPresentation</string>
            <string name="Source"><![CDATA[--!strict
-- Only the editable Customer Area/Dynamic Sign Text SurfaceGui is touched.
local Style = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local Presentation = {}
local layers = { "Shadow", "Depth2", "Depth1", "Main" }
local colors = {
    Color3.fromRGB(38, 31, 43),
    Color3.fromRGB(128, 119, 150),
    Color3.fromRGB(195, 187, 211),
    Style.White,
}

function Presentation.SetStandName(signRoot: Instance, text: string)
    local gui = signRoot:FindFirstChild("SurfaceGui")
    local root = if gui and gui:IsA("SurfaceGui") then gui:FindFirstChild("TextRoot") else nil
    if not root then
        return
    end
    for _, name in layers do
        local label = root:FindFirstChild(name)
        if label and label:IsA("TextLabel") then
            label.Text = text
        end
    end
end

-- Shared with the Studio authoring helper; no letter geometry is generated.
function Presentation.Style(signRoot: Instance)
    local gui = signRoot:FindFirstChild("SurfaceGui")
    local root = if gui and gui:IsA("SurfaceGui") then gui:FindFirstChild("TextRoot") else nil
    if not root or not root:IsA("Frame") then
        return
    end
    root.BackgroundTransparency = 1
    root.Position = UDim2.fromOffset(16, 16)
    root.Size = UDim2.new(1, -38, 1, -38)
    for index, name in layers do
        local label = root:FindFirstChild(name)
        if label and label:IsA("TextLabel") then
            label.Font = Style.Font
            label.BackgroundTransparency = 1
            label.TextColor3 = colors[index]
            label.TextScaled, label.TextWrapped, label.RichText = true, true, false
            label.Size = UDim2.fromScale(1, 1)
            label.Position = UDim2.fromOffset((4 - index) * 2, (4 - index) * 2)
            label.ZIndex = index
            local constraint = label:FindFirstChildOfClass("UITextSizeConstraint")
                or Instance.new("UITextSizeConstraint")
            constraint.MinTextSize, constraint.MaxTextSize = 20, 96
            constraint.Parent = label
            local stroke = Style.Outline(label)
            stroke.Color = colors[1]
            stroke.Thickness = 3
        end
    end
end

return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">StashExpansionService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local WorldUtil = require(script.Parent.WorldUtil)
local Slots = require(script.Parent.StashSlots)
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local Service = {}

-- Match Farm's anchored-part reveal without depending on FarmService or its row state.
local function capture(root: Instance): { any }
    local saved: { any } = {}
    local objects = root:GetDescendants()
    table.insert(objects, root)
    for _, object in objects do
        if object:IsA("BasePart") then
            table.insert(saved, {
                Object = object,
                Frame = object.CFrame,
                Transparency = object.Transparency,
                Collide = object.CanCollide,
                Touch = object.CanTouch,
                Query = object.CanQuery,
            })
            object.Anchored = true
        elseif object:IsA("Decal") or object:IsA("Texture") then
            table.insert(saved, { Object = object, Transparency = object.Transparency })
        elseif
            object:IsA("LayerCollector")
            or object:IsA("ProximityPrompt")
            or object:IsA("ParticleEmitter")
            or object:IsA("Beam")
            or object:IsA("Trail")
            or object:IsA("Light")
        then
            table.insert(saved, { Object = object, Enabled = object.Enabled })
        end
    end
    return saved
end
local function show(saved: { any }, visible: boolean)
    for _, item in saved do
        local object = item.Object
        if item.Frame then
            object.Transparency = if visible then item.Transparency else 1
            object.CanCollide, object.CanTouch, object.CanQuery =
                visible and item.Collide, visible and item.Touch, visible and item.Query
        elseif item.Transparency then
            object.Transparency = if visible then item.Transparency else 1
        else
            object.Enabled = visible and item.Enabled
        end
    end
end

function Service.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot: Instance): (() -> ())?
        local row = Slots.Expansion(plot)
        local pad = row and row:FindFirstChild("PurchasePoint")
        if not row or not pad or not pad:IsA("BasePart") then
            return nil
        end
        local fixtures = services.TycoonService.GetFixtures(plot, "PlayerStash")
        if #fixtures ~= 1 then
            return nil
        end
        local resolved = Slots.Resolve(fixtures[1], row)
        for index = 6, 10 do
            if not resolved[index] then
                warn("[StashExpansion] Missing/ambiguous slot " .. index .. " in " .. row:GetFullName())
                return nil
            end
        end
        local base = row:FindFirstChild("base")
        if not base then
            warn("[StashExpansion] Missing base in " .. row:GetFullName())
            return nil
        end
        -- Only the purchased structure moves. PurchasePoint is a separate BasePart;
        -- unrelated decoration (such as shine) is not part of the reveal.
        local visual = capture(base)
        for index = 6, 10 do
            local object = row:FindFirstChild("Slot" .. index)
            assert(object) -- validated by the shared slot resolver above
            for _, item in capture(object) do
                table.insert(visual, item)
            end
        end
        local padAppearance = capture(pad)
        local motions: { any } = {}
        local connections: { RBXScriptConnection } = {}
        local generation, purchased, active = 0, false, true
        local session: any = nil
        local function stop()
            generation += 1
            for _, motion in motions do
                motion.Connection:Disconnect()
                motion.Tween:Cancel()
            end
            table.clear(motions)
            for _, item in visual do
                if item.Frame then
                    item.Object.CFrame = item.Frame
                end
            end
        end
        local function reset()
            stop()
            purchased = false
            row:SetAttribute("StashExpansionReady", false)
            show(visual, false)
            show(padAppearance, true)
            pad.CanTouch = true
            pad:SetAttribute("SecondStoragePad", true)
        end
        local function refresh()
            local owner = services.TycoonService.GetOwner(plot)
            local current = owner and services.TycoonService.GetSessionId(owner)
            if session ~= current then
                reset()
                session = current
            end
            local owned = owner ~= nil and services.TycoonService.GetUpgrade(owner, "SecondStorage") == 2
            if not owned then
                if purchased then
                    reset()
                end
                return
            end
            if purchased then
                return
            end
            purchased = true
            show(padAppearance, false)
            show(visual, true)
            -- Authored prompts also stay disabled until the reveal finishes.
            for _, object in row:GetDescendants() do
                if object:IsA("ProximityPrompt") then
                    object.Enabled = false
                end
            end
            local epoch, revealSession = generation, current
            local remaining = 0
            for _, item in visual do
                if item.Frame then
                    remaining += 1
                end
            end
            for _, item in visual do
                if item.Frame then
                    item.Object.CFrame = CFrame.new(0, -3.5, 0) * item.Frame
                    local tween = TweenService:Create(
                        item.Object,
                        TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                        { CFrame = item.Frame }
                    )
                    local connection = tween.Completed:Connect(function()
                        local currentOwner = services.TycoonService.GetOwner(plot)
                        if
                            not active
                            or epoch ~= generation
                            or not currentOwner
                            or services.TycoonService.GetSessionId(currentOwner) ~= revealSession
                        then
                            return
                        end
                        item.Object.CFrame = item.Frame
                        remaining -= 1
                        if remaining == 0 then
                            row:SetAttribute("StashExpansionReady", true)
                        end
                    end)
                    table.insert(motions, { Tween = tween, Connection = connection })
                    tween:Play()
                end
            end
        end
        reset()
        table.insert(connections, plot:GetAttributeChangedSignal("SecondStoragePurchased"):Connect(refresh))
        table.insert(connections, plot:GetAttributeChangedSignal("PlotSessionId"):Connect(refresh))
        table.insert(
            connections,
            pad.Touched:Connect(function(hit)
                if purchased or not active then
                    return
                end
                local ancestor = hit.Parent
                while ancestor and ancestor ~= workspace do
                    local player = if ancestor:IsA("Model") then Players:GetPlayerFromCharacter(ancestor) else nil
                    if player then
                        if
                            services.TycoonService.IsMember(player, plot)
                            and WorldUtil.Near(player, pad, Economy.InteractionDistance)
                        then
                            services.TycoonService.PurchaseSecondStorage(
                                player,
                                plot,
                                services.TycoonService.GetRequestContext(player)
                            )
                        end
                        return
                    end
                    ancestor = ancestor.Parent
                end
            end)
        )
        refresh()
        return function()
            active = false
            reset()
            for _, connection in connections do
                connection:Disconnect()
            end
            pad:SetAttribute("SecondStoragePad", nil)
        end
    end)
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">StashSlots</string>
            <string name="Source"><![CDATA[--!strict
-- One resolver shared by server validation and prompt binding. Authored names stay intact.
local Slots = {}
function Slots.Expansion(plot: Instance): Instance?
    return plot:FindFirstChild("UpgradeStash")
end
function Slots.Resolve(fixture: Instance, expansion: Instance?): { [number]: BasePart }
    local slots: { [number]: BasePart } = {}
    local counts: { [number]: number } = {}
    for _, object in fixture:GetDescendants() do
        local index = object:GetAttribute("SlotIndex")
        if object:IsA("BasePart") and type(index) == "number" and index % 1 == 0 and index >= 1 and index <= 5 then
            counts[index] = (counts[index] or 0) + 1
            slots[index] = object
        end
    end
    for index, count in counts do
        if count ~= 1 then
            slots[index] = nil
        end
    end
    if expansion then
        for index = 6, 10 do
            local object = expansion:FindFirstChild("Slot" .. index)
            local part: BasePart? = nil
            if object and object:IsA("BasePart") then
                part = object
            elseif object and object:IsA("Model") and object.PrimaryPart then
                part = object.PrimaryPart
            elseif object then
                -- Multipart slots can identify their interaction surface with the existing
                -- logical SlotIndex (6-10). A single-part container needs no attribute.
                local candidates: { BasePart } = {}
                local marked: { BasePart } = {}
                for _, child in object:GetDescendants() do
                    if child:IsA("BasePart") then
                        table.insert(candidates, child)
                        if child:GetAttribute("SlotIndex") == index then
                            table.insert(marked, child)
                        end
                    end
                end
                part = if #marked == 1
                    then marked[1]
                    elseif #marked == 0 and #candidates == 1 then candidates[1]
                    else nil
            end
            if part then
                slots[index] = part
            end
        end
    end
    return slots
end
return Slots
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">StashValue</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Item = require(Shared.IngredientItem)
local Types = require(Shared.Types)
local StashValue = {}
function StashValue.GetEffectiveIngredientValue(item: Types.IngredientItem): number
    Item.Resolve(item, workspace:GetServerTimeNow())
    return Item.GetIngredientValue(item, workspace:GetServerTimeNow())
end
function StashValue.Calculate(slot: any): number
    if slot.ItemType == "Smoothie" and slot.Smoothie then
        return Item.GetSmoothieValue(slot.Smoothie, workspace:GetServerTimeNow())
    end
    local total = 0
    for _, item in slot.Ingredients do
        total += StashValue.GetEffectiveIngredientValue(item)
    end
    return total
end
return StashValue
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">StudioServices</string>
            <string name="Source"><![CDATA[--!strict
-- No service requires here. Bootstrap owns initialization and publishes its live instances.
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local StudioServices = {}
local isRuntime = false
local bridgeName = "StudioServiceCalls"

local function assertStudioServer()
    assert(
        RunService:IsStudio() and RunService:IsServer() and RunService:IsRunning(),
        "[StudioServices] Use the Server Command Bar in Play mode"
    )
end

function StudioServices.BeginBootstrap()
    if RunService:IsStudio() then
        assertStudioServer()
        isRuntime = true
    end
end

function StudioServices.Publish(services: { [string]: any })
    if not RunService:IsStudio() then
        return
    end
    assertStudioServer()
    assert(isRuntime, "[StudioServices] Only server bootstrap can publish services")
    assert(not ServerStorage:FindFirstChild(bridgeName), "[StudioServices] Runtime already published")
    local bridge = Instance.new("BindableFunction")
    bridge.Name = bridgeName
    bridge.OnInvoke = function(serviceName: string, methodName: string, ...: any)
        assertStudioServer()
        assert(methodName ~= "Init", "[StudioServices] Service initialization belongs to bootstrap")
        local service = services[serviceName]
        local method = service and service[methodName]
        assert(type(method) == "function", "[StudioServices] Unknown service method")
        return method(...)
    end
    -- Parent only after the callback is ready; tooling never waits on an unbound callback.
    bridge.Parent = ServerStorage
end

function StudioServices.Wrap(name: string, service: any): any
    if not RunService:IsStudio() or isRuntime then
        return service
    end
    local proxy = {}
    for methodName, method in service do
        if type(method) == "function" then
            proxy[methodName] = function(...: any)
                assertStudioServer()
                assert(methodName ~= "Init", "[StudioServices] Service initialization belongs to bootstrap")
                local bridge = ServerStorage:FindFirstChild(bridgeName)
                assert(
                    bridge and bridge:IsA("BindableFunction"),
                    "[StudioServices] Runtime unavailable; wait for the server initialized message"
                )
                return bridge:Invoke(name, methodName, ...)
            end
        end
    end
    return proxy
end

return StudioServices
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Orders = require(Shared.Constants.TutorialOrders)
local Requests = require(Shared.Constants.CustomerRequests)
local Evaluation = require(script.Parent.CustomerOrderEvaluation)
local SmoothieItem = require(script.Parent.SmoothieItem)
local Targets = require(Shared.TutorialTargets)
local Tutorial = {}
local deps: any
type State = {
    Milestones: { [string]: boolean },
    Started: boolean,
    Stage: string,
    Plot: Instance?,
    SessionId: string?,
    Version: number,
}
local states: { [Player]: State } = {}
local function climbedOwnLadder(player: Player, plot: Instance?): boolean
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    if
        not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
        or humanoid:GetState() ~= Enum.HumanoidStateType.Climbing
    then
        return false
    end
    for _, ladder in Targets.Resolve(plot, "Ladder") do
        local parts = ladder:GetDescendants()
        table.insert(parts, ladder)
        for _, part in parts do
            if part:IsA("TrussPart") then
                local point = part.CFrame:PointToObjectSpace(root.Position)
                local half = part.Size * 0.5
                local distance = (point - Vector3.new(
                    math.clamp(point.X, -half.X, half.X),
                    math.clamp(point.Y, -half.Y, half.Y),
                    math.clamp(point.Z, -half.Z, half.Z)
                )).Magnitude
                if distance <= 6 then
                    return true
                end
            end
        end
    end
    return false
end
local function currentTarget(player: Player, state: State): (string, number?, number?)
    local orders = deps.CustomerService.GetTutorialSnapshot(player)
    if not orders then
        return "Complete", nil, nil
    end
    for index, order in orders do
        if order.Served then
            continue
        end
        local slot = Orders[index].Slot
        if not order.OrderTaken then
            return "Counter", index, slot
        end
        -- Reconcile early dispensing and stored cups from actual ownership.
        local request
        for _, definition in Requests.Definitions do
            if definition.Id == order.RequestId then
                request = definition
                break
            end
        end
        if request then
            for _, cup in deps.InventoryService.GetSmoothieInventory(player) do
                local evaluation = Evaluation.Evaluate(SmoothieItem.Result(cup.Data), request)
                if evaluation.IsValid and evaluation.IsFulfilled then
                    return "Serve", index, slot
                end
            end
        end
        local batch = deps.BlendService.GetSnapshot(player)
        if batch and batch.ReadyToDispense and batch.ProgressPercent >= 100 then
            return "Dispenser", index, slot
        end
        if batch and batch.AcceptedIngredientCount >= 3 and batch.State ~= "DISPENSED" then
            return "Turbine", index, slot
        end
        if deps.InventoryService.HasIngredientInFlight(player) then
            return "Blender", index, slot
        end
        if deps.InventoryService.HasCarriedIngredient(player) then
            if
                state.Milestones.TookStashItem
                and not state.Milestones.UsedLadder
                and not state.Milestones.LoadedBlender
                and (not batch or batch.AcceptedIngredientCount == 0)
                and #Targets.Resolve(state.Plot, "Ladder") > 0
            then
                return "Ladder", index, slot
            end
            return "Blender", index, slot
        end
        return "Stash", index, slot
    end
    return "Complete", nil, nil
end
local function refresh(player: Player, state: State)
    if not state.Started then
        return
    end
    local plot = deps.TycoonService.GetPlot(player)
    local sessionId = deps.TycoonService.GetSessionId(player)
    if state.SessionId ~= sessionId then
        state.Milestones = {}
        state.SessionId = sessionId
        player:SetAttribute("TutorialTookStashItem", false)
    end
    local stage: string = "ClaimPlot"
    local order: number? = nil
    local slot: number? = nil
    if plot then
        if state.Stage == "Ladder" and climbedOwnLadder(player, plot) then
            state.Milestones.UsedLadder = true
        end
        stage, order, slot = currentTarget(player, state)
    end
    player:SetAttribute("TutorialOrderIndex", order)
    player:SetAttribute("TutorialStashSlot", slot)
    local target = player:FindFirstChild("TutorialCustomerTarget")
    if not target then
        local created = Instance.new("ObjectValue")
        created.Name = "TutorialCustomerTarget"
        created.Parent = player
        target = created
    end
    if target and target:IsA("ObjectValue") then
        local orders = if plot then deps.CustomerService.GetTutorialSnapshot(player) else nil
        target.Value = if orders and order then orders[order].Model else nil
    end
    if state.Stage == stage and state.Plot == plot then
        return
    end
    state.Stage, state.Plot = stage, plot
    state.Version += 1
    local version = state.Version
    player:SetAttribute("TutorialHintReady", false)
    player:SetAttribute("TutorialStage", stage)
    player:SetAttribute("TutorialActive", stage ~= "Complete")
    if stage == "ClaimPlot" then
        task.delay(4.5, function()
            if states[player] == state and state.Version == version and player.Parent ~= nil then
                refresh(player, state)
                if state.Version == version then
                    player:SetAttribute("TutorialHintReady", true)
                end
            end
        end)
    elseif stage ~= "Complete" then
        player:SetAttribute("TutorialHintReady", true)
    end
end
function Tutorial.AddPlayer(player: Player)
    if states[player] then
        return
    end
    states[player] = { Milestones = {}, Started = false, Stage = "", Plot = nil, SessionId = nil, Version = 0 }
    player:SetAttribute("TutorialActive", false)
    player:SetAttribute("TutorialStage", "ClaimPlot")
    player:SetAttribute("TutorialTookStashItem", false)
    player:SetAttribute("TutorialHintReady", false)
end
-- Compatibility telemetry only. Progress comes from live gameplay state.
function Tutorial.Mark(player: Player, milestone: string)
    local state = states[player]
    if not state then
        return
    end
    state.Milestones[milestone] = true
    if milestone == "TookStashItem" then
        player:SetAttribute("TutorialTookStashItem", true)
    end
    refresh(player, state)
end
function Tutorial.GetMilestones(player: Player): { [string]: boolean }
    local state = states[player]
    return if state then table.clone(state.Milestones) else {}
end
function Tutorial.MembershipChanged(player: Player)
    local state = states[player]
    if state then
        refresh(player, state)
    end
end
function Tutorial.ApplyCharacter(player: Player, character: Model)
    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)
        if root and player.Character == character and player.Parent ~= nil then
            local state = states[player]
            if state then
                state.Started = true
                refresh(player, state)
            end
        end
    end)
end
function Tutorial.RemovePlayer(player: Player)
    states[player] = nil
end
function Tutorial.Init(services: any)
    deps = services
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        for player, state in states do
            refresh(player, state)
        end
    end)
end
return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">TycoonService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local WorldUtil = require(script.Parent.WorldUtil)
local TycoonService = {}
local HttpService = game:GetService("HttpService")
local Upgrades = require(game:GetService("ReplicatedStorage").Shared.Constants.Upgrades)
local FarmConfig = require(game:GetService("ReplicatedStorage").Shared.Constants.FarmConfig)
local StandIdentity = require(game:GetService("ReplicatedStorage").Shared.Constants.StandIdentity)
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
type Session =
    Types.PlotSessionState
    & { Plot: Instance, Owner: Player, Teammate: Player?, Busy: boolean, Pending: { () -> () } }
local sessions: { [Instance]: Session } = {}
local byId: { [string]: Session } = {}
local plots: { [Player]: Instance } = {}
local hooks: any = {}
local shared: { [string]: boolean } = {
    FarmRows = true,
    SecondStorage = true,
    Bat = true,
    Jump = true,
    Payout = true,
    MovementSpeed = true,
    SprintStamina = true,
    Hand = true,
    BlendSpeed = true,
}

function TycoonService.Init(callbacks: any)
    hooks = callbacks or {}
end
local function sessionFor(player: Player): Session?
    local plot = plots[player]
    local session = if plot then sessions[plot] else nil
    return if session and session.Status == "Active" and session.Plot:IsDescendantOf(workspace) then session else nil
end
function TycoonService.GetPlot(player: Player): Instance?
    local session = sessionFor(player)
    return if session then session.Plot else nil
end
function TycoonService.GetSessionId(player: Player): string?
    local session = sessionFor(player)
    return if session then session.PlotSessionId else nil
end
function TycoonService.GetSessionOwner(id: string): Player?
    local session = byId[id]
    return if session
            and session.Status == "Active"
            and session.Plot:IsDescendantOf(workspace)
        then session.Owner
        else nil
end
function TycoonService.GetOwner(object: Instance): Player?
    for plot, session in sessions do
        if
            session.Status == "Active"
            and plot:IsDescendantOf(workspace)
            and (object == plot or object:IsDescendantOf(plot))
        then
            return session.Owner
        end
    end
    return nil
end
function TycoonService.IsMember(player: Player, object: Instance): boolean
    local plot = TycoonService.GetPlot(player)
    return plot ~= nil and (object == plot or object:IsDescendantOf(plot))
end
function TycoonService.GetMembers(id: string): { Player }
    local session = byId[id]
    if not session or session.Status ~= "Active" then
        return {}
    end
    return if session.Teammate then { session.Owner, session.Teammate } else { session.Owner }
end
function TycoonService.GetSession(player: Player): Types.PlotSessionState?
    local session = sessionFor(player)
    if not session then
        return nil
    end
    return {
        PlotId = session.PlotId,
        PlotSessionId = session.PlotSessionId,
        OwnerUserId = session.OwnerUserId,
        TeammateUserId = session.TeammateUserId,
        JoinMode = session.JoinMode,
        StandName = session.StandName,
        StandNameRevision = session.StandNameRevision,
        SharedCash = session.SharedCash,
        SharedUpgrades = table.clone(session.SharedUpgrades),
        Status = session.Status,
        MembershipRevision = session.MembershipRevision,
    }
end
function TycoonService.GetRequestContext(player: Player): Types.PlotRequestContext?
    local session = sessionFor(player)
    return if session
        then { PlotSessionId = session.PlotSessionId, MembershipRevision = session.MembershipRevision }
        else nil
end
function TycoonService.ValidateActor(player: Player, context: any): boolean
    local session = sessionFor(player)
    return session ~= nil
        and type(context) == "table"
        and context.PlotSessionId == session.PlotSessionId
        and context.MembershipRevision == session.MembershipRevision
end
-- A synchronous transaction linearizes against reentrant membership changes.
-- Lifecycle requests made by Immediate signals run after the committed transaction.
function TycoonService.BeginTransaction(player: Player, context: any): string?
    local session = sessionFor(player)
    if not session or session.Busy or not TycoonService.ValidateActor(player, context) then
        return nil
    end
    session.Busy = true
    return session.PlotSessionId
end
function TycoonService.EndTransaction(id: string)
    local session = byId[id]
    if not session then
        return
    end
    session.Busy = false
    local pending = session.Pending
    session.Pending = {}
    for _, operation in pending do
        operation()
    end
end
local function publishIdentity(plot: Instance, session: Session?)
    plot:SetAttribute("StandName", if session then session.StandName else nil)
    plot:SetAttribute("StandNameRevision", if session then session.StandNameRevision else nil)
    plot:SetAttribute("PlotOwnerName", if session then session.Owner.Name else nil)
    plot:SetAttribute("PlotTeammateName", if session and session.Teammate then session.Teammate.Name else nil)
    plot:SetAttribute("TeammateUserId", if session then session.TeammateUserId else nil)
    plot:SetAttribute("JoinMode", if session then session.JoinMode else nil)
    plot:SetAttribute("PlotMembershipRevision", if session then session.MembershipRevision else nil)
    plot:SetAttribute("PlotOccupancy", if session then (if session.Teammate then 2 else 1) else 0)
    plot:SetAttribute("PlotCapacity", 2)
end
-- Publish the authoritative tier projection even before a player claims a plot.
-- UI readiness must not depend on membership or optional Tool assets.
function TycoonService.RefreshUpgradeAttributes(player: Player)
    for id in shared do
        local tier = TycoonService.GetUpgrade(player, id)
        player:SetAttribute(id .. "PurchasedLevel", tier - 1)
        player:SetAttribute(id .. "Level", tier - 1)
    end
end
local function publish(session: Session)
    session.Plot:SetAttribute("OwnerUserId", session.OwnerUserId)
    session.Plot:SetAttribute("PlotSessionId", session.PlotSessionId)
    session.Plot:SetAttribute("SecondStoragePurchased", session.SharedUpgrades.SecondStorage == 2)
    publishIdentity(session.Plot, session)
    for _, player in TycoonService.GetMembers(session.PlotSessionId) do
        player:SetAttribute("PlotSessionId", session.PlotSessionId)
        player:SetAttribute("PlotMembershipRevision", session.MembershipRevision)
        player:SetAttribute("playerCash", session.SharedCash)
        TycoonService.RefreshUpgradeAttributes(player)
        if hooks.MemberChanged then
            hooks.MemberChanged(player)
        end
    end
end
function TycoonService.IsSharedUpgrade(id: string): boolean
    return (shared :: any)[id] == true
end
function TycoonService.GetUpgrade(player: Player, id: string): number
    local session = sessionFor(player)
    return if session then session.SharedUpgrades[id] or 1 else 1
end
function TycoonService.GetJumpTier(player: Player): number
    return TycoonService.GetUpgrade(player, "Jump") - 1
end
function TycoonService.GetCash(player: Player): number
    local session = sessionFor(player)
    return if session then session.SharedCash else 0
end
local function validAmount(amount: number): boolean
    return type(amount) == "number" and amount == amount and amount >= 0 and amount < math.huge
end
-- Server-only cash operations; network actions must supply a captured context.
function TycoonService.SetCash(player: Player, amount: number): number
    assert(validAmount(amount), "Invalid cash")
    local context = TycoonService.GetRequestContext(player)
    local id = TycoonService.BeginTransaction(player, context)
    if not id then
        return TycoonService.GetCash(player)
    end
    local session = byId[id]
    session.SharedCash = math.floor(amount)
    publish(session)
    TycoonService.EndTransaction(id)
    return session.SharedCash
end
function TycoonService.AddCash(player: Player, amount: number): number
    assert(validAmount(amount), "Invalid award")
    local total = TycoonService.GetCash(player) + amount
    assert(validAmount(total), "Invalid cash")
    return TycoonService.SetCash(player, total)
end
-- Only a service holding the transaction may credit it; never expose to a remote.
function TycoonService.CreditTransaction(id: string, amount: number)
    local session = byId[id]
    assert(session and session.Busy and session.Status == "Active", "No transaction")
    assert(validAmount(amount) and validAmount(session.SharedCash + amount), "Invalid award")
    session.SharedCash = math.floor(session.SharedCash + amount)
    publish(session)
end
-- Server-only loss under the same nonnegative cash policy as SetCash/purchases.
function TycoonService.DebitTransaction(id: string, amount: number)
    local session = byId[id]
    assert(session and session.Busy and session.Status == "Active", "No transaction")
    assert(validAmount(amount), "Invalid debit")
    session.SharedCash = math.max(0, session.SharedCash - math.floor(amount))
    publish(session)
end
function TycoonService.PurchaseUpgrade(
    player: Player,
    id: string,
    expectedTier: number,
    context: any
): (boolean, string?)
    if not TycoonService.IsSharedUpgrade(id) or id == "FarmRows" or id == "SecondStorage" then
        return false, "InvalidUpgrade"
    end
    local token = TycoonService.BeginTransaction(player, context)
    if not token then
        return false, "StaleSession"
    end
    local session = byId[token]
    local nextTier = session.SharedUpgrades[id] + 1
    local definition = (Upgrades :: any)[id][nextTier]
    local reason = if expectedTier ~= nextTier
        then "InvalidLevel"
        elseif not definition then "MaxLevel"
        elseif session.SharedCash < definition.Cost then "InsufficientCash"
        else nil
    if reason then
        TycoonService.EndTransaction(token)
        return false, reason
    end
    session.SharedCash -= definition.Cost
    session.SharedUpgrades[id] = nextTier
    publish(session)
    TycoonService.EndTransaction(token)
    return true
end
-- Farm progression uses the same session cash/upgrade ledger, but only physical
-- farm interactions may commit it. The callback must be synchronous.
function TycoonService.PurchaseFarmRow(player: Player, row: number, context: any, commit: () -> ()): boolean
    local cost = FarmConfig.RowPrices[row]
    if not cost then
        return false
    end
    local token = TycoonService.BeginTransaction(player, context)
    if not token then
        return false
    end
    local session = byId[token]
    if session.SharedUpgrades.FarmRows ~= row or session.SharedCash < cost then
        TycoonService.EndTransaction(token)
        return false
    end
    session.SharedCash -= cost
    session.SharedUpgrades.FarmRows = row + 1
    commit()
    publish(session)
    TycoonService.EndTransaction(token)
    return true
end

-- Server-only physical stash pad transaction; membership is checked against the target plot.
function TycoonService.PurchaseSecondStorage(player: Player, plot: Instance, context: any): boolean
    if not TycoonService.IsMember(player, plot) then
        return false
    end
    local token = TycoonService.BeginTransaction(player, context)
    if not token then
        return false
    end
    local session = byId[token]
    local cost = Upgrades.SecondStorage[2].Cost
    if session.SharedUpgrades.SecondStorage ~= 1 or session.SharedCash < cost then
        TycoonService.EndTransaction(token)
        return false
    end
    session.SharedCash -= cost
    session.SharedUpgrades.SecondStorage = 2
    publish(session)
    TycoonService.EndTransaction(token)
    return true
end

-- Isolated adapter for the still-personal CarryCapacity/StackSize policy.
function TycoonService.PurchasePersonalUpgrade(
    player: Player,
    context: any,
    cost: number,
    commit: () -> ()
): (boolean, string?)
    if not validAmount(cost) then
        return false, "InvalidCost"
    end
    local token = TycoonService.BeginTransaction(player, context)
    if not token then
        return false, "StaleSession"
    end
    local session = byId[token]
    if session.SharedCash < cost then
        TycoonService.EndTransaction(token)
        return false, "InsufficientCash"
    end
    session.SharedCash -= cost
    commit()
    publish(session)
    TycoonService.EndTransaction(token)
    return true
end
-- Trusted server-only membership primitive; public joins must pass RequestJoin policy.
function TycoonService.JoinSession(player: Player, owner: Player, context: any): boolean
    local session = sessionFor(owner)
    if
        not session
        or session.Busy
        or session.Owner ~= owner
        or session.Teammate
        or plots[player]
        or not TycoonService.ValidateActor(owner, context)
    then
        return false
    end
    session.Busy = true
    session.Teammate, session.TeammateUserId = player, player.UserId
    plots[player] = session.Plot
    session.MembershipRevision += 1
    publish(session)
    TycoonService.EndTransaction(session.PlotSessionId)
    return true
end
function TycoonService.RemovePlayer(player: Player, afterTransition: (() -> ())?)
    local plot = plots[player]
    local session = if plot then sessions[plot] else nil
    if not session then
        if afterTransition then
            afterTransition()
        end
        return
    end
    if session.Busy then
        table.insert(session.Pending, function()
            TycoonService.RemovePlayer(player, afterTransition)
        end)
        return
    end
    session.Busy = true
    plots[player] = nil -- revoke authority before any cleanup or projection signals
    session.MembershipRevision += 1
    local remaining = if session.Owner == player then session.Teammate else session.Owner
    if remaining then
        session.Owner, session.OwnerUserId = remaining, remaining.UserId
        session.Teammate, session.TeammateUserId = nil, nil
    else
        session.Status = "Closing" -- invalidate first, clean once, release last
    end
    player:SetAttribute("PlotSessionId", nil)
    player:SetAttribute("PlotMembershipRevision", nil)
    player:SetAttribute("playerCash", 0)
    for upgrade in shared do
        player:SetAttribute(upgrade .. "PurchasedLevel", 0)
        player:SetAttribute(upgrade .. "Level", 0)
    end
    if hooks.MemberRemoved then
        hooks.MemberRemoved(player)
    end
    if remaining then
        publish(session)
        TycoonService.EndTransaction(session.PlotSessionId)
    else
        if hooks.SessionEnded then
            hooks.SessionEnded(session.PlotSessionId)
        end
        session.Status = "Closed"
        sessions[session.Plot], byId[session.PlotSessionId] = nil, nil
        session.Plot:SetAttribute("SecondStoragePurchased", false)
        session.Plot:SetAttribute("OwnerUserId", nil)
        session.Plot:SetAttribute("PlotSessionId", nil)
        publishIdentity(session.Plot, nil)
        session.Plot:SetAttribute(
            "PlotClaimRevision",
            ((session.Plot:GetAttribute("PlotClaimRevision") or 0) :: number) + 1
        )
    end
    if afterTransition then
        afterTransition()
    end
end
function TycoonService.Kick(owner: Player, teammate: Player, context: any): boolean
    local session = sessionFor(owner)
    if
        not session
        or session.Owner ~= owner
        or session.Teammate ~= teammate
        or not TycoonService.ValidateActor(owner, context)
    then
        return false
    end
    if session.Busy then
        table.insert(session.Pending, function()
            TycoonService.Kick(owner, teammate, context)
        end)
    else
        TycoonService.RemovePlayer(teammate)
    end
    return true
end
function TycoonService.GetFixtures(plot: Instance, role: string): { Instance }
    local fixtures = {}
    for _, object in CollectionService:GetTagged(role) do
        if object:IsDescendantOf(plot) then
            table.insert(fixtures, object)
        end
    end
    return fixtures
end

-- Compatibility runs before binding. An explicitly tagged role always wins over old names.
function TycoonService.AutoTagLegacyPlot(plot: Instance)
    CollectionService:AddTag(plot, "PlayerPlot")
    if plot:GetAttribute("PlotClaimRevision") == nil then
        plot:SetAttribute("PlotClaimRevision", 0)
    end
    if plot:GetAttribute("PlotId") == nil then
        plot:SetAttribute("PlotId", HttpService:GenerateGUID(false))
    end
    if not sessions[plot] then
        plot:SetAttribute("SecondStoragePurchased", false)
        plot:SetAttribute("OwnerUserId", nil)
        plot:SetAttribute("PlotSessionId", nil)
        publishIdentity(plot, nil)
    end
    for _, role in
        {
            "BlenderInput",
            "BlenderVacuum",
            "IngredientSpawn",
            "DispenseButton",
            "CustomerSpawn",
            "CustomerCounter",
            "CustomerWait1",
            "CustomerWait2",
            "CustomerExit",
            "CustomerThiefPoint",
            "StartDayButton",
            "PlayerStash",
            "TurbineWheel",
        }
    do
        if #TycoonService.GetFixtures(plot, role) == 0 then
            local object = plot:FindFirstChild(role, true)
            if not object and role == "PlayerStash" then
                object = plot:FindFirstChild("Stash")
            end
            if not object and role == "TurbineWheel" then
                local turbine = plot:FindFirstChild("Turbine", true)
                object = turbine
                    and (
                        turbine:FindFirstChild("blade", true)
                        or turbine:FindFirstChild("stem", true)
                        or WorldUtil.Part(turbine)
                    )
            end
            if object then
                CollectionService:AddTag(object, role)
            end
        end
    end
end

local customerRoles = {
    CustomerSpawn = true,
    CustomerCounter = true,
    CustomerWait1 = true,
    CustomerWait2 = true,
    CustomerExit = true,
    CustomerThiefPoint = true,
}

-- Customer destinations must be explicit markers, never an arbitrary part of a tagged area.
-- Prefer tagged parts over legacy tagged containers so tagging the actual marker repairs
-- an old area-level tag without making the reference ambiguous.
local function customerReference(fixtures: { Instance }, name: string): (BasePart?, string?)
    local markers: { BasePart } = {}
    for _, fixture in fixtures do
        if fixture:IsA("BasePart") then
            table.insert(markers, fixture)
        end
    end
    if #markers == 0 then
        for _, fixture in fixtures do
            local parts: { BasePart } = {}
            local named: { BasePart } = {}
            for _, child in fixture:GetDescendants() do
                if child:IsA("BasePart") then
                    table.insert(parts, child)
                    if child.Name == name then
                        table.insert(named, child)
                    end
                end
            end
            local marker = if #named == 1 then named[1] elseif #parts == 1 then parts[1] else nil
            if not marker then
                return nil,
                    "Tag the " .. name .. " marker BasePart itself; ambiguous/empty container " .. fixture:GetFullName()
            end
            if not table.find(markers, marker) then
                table.insert(markers, marker)
            end
        end
    end
    if #markers ~= 1 then
        local paths = {}
        for _, fixture in fixtures do
            table.insert(paths, fixture:GetFullName())
        end
        return nil,
            string.format(
                "%s: expected one marker, found %d; tagged objects=[%s]",
                name,
                #markers,
                table.concat(paths, ", ")
            )
    end
    local marker = markers[1]
    if
        CollectionService:HasTag(marker, "StartDayButton")
        or marker.Name == "StartDayButton"
        or marker:FindFirstChild("StartDayPrompt")
    then
        return nil,
            name .. " resolves to Start Day button " .. marker:GetFullName() .. "; tag a separate customer marker"
    end
    return marker
end

function TycoonService.GetReference(player: Player, name: string): (BasePart?, string?)
    local plot = TycoonService.GetPlot(player)
    if not plot then
        return nil, "No assigned plot"
    end
    local fixtures = TycoonService.GetFixtures(plot, name)
    if (customerRoles :: any)[name] then
        return customerReference(fixtures, name)
    end
    if #fixtures ~= 1 then
        return nil
    end
    local fixture = fixtures[1]
    if (name == "BlenderInput" or name == "BlenderVacuum") and not fixture:IsA("BasePart") then
        return nil
    end
    local part = WorldUtil.Part(fixture)
    if part and (part == fixture or part:IsDescendantOf(fixture)) then
        return part
    end
    return nil
end
-- Shared stable order for arrival routing and trusted automatic assignment.
function TycoonService.GetOrderedPlots(): { Instance }
    local candidates = CollectionService:GetTagged("PlayerPlot")
    local folder = workspace:FindFirstChild("Plots")
    if folder then
        for _, plot in folder:GetChildren() do
            if not table.find(candidates, plot) then
                table.insert(candidates, plot)
            end
        end
    end
    table.sort(candidates, function(a, b)
        local ao, bo = a:GetAttribute("SpawnOrder"), b:GetAttribute("SpawnOrder")
        if type(ao) == "number" and type(bo) == "number" and ao ~= bo then
            return ao < bo
        elseif type(ao) == "number" and type(bo) ~= "number" then
            return true
        elseif type(bo) == "number" and type(ao) ~= "number" then
            return false
        end
        return a:GetFullName() < b:GetFullName()
    end)
    return candidates
end
function TycoonService.IsPlotAvailable(plot: Instance): boolean
    return plot:IsDescendantOf(workspace) and sessions[plot] == nil
end
-- Trusted compatibility API. Runtime arrivals never call this; claims select an exact plot.
function TycoonService.AssignPlot(player: Player, requestedPlot: Instance?): Instance?
    if TycoonService.GetPlot(player) then
        return plots[player]
    end
    if plots[player] then
        TycoonService.RemovePlayer(player)
        if plots[player] then
            return nil
        end
    end
    local candidates = TycoonService.GetOrderedPlots()
    for _, plot in candidates do
        if not CollectionService:HasTag(plot, "PlayerPlot") then
            TycoonService.AutoTagLegacyPlot(plot)
        end
    end
    for _, plot in candidates do
        if plot:IsDescendantOf(workspace) and not sessions[plot] and (not requestedPlot or plot == requestedPlot) then
            plots[player] = plot
            local id = HttpService:GenerateGUID(false)
            local authoredId = plot:GetAttribute("PlotId")
            local plotId = if type(authoredId) == "string" then authoredId else HttpService:GenerateGUID(false)
            plot:SetAttribute("PlotId", plotId)
            local upgrades: { [string]: number } = {}
            for upgrade in shared do
                upgrades[upgrade] = 1
            end
            local session: Session = {
                Plot = plot,
                PlotId = plotId,
                PlotSessionId = id,
                Owner = player,
                OwnerUserId = player.UserId,
                Teammate = nil,
                TeammateUserId = nil,
                JoinMode = "Open",
                -- DisplayName is platform moderated; custom submissions use StandIdentityService.
                StandName = StandIdentity.DefaultName(player.DisplayName or player.Name),
                StandNameRevision = 1,
                SharedCash = 0,
                SharedUpgrades = upgrades,
                Status = "Active",
                MembershipRevision = 1,
                Busy = true,
                Pending = {},
            }
            sessions[plot], byId[id] = session, session
            publish(session)
            if hooks.SessionStarted then
                hooks.SessionStarted(player)
            end
            TycoonService.EndTransaction(id)
            return plot
        end
    end
    warn("[TycoonService] No free PlayerPlot / workspace.Plots child for " .. player.Name)
    return nil
end
-- Requests retain the submitted context across any yielding friendship lookup.
function TycoonService.ClaimPlot(player: Player, plot: Instance, context: any): boolean
    if
        plots[player]
        or not CollectionService:HasTag(plot, "PlayerPlot")
        or not plot:IsDescendantOf(workspace)
        or sessions[plot]
        or type(context) ~= "table"
        or context.PlotSessionId ~= nil
        or context.ClaimRevision ~= (plot:GetAttribute("PlotClaimRevision") or 0)
    then
        return false
    end
    return TycoonService.AssignPlot(player, plot) == plot
end
function TycoonService.RequestJoin(player: Player, plot: Instance, context: any): boolean
    local session = sessions[plot]
    if
        not session
        or session.Status ~= "Active"
        or session.Busy
        or plots[player]
        or session.Teammate
        or not TycoonService.ValidateActor(session.Owner, context)
    then
        return false
    end
    local owner = session.Owner
    if session.JoinMode == "Closed" then
        return false
    elseif session.JoinMode == "FriendsOnly" then
        local ok, friend = pcall(function()
            return player:IsFriendsWithAsync(owner.UserId)
        end)
        if not ok or not friend then
            return false
        end
    end
    -- Joining can yield above: never substitute a newer session, owner, or revision.
    if sessions[plot] ~= session or session.Owner ~= owner or player.Parent == nil then
        return false
    end
    return TycoonService.JoinSession(player, owner, context)
end
function TycoonService.SetJoinMode(player: Player, mode: any, context: any): boolean
    local session = sessionFor(player)
    if
        not session
        or session.Owner ~= player
        or session.Busy
        or not TycoonService.ValidateActor(player, context)
        or (mode ~= "Open" and mode ~= "FriendsOnly" and mode ~= "Closed")
    then
        return false
    end
    session.Busy = true
    session.JoinMode = mode
    session.MembershipRevision += 1
    publish(session)
    TycoonService.EndTransaction(session.PlotSessionId)
    return true
end
-- TODO(Settings): Expose teammate access in Settings > Stand.
-- Planned policies: Anyone / FriendsOnly. Access checks stay server-authoritative
-- in RequestJoin; this adapter retains the existing Open wire value.
function TycoonService.SetTeammateAccess(player: Player, mode: string, context: any): boolean
    return TycoonService.SetJoinMode(player, if mode == "Anyone" then "Open" else mode, context)
end

-- Trusted server-only commit. Never expose this method directly to a remote.
function TycoonService.CommitFilteredStandName(player: Player, plot: Instance, text: string, context: any): boolean
    local session = sessionFor(player)
    if
        not session
        or session.Owner ~= player
        or session.Plot ~= plot
        or type(context) ~= "table"
        or context.StandNameRevision ~= session.StandNameRevision
    then
        return false
    end
    local id = TycoonService.BeginTransaction(player, context)
    if not id then
        return false
    end
    session.StandName = text
    session.StandNameRevision += 1
    publishIdentity(plot, session)
    TycoonService.EndTransaction(id)
    return true
end
function TycoonService.LeaveTeam(player: Player, context: any): boolean
    local session = sessionFor(player)
    if
        not session
        or session.Teammate ~= player
        or session.Busy
        or not TycoonService.ValidateActor(player, context)
    then
        return false
    end
    TycoonService.RemovePlayer(player)
    return true
end
return require(script.Parent.StudioServices).Wrap("TycoonService", TycoonService)
]]></string>
