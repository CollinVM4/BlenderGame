      <Item class="LocalScript" referent="799">
        <Properties>
          <string name="Name">FramewispTextScaler</string>
          <BinaryString name="AttributesSerialize">AwAAAAgAAABGV19Pd25lZAMBBgAAAEZXX1NyYwYAAIC94BrUQQMAAABGV3YGAAAAAAAAPkA=</BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="Disabled">false</bool>
          <ContentId name="LinkedSource">
            <null>
