          <Item class="ModuleScript" referent="849">
            <Properties>
              <string name="Name">TutorialGleamController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Targets = require(game:GetService("ReplicatedStorage").Shared.TutorialTargets)
local Presentation = require(script.Parent.TutorialPresentationState)
local Flow = require(script.Parent.Parent.UI.TutorialBeamFlow)
local beamFinish: Attachment? = nil
local Controller = {}
local DEBUG_TUTORIAL_GLEAM = false
local debugSignature = ""
local spawnTarget: ObjectValue? = nil
local spawnTargetConnection: RBXScriptConnection? = nil
local player = Players.LocalPlayer
local initialized = false
local stopped = false
local removingCharacter: Model? = nil
local connections: { RBXScriptConnection } = {}
local highlights: { Highlight } = {}
local tweens: { Tween } = {}
local current: { Instance } = {}
local activeClaimHintPlot: Instance? = nil
local activeClaimHintTargets: { Instance } = {}
local glassProxy: UnionOperation? = nil
local glassSource: UnionOperation? = nil
local failedGlassSource: UnionOperation? = nil
local targetConnections: { RBXScriptConnection } = {}
local stashBeam: Beam? = nil
local stashFlow: Beam? = nil
local beamStartedAt = 0
local beamAttachments: { Attachment } = {}
local function clearClaimPin()
    activeClaimHintPlot = nil
    table.clear(activeClaimHintTargets)
end
local function claimAvailable(plot: Instance?): boolean
    return plot ~= nil and plot:IsDescendantOf(workspace) and plot:GetAttribute("PlotSessionId") == nil
end
local beamTarget: Instance? = nil
local function clearBeam()
    beamFinish = nil
    if stashFlow then
        stashFlow:Destroy()
        stashFlow = nil
    end
    if stashBeam then
        stashBeam:Destroy()
        stashBeam = nil
    end
    for _, attachment in beamAttachments do
        attachment:Destroy()
    end
    table.clear(beamAttachments)
    beamTarget = nil
end
local function clear()
    for _, tween in tweens do
        tween:Cancel()
    end
    for _, highlight in highlights do
        highlight:Destroy()
    end
    for _, connection in targetConnections do
        connection:Disconnect()
    end
    table.clear(targetConnections)
    if glassProxy then
        glassProxy:Destroy()
        glassProxy = nil
    end
    glassSource = nil
    table.clear(tweens)
    table.clear(highlights)
    table.clear(current)
end
local function plotFor(stage: string): Instance?
    if stage == "ClaimPlot" then
        local target = player:FindFirstChild("TutorialSpawnTarget")
        local intended = if target and target:IsA("ObjectValue") then target.Value else nil
        if intended and claimAvailable(intended) then
            if activeClaimHintPlot and activeClaimHintPlot ~= intended then
                clearClaimPin()
            end
            return intended
        end
        if claimAvailable(activeClaimHintPlot) then
            return activeClaimHintPlot
        end
        clearClaimPin()
        return nil
    end
    local id = player:GetAttribute("PlotSessionId")
    if id then
        for _, plot in CollectionService:GetTagged("PlayerPlot") do
            if plot:GetAttribute("PlotSessionId") == id then
                return plot
            end
        end
    end
    return nil
end
local function debugging(): boolean
    return DEBUG_TUTORIAL_GLEAM or player:GetAttribute("DebugTutorialGleam") == true
end
local function describe(object: Instance?): string
    return if object then object:GetFullName() .. " class=" .. object.ClassName else "nil"
end
local function renderDetails(object: Instance): string
    local lines = {
        "target=" .. describe(object) .. " parent=" .. describe(object.Parent) .. " inWorkspace=" .. tostring(
            object:IsDescendantOf(workspace)
        ),
    }
    local parts = object:GetDescendants()
    table.insert(parts, 1, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            table.insert(
                lines,
                "part="
                    .. describe(part)
                    .. " Transparency="
                    .. tostring(part.Transparency)
                    .. " LocalTransparencyModifier="
                    .. tostring(part.LocalTransparencyModifier)
                    .. " Material="
                    .. tostring(part.Material)
                    .. " Size="
                    .. tostring(part.Size)
            )
        end
    end
    return table.concat(lines, "\n")
end
local function diagnose(stage: any, plot: Instance?, targets: { Instance })
    if not debugging() then
        debugSignature = ""
        return
    end
    local lines = {
        "stage="
            .. tostring(stage)
            .. " hintReady="
            .. tostring(player:GetAttribute("TutorialHintReady"))
            .. " active="
            .. tostring(player:GetAttribute("TutorialActive")),
        "plot=" .. describe(plot),
    }
    local slot = player:GetAttribute("TutorialStashSlot")
    local roots: { Instance } = if type(stage) == "string"
        then Targets.GetRoots(plot, stage, if type(slot) == "number" then slot else nil)
        else {}
    local keys = table.clone(lines)
    table.insert(keys, "adornableTargets=" .. tostring(#targets))
    for _, root in roots do
        table.insert(keys, describe(root))
    end
    local signature = table.concat(keys, "\n")
    if signature == debugSignature then
        return
    end
    debugSignature = signature
    for _, root in roots do
        table.insert(lines, renderDetails(root))
    end
    if #roots == 0 and type(stage) == "string" then
        table.insert(
            lines,
            if stage == "ClaimPlot" and not plot
                then "ClaimPlot: TutorialSpawnTarget=nil"
                elseif stage == "Blender" then "Blender: Glass target missing"
                else stage .. ": authored target missing"
        )
    elseif #targets == 0 then
        table.insert(
            lines,
            "No adornable target (hint inactive, character unavailable, or assembly has no visible parts)"
        )
    end
    print("[TutorialGleam] " .. table.concat(lines, "\n"))
end
-- This workaround is deliberately exclusive to the authored Blender.Glass union.
local function createGlassProxy(source: UnionOperation): UnionOperation?
    local clone = source:Clone()
    if not clone then
        return nil
    end
    for _, child in clone:GetChildren() do
        child:Destroy()
    end
    for name in clone:GetAttributes() do
        clone:SetAttribute(name, nil)
    end
    for _, tag in CollectionService:GetTags(clone) do
        CollectionService:RemoveTag(clone, tag)
    end
    clone.Name = "TutorialGlassGleamProxy"
    clone.Anchored = true
    clone.CanCollide, clone.CanTouch, clone.CanQuery = false, false, false
    clone.CastShadow = false
    clone.Transparency = 1
    clone.LocalTransparencyModifier = 0
    clone.Material = Enum.Material.Glass
    clone.CFrame, clone.Size = source.CFrame, source.Size
    clone.Parent = workspace
    return clone
end
local function beamEnd(target: BasePart | Attachment, stage: string?): Attachment
    if target:IsA("Attachment") then
        return target
    end
    local attachment = Instance.new("Attachment")
    attachment.Name = "TutorialStashBeamEnd"
    if stage == "Turbine" or stage == "FinishBatch" then
        -- Lower on a tall stationary shaft; centered on short stems.
        attachment.Position = Vector3.new(0, math.min(0, 2.5 - target.Size.Y * 0.5), 0)
    end
    attachment.Parent = target
    table.insert(beamAttachments, attachment)
    return attachment
end
local function createStashBeam(character: Model, target: BasePart | Attachment, stage: string?)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then
        return
    end
    local start = Instance.new("Attachment")
    start.Name = "TutorialStashBeamStart"
    start.Position = Vector3.new(0, -0.5, 1.25) -- Local +Z is behind the avatar.
    start.Parent = root
    local finish = beamEnd(target, stage)
    beamTarget, beamFinish = target, finish
    local beam = Instance.new("Beam")
    beam.Name = "TutorialStashBeam"
    beam.Attachment0, beam.Attachment1 = start, finish
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 224, 65))
    beam.Transparency = NumberSequence.new(0.6)
    beam.Width0, beam.Width1 = 0.26, 0.195
    beam.CurveSize0, beam.CurveSize1 = 1.5, -1.5
    beam.Segments = 20
    beam.FaceCamera = true
    beam.LightEmission = 0.35
    beam.Enabled = true
    beam.Parent = root
    stashBeam = beam
    local flow = Instance.new("Beam")
    flow.Name = "TutorialStashFlow"
    flow.Attachment0, flow.Attachment1 = start, finish
    flow.Color = ColorSequence.new(Color3.fromRGB(255, 250, 185))
    flow.Width0, flow.Width1 = 0.11, 0.085
    flow.CurveSize0, flow.CurveSize1 = beam.CurveSize0, beam.CurveSize1
    flow.Segments, flow.FaceCamera = 20, true
    flow.LightEmission, flow.LightInfluence = 1, 0
    flow.Transparency = Flow.Transparency(0)
    flow.Enabled = true
    flow.Parent = root
    stashFlow, beamStartedAt = flow, os.clock()
    table.insert(beamAttachments, start)
end
-- Retarget the existing effect; only locally created attachments are owned here.
local function updateBeam(character: Model?, target: (BasePart | Attachment)?, stage: string?)
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    if
        not root
        or not root:IsA("BasePart")
        or not target
        or not target:IsDescendantOf(workspace)
        or (target:IsA("Attachment") and (not target.Parent or not target.Parent:IsA("BasePart")))
    then
        clearBeam()
        return
    end
    if stashBeam and stashFlow then
        local start, finish = stashBeam.Attachment0, beamFinish
        if
            not start
            or start.Parent ~= root
            or not stashBeam:IsDescendantOf(workspace)
            or not stashFlow:IsDescendantOf(workspace)
        then
            clearBeam()
        elseif beamTarget ~= (target :: Instance) or not finish or not finish:IsDescendantOf(workspace) then
            if finish and table.find(beamAttachments, finish) then
                table.remove(beamAttachments, table.find(beamAttachments, finish) :: number)
                finish:Destroy()
            end
            finish = beamEnd(target, stage)
            stashBeam.Attachment1, stashFlow.Attachment1 = finish, finish
            beamTarget, beamFinish = target, finish
        end
    end
    if not stashBeam then
        createStashBeam(character :: Model, target, stage)
    end
    if stashBeam and stashFlow and beamFinish then
        stashBeam.Enabled, stashFlow.Enabled = true, true
        stashBeam.Attachment1, stashFlow.Attachment1 = beamFinish, beamFinish
        local transparency = Flow.Transparency(os.clock() - beamStartedAt)
        if stashFlow.Transparency ~= transparency then
            stashFlow.Transparency = transparency
        end
    end
end
local function refresh()
    if stopped then
        return
    end
    local _, presentationReady, presentationStage, beamAllowed = Presentation.Read(player)
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    local stage = presentationStage
    if
        stage ~= "ClaimPlot"
        or player:GetAttribute("TutorialActive") ~= true
        or player:GetAttribute("PlotSessionId") ~= nil
    then
        clearClaimPin()
    end
    local targets: { Instance } = {}
    local plot = if type(stage) == "string" then plotFor(stage) else nil
    local worldReady = player.Parent ~= nil
        and character
        and character ~= removingCharacter
        and character:IsDescendantOf(workspace)
        and humanoid
        and humanoid.Health > 0
        and Presentation.IsActive(player, stage)
        and type(stage) == "string"
        and presentationReady
    if worldReady and type(stage) == "string" then
        if stage ~= "ClaimPlot" or player:GetAttribute("PlotSessionId") == nil then
            local slot = player:GetAttribute("TutorialStashSlot")
            local customer = player:FindFirstChild("TutorialCustomerTarget")
            targets = Targets.Resolve(
                plot,
                stage,
                if type(slot) == "number" then slot else nil,
                if customer and customer:IsA("ObjectValue") then customer.Value else nil
            )
        end
        if stage == "ClaimPlot" and activeClaimHintPlot == plot and #activeClaimHintTargets > 0 then
            local valid = #targets == #activeClaimHintTargets
            for _, target in activeClaimHintTargets do
                if not target:IsDescendantOf(workspace) or not table.find(targets, target) then
                    valid = false
                    break
                end
            end
            if valid then
                targets = table.clone(activeClaimHintTargets)
            else
                table.clear(activeClaimHintTargets)
            end
        end
    end
    diagnose(stage, plot, targets)
    local same = #targets == #current
    for i, object in targets do
        if current[i] ~= object then
            same = false
            break
        end
    end
    if same and glassProxy and glassSource then
        if glassProxy.Parent ~= workspace then
            same = false
        else
            glassProxy.CFrame, glassProxy.Size = glassSource.CFrame, glassSource.Size
        end
    end
    local destination = if beamAllowed
            and worldReady
            and type(stage) == "string"
        then Targets.ResolveBeam(plot, stage, player:GetAttribute("TutorialStashSlot"), targets[1])
        else nil
    updateBeam(character, destination, stage)
    if same then
        return
    end
    clear()
    for _, object in targets do
        local adornee = object
        if stage == "Blender" and object:IsA("UnionOperation") and Targets.GetRoots(plot, "Blender")[1] == object then
            local proxy = createGlassProxy(object)
            if not proxy then
                if debugging() and failedGlassSource ~= object then
                    failedGlassSource = object
                    warn("[TutorialGleam] Blender.Glass could not be cloned; retrying")
                end
                continue
            end
            failedGlassSource = nil
            glassProxy, glassSource = proxy, object
            adornee = proxy
        end
        table.insert(targetConnections, object.Destroying:Connect(clear))
        table.insert(
            targetConnections,
            object.AncestryChanged:Connect(function()
                if not object:IsDescendantOf(workspace) then
                    clear()
                end
            end)
        )
        local highlight = Instance.new("Highlight")
        highlight.Name = "TutorialGleam"
        highlight.Adornee = adornee
        highlight.Enabled = true
        highlight.FillColor = Color3.fromRGB(255, 224, 65)
        highlight.OutlineColor = Color3.fromRGB(255, 250, 205)
        highlight.FillTransparency, highlight.OutlineTransparency = 0.70, 0.05
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = workspace -- created locally, never replicated by server
        if debugging() then
            print(
                "[TutorialGleam] highlight created stage="
                    .. tostring(stage)
                    .. " target="
                    .. describe(object)
                    .. " highlight="
                    .. describe(highlight)
                    .. " parent="
                    .. describe(highlight.Parent)
                    .. " Adornee="
                    .. describe(highlight.Adornee)
                    .. " Enabled="
                    .. tostring(highlight.Enabled)
                    .. " DepthMode="
                    .. tostring(highlight.DepthMode)
                    .. " FillTransparency="
                    .. tostring(highlight.FillTransparency)
                    .. " OutlineTransparency="
                    .. tostring(highlight.OutlineTransparency)
            )
        end
        local tween = TweenService:Create(
            highlight,
            TweenInfo.new(0.85, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            { FillTransparency = 0.35, OutlineTransparency = 0.15 }
        )
        table.insert(highlights, highlight)
        table.insert(tweens, tween)
        table.insert(current, object)
        tween:Play()
    end
    if stage == "ClaimPlot" and #current > 0 then
        activeClaimHintPlot = plot
        activeClaimHintTargets = table.clone(current)
    end
end
local function bindSpawnTarget()
    local candidate = player:FindFirstChild("TutorialSpawnTarget")
    local target = if candidate and candidate:IsA("ObjectValue") then candidate else nil
    if target == spawnTarget then
        return
    end
    if spawnTargetConnection then
        spawnTargetConnection:Disconnect()
        spawnTargetConnection = nil
    end
    spawnTarget = target
    if target then
        spawnTargetConnection = target:GetPropertyChangedSignal("Value"):Connect(function()
            if player:GetAttribute("TutorialStage") == "ClaimPlot" then
                refresh() -- nil after reservation expiry retains the active claim pin
            end
        end)
    end
    if player:GetAttribute("TutorialStage") == "ClaimPlot" then
        refresh()
    end
end
function Controller.Init()
    if initialized then
        return
    end
    initialized = true
    bindSpawnTarget()
    for _, event in { player.ChildAdded, player.ChildRemoved } do
        table.insert(
            connections,
            event:Connect(function(child)
                if child.Name == "TutorialSpawnTarget" then
                    bindSpawnTarget()
                end
            end)
        )
    end
    for _, attribute in
        {
            "FarmTutorialStage",
            "TutorialStage",
            "TutorialActive",
            "TutorialHintReady",
            "TutorialStashSlot",
            "TutorialOrderIndex",
            "PlotSessionId",
            "PlotMembershipRevision",
            "DebugTutorialGleam",
        }
    do
        table.insert(
            connections,
            player:GetAttributeChangedSignal(attribute):Connect(function()
                if attribute == "PlotMembershipRevision" or attribute == "DebugTutorialGleam" then
                    clear()
                end
                refresh()
            end)
        )
    end
    table.insert(
        connections,
        player.CharacterRemoving:Connect(function(character)
            removingCharacter = character
            if character then
                Presentation.CharacterRemoving(character)
            end
            clearBeam()
            clear()
        end)
    )
    table.insert(
        connections,
        player.CharacterAdded:Connect(function()
            removingCharacter = nil
            Presentation.CharacterAdded()
            clearBeam()
            clear()
            refresh()
        end)
    )
    -- Re-resolve streaming/recreated targets and death state without waiting for missing assets.
    table.insert(connections, RunService.Heartbeat:Connect(refresh))
    script.Destroying:Connect(function()
        stopped = true
        clearClaimPin()
        if spawnTargetConnection then
            spawnTargetConnection:Disconnect()
            spawnTargetConnection = nil
        end
        clearBeam()
        clear()
        for _, connection in connections do
            connection:Disconnect()
        end
        table.clear(connections)
    end)
    refresh()
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="850">
            <Properties>
              <string name="Name">TutorialHintController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local Banner = require(script.Parent.Parent.UI.AnnouncementBanner)
local Text = require(script.Parent.Parent.UI.TutorialHintText)
local Carry = require(script.Parent.CarryInputController)
local Presentation = require(script.Parent.TutorialPresentationState)
local Controller = {}
local initialized = false
local connections: { RBXScriptConnection } = {}
local presentationConnections: { RBXScriptConnection } = {}
local function stopPresentation()
    for _, connection in presentationConnections do
        connection:Disconnect()
    end
    table.clear(presentationConnections)
end
local surface: Banner.Surface? = nil
local displayed: string? = nil
local exitingUntil: number? = nil
local removingCharacter: Model? = nil
local function clearSurface()
    if surface then
        surface.Destroy()
        surface = nil
    end
    displayed, exitingUntil = nil, nil
end
local function refresh()
    local player = Players.LocalPlayer
    local now = os.clock()
    local textAllowed, presentationReady, stage = Presentation.Read(player)
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    local active = Presentation.IsActive(player, stage) and type(stage) == "string"
    if not active or not textAllowed then
        stopPresentation()
        clearSurface()
        return
    end
    if #presentationConnections == 0 then
        table.insert(presentationConnections, Banner.PriorityChanged:Connect(refresh))
        table.insert(presentationConnections, Input:GetPropertyChangedSignal("PreferredInput"):Connect(refresh))
        table.insert(presentationConnections, RunService.Heartbeat:Connect(refresh))
    end
    if surface and (not gui or not surface.Gui:IsDescendantOf(gui)) then
        clearSurface()
    end
    local visible = presentationReady
        and character ~= nil
        and character ~= removingCharacter
        and character:IsDescendantOf(workspace)
        and humanoid ~= nil
        and humanoid.Health > 0
        and not Banner.IsGlobalActive()
    if not visible or not gui then
        if surface then
            surface.Hide() -- Priority is synchronous: never overlap even during exit.
        end
        displayed, exitingUntil = nil, nil
        return
    end
    local button = Carry.GetThrowButtonLabel():gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    local hint = Text.Get(stage :: string, Input.PreferredInput, button)
    if not hint then
        clearSurface()
        return
    end
    local text = '<font color="#FFE073">' .. hint .. "</font>"
    if not surface then
        surface = Banner.Create(gui :: PlayerGui, "TutorialHint")
    end
    local banner = surface :: Banner.Surface
    if text == displayed and not exitingUntil then
        return
    end
    if stage == "Dispenser" then
        exitingUntil = nil -- Smoothie readiness shows collection immediately, including during another exit.
    elseif displayed and not exitingUntil then
        banner.Exit()
        exitingUntil = now + 0.18
        return
    end
    if exitingUntil and now < exitingUntil then
        return
    end
    banner.Show(text)
    displayed, exitingUntil = text, nil
end
function Controller.Destroy()
    initialized = false
    stopPresentation()
    clearSurface()
    for _, connection in connections do
        connection:Disconnect()
    end
    table.clear(connections)
end
function Controller.Init()
    if initialized then
        return
    end
    initialized = true
    local player = Players.LocalPlayer
    table.insert(
        connections,
        player.CharacterRemoving:Connect(function(character)
            removingCharacter = character
            if character then
                Presentation.CharacterRemoving(character)
            end
            clearSurface()
        end)
    )
    table.insert(
        connections,
        player.CharacterAdded:Connect(function()
            removingCharacter = nil
            Presentation.CharacterAdded()
            refresh()
        end)
    )
    for _, attribute in
        {
            "FarmTutorialStage",
            "TutorialStage",
            "TutorialOrderIndex",
            "TutorialActive",
            "TutorialHintReady",
            "PlotSessionId",
        }
    do
        table.insert(connections, player:GetAttributeChangedSignal(attribute):Connect(refresh))
    end
    table.insert(connections, script.Destroying:Connect(Controller.Destroy))
    refresh()
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="851">
            <Properties>
              <string name="Name">TutorialPresentationState</string>
              <string name="Source"><![CDATA[--!strict
-- Local presentation only: no delayed tasks, remotes or gameplay milestones.
local ORDER_READ_SECONDS = 2.5
local State = {}
local session: any = nil
local character: Model? = nil
local removedCharacter: Model? = nil
local beamFinished = false -- Permanent for this onboarding, including respawns and membership changes.
local textFinished = false
local initialStashFinished = false
local stashDeadline: number? = nil
local marketDeadline: number? = nil
local marketReadFinished = false
local marketReadPending = false
local previousStage: any = nil
local counterDeadline: number? = nil
local counterReady = false
function State.CharacterRemoving(model: Model)
    removedCharacter = model
    stashDeadline, counterDeadline, marketDeadline = nil, nil, nil
end
function State.CharacterAdded()
    removedCharacter = nil
end
function State.IsActive(player: Player, stage: string?): boolean
    if stage == "BuyRow" or stage == "Plant" or stage == "Harvest" then
        return player:GetAttribute("TutorialActive") ~= true and player:GetAttribute("FarmTutorialStage") == stage
    end
    return player:GetAttribute("TutorialActive") == true
        and (player:GetAttribute("TutorialHintReady") == true or stage == "ClaimPlot")
end
function State.Read(player: Player): (boolean, boolean, string?, boolean)
    local nextSession = player:GetAttribute("PlotSessionId")
    if session ~= nextSession then
        session = nextSession
        textFinished, initialStashFinished = false, false
        stashDeadline, previousStage = nil, nil
        marketDeadline, marketReadFinished, marketReadPending = nil, false, false
        counterDeadline, counterReady = nil, false
    end
    if character ~= player.Character then
        character = player.Character
        stashDeadline, counterDeadline, marketDeadline = nil, nil, nil
    end
    local stage = player:GetAttribute("TutorialStage")
    local order = player:GetAttribute("TutorialOrderIndex")
    if type(order) == "number" and order > 1 then
        beamFinished = true
        textFinished = true -- Only a new plot session may re-enable instructions.
    end
    if stage == "Complete" then
        beamFinished = true
    end
    if previousStage == "Stash" and stage ~= "Stash" then
        initialStashFinished = true
        stashDeadline = nil
    end
    if stage ~= "Counter" then
        counterDeadline, counterReady = nil, false
    end
    if previousStage == "NextCustomer" and stage == "Market" and not marketReadFinished then
        marketReadPending = true
    end
    if stage ~= "Market" and marketReadPending then
        marketReadFinished, marketReadPending, marketDeadline = true, false, nil
    end
    previousStage = stage
    if
        type(stage) == "string"
        and stage ~= "ClaimPlot"
        and stage ~= "Counter"
        and stage ~= "Order"
        and stage ~= "Stash"
    then
        initialStashFinished = true -- Early gameplay never gets an obsolete order-dialogue delay.
    end
    local ready = true
    if stage == "Stash" and order == 1 and not initialStashFinished then
        local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
        if
            not character
            or character == removedCharacter
            or not humanoid
            or humanoid.Health <= 0
            or not character:IsDescendantOf(workspace)
            or player:GetAttribute("TutorialActive") ~= true
        then
            stashDeadline = nil
            ready = false
        else
            if not stashDeadline then
                stashDeadline = os.clock() + ORDER_READ_SECONDS
            end
            ready = os.clock() >= (stashDeadline :: number)
            if ready then
                initialStashFinished = true
                stashDeadline = nil
            end
        end
    end
    if stage == "Counter" and order == 1 and not textFinished then
        local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
        local alive = character ~= nil
            and character ~= removedCharacter
            and character:IsDescendantOf(workspace)
            and humanoid ~= nil
            and humanoid.Health > 0
            and player:GetAttribute("TutorialActive") == true
        if not alive then
            counterDeadline = nil
            ready = false
        elseif not counterReady then
            counterDeadline = counterDeadline or (os.clock() + 3)
            counterReady = os.clock() >= (counterDeadline :: number)
            ready = counterReady
        end
    end
    if stage == "Market" and marketReadPending and not marketReadFinished then
        local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
        if
            not character
            or character == removedCharacter
            or not humanoid
            or humanoid.Health <= 0
            or not character:IsDescendantOf(workspace)
            or player:GetAttribute("TutorialActive") ~= true
        then
            marketDeadline = nil
            ready = false
        else
            marketDeadline = marketDeadline or (os.clock() + ORDER_READ_SECONDS)
            ready = os.clock() >= (marketDeadline :: number)
            if ready then
                marketReadFinished, marketReadPending, marketDeadline = true, false, nil
            end
        end
    end
    -- Follow-up guidance bypasses first-order instruction retirement.
    if (stage == "BuyJump" or stage == "BuyBat") and player:GetAttribute("TutorialActive") == true then
        return true, ready, stage, false -- Alert pulses point to upgrades; there is no world target.
    end
    if
        (stage == "NextCustomer" or stage == "Market" or stage == "MarketJump")
        and player:GetAttribute("TutorialActive") == true
    then
        return true, ready, stage, ready
    end
    -- Farm guidance deliberately bypasses opening-only completion latches.
    if player:GetAttribute("TutorialActive") ~= true then
        local farmStage = player:GetAttribute("FarmTutorialStage")
        if farmStage == "BuyRow" or farmStage == "Plant" or farmStage == "Harvest" then
            return true, true, farmStage, true
        end
    end
    return not textFinished or stage == "ClaimPlot",
        ready,
        if type(stage) == "string" then stage else nil,
        not beamFinished and (stage == "ClaimPlot" or order == 1)
end
return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="852">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[-- Handles customer speech bubbles for smoothie orders 

]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="853">
            <Properties>
              <string name="Name">UnstuckController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CAS = game:GetService("ContextActionService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.UnstuckConfig)
local getEvent = require(Shared.Events.UnstuckEvents)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)
local player = Players.LocalPlayer
local Controller = {}
local started = false
function Controller.Init()
    if started then
        return
    end
    started = true
    local remote = getEvent()
    local gui = Instance.new("ScreenGui")
    gui.Name = "UnstuckGui"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 5
    gui.Parent = player:WaitForChild("PlayerGui")
    local button = Instance.new("TextButton")
    button.Name = "Unstuck"
    button.AnchorPoint = Vector2.new(0.5, 0)
    button.Position = UDim2.fromScale(0.5, 0.16)
    button.Size = UDim2.fromOffset(180, 48)
    button.BackgroundColor3 = Color3.fromRGB(247, 191, 71)
    button.TextColor3 = Color3.fromRGB(42, 35, 27)
    button.Font = Enum.Font.FredokaOne
    button.TextSize = 22
    button.Text = "UNSTUCK"
    button.Selectable = true
    button.Visible = false
    button.Parent = gui
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = button
    local hint = Instance.new("TextLabel")
    hint.Name = "Eligibility"
    hint.BackgroundTransparency = 1
    hint.Position = UDim2.new(0, -40, 1, 4)
    hint.Size = UDim2.new(1, 80, 0, 32)
    hint.Font = Enum.Font.FredokaOne
    hint.TextSize = 14
    hint.TextColor3 = Color3.new(1, 1, 1)
    hint.TextStrokeTransparency = 0.3
    hint.TextWrapped = true
    hint.Text = "Stuck after a hit? (U / D-pad Up)"
    hint.Parent = button
    local feedback = Instance.new("TextLabel")
    feedback.Name = "RecoveryFeedback"
    feedback.AnchorPoint = Vector2.new(0.5, 0)
    feedback.Position = UDim2.new(0.5, 0, 0.16, 52)
    feedback.Size = UDim2.fromOffset(260, 40)
    feedback.BackgroundTransparency = 1
    feedback.Font = hint.Font
    feedback.TextSize = 18
    feedback.TextColor3 = hint.TextColor3
    feedback.TextStrokeTransparency = hint.TextStrokeTransparency
    feedback.TextWrapped = true
    feedback.Visible = false
    feedback.Parent = gui
    local feedbackUntil = 0
    local shown = false
    local pendingUntil = 0
    local bound = false
    local function request()
        if shown and os.clock() >= pendingUntil then
            pendingUntil = os.clock() + Config.RequestIntervalSeconds
            remote:FireServer("Recover")
        end
    end
    local function render(visible: boolean)
        shown = visible
        button.Visible = visible
        if visible and not bound then
            bound = true
            CAS:BindAction("UnstuckRecovery", function(_, state)
                if state == Enum.UserInputState.Begin then
                    request()
                end
                return Enum.ContextActionResult.Sink
            end, false, Enum.KeyCode.U, Enum.KeyCode.DPadUp)
        elseif not visible and bound then
            bound = false
            CAS:UnbindAction("UnstuckRecovery")
        end
    end
    button.Activated:Connect(request)
    remote.OnClientEvent:Connect(function(result: string, recoveredCharacter: Model?)
        if result == "Unstuck!" or result == "Returned to your plot!" then
            if recoveredCharacter ~= player.Character then
                return
            end
            render(false)
            feedback.Text = result
            feedbackUntil = os.clock() + Config.FeedbackSeconds
            feedback.Visible = PanelManager.GetActive() == nil
            local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if
                recoveredCharacter == player.Character
                and h
                and h.Health > 0
                and player:GetAttribute("Stunned") ~= true
            then
                -- Humanoid state transitions must also run on the owning client.
                h.PlatformStand = false
                h.AutoRotate = true
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        else
            hint.Text = result
        end
    end)
    player.CharacterAdded:Connect(function()
        feedbackUntil = 0
        feedback.Visible = false
        render(false)
    end)
    player:GetAttributeChangedSignal("UnstuckEligible"):Connect(function()
        if player:GetAttribute("UnstuckEligible") ~= true then
            render(false)
        end
    end)
    task.spawn(function()
        local lastPosition: Vector3? = nil
        local lastCharacter: Model? = nil
        while true do
            task.wait(Config.SampleSeconds)
            feedback.Visible = os.clock() < feedbackUntil and PanelManager.GetActive() == nil
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local part = character and character:FindFirstChild("HumanoidRootPart")
            local root = if part and part:IsA("BasePart") then part else nil
            local live = humanoid ~= nil and humanoid.Health > 0 and root ~= nil
            if character ~= lastCharacter then
                lastPosition = nil
                lastCharacter = character
            end
            local moved = root ~= nil
                and lastPosition ~= nil
                and (root.Position - lastPosition).Magnitude > Config.MaxDisplacement
            if player:GetAttribute("UnstuckWatching") == true and live then
                -- Input is an intent hint only; server measures displacement/obstruction.
                remote:FireServer((humanoid :: Humanoid).MoveDirection.Magnitude > 0.05)
            end
            render(
                live
                    and not moved
                    and player:GetAttribute("UnstuckEligible") == true
                    and player:GetAttribute("Stunned") ~= true
                    and PanelManager.GetActive() == nil
            )
            lastPosition = if root then root.Position else nil
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="854">
            <Properties>
              <string name="Name">UpgradesController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Display = require(script.Parent.Parent.UI.UpgradeDisplay)
local Gui = require(script.Parent.Parent.UI.UpgradesGui)
local Notifications = require(script.Parent.Parent.UI.MenuNotifications)
local BadgeState = require(script.Parent.Parent.UI.UpgradeBadgeState)
local MoneyFormat = require(ReplicatedStorage.Shared.MoneyFormat)
local CashTicker = require(script.Parent.Parent.UI.CashTicker)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
        local view: Gui.View? = nil
        local remote: RemoteEvent? = nil
        local pending: string? = nil
        local generation = 0
        local membershipGeneration = 0
        local membershipUpdating = false
        local feedback: { [string]: string } = {}
        local feedbackVersion: { [string]: number } = {}
        local serverMax: { [string]: boolean } = {}
        local badge = BadgeState.new()
        local badgeQueued = false
        local tickerTarget: number? = nil

        local function numberAttribute(name: string): number?
            local value = player:GetAttribute(name)
            return if typeof(value) == "number" then value else nil
        end
        local function rowState(track: { Id: string, Name: string, Attribute: string })
            return if membershipUpdating
                then nil
                else Display.Row(
                    track.Id,
                    numberAttribute(track.Id .. (if track.Id == "CarryCapacity" then "Level" else "PurchasedLevel")),
                    numberAttribute(track.Attribute)
                )
        end
        local function refreshBadge()
            local eligible: { [string]: number } = {}
            local cash = numberAttribute("playerCash")
            for _, track in Display.Tracks do
                local state = rowState(track)
                if
                    state
                    and not state.Max
                    and not serverMax[track.Id]
                    and state.Price
                    and cash
                    and cash >= state.Price
                then
                    eligible[track.Id] = state.Level
                end
            end
            Notifications.Set("Upgrades", badge.Refresh(eligible, Notifications.IsOpen("Upgrades"), membershipUpdating))
        end
        Notifications.OnOpened("Upgrades", refreshBadge)
        local function refresh()
            if not badgeQueued then
                badgeQueued = true
                task.delay(0, function()
                    badgeQueued = false
                    refreshBadge()
                end)
            end
            local currentView = view
            if not currentView then
                return
            end
            local cash = numberAttribute("playerCash")
            if cash == nil then
                CashTicker.Clear()
                tickerTarget = nil
                if currentView.Cash then
                    currentView.Cash.Text = "$\u{2014}"
                end
            end
            if cash and cash ~= tickerTarget then
                if tickerTarget == nil then
                    CashTicker.Bind(currentView.Cash, cash)
                end
                tickerTarget = cash
                CashTicker.SetTarget(cash)
            end
            for _, track in Display.Tracks do
                local row = currentView.Rows[track.Id]
                if not row then
                    continue
                end
                local state = rowState(track)
                local isMax = serverMax[track.Id] or (state ~= nil and state.Max)
                local enabled = remote ~= nil
                    and pending == nil
                    and state ~= nil
                    and not isMax
                    and feedback[track.Id] ~= "PURCHASED!"
                local affordable = cash ~= nil and state ~= nil and state.Price ~= nil and cash >= state.Price
                -- Keep authored colors, backgrounds, typography and FX. Dim only
                -- price/BUY text, retaining server rejection feedback on activation.
                row.Price.TextTransparency = if state
                        and not isMax
                        and not affordable
                    then math.max(row.PriceTransparency, 0.4)
                    else row.PriceTransparency
                row.BuyLabel.TextTransparency = if enabled and not affordable
                    then math.max(row.BuyTransparency, 0.4)
                    else row.BuyTransparency
                row.Title.Text = track.Name
                row.Current.Text = if state then state.Current else "LOADING..."
                row.Next.Text = if isMax then "MAX" elseif state then state.Next else "-"
                row.Price.Text = if state
                        and state.Price
                        and not isMax
                    then (if Display.IsStatTrack(track.Id)
                        then MoneyFormat.Full(state.Price)
                        else MoneyFormat.Compact(state.Price))
                    else ""
                row.BuyLabel.Text = if remote == nil
                        or state == nil
                        or pending == track.Id
                    then "..."
                    elseif feedback[track.Id] == "PURCHASED!" then "PURCHASED!"
                    elseif isMax then "MAX"
                    elseif feedback[track.Id] then feedback[track.Id]
                    else "BUY"
                row.Purchase.Interactable = enabled
            end
        end
        local function showFeedback(id: string, message: string)
            local version = (feedbackVersion[id] or 0) + 1
            feedbackVersion[id] = version
            feedback[id] = message
            local membershipToken = membershipGeneration
            task.delay(if message == "PURCHASED!" then 0.8 else 1.5, function()
                if membershipGeneration == membershipToken and feedbackVersion[id] == version then
                    feedback[id] = nil
                    refresh()
                end
            end)
        end
        player:GetAttributeChangedSignal("playerCash"):Connect(refresh)
        player.CharacterAdded:Connect(function()
            CashTicker.Snap(numberAttribute("playerCash") or 0)
        end)
        local function membershipChanged()
            generation += 1
            pending = nil
            membershipGeneration += 1
            local token = membershipGeneration
            membershipUpdating = true
            badge.Reset()
            table.clear(serverMax)
            table.clear(feedback)
            refresh()
            -- Membership identity is published before the upgrade projection.
            task.defer(function()
                if membershipGeneration == token then
                    membershipUpdating = false
                    refresh()
                end
            end)
        end
        player:GetAttributeChangedSignal("PlotSessionId"):Connect(membershipChanged)
        player:GetAttributeChangedSignal("PlotMembershipRevision"):Connect(membershipChanged)
        for _, track in Display.Tracks do
            player
                :GetAttributeChangedSignal(
                    track.Id .. (if track.Id == "CarryCapacity" then "Level" else "PurchasedLevel")
                )
                :Connect(function()
                    serverMax[track.Id] = nil
                    refresh()
                end)
            if track.Attribute ~= track.Id .. (if track.Id == "CarryCapacity" then "Level" else "PurchasedLevel") then
                player:GetAttributeChangedSignal(track.Attribute):Connect(refresh)
            end
        end
        Gui.Observe(playerGui, function(nextView)
            view = nextView
            tickerTarget = numberAttribute("playerCash")
            CashTicker.Bind(if nextView then nextView.Cash else nil, tickerTarget or 0)
            refresh()
        end, function(id)
            local track
            for _, candidate in Display.Tracks do
                if candidate.Id == id then
                    track = candidate
                    break
                end
            end
            if not track or not view then
                return
            end
            local state = rowState(track)
            local request = remote
            if
                not request
                or pending
                or not state
                or state.Max
                or serverMax[track.Id]
                or feedback[track.Id] == "PURCHASED!"
            then
                return
            end
            feedbackVersion[track.Id] = (feedbackVersion[track.Id] or 0) + 1
            feedback[track.Id] = nil
            pending = track.Id
            generation += 1
            local token = generation
            refresh()
            request:FireServer("PurchaseUpgrade", track.Id, state.Level + 2, {
                PlotSessionId = player:GetAttribute("PlotSessionId"),
                MembershipRevision = player:GetAttribute("PlotMembershipRevision"),
            })
            -- The shared server throttle can drop a request without a response.
            task.delay(5, function()
                if generation == token and pending == track.Id then
                    pending = nil
                    showFeedback(track.Id, "TRY AGAIN")
                    refresh()
                end
            end)
        end)
        refresh()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local request = events:WaitForChild("GameplayRequest")
        assert(request:IsA("RemoteEvent"), "GameplayRequest must be a RemoteEvent")
        request.OnClientEvent:Connect(function(action: any, result: any)
            if action ~= "PurchaseUpgradeResult" or type(result) ~= "table" then
                return
            end
            if
                result.PlotSessionId ~= player:GetAttribute("PlotSessionId")
                or result.MembershipRevision ~= player:GetAttribute("PlotMembershipRevision")
            then
                return
            end
            if result.reason == "InvalidUpgrade" then
                warn("Upgrade purchase rejected: InvalidUpgrade")
            end
            local id = result.upgradeId
            if type(id) ~= "string" or not Display.Row(id, 0) or type(result.success) ~= "boolean" then
                return
            end
            if pending ~= id then
                return
            end
            pending = nil
            generation += 1
            if result.reason == "MaxLevel" then
                serverMax[id] = true
            end
            showFeedback(id, Display.Feedback(result.success, result.reason))
            -- Response levels never replace replicated player state.
            refresh()
        end)
        remote = request
        refresh()
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="855">
            <Properties>
              <string name="Name">WorldStrokeController</string>
              <string name="Source"><![CDATA[--!strict
-- AbsoluteSize is camera-dependent. Server-authored/replicated world lettering
-- publishes stud thickness; each client owns the rendered pixel thickness.
local Style = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local Controller = {}
local started = false
function Controller.Init()
    if started then
        return
    end
    started = true
    local tracked: { [UIStroke]: () -> () } = {}
    local function track(object: Instance)
        if not object:IsA("UIStroke") or tracked[object] then
            return
        end
        local stroke = object
        local stop: (() -> ())? = nil
        local function refresh()
            local label = stroke.Parent
            local gui = stroke:FindFirstAncestorWhichIsA("BillboardGui")
            local thickness = stroke:GetAttribute("WorldThicknessStuds")
            if stop then
                stop()
                stop = nil
            end
            if label and label:IsA("GuiObject") and gui and typeof(thickness) == "number" then
                stop = Style.ApplyWorldStroke(label, gui :: BillboardGui, {
                    Name = stroke.Name,
                    ThicknessStuds = thickness,
                    Color = stroke.Color,
                    Transparency = stroke.Transparency,
                })
            end
        end
        local attribute = stroke:GetAttributeChangedSignal("WorldThicknessStuds"):Connect(refresh)
        local ancestry = stroke.AncestryChanged:Connect(refresh)
        tracked[stroke] = function()
            attribute:Disconnect()
            ancestry:Disconnect()
            if stop then
                stop()
            end
        end
        refresh()
    end
    workspace.DescendantAdded:Connect(track)
    workspace.DescendantRemoving:Connect(function(object)
        if object:IsA("UIStroke") then
            local stop = tracked[object]
            if stop then
                stop()
                tracked[object] = nil
            end
        end
    end)
    for _, object in workspace:GetDescendants() do
        track(object)
    end
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="856">
            <Properties>
              <string name="Name">WorldTextController</string>
              <string name="Source"><![CDATA[--!strict
local Presentation = require(script.Parent.Parent.UI.WorldTextPresentation)
local Controller = {}
local started = false

type Entry = {
    Connection: RBXScriptConnection?,
    Handle: Presentation.Handle?,
    MaxDistance: number?,
    TextSize: number?,
}

local function positiveNumber(value: any): number?
    return if typeof(value) == "number" and value > 0 and value < math.huge then value else nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local tracked: { [Attachment]: Entry } = {}
    local function clear(entry: Entry)
        local handle = entry.Handle
        entry.Handle = nil
        if handle then
            handle:Destroy()
        end
    end
    local function refresh(origin: Attachment, entry: Entry)
        local text = origin:GetAttribute("WorldText")
        if not origin:IsDescendantOf(workspace) or typeof(text) ~= "string" or text == "" then
            clear(entry)
            return
        end
        local distance = positiveNumber(origin:GetAttribute("WorldTextMaxDistance"))
        local textSize = positiveNumber(origin:GetAttribute("WorldTextTextSize"))
        if entry.MaxDistance ~= distance or entry.TextSize ~= textSize then
            clear(entry)
        end
        entry.MaxDistance, entry.TextSize = distance, textSize
        local handle = entry.Handle
        if not handle then
            local settings: Presentation.Settings = {
                Origin = origin,
                Text = text,
                MaxDistance = distance,
                TextSize = textSize,
            }
            handle = Presentation.Create(settings)
            entry.Handle = handle
        else
            handle:SetText(text)
        end
        if handle then
            handle:SetVisible(origin:GetAttribute("WorldTextVisible") ~= false)
        end
    end
    local function track(object: Instance)
        if not object:IsA("Attachment") or tracked[object] or not object:IsDescendantOf(workspace) then
            return
        end
        local entry: Entry = {}
        tracked[object] = entry
        -- Track bare Attachments too: attributes may replicate or be authored later.
        entry.Connection = object.AttributeChanged:Connect(function(attribute)
            if
                attribute == "WorldText"
                or attribute == "WorldTextVisible"
                or attribute == "WorldTextMaxDistance"
                or attribute == "WorldTextTextSize"
            then
                refresh(object, entry)
            end
        end)
        refresh(object, entry)
    end
    workspace.DescendantAdded:Connect(track)
    workspace.DescendantRemoving:Connect(function(object)
        if not object:IsA("Attachment") then
            return
        end
        local entry = tracked[object]
        if not entry then
            return
        end
        tracked[object] = nil
        if entry.Connection then
            entry.Connection:Disconnect()
        end
        clear(entry)
    end)
    -- Connect first so objects arriving during startup cannot be missed.
    for _, object in workspace:GetDescendants() do
        track(object)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="857">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="858">
            <Properties>
              <string name="Name">AnnouncementBanner</string>
              <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Style = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
export type Surface = {
    Gui: ScreenGui,
    Label: TextLabel,
    Show: (string) -> (),
    Exit: () -> (),
    Hide: () -> (),
    Destroy: () -> (),
}
local Banner = {}
local priority = Instance.new("BindableEvent")
local globalActive = false
Banner.PriorityChanged = priority.Event
function Banner.IsGlobalActive(): boolean
    return globalActive
end
function Banner.SetGlobalActive(active: boolean)
    if globalActive ~= active then
        globalActive = active
        priority:Fire()
    end
end
function Banner.Create(playerGui: PlayerGui, name: string): Surface
    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = false
    gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
    gui.DisplayOrder = 20
    local label = Instance.new("TextLabel")
    label.Name = "Announcement"
    label.AnchorPoint = Vector2.new(0.5, 0)
    local resting = UDim2.fromScale(0.5, 0.065)
    label.Position = resting
    label.Size = UDim2.new(0.92, 0, 0, 104)
    label.BackgroundTransparency = 1
    Style.Apply(label, 32)
    label.TextWrapped, label.TextScaled, label.RichText = true, true, true
    label.Visible = false
    label.Parent = gui
    local width = Instance.new("UISizeConstraint")
    width.MaxSize = Vector2.new(780, 104)
    width.Parent = label
    local textSize = Instance.new("UITextSizeConstraint")
    textSize.MinTextSize, textSize.MaxTextSize = 18, 32
    textSize.Parent = label
    local stroke = Style.Outline(label)
    local scale = Instance.new("UIScale")
    scale.Parent = label
    gui.Parent = playerGui
    local tweens: { Tween } = {}
    local function cancel()
        for _, tween in tweens do
            tween:Cancel()
        end
        table.clear(tweens)
    end
    local function tween(object: Instance, info: TweenInfo, properties: any)
        local animation = TweenService:Create(object, info, properties)
        table.insert(tweens, animation)
        animation:Play()
    end
    return {
        Gui = gui,
        Label = label,
        Show = function(text: string)
            cancel()
            label.Text = text
            label.Position = resting - UDim2.fromOffset(0, 14)
            label.TextTransparency, stroke.Transparency, scale.Scale = 1, 1, 0.93
            label.Visible = true
            local enter = TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(label, enter, { Position = resting, TextTransparency = 0 })
            tween(scale, enter, { Scale = 1 })
            tween(stroke, TweenInfo.new(0.16), { Transparency = 0 })
        end,
        Exit = function()
            cancel()
            local exit = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tween(label, exit, { Position = resting - UDim2.fromOffset(0, 10), TextTransparency = 1 })
            tween(stroke, exit, { Transparency = 1 })
        end,
        Hide = function()
            cancel()
            label.Visible = false
        end,
        Destroy = function()
            cancel()
            gui:Destroy()
        end,
    }
end
return Banner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="859">
            <Properties>
              <string name="Name">CashHud</string>
              <string name="Source"><![CDATA[--!strict
local Registry = require(script.Parent.UIRegistry)
local Hud = {}

local function resolveWithin(root: Instance?, playerGui: Instance): GuiObject?
    local cash = Registry.Child(root, "CashDisplay", { "CashDisplay" }, "GuiObject")
    local label = Registry.Child(cash, "Cash", { "{Coins}", "Cash" }, "TextLabel")
    local target = if cash and label then cash else Registry.Child(root, "Cash", { "{Coins}", "Cash" }, "TextLabel")
    local activeLabel = label or target
    if target and target:IsA("GuiObject") and activeLabel and Registry.ActiveRoot(activeLabel, playerGui) then
        if target.AbsoluteSize.X > 0 and target.AbsoluteSize.Y > 0 then
            return target
        end
    end
    return nil
end

function Hud.Resolve(playerGui: Instance): GuiObject?
    local selected: GuiObject? = nil
    for _, desktop in Registry.Desktops(playerGui) do
        if Registry.ActiveRoot(desktop, playerGui) then
            local content = Registry.Content(desktop)
            local top = Registry.Child(content, "TOP", { "TOP" }, "GuiObject")
            local target = resolveWithin(top, playerGui) or resolveWithin(content, playerGui)
            if not target and content ~= desktop then
                local desktopTop = Registry.Child(desktop, "TOP", { "TOP" }, "GuiObject")
                target = resolveWithin(desktopTop, playerGui) or resolveWithin(desktop, playerGui)
            end
            if target then
                if selected and selected ~= target then
                    return nil
                end
                selected = target
            end
        end
    end
    return selected
end

-- All AbsolutePositions share the CoreUISafeInsets coordinate system, even
-- when the imported ScreenGui ignores insets. Subtract our actual canvas origin.
function Hud.Center(target: GuiObject, canvas: GuiObject): Vector2
    return target.AbsolutePosition + target.AbsoluteSize / 2 - canvas.AbsolutePosition
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="860">
            <Properties>
              <string name="Name">CashRewardAnimation</string>
              <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.CashFeedback)
local Audio = require(script.Parent.Parent.Controllers.GameplayAudioController)
local Hud = require(script.Parent.CashHud)
local CashTicker = require(script.Parent.CashTicker)
local Debug = require(script.Parent.CashRewardDebug)
local Animation = {}
local random = Random.new()
type Burst = { Collected: boolean }
type Icon = {
    View: ImageLabel,
    Start: number,
    Origin: Vector2,
    Spread: Vector2,
    Arc: number,
    Size: number,
    Rotation: number,
    Float: number,
    Burst: Burst,
}
type Punch = { Target: GuiObject, Scale: UIScale, Base: number, Last: number, Owned: boolean, Start: number }
local icons: { Icon } = {}
local punch: Punch? = nil
local gui: ScreenGui? = nil
local canvas: Frame? = nil
local connection: RBXScriptConnection? = nil
local playerGui: PlayerGui? = nil

local function stopPunch()
    local current = punch
    punch = nil
    if current and current.Scale.Parent then
        if current.Owned then
            current.Scale:Destroy()
        elseif math.abs(current.Scale.Scale - current.Last) < 0.0001 then
            current.Scale.Scale = current.Base
        end
    end
end

local function collect(target: GuiObject)
    local player = game:GetService("Players").LocalPlayer
    local cash = if player then player:GetAttribute("playerCash") else nil
    if type(cash) == "number" then
        CashTicker.SetTarget(cash)
    end
    -- Consecutive arrivals extend one pulse rather than accumulating scales.
    if punch and punch.Target == target then
        punch.Start = os.clock()
        return
    end
    stopPunch()
    local existing = target:FindFirstChildOfClass("UIScale")
    local scale = existing or Instance.new("UIScale")
    if not existing then
        scale.Name = "CashArrivalScale"
        scale.Parent = target
    end
    punch = {
        Target = target,
        Scale = scale,
        Base = scale.Scale,
        Last = scale.Scale,
        Owned = existing == nil,
        Start = os.clock(),
    }
end

function Animation.Clear()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    for _, icon in icons do
        icon.View:Destroy()
    end
    table.clear(icons)
    stopPunch()
    if gui then
        gui:Destroy()
    end
    gui, canvas, playerGui = nil, nil, nil
end

local function step()
    local container, layer = playerGui, canvas
    if not container or not layer or not layer:IsDescendantOf(container) then
        Animation.Clear()
        return
    end
    local now = os.clock()
    local target = Hud.Resolve(container)
    local destination = if target then Hud.Center(target, layer) else layer.AbsoluteSize / 2
    for index = #icons, 1, -1 do
        local icon = icons[index]
        local age = now - icon.Start
        local flightStart = 0.12 + icon.Float
        local duration = flightStart + 0.32
        if age >= duration then
            if target and age >= duration and not icon.Burst.Collected then
                icon.Burst.Collected = true
                collect(target)
                Audio.PlayCashFeedback("Collect")
            end
            icon.View:Destroy()
            table.remove(icons, index)
        elseif age >= 0 then
            local view = icon.View
            view.Visible = true
            local at, scale, fade = icon.Origin, 1, 0
            if age < 0.12 then
                local t = age / 0.12
                local ease = 1 - (1 - t) ^ 3
                at = icon.Origin + icon.Spread * ease
                scale = 0.3 + 0.7 * ease + math.sin(t * math.pi) * 0.25
            elseif age < flightStart then
                local t = (age - 0.12) / icon.Float
                at = icon.Origin + icon.Spread + Vector2.new(0, -6 * math.sin(t * math.pi / 2))
            else
                local t = (age - flightStart) / 0.32
                local eased = t * t
                local from = icon.Origin + icon.Spread + Vector2.new(0, -6)
                local control = (from + destination) / 2 + Vector2.new(icon.Arc, -50)
                at = from * (1 - eased) ^ 2 + control * (2 * (1 - eased) * eased) + destination * eased ^ 2
                scale = 1 - 0.8 * t
                fade = math.clamp((t - 0.6) / 0.4, 0, 1)
            end
            view.Position = UDim2.fromOffset(at.X, at.Y)
            local stretch = if age < 0.12 then math.sin(age / 0.12 * math.pi) * 0.16 else 0
            view.Size = UDim2.fromOffset(icon.Size * scale * (1 + stretch), icon.Size * scale * (1 - stretch))
            view.Rotation = icon.Rotation * math.min(age / 0.12, 1)
            view.ImageTransparency = fade
        end
    end
    local current = punch
    if current then
        if
            current.Target ~= target
            or not current.Scale.Parent
            or math.abs(current.Scale.Scale - current.Last) > 0.0001
        then
            -- Yield to Framewisp if it takes ownership of the same scale.
            stopPunch()
        else
            local t = (now - current.Start) / 0.22
            if t >= 1 then
                stopPunch()
            else
                current.Last = current.Base * (1 + 0.08 * math.sin(t * math.pi))
                current.Scale.Scale = current.Last
            end
        end
    end
    if #icons == 0 and not punch then
        Animation.Clear()
    end
end

function Animation.Play(player: Player)
    if Config.Image == "" then
        Debug.Log(player, "asset failed to load: empty image; burst skipped")
        return
    end
    local container = player:FindFirstChildOfClass("PlayerGui")
    local camera = workspace.CurrentCamera
    local character = player.Character
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    if not container then
        Debug.Log(player, "burst skipped: no PlayerGui")
        return
    end
    if not camera then
        Debug.Log(player, "burst skipped: no camera")
        return
    end
    if not root or not root:IsA("BasePart") then
        Debug.Log(player, "burst skipped: no character/HumanoidRootPart")
        return
    end
    local torso = character and (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"))
    local position = if torso and torso:IsA("BasePart") then torso.Position else root.Position + Vector3.new(0, 1, 0)
    local projected, onScreen = camera:WorldToScreenPoint(position)
    local target = Hud.Resolve(container)
    if not target then
        Debug.Log(
            player,
            "HUD target missing: Desktop.Content.TOP.CashDisplay.Cash/{Coins} and aliases; centered burst"
        )
    end
    if not onScreen or projected.Z <= 0 then
        Debug.Log(player, "burst skipped: off-screen character")
        return
    end
    if gui and (playerGui ~= container or not gui:IsDescendantOf(container)) then
        Animation.Clear()
    end
    local count = math.min(random:NextInteger(5, 8), Config.MaxIcons - #icons)
    if count < 5 then
        Debug.Log(player, "burst skipped: icon capacity")
        return
    end
    if not gui then
        local overlay = Instance.new("ScreenGui")
        overlay.Name = "CashRewardEffects"
        overlay.ResetOnSpawn = false
        overlay.DisplayOrder = 1000
        overlay.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
        local layer = Instance.new("Frame")
        layer.BackgroundTransparency = 1
        layer.Size = UDim2.fromScale(1, 1)
        layer.Parent = overlay
        overlay.Parent = container
        gui, canvas, playerGui = overlay, layer, container
    end
    local layer = canvas :: Frame
    local origin = if target
        then Vector2.new(projected.X, projected.Y) - layer.AbsolutePosition
        else layer.AbsoluteSize / 2
    local viewport = camera.ViewportSize
    local radius = math.clamp(math.min(viewport.X, viewport.Y) * 0.065, 22, 44)
    origin = Vector2.new(
        math.clamp(origin.X, radius, math.max(radius, layer.AbsoluteSize.X - radius)),
        math.clamp(origin.Y, radius, math.max(radius, layer.AbsoluteSize.Y - radius))
    )
    local burst: Burst = { Collected = false }
    local now = os.clock()
    local stagger = random:NextNumber(0.04, 0.05)
    for index = 1, count do
        local view = Instance.new("ImageLabel")
        view.Name = "CashIcon"
        view.Image = Config.Image
        view.BackgroundTransparency = 1
        view.AnchorPoint = Vector2.new(0.5, 0.5)
        view.Visible = false
        view.Parent = layer
        if index == 1 then
            Debug.WatchImage(player, view)
        end
        local angle = (index - 1) / count * math.pi * 2 + random:NextNumber(-0.25, 0.25)
        local spread = radius * random:NextNumber(0.65, 1)
        table.insert(icons, {
            View = view,
            Start = now + (index - 1) * stagger,
            Origin = origin,
            Spread = Vector2.new(math.cos(angle), math.sin(angle)) * spread,
            Arc = random:NextNumber(-45, 45),
            Size = random:NextNumber(25, 34),
            Rotation = random:NextNumber(-18, 18),
            Float = random:NextNumber(0.15, 0.2),
            Burst = burst,
        })
    end
    Audio.PlayCashFeedback("Pop")
    if not connection then
        connection = RunService.RenderStepped:Connect(step)
    end
end

return Animation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="861">
            <Properties>
              <string name="Name">CashRewardDebug</string>
              <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ContentProvider = game:GetService("ContentProvider")
local Debug = {}
local window, lines, watching = 0, 0, 0

function Debug.Enabled(player: Player): boolean
    return RunService:IsStudio() and player:GetAttribute("CashRewardDebug") == true
end

function Debug.Log(player: Player, message: string)
    if not Debug.Enabled(player) then
        return
    end
    local now = os.clock()
    if now - window >= 5 then
        window, lines = now, 0
    end
    if lines < 20 then
        lines += 1
        warn("[CashReward] " .. message)
    end
end

-- Sample one real icon per burst, with at most four pending probes. Preload's
-- status survives the short-lived icon; IsLoaded catches already cached images.
function Debug.WatchImage(player: Player, view: ImageLabel)
    if not Debug.Enabled(player) or watching >= 4 then
        return
    end
    watching += 1
    local image = view.Image
    local done = false
    local changed: RBXScriptConnection? = nil
    local function finish(loaded: boolean, detail: string)
        if done then
            return
        end
        done = true
        watching -= 1
        if changed then
            changed:Disconnect()
        end
        Debug.Log(
            player,
            string.format("asset %s: %s (%s)", if loaded then "loaded" else "failed to load", image, detail)
        )
    end
    changed = view:GetPropertyChangedSignal("IsLoaded"):Connect(function()
        if view.IsLoaded then
            finish(true, "ImageLabel.IsLoaded")
        end
    end)
    if view.IsLoaded then
        finish(true, "ImageLabel.IsLoaded")
        return
    end
    task.delay(5, function()
        finish(view.IsLoaded, "five-second timeout; check asset permissions/moderation/network")
    end)
    task.spawn(function()
        local ok = pcall(function()
            ContentProvider:PreloadAsync({ image }, function(_, status)
                finish(status == Enum.AssetFetchStatus.Success, tostring(status))
            end)
        end)
        if not ok then
            finish(false, "PreloadAsync error")
        end
    end)
end

return Debug
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="862">
            <Properties>
              <string name="Name">CashRewardState</string>
              <string name="Source"><![CDATA[--!strict
local State = {}

-- Each consumed smoothie has a server-generated GUID. Remember it for the
-- client session, including skipped effects and respawns, so replay never animates.
function State.New(): (any, any, any, number) -> (boolean, string)
    local seen: { [string]: boolean } = {}
    return function(moment: any, owner: any, payload: any, localUserId: number): (boolean, string)
        if moment ~= "CustomerReaction" then
            return false, "wrong moment"
        elseif owner ~= localUserId then
            return false, "owner mismatch"
        elseif type(payload) ~= "table" then
            return false, "bad payload"
        end
        local id, payout = payload.BlendId, payload.Payout
        if type(id) ~= "string" or id == "" then
            return false, "bad BlendId"
        end
        if type(payout) ~= "number" or payout ~= payout or payout <= 0 or payout == math.huge then
            return false, "bad payout"
        end
        if seen[id] then
            return false, "duplicate"
        end
        seen[id] = true
        return true, "accepted"
    end
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="863">
            <Properties>
              <string name="Name">CashTicker</string>
              <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local MoneyFormat = require(game:GetService("ReplicatedStorage").Shared.MoneyFormat)
local Model = require(script.Parent.CashTickerModel)
local Ticker = {}
type View = { Label: TextLabel, State: Model.State }
local view: View? = nil
local render: RBXScriptConnection? = nil

local function stop()
    if render then
        render:Disconnect()
        render = nil
    end
end

function Ticker.Clear()
    stop()
    view = nil
end

function Ticker.Bind(label: TextLabel?, value: number)
    Ticker.Clear()
    if not label then
        return
    end
    view = { Label = label, State = Model.New(value) }
    label.Visible = true
    label.Text = MoneyFormat.Full(value)
end

function Ticker.SetTarget(value: number)
    local current = view
    if not current or value ~= value or value < 0 or value == math.huge then
        return
    end
    local target = math.floor(value)
    if render and target == current.State.Target then
        return
    end
    stop()
    Model.Retarget(current.State, target, os.clock())
    if current.State.Duration == 0 then
        current.Label.Text = MoneyFormat.Full(target)
        return
    end
    render = RunService.RenderStepped:Connect(function()
        local ok, rolling = pcall(function()
            local active = Model.Sample(current.State, os.clock())
            current.Label.Text = MoneyFormat.Full(if active then math.floor(current.State.Value + 0.5) else target)
            return active
        end)
        if not ok or not rolling then
            stop()
            if not ok then
                -- Keep the authored renderer and settle to the correct balance if animation fails.
                current.State = Model.New(target)
                pcall(function()
                    current.Label.Text = MoneyFormat.Full(target)
                end)
            end
        end
    end)
end

function Ticker.Snap(value: number)
    stop()
    if view then
        view.State = Model.New(value)
        view.Label.Text = MoneyFormat.Full(value)
    end
end

return Ticker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="864">
            <Properties>
              <string name="Name">CashTickerModel</string>
              <string name="Source"><![CDATA[--!strict
-- Presentation only: tween the value displayed by the authored cash label.
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.CashFeedback).Ticker
local Model = {}
export type State = { Value: number, From: number, Target: number, Start: number, Duration: number }

function Model.Digits(value: number): number
    return #string.format("%.0f", math.floor(math.max(0, value)))
end

function Model.New(value: number): State
    return { Value = value, From = value, Target = value, Start = 0, Duration = 0 }
end

function Model.Sample(state: State, now: number): boolean
    local t = if state.Duration == 0 then 1 else math.clamp((now - state.Start) / state.Duration, 0, 1)
    -- Cubic Out, equivalent to TweenService easing without an engine dependency.
    state.Value = if t == 1
        then state.Target
        else state.From + (state.Target - state.From) * (1 - (1 - t) ^ Config.EasingExponent)
    return t < 1
end

function Model.Retarget(state: State, target: number, now: number)
    if state.Duration > 0 and state.Value ~= state.Target and target == state.Target then
        return
    end
    -- Value is the last rendered sample; never restart from the old target.
    local changed = 0
    for place = 0, math.max(Model.Digits(state.Value), Model.Digits(target)) - 1 do
        if math.floor(state.Value / 10 ^ place) % 10 ~= math.floor(target / 10 ^ place) % 10 then
            changed += 1
        end
    end
    state.From, state.Target, state.Start = state.Value, target, now
    state.Duration = if state.Value == target
        then 0
        else math.clamp(
            Config.BaseDuration + Config.PerDigitDuration * changed,
            Config.MinDuration,
            Config.MaxDuration
        )
end

return Model
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="865">
            <Properties>
              <string name="Name">FilmCamPanel</string>
              <string name="Source"><![CDATA[--!strict
local Panel = {}

function Panel.Create(parent: PlayerGui)
    local gui = Instance.new("ScreenGui")
    gui.Name = "FilmCam"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 10000
    gui.Enabled = false
    gui:SetAttribute("FilmCamDevUI", true)
    local bars = {}
    for i = 1, 2 do
        local bar = Instance.new("Frame")
        bar.Name = "Letterbox"
        bar.Size = UDim2.fromScale(1, 0.12)
        bar.Position = UDim2.fromScale(0, if i == 1 then 0 else 0.88)
        bar.BackgroundColor3 = Color3.new(0, 0, 0)
        bar.BorderSizePixel = 0
        bar.Visible = false
        bar.Parent = gui
        table.insert(bars, bar)
    end
    local frame = Instance.new("Frame")
    frame.Name = "Panel"
    frame.Size = UDim2.fromOffset(340, 424)
    frame.Position = UDim2.new(0, 12, 0.14, 0)
    frame.BackgroundColor3 = Color3.fromRGB(25, 28, 34)
    frame.Parent = gui
    local function control(class: string, text: string, x: number, y: number, width: number): any
        local object = Instance.new(class) :: any
        object.Size = UDim2.fromOffset(width, 28)
        object.Position = UDim2.fromOffset(x, y)
        object.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
        object.TextColor3 = Color3.new(1, 1, 1)
        object.TextSize = 14
        object.Font = Enum.Font.Code
        object.Text = text
        if object:IsA("TextBox") then
            object.ClearTextOnFocus = false
        end
        object.Parent = frame
        return object
    end
    local title = control("TextLabel", "FilmCam | F6 exit | F7 panel", 8, 6, 324)
    local hidePanel = control("TextButton", "Hide", 0, 0, 64) :: TextButton
    hidePanel.Name = "HidePanel"
    hidePanel.TextSize = 12
    hidePanel.BorderSizePixel = 0
    hidePanel.ZIndex = 3
    -- Survive panel hiding; the controller docks Show inside the top letterbox bar.
    hidePanel.Parent = gui
    hidePanel.AnchorPoint = Vector2.new(1, 0)
    hidePanel.Position = UDim2.new(1, -12, 0, 12)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = hidePanel
    local name = control("TextBox", "", 8, 40, 324) :: TextBox
    name.PlaceholderText = "Take name (automatic if blank)"
    local record = control("TextButton", "Record", 8, 74, 102) :: TextButton
    local stop = control("TextButton", "Stop", 118, 74, 102) :: TextButton
    local play = control("TextButton", "Play", 228, 74, 104) :: TextButton
    local select = control("TextButton", "No takes | click to cycle", 8, 108, 324) :: TextButton
    local speed = control("TextBox", "1", 8, 142, 102) :: TextBox
    local ease = control("TextButton", "Ease: on", 118, 142, 102) :: TextButton
    local copy = control("TextButton", "Copy Take", 228, 142, 104) :: TextButton
    local push = control("TextButton", "Push-in", 8, 176, 102) :: TextButton
    local pull = control("TextButton", "Pull-out", 118, 176, 102) :: TextButton
    local orbit = control("TextButton", "Orbit", 228, 176, 104) :: TextButton
    local letterbox = control("TextButton", "Letterbox: off", 8, 210, 158) :: TextButton
    local hide = control("TextButton", "Hide UI: off", 174, 210, 158) :: TextButton
    local scrub = control("TextButton", "Seek / progress", 8, 244, 324) :: TextButton
    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale(0, 1)
    fill.BackgroundColor3 = Color3.fromRGB(80, 130, 175)
    fill.BackgroundTransparency = 0.5
    fill.BorderSizePixel = 0
    fill.Parent = scrub
    local status = control("TextLabel", "RMB drag | WASD/QE | speed 0.25-2", 8, 278, 324) :: TextLabel
    status.TextWrapped = true
    status.Size = UDim2.fromOffset(324, 48)
    local export = control("TextBox", "Copy Take puts JSON here; Ctrl+A / Ctrl+C", 8, 332, 324) :: TextBox
    export.Size = UDim2.fromOffset(324, 80)
    export.MultiLine = true
    export.TextWrapped = true
    export.TextSize = 11
    gui.Parent = parent
    return {
        Gui = gui,
        Frame = frame,
        Title = title,
        Name = name,
        Record = record,
        Stop = stop,
        Play = play,
        Select = select,
        Speed = speed,
        Ease = ease,
        Copy = copy,
        Push = push,
        Pull = pull,
        Orbit = orbit,
        Letterbox = letterbox,
        Hide = hide,
        HidePanel = hidePanel,
        Scrub = scrub,
        Fill = fill,
        Status = status,
        Export = export,
        Bars = bars,
    }
end

return Panel
]]></string>
