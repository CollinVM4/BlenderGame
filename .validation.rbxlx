          <Item class="ModuleScript" referent="810">
            <Properties>
              <string name="Name">BatController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Constants.BatConfig)
local Controller = {}
local teardown: (() -> ())? = nil

-- Temporary boundary trace: independent of attribute replication so a missing
-- server request can still be diagnosed. Remove after the Studio repro is resolved.
local function trace(message: string)
    if RunService:IsStudio() then
        print("[BatInput] " .. message)
    end
end

type Playback = {
    Tool: Tool,
    Character: Model,
    Humanoid: Humanoid?,
    Tracks: { [string]: AnimationTrack },
    Connections: { RBXScriptConnection },
    Phase: string,
}
local function disconnect(connections: { RBXScriptConnection })
    for _, connection in connections do
        connection:Disconnect()
    end
    table.clear(connections)
end

function Controller.Destroy()
    if teardown then
        teardown()
        teardown = nil
    end
end

function Controller.Init()
    if teardown then
        return
    end
    local player = Players.LocalPlayer
    trace("BatController initialized trace=input-v1 player=" .. player.Name)
    local characterConnections: { RBXScriptConnection } = {}
    local playerConnections: { RBXScriptConnection } = {}
    local current: Playback? = nil
    local nextSwingAt = 0

    local function clearTool()
        local state = current
        current = nil -- Invalidate completion callbacks before stopping any track.
        if state then
            disconnect(state.Connections)
            for _, track in state.Tracks do
                track:Stop(0)
                track:Destroy()
            end
        end
    end
    local function clearCharacter()
        clearTool()
        disconnect(characterConnections)
    end
    local function stillEquipped(state: Playback): boolean
        local humanoid = state.Humanoid
        return current == state
            and state.Tool.Parent == state.Character
            and player.Character == state.Character
            and humanoid ~= nil
            and humanoid.Health > 0
    end
    local function play(state: Playback, name: string): boolean
        -- Stop callbacks from the interrupted phase cannot resume idle over the next phase.
        state.Phase = "Transition"
        for _, track in state.Tracks do
            track:Stop(0)
        end
        state.Phase = name
        local track = state.Tracks[name]
        if not track then
            return false
        end
        local ok, problem = pcall(function(): string?
            track:Play(0.05, 1, 1)
            return nil
        end)
        if not ok then
            warn("[Bat] Could not play " .. name .. "Animation: " .. tostring(problem))
        end
        return ok
    end
    local function idle(state: Playback)
        if stillEquipped(state) then
            play(state, "Idle")
        end
    end
    local function prepare(state: Playback, humanoid: Humanoid)
        if state.Humanoid ~= humanoid then
            state.Humanoid = humanoid
            table.insert(
                state.Connections,
                humanoid.Died:Connect(function()
                    if current == state then
                        clearTool()
                    end
                end)
            )
        end
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            return
        end
        for _, name in { "Idle", "Equip", "Swing", "Unequip" } do
            if state.Tracks[name] then
                continue
            end
            local animation = state.Tool:FindFirstChild(name .. "Animation")
            if not animation or not animation:IsA("Animation") or animation.AnimationId == "" then
                continue
            end
            -- Reuse the Humanoid's replicated Animator; never create a client-only Animator.
            local ok, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)
            if not ok then
                warn("[Bat] Could not load " .. name .. "Animation: " .. tostring(track))
                continue
            end
            track.Priority = if name == "Idle" then Enum.AnimationPriority.Idle else Enum.AnimationPriority.Action
            track.Looped = name == "Idle"
            state.Tracks[name] = track
            if name ~= "Idle" then
                table.insert(
                    state.Connections,
                    track.Ended:Connect(function()
                        -- Ended can arrive after a stop/replay of this same track.
                        if current ~= state or state.Phase ~= name or track.IsPlaying then
                            return
                        end
                        if name == "Unequip" then
                            clearTool()
                        else
                            idle(state)
                        end
                    end)
                )
            end
        end
    end
    local function unequip(state: Playback)
        if current ~= state or state.Phase == "Unequip" then
            return
        end
        local humanoid = state.Humanoid
        if player.Character ~= state.Character or not humanoid or humanoid.Health <= 0 then
            clearTool()
            return
        end
        -- Retain the death/destruction listeners until this optional outro finishes.
        if not play(state, "Unequip") then
            clearTool()
        end
    end
    local function bind(character: Model)
        clearCharacter()
        nextSwingAt = 0
        local function equipped(child: Instance)
            if not child:IsA("Tool") then
                return
            end
            if child.Name ~= "Bat" then
                if current and current.Phase == "Unequip" then
                    clearTool()
                end
                return
            end
            if current and current.Tool == child and current.Phase ~= "Unequip" then
                return
            end
            clearTool()
            local state: Playback = {
                Tool = child,
                Character = character,
                Humanoid = nil,
                Tracks = {},
                Connections = {},
                Phase = "Equip",
            }
            current = state
            trace("bound Tool.Activated tool=" .. child:GetFullName())
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                prepare(state, humanoid)
            end
            table.insert(
                state.Connections,
                child.Unequipped:Connect(function()
                    unequip(state)
                end)
            )
            table.insert(
                state.Connections,
                child.Destroying:Connect(function()
                    if current == state then
                        clearTool()
                    end
                end)
            )
            table.insert(
                state.Connections,
                child.AncestryChanged:Connect(function()
                    if child.Parent ~= character then
                        unequip(state)
                    end
                end)
            )
            table.insert(
                state.Connections,
                child.Activated:Connect(function()
                    trace("Tool.Activated player=" .. player.Name .. " tool=" .. child:GetFullName())
                    local living = character:FindFirstChildOfClass("Humanoid")
                    local level = child:GetAttribute("BatLevel")
                    if
                        current ~= state
                        or state.Phase == "Unequip"
                        or child.Parent ~= character
                        or player.Character ~= character
                        or not living
                        or living.Health <= 0
                        or player:GetAttribute("Stunned") == true
                        or player:GetAttribute("PlotSessionId") == nil
                        or type(level) ~= "number"
                        or level < 1
                        or os.clock() < nextSwingAt
                    then
                        local reason = if current ~= state
                            then "stale Tool binding"
                            elseif state.Phase == "Unequip" then "unequipping"
                            elseif child.Parent ~= character then "Tool not equipped"
                            elseif player.Character ~= character then "stale character"
                            elseif not living then "missing Humanoid"
                            elseif living.Health <= 0 then "dead Humanoid"
                            elseif player:GetAttribute("Stunned") == true then "attacker Stunned attribute"
                            elseif player:GetAttribute("PlotSessionId") == nil then "missing PlotSessionId attribute"
                            elseif type(level) ~= "number" then "missing/non-numeric Tool BatLevel"
                            elseif level < 1 then "Tool BatLevel locked"
                            else "local swing cooldown"
                        trace("activation rejected: " .. reason)
                        return
                    end
                    local remote = ReplicatedStorage.Shared.Events:FindFirstChild("GameplayRequest")
                    if not remote or not remote:IsA("RemoteEvent") then
                        trace(
                            "activation rejected: GameplayRequest "
                                .. (if remote then "is not a RemoteEvent" else "missing")
                        )
                        return
                    end
                    nextSwingAt = os.clock() + Config.SwingCooldown
                    prepare(state, living)
                    if not play(state, "Swing") then
                        idle(state)
                    end
                    -- Local prediction only. No pose, animation event or timing authorizes a hit.
                    if RunService:IsStudio() then
                        local named = 0
                        for _, event in ReplicatedStorage.Shared.Events:GetChildren() do
                            if event.Name == "GameplayRequest" then
                                named += 1
                            end
                        end
                        trace(
                            "sending SwingBat remote="
                                .. remote:GetFullName()
                                .. " adapter="
                                .. tostring(remote:GetAttribute("BatRequestTraceVersion"))
                                .. " namedRemotes="
                                .. tostring(named)
                                .. " debugArmed="
                                .. tostring(player:GetAttribute("BatDebugNextSwing"))
                        )
                    end
                    remote:FireServer("SwingBat")
                    trace("FireServer returned: SwingBat")
                end)
            )
            if stillEquipped(state) and not play(state, "Equip") then
                idle(state)
            end
        end
        table.insert(characterConnections, character.ChildAdded:Connect(equipped))
        for _, child in character:GetChildren() do
            equipped(child)
        end
    end
    teardown = function()
        clearCharacter()
        disconnect(playerConnections)
    end
    table.insert(playerConnections, player.CharacterAdded:Connect(bind))
    table.insert(playerConnections, player.CharacterRemoving:Connect(clearCharacter))
    if player.Character then
        bind(player.Character)
    end
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="811">
            <Properties>
              <string name="Name">BlenderStatusDistanceController</string>
              <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Controller = {}
local started = false

-- Scoped visibility ranges; Roblox performs camera-distance culling.
local MAX_DISTANCES: { [string]: number } = {
    IngredientCountDisplay = 40,
    TurbineStatusDisplay = 40,
}

function Controller.Init()
    if started then
        return
    end
    started = true
    local cleanups: { [Instance]: () -> () } = {}
    local function register(object: Instance)
        if not object:IsA("TextLabel") or object.Name ~= "Status" then
            return
        end
        local gui = object.Parent
        if not gui or not gui:IsA("BillboardGui") then
            return
        end
        local maxDistance = MAX_DISTANCES[gui.Name]
        if not maxDistance then
            return
        end
        if gui.Name == "TurbineStatusDisplay" then
            local function guidanceRange()
                gui.MaxDistance = if object.Text == "LOAD INGREDIENTS TO BLEND!" then maxDistance else 40
            end
            guidanceRange()
            if not cleanups[object] then
                local changed = object:GetPropertyChangedSignal("Text"):Connect(guidanceRange)
                cleanups[object] = function()
                    changed:Disconnect()
                end
            end
        else
            gui.MaxDistance = maxDistance
        end
        if gui.Name == "IngredientCountDisplay" then
            -- Retain the label's existing centered layout inside the stud canvas.
            object.AnchorPoint = Vector2.new(0.5, 0.5)
            object.Position = UDim2.fromScale(0.5, 0.5)
            object.TextScaled = true
            if not cleanups[object] then
                local scale = Instance.new("UIScale")
                scale.Scale = 1
                scale.Parent = object
                local tween: Tween? = nil
                local function complete(): boolean
                    local loaded, required = string.match(object.Text, "^(%d+)%s*/%s*(%d+)")
                    return loaded ~= nil and required ~= nil and tonumber(loaded) >= tonumber(required)
                end
                local wasComplete = complete()
                local changed = object:GetPropertyChangedSignal("Text"):Connect(function()
                    local full = complete()
                    if full ~= wasComplete then
                        if tween then
                            tween:Cancel()
                        end
                        scale.Scale = 1
                        if full then
                            local pop = TweenService:Create(
                                scale,
                                TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
                                { Scale = 1.1 }
                            )
                            tween = pop
                            pop:Play()
                        end
                    end
                    wasComplete = full
                end)
                cleanups[object] = function()
                    changed:Disconnect()
                    if tween then
                        tween:Cancel()
                    end
                    scale:Destroy()
                end
            end
        end
        -- Canvas size, font, opacity, world origin and state text stay authored.
    end
    -- Late replication and streaming use the same idempotent configuration.
    workspace.DescendantAdded:Connect(register)
    workspace.DescendantRemoving:Connect(function(object)
        local cleanup = cleanups[object]
        if cleanup then
            cleanups[object] = nil
            cleanup()
        end
    end)
    for _, object in workspace:GetDescendants() do
        register(object)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="812">
            <Properties>
              <string name="Name">CarryInputController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local MobileControlLayout = require(script.Parent.Parent.UI.MobileControlLayout)
local Controller = {}
local started = false

-- Read the live CAS binding; observing input never invokes the throw handler.
function Controller.GetThrowButtonLabel(): string
    local info = ContextActionService:GetBoundActionInfo("ThrowHeld")
    for _, key in (info.inputTypes or {}) do
        if key.EnumType == Enum.KeyCode and string.sub(key.Name, 1, 6) == "Button" then
            local label = UserInputService:GetStringForKeyCode(key)
            return if label ~= "" then label else key.Name
        end
    end
    return "Throw"
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local remote = ReplicatedStorage.Shared.Events:WaitForChild("GameplayRequest") :: RemoteEvent
    local attempt = 0
    local logWindow, logCount = 0, 0
    local function trace(message: string)
        if player:GetAttribute("ThrowDebug") ~= true then
            return
        end
        local now = os.clock()
        if now - logWindow >= 5 then
            logWindow, logCount = now, 0
        end
        if logCount >= 40 then
            return
        end
        logCount += 1
        print("[ThrowInput] player=" .. player.Name .. " attempt=" .. tostring(attempt) .. " " .. message)
    end
    local function observe(source: string)
        attempt += 1
        if player:GetAttribute("ThrowDebug") ~= true then
            return
        end
        local names = {}
        for _, child in (if player.Character then player.Character:GetChildren() else {}) do
            if child:IsA("Tool") then
                local kind = if child:GetAttribute("IceGunWeapon") == true
                    then "IceGun"
                    elseif typeof(child:GetAttribute("BatLevel")) == "number" then "Bat"
                    elseif child:GetAttribute("IngredientId") ~= nil then "ingredient"
                    else "other"
                table.insert(names, child.Name .. ":" .. kind)
            end
        end
        local ok, preferred = pcall(function()
            return UserInputService.PreferredInput
        end)
        trace(
            string.format(
                "input=%s mouse=%s touch=%s keyboard=%s preferred=%s tools=[%s]",
                source,
                tostring(UserInputService.MouseEnabled),
                tostring(UserInputService.TouchEnabled),
                tostring(UserInputService.KeyboardEnabled),
                if ok then tostring(preferred) else "unavailable",
                table.concat(names, ",")
            )
        )
    end
    local function throw(_action: string, state: Enum.UserInputState): Enum.ContextActionResult
        trace("handler invoked state=" .. tostring(state))
        local character = player.Character
        if character then
            for _, child in character:GetChildren() do
                if
                    child:IsA("Tool")
                    and (
                        typeof(child:GetAttribute("BatLevel")) == "number"
                        or child:GetAttribute("IceGunWeapon") == true
                    )
                then
                    -- Leave primary input available to Tool.Activated, including on touch.
                    trace("owner=weapon ignored: weapon equipped " .. child.Name)
                    return Enum.ContextActionResult.Pass
                end
            end
        end
        trace("owner=carry")
        if GuiService.MenuIsOpen or player.GameplayPaused then
            trace("ignored: menu open or gameplay paused")
            return Enum.ContextActionResult.Pass
        end
        if player:GetAttribute("Stunned") == true then
            trace("ignored: stunned")
            return Enum.ContextActionResult.Sink
        end
        if (player:GetAttribute("CarryCount") or 0) <= 0 or UserInputService:GetFocusedTextBox() then
            trace("ignored: empty carry or focused textbox")
            return Enum.ContextActionResult.Pass
        end
        if state == Enum.UserInputState.Begin then
            trace("request sent: ThrowHeld equipped item, newest ingredient fallback")
            remote:FireServer("ThrowHeld", nil, nil, if player:GetAttribute("ThrowDebug") == true then attempt else nil)
        end
        return Enum.ContextActionResult.Sink
    end
    -- The existing CAS Throw button and console trigger share this intentional path.
    -- Do not bind touch-world/primary mouse input to the mobile button's action.
    ContextActionService:BindAction(
        "ThrowHeld",
        function(action: string, state: Enum.UserInputState, input: InputObject?)
            observe(action .. ":" .. (if input then tostring(input.UserInputType) else "button"))
            return throw(action, state)
        end,
        true,
        Enum.KeyCode.ButtonR2
    )
    -- UIS exposes processed input; CAS callbacks do not have a GUI-consumed flag.
    -- TouchEnabled describes hardware capability, not the input being received.
    UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
        if input.UserInputType == Enum.UserInputType.Touch then
            observe("Touch processed=" .. tostring(processed))
            trace("ignored: world touch/UI gesture; use Throw button")
            return
        elseif input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        observe("MouseButton1")
        trace("mouse received processed=" .. tostring(processed))
        if not UserInputService.MouseEnabled then
            trace("ignored: no mouse device (touch synthesized input)")
            return
        end
        if processed then
            trace("ignored: GUI or another action processed input")
            return
        end
        throw("ThrowHeldMouse", Enum.UserInputState.Begin)
    end)
    ContextActionService:SetTitle("ThrowHeld", "Throw")
    MobileControlLayout.Register("ThrowHeld")
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="813">
            <Properties>
              <string name="Name">CashRewardController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local State = require(script.Parent.Parent.UI.CashRewardState)
local Animation = require(script.Parent.Parent.UI.CashRewardAnimation)
local Debug = require(script.Parent.Parent.UI.CashRewardDebug)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    local accept = State.New()
    local player = Players.LocalPlayer
    player.CharacterRemoving:Connect(Animation.Clear)
    task.spawn(function()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local remote = events:WaitForChild("GameplayPresentation") :: RemoteEvent
        remote.OnClientEvent:Connect(function(moment: any, owner: any, payload: any)
            local accepted, reason = accept(moment, owner, payload, player.UserId)
            Debug.Log(player, string.format("received %s owner=%s: %s", tostring(moment), tostring(owner), reason))
            if accepted then
                Animation.Play(player)
            end
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="814">
            <Properties>
              <string name="Name">CharacterStatusOutlineController</string>
              <string name="Source"><![CDATA[--!strict
-- Sole owner of combat character Highlights. Stunned on Player is an aggregate
-- input lock, so outlines read character-specific server status attributes instead.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IceShotgunPresentationConfig)
local Controller = {}
local NAME = "CharacterStatusOutline"
type Track = {
    Player: Player,
    Character: Model?,
    Dead: boolean,
    Highlight: Highlight?,
    CharacterConnections: { RBXScriptConnection },
    PlayerConnections: { RBXScriptConnection },
}
local tracks: { [Player]: Track } = {}
local connections: { RBXScriptConnection } = {}
local started = false

local function removeOutline(track: Track)
    if track.Highlight then
        track.Highlight:Destroy()
    end
    track.Highlight = nil
end

local function clearCharacter(track: Track)
    removeOutline(track)
    for _, connection in track.CharacterConnections do
        connection:Disconnect()
    end
    table.clear(track.CharacterConnections)
    track.Character = nil
end

local function immune(value: any, now: number): boolean
    return typeof(value) == "number" and value > now and value < math.huge
end

local function status(character: Model, now: number): (string?, Color3?, boolean)
    -- A freeze stays active until the server clears it, including a delayed thaw.
    local frozen = character:GetAttribute("FrozenUntil")
    if typeof(frozen) == "number" and frozen > 0 then
        return "Freeze", Config.Blue, false
    elseif character:GetAttribute("BatStunned") == true then
        return "BatStun", Config.White, false
    elseif immune(character:GetAttribute("FreezeImmuneUntil"), now) then
        return "FreezeImmunity", Config.Blue, true
    elseif immune(character:GetAttribute("BatImmuneUntil"), now) then
        return "BatImmunity", Config.White, true
    end
    return nil, nil, false
end

local function refresh()
    local camera = workspace.CurrentCamera
    local now = workspace:GetServerTimeNow()
    local candidates: { { Track: Track, Distance: number, Kind: string, Color: Color3, Flash: boolean } } = {}
    for _, track in tracks do
        local character = track.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local h = character and character:FindFirstChildOfClass("Humanoid")
        local kind, color, flash = nil, nil, false
        if character and not track.Dead and h and h.Health > 0 then
            kind, color, flash = status(character, now)
        end
        if kind and color and camera and root and root:IsA("BasePart") and root:IsDescendantOf(workspace) then
            local distance = (camera.CFrame.Position - root.Position).Magnitude
            if distance <= Config.OutlineDistance then
                table.insert(
                    candidates,
                    { Track = track, Distance = distance, Kind = kind, Color = color, Flash = flash }
                )
                continue
            end
        end
        removeOutline(track)
    end
    table.sort(candidates, function(a, b)
        local aLocal, bLocal = a.Track.Player == Players.LocalPlayer, b.Track.Player == Players.LocalPlayer
        if aLocal ~= bLocal then
            return aLocal
        end
        if a.Distance ~= b.Distance then
            return a.Distance < b.Distance
        end
        return a.Track.Player.UserId < b.Track.Player.UserId
    end)
    for index, candidate in candidates do
        local track = candidate.Track
        if index > Config.MaxOutlines then
            removeOutline(track)
            continue
        end
        local highlight = track.Highlight
        if not highlight or highlight.Parent ~= track.Character then
            removeOutline(track)
            local created = Instance.new("Highlight")
            created.Name = NAME
            created.Adornee = track.Character
            created.FillTransparency = 1
            created.DepthMode = Enum.HighlightDepthMode.Occluded
            created.Parent = track.Character
            track.Highlight, highlight = created, created
        end
        if not highlight then
            continue
        end
        highlight:SetAttribute("Status", candidate.Kind)
        highlight.OutlineColor = candidate.Color
        highlight.OutlineTransparency = if candidate.Flash
                and math.floor(now / Config.ImmunityFlashSeconds) % 2 == 1
            then 0.85
            else 0.05
    end
end

local function bindCharacter(track: Track, character: Model)
    clearCharacter(track)
    track.Character, track.Dead = character, false
    -- Reinitialization/hot reload may leave an owned outline; never touch other Highlights.
    for _, child in character:GetChildren() do
        if child:IsA("Highlight") and child.Name == NAME then
            child:Destroy()
        end
    end
    for _, attribute in { "FrozenUntil", "BatStunned", "FreezeImmuneUntil", "BatImmuneUntil" } do
        table.insert(track.CharacterConnections, character:GetAttributeChangedSignal(attribute):Connect(refresh))
    end
    local humanoid: Humanoid? = nil
    local function attachHumanoid()
        local h = character:FindFirstChildOfClass("Humanoid")
        if not h or h == humanoid then
            return
        end
        humanoid = h
        table.insert(
            track.CharacterConnections,
            h.Died:Connect(function()
                track.Dead = true
                removeOutline(track)
            end)
        )
        refresh()
    end
    table.insert(track.CharacterConnections, character.ChildAdded:Connect(attachHumanoid))
    attachHumanoid()
    refresh()
end

local function addPlayer(player: Player)
    if tracks[player] then
        return
    end
    local track: Track = {
        Player = player,
        Character = nil,
        Dead = false,
        Highlight = nil,
        CharacterConnections = {},
        PlayerConnections = {},
    }
    tracks[player] = track
    table.insert(
        track.PlayerConnections,
        player.CharacterAdded:Connect(function(character)
            bindCharacter(track, character)
        end)
    )
    table.insert(
        track.PlayerConnections,
        player.CharacterRemoving:Connect(function(character)
            if track.Character == character then
                clearCharacter(track)
            end
        end)
    )
    if player.Character then
        bindCharacter(track, player.Character)
    end
end

local function removePlayer(player: Player)
    local track = tracks[player]
    if not track then
        return
    end
    tracks[player] = nil
    clearCharacter(track)
    for _, connection in track.PlayerConnections do
        connection:Disconnect()
    end
end

function Controller.Init()
    if started then
        return
    end
    started = true
    table.insert(connections, Players.PlayerAdded:Connect(addPlayer))
    table.insert(connections, Players.PlayerRemoving:Connect(removePlayer))
    for _, player in Players:GetPlayers() do
        addPlayer(player)
    end
    local elapsed = 0
    table.insert(
        connections,
        RunService.Heartbeat:Connect(function(dt)
            elapsed += dt
            if elapsed >= Config.OutlineInterval then
                elapsed = 0
                refresh()
            end
        end)
    )
end

function Controller.Destroy()
    for player in tracks do
        removePlayer(player)
    end
    for _, connection in connections do
        connection:Disconnect()
    end
    table.clear(connections)
    started = false
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="815">
            <Properties>
              <string name="Name">CustomerOrderController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    local tracked: { [BillboardGui]: () -> () } = {}
    local function attach(object: Instance)
        if
            not object:IsA("BillboardGui")
            or (object.Name ~= "OrderBubble" and object.Name ~= "CustomerResult")
            or tracked[object]
        then
            return
        end
        object.Enabled = false
        local customer = object.Parent
        while customer and not customer:IsA("Model") do
            customer = customer.Parent
        end
        if not customer then
            return
        end
        local function refresh()
            object.Enabled = customer:GetAttribute("PlotSessionId") ~= nil
                and customer:GetAttribute("PlotSessionId") == Players.LocalPlayer:GetAttribute("PlotSessionId")
                and (object.Name ~= "OrderBubble" or customer:GetAttribute("OrderRevealed") == true)
        end
        local ownership = customer:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
        local membership = Players.LocalPlayer:GetAttributeChangedSignal("PlotSessionId"):Connect(refresh)
        local sessionChanged = customer:GetAttributeChangedSignal("PlotSessionId"):Connect(refresh)
        local reveal = customer:GetAttributeChangedSignal("OrderRevealed"):Connect(refresh)
        tracked[object] = function()
            ownership:Disconnect()
            sessionChanged:Disconnect()
            membership:Disconnect()
            reveal:Disconnect()
            object.Enabled = false
        end
        refresh()
    end
    workspace.DescendantAdded:Connect(attach)
    workspace.DescendantRemoving:Connect(function(object)
        if object:IsA("BillboardGui") then
            local cleanup = tracked[object]
            if cleanup then
                tracked[object] = nil
                cleanup()
            end
        end
    end)
    for _, object in workspace:GetDescendants() do
        attach(object)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="816">
            <Properties>
              <string name="Name">FarmPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Prompts = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Constants = game:GetService("ReplicatedStorage").Shared.Constants
local Config = require(Constants.FarmConfig)
local Definitions = require(Constants.Ingredients)
local Eligibility = require(Constants.FarmEligibility)
local TextStyle = require(Constants.DialogueTextStyle)
local Style = require(script.Parent.Parent.UI.WorldBillboardStyle)
local Input = require(script.Parent.Parent.UI.InteractionPromptPresentation)
local Controller = {}
local started = false

local function label(gui: BillboardGui, y: number, text: string): TextLabel
    local result = Instance.new("TextLabel")
    result.Name = if y == 0 then "Title" else "Detail"
    Style.ApplyText(result, {})
    TextStyle.Apply(result, 24, gui)
    local canvasHeight = if gui.Name == "FarmPlantDisplay" then 100 else 64
    result.Size = UDim2.fromScale(1, 32 / canvasHeight)
    result.TextScaled = true
    result.Position = UDim2.fromScale(0, y / canvasHeight)
    result.Text = text
    result.Parent = gui
    return result
end

local function billboard(origin: Instance, parent: Instance, height: number): BillboardGui
    local gui = Instance.new("BillboardGui")
    gui.Name = "FarmDisplay"
    gui.Adornee = origin
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    Style.ApplyBillboard(
        gui,
        { WidthStuds = 10.92, HeightStuds = (math.round(height / 37.5 * 10) / 10) * 1.2, MaxDistance = 35 }
    )
    gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
    gui.Parent = parent
    return gui
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    type Row = {
        Object: Instance,
        Origin: Attachment,
        Gui: BillboardGui,
        Title: TextLabel,
        Detail: TextLabel,
        PadGui: BillboardGui?,
        Pad: BasePart?,
        InputGui: BillboardGui?,
        InputTitle: TextLabel?,
        InputName: TextLabel?,
        Cleanup: (() -> ())?,
    }
    local rows: { [ProximityPrompt]: Row } = {}
    local function hide(prompt: ProximityPrompt)
        local row = rows[prompt]
        if row and row.Cleanup then
            row.Cleanup()
            row.Cleanup, row.InputGui, row.InputTitle, row.InputName = nil, nil, nil, nil
        end
    end
    local function bind(object: Instance)
        if not object:IsA("ProximityPrompt") or object.Name ~= "FarmPlantPrompt" or rows[object] then
            return
        end
        local origin = object.Parent
        local row = origin and origin.Parent and origin.Parent.Parent
        if not origin or not origin:IsA("Attachment") or not row then
            return
        end
        local gui = billboard(origin, playerGui, 64)
        gui.Enabled = false
        rows[object] = {
            Object = row,
            Origin = origin,
            Gui = gui,
            Title = label(gui, 0, ""),
            Detail = label(gui, 32, ""),
        }
    end
    local function refresh(prompt: ProximityPrompt, row: Row, now: number)
        local state = row.Object:GetAttribute("FarmState")
        row.Gui.Enabled = state == "GROWING" or state == "READY"
        row.Title.TextColor3 = if state == "READY" then TextStyle.Green else TextStyle.White
        row.Title.Text = if state == "READY"
            then "READY!"
            else "GROWING" .. string.rep(".", math.floor(now / 0.4) % 3 + 1)
        local deadline = row.Object:GetAttribute("FarmGrowEnd")
        local remaining = if typeof(deadline) == "number" then math.max(0, math.ceil(deadline - now)) else 0
        row.Detail.Text = if state == "GROWING"
            then string.format("%d:%02d", math.floor(remaining / 60), remaining % 60)
            else ""
        if state ~= "EMPTY" or not prompt.Enabled or not Prompts.Enabled then
            hide(prompt)
        end
        if row.InputTitle and row.InputName then
            -- InventoryService publishes its selected/fallback action target, including
            -- equipped smoothies. This is display metadata, never an activation payload.
            local id = player:GetAttribute("HeldIngredientId")
            local definition = if typeof(id) == "string" then Definitions[id] else nil
            local valid = Eligibility.CanPlant(definition)
            row.InputTitle.Text = if valid
                then "PLANT"
                elseif definition then "Cannot Plant This Item"
                else "HOLD AN INGREDIENT"
            row.InputTitle.TextTransparency = if valid then 0 else 0.35
            row.InputName.Text = if valid and definition then definition.DisplayName or definition.Id else ""
            row.InputName.TextColor3 = if definition then definition.BlendColor else TextStyle.White
            local action = row.InputGui and row.InputGui:FindFirstChild("Action")
            if action and action:IsA("TextButton") then
                action.TextTransparency = if valid then 0 else 1
                local outline = action:FindFirstChild("DialogueOutline")
                if outline and outline:IsA("UIStroke") then
                    outline.Transparency = if valid then 0 else 1
                end
            end
        end
        if row.PadGui and row.Pad and not row.Pad:IsDescendantOf(workspace) then
            row.PadGui:Destroy()
            row.PadGui, row.Pad = nil, nil
        end
        if not row.PadGui then
            local index = tonumber(string.match(row.Object.Name, "^Row(%d+)$"))
            local pad = index and row.Object:FindFirstChild("PurchasePoint" .. index)
            local price = index and Config.RowPrices[index]
            if pad and pad:IsA("BasePart") and price then
                row.Pad = pad
                local padGui = billboard(pad, playerGui, 64)
                padGui.MaxDistance = 35
                row.PadGui = padGui
                label(padGui, 0, "FARM ROW")
                local amount = tostring(price):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
                label(padGui, 32, "$" .. amount).TextColor3 = TextStyle.Gold
            end
        end
        if row.PadGui and row.Pad then
            row.PadGui.Enabled = row.Pad:IsDescendantOf(workspace) and row.Pad.CanTouch and row.Pad.Transparency < 1
        end
    end
    workspace.DescendantAdded:Connect(bind)
    for _, object in workspace:GetDescendants() do
        bind(object)
    end
    Prompts.PromptShown:Connect(function(object, inputType)
        if not object:IsA("ProximityPrompt") then
            return
        end
        bind(object)
        local prompt = object :: ProximityPrompt
        local row = rows[prompt]
        if not row or row.Object:GetAttribute("FarmState") ~= "EMPTY" then
            return
        end
        hide(prompt)
        local cleanup, gui = Input.Create(prompt, row.Origin, playerGui, inputType, {
            InputOnly = true,
            WidthStuds = 10.92,
            HeightStuds = 3.24,
            MaxDistance = 35,
            TextSize = 24,
        })
        gui.Name = "FarmPlantDisplay"
        gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
        local action = gui:FindFirstChild("Action") :: TextButton
        TextStyle.Apply(action, 24, gui)
        action.TextScaled = true
        -- Full-canvas hit target; fixed padding places its key below the two labels.
        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0.64, 0)
        padding.Parent = action
        row.Cleanup, row.InputGui = cleanup, gui
        row.InputTitle, row.InputName = label(gui, 0, ""), label(gui, 32, "")
        refresh(prompt, row, workspace:GetServerTimeNow())
    end)
    Prompts.PromptHidden:Connect(hide)

    -- Animate the existing model's pivot locally. No proxy models, pickup replacements,
    -- or server physics movement. Old streamed harvests do not replay their pop.
    type Pop = { Target: CFrame, Start: number }
    local pops: { [Instance]: Pop } = {}
    local function harvest(object: Instance)
        local time = object:GetAttribute("FarmSpawnTime")
        if
            object:GetAttribute("SpawnSource") ~= "Farm"
            or typeof(time) ~= "number"
            or workspace:GetServerTimeNow() - time > Config.HarvestPopSeconds
            or not (object:IsA("BasePart") or object:IsA("Model"))
        then
            return
        end
        pops[object] = { Target = object:GetPivot(), Start = time }
    end
    CollectionService:GetInstanceAddedSignal("IngredientWorldItem"):Connect(harvest)
    for _, object in CollectionService:GetTagged("IngredientWorldItem") do
        harvest(object)
    end
    local elapsed = 0
    RunService.RenderStepped:Connect(function(dt)
        local now = workspace:GetServerTimeNow()
        for object, pop in pops do
            if not object:IsDescendantOf(workspace) or object:GetAttribute("FrozenUntilPickup") ~= true then
                pops[object] = nil
            elseif object:IsA("Model") or object:IsA("BasePart") then
                local alpha = math.clamp((now - pop.Start) / math.max(0.001, Config.HarvestPopSeconds), 0, 1)
                local eased = TweenService:GetValue(alpha, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                object:PivotTo(pop.Target + Vector3.new(0, -Config.HarvestPopDepth * (1 - eased), 0))
                if alpha >= 1 then
                    object:PivotTo(pop.Target)
                    pops[object] = nil
                end
            end
        end
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        for prompt, row in rows do
            if not prompt:IsDescendantOf(workspace) then
                hide(prompt)
                row.Gui:Destroy()
                if row.PadGui then
                    row.PadGui:Destroy()
                end
                rows[prompt] = nil
            else
                refresh(prompt, row, now)
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="817">
            <Properties>
              <string name="Name">FilmCamController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.FilmCam)
local Path = require(Shared.FilmCamPath)
local Controller = {}
local cleanup: (() -> ())? = nil
local playTake: ((Path.Take, number?) -> boolean)? = nil
local stopTake: (() -> ())? = nil

-- Public presentation API remains inert until authorized Init and F6 entry.
function Controller.Play(take: Path.Take, speed: number?): boolean
    return if playTake then playTake(take, speed) else false
end

function Controller.Stop()
    if stopTake then
        stopTake()
    end
end

function Controller.Destroy()
    if cleanup then
        cleanup()
        cleanup = nil
    end
end

function Controller.Init()
    -- Hard boundary: no UI, listeners, camera access, input binding, or controller
    -- loading beyond this point for an ordinary live player.
    local player = Players.LocalPlayer
    if cleanup or not Path.Allowed(RunService:IsStudio(), player.UserId, Config.AllowedUserIds) then
        return
    end
    local Takes = require(script.Parent.Parent.UI.FilmCamTakes)
    local Panel = require(script.Parent.Parent.UI.FilmCamPanel)
    local Turbine = require(script.Parent.TurbineCameraController)
    local Stand = require(script.Parent.StandIdentityController)
    local gui = player:WaitForChild("PlayerGui") :: PlayerGui
    local ui = Panel.Create(gui)
    local connections: { RBXScriptConnection } = {}
    local takes: { Path.Take } = {}
    local selected = 0
    local active, recording, playing, easing = false, false, false, true
    local hidden, boxed, dragging = false, false, false
    local camera: Camera? = nil
    local original: any = nil
    local beforePlayback: any = nil
    local turbineSuspended, standSuspended = false, false
    local hiddenGuis: { [LayerCollector]: boolean } = {}
    local hiddenConnections: { [LayerCollector]: RBXScriptConnection } = {}
    local keys: { Path.Key } = {}
    local lastSample: Path.Key? = nil
    local recordTime, sampleTime, playTime, speed = 0, 0, 0, 1
    local track: Path.Track? = nil
    local yaw, pitch = 0, 0
    local mouseBehavior = Input.MouseBehavior
    local mouseIcon = Input.MouseIconEnabled
    local serial = 0

    local function syncPanelToggle()
        local inBar = boxed and not ui.Frame.Visible
        ui.HidePanel.Text = if ui.Frame.Visible then "Hide" else "Show"
        ui.HidePanel.AnchorPoint = if inBar then Vector2.new(0.5, 0.5) else Vector2.new(1, 0)
        ui.HidePanel.Position = if inBar then UDim2.fromScale(0.5, 0.06) else UDim2.new(1, -12, 0, 12)
    end
    local function togglePanel()
        ui.Frame.Visible = not ui.Frame.Visible
        syncPanelToggle()
    end

    local function connect(signal: RBXScriptSignal, fn: any)
        table.insert(connections, signal:Connect(fn))
    end
    local function snapshot(cam: Camera): any
        return {
            Type = cam.CameraType,
            Subject = cam.CameraSubject,
            Frame = cam.CFrame,
            Focus = cam.Focus,
            Fov = cam.FieldOfView,
        }
    end
    local function restore(cam: Camera, state: any)
        cam.CameraSubject = state.Subject
        cam.CFrame, cam.Focus, cam.FieldOfView = state.Frame, state.Focus, state.Fov
        cam.CameraType = state.Type
    end
    local function syncAngles()
        if camera then
            pitch, yaw = camera.CFrame:ToOrientation()
        end
    end
    local function releaseMouse()
        if not dragging then
            return
        end
        dragging = false
        Input.MouseBehavior, Input.MouseIconEnabled = mouseBehavior, mouseIcon
    end
    local function hideGui(child: Instance)
        if not child:IsA("LayerCollector") or child == ui.Gui or child:GetAttribute(Config.DevUIAttribute) then
            return
        end
        if hiddenGuis[child] ~= nil then
            return
        end
        hiddenGuis[child] = child.Enabled
        child.Enabled = false
        hiddenConnections[child] = child:GetPropertyChangedSignal("Enabled"):Connect(function()
            if hidden and child.Enabled then
                child.Enabled = false
            end
        end)
    end
    local function setHidden(value: boolean)
        hidden = value
        if value then
            for _, child in gui:GetDescendants() do
                hideGui(child)
            end
        else
            for child, enabled in hiddenGuis do
                hiddenConnections[child]:Disconnect()
                if child.Parent then
                    child.Enabled = enabled
                end
            end
            table.clear(hiddenGuis)
            table.clear(hiddenConnections)
        end
        ui.Hide.Text = if value then "Hide UI: on" else "Hide UI: off"
    end
    local function choose(index: number)
        selected = index
        local take = takes[index]
        ui.Select.Text = if take
            then string.format("%d/%d %s (%.1fs)", index, #takes, take.Name, take.Duration)
            else "No takes"
    end
    local function save(take: Path.Take)
        table.insert(takes, take)
        choose(#takes)
    end
    for _, json in require(Shared.Constants.FilmTakes) do
        local take, message = Takes.Decode(json)
        if take then
            save(take)
        else
            warn("[FilmCam] Skipped checked-in take: " .. message)
        end
    end
    local function stopPlayback()
        if not playing then
            return
        end
        playing = false
        if camera and beforePlayback then
            restore(camera, beforePlayback)
        end
        beforePlayback = nil
        syncAngles()
    end
    local function stopRecording()
        if not recording then
            return
        end
        recording = false
        local cam = camera
        if not cam then
            return
        end
        local duration = math.min(recordTime, Config.MaxDuration)
        if duration <= 0 then
            return
        end
        -- Endpoint is mandatory even for a held camera: preserve pauses and duration.
        local endpoint = Takes.Capture(duration, cam.CFrame, cam.FieldOfView)
        if keys[#keys].Time == duration then
            keys[#keys] = endpoint
        else
            table.insert(keys, endpoint)
        end
        serial += 1
        local name = string.sub(ui.Name.Text, 1, 100)
        save({ Version = 1, Name = if name == "" then "Take_" .. serial else name, Duration = duration, Keys = keys })
        ui.Status.Text = if duration >= Config.MaxDuration then "5 minute cap reached; take saved" else "Take saved"
    end
    local function stop()
        stopRecording()
        stopPlayback()
    end
    local function exit()
        if not active then
            return
        end
        stop()
        active = false
        releaseMouse()
        CAS:UnbindAction("FilmCamFly")
        RunService:UnbindFromRenderStep("FilmCamRender")
        setHidden(false)
        boxed = false
        for _, bar in ui.Bars do
            bar.Visible = false
        end
        ui.Letterbox.Text = "Letterbox: off"
        syncPanelToggle()
        if camera and original then
            restore(camera, original)
        end
        camera, original = nil, nil
        Turbine.SetSuspended(turbineSuspended)
        Stand.SetSuspended(standSuspended)
        ui.Gui.Enabled = false
    end
    local function drawPlayback()
        local cam, compiled = camera, track
        if not cam or not compiled then
            return
        end
        local time = Path.EasedTime(playTime, compiled.Duration / speed, easing) * speed
        local x, y, z, qx, qy, qz, qw, fov = Path.Evaluate(compiled, time)
        cam.CFrame = CFrame.new(x, y, z, qx, qy, qz, qw)
        cam.Focus = cam.CFrame * CFrame.new(0, 0, -20)
        cam.FieldOfView = fov
        ui.Fill.Size = UDim2.fromScale(math.clamp(playTime * speed / compiled.Duration, 0, 1), 1)
    end
    local function render(dt: number)
        local cam = camera
        if not cam then
            return
        end
        if workspace.CurrentCamera ~= cam then
            exit()
            return
        end
        cam.CameraType = Enum.CameraType.Scriptable
        if playing and track then
            playTime = math.min(playTime + dt, track.Duration / speed)
            drawPlayback()
            if playTime >= track.Duration / speed then
                stopPlayback()
            end
            return
        end
        if not Input:GetFocusedTextBox() then
            local x, y, z = 0, 0, 0
            if Input:IsKeyDown(Enum.KeyCode.A) then
                x -= 1
            end
            if Input:IsKeyDown(Enum.KeyCode.D) then
                x += 1
            end
            if Input:IsKeyDown(Enum.KeyCode.Q) then
                y -= 1
            end
            if Input:IsKeyDown(Enum.KeyCode.E) then
                y += 1
            end
            if Input:IsKeyDown(Enum.KeyCode.W) then
                z -= 1
            end
            if Input:IsKeyDown(Enum.KeyCode.S) then
                z += 1
            end
            local motion = Vector3.new(x, y, z)
            if motion.Magnitude > 0 then
                motion = motion.Unit * Config.FlySpeed * dt
            end
            cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.fromOrientation(pitch, yaw, 0) * CFrame.new(motion)
            cam.Focus = cam.CFrame * CFrame.new(0, 0, -20)
        end
        if recording then
            recordTime = math.min(recordTime + dt, Config.MaxDuration)
            sampleTime += dt
            if sampleTime >= Config.SampleInterval then
                sampleTime %= Config.SampleInterval
                local key = Takes.Capture(recordTime, cam.CFrame, cam.FieldOfView)
                if Path.ShouldSample(keys[#keys], key, Config.PositionThreshold, Config.RotationThreshold) then
                    -- Keep just the end of a stationary hold before movement resumes.
                    -- Skipped samples still do not accumulate a key every 0.1 seconds.
                    if
                        lastSample
                        and lastSample.Time > keys[#keys].Time
                        and not Path.ShouldSample(keys[#keys], lastSample, 0.000001, 0.000001)
                    then
                        table.insert(keys, lastSample)
                    end
                    table.insert(keys, key)
                end
                lastSample = key
            end
            ui.Status.Text = string.format("Recording %.1fs / 300s | %d keys", recordTime, #keys)
            if recordTime >= Config.MaxDuration then
                stopRecording()
            end
        end
    end
    local function enter()
        local cam = workspace.CurrentCamera
        if not cam then
            return
        end
        if cam:GetAttribute("StandNameEditorActive") then
            warn("[FilmCam] Finish or close the stand-name editor before filming")
            return
        end
        camera, original = cam, snapshot(cam)
        turbineSuspended = Turbine.SetSuspended(true)
        standSuspended = Stand.SetSuspended(true)
        active = true
        cam.CameraType = Enum.CameraType.Scriptable
        syncAngles()
        ui.Frame.Visible = true
        syncPanelToggle()
        ui.Gui.Enabled = true
        CAS:BindActionAtPriority(
            "FilmCamFly",
            function()
                return if playing or Input:GetFocusedTextBox()
                    then Enum.ContextActionResult.Pass
                    else Enum.ContextActionResult.Sink
            end,
            false,
            Enum.ContextActionPriority.High.Value + 100,
            Enum.KeyCode.W,
            Enum.KeyCode.A,
            Enum.KeyCode.S,
            Enum.KeyCode.D,
            Enum.KeyCode.Q,
            Enum.KeyCode.E
        )
        RunService:BindToRenderStep("FilmCamRender", Enum.RenderPriority.Camera.Value + 10, render)
    end
    playTake = function(take: Path.Take, requestedSpeed: number?): boolean
        if not active or not camera or not Path.Validate(take) then
            return false
        end
        stop()
        local requested = requestedSpeed or 1
        if requested ~= requested then
            requested = 1
        end
        speed = math.clamp(requested, 0.25, 2)
        ui.Speed.Text = tostring(speed)
        track = Path.Compile(take)
        beforePlayback = snapshot(camera)
        playTime, playing = 0, true
        releaseMouse()
        drawPlayback()
        ui.Status.Text = "Playing | perform live | Stop to restore framing"
        return true
    end
    stopTake = stop
    local function play()
        -- Stop may finish a recording and select the new take.
        stop()
        local take = takes[selected]
        if take then
            Controller.Play(take, tonumber(ui.Speed.Text) or 1)
        end
    end
    connect(ui.Record.Activated, function()
        if not active or not camera then
            return
        end
        stop()
        keys = { Takes.Capture(0, camera.CFrame, camera.FieldOfView) }
        lastSample = nil
        recordTime, sampleTime, recording = 0, 0, true
    end)
    connect(ui.Stop.Activated, stop)
    connect(ui.Play.Activated, play)
    connect(ui.Select.Activated, function()
        if #takes > 0 then
            choose(selected % #takes + 1)
        end
    end)
    connect(ui.Ease.Activated, function()
        easing = not easing
        ui.Ease.Text = if easing then "Ease: on" else "Ease: off"
    end)
    connect(ui.Copy.Activated, function()
        local take = takes[selected]
        if take then
            ui.Export.Text = Takes.Encode(take)
            ui.Export:CaptureFocus()
            ui.Export.SelectionStart = 1
            ui.Export.CursorPosition = #ui.Export.Text + 1
        end
    end)
    local function preset(kind: string)
        if not active or not camera then
            return
        end
        stop()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = if player.Character then { player.Character } else {}
        local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 1000, params)
        save(Takes.Preset(kind, camera.CFrame, camera.FieldOfView, if hit then hit.Position else nil))
        play()
    end
    connect(ui.Push.Activated, function()
        preset("Push-in")
    end)
    connect(ui.Pull.Activated, function()
        preset("Pull-out")
    end)
    connect(ui.Orbit.Activated, function()
        preset("Orbit")
    end)
    connect(ui.Letterbox.Activated, function()
        boxed = not boxed
        for _, bar in ui.Bars do
            bar.Visible = boxed
        end
        ui.Letterbox.Text = if boxed then "Letterbox: on" else "Letterbox: off"
        syncPanelToggle()
    end)
    connect(ui.Hide.Activated, function()
        setHidden(not hidden)
    end)
    connect(ui.HidePanel.MouseButton1Click, togglePanel)
    connect(ui.Scrub.InputBegan, function(input: InputObject)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 or not active then
            return
        end
        if not playing then
            play()
        end
        if track and playing then
            playTime = math.clamp((input.Position.X - ui.Scrub.AbsolutePosition.X) / ui.Scrub.AbsoluteSize.X, 0, 1)
                * track.Duration
                / speed
            drawPlayback()
        end
    end)
    connect(gui.DescendantAdded, function(child: Instance)
        if hidden then
            hideGui(child)
        end
    end)
    connect(Input.InputBegan, function(input: InputObject, processed: boolean)
        if input.KeyCode == Config.ToggleKey and not processed and not Input:GetFocusedTextBox() then
            if active then
                exit()
            else
                enter()
            end
        elseif active and input.KeyCode == Config.PanelKey and not processed then
            togglePanel()
        elseif
            active
            and not playing
            and not processed
            and not Input:GetFocusedTextBox()
            and input.UserInputType == Enum.UserInputType.MouseButton2
        then
            mouseBehavior, mouseIcon = Input.MouseBehavior, Input.MouseIconEnabled
            dragging = true
            Input.MouseBehavior, Input.MouseIconEnabled = Enum.MouseBehavior.LockCurrentPosition, false
        end
    end)
    connect(Input.InputChanged, function(input: InputObject)
        if active and not playing and dragging and camera and input.UserInputType == Enum.UserInputType.MouseWheel then
            camera.FieldOfView = math.clamp(camera.FieldOfView - input.Position.Z * 2, 1, 120)
        end
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            yaw -= input.Delta.X * Config.MouseSensitivity
            pitch = math.clamp(pitch - input.Delta.Y * Config.MouseSensitivity, -math.pi / 2 + 0.01, math.pi / 2 - 0.01)
        end
    end)
    connect(Input.InputEnded, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            releaseMouse()
        end
    end)
    connect(Input.WindowFocusReleased, releaseMouse)
    connect(workspace:GetPropertyChangedSignal("CurrentCamera"), exit)
    connect(script.Destroying, Controller.Destroy)
    connect(ui.Gui.Destroying, exit)
    cleanup = function()
        exit()
        for _, connection in connections do
            connection:Disconnect()
        end
        ui.Gui:Destroy()
        playTake, stopTake = nil, nil
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="818">
            <Properties>
              <string name="Name">GameplayAudioController</string>
              <string name="Source"><![CDATA[--!strict
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Constants.GameplayAudio)
local MuncherConfig = require(ReplicatedStorage.Shared.Constants.Muncher)
local Controller = {}
local started = false
local lastCashCue = { Pop = -math.huge, Collect = -math.huge }
local templates: { [string]: Sound } = {}
local eventAssets: { [string]: string } = {
    IngredientPickup = Config.IngredientPickupSoundId,
    IngredientPlant = Config.IngredientPlantSoundId,
    IngredientThrow = Config.IngredientThrowSoundId,
    BatSwing = Config.BatSwingSoundId,
    CustomerHurt = Config.CustomerHurtSoundId,
}

local muncherAssets: { [string]: string } = {
    Insert = MuncherConfig.InsertSoundId,
    Roll = MuncherConfig.RollSoundId,
    ReelStop = MuncherConfig.ReelStopSoundId,
    Win = MuncherConfig.WinSoundId,
    Lose = MuncherConfig.LoseSoundId,
}

-- Reuse the authored pickup/throw assets for brief local UI cues.
function Controller.PlayCashFeedback(kind: "Pop" | "Collect")
    local now = os.clock()
    if now - lastCashCue[kind] < 0.18 then
        return
    end
    lastCashCue[kind] = now
    local id = if kind == "Pop" then Config.IngredientPickupSoundId else Config.IngredientThrowSoundId
    local template = templates[id]
    if not template then
        return
    end
    local sound = template:Clone()
    sound.Name = "CashFeedback"
    sound.Volume = 0.22
    sound.Parent = game:GetService("SoundService")
    sound:Play()
    Debris:AddItem(sound, 0.4)
end

local function play(template: Sound, position: Vector3)
    local camera = workspace.CurrentCamera
    if camera and (camera.CFrame.Position - position).Magnitude > Config.SoundRollOffMaxDistance then
        return
    end
    local emitter = Instance.new("Part")
    emitter.Name = "GameplaySfx"
    emitter.Size = Vector3.new(0.1, 0.1, 0.1)
    emitter.Anchored, emitter.Transparency = true, 1
    emitter.CanCollide, emitter.CanTouch, emitter.CanQuery = false, false, false
    emitter.Position = position
    local sound = template:Clone()
    sound.Parent = emitter
    emitter.Parent = workspace
    sound.Ended:Once(function()
        emitter:Destroy()
    end)
    Debris:AddItem(emitter, 15)
    sound:Play()
end

-- Local spatial audio. Cleanup owns loop cancellation, including interrupted rolls.
function Controller.PlayMuncher(kind: "Insert" | "Roll" | "ReelStop" | "Win" | "Lose", parent: BasePart): () -> ()
    local id = muncherAssets[kind]
    local template = if id ~= "" then templates[id] else nil
    if not template then
        return function() end
    end
    if kind ~= "Roll" then
        play(template, parent.Position)
        return function() end
    end
    local sound = template:Clone()
    sound.Name = "Muncher" .. kind
    sound.Looped = true
    sound.Parent = parent
    sound:Play()
    return function()
        sound:Destroy()
    end
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local preload: { Instance } = {}
    for _, id in eventAssets do
        if not templates[id] then
            local sound = Instance.new("Sound")
            sound.SoundId = id
            sound.Volume = Config.SoundVolume
            sound.RollOffMinDistance = Config.SoundRollOffMinDistance
            sound.RollOffMaxDistance = Config.SoundRollOffMaxDistance
            templates[id] = sound
            table.insert(preload, sound)
        end
    end
    for _, id in muncherAssets do
        if id ~= "" and not templates[id] then
            local sound = Instance.new("Sound")
            sound.SoundId = id
            sound.Volume = Config.SoundVolume
            sound.RollOffMinDistance = Config.SoundRollOffMinDistance
            sound.RollOffMaxDistance = Config.SoundRollOffMaxDistance
            templates[id] = sound
            table.insert(preload, sound)
        end
    end
    local ready = false
    local pending: { { Template: Sound, Position: Vector3 } } = {}
    task.spawn(function()
        local remote = ReplicatedStorage.Shared.Events:WaitForChild("GameplaySfx") :: RemoteEvent
        remote.OnClientEvent:Connect(function(event: any, position: any)
            local id = if type(event) == "string" then eventAssets[event] else nil
            if not id or typeof(position) ~= "Vector3" then
                return
            end
            local template = templates[id]
            if ready then
                play(template, position)
            elseif #pending < 32 then
                -- Preserve early authorized events while the two assets load.
                table.insert(pending, { Template = template, Position = position })
            end
        end)
    end)
    task.spawn(function()
        local ok, message = pcall(function()
            ContentProvider:PreloadAsync(preload)
        end)
        if not ok then
            warn("[GameplayAudio] Preload failed: " .. tostring(message))
        end
        ready = true
        for _, event in pending do
            play(event.Template, event.Position)
        end
        table.clear(pending)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="819">
            <Properties>
              <string name="Name">GameplayPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameplayPresentationController = {}
local started = false

function GameplayPresentationController.Init()
    if started then
        return
    end
    started = true
    -- Waiting for server-created objects must not block other client controllers.
    task.spawn(function()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local remote = events:WaitForChild("GameplayPresentation")
        assert(remote:IsA("RemoteEvent"), "GameplayPresentation must be a RemoteEvent")
        remote.OnClientEvent:Connect(function(_moment: any, _ownerUserId: any, _payload: any)
            -- Drain all presentation messages, including future/unsupported kinds.
            -- Current visuals use replicated attributes and server-created UI/audio.
            -- Add cosmetic handlers here when implemented; never send gameplay requests
            -- or mutate authoritative state in response to these notifications.
        end)
    end)
end

return GameplayPresentationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="820">
            <Properties>
              <string name="Name">IceGunController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")
local MobileControlLayout = require(script.Parent.Parent.UI.MobileControlLayout)
local FireView = require(script.Parent.Parent.UI.IceShotgunFireView)
local REVISION = "icegun-reequip-2026-10-11"
local Config = require(ReplicatedStorage.Shared.Constants.IceGunConfig)
local Controller = {}
local started = false
local lastDiagnostic: { [string]: number } = {}
local function trace(player: Player, stage: string, tool: Tool?)
    if not Config.DebugLogging or not RunService:IsStudio() then
        return
    end
    local key = tostring(player.UserId) .. ":" .. stage
    local now = os.clock()
    if now < (lastDiagnostic[key] or 0) then
        return
    end
    lastDiagnostic[key] = now + 1
    local detail = if tool
        then string.format(
            " issue=%s parent=%s weapon=%s",
            tostring(tool:GetAttribute("IceGunIssueId")),
            tostring(tool.Parent),
            tostring(tool:GetAttribute("IceGunWeapon"))
        )
        else ""
    warn("[IceGun client] " .. tostring(player.UserId) .. " " .. stage .. detail)
end

local function pointerAim(): boolean
    return UserInputService.PreferredInput == Enum.PreferredInput.KeyboardAndMouse
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local character: Model? = nil
    local pendingUntil = 0
    local tools: { [Tool]: { RBXScriptConnection } } = {}
    local containers: { [Instance]: { RBXScriptConnection } } = {}
    local characterConnections: { RBXScriptConnection } = {}
    local reticle: ScreenGui? = nil
    local crosshair: Frame? = nil
    local cooldownView: FireView.Handle? = nil
    local actionBound = false
    local requestFire: (Tool) -> ()
    local function updateFireButton()
        local button = if actionBound then ContextActionService:GetButton("IceShotgunFire") else nil
        if button then
            button.Visible = UserInputService.PreferredInput == Enum.PreferredInput.Touch
        end
    end
    local savedMouseEnabled: boolean? = nil
    local windowFocused = true
    local function restoreCursor()
        if savedMouseEnabled ~= nil then
            -- Restore only our own override; another controller may have taken ownership.
            if not UserInputService.MouseIconEnabled then
                UserInputService.MouseIconEnabled = savedMouseEnabled
            end
            savedMouseEnabled = nil
        end
    end
    local function gameplayInput(): boolean
        if pointerAim() then
            local gui = player:FindFirstChildOfClass("PlayerGui")
            local mouse = UserInputService:GetMouseLocation()
            if gui then
                for _, object in gui:GetGuiObjectsAtPosition(mouse.X, mouse.Y) do
                    if object:IsA("GuiButton") or object:IsA("TextBox") then
                        return false
                    end
                end
            end
        end
        return windowFocused
            and not GuiService.MenuIsOpen
            and GuiService.SelectedObject == nil
            and UserInputService:GetFocusedTextBox() == nil
            and not player.GameplayPaused
    end
    local function centeredAim(): boolean
        return not pointerAim() or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
    end
    local function aimPoint(camera: Camera): Vector2
        if centeredAim() then
            return Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        end
        -- Mouse coordinates are fullscreen; camera/UI coordinates are device-safe.
        -- Both inset Rects are relative to CoreUISafeInsets, so their difference
        -- removes only device cutouts, never the Roblox top bar.
        local safe = GuiService:GetInsetArea(Enum.ScreenInsets.DeviceSafeInsets)
        local full = GuiService:GetInsetArea(Enum.ScreenInsets.None)
        local mouse = UserInputService:GetMouseLocation()
        return Vector2.new(mouse.X - safe.Min.X + full.Min.X, mouse.Y - safe.Min.Y + full.Min.Y)
    end
    local function positionReticle()
        local camera = workspace.CurrentCamera
        if crosshair and camera then
            if centeredAim() then
                crosshair.Position = UDim2.fromScale(0.5, 0.5)
            else
                local point = aimPoint(camera)
                crosshair.Position = UDim2.fromOffset(point.X, point.Y)
            end
        end
    end
    local function reconcileCursor()
        if reticle and reticle.Enabled and gameplayInput() and pointerAim() then
            if savedMouseEnabled == nil then
                savedMouseEnabled = UserInputService.MouseIconEnabled
            end
            UserInputService.MouseIconEnabled = false
        else
            restoreCursor()
        end
    end
    local function hideReticle()
        if actionBound then
            actionBound = false
            ContextActionService:UnbindAction("IceShotgunFire")
            MobileControlLayout.Unregister("IceShotgunFire")
        end
        if cooldownView then
            FireView.Destroy(cooldownView)
            cooldownView = nil
        end
        restoreCursor()
        crosshair = nil
        if reticle then
            reticle:Destroy()
            reticle = nil
        end
    end
    local function updateReticle()
        local h = character and character:FindFirstChildOfClass("Humanoid")
        local equipped = false
        for tool in tools do
            if character and tool.Parent == character and tool:GetAttribute("IceGunWeapon") == true then
                equipped = true
                break
            end
        end
        local gui = player:FindFirstChildOfClass("PlayerGui")
        if not equipped or not h or h.Health <= 0 or not gui or not gameplayInput() then
            hideReticle()
            return
        end
        if reticle and reticle.Parent == gui then
            positionReticle()
            reconcileCursor()
            updateFireButton()
            return
        end
        hideReticle()
        local screen = Instance.new("ScreenGui")
        screen.Name = "IceGunReticle"
        screen.ResetOnSpawn = false
        screen.DisplayOrder = 10
        screen.IgnoreGuiInset = true
        screen.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
        local cross = Instance.new("Frame")
        cross.Name = "Crosshair"
        cross.AnchorPoint = Vector2.new(0.5, 0.5)
        cross.Size = UDim2.fromOffset(14, 14)
        cross.BackgroundTransparency = 1
        cross.Active = false
        cross.Selectable = false
        cross.Parent = screen
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = cross
        local outline = Instance.new("UIStroke")
        outline.Color = Color3.new(0, 0, 0)
        outline.Thickness = 3
        outline.Parent = cross
        local ring = Instance.new("Frame")
        ring.Name = "Ring"
        ring.Size = UDim2.fromScale(1, 1)
        ring.BackgroundTransparency = 1
        ring.Active = false
        ring.Selectable = false
        ring.Parent = cross
        corner:Clone().Parent = ring
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.new(1, 1, 1)
        stroke.Thickness = 1
        stroke.Parent = ring
        local dot = Instance.new("Frame")
        dot.Name = "CenterDot"
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
        dot.Position = UDim2.fromScale(0.5, 0.5)
        dot.Size = UDim2.fromOffset(3, 3)
        dot.BackgroundColor3 = Color3.new(1, 1, 1)
        dot.BorderSizePixel = 0
        dot.Active = false
        dot.Selectable = false
        dot.Parent = cross
        corner:Clone().Parent = dot
        local dotStroke = Instance.new("UIStroke")
        dotStroke.Color = Color3.new(0, 0, 0)
        dotStroke.Thickness = 1
        dotStroke.Parent = dot
        actionBound = true
        ContextActionService:BindActionAtPriority("IceShotgunFire", function(_, state)
            if state == Enum.UserInputState.Begin then
                for tool in tools do
                    if character and tool.Parent == character and tool:GetAttribute("IceGunWeapon") == true then
                        requestFire(tool)
                        break
                    end
                end
            end
            return Enum.ContextActionResult.Sink
        end, true, 2100, Enum.KeyCode.ButtonR2)
        ContextActionService:SetTitle("IceShotgunFire", "Fire")
        MobileControlLayout.Register("IceShotgunFire")
        reticle, crosshair = screen, cross
        screen:GetPropertyChangedSignal("Enabled"):Connect(reconcileCursor)
        screen.Parent = gui
        updateFireButton()
        positionReticle()
        reconcileCursor()
    end
    local selectedTool: Tool? = nil
    local selectedCharacter: Model? = nil
    local selectedEquipped: boolean? = nil
    local function sendSelection(tool: Tool, force: boolean?)
        if not character or player.Character ~= character or tool:GetAttribute("IceGunWeapon") ~= true then
            return
        end
        local backpack = player:FindFirstChildOfClass("Backpack")
        if tool.Parent ~= character and tool.Parent ~= backpack then
            return
        end
        local equipped = tool.Parent == character
        if not force and selectedTool == tool and selectedCharacter == character and selectedEquipped == equipped then
            return
        end
        local event = ReplicatedStorage:FindFirstChild("IceGunFire")
        if event and event:IsA("RemoteEvent") then
            -- Selection and shots share one ordered, nonyielding server handler.
            selectedTool, selectedCharacter, selectedEquipped = tool, character, equipped
            event:FireServer("Select", tool, equipped, character)
            trace(player, "hotbar selection intent sent", tool)
        end
    end
    requestFire = function(tool: Tool)
        trace(player, "Tool.Activated fired", tool)
        if tool:GetAttribute("IceGunWeapon") ~= true then
            trace(player, "activation rejected: weapon attribute unavailable", tool)
            return
        end
        local current = character
        local camera = workspace.CurrentCamera
        local h = current and current:FindFirstChildOfClass("Humanoid")
        if not current or tool.Parent ~= current or player.Character ~= current then
            trace(player, "activation rejected: Tool not equipped on current character", tool)
            return
        elseif not h or h.Health <= 0 then
            trace(player, "activation rejected: missing/dead Humanoid", tool)
            return
        elseif not camera then
            trace(player, "activation rejected: camera unavailable", tool)
            return
        elseif player:GetAttribute("Stunned") == true then
            trace(player, "activation rejected: stunned/frozen", tool)
            return
        elseif UserInputService:GetFocusedTextBox() then
            trace(player, "activation rejected: text input focused", tool)
            return
        elseif os.clock() < pendingUntil then
            trace(player, "activation deferred: awaiting server response", tool)
            return
        end
        if not gameplayInput() then
            trace(player, "activation rejected: gameplay UI inactive", tool)
            return
        end
        local point = aimPoint(camera)
        local ray = camera:ViewportPointToRay(point.X, point.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { current }
        -- Crosshair intent only: the server blast is radial around the caster
        -- and does not use this aim point for hit detection. It is still sent
        -- so the server can reject malformed payloads, and the reticle and
        -- cooldown behavior below are unchanged.
        local length = Config.BlastRadius + Config.MaximumCameraDistance
        local hit = workspace:Raycast(ray.Origin, ray.Direction * length, params)
        local aim = if hit then hit.Position else ray.Origin + ray.Direction * length
        local event = ReplicatedStorage:FindFirstChild("IceGunFire")
        if event and event:IsA("RemoteEvent") then
            -- Covers activation delivered before Equipped/ChildAdded notifications.
            sendSelection(tool, true)
            pendingUntil = os.clock() + 1.5
            updateFireButton()
            trace(player, "Fire RemoteEvent sent", tool)
            event:FireServer(aim, ray.Origin, ray.Direction, current)
        else
            trace(player, "activation rejected: fire remote unavailable", tool)
        end
    end
    local function unwatch(tool: Tool)
        local list = tools[tool]
        tools[tool] = nil
        if selectedTool == tool then
            selectedTool, selectedCharacter, selectedEquipped = nil, nil, nil
        end
        for _, connection in (list or {}) :: { RBXScriptConnection } do
            connection:Disconnect()
        end
        updateReticle()
    end
    local function watch(child: Instance)
        if not child:IsA("Tool") then
            if child:IsA("Humanoid") then
                table.insert(characterConnections, child.Died:Connect(hideReticle))
                updateReticle()
            end
            return
        end
        trace(
            player,
            if child.Parent == character then "Tool observed in Character" else "Tool observed in Backpack",
            child
        )
        if tools[child] then
            sendSelection(child)
            updateReticle()
            return
        end
        local list: { RBXScriptConnection } = {}
        tools[child] = list
        -- Discovery observes attributes on all Tools to handle late replication,
        -- but only an authorized weapon may own an activation listener.
        local activation: RBXScriptConnection? = nil
        local function reconcileActivation()
            if activation then
                activation:Disconnect()
                local index = table.find(list, activation)
                if index then
                    table.remove(list, index)
                end
                activation = nil
            end
            if child:GetAttribute("IceGunWeapon") == true then
                local connection = child.Activated:Connect(function()
                    -- CAS owns touch/gamepad; native activation owns desktop.
                    if pointerAim() and child:GetAttribute("IceGunWeapon") == true then
                        requestFire(child)
                    end
                end)
                activation = connection
                table.insert(list, connection)
                sendSelection(child)
            end
            updateReticle()
        end
        table.insert(list, child:GetAttributeChangedSignal("IceGunWeapon"):Connect(reconcileActivation))
        table.insert(
            list,
            child.Equipped:Connect(function()
                trace(player, "Tool equipped", child)
                sendSelection(child)
                updateReticle()
            end)
        )
        table.insert(
            list,
            child.Unequipped:Connect(function()
                trace(player, "Tool unequipped", child)
                sendSelection(child)
                updateReticle()
            end)
        )
        table.insert(
            list,
            child.AncestryChanged:Connect(function()
                sendSelection(child)
                updateReticle()
                -- Transfers can pass through nil. Retire only after the current transfer finishes.
                task.defer(function()
                    local backpack = player:FindFirstChildOfClass("Backpack")
                    if
                        tools[child] == list
                        and (not character or child.Parent ~= character)
                        and (not backpack or child.Parent ~= backpack)
                    then
                        unwatch(child)
                    end
                end)
            end)
        )
        table.insert(
            list,
            child.Destroying:Connect(function()
                unwatch(child)
            end)
        )
        reconcileActivation()
    end
    local function unwatchContainer(container: Instance)
        local list = containers[container]
        containers[container] = nil
        for _, connection in (list or {}) :: { RBXScriptConnection } do
            connection:Disconnect()
        end
    end
    local function watchContainer(container: Instance)
        if containers[container] then
            return
        end
        -- Subscribe before scanning so existing grants and concurrent transfers are both discovered.
        containers[container] = { container.ChildAdded:Connect(watch), container.ChildRemoved:Connect(updateReticle) }
        for _, child in container:GetChildren() do
            watch(child)
        end
    end
    local function clearCharacter()
        local old = character
        character = nil
        hideReticle()
        if old then
            unwatchContainer(old)
        end
        for _, connection in characterConnections do
            connection:Disconnect()
        end
        table.clear(characterConnections)
        for tool in tools do
            unwatch(tool)
        end
    end
    local function bind(current: Model)
        clearCharacter()
        character = current
        pendingUntil = 0
        watchContainer(current)
        local backpack = player:FindFirstChildOfClass("Backpack")
        if backpack then
            -- A retained Backpack subscription must still reconcile its current contents after respawn.
            watchContainer(backpack)
            for _, child in backpack:GetChildren() do
                watch(child)
            end
        end
    end
    local resultRemote: RemoteEvent? = nil
    local resultConnection: RBXScriptConnection? = nil
    local function watchResults(object: Instance)
        if object.Name ~= "IceGunFire" or not object:IsA("RemoteEvent") or resultRemote == object then
            return
        end
        if resultConnection then
            resultConnection:Disconnect()
        end
        resultRemote = object
        resultConnection = object.OnClientEvent:Connect(
            function(accepted: boolean, firingCharacter: Model?, deadline: number, reason: string?)
                if firingCharacter ~= character or not character then
                    return
                end
                pendingUntil = 0
                if accepted then
                    if cooldownView then
                        FireView.Hide(cooldownView)
                    end
                elseif reason == "shot cooldown" and crosshair and gameplayInput() then
                    local remaining = math.max(0, deadline - workspace:GetServerTimeNow())
                    if remaining > 0 then
                        if not cooldownView then
                            cooldownView = FireView.Create(crosshair)
                        end
                        local view = cooldownView
                        if view then
                            FireView.Show(view, remaining)
                        end
                    end
                end
            end
        )
    end
    ReplicatedStorage.ChildAdded:Connect(watchResults)
    local remote = ReplicatedStorage:FindFirstChild("IceGunFire")
    if remote then
        watchResults(remote)
    end
    player.ChildAdded:Connect(function(child)
        if child:IsA("Backpack") then
            watchContainer(child)
        elseif child:IsA("PlayerGui") then
            updateReticle()
        end
    end)
    player.ChildRemoved:Connect(function(child)
        if child:IsA("Backpack") then
            unwatchContainer(child)
            for tool in tools do
                if tool.Parent == child then
                    unwatch(tool)
                end
            end
        elseif child:IsA("PlayerGui") then
            hideReticle()
        end
    end)
    player.CharacterAdded:Connect(bind)
    player.CharacterRemoving:Connect(function(old)
        if old == character then
            clearCharacter()
        end
    end)
    UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(updateReticle)
    UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(updateReticle)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            updateReticle()
        end
    end)
    UserInputService.TextBoxFocused:Connect(updateReticle)
    UserInputService.TextBoxFocusReleased:Connect(updateReticle)
    UserInputService.WindowFocusReleased:Connect(function()
        windowFocused = false
        updateReticle()
    end)
    UserInputService.WindowFocused:Connect(function()
        windowFocused = true
        updateReticle()
    end)
    GuiService:GetPropertyChangedSignal("MenuIsOpen"):Connect(updateReticle)
    GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(updateReticle)
    GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(positionReticle)
    player:GetPropertyChangedSignal("GameplayPaused"):Connect(updateReticle)
    local viewportConnection: RBXScriptConnection? = nil
    local function bindCamera()
        if viewportConnection then
            viewportConnection:Disconnect()
            viewportConnection = nil
        end
        local camera = workspace.CurrentCamera
        if camera then
            viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(positionReticle)
        end
        positionReticle()
    end
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
    bindCamera()
    if Config.DebugLogging and RunService:IsStudio() then
        trace(player, "controller initialized revision=" .. REVISION .. " module=" .. script:GetFullName())
    end
    if player.Character then
        bind(player.Character)
    else
        local backpack = player:FindFirstChildOfClass("Backpack")
        if backpack then
            watchContainer(backpack)
        end
    end
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="821">
            <Properties>
              <string name="Name">IceGunDisplayController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local PromptService = game:GetService("ProximityPromptService")
local UserInputService = game:GetService("UserInputService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IceGunConfig)
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local Presentation = require(script.Parent.Parent.UI.InteractionPromptPresentation)
local Adapter = require(script.Parent.IceGunShopAdapter)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    Adapter.Init()
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local displays: { [BasePart]: boolean } = {}
    type View = { Cleanup: () -> (), Text: TextLabel, Key: string, Gui: BillboardGui }
    local views: { [ProximityPrompt]: View } = {}
    local engineVisible = setmetatable({} :: { [ProximityPrompt]: boolean }, { __mode = "k" })
    local shownCounts = setmetatable({} :: { [ProximityPrompt]: number }, { __mode = "k" })
    local function debugging(): boolean
        return RunService:IsStudio() and playerGui:GetAttribute("DebugIceGunPrompt") == true
    end
    local function log(message: string)
        if debugging() then
            print("[IceGunPrompt] " .. message)
        end
    end
    local function diagnose()
        if not debugging() then
            return
        end
        local character = Players.LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local camera = workspace.CurrentCamera
        for _, object in workspace:GetDescendants() do
            if not object:IsA("ProximityPrompt") or object.Name ~= "IceGunPurchase" then
                continue
            end
            local origin = object.Parent
            local view = views[object]
            local distance = if root
                    and root:IsA("BasePart")
                    and origin
                    and origin:IsA("Attachment")
                then (root.Position - origin.WorldPosition).Magnitude
                else math.huge
            local occluded = false
            if camera and origin and origin:IsA("Attachment") then
                local ray = RaycastParams.new()
                ray.FilterType = Enum.RaycastFilterType.Exclude
                ray.FilterDescendantsInstances = if character then { character } else {}
                local hit =
                    workspace:Raycast(camera.CFrame.Position, origin.WorldPosition - camera.CFrame.Position, ray)
                occluded = hit ~= nil and hit.Instance ~= origin.Parent
            end
            local reason = if object:GetAttribute("IceGunPurchase") ~= true
                then "rejected: missing IceGunPurchase attribute"
                elseif not origin or not origin:IsA("Attachment") then "rejected: parent must be Attachment"
                elseif object.Style ~= Enum.ProximityPromptStyle.Custom then "rejected: Style is not Custom"
                elseif
                    view and (not view.Gui.Enabled or not view.Text.Visible or not view.Gui.Parent)
                then "GUI created but hidden"
                elseif view then "GUI created and enabled"
                else "no active view: engine never shown or hidden (range/occlusion/exclusivity/service limits)"
            local otherPrompts = 0
            for other in pairs(engineVisible) do
                if other ~= object then
                    otherPrompts += 1
                end
            end
            log(
                string.format(
                    "%s | %s | shown=%d | distance=%.1f/%s | enabled=%s | ownership=%s | cameraOccluded=%s | RequiresLineOfSight=%s | Exclusivity=%s | service=%s | MaxPromptsVisible=%s | otherVisiblePrompts=%d",
                    object:GetFullName(),
                    reason,
                    shownCounts[object] or 0,
                    distance,
                    tostring(object.MaxActivationDistance),
                    tostring(object.Enabled),
                    tostring(Players.LocalPlayer:GetAttribute("IceGunOwnership") or "MISSING"),
                    tostring(occluded),
                    tostring(object.RequiresLineOfSight),
                    tostring(object.Exclusivity),
                    tostring(PromptService.Enabled),
                    tostring(PromptService.MaxPromptsVisible),
                    otherPrompts
                )
            )
        end
    end
    playerGui:GetAttributeChangedSignal("DebugIceGunPrompt"):Connect(diagnose)
    local lastDiagnostic = 0
    local function add(object: Instance)
        if object:IsA("BasePart") then
            displays[object] = true
        end
    end
    for _, object in CollectionService:GetTagged("IceGunCosmeticDisplay") do
        add(object)
    end
    CollectionService:GetInstanceAddedSignal("IceGunCosmeticDisplay"):Connect(add)
    CollectionService:GetInstanceRemovedSignal("IceGunCosmeticDisplay"):Connect(function(object)
        if object:IsA("BasePart") then
            displays[object] = nil
        end
    end)
    -- One managed cosmetic animator, preserving the original local Z-axis spin.
    RunService.RenderStepped:Connect(function()
        if debugging() and os.clock() - lastDiagnostic >= 5 then
            lastDiagnostic = os.clock()
            diagnose()
        end
        for display in displays do
            local base = display:GetAttribute("IceGunDisplayBase")
            if typeof(base) == "CFrame" and display:IsDescendantOf(workspace) then
                display.CFrame = base * CFrame.Angles(0, 0, os.clock() * Config.DisplayRadiansPerSecond)
            end
        end
    end)
    local function format(key: string, _holding: boolean): string
        local snapshot = Adapter.GetSnapshot()
        local status = if snapshot.Owned
            then "OWNED"
            elseif snapshot.Ownership == "Loading" then "LOADING..."
            elseif snapshot.Ownership == "Unavailable" then "UNAVAILABLE"
            else snapshot.PriceText
        local action = if snapshot.Owned
            then (if snapshot.Equipped then "EQUIPPED" else "EQUIP")
            elseif snapshot.CanBuy then "BUY"
            else "RETRY"
        return "ICE GUN\n" .. status .. "\n[" .. key .. "] " .. action
    end
    local function refresh()
        for _, view in views do
            view.Text.Text = format(view.Key, false)
        end
    end
    local function hide(prompt: ProximityPrompt)
        local view = views[prompt]
        views[prompt] = nil
        if view then
            view.Cleanup()
        end
    end
    Adapter.Changed:Connect(refresh)
    PromptService.PromptShown:Connect(function(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
        engineVisible[prompt] = true
        if
            prompt.Style ~= Enum.ProximityPromptStyle.Custom
            or prompt:GetAttribute("IceGunPurchase") ~= true
            or not prompt.Parent
            or not prompt.Parent:IsA("Attachment")
        then
            return
        end
        shownCounts[prompt] = (shownCounts[prompt] or 0) + 1
        log("PromptShown: " .. prompt:GetFullName())
        hide(prompt)
        local cleanup, gui = Presentation.Create(prompt, prompt.Parent, playerGui, inputType, {
            FormatText = format,
            Width = 230,
            Height = 100,
            TextSize = 24,
            -- PromptShown/Hidden controls character proximity. Billboard distance is camera-based.
            MaxDistance = math.huge,
            Available = function()
                return Players.LocalPlayer:GetAttribute("Stunned") ~= true
            end,
        })
        local text = gui:FindFirstChild("Action") :: TextLabel
        TextStyle.Apply(text, 24, gui)
        text.TextColor3 = Color3.fromRGB(140, 235, 255)
        local key = if inputType == Enum.ProximityPromptInputType.Touch
            then "TAP"
            elseif inputType == Enum.ProximityPromptInputType.Gamepad then prompt.GamepadKeyCode.Name
            else UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
        views[prompt] = { Cleanup = cleanup, Text = text, Key = key, Gui = gui }
        log("GUI created in PlayerGui: " .. prompt:GetFullName())
        Adapter.Refresh()
        refresh()
    end)
    PromptService.PromptHidden:Connect(function(prompt)
        engineVisible[prompt] = nil
        if prompt:GetAttribute("IceGunPurchase") == true then
            log("PromptHidden: " .. prompt:GetFullName())
        end
        hide(prompt)
    end)
    playerGui:SetAttribute("IceGunPromptRendererRegistered", true)
    diagnose()
    workspace.DescendantRemoving:Connect(function(object)
        if object:IsA("ProximityPrompt") then
            engineVisible[object] = nil
            hide(object)
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="822">
            <Properties>
              <string name="Name">IceGunShopAdapter</string>
              <string name="Source"><![CDATA[--!strict
-- Future Framewisp entry points. All authority stays in IceGunService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Marketplace = game:GetService("MarketplaceService")
local Config = require(ReplicatedStorage.Shared.Constants.IceGunConfig)
local Adapter = {}
local changed = Instance.new("BindableEvent")
Adapter.Changed = changed.Event
local started = false
local price: number? = nil
local forSale: boolean? = nil
local fetching = false
local nextPriceAt = 0

function Adapter.GetSnapshot()
    local ownership = Players.LocalPlayer:GetAttribute("IceGunOwnership") or "Loading"
    return {
        Ownership = ownership,
        Owned = ownership == "Owned",
        Equipped = ownership == "Owned" and Players.LocalPlayer:GetAttribute("IceGunEquipped") == true,
        Price = price,
        PriceText = if price then tostring(price) .. " ROBUX" else "PRICE UNAVAILABLE",
        CanBuy = ownership == "Unowned" and forSale == true,
        CanEquip = ownership == "Owned",
    }
end

local function fetchPrice()
    if fetching or Config.IceGunGamePassId <= 0 or os.clock() < nextPriceAt then
        return
    end
    fetching = true
    nextPriceAt = os.clock() + 30
    task.spawn(function()
        -- Query on the client so PriceInRobux reflects this player's localized price.
        local ok, info = pcall(function()
            return Marketplace:GetProductInfoAsync(Config.IceGunGamePassId, Enum.InfoType.GamePass)
        end)
        fetching = false
        price = if ok and typeof(info.PriceInRobux) == "number" then info.PriceInRobux else nil
        forSale = if ok then info.IsForSale == true else nil
        changed:Fire(Adapter.GetSnapshot())
    end)
end

local function request(action: string)
    local remote = ReplicatedStorage:FindFirstChild("IceGunRequest")
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer(action)
    end
end

function Adapter.Refresh()
    local ownership = Adapter.GetSnapshot().Ownership
    if ownership == "Loading" or ownership == "Unavailable" then
        request("Refresh")
    end
    fetchPrice()
end

function Adapter.RequestPurchase()
    request("Purchase")
end

function Adapter.RequestEquip()
    request("Equip")
end

function Adapter.Init()
    if started then
        return
    end
    started = true
    Players.LocalPlayer:GetAttributeChangedSignal("IceGunOwnership"):Connect(function()
        fetchPrice()
        changed:Fire(Adapter.GetSnapshot())
    end)
    Players.LocalPlayer:GetAttributeChangedSignal("IceGunEquipped"):Connect(function()
        changed:Fire(Adapter.GetSnapshot())
    end)
    fetchPrice()
end

return Adapter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="823">
            <Properties>
              <string name="Name">IceShotgunPresentationController</string>
              <string name="Source"><![CDATA[--!strict
-- Local, bounded cosmetics from server-confirmed results. No aim raycasts or damage.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Constants.IceShotgunPresentationConfig)
local Controller = {}
type Hit = { Position: Vector3, UserId: number, Frozen: boolean }
type Result = {
    Origin: Vector3,
    -- The server hit radius. The pulse is sized to exactly this value, so
    -- the visible blast and the actual hit area are the same sphere.
    Radius: number,
    ShooterUserId: number,
    ServerTime: number,
    Hits: { Hit },
}
type Blast = { Model: Model, Expires: number }
local active: { Blast } = {}
local connections: { RBXScriptConnection } = {}
local started, generation = false, 0
local shotSound, frostTexture = Config.FallbackSoundId, Config.FallbackTexture
local feedback: ScreenGui? = nil
local feedbackUntil = 0

local function mobile(): boolean
    return UserInputService.PreferredInput == Enum.PreferredInput.Touch
end
local function finite(n: any): boolean
    return typeof(n) == "number" and n == n and math.abs(n) < math.huge
end
local function vector(v: any): boolean
    return typeof(v) == "Vector3" and finite(v.X) and finite(v.Y) and finite(v.Z)
end
local function valid(result: any): boolean
    if
        typeof(result) ~= "table"
        or not vector(result.Origin)
        or not finite(result.Radius)
        or result.Radius <= 0
        or result.Radius > 128
        or not finite(result.ShooterUserId)
        or not finite(result.ServerTime)
        or typeof(result.Hits) ~= "table"
        or #result.Hits > 100
    then
        return false
    end
    local age = workspace:GetServerTimeNow() - result.ServerTime
    if age > Config.MaxEventAge or age < -0.25 then
        return false
    end
    for _, hit in result.Hits do
        if
            typeof(hit) ~= "table"
            or not vector(hit.Position)
            or not finite(hit.UserId)
            or typeof(hit.Frozen) ~= "boolean"
        then
            return false
        end
    end
    return true
end
local function part(class: string, model: Model, at: CFrame, size: Vector3): BasePart
    local p = Instance.new(class) :: BasePart
    p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = true, false, false, false, true
    p.CastShadow = false
    p.Color, p.Material, p.Transparency = Config.Blue, Enum.Material.Glass, 0.72
    p.CFrame, p.Size, p.Parent = at, size, model
    return p
end
local function tween(object: Instance, seconds: number, properties: { [string]: any })
    TweenService:Create(object, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
        :Play()
end
-- Transparent bluish pulse expanding outward from the caster, in the style
-- of an outward burst: it starts small at the caster and grows to exactly
-- the server hit radius, then fades. It is one native sphere, anchored and
-- fully inert (no collision, touch, query or shadow), so it cannot block
-- input, movement or raycasts, and it adds no movement mechanic.
local function pulse(model: Model, origin: Vector3, radius: number): BasePart
    local sphere = part("Part", model, CFrame.new(origin), Vector3.new(2, 2, 2)) :: Part
    sphere.Name, sphere.Shape = "IceRadialPulse", Enum.PartType.Ball
    sphere.Transparency = Config.PulseStartTransparency
    local finalSize = Vector3.new(radius * 2, radius * 2, radius * 2)
    tween(sphere, Config.PulseGrowSeconds, { Size = finalSize })
    tween(sphere, Config.PulseGrowSeconds + Config.PulseFadeSeconds, { Transparency = 1 })
    return sphere
end
local function frost(parent: BasePart, count: number, angle: number)
    local emitter = Instance.new("ParticleEmitter")
    emitter.Name, emitter.Texture = "ShotgunFrost", frostTexture
    emitter.Enabled, emitter.Rate = false, 0
    emitter.Color = ColorSequence.new(Config.Blue, Config.White)
    emitter.Lifetime, emitter.Speed = NumberRange.new(0.15, 0.35), NumberRange.new(35, 60)
    emitter.EmissionDirection, emitter.SpreadAngle = Enum.NormalId.Front, Vector2.new(angle * 0.5, angle * 0.5)
    emitter.Drag, emitter.LightEmission = 4, 0.4
    emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0) })
    emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
    emitter.Parent = parent
    emitter:Emit(count)
end
local function sound(parent: Instance, id: string, volume: number)
    local clip = Instance.new("Sound")
    clip.SoundId, clip.Volume = id, volume
    clip.Name = "IceRayCast"
    clip.RollOffMode = Enum.RollOffMode.InverseTapered
    clip.RollOffMinDistance, clip.RollOffMaxDistance = Config.SoundMinDistance, Config.SoundMaxDistance
    clip.PlaybackSpeed = 1
    clip.Parent = parent
    clip:Play()
    Debris:AddItem(clip, Config.SoundLifetime)
end
local function shards(model: Model, position: Vector3, count: number)
    for i = 1, count do
        local angle = i * math.pi * 2 / count
        local at = CFrame.new(position) * CFrame.Angles(i * 0.7, angle, 0.4)
        local shard = part("WedgePart", model, at, Vector3.new(0.13, 0.55, 0.22))
        shard.Name, shard.Transparency = "IceShard", 0.25
        local endPosition = position + Vector3.new(math.cos(angle) * 2, 0.8, math.sin(angle) * 2)
        tween(shard, 0.32, { CFrame = CFrame.new(endPosition) * at.Rotation, Transparency = 1 })
    end
end
local function clearFeedback()
    if feedback then
        feedback:Destroy()
    end
    feedback = nil
end
local function showFeedback(result: Result)
    local player = Players.LocalPlayer
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local shooterHit = player.UserId == result.ShooterUserId and #result.Hits > 0
    local victimHit, froze = false, false
    for _, hit in result.Hits do
        if hit.UserId == player.UserId then
            victimHit = true
        end
        froze = froze or hit.Frozen
    end
    if not gui or not (shooterHit or victimHit) then
        return
    end
    clearFeedback()
    local screen = Instance.new("ScreenGui")
    screen.Name, screen.ResetOnSpawn, screen.IgnoreGuiInset = "IceShotgunHitFeedback", true, true
    screen.DisplayOrder = 9
    if victimHit then
        local flash = Instance.new("Frame")
        flash.Name, flash.Size = "FrostFlash", UDim2.fromScale(1, 1)
        flash.BackgroundColor3, flash.BackgroundTransparency = Config.Blue, 0.9
        flash.Active, flash.Parent = false, screen
        tween(flash, 0.2, { BackgroundTransparency = 1 })
    end
    if shooterHit then
        local marker = Instance.new("TextLabel")
        marker.Name, marker.Text = "ConfirmedHit", "+"
        marker.AnchorPoint, marker.Position = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
        marker.Size, marker.BackgroundTransparency = UDim2.fromOffset(28, 28), 1
        marker.TextColor3 = if froze then Config.Blue else Config.White
        marker.Font, marker.TextSize, marker.TextStrokeTransparency = Enum.Font.GothamBold, 28, 0.4
        marker.Active, marker.Parent = false, screen
        tween(marker, 0.2, { TextTransparency = 1 })
    end
    screen.Parent = gui
    feedback, feedbackUntil = screen, os.clock() + 0.22
end
local function prune()
    local now = os.clock()
    for i = #active, 1, -1 do
        local blast = active[i]
        if now >= blast.Expires or not blast.Model.Parent then
            blast.Model:Destroy()
            table.remove(active, i)
        end
    end
    if feedback and (now >= feedbackUntil or not feedback.Parent) then
        clearFeedback()
    end
end
function Controller.Play(result: any): boolean
    if not started or not valid(result) then
        return false
    end
    local camera, isMobile = workspace.CurrentCamera, mobile()
    local distance = if isMobile then Config.MobileViewDistance else Config.ViewDistance
    if not camera or (camera.CFrame.Position - result.Origin).Magnitude > distance then
        return false
    end
    showFeedback(result)
    prune()
    local maximum = if isMobile then Config.MobileMaxActiveBlasts else Config.MaxActiveBlasts
    if #active >= maximum then
        return false
    end
    local model = Instance.new("Model")
    model.Name, model.Parent = "IceShotgunBlast", workspace
    table.insert(active, { Model = model, Expires = os.clock() + Config.Lifetime })
    local origin = result.Origin
    -- The pulse diameter is exactly twice the server radius: what players
    -- see expanding around the caster is the area that was actually hit.
    local center = pulse(model, origin, result.Radius)
    frost(center, if isMobile then Config.MobileFrostCount else Config.FrostCount, 360)
    local caster = Players:GetPlayerByUserId(result.ShooterUserId)
    local root = caster and caster.Character and caster.Character:FindFirstChild("HumanoidRootPart")
    -- A dedicated emitter follows the caster; the expanding pulse is never an audio source.
    local emitter = Instance.new("Attachment")
    emitter.Name = "IceRayCastEmitter"
    emitter.Parent = if root and root:IsA("BasePart") then root else center
    sound(emitter, shotSound, Config.CastVolume)
    Debris:AddItem(emitter, Config.SoundLifetime)
    local shardCount = if isMobile then Config.MobileShardCount else Config.ShardCount
    local maxImpacts = if isMobile then Config.MobileMaxImpactEffects else Config.MaxImpactEffects
    for index, hit in result.Hits do
        if index > maxImpacts then
            break
        end
        local impact = part("Part", model, CFrame.new(hit.Position), Vector3.new(0.1, 0.1, 0.1))
        impact.Name, impact.Transparency = "IceImpact", 1
        frost(impact, if isMobile then 6 else 10, 180)
        shards(model, hit.Position, shardCount)
    end
    return true
end
function Controller.Init()
    if started then
        return
    end
    started = true
    generation += 1
    local token = generation
    table.insert(connections, RunService.Heartbeat:Connect(prune))
    table.insert(connections, Players.LocalPlayer.CharacterRemoving:Connect(clearFeedback))
    task.spawn(function()
        local remote = ReplicatedStorage.Shared.Events:WaitForChild("IceShotgunResult")
        if started and generation == token and remote:IsA("RemoteEvent") then
            table.insert(connections, remote.OnClientEvent:Connect(Controller.Play))
        end
    end)
    task.spawn(function()
        pcall(function()
            ContentProvider:PreloadAsync(
                { Config.ShotSoundId, Config.FallbackSoundId, Config.FrostTexture },
                function(id, fetchStatus)
                    if not started or generation ~= token or fetchStatus ~= Enum.AssetFetchStatus.Success then
                        return
                    end
                    if id == Config.ShotSoundId then
                        shotSound = id
                    elseif id == Config.FrostTexture then
                        frostTexture = id
                    end
                end
            )
        end)
    end)
end
function Controller.Destroy()
    started = false
    generation += 1
    for _, connection in connections do
        connection:Disconnect()
    end
    table.clear(connections)
    for _, blast in active do
        blast.Model:Destroy()
    end
    table.clear(active)
    clearFeedback()
    shotSound, frostTexture = Config.FallbackSoundId, Config.FallbackTexture
end
return Controller
]]></string>
            </Properties>
