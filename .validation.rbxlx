        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">AdminConfig</string>
            <string name="Source"><![CDATA[--!strict
return {
    -- Numeric IDs are the permanent canonical identities. Fill these from startup logs.
    AdminUserIds = {} :: { number },
    BootstrapUsernames = { "Eatandpoop", "KarmaReaper2", "snipernosniping1234" },
    MaxAddCash = 1_000_000_000,
    CommandCooldownSeconds = 0.35,
}
]]></string>
