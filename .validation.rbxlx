                </Properties>
                <Item class="UIScale" referent="796">
                  <Properties>
                    <string name="Name">FW_Scale</string>
                    <BinaryString name="AttributesSerialize">AQAAAAgAAABGV19Pd25lZAMB</BinaryString>
                    <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
