          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">CarryInputController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local remote = ReplicatedStorage.Shared.Events:WaitForChild("GameplayRequest") :: RemoteEvent
    local function throw(_action: string, state: Enum.UserInputState): Enum.ContextActionResult
        if (player:GetAttribute("CarryCount") or 0) <= 0 or UserInputService:GetFocusedTextBox() then
            return Enum.ContextActionResult.Pass
        end
        if state == Enum.UserInputState.Begin then
            local character = player.Character
            local tool = character and character:FindFirstChildOfClass("Tool")
            local selectedCarryItemId = nil
            if tool and tool:GetAttribute("IngredientId") ~= nil then
                local id = tool:GetAttribute("CarryItemId")
                if typeof(id) == "number" then
                    selectedCarryItemId = id
                end
            end
            -- The server validates this preference against its own held records.
            remote:FireServer("ThrowHeld", selectedCarryItemId)
        end
        return Enum.ContextActionResult.Sink
    end
    ContextActionService:BindAction("ThrowHeld", throw, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
    ContextActionService:SetTitle("ThrowHeld", "Throw")
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">CustomerOrderController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    local tracked: { [BillboardGui]: () -> () } = {}
    local function attach(object: Instance)
        if
            not object:IsA("BillboardGui")
            or (object.Name ~= "OrderBubble" and object.Name ~= "CustomerResult")
            or tracked[object]
        then
            return
        end
        object.Enabled = false
        local customer = object.Parent
        while customer and not customer:IsA("Model") do
            customer = customer.Parent
        end
        if not customer then
            return
        end
        local function refresh()
            object.Enabled = customer:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId
                and (object.Name ~= "OrderBubble" or customer:GetAttribute("OrderRevealed") == true)
        end
        local ownership = customer:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
        local reveal = customer:GetAttributeChangedSignal("OrderRevealed"):Connect(refresh)
        tracked[object] = function()
            ownership:Disconnect()
            reveal:Disconnect()
            object.Enabled = false
        end
        refresh()
    end
    workspace.DescendantAdded:Connect(attach)
    workspace.DescendantRemoving:Connect(function(object)
        if object:IsA("BillboardGui") then
            local cleanup = tracked[object]
            if cleanup then
                tracked[object] = nil
                cleanup()
            end
        end
    end)
    for _, object in workspace:GetDescendants() do
        attach(object)
    end
end

return Controller
]]></string>
            </Properties>
