        <Properties>
          <string name="Name">Components</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">AnnouncedIngredientSpawn</string>
            <string name="Source"><![CDATA[--!strict
--! Server script for announcing rare ingredient spawns to clients.
local Events = game:GetService("ReplicatedStorage").Shared.Events
local IngredientSpawn = require(script.Parent.IngredientSpawn)
local AnnouncedIngredientSpawn = {}
local started = false

function AnnouncedIngredientSpawn.Init(services: any)
    if started then
        return
    end
    started = true
    local existing = Events:FindFirstChild("RareIngredientSpawned")
    local remote: RemoteEvent
    if existing then
        assert(existing:IsA("RemoteEvent"), "RareIngredientSpawned must be a RemoteEvent")
        remote = existing
    else
        remote = Instance.new("RemoteEvent")
        remote.Name = "RareIngredientSpawned"
        remote.Parent = Events
    end
    -- No inbound listener: clients cannot select stock, timing, or announce events.
    IngredientSpawn.Bind(services, "AnnouncedIngredientSpawn", function(station, id)
        local location = station:GetAttribute("LocationName")
        remote:FireAllClients({
            Type = "RareIngredientSpawned",
            IngredientId = id,
            DisplayName = services.IngredientService.GetDefinition(id).DisplayName,
            LocationName = if typeof(location) == "string" and location ~= "" then location else station.Name,
        })
    end)
end

return AnnouncedIngredientSpawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">BlendProgressLights</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderReadyIndicator = require(script.Parent.BlenderReadyIndicator)
local BlendProgressLights = {}

type Light = {
    Bulb: BasePart,
    Point: PointLight,
    Insert: BasePart?,
    OffMaterial: Enum.Material,
    Brightness: number,
    Mode: string,
}

local function playClick(light: Light)
    local sound = Instance.new("Sound")
    sound.Name = "BlendThresholdClick"
    sound.SoundId = "rbxassetid://113416294133952"
    sound.Volume = 0.5
    sound.RollOffMaxDistance = 60
    sound.Parent = light.Bulb
    sound.Ended:Once(function()
        sound:Destroy()
    end)
    Debris:AddItem(sound, 10)
    sound:Play()
end

local function setMode(light: Light, mode: string)
    if light.Mode == mode then
        return
    end
    light.Mode = mode
    light.Bulb.Material = if mode == "solid" then Enum.Material.Neon else light.OffMaterial
    if light.Insert then
        light.Insert.Transparency = if mode == "off" then 1 else 0
    end
    light.Point.Enabled = mode ~= "off"
    light.Point.Brightness = if mode == "off" then 0 else light.Brightness
end

function BlendProgressLights.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        local folder = blender and blender:FindFirstChild("BlendProgressLights")
        if not folder then
            return nil
        end
        -- Group physical bulbs by milestone; banks never own progress or clicks.
        local lights: { { Light } } = { {}, {}, {}, {}, {} }
        local clicked: { [number]: boolean } = {}
        local banks: { Instance } = {}
        if folder:FindFirstChild("Light1") then
            -- Preserve the original single-bank hierarchy during Studio migration.
            table.insert(banks, folder)
        else
            for _, bank in folder:GetChildren() do
                if bank:IsA("Folder") or bank:IsA("Model") then
                    table.insert(banks, bank)
                end
            end
        end
        table.sort(banks, function(a, b)
            return a.Name < b.Name
        end)
        for _, bank in banks do
            local bankContext = bank:GetFullName()
            for index = 1, 5 do
                local model = bank:FindFirstChild("Light" .. index)
                local bulb = if model and model:IsA("Model") then model:FindFirstChild("Bulb") else nil
                local point = bulb and bulb:FindFirstChild("PointLight")
                local insert = if model then model:FindFirstChild("Light") else nil
                if bulb and bulb:IsA("BasePart") and point and point:IsA("PointLight") then
                    if not insert or not insert:IsA("BasePart") then
                        warn("[BlendProgressLights] Expected " .. bankContext .. ".Light" .. index .. ".Light BasePart")
                    end
                    table.insert(lights[index], {
                        Bulb = bulb,
                        Point = point,
                        Insert = if insert and insert:IsA("BasePart") then insert else nil,
                        OffMaterial = if bulb.Material == Enum.Material.Neon
                            then Enum.Material.SmoothPlastic
                            else bulb.Material,
                        -- An authored zero is an off setting; use a visible solid fallback.
                        Brightness = if point.Brightness > 0 then point.Brightness else 1.5,
                        Mode = "",
                    })
                else
                    warn("[BlendProgressLights] Expected " .. bankContext .. ".Light" .. index .. ".Bulb.PointLight")
                end
            end
        end

        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local function refresh(playThresholdClicks: boolean?)
            local player = owner
            local state = player and player:GetAttribute("BlendState") or "EMPTY"
            local progress = player and player:GetAttribute("BlendProgress") or 0
            -- BlendService publishes DISPENSED after a successful dispense, then
            -- Reset publishes EMPTY. Stopping progress production is not a reset.
            local reset = state == "EMPTY" or state == "DISPENSED"
            local completed = if reset
                then 0
                else math.clamp(math.floor((progress :: number) / Economy.RequiredProgress * 5), 0, 5)
            if completed == 5 and not BlenderReadyIndicator.IsReady(state, progress) then
                completed = 4
            end
            for index, milestoneLights in lights do
                for _, light in milestoneLights do
                    setMode(light, if index <= completed then "solid" else "off")
                end
                if reset then
                    clicked[index] = nil
                elseif index <= completed and index <= 4 and not clicked[index] then
                    clicked[index] = true
                    local soundSource = milestoneLights[1]
                    if playThresholdClicks ~= false and soundSource then
                        playClick(soundSource)
                    end
                end
            end
        end
        local function bindOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
            table.clear(clicked)
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            local player = owner
            if player then
                for _, attribute in { "BlendProgress", "BlendState" } do
                    table.insert(ownerConnections, player:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
            end
            -- Binding an already-progressed batch restores visuals silently;
            -- only subsequent authoritative threshold crossings play clicks.
            refresh(false)
        end
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                owner = nil
                refresh()
            end
        end)
        bindOwner()
        return function()
            ownership:Disconnect()
            leaving:Disconnect()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            for _, milestoneLights in lights do
                for _, light in milestoneLights do
                    setMode(light, "off")
                end
            end
        end
    end)
end

return BlendProgressLights
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">BlendVFX</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation only. BlendService owns acceptance, progress, color and reset.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlendVFX = {}
-- Legacy fallback in BlendVisualOrigin's local axes; never scales templates.
local IngredientSlotNames = { "IngredientSlot1", "IngredientSlot2", "IngredientSlot3" }
local IngredientOffsetRadius = 1.8 -- studs; fit to the jar's interior clearance
local IngredientVerticalSpread = 0.4 -- studs per local Y offset below
local IngredientArrivalDuration = 0.35 -- seconds; existing arrival timing
local IngredientOffsets = {
    Vector3.new(1, -0.4, 0.05),
    Vector3.new(-0.65, 0.15, 0.75),
    Vector3.new(-0.5, -0.2, -0.8),
    Vector3.new(0.55, -0.6, 0.7),
    Vector3.new(-0.95, 0.4, -0.1),
    Vector3.new(0.4, 0, -0.75),
}
-- Keep authored values across tag removal/re-entry; detached liquid is hidden.
-- Weak keys release the cache when a plot's liquid is destroyed and collected.
local liquidDefaults = setmetatable({} :: { [BasePart]: { Color: Color3, Transparency: number } }, { __mode = "k" })

-- Temporary lifecycle diagnostics; never print progress updates every frame.
local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[BlendVFX] " .. message)
    end
end

local function findLiquid(blender: Instance, visuals: Instance?): BasePart?
    local container = blender:FindFirstChild("Liquid")
    local nested = container and container:FindFirstChild("Liquid")
    if nested and nested:IsA("BasePart") then
        return nested
    end
    if container and container:IsA("BasePart") then
        return container
    end
    -- Imported models may nest the named liquid under Body/Glass/etc. Never
    -- select arbitrary geometry or an ingredient proxy as the smoothie surface.
    local found: BasePart? = nil
    for _, candidate in blender:GetDescendants() do
        if
            candidate:IsA("BasePart")
            and string.lower(candidate.Name) == "liquid"
            and not (visuals and candidate:IsDescendantOf(visuals))
        then
            if found then
                diagnostic("liquid ambiguous=true; multiple named Liquid parts")
                return nil
            end
            found = candidate
        end
    end
    return found
end

local function sanitize(proxy: Instance)
    local descendants = proxy:GetDescendants()
    table.insert(descendants, proxy)
    for _, child in descendants do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        for attribute in child:GetAttributes() do
            child:SetAttribute(attribute, nil)
        end
        -- Keep geometry and appearance only, before anything enters Workspace.
        if child:IsA("BasePart") then
            child.Anchored = true
            child.CanCollide = false
            child.CanTouch = false
            child.CanQuery = false
        elseif
            not (
                child:IsA("Model")
                or child:IsA("Folder")
                or child:IsA("DataModelMesh")
                or child:IsA("Decal")
                or child:IsA("Texture")
                or child:IsA("SurfaceAppearance")
                or child:IsA("Attachment")
            )
        then
            child:Destroy()
        end
    end
end

function BlendVFX.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        if not blender then
            return nil
        end
        diagnostic("bound plot=" .. plot.Name)
        diagnostic("bound blender path=" .. blender:GetFullName())
        for _, child in blender:GetChildren() do
            diagnostic("child name=" .. child.Name .. " class=" .. child.ClassName)
        end
        local folder = blender:FindFirstChild("IngredientVisuals")
        diagnostic("IngredientVisuals found=" .. tostring(folder ~= nil and folder:IsA("Folder")))
        local createdFolder = false
        if not folder then
            local fallback = Instance.new("Folder")
            fallback.Name = "IngredientVisuals"
            fallback.Parent = blender
            folder = fallback
            createdFolder = true
        elseif not folder:IsA("Folder") then
            warn("[BlendVFX] Expected Blender.IngredientVisuals Folder; ingredient visuals skipped")
            folder = nil
        end
        local visuals = folder
        local origin = blender:FindFirstChild("BlendVisualOrigin")
        diagnostic("BlendVisualOrigin found=" .. tostring(origin ~= nil))
        local liquid: BasePart? = nil
        local originalColor = Color3.new(1, 1, 1)
        local finishedTransparency = 0
        local function discoverLiquid()
            local container = blender:FindFirstChild("Liquid")
            local nested = container and container:FindFirstChild("Liquid")
            local count = 0
            for _, candidate in blender:GetDescendants() do
                if candidate:IsA("BasePart") and string.find(string.lower(candidate.Name), "liquid", 1, true) then
                    count += 1
                end
            end
            diagnostic("liquid container direct=" .. tostring(container ~= nil))
            diagnostic("liquid nested part=" .. tostring(nested ~= nil and nested:IsA("BasePart")))
            diagnostic("liquid descendant candidates=" .. tostring(count))
            liquid = findLiquid(blender, blender:FindFirstChild("IngredientVisuals"))
            diagnostic(
                "liquid found="
                    .. tostring(liquid ~= nil)
                    .. " path="
                    .. (if liquid then liquid:GetFullName() else "<none>")
            )
            if liquid then
                diagnostic(
                    "liquid anchored=" .. tostring(liquid.Anchored) .. " archivable=" .. tostring(liquid.Archivable)
                )
                if not liquidDefaults[liquid] then
                    liquidDefaults[liquid] = { Color = liquid.Color, Transparency = liquid.Transparency }
                end
                local defaults = liquidDefaults[liquid]
                originalColor = defaults.Color
                finishedTransparency = defaults.Transparency
            end
        end
        discoverLiquid()
        if not origin or not (origin:IsA("BasePart") or origin:IsA("Attachment")) then
            warn("[BlendVFX] Expected Blender.BlendVisualOrigin BasePart or Attachment; ingredient visuals skipped")
        end
        local emitters: { ParticleEmitter } = {}
        local seen: { [Instance]: boolean } = {}
        local function isPuffEmitter(emitter: ParticleEmitter): boolean
            return string.sub(string.lower(emitter.Name), 1, 4) == "puff"
        end
        local function collectEmitters(root: Instance?)
            if not root then
                return
            end
            local candidates = root:GetDescendants()
            table.insert(candidates, root)
            for _, candidate in candidates do
                if candidate:IsA("ParticleEmitter") and isPuffEmitter(candidate) and not seen[candidate] then
                    seen[candidate] = true
                    table.insert(emitters, candidate)
                end
            end
        end
        collectEmitters(origin)
        diagnostic("emitters found=" .. tostring(#emitters))
        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local tweens: { Tween } = {}
        local displayed: { [number]: boolean } = {}
        local ownedVisuals: { Instance } = {}
        local cloudActive = false
        local phase = ""
        local lastProgress = 0
        local lastIncreaseAt = 0
        local activityTimer: thread? = nil
        local activityGrace = 0.35
        local function cloud(enabled: boolean)
            cloudActive = enabled
            for _, emitter in emitters do
                emitter.Enabled = enabled
                if not enabled then
                    emitter:Clear() -- Immediate completion reveal, including long-lived particles.
                end
            end
        end
        local function stopActivity()
            if activityTimer then
                task.cancel(activityTimer)
                activityTimer = nil
            end
            cloud(false)
        end
        local function expireActivity()
            activityTimer = nil
            local remaining = activityGrace - (os.clock() - lastIncreaseAt)
            if remaining > 0 then
                activityTimer = task.delay(remaining, expireActivity)
            else
                if cloudActive then
                    diagnostic("blend visual idle")
                end
                cloud(false)
            end
        end
        local function clearIngredients()
            for _, tween in tweens do
                tween:Cancel()
            end
            table.clear(tweens)
            table.clear(displayed)
            for _, child in ownedVisuals do
                child:Destroy()
            end
            table.clear(ownedVisuals)
        end
        local function reset()
            if phase ~= "reset" then
                diagnostic("reset")
            end
            phase = "reset"
            clearIngredients()
            stopActivity()
            lastProgress = 0
            if liquid then
                liquid.Color = originalColor
                liquid.Transparency = 1
            end
        end
        local function addIngredient(id: string, index: number, from: CFrame?)
            if displayed[index] or not origin or not visuals then
                return
            end
            local at: CFrame
            if origin:IsA("BasePart") then
                at = origin.CFrame
            elseif origin:IsA("Attachment") then
                at = origin.WorldCFrame
            else
                return
            end
            local proxy = services.IngredientService.CreateVisual(id)
            diagnostic("visual source found=" .. tostring(proxy ~= nil))
            if not proxy then
                return
            end
            sanitize(proxy)
            local physical = proxy :: any
            -- Resolve the complete authored set at placement time. Exact direct
            -- Blender children take precedence; origin children are also supported.
            local slots: { Attachment } = {}
            for _, name in IngredientSlotNames do
                local candidate = blender:FindFirstChild(name) or origin:FindFirstChild(name)
                if candidate and candidate:IsA("Attachment") then
                    table.insert(slots, candidate)
                end
            end
            local target: CFrame
            if index >= 1 and index <= #IngredientSlotNames and #slots == #IngredientSlotNames then
                target = slots[index].WorldCFrame
            else
                if index > #IngredientSlotNames and RunService:IsStudio() then
                    warn(
                        string.format(
                            "[BlendVFX] Unexpected ingredient index=%d plot=%s; expected exactly 3, using presentation offset fallback",
                            index,
                            plot:GetFullName()
                        )
                    )
                end
                -- An incomplete set falls back as a whole, preserving legacy layout.
                local offset = IngredientOffsets[(index - 1) % #IngredientOffsets + 1]
                local localOffset = Vector3.new(
                    offset.X * IngredientOffsetRadius,
                    offset.Y * IngredientVerticalSpread,
                    offset.Z * IngredientOffsetRadius
                )
                target = at * CFrame.new(localOffset.X, localOffset.Y, localOffset.Z)
            end
            local start = from or target
            physical:PivotTo(start)
            proxy.Name = "BlendIngredientVisual"
            proxy.Parent = visuals
            table.insert(ownedVisuals, proxy)
            diagnostic("visual created=" .. proxy:GetFullName())
            displayed[index] = true
            local parts = proxy:GetDescendants()
            table.insert(parts, proxy)
            for _, part in parts do
                if part:IsA("BasePart") and from then
                    local tween = TweenService:Create(
                        part,
                        TweenInfo.new(IngredientArrivalDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                        {
                            CFrame = target * start:ToObjectSpace(part.CFrame),
                        }
                    )
                    table.insert(tweens, tween)
                    tween:Play()
                end
            end
        end
        local function refresh()
            local player = owner
            -- Snapshot avoids observing a half-published state/progress attribute pair.
            local batch = player and services.BlendService.GetSnapshot(player)
            if not batch or batch.State == "EMPTY" or batch.State == "DISPENSED" then
                reset()
                return
            end
            local complete = batch.State == "COMPLETE"
            local active = batch.Progress > 0
            if not active and not complete then
                phase = "loaded"
                if liquid then
                    liquid.Color = originalColor
                    liquid.Transparency = 1
                end
                return
            end
            if complete then
                if phase ~= "complete" then
                    diagnostic("complete")
                end
                phase = "complete"
            else
                phase = "blending"
            end
            clearIngredients()
            if complete then
                stopActivity()
            elseif batch.Progress > lastProgress then
                lastIncreaseAt = os.clock()
                if not cloudActive then
                    diagnostic("blend active progress=" .. tostring(batch.Progress))
                end
                cloud(true)
                if not activityTimer then
                    activityTimer = task.delay(activityGrace, expireActivity)
                end
            end
            lastProgress = batch.Progress
            if liquid and player then
                local color = if batch.Result then batch.Result.Color else player:GetAttribute("BlendColor")
                if typeof(color) == "Color3" then
                    liquid.Color = color
                end
                local progress = if complete then 1 else math.clamp(batch.Progress / Economy.RequiredProgress, 0, 1)
                -- Preserve the authored endpoint; zero progress is fully hidden.
                liquid.Transparency = if progress == 1
                    then finishedTransparency
                    else 1 + (finishedTransparency - 1) * progress
            end
        end
        local function disconnectOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
        end
        local function bindOwner()
            disconnectOwner()
            reset()
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            local player = owner
            if player then
                for _, attribute in { "BlendProgress", "BlendState", "BlendColor" } do
                    table.insert(ownerConnections, player:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
                local batch = services.BlendService.GetSnapshot(player)
                if batch and (batch.State == "LOADING" or batch.State == "READY") and batch.Progress == 0 then
                    for index, id in batch.Ingredients do
                        addIngredient(id, index, nil)
                    end
                end
            end
            refresh()
        end
        local accepted = services.BlendService.ObserveIngredientAccepted(function(player, id, at, index)
            diagnostic("accepted ingredient=" .. id)
            if player ~= owner then
                diagnostic("accepted visual skipped owner mismatch plot=" .. plot.Name)
                return
            end
            local batch = services.BlendService.GetSnapshot(player)
            if
                batch
                and (batch.State == "LOADING" or batch.State == "READY")
                and batch.Progress == 0
                and batch.Ingredients[index] == id
            then
                addIngredient(id, index, at)
            else
                diagnostic(
                    "accepted visual skipped state="
                        .. tostring(batch and batch.State)
                        .. " progress="
                        .. tostring(batch and batch.Progress)
                )
            end
        end)
        diagnostic("ObserveIngredientAccepted connected=true")
        local alive = true
        local function liquidHierarchyChanged(object: Instance)
            if string.lower(object.Name) ~= "liquid" then
                return
            end
            diagnostic("liquid hierarchy changed path=" .. object:GetFullName())
            task.defer(function()
                if alive then
                    discoverLiquid()
                    refresh()
                end
            end)
        end
        local liquidAdded = blender.DescendantAdded:Connect(liquidHierarchyChanged)
        local liquidRemoving = blender.DescendantRemoving:Connect(liquidHierarchyChanged)
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                disconnectOwner()
                owner = nil
                reset()
            end
        end)
        bindOwner()
        return function()
            alive = false
            liquidAdded:Disconnect()
            liquidRemoving:Disconnect()
            accepted:Disconnect()
            ownership:Disconnect()
            leaving:Disconnect()
            disconnectOwner()
            owner = nil
            reset()
            if createdFolder and visuals and #visuals:GetChildren() == 0 then
                visuals:Destroy()
            end
        end
    end)
end

return BlendVFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">BlenderInput</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderInput = {}
function BlenderInput.Init(services: any)
    WorldUtil.BindTag("BlenderInput", function(object)
        if not object:IsA("BasePart") then
            warn("[BlenderInput] Tag a BasePart")
            return nil
        end
        local elapsed = 0
        local connection = RunService.Heartbeat:Connect(function(dt)
            elapsed += dt
            if elapsed < 0.1 then
                return
            end
            elapsed = 0
            local owner = services.TycoonService.GetOwner(object)
            if not owner then
                return
            end
            local seen: { [Instance]: boolean } = {}
            for _, part in workspace:GetPartsInPart(object) do
                local item = services.IngredientService.Resolve(part)
                if item and not seen[item] then
                    seen[item] = true
                    services.BlendService.TryInput(owner, item, object)
                end
            end
        end)
        return function()
            connection:Disconnect()
        end
    end)
end
return BlenderInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">BlenderKillScript</string>
            <string name="Source">local CollectionService = game:GetService("CollectionService")

local BlenderKill = {}

local TAG = "KillZone"

local function connectKillPart(part: Instance)
    if not part:IsA("BasePart") then
        return
    end

    if part:GetAttribute("KillZoneConnected") then
        return
    end

    part:SetAttribute("KillZoneConnected", true)

    part.Touched:Connect(function(hit)
        local character = hit:FindFirstAncestorOfClass("Model")
        if not character then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health &gt; 0 then
            humanoid.Health = 0
        end
    end)
end

function BlenderKill.Init()
    for _, instance in CollectionService:GetTagged(TAG) do
        connectKillPart(instance)
    end

    CollectionService:GetInstanceAddedSignal(TAG):Connect(connectKillPart)
end

return BlenderKill</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">BlenderReadyIndicator</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderReadyIndicator = {}

-- Presentation of BlendService's published state only; never authorizes dispensing.
-- READY means loaded, whereas COMPLETE means blended and dispensable.
function BlenderReadyIndicator.IsReady(state: any, progress: any): boolean
    return state == "COMPLETE" and typeof(progress) == "number" and progress >= Economy.RequiredProgress
end

function BlenderReadyIndicator.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        local marker = blender and blender:FindFirstChild("ReadyIndicatorOrigin", true)
        if not marker or not (marker:IsA("BasePart") or marker:IsA("Attachment")) then
            warn("[BlenderReadyIndicator] Missing BasePart/Attachment ReadyIndicatorOrigin in " .. plot:GetFullName())
            return nil
        end
        local disk = Instance.new("Part")
        disk.Name = "BlenderReadyFloorIndicator"
        disk.Shape = Enum.PartType.Cylinder
        disk.Size = Vector3.new(0.15, 8, 8
)
        disk.Anchored = true
        disk.CanCollide = false
        disk.CanTouch = false
        disk.CanQuery = false
        disk.CastShadow = false
        disk.Material = Enum.Material.Neon
        disk.Color = Color3.fromRGB(1, 189, 29)
        disk.Transparency = 1
        -- Cylinder length is local X. Ignore marker rotation to remain floor-flat.
        local function place()
            local position = if marker:IsA("Attachment") then marker.WorldPosition else (marker :: BasePart).Position
            disk.CFrame = CFrame.new(position + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2)
        end
        place()
        disk.Parent = marker
        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local function refresh()
            local ready = owner ~= nil
                and BlenderReadyIndicator.IsReady(owner:GetAttribute("BlendState"), owner:GetAttribute("BlendProgress"))
            if ready then
                place()
            end
            disk.Transparency = if ready then 0.1 else 1
        end
        local function disconnectOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
        end
        local function bindOwner()
            disconnectOwner()
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            if owner then
                for _, attribute in { "BlendState", "BlendProgress" } do
                    table.insert(ownerConnections, owner:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
            end
            refresh()
        end
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                disconnectOwner()
                owner = nil
                refresh()
            end
        end)
        bindOwner()
        return function()
            ownership:Disconnect()
            leaving:Disconnect()
            disconnectOwner()
            disk:Destroy()
        end
    end)
end

return BlenderReadyIndicator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">BlenderStatusPresentation</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderStatusPresentation = {}

-- Cosmetic tuning only. Capacity comes from the same config as BlendService.
local TEXT_SIZE = 24
local MAX_DISTANCE = 5
-- Offset-only canvases keep both displays at a fixed screen-space pixel size.
local COUNT_SIZE = UDim2.fromOffset(240, 72)
local PROMPT_SIZE = UDim2.fromOffset(380, 80)
local COUNT_OFFSET = Vector3.new(0, 0, 0)
local PROMPT_OFFSET = Vector3.new(0, 0, 0)
local WHITE = Color3.new(1, 1, 1)
local FULL_COLOR = Color3.new(0.45, 1, 0.55)

-- Presentation markers accept Attachments without changing gameplay references,
-- whose TycoonService.GetReference API intentionally returns BaseParts.
local function origin(root: Instance, name: string): Instance?
    local direct = root:FindFirstChild(name)
    if direct and (direct:IsA("Attachment") or direct:IsA("BasePart")) then
        return direct
    end
    local found: Instance? = nil
    for _, child in root:GetDescendants() do
        if child.Name == name and (child:IsA("Attachment") or child:IsA("BasePart")) then
            if found then
                warn("[BlenderStatusPresentation] Duplicate " .. name .. " in " .. root:GetFullName())
                return nil
            end
            found = child
        end
    end
    if not found then
        warn("[BlenderStatusPresentation] Missing " .. name .. " in " .. root:GetFullName())
    end
    return found
end

local function billboard(marker: Instance, name: string, size: UDim2, offset: Vector3): (BillboardGui, TextLabel)
    local gui = Instance.new("BillboardGui")
    gui.Name = name
    gui.Adornee = marker
    gui.Size = size
    gui.StudsOffsetWorldSpace = offset
    gui.AlwaysOnTop = true
    gui.MaxDistance = MAX_DISTANCE
    local text = Instance.new("TextLabel")
    text.Name = "Status"
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.BorderSizePixel = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.TextStrokeTransparency = 0.25
    text.TextColor3 = WHITE
    text.Font = Enum.Font.GothamBold
    text.TextScaled = false
    text.TextSize = TEXT_SIZE
    text.TextWrapped = true
    text.Text = ""
    text.Parent = gui
    gui.Parent = marker
    return gui, text
end

function BlenderStatusPresentation.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        local countOrigin = blender and origin(blender, "IngredientCountOrigin")
        local promptOrigin = origin(plot, "TurbinePromptOrigin")
        local guis: { BillboardGui } = {}
        local countText: TextLabel? = nil
        local promptText: TextLabel? = nil
        if countOrigin then
            local gui, text = billboard(countOrigin, "IngredientCountDisplay", COUNT_SIZE, COUNT_OFFSET)
            table.insert(guis, gui)
            countText = text
        end
        if promptOrigin then
            local gui, text = billboard(promptOrigin, "TurbineStatusDisplay", PROMPT_SIZE, PROMPT_OFFSET)
            table.insert(guis, gui)
            promptText = text
        end
        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local function refresh()
            local state = if owner then owner:GetAttribute("BlendState") else "EMPTY"
            local accepted = if owner then owner:GetAttribute("BlendIngredientCount") else 0
            local loaded = if state == "EMPTY" or typeof(accepted) ~= "number" then 0 else accepted :: number
            local full = loaded >= Economy.MaxIngredients
            if countText then
                countText.Text = string.format("%d / %d", loaded, Economy.MaxIngredients)
                    .. (if full then "\nLOADING COMPLETE!" else "")
                countText.TextColor3 = if full then FULL_COLOR else WHITE
            end
            if promptText then
                promptText.Text = if state == "COMPLETE"
                    then "READY TO DISPENSE!"
                    elseif state == "BLENDING" then "BLENDING..."
                    elseif state == "READY" and full then "SPIN TO BLEND!"
                    elseif not full and owner and owner:GetAttribute("BlendNeedsItems") == true
                        then string.format("NEEDS %d ITEMS!", Economy.MaxIngredients)
                    else "LOAD INGREDIENTS TO BLEND!"
            end
        end
        local function disconnectOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
        end
        local function bindOwner()
            disconnectOwner()
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            if owner then
                for _, attribute in { "BlendIngredientCount", "BlendState", "BlendNeedsItems" } do
                    table.insert(ownerConnections, owner:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
            end
            refresh()
        end
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                disconnectOwner()
                owner = nil
                refresh()
            end
        end)
        bindOwner()
        return function()
            ownership:Disconnect()
            leaving:Disconnect()
            disconnectOwner()
            for _, gui in guis do
                gui:Destroy()
            end
        end
    end)
end

return BlenderStatusPresentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">BlenderVacuum</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.BlenderVacuum)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Physics = require(script.Parent.Parent.Services.BlenderVacuumPhysics)
local BlenderVacuum = {}

local function log(message: string)
    if RunService:IsStudio() and ServerStorage:GetAttribute("DebugBlenderVacuum") == true then
        print("[BlenderVacuum] " .. message)
    end
end

local function targetPosition(zone: BasePart, input: BasePart): Vector3
    -- Attachments belong to BaseParts. Prefer a direct child of InputZone,
    -- then VacuumZone, so unrelated blender attachments cannot win by scan order.
    for _, parent in { input, zone } do
        local target = parent:FindFirstChild("VacuumTarget")
        if target and target:IsA("Attachment") then
            return target.WorldPosition
        end
    end
    return input.Position + input.CFrame.UpVector * (input.Size.Y * 0.5 + Config.TargetHeight)
end

local function looseRoot(item: Instance): BasePart?
    local ancestor: Instance? = item
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Tool") or ancestor:IsA("Accessory") or ancestor:FindFirstChildOfClass("Humanoid") then
            return nil
        end
        ancestor = ancestor.Parent
    end
    local root = WorldUtil.Part(item)
    if not root or root.Anchored then
        return nil
    end
    -- Reject a registered object welded to a character/other external assembly.
    for _, part in root:GetConnectedParts(true) do
        if part.Anchored or (part ~= item and not part:IsDescendantOf(item)) then
            return nil
        end
    end
    return root
end

function BlenderVacuum.Init(services: any)
    local active: { [Instance]: BasePart } = {}
    -- One update for all authored zones; no workspace traversal or per-item connections.
    RunService.Heartbeat:Connect(function(dt: number)
        local candidates: { [Instance]: any } = {}
        for _, zone in CollectionService:GetTagged("BlenderVacuum") do
            if not zone:IsA("BasePart") or not zone:IsDescendantOf(workspace) then
                continue
            end
            local owner = services.TycoonService.GetOwner(zone)
            if not owner or services.TycoonService.GetReference(owner, "BlenderVacuum") ~= zone then
                continue
            end
            local input = services.TycoonService.GetReference(owner, "BlenderInput")
            if not input then
                continue
            end
            local target = targetPosition(zone, input)
            local insideInput: { [Instance]: boolean } = {}
            for _, part in workspace:GetPartsInPart(input) do
                local item = services.IngredientService.Resolve(part)
                if item then
                    insideInput[item] = true
                end
            end
            local seen: { [Instance]: boolean } = {}
            for _, part in workspace:GetPartsInPart(zone) do
                local item = services.IngredientService.Resolve(part)
                if not item or seen[item] or insideInput[item] then
                    continue
                end
                seen[item] = true
                local record = services.IngredientService.GetRecord(item)
                if
                    not record
                    or (record.Owner ~= nil and record.Owner ~= owner)
                    or (record.Owner == nil and not record.Claimable)
                then
                    continue
                end
                local root = looseRoot(item)
                if not root then
                    continue
                end
                -- Release at the opening; never hold ingredients below the target.
                if root.Position.Y < target.Y then
                    continue
                end
                local distance = (root.Position - target).Magnitude
                local previous = candidates[item]
                -- Public claimable items follow existing input ownership rules.
                -- Nearest valid opening wins, with UserId as a stable tie breaker.
                if
                    not previous
                    or distance < previous.Distance
                    or (distance == previous.Distance and owner.UserId < previous.Owner.UserId)
                then
                    candidates[item] = { Zone = zone, Root = root, Target = target, Owner = owner, Distance = distance }
                end
            end
        end
        local nextActive: { [Instance]: BasePart } = {}
        for item, candidate in candidates do
            local root = candidate.Root
            -- No yields between eligibility and velocity write/consumption boundary.
            if services.IngredientService.GetRecord(item) and root:IsDescendantOf(workspace) then
                if active[item] ~= candidate.Zone then
                    log("captured ingredient=" .. item.Name .. " owner=" .. candidate.Owner.Name)
                end
                nextActive[item] = candidate.Zone
                root.AssemblyLinearVelocity = Physics.Steer(
                    root.AssemblyLinearVelocity,
                    root.Position,
                    candidate.Target,
                    math.max(candidate.Zone.Size.X, candidate.Zone.Size.Z) * 0.5,
                    dt
                )
            end
        end
        for item, zone in active do
            if nextActive[item] ~= zone then
                log("released ingredient=" .. item.Name)
            end
        end
        active = nextActive
    end)
end

return BlenderVacuum
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">DayButton</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local DayButton = {}

local function existingPrompt(object: Instance, part: BasePart): ProximityPrompt?
    -- The authored prompt may be a sibling of the button, directly on its Model.
    local root: Instance? = object
    while root and root ~= workspace do
        local origin = root:FindFirstChild("StartDayTextOrigin")
        if origin and origin:IsA("Attachment") then
            local prompt = root:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                return prompt
            end
            break
        end
        root = root.Parent
    end
    return part:FindFirstChildOfClass("ProximityPrompt")
end

-- Keep authored fixtures, but retire the manual gameplay interaction.
function DayButton.Init(_services: any)
    WorldUtil.BindTag("StartDayButton", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            return nil
        end
        local prompt = existingPrompt(object, part)
        if prompt then
            prompt.Enabled = false
        end
        return nil
    end)
end
return DayButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">DispenseButton</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local AudioService = require(script.Parent.Parent.Services.AudioService)
local DispenseButton = {}
function DispenseButton.Init(services: any)
    WorldUtil.BindTag("DispenseButton", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[DispenseButton] Requires a BasePart")
            return nil
        end
        local prompt = WorldUtil.Prompt(part, "DispensePrompt", "Dispense smoothie")
        prompt:SetAttribute("InteractionOrigin", "DispenserTextOrigin")
        prompt:SetAttribute("InteractionActionText", "DISPENSE")
        prompt.Style = Enum.ProximityPromptStyle.Custom
        local audio = AudioService.CreateBlendGroup(part)
        local connection = prompt.Triggered:Connect(function(player)
            if services.TycoonService.GetOwner(part) ~= player then
                return
            end
            local success = services.BlendService.Dispense(player, part)
            if success then
                audio.pourSound:Play()
            else
                audio.notReadySound:Play()
            end
        end)
        return function()
            connection:Disconnect()
            prompt:Destroy()
            for _, sound in audio do
                sound:Destroy()
            end
        end
    end)
end
return DispenseButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Dispenser</string>
            <string name="Source"><![CDATA[--!strict
-- Inventory-to-physical-unit API only. IngredientPickup owns loose-item interaction.
local Dispenser = {}
local deps: any
function Dispenser.Init(services: any)
    deps = services
end
function Dispenser.DispenseIngredient(player: Player, id: string): Instance?
    return deps.InventoryService.ReleaseUnit(player, id)
end
return Dispenser
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">IngredientPickup</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local IngredientPickup = {}
function IngredientPickup.Init(services: any)
    WorldUtil.BindTag("IngredientWorldItem", function(object)
        local record = services.IngredientService.GetRecord(object)
        local part = WorldUtil.Part(object)
        -- Eligibility only; InventoryService authorizes the triggering player's loose pickup.
        -- Nonclaimable market stock keeps its existing pedestal transaction.
        if not record or not record.Claimable or not part then
            return nil
        end
        local prompt = WorldUtil.Prompt(part, "CarryPrompt", "Pickup")
        prompt.Style = Enum.ProximityPromptStyle.Custom
        prompt:SetAttribute("IngredientPickupPrompt", true)
        prompt.ObjectText = record.Id
        local connection = prompt.Triggered:Connect(function(player)
            services.InventoryService.CarryWorldItem(player, object)
        end)
        return function()
            connection:Disconnect()
            prompt:Destroy()
        end
    end)
end
return IngredientPickup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">IngredientSpawn</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local IngredientSpawn = {}
local bound: { [Instance]: boolean } = {}

-- Also used by the Edit-mode authoring utility. Keep authored local orientation.
function IngredientSpawn.GetSpawnCFrame(marker: BasePart): CFrame
    return marker.CFrame * CFrame.new(0, marker.Size.Y / 2 + 3, 0)
end

-- Both marker types share the same one-item lifecycle. The callback is output only.
function IngredientSpawn.Bind(services: any, tag: string, onSpawn: ((Instance, string) -> ())?)
    WorldUtil.BindTag(tag, function(station)
        if bound[station] then
            warn("[IngredientSpawn] Use only one spawn tag: " .. station:GetFullName())
            return nil
        end
        if not station:IsA("BasePart") then
            warn("[IngredientSpawn] Tag a BasePart: " .. station:GetFullName())
            return nil
        end
        local id = station:GetAttribute("IngredientId")
        if typeof(id) ~= "string" or not services.IngredientService.GetDefinition(id) then
            warn("[IngredientSpawn] Set a valid IngredientId: " .. station:GetFullName())
            return nil
        end
        local configuredSeconds = station:GetAttribute("RespawnSeconds")
        local seconds: number = 5
        if
            typeof(configuredSeconds) == "number"
            and configuredSeconds == configuredSeconds
            and configuredSeconds > 0
            and configuredSeconds < math.huge
        then
            seconds = configuredSeconds
        end
        local minSeconds = seconds
        local maxSeconds = seconds
        if onSpawn then
            local low = station:GetAttribute("MinRespawnSeconds")
            local high = station:GetAttribute("MaxRespawnSeconds")
            if
                typeof(low) == "number"
                and typeof(high) == "number"
                and low > 0
                and high >= low
                and high < math.huge
            then
                minSeconds = low
                maxSeconds = high
            end
        end

        bound[station] = true
        local stopped = false
        local active: Instance? = nil
        local pending: thread? = nil
        local itemConnections: { RBXScriptConnection } = {}
        local function disconnectItem()
            for _, connection in itemConnections do
                connection:Disconnect()
            end
            table.clear(itemConnections)
        end
        local function spawnItem()
            pending = nil
            if stopped or active or not station:IsDescendantOf(workspace) then
                return
            end
            local item = services.IngredientService.Spawn(
                id,
                IngredientSpawn.GetSpawnCFrame(station),
                nil,
                true,
                { FreezeUntilPickup = station:GetAttribute("FreezeSpawnedItem") == true }
            )
            if not item then
                return
            end
            active = item
            local function removed(destroying: boolean)
                if stopped or active ~= item then
                    return
                end
                active = nil
                disconnectItem()
                -- Retire a reparented item so returning it cannot duplicate station stock.
                if not destroying then
                    item:Destroy()
                end
                pending = task.delay(minSeconds + math.random() * (maxSeconds - minSeconds), spawnItem)
            end
            table.insert(
                itemConnections,
                item.Destroying:Connect(function()
                    removed(true)
                end)
            )
            if onSpawn then
                onSpawn(station, id)
            end
            table.insert(
                itemConnections,
                item.AncestryChanged:Connect(function()
                    if not item:IsDescendantOf(workspace) then
                        removed(false)
                    end
                end)
            )
        end
        local stationConnection: RBXScriptConnection? = nil
        local function cleanup()
            if stopped then
                return
            end
            stopped = true
            bound[station] = nil
            if pending then
                task.cancel(pending)
                pending = nil
            end
            if stationConnection then
                stationConnection:Disconnect()
            end
            disconnectItem()
            local item = active
            active = nil
            if item then
                item:Destroy()
            end
        end
        stationConnection = station.Destroying:Connect(cleanup)
        spawnItem()
        return cleanup
    end)
end

function IngredientSpawn.Init(services: any)
    IngredientSpawn.Bind(services, "IngredientSpawn", nil)
end

return IngredientSpawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">MarketPedestal</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local MarketPedestal = {}
function MarketPedestal.Init(services: any)
    WorldUtil.BindTag("MarketPedestal", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[MarketPedestal] Requires a BasePart")
            return nil
        end
        services.MarketService.Register(part)
        return function()
            services.MarketService.Unregister(part)
        end
    end)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed >= 1 then
            elapsed = 0
            services.MarketService.Step()
        end
    end)
end
return MarketPedestal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">SmoothiePickup</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local SmoothiePickup = {}
function SmoothiePickup.Init(services: any)
    WorldUtil.BindTag("SmoothieWorldItem", function(object)
        local record = services.SmoothieWorldItemService.GetData(object)
        local part = WorldUtil.Part(object)
        if not record or not part then
            return nil
        end
        local prompt = WorldUtil.Prompt(part, "SmoothieCarryPrompt", "Pickup")
        prompt.Style = Enum.ProximityPromptStyle.Custom
        prompt:SetAttribute("SmoothiePickupPrompt", true)
        prompt.ObjectText = "Smoothie"
        local connection = prompt.Triggered:Connect(function(player)
            services.InventoryService.CarryWorldSmoothie(player, object)
        end)
        return function()
            connection:Disconnect()
            prompt:Destroy()
        end
    end)
end
return SmoothiePickup
]]></string>
