        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Stash</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Presentation = require(script.Parent.StashPresentation)
local Stash = {}
function Stash.Init(services: any)
    WorldUtil.BindTag("PlayerStash", function(object)
        local slots: { [number]: BasePart } = {}
        local counts: { [number]: number } = {}
        for _, part in object:GetDescendants() do
            local index = part:GetAttribute("SlotIndex")
            if part:IsA("BasePart") and type(index) == "number" and index % 1 == 0 and index >= 1 and index <= 5 then
                counts[index] = (counts[index] or 0) + 1
                slots[index] = part
            end
        end
        local prompts = {}
        local connections = {}
        for index, slot in slots do
            if counts[index] ~= 1 then
                warn("[Stash] Duplicate SlotIndex: " .. index)
                slots[index] = nil
                continue
            end
            local prompt = WorldUtil.Prompt(slot, "StashPrompt", "Store ingredient")
            prompt:SetAttribute("PlayerStashPrompt", true)
            prompts[index] = prompt
            table.insert(
                connections,
                prompt.Triggered:Connect(function(player)
                    local owner = services.TycoonService.GetOwner(object)
                    services.InventoryService.InteractStash(player, index, owner)
                end)
            )
        end
        local function refresh()
            local owner = services.TycoonService.GetOwner(object)
            local snapshot = owner and services.InventoryService.GetSnapshot(owner)
            for index, slot in slots do
                local state = snapshot and snapshot.Stash[index]
                slot:SetAttribute("StashOwnerUserId", owner and owner.UserId or 0)
                Presentation.Refresh(slot, state, services.IngredientService)
                prompts[index].ObjectText = (if index <= 2 then "Protected slot " else "Slot ") .. index
                prompts[index].ActionText = if state and state.Count > 0
                    then (if state.ItemType == "Smoothie"
                        then "Take smoothie"
                        else "Take " .. state.IngredientId .. " (" .. state.Count .. "/5)")
                    else "Store ingredient"
            end
        end
        table.insert(
            connections,
            services.InventoryService.StashChanged:Connect(function()
                refresh()
            end)
        )
        -- Plot assignment and release also refresh empty fixtures for their new owner.
        local ancestor = object.Parent
        while ancestor and ancestor ~= workspace do
            table.insert(connections, ancestor:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh))
            ancestor = ancestor.Parent
        end
        refresh()
        return function()
            for _, connection in connections do
                connection:Disconnect()
            end
            for _, prompt in prompts do
                prompt:Destroy()
            end
            for _, slot in slots do
                Presentation.Clear(slot)
                for _, name in
                    {
                        "StashOwnerUserId",
                        "StashIngredientId",
                        "StashItemType",
                        "StashCapacity",
                        "StashCount",
                        "StashProtected",
                    }
                do
                    slot:SetAttribute(name, nil)
                end
            end
        end
    end)
end
return Stash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">StashPresentation</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetic Instances only: never register, spawn, or consume world inventory here.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local SmoothieGeometry = require(script.Parent.Parent.Services.SmoothieGeometry)
local Presentation = {}

-- Footprint and height are relative to the display plane's smaller dimension.
-- Size limits are in studs: clamp the target footprint, not the source scale,
-- so both tiny and huge templates can reach the same visible size.
local DisplayFootprintScale = 0.30
local DisplayMaxHeightScale = 0.90 -- Safety cap for unusually tall/thin meshes.
local DisplayMinSize = 0.25
local DisplayMaxSize = 4.0 -- Also caps height; height safety takes precedence.
local DisplayHeightOffset = 0.12
local DisplaySpacing = 1.08 -- Center-to-center spacing in item-size units.
local DisplayFifthLift = 0.65 -- Fifth item's extra height in item-size units.

-- Temporary: print geometry once for the first occupied Slot3 in Studio.
local DisplayDiagnostics = true
local DiagnosticSlotIndex = 3
local diagnosticPrinted = false

local function displaySurface(slot: BasePart)
    local axes = { slot.CFrame.RightVector, slot.CFrame.UpVector, slot.CFrame.LookVector * -1 }
    local sizes = { slot.Size.X, slot.Size.Y, slot.Size.Z }
    local names = { "X", "Y", "Z" }
    local normalIndex = 1
    for index = 2, 3 do
        if math.abs(axes[index]:Dot(Vector3.yAxis)) > math.abs(axes[normalIndex]:Dot(Vector3.yAxis)) then
            normalIndex = index
        end
    end
    local normal = axes[normalIndex]
    if normal:Dot(Vector3.yAxis) < 0 then
        normal *= -1
    end
    local widthIndex = if normalIndex == 1 then 2 else 1
    local depthIndex = 6 - normalIndex - widthIndex
    local tangent = axes[widthIndex]
    -- Complete a right-handed frame with local Y pointing out of the top face.
    -- The second tangent is the remaining slot axis, with the appropriate sign.
    local depthTangent = tangent:Cross(normal)
    local thickness = sizes[normalIndex]
    local topCenter = slot.Position + normal * (thickness / 2)
    return CFrame.fromMatrix(topCenter, tangent, normal, depthTangent),
        sizes[widthIndex],
        sizes[depthIndex],
        thickness,
        names[normalIndex]
end

-- Display-plane X/Z layouts, centered around their horizontal centroid.
local Layouts = {
    { Vector3.new(0, 0, 0) },
    { Vector3.new(-0.5, 0, 0), Vector3.new(0.5, 0, 0) },
    { Vector3.new(-0.5, 0, 1 / 3), Vector3.new(0.5, 0, 1 / 3), Vector3.new(0, 0, -2 / 3) },
    { Vector3.new(-0.5, 0, -0.5), Vector3.new(0.5, 0, -0.5), Vector3.new(-0.5, 0, 0.5), Vector3.new(0.5, 0, 0.5) },
    -- Move the four lower items forward slightly to balance the raised back item.
    {
        Vector3.new(-0.5, 0, -0.4),
        Vector3.new(0.5, 0, -0.4),
        Vector3.new(-0.5, 0, 0.6),
        Vector3.new(0.5, 0, 0.6),
        Vector3.new(0, 0, -0.4),
    },
}
function Presentation.Clear(slot: BasePart)
    local old = slot:FindFirstChild("StashDisplay")
    if old then
        old:Destroy()
    end
end
function Presentation.Refresh(slot: BasePart, state: any, ingredients: any)
    Presentation.Clear(slot)
    slot:SetAttribute("StashIngredientId", state and state.IngredientId)
    slot:SetAttribute("StashItemType", state and state.ItemType)
    slot:SetAttribute("StashCapacity", state and state.Capacity or 5)
    slot:SetAttribute("StashCount", state and state.Count or 0)
    slot:SetAttribute("StashProtected", state and state.Protected or slot:GetAttribute("SlotIndex") <= 2)
    if not state or state.Count == 0 or (not state.IngredientId and not state.Smoothie) then
        return
    end
    local folder = Instance.new("Folder")
    folder.Name = "StashDisplay"
    folder.Parent = slot
    local surface, width, depth, thickness, normalAxis = displaySurface(slot)
    local slotSize = math.min(width, depth)
    local itemSize = math.clamp(slotSize * DisplayFootprintScale, DisplayMinSize, DisplayMaxSize)
    local maxHeight = math.min(slotSize * DisplayMaxHeightScale, DisplayMaxSize)
    local shouldPrintDiagnostic = DisplayDiagnostics
        and not diagnosticPrinted
        and RunService:IsStudio()
        and slot:GetAttribute("SlotIndex") == DiagnosticSlotIndex
    local spacing = itemSize * DisplaySpacing
    local layout = Layouts[state.Count]
    for i = 1, state.Count do
        local proxy = if state.ItemType == "Smoothie"
            then SmoothieGeometry.CreateVisual(state.Smoothie)
            else ingredients.CreateVisual(state.IngredientId)
        if not proxy then
            continue
        end
        local descendants = proxy:GetDescendants()
        table.insert(descendants, proxy)
        for _, child in descendants do
            for _, tag in CollectionService:GetTags(child) do
                CollectionService:RemoveTag(child, tag)
            end
            child:SetAttribute("SlotIndex", nil)
            child:SetAttribute("WorldItemId", nil)
            child:SetAttribute("IngredientId", nil)
            child:SetAttribute("OwnerUserId", nil)
            if child:IsA("ProximityPrompt") or child:IsA("ClickDetector") or child:IsA("LuaSourceContainer") then
                child:Destroy()
            elseif child:IsA("BasePart") then
                child.PivotOffset = CFrame.new()
                child.Anchored = true
                child.CanCollide = false
                child.CanQuery = false
                child.CanTouch = false
            end
        end
        -- Remove the source pivot's translation/orientation before measuring.
        -- A fresh wrapper with no PrimaryPart gives all templates the same axes.
        local physical = proxy :: any
        physical:PivotTo(CFrame.new())
        local model = Instance.new("Model")
        model.Name = "DisplayIngredient"
        model.WorldPivot = CFrame.new()
        proxy.Parent = model
        local bounds, size = model:GetBoundingBox()
        -- Center the wrapper pivot on actual geometry, independent of authored
        -- pivots. Uniform scaling can enlarge small templates as well as shrink.
        model.WorldPivot = bounds
        -- The identity-oriented wrapper's X/Z axes become the display plane's
        -- X/Z axes at placement, so these bounds already reflect display orientation.
        local footprint = math.max(size.X, size.Z)
        local scaleFactor = math.min(itemSize / math.max(footprint, 0.000001), maxHeight / math.max(size.Y, 0.000001))
        model:ScaleTo(scaleFactor)
        local _, scaled = model:GetBoundingBox()
        if shouldPrintDiagnostic and not diagnosticPrinted then
            diagnosticPrinted = true
            print(
                string.format(
                    "[StashPresentation] %s Size=%s normalAxis=%s thickness=%.3f usableWidth=%.3f usableDepth=%.3f originalBounds=%s horizontalFootprint=%.6f targetFootprint=%.3f scaleFactor=%.6g scaledBounds=%s topSurfaceCenter=%s",
                    slot:GetFullName(),
                    tostring(slot.Size),
                    normalAxis,
                    thickness,
                    width,
                    depth,
                    tostring(size),
                    footprint,
                    itemSize,
                    scaleFactor,
                    tostring(scaled),
                    tostring(surface.Position)
                )
            )
        end
        local offset = layout[i] * spacing
        local lift = if i == 5 then itemSize * DisplayFifthLift else 0
        local target = surface * CFrame.new(offset.X, DisplayHeightOffset + scaled.Y / 2 + lift, offset.Z)
        model:PivotTo(target)
        model.Parent = folder
    end
end
return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">TurbineWheel</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local AudioService = require(script.Parent.Parent.Services.AudioService)
local PhysicsService = require(script.Parent.Parent.Services.PhysicsService)
local TurbineWheel = {}
function TurbineWheel.Init(services: any)
    WorldUtil.BindTag("TurbineWheel", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[TurbineWheel] Requires a blade/stem BasePart")
            return nil
        end
        -- if part:CanSetNetworkOwnership() then
        --     part:SetNetworkOwner(nil)
        -- end
        local audio = AudioService.CreateBlendGroup(part)
        audio.blendSound:Play()
        local particles = Instance.new("ParticleEmitter")
        particles.Rate = 0
        particles.Speed = NumberRange.new(5, 10)
        particles.Parent = part
        local wasComplete = false
        local heartbeat = RunService.Heartbeat:Connect(function(dt)
            local owner = services.TycoonService.GetOwner(part)
            if owner then
                services.BlendService.AddProgress(owner, part, PhysicsService.GetBlendDelta(part, dt))
            end
            local snapshot = owner and services.BlendService.GetSnapshot(owner)
            local state = snapshot and snapshot.State or "EMPTY"
            local strength = if state == "BLENDING" then PhysicsService.GetSpinStrength(part) else 0
            AudioService.UpdateBlendGroup(audio, strength)
            particles.Rate = strength * 2
            if snapshot and snapshot.Result then
                particles.Color = ColorSequence.new(snapshot.Result.Color)
            end
            if state == "COMPLETE" and not wasComplete then
                audio.dingSound:Play()
            end
            wasComplete = state == "COMPLETE"
        end)
        return function()
            heartbeat:Disconnect()
            particles:Destroy()
            for _, sound in audio do
                sound:Destroy()
            end
        end
    end)
end
return TurbineWheel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">AudioService</string>
            <string name="Source"><![CDATA[--!strict
local AudioService = {}

local DIALOGUE_SOUND_IDS = {
    "rbxassetid://218057428",
    "rbxassetid://218057436",
    "rbxassetid://218057416",
}

function AudioService.ConstructAudioCue(parent: Instance, soundId: string, volume: number, looped: boolean?): Sound
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = volume
    sound.Looped = looped or false
    sound.RollOffMaxDistance = 50
    sound.RollOffMinDistance = 10
    sound.Parent = parent
    return sound
end

function AudioService.CreateBlendGroup(parent: Instance): { [string]: Sound }
    local blendSound = AudioService.ConstructAudioCue(parent, "rbxassetid://365965609", 0, true)
    local dingSound = AudioService.ConstructAudioCue(parent, "rbxassetid://110253665387820", 1, false)
    local pourSound = AudioService.ConstructAudioCue(parent, "rbxassetid://9114612188", 1, false)
    local notReadySound = AudioService.ConstructAudioCue(parent, "rbxassetid://90524619811521", 1, false)
    local customerServeSound = AudioService.ConstructAudioCue(parent, "rbxassetid://135165335432475", 1, false)
    -- randomize dialogue chirp
    local dialogueSoundId = DIALOGUE_SOUND_IDS[math.random(1, #DIALOGUE_SOUND_IDS)]
    local dialogueSound = AudioService.ConstructAudioCue(parent, dialogueSoundId, 1, false)

    return {
        blendSound = blendSound,
        dingSound = dingSound,
        pourSound = pourSound,
        notReadySound = notReadySound,
        customerServeSound = customerServeSound,
        dialogueSound = dialogueSound,
    }
end

-- Dynamically adjust volume based on the blades RPM / blend strength.
function AudioService.UpdateBlendGroup(group: { blendSound: Sound }, blendStrength: number)
    local targetVolume = math.clamp(blendStrength / 20, 0, 1)
    group.blendSound.Volume = targetVolume
    group.blendSound.PlaybackSpeed = 0.5 + (blendStrength / 25)
end

return AudioService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">BlendService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local HttpService = game:GetService("HttpService")
local Economy = require(Shared.Constants.Economy)
local Types = require(Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local Film = require(script.Parent.FilmingUtil)
local SmoothieItem = require(script.Parent.SmoothieItem)
local BlendService = {}
local deps: any
local ingredientAccepted = Instance.new("BindableEvent")
local RunService = game:GetService("RunService")
local observers: { RBXScriptConnection } = {}
local nextNotificationToken = 0
local function observerCount(): number
    for index = #observers, 1, -1 do
        if not observers[index].Connected then
            table.remove(observers, index)
        end
    end
    return #observers
end
local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[BlendService] " .. message)
    end
end

-- One canonical color calculation for both the developing liquid and final cup.
local function batchColor(ids: { string }): Color3?
    if #ids == 0 then
        return nil
    end
    local sum = Vector3.zero
    for _, id in ids do
        local color = deps.IngredientService.GetDefinition(id).BlendColor
        sum += Vector3.new(color.R, color.G, color.B)
    end
    sum /= #ids
    return Color3.new(sum.X, sum.Y, sum.Z)
end

type Batch = {
    NotificationToken: number,
    State: Types.BlendState,
    Ingredients: { string },
    Progress: number,
    Result: Types.Smoothie?,
    NextProgressPresentationAt: number,
    NextRejectionAt: number,
    Dispensing: boolean,
}
local batches: { [Player]: Batch } = {}

function BlendService.ObserveIngredientAccepted(callback: (Player, string, CFrame, number) -> ()): RBXScriptConnection
    local connection = ingredientAccepted.Event:Connect(function(player, id, at, index, token)
        -- BindableEvents COPY tables. Compare a scalar token, never table identity.
        local batch = batches[player]
        if batch and batch.NotificationToken == token then
            callback(player, id, at, index)
        else
            diagnostic("accepted notify skipped stale batch ingredient=" .. id)
        end
    end)
    table.insert(observers, connection)
    diagnostic("ingredient observer connected observers=" .. tostring(observerCount()))
    return connection
end

local function publish(player: Player)
    local batch = batches[player]
    player:SetAttribute("BlendColor", if batch.Result then batch.Result.Color else batchColor(batch.Ingredients))
    player:SetAttribute("BlendState", batch.State)
    player:SetAttribute("BlendProgress", batch.Progress)
    player:SetAttribute("BlendIngredientCount", #batch.Ingredients)
    if batch.State == "EMPTY" or #batch.Ingredients >= Economy.MaxIngredients then
        player:SetAttribute("BlendNeedsItems", false)
    end
end
local function copyResult(result: Types.Smoothie): Types.Smoothie
    return {
        BlendId = result.BlendId,
        Ingredients = table.clone(result.Ingredients),
        Tags = table.clone(result.Tags),
        Color = result.Color,
        Discovery = result.Discovery,
    }
end
function BlendService.Init(services)
    deps = services
end
function BlendService.Reset(player: Player)
    nextNotificationToken += 1
    batches[player] = {
        NotificationToken = nextNotificationToken,
        State = "EMPTY",
        Ingredients = {},
        Progress = 0,
        Result = nil,
        NextProgressPresentationAt = 0,
        NextRejectionAt = 0,
        Dispensing = false,
    }
    publish(player)
    Film.Log("Blend", "reset")
end
function BlendService.GetSnapshot(player: Player): {
    State: Types.BlendState,
    Ingredients: { string },
    Progress: number,
    Result: Types.Smoothie?,
}?
    local batch = batches[player]
    if not batch then
        return nil
    end
    return {
        State = batch.State,
        Ingredients = table.clone(batch.Ingredients),
        Progress = batch.Progress,
        Result = if batch.Result then copyResult(batch.Result) else nil,
    }
end
function BlendService.TryInput(player: Player, object: Instance, input: BasePart): boolean
    local batch = batches[player]
    local record = deps.IngredientService.GetRecord(object)
    local part = WorldUtil.Part(object)
    if
        not batch
        or (batch.State ~= "EMPTY" and batch.State ~= "LOADING" and batch.State ~= "READY")
        or #batch.Ingredients >= Economy.MaxIngredients
        or not record
        or object:GetAttribute("FrozenUntilPickup") == true
        or (record.Owner ~= nil and record.Owner ~= player)
        or (record.Owner == nil and not record.Claimable)
        or not part
        or deps.TycoonService.GetOwner(input) ~= player
        or deps.TycoonService.GetReference(player, "BlenderInput") ~= input
    then
        return false
    end
    -- Check actual overlap on the server, not only a client-influenced Touched signal.
    local overlaps = false
    for _, touching in workspace:GetPartsInPart(input) do
        if deps.IngredientService.Resolve(touching) == object then
            overlaps = true
            break
        end
    end
    if not overlaps then
        return false
    end
    local acceptedAt = part.CFrame
    local id = deps.IngredientService.Consume(object)
    if not id then
        return false
    end
    table.insert(batch.Ingredients, id)
    Film.Log("Blend", string.format("%s accepted (%d/3)", id, #batch.Ingredients))
    batch.State = if #batch.Ingredients == Economy.MaxIngredients then "READY" else "LOADING"
    publish(player)
    Film.Log("Blend", batch.State)
    diagnostic("accepted notify ingredient=" .. id .. " observers=" .. tostring(observerCount()))
    ingredientAccepted:Fire(player, id, acceptedAt, #batch.Ingredients, batch.NotificationToken)
    return true
end
function BlendService.Ready(player: Player): boolean
    local batch = batches[player]
    if
        not batch
        or #batch.Ingredients < Economy.MaxIngredients
        or (batch.State ~= "LOADING" and batch.State ~= "READY")
    then
        return false
    end
    batch.State = "READY"
    publish(player)
    Film.Log("Blend", "READY")
    return true
end
local function makeResult(ids: { string }): Types.Smoothie
    local tags = {}
    for _, id in ids do
        local definition = deps.IngredientService.GetDefinition(id)
        for _, tag in definition.Tags do
            if not table.find(tags, tag) then
                table.insert(tags, tag)
            end
        end
    end
    return {
        BlendId = HttpService:GenerateGUID(false),
        Ingredients = table.clone(ids),
        Tags = tags,
        Color = batchColor(ids) :: Color3,
        -- Retained for compatibility with existing smoothie consumers.
        Discovery = nil,
    }
end
-- Server Heartbeat reports measured physical spin. No progress remote exists.
function BlendService.AddProgress(player: Player, wheel: BasePart, delta: number): boolean
    local batch = batches[player]
    if
        not batch
        or deps.TycoonService.GetOwner(wheel) ~= player
        or delta ~= delta
        or delta <= 0
        or delta == math.huge
    then
        return false
    end
    -- This private count is the source of BlendIngredientCount. Never authorize
    -- a start from replicated attributes or mutate an underfilled batch.
    if #batch.Ingredients < Economy.MaxIngredients then
        if
            (batch.State == "EMPTY" or batch.State == "LOADING" or batch.State == "READY")
            and os.clock() >= batch.NextRejectionAt
        then
            -- Heartbeat must not continually extend the transient feedback.
            batch.NextRejectionAt = os.clock() + 2.5
            local rejectionAt = batch.NextRejectionAt
            player:SetAttribute("BlendNeedsItems", true)
            task.delay(1.75, function()
                if batches[player] == batch and batch.NextRejectionAt == rejectionAt then
                    player:SetAttribute("BlendNeedsItems", false)
                end
            end)
        end
        return false
    end
    if batch.State == "LOADING" then
        BlendService.Ready(player)
    end
    if batch.State ~= "READY" and batch.State ~= "BLENDING" then
        return false
    end
    if batch.State == "READY" then
        batch.State = "BLENDING"
        publish(player)
        Film.Emit(player, "BlendStarted", { IngredientIds = table.clone(batch.Ingredients) })
        Film.Log("Blend", "BLENDING")
    end
    local oldProgress = batch.Progress
    batch.Progress = math.min(Economy.RequiredProgress, batch.Progress + delta)
    local now = os.clock()
    if
        batch.Progress > oldProgress
        and (now >= batch.NextProgressPresentationAt or batch.Progress >= Economy.RequiredProgress)
    then
        batch.NextProgressPresentationAt = now + 0.1
        Film.Emit(player, "BlendProgressChanged", { Progress = batch.Progress })
    end
    if math.floor(oldProgress / 10) ~= math.floor(batch.Progress / 10) then
        Film.Log("Blend", string.format("progress %.0f", batch.Progress))
    end
    if batch.Progress >= Economy.RequiredProgress then
        batch.State = "COMPLETE"
        local result = makeResult(batch.Ingredients)
        batch.Result = result
        Film.Emit(player, "BlendCompleted", {
            BlendId = result.BlendId,
            Color = result.Color,
            IngredientIds = table.clone(result.Ingredients),
            RecipeId = result.Discovery,
        })
        Film.Log(
            "Blend",
            string.format("COMPLETE color=(%.3f,%.3f,%.3f)", result.Color.R, result.Color.G, result.Color.B)
        )
        deps.PlayerDataService.IncrementStat(player, "SmoothiesMade")
    end
    publish(player)
    return true
end
function BlendService.GetCup(player: Player, requested: Instance?): Types.Smoothie?
    local data = deps.InventoryService.GetHeldSmoothie(player, requested)
    return if data then SmoothieItem.Result(data) else nil
end
function BlendService.ConsumeCup(player: Player): Types.Smoothie?
    local data = deps.InventoryService.ConsumeHeldSmoothie(player)
    return if data then SmoothieItem.Result(data) else nil
end
function BlendService.Dispense(player: Player, button: BasePart): (boolean, string?)
    local batch = batches[player]
    if not batch or batch.State ~= "COMPLETE" or not batch.Result or batch.Dispensing then
        return false, "Not ready"
    end
    if
        deps.TycoonService.GetOwner(button) ~= player
        or not WorldUtil.Near(player, button, Economy.InteractionDistance)
    then
        return false, "Not your blender or too far"
    end
    if deps.InventoryService.GetCarryCount(player) >= deps.InventoryService.GetCarryCapacity(player) then
        return false, "Inventory full"
    end
    local data: Types.SmoothieData = {
        BlendId = batch.Result.BlendId :: string,
        Ingredients = table.clone(batch.Result.Ingredients),
    }
    -- Grant is synchronous. Guard signals from equip/presentation against a
    -- reentrant dispense of this same batch, including while it is still COMPLETE.
    batch.Dispensing = true
    local granted = deps.InventoryService.GrantSmoothie(player, data)
    batch.Dispensing = false
    if not granted then
        return false, "Cannot carry smoothie"
    end
    batch.State = "DISPENSED"
    publish(player)
    task.defer(function()
        if batches[player] == batch then
            BlendService.Reset(player)
        end
    end)
    Film.Emit(player, "SmoothieDispensed", { BlendId = data.BlendId, Color = batch.Result.Color })
    Film.Log("Blend", "DISPENSED blend=" .. data.BlendId)
    return true
end
function BlendService.RemovePlayer(player: Player)
    batches[player] = nil
end
return require(script.Parent.StudioServices).Wrap("BlendService", BlendService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">BlenderVacuumPhysics</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BlenderVacuum)
local Physics = {}

local function clampMagnitude(value: Vector3, limit: number): Vector3
    return if value.Magnitude > limit then value.Unit * limit else value
end

function Physics.Steer(velocity: Vector3, position: Vector3, target: Vector3, radius: number, dt: number): Vector3
    local offset = target - position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    local proximity = 1 - math.clamp(horizontal.Magnitude / math.max(radius, 0.01), 0, 1)
    local strength = Config.EdgeStrength + (1 - Config.EdgeStrength) * proximity
    local desired =
        clampMagnitude(horizontal * Config.CenteringStrength + Vector3.new(0, -Config.DownwardBias, 0), Config.MaxSpeed)
    local step = math.clamp(dt, 0, Config.MaxStep)
    local delta = (desired - velocity) * (1 - math.exp(-Config.PullStrength * strength * step))
    return velocity + clampMagnitude(delta, Config.MaxAcceleration * step)
end

return Physics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">CharacterPhysicsService</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local CharacterPhysicsService = {}

-- Enable before spawning in Studio; never prints in live servers.
local DEBUG = true
local ROOT_SIZE = Vector3.new(2, 2, 1)
-- 4 cubic studs * density 4 = 16 mass units, independent of avatar mesh volume.
local ROOT_PHYSICS = PhysicalProperties.new(4, 0.3, 0, 1, 1)
local BODY_PHYSICS = PhysicalProperties.new(0.7, 0.3, 0, 1, 1)
local BODY_NAMES: { [string]: boolean } = {}
for _, name in
    {
        "Head",
        "UpperTorso",
        "LowerTorso",
        "LeftUpperArm",
        "LeftLowerArm",
        "LeftHand",
        "RightUpperArm",
        "RightLowerArm",
        "RightHand",
        "LeftUpperLeg",
        "LeftLowerLeg",
        "LeftFoot",
        "RightUpperLeg",
        "RightLowerLeg",
        "RightFoot",
        "Torso",
        "Left Arm",
        "Right Arm",
        "Left Leg",
        "Right Leg",
    }
do
    BODY_NAMES[name] = true
end
type State = { Character: Model, Connections: { RBXScriptConnection }, Started: boolean }
local states: { [Player]: State } = {}

function CharacterPhysicsService.RemovePlayer(player: Player)
    local state = states[player]
    if state then
        for _, connection in state.Connections do
            connection:Disconnect()
        end
        states[player] = nil
    end
end

-- Called by bootstrap's existing CharacterAdded path; appearance loading must finish
-- before reading its description, otherwise Roblox can overwrite the scales later.
function CharacterPhysicsService.ApplyCharacter(player: Player, character: Model)
    if states[player] and states[player].Character == character then
        return
    end
    CharacterPhysicsService.RemovePlayer(player)
    local state: State = { Character = character, Connections = {}, Started = false }
    states[player] = state
    local function current(): boolean
        return states[player] == state and player.Character == character
    end
    local function normalizePart(instance: Instance)
        if not current() or not instance:IsA("BasePart") or not instance:IsDescendantOf(character) then
            return
        end
        -- Only avatar body parts and cosmetics are ours. Tools and server-authored
        -- gameplay parts retain their own physics, including nested Tool parts.
        if instance:FindFirstAncestorWhichIsA("Tool") then
            return
        end
        local accessory = instance:FindFirstAncestorWhichIsA("Accessory")
        if accessory and accessory.Parent == character then
            if accessory:GetAttribute("PreserveGameplayPhysics") == true then
                return
            end
            instance.Massless = true
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
            instance.RootPriority = -127
        elseif instance.Parent == character and instance.Name == "HumanoidRootPart" then
            instance.Size = ROOT_SIZE
            instance.Massless = false
            instance.RootPriority = 127
            instance.CustomPhysicalProperties = ROOT_PHYSICS
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = true
        elseif instance.Parent == character and BODY_NAMES[instance.Name] then
            instance.Massless = true
            instance.RootPriority = 0
            instance.CustomPhysicalProperties = BODY_PHYSICS
            -- Retain Roblox's body collision/state-machine behavior. In particular,
            -- collidable torso/head parts must keep physically driving the turbine.
            -- Forcing limb collisions adds snagging; disabling torso collisions removes pushing.
        end
    end
    local function scan()
        for _, instance in character:GetDescendants() do
            normalizePart(instance)
        end
    end
    table.insert(
        state.Connections,
        character.DescendantAdded:Connect(function(instance)
            -- Defer until a newly inserted accessory's hierarchy is fully parented.
            task.defer(normalizePart, instance)
        end)
    )
    table.insert(
        state.Connections,
        player.CharacterRemoving:Connect(function(removing)
            if removing == character and states[player] == state then
                CharacterPhysicsService.RemovePlayer(player)
            end
        end)
    )
    scan()

    local function finish(appearanceSource: string)
        if not current() or state.Started then
            return
        end
        state.Started = true
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            local root = character:WaitForChild("HumanoidRootPart", 10)
            if not current() then
                return
            end
            if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") then
                warn("[CharacterPhysics] Missing Humanoid/root for " .. player.Name)
                return
            end
            if humanoid.RigType == Enum.HumanoidRigType.R15 then
                local ok, problem = pcall(function()
                    local description = humanoid:GetAppliedDescription()
                    -- Keep the loaded avatar's assets/cosmetics, but remove the
                    -- taller/slender body morph independently of dimensional scale.
                    -- Head is a collidable body part: its scale affects clearance too.
                    local changed = description.HeightScale ~= 1
                        or description.WidthScale ~= 1
                        or description.DepthScale ~= 1
                        or description.HeadScale ~= 1
                        or description.BodyTypeScale ~= 0
                        or description.ProportionScale ~= 0
                    description.HeightScale = 1
                    description.WidthScale = 1
                    description.DepthScale = 1
                    description.HeadScale = 1
                    description.BodyTypeScale = 0
                    description.ProportionScale = 0
                    humanoid.AutomaticScalingEnabled = true
                    if changed then
                        -- At most one application per spawn. No heartbeat reapplication.
                        local applied, reason = pcall(function()
                            humanoid:ApplyDescriptionAsync(description)
                        end)
                        description:Destroy()
                        if not applied then
                            error(tostring(reason))
                        end
                    else
                        description:Destroy()
                    end
                end)
                if not ok and current() then
                    warn(
                        "[CharacterPhysics] Scale normalization failed for " .. player.Name .. ": " .. tostring(problem)
                    )
                end
            end
            -- R6 receives mass/accessory handling but no R15 scaling or rig conversion.
            if not current() then
                return
            end
            scan() -- Description application can resize the root and replace body parts.
            -- Read back after the yielding application and a simulation step, not
            -- from the requested description. Never reapply in response to this check.
            RunService.Heartbeat:Wait()
            if not current() then
                return
            end
            if DEBUG and RunService:IsStudio() then
                local count = 0
                for _, instance in character:GetDescendants() do
                    if instance:IsA("BasePart") then
                        local accessory = instance:FindFirstAncestorWhichIsA("Accessory")
                        if
                            accessory
                            and accessory.Parent == character
                            and not instance:FindFirstAncestorWhichIsA("Tool")
                            and accessory:GetAttribute("PreserveGameplayPhysics") ~= true
                        then
                            count += 1
                        end
                    end
                end
                local function scale(name: string): string
                    local value = humanoid:FindFirstChild(name)
                    return if value and value:IsA("NumberValue") then tostring(value.Value) else "n/a"
                end
                local appliedRoot = character:FindFirstChild("HumanoidRootPart")
                if appliedRoot and appliedRoot:IsA("BasePart") then
                    local _, boundingSize = character:GetBoundingBox()
                    local final = humanoid:GetAppliedDescription()
                    local finalScales = if humanoid.RigType == Enum.HumanoidRigType.R15
                        then string.format(
                            "HeightScale=%.3f WidthScale=%.3f DepthScale=%.3f HeadScale=%.3f BodyTypeScale=%.3f ProportionScale=%.3f",
                            final.HeightScale,
                            final.WidthScale,
                            final.DepthScale,
                            final.HeadScale,
                            final.BodyTypeScale,
                            final.ProportionScale
                        )
                        else "R6 scales=n/a"
                    final:Destroy()
                    print(
                        string.format(
                            "[CharacterPhysics] FINAL player=%s rig=%s appearance=%s description={%s} liveScales(H/W/D/Head/Type/Proportion)=%s/%s/%s/%s/%s/%s boundingSize=%s rootMass=%.3f assemblyMass=%.3f cosmeticParts=%d",
                            player.Name,
                            humanoid.RigType.Name,
                            appearanceSource,
                            finalScales,
                            scale("BodyHeightScale"),
                            scale("BodyWidthScale"),
                            scale("BodyDepthScale"),
                            scale("HeadScale"),
                            scale("BodyTypeScale"),
                            scale("BodyProportionScale"),
                            tostring(boundingSize),
                            appliedRoot:GetMass(),
                            appliedRoot.AssemblyMass,
                            count
                        )
                    )
                end
            end
        end)
    end
    table.insert(
        state.Connections,
        player.CharacterAppearanceLoaded:Connect(function(loaded)
            if loaded == character then
                finish("CharacterAppearanceLoaded")
            end
        end)
    )
    -- Connect first, then check: covers appearances loaded before bootstrap as well
    -- as the event/check race. Started is set before yielding to prevent duplicates.
    if player:HasAppearanceLoaded() then
        finish("HasAppearanceLoaded")
    elseif not player.LoadCharacterAppearance then
        finish("LoadCharacterAppearance=false")
    end
end

return CharacterPhysicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local WorldUtil = require(script.Parent.WorldUtil)
local CombatService = {}
local deps: any
local attackAt: { [Player]: number } = {}
local dropAt: { [Player]: number } = {}
local stunAt: { [Player]: number } = {}
local hands: { [Player]: Tool } = {}
function CombatService.Init(services)
    deps = services
end
function CombatService.Slap(player: Player, victim: Player): boolean
    local now = os.clock()
    local hand = hands[player]
    local target = victim.Character
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
    local humanoid = target and target:FindFirstChildOfClass("Humanoid")
    if
        player == victim
        or not hand
        or hand.Parent ~= player.Character
        or not root
        or not root:IsA("BasePart")
        or not targetRoot
        or not targetRoot:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0
        or not WorldUtil.Near(player, targetRoot, Economy.SlapRange)
        or now < (attackAt[player] or 0)
        or now < (tonumber(player:GetAttribute("StunnedUntil")) or 0)
    then
        return false
    end
    local direction = targetRoot.Position - root.Position
    if direction.Magnitude < 0.01 or root.CFrame.LookVector:Dot(direction.Unit) < 0 then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character :: Model }
    local obstruction = workspace:Raycast(root.Position, direction, params)
    if obstruction and not obstruction.Instance:IsDescendantOf(target :: Model) then
        return false
    end
    attackAt[player] = now + Economy.SlapCooldown
    local level = Upgrades.Hand[deps.PlayerDataService.GetUpgrade(player, "Hand")]
    local handle = hand:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        handle.Size = Vector3.new(2, 2, 0.5) * level.Size
    end
    humanoid:TakeDamage(level.Damage)
    targetRoot:ApplyImpulse((direction.Unit * level.Knockback + Vector3.new(0, 8, 0)) * targetRoot.AssemblyMass)
    if now >= (stunAt[victim] or 0) then
        victim:SetAttribute("StunnedUntil", now + Economy.StunSeconds)
        stunAt[victim] = now + Economy.StunSeconds + 1
    end
    if now >= (dropAt[victim] or 0) then
        deps.InventoryService.DropOne(victim)
        dropAt[victim] = now + Economy.DropProtection
    end
    deps.PlayerDataService.IncrementStat(player, "PlayersSlapped")
    return true
end
-- Optional server-issued placeholder weapon. No arbitrary Tool name grants attack rights.
function CombatService.GrantHand(player: Player): Tool?
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then
        return nil
    end
    if hands[player] then
        hands[player]:Destroy()
    end
    local tool = Instance.new("Tool")
    tool.Name = "SlapHand"
    tool.CanBeDropped = false
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(2, 2, 0.5)
    handle.Color = Color3.fromRGB(255, 210, 140)
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool
    hands[player] = tool
    tool.Activated:Connect(function()
        local closest: Player? = nil
        local distance = Economy.SlapRange
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") then
            return
        end
        for _, victim in Players:GetPlayers() do
            local target = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart")
            if victim ~= player and target and target:IsA("BasePart") then
                local separation = (target.Position - root.Position).Magnitude
                if separation < distance then
                    distance = separation
                    closest = victim
                end
            end
        end
        if closest then
            CombatService.Slap(player, closest)
        end
    end)
    tool.Parent = backpack
    return tool
end
function CombatService.RemovePlayer(player: Player)
    if hands[player] then
        hands[player]:Destroy()
    end
    hands[player] = nil
    attackAt[player] = nil
    dropAt[player] = nil
    stunAt[player] = nil
end
return require(script.Parent.StudioServices).Wrap("CombatService", CombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">CustomerPlacement</string>
            <string name="Source"><![CDATA[--!strict
-- Markers describe ground surfaces, not avatar pivot heights.
local CustomerPlacement = {}

function CustomerPlacement.BottomOffset(model: Model): number
    local bounds, size = model:GetBoundingBox()
    local halfHeight = (
        math.abs(bounds.RightVector.Y) * size.X
        + math.abs(bounds.UpVector.Y) * size.Y
        + math.abs(bounds.LookVector.Y) * size.Z
    ) / 2
    local offset = model:GetAttribute("CustomerVerticalOffset")
    local extra = if type(offset) == "number" and offset == offset and math.abs(offset) < math.huge then offset else 0
    return model:GetPivot().Position.Y - (bounds.Position.Y - halfHeight) + extra
end

function CustomerPlacement.AtMarker(marker: BasePart, bottomOffset: number): CFrame
    -- Top surface at the marker's center X/Z. Author upright, horizontal route markers.
    local position = marker.CFrame.Position
    local grounded = Vector3.new(position.X, position.Y + marker.Size.Y / 2 + bottomOffset, position.Z)
    return CustomerPlacement.Face(grounded, grounded + marker.CFrame.LookVector, marker.CFrame)
end

function CustomerPlacement.Face(position: Vector3, target: Vector3, fallback: CFrame): CFrame
    local direction = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
    if direction.Magnitude < 0.0001 then
        direction = Vector3.new(fallback.LookVector.X, 0, fallback.LookVector.Z)
        if direction.Magnitude < 0.0001 then
            direction = Vector3.new(0, 0, -1)
        end
    end
    return CFrame.lookAt(position, position + direction)
end

return CustomerPlacement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">CustomerPresentation</string>
            <string name="Source"><![CDATA[--!strict
local CustomerPresentation = {}

local RESULT_DURATION = 4
local RESULT_GAP = 6
local RESULT_DROP = 32
local GRADE_COLORS: { [string]: string } = {
    A = "rgb(100,225,120)",
    B = "rgb(100,170,255)",
    C = "rgb(195,135,255)",
    D = "rgb(255,95,95)",
    F = "rgb(255,95,95)",
}

-- Measure once in the resting pose; never follow the animated Head or camera axes.
function CustomerPresentation.CreateAnchor(root: BasePart, head: BasePart?): Attachment
    local height = if head then head.Position.Y - root.Position.Y + head.Size.Y / 2 else root.Size.Y / 2
    local anchor = Instance.new("Attachment")
    anchor.Name = "ServePromptOrigin"
    anchor.Position = Vector3.new(0, math.max(0, height) + 0.35, 0)
    anchor.Parent = root
    return anchor
end

local function outline(text: TextLabel)
    text.TextStrokeTransparency = 1
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(18, 22, 30)
    stroke.Thickness = 2.5
    stroke.Transparency = 0
    stroke.Parent = text
end

-- Both customer types share lettering; specials retain their separate name row.
local function styleDialogueText(text: TextLabel, size: number)
    text.Font = Enum.Font.FredokaOne
    text.TextSize = size
    text.TextScaled = false
    text.TextWrapped = true
    text.TextColor3 = Color3.new(1, 1, 1)
    text.LineHeight = 1
    outline(text)
end

function CustomerPresentation.StyleDialogue(bubble: BillboardGui, text: TextLabel, special: boolean)
    if not special then
        bubble.Size = UDim2.fromOffset(300, 112)
        text.Size = UDim2.fromScale(1, 1)
    end
    styleDialogueText(text, 21)
    local name = bubble:FindFirstChild("CustomerName")
    if name and name:IsA("TextLabel") then
        name.Visible = special
        if special then
            styleDialogueText(name, 18)
        end
    end
end

function CustomerPresentation.ShowResult(
    order: BillboardGui,
    grade: string,
    payout: number,
    rarity: number
): BillboardGui
    -- Serving has disabled both action prompts. Lower the reaction and reward as
    -- one fixed-pixel stack, keeping their gap and special name row intact.
    order.SizeOffset = Vector2.new(order.SizeOffset.X, 0.5 - RESULT_DROP / order.Size.Y.Offset)
    local cash = tostring(payout):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    local gui = Instance.new("BillboardGui")
    gui.Name = "CustomerResult"
    gui.Adornee = order.Adornee
    gui.StudsOffset = Vector3.zero
    local height = if grade == "D" then 76 else 54
    gui.Size = UDim2.fromOffset(300, height)
    -- Same stable anchor, fixed pixel rows above the entire reaction dialogue.
    local dialogueTop = (order.SizeOffset.Y + 0.5) * order.Size.Y.Offset
    gui.SizeOffset = Vector2.new(0, (dialogueTop + height / 2 + RESULT_GAP) / height)
    gui.AlwaysOnTop = true
    gui.MaxDistance = order.MaxDistance
    gui.Enabled = false
    local function row(name: string, y: number, height: number, size: number, content: string): TextLabel
        local text = Instance.new("TextLabel")
        text.Name = name
        text.Size = UDim2.fromOffset(300, height)
        text.Position = UDim2.fromOffset(0, y)
        text.BackgroundTransparency = 1
        text.Font = Enum.Font.FredokaOne
        text.TextSize = size
        text.TextScaled = false
        text.TextColor3 = Color3.new(1, 1, 1)
        text.RichText = true
        text.Text = content
        outline(text)
        text.Parent = gui
        return text
    end
    row(
        "Result",
        0,
        32,
        24,
        string.format(
            '<font color="%s">%s</font>  <font color="rgb(255,222,115)">+$%s</font>',
            GRADE_COLORS[grade] or "rgb(255,255,255)",
            grade,
            cash
        )
    )
    row("Rarity", 34, 20, 18, string.format("Rarity Bonus x%s", tostring(rarity)))
    if grade == "D" then
        local retry = row("Retry", 56, 20, 16, "TRY AGAIN \u{00B7} 15% PAYOUT")
        retry.TextColor3 = Color3.fromRGB(255, 95, 95)
    end
    gui.Parent = order.Parent
    gui:SetAttribute("ResultExpiresAt", os.clock() + RESULT_DURATION)
    game:GetService("Debris"):AddItem(gui, RESULT_DURATION)
    return gui
end

-- A short exit route must not truncate the readable hold or delay the next customer.
-- Snapshot only the presentation at the final root position before normal rig cleanup.
function CustomerPresentation.PreserveResult(gui: BillboardGui)
    local expires = gui:GetAttribute("ResultExpiresAt")
    local anchor = gui.Adornee
    if
        not gui.Parent
        or typeof(expires) ~= "number"
        or expires <= os.clock()
        or not anchor
        or not anchor:IsA("Attachment")
    then
        return
    end
    local root = anchor.Parent
    if not root or not root:IsA("BasePart") then
        return
    end
    local customer = root.Parent
    if not customer then
        return
    end
    local holder = Instance.new("Model")
    holder.Name = "CustomerResultHold"
    holder:SetAttribute("OwnerUserId", customer:GetAttribute("OwnerUserId"))
    local origin = Instance.new("Part")
    origin.Name = "ResultOrigin"
    origin.Anchored = true
    origin.Transparency = 1
    origin.CanCollide, origin.CanTouch, origin.CanQuery = false, false, false
    origin.CFrame = root.CFrame
    origin.Parent = holder
    local fixedAnchor = Instance.new("Attachment")
    fixedAnchor.Position = anchor.Position
    fixedAnchor.Parent = origin
    local copy = gui:Clone()
    copy.Enabled = false
    copy.Adornee = fixedAnchor
    copy.Parent = origin
    holder.Parent = workspace
    game:GetService("Debris"):AddItem(holder, math.max(0, expires - os.clock()))
end

-- Presentation only: keys are normalized tags, never ingredient-derived colors.
-- Aliases describe wording in authored dialogue; they do not change tag validation.
CustomerPresentation.TagHighlights = {
    red = { Color = Color3.fromRGB(255, 95, 95) },
    yellow = { Color = Color3.fromRGB(255, 220, 65) },
    green = { Color = Color3.fromRGB(100, 225, 120) },
    purple = { Color = Color3.fromRGB(195, 135, 255) },
    blue = { Color = Color3.fromRGB(100, 170, 255) },
    cold = { Color = Color3.fromRGB(105, 225, 255) },
    sweet = { Color = Color3.fromRGB(255, 140, 200) },
    spicy = { Color = Color3.fromRGB(255, 140, 65), Aliases = { "spice", "heat" } },
    protein = { Color = Color3.fromRGB(235, 180, 120) },
    fruit = { Color = Color3.fromRGB(255, 175, 95), Aliases = { "fruity" } },
    seafood = { Color = Color3.fromRGB(95, 215, 200), Aliases = { "ocean", "fish" } },
    ["fast food"] = { Color = Color3.fromRGB(255, 190, 75) },
    milk = { Color = Color3.fromRGB(190, 205, 255) },
    weird = { Color = Color3.fromRGB(210, 145, 245) },
    sour = { Color = Color3.fromRGB(195, 235, 85) },
    veggie = { Color = Color3.fromRGB(135, 215, 105), Aliases = { "veggies" } },
    mushroom = { Color = Color3.fromRGB(220, 180, 145), Aliases = { "mushrooms" } },
    watermelon = { Color = Color3.fromRGB(255, 130, 155) },
    steak = { Color = Color3.fromRGB(225, 140, 120) },
} :: { [string]: { Color: Color3, Aliases: { string }? } }

function CustomerPresentation.HideDefaultDisplay(humanoid: Humanoid)
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
end

local function nonempty(value: any): string?
    return if type(value) == "string" and string.find(value, "%S") then value else nil
end

function CustomerPresentation.DisplayName(
    template: Model,
    special: boolean,
    configured: string?,
    identity: string?
): string
    if not special then
        return "CustomerNPC"
    end
    local humanoid = template:FindFirstChildOfClass("Humanoid")
    return (if humanoid then nonempty(humanoid.DisplayName) else nil)
        or nonempty(configured)
        or nonempty(identity)
        or template.Name
end

function CustomerPresentation.Response(request: { GoodResponse: string?, BadResponse: string? }, grade: string): string?
    if grade == "A" or grade == "B" then
        return nonempty(request.GoodResponse)
    elseif grade == "C" or grade == "D" or grade == "F" then
        return nonempty(request.BadResponse)
    end
    return nil
end

return CustomerPresentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">CustomerService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local Customers = require(Shared.Constants.Customers)
local CustomerRequests = require(Shared.Constants.CustomerRequests)
local Ingredients = require(Shared.Constants.Ingredients)
local RunService = game:GetService("RunService")
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local Types = require(Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local Placement = require(script.Parent.CustomerPlacement)
local Walk = require(script.Parent.CustomerWalk)
local Presentation = require(script.Parent.CustomerPresentation)
local AudioService = require(script.Parent.AudioService)
local Film = require(script.Parent.FilmingUtil)
local CustomerService = {}
local deps: any
local onServed: (Player, Types.Grade) -> ()
local queues: { [Player]: any } = {}
local queueMarkers = { "CustomerCounter", "CustomerWait1", "CustomerWait2" }
local function front(player: Player): any
    local queue = queues[player]
    return if queue then queue.Customers[1] else nil
end
local function current(player: Player, queue: any): boolean
    return queues[player] == queue
        and deps.TycoonService.GetPlot(player) == queue.Plot
        and deps.TycoonService.GetOwner(queue.Plot) == player
end
local ownedModels: { [Player]: { [Model]: boolean } } = {}
local lastSpecialSpawn: { [Player]: number } = {}
local lastTemplates: { [Player]: Model } = {}
-- Runtime-only regular selections survive flow restarts.
local recentTemplates: { [Player]: { Model } } = {}
local recentRequests: { [Player]: { string } } = {}

local function remember<T>(histories: { [Player]: { T } }, player: Player, value: T, window: number)
    local history = histories[player] or {}
    table.insert(history, value)
    while #history > math.max(0, window) do
        table.remove(history, 1)
    end
    histories[player] = history
end
local warnedTemplates = setmetatable({} :: { [Instance]: boolean }, { __mode = "k" })
local activeTypingTasks = setmetatable({}, { __mode = "k" })
local CustomerNameHeight = 28
local CUSTOMER_ORDER_MAX_DISTANCE = 30
local CUSTOMER_ORDER_WIDTH = 270
local CUSTOMER_ORDER_TEXT_HEIGHT = 56
local CUSTOMER_ORDER_TEXT_SIZE = 21

local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[CustomerService] " .. message)
    end
end

-- Pure request decision, separate from legacy grading and cosmetic reactions.
-- Read definitions from actual ingredient IDs, never cup attributes or supplied result.Tags.
-- Only tag comparisons ignore case; ingredient IDs and CustomerIds keep their existing semantics.
function CustomerService.ValidateRequestDefinition(request: CustomerRequests.Request): { string }
    local diagnostics: { string } = {}
    local requiredIngredients: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    for slot, requirement in requiredIngredients do
        if type(requirement) == "table" then
            local accessible = false
            local valid = false
            if #requirement == 0 then
                table.insert(diagnostics, "Empty ingredient alternative group at slot " .. slot)
            end
            for _, id in requirement do
                local definition = Ingredients[id]
                if not definition then
                    table.insert(diagnostics, "Unknown required ingredient: " .. id)
                else
                    valid = true
                    accessible = accessible or definition.JumpLocation <= request.MinJumpTier
                end
            end
            if valid and not accessible then
                table.insert(
                    diagnostics,
                    "No ingredient alternative at slot "
                        .. slot
                        .. " is accessible at MinJumpTier "
                        .. request.MinJumpTier
                )
            end
            continue
        end
        local id = requirement
        local definition = Ingredients[id]
        if not definition then
            table.insert(diagnostics, "Unknown required ingredient: " .. id)
        elseif definition.JumpLocation > request.MinJumpTier then
            table.insert(
                diagnostics,
                string.format(
                    "Required ingredient %s needs JumpLocation %d, above MinJumpTier %d",
                    id,
                    definition.JumpLocation,
                    request.MinJumpTier
                )
            )
        end
    end
    local forbiddenIngredients: { string } = request.ForbiddenIngredients or {}
    for _, id in forbiddenIngredients do
        if not Ingredients[id] then
            table.insert(diagnostics, "Unknown forbidden ingredient: " .. id)
        end
    end
    if request.ExactIngredients and #requiredIngredients == 0 then
        table.insert(diagnostics, "ExactIngredients requires at least one RequiredIngredient")
    end
    return diagnostics
end

function CustomerService.ValidateRequest(result: Types.Smoothie, request: CustomerRequests.Request): (boolean, string)
    local requiredIngredients: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    if #result.Ingredients == 0 then
        return false, "Empty smoothie"
    end
    if #request.RequiredTags == 0 and #requiredIngredients == 0 then
        return false, "Empty request"
    end
    if request.ExactIngredients and #requiredIngredients == 0 then
        return false, "ExactIngredients requires at least one RequiredIngredient"
    end
    local tags: { [string]: boolean } = {}
    local ingredientCounts: { [string]: number } = {}
    for _, id in result.Ingredients do
        local definition = Ingredients[id]
        if not definition then
            return false, "Unknown ingredient: " .. id
        end
        ingredientCounts[id] = (ingredientCounts[id] or 0) + 1
        for _, tag in definition.Tags do
            tags[string.lower(tag)] = true
        end
    end
    for _, tag in request.RequiredTags do
        local normalizedTag = string.lower(tag)
        local matches = tags[normalizedTag] == true
        local group = CustomerRequests.TagGroups[normalizedTag]
        if group then
            for member in group do
                if tags[member] then
                    matches = true
                    break
                end
            end
        end
        if not matches then
            return false, "Missing required tag: " .. tag
        end
    end
    local forbiddenTags: { string } = request.ForbiddenTags or {}
    for _, tag in forbiddenTags do
        if tags[string.lower(tag)] then
            return false, "Contains forbidden tag: " .. tag
        end
    end
    -- Augmenting paths let overlapping slots reassign earlier matches instead of
    -- greedily consuming the only ingredient available to a later slot.
    local assignedSlots: { [number]: number } = {}
    local function matchSlot(slot: number, visited: { [number]: boolean }): boolean
        local requirement = requiredIngredients[slot]
        for index, id in result.Ingredients do
            local matches = if type(requirement) == "string"
                then requirement == id
                else table.find(requirement, id) ~= nil
            if matches and not visited[index] then
                visited[index] = true
                local previousSlot = assignedSlots[index]
                if not previousSlot or matchSlot(previousSlot, visited) then
                    assignedSlots[index] = slot
                    return true
                end
            end
        end
        return false
    end
    for slot, requirement in requiredIngredients do
        if not matchSlot(slot, {}) then
            local description = if type(requirement) == "string" then requirement else table.concat(requirement, " or ")
            return false, "Missing required ingredient: " .. description
        end
    end
    local forbiddenIngredients: { string } = request.ForbiddenIngredients or {}
    for _, id in forbiddenIngredients do
        if ingredientCounts[id] then
            return false, "Contains forbidden ingredient: " .. id
        end
    end
    if request.ExactIngredients and #result.Ingredients ~= #requiredIngredients then
        return false, "Exact ingredient mismatch"
    end
    return true, "Request requirements matched"
end

local function eligibleRequests(player: Player): { CustomerRequests.Request }
    -- Server-owned effective tier, published by PlayerDataService/MovementService (0-3).
    local playerJumpTier = player:GetAttribute("JumpLevel") or 0
    local eligible: { CustomerRequests.Request } = {}
    for _, request in CustomerRequests.Definitions do
        if not request.NPCOnly and playerJumpTier >= request.MinJumpTier then
            table.insert(eligible, request)
        end
    end
    if #eligible == 0 then
        warn(
            string.format(
                "[CustomerService] No eligible requests for %s at jump tier %s",
                player.Name,
                tostring(playerJumpTier)
            )
        )
    end
    return eligible
end

local function assignRequest(player: Player, record: any): boolean
    local selectedRequest = record.FixedRequest
    local forced = selectedRequest ~= nil
    local recentFiltered, recentFallback = false, false
    if selectedRequest and (player:GetAttribute("JumpLevel") or 0) < selectedRequest.MinJumpTier then
        diagnostic("special became ineligible before assignment; removing customer owner=" .. player.Name)
        record.Model:Destroy()
        return false
    end
    if not selectedRequest then
        local eligible = eligibleRequests(player)
        if #eligible == 0 then
            record.Model:Destroy()
            return false
        end
        local pool = eligible
        if record.CustomerType == "Regular" then
            local fresh: { CustomerRequests.Request } = {}
            for _, request in eligible do
                if not table.find(recentRequests[player] or {}, request.Id) then
                    table.insert(fresh, request)
                end
            end
            recentFiltered = #fresh < #eligible
            recentFallback = #fresh == 0
            if #fresh > 0 then
                pool = fresh
            end
        end
        selectedRequest = pool[math.random(1, #pool)]
    end
    local request = selectedRequest :: CustomerRequests.Request
    record.Request = request
    record.RequestId = request.Id
    record.Preference = request.RequiredTags[1] or "Surprise Me"
    record.Model:SetAttribute("Preference", record.Preference)
    record.Model:SetAttribute("RequestId", request.Id)
    if not forced and record.CustomerType == "Regular" then
        remember(recentRequests, player, request.Id, CustomerRequests.RegularRequestRecencyWindow)
    end
    diagnostic(
        string.format(
            "selected type=%s template=%s customerId=%s displayName=%s request=%s jumpTier=%s forced=%s requestRecencyFiltered=%s requestRecencyFallback=%s",
            record.CustomerType,
            record.TemplateName,
            record.CustomerId or "<absent>",
            record.DisplayName or "<absent>",
            request.Id,
            tostring(player:GetAttribute("JumpLevel") or 0),
            tostring(forced),
            tostring(recentFiltered),
            tostring(recentFallback)
        )
    )
    return true
end

local function npcRoot(model: Model): BasePart?
    local root = model:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        return root
    end
    return WorldUtil.Part(model)
end

local function rejectTemplate(template: Instance, reason: string)
    if RunService:IsStudio() and not warnedTemplates[template] then
        warnedTemplates[template] = true
        warn("[CustomerService] Skipping " .. template:GetFullName() .. ": " .. reason)
    end
end

local function cleanClone(model: Model)
    -- This flow owns customer world-space presentation, including on cloned templates.
    for _, object in model:GetDescendants() do
        if
            object:IsA("Script")
            or object:IsA("LocalScript")
            or object:IsA("ModuleScript")
            or object:IsA("Tool")
            or object:IsA("ProximityPrompt")
            or object:IsA("BillboardGui")
            or object:IsA("SurfaceGui")
        then
            object:Destroy()
        end
    end
end

type Candidate = {
    Template: Model,
    CustomerId: string?,
    DisplayName: string?,
    CustomerType: string,
    Request: CustomerRequests.Request?,
    Weight: number,
}

local function candidateFor(player: Player, template: Model): Candidate?
    local id = CustomerRequests.NormalizeCustomerId(template:GetAttribute("CustomerId"))
    local config = if id then CustomerRequests.NPCs[id] else nil
    -- Existing RequestId-only mappings remain special; an explicit Regular ignores overrides.
    local kind = if config and (config.Type == "Special" or (not config.Type and config.RequestId))
        then "Special"
        else "Regular"
    local request, reason = CustomerRequests.GetForNPC(id)
    if kind == "Special" then
        if reason then
            rejectTemplate(template, reason)
            return nil
        end
        if request and (player:GetAttribute("JumpLevel") or 0) < request.MinJumpTier then
            diagnostic(
                string.format(
                    "special ineligible customerId=%s request=%s requiredJumpTier=%d playerJumpTier=%s",
                    id or "<absent>",
                    request.Id,
                    request.MinJumpTier,
                    tostring(player:GetAttribute("JumpLevel") or 0)
                )
            )
            return nil
        end
    else
        request = nil
    end
    local weight = if config and config.Weight then config.Weight else 1
    if weight ~= weight or weight <= 0 or weight == math.huge then
        rejectTemplate(template, "Weight must be positive and finite")
        return nil
    end
    return {
        Template = template,
        CustomerId = id,
        DisplayName = Presentation.DisplayName(
            template,
            kind == "Special",
            if config then config.DisplayName else nil,
            id
        ),
        CustomerType = kind,
        Request = request,
        Weight = weight,
    }
end

local function cloneNPC(player: Player): (Model?, Candidate?)
    local folder = ServerStorage:FindFirstChild("CustomerNPCs")
    local regular: { Candidate } = {}
    local special: { Candidate } = {}
    if folder and folder:IsA("Folder") then
        for _, kind in { "Regular", "Special" } do
            local source = folder:FindFirstChild(kind)
            if source and source:IsA("Folder") then
                for _, template in source:GetChildren() do
                    if not template:IsA("Model") then
                        rejectTemplate(template, "expected a Model")
                    elseif not template:FindFirstChildOfClass("Humanoid") or not npcRoot(template) then
                        rejectTemplate(template, "requires Humanoid and a BasePart root")
                    elseif not template.Archivable then
                        rejectTemplate(template, "enable Archivable to allow cloning")
                    else
                        local candidate = candidateFor(player, template)
                        if candidate and candidate.CustomerType == kind then
                            table.insert(if kind == "Special" then special else regular, candidate)
                        elseif candidate then
                            rejectTemplate(template, "CustomerId mapping does not match source folder " .. kind)
                        end
                    end
                end
            elseif source then
                rejectTemplate(source, kind .. " must be a Folder")
            end
        end
    elseif folder then
        rejectTemplate(folder, "CustomerNPCs must be a Folder")
    end
    if #regular > 0 then
        for index = #special, 1, -1 do
            if special[index].Template == lastTemplates[player] then
                table.remove(special, index)
            end
        end
    end
    local useSpecial = #special > 0
        and (lastSpecialSpawn[player] == nil or os.clock() - lastSpecialSpawn[player] >= Economy.SpecialCustomerCooldownSeconds)
        and math.random() < CustomerRequests.SpecialCustomerChance
    local candidates = if useSpecial then special else regular
    -- Regulars use rolling recency; specials retain their existing immediate-repeat rule.
    -- Never increase special frequency to avoid a regular repeat.
    local function take(pool: { Candidate }): (Candidate, boolean, boolean)
        local alternatives: { number } = {}
        for index, candidate in pool do
            local recent = if candidate.CustomerType == "Regular"
                then table.find(recentTemplates[player] or {}, candidate.Template) ~= nil
                else candidate.Template == lastTemplates[player]
            if not recent then
                table.insert(alternatives, index)
            end
        end
        local filtered, fallback = #alternatives < #pool, #alternatives == 0
        if fallback then
            for index in pool do
                table.insert(alternatives, index)
            end
        end
        local total = 0
        for _, index in alternatives do
            total += pool[index].Weight
        end
        local roll = math.random() * total
        local chosen = alternatives[#alternatives]
        for _, index in alternatives do
            roll -= pool[index].Weight
            if roll < 0 then
                chosen = index
                break
            end
        end
        return table.remove(pool, chosen) :: Candidate, filtered, fallback
    end
    while #candidates > 0 do
        local candidate, filtered, fallback = take(candidates)
        local template = candidate.Template
        local ok, clone = pcall(function()
            return template:Clone()
        end)
        if ok and clone then
            cleanClone(clone)
        end
        if ok and clone and clone:FindFirstChildOfClass("Humanoid") and npcRoot(clone) then
            lastTemplates[player] = template
            if candidate.CustomerType == "Regular" then
                remember(recentTemplates, player, template, CustomerRequests.RegularCustomerRecencyWindow)
                diagnostic(
                    string.format(
                        "regular template=%s customerRecencyFiltered=%s customerRecencyFallback=%s owner=%s",
                        template:GetFullName(),
                        tostring(filtered),
                        tostring(fallback),
                        player.Name
                    )
                )
            end
            return clone, candidate
        end
        if ok and clone then
            clone:Destroy()
        end
        rejectTemplate(template, "clone failed or required descendants are not Archivable")
        if #candidates == 0 and useSpecial then
            candidates = regular
            useSpecial = false
        end
    end
    return nil, nil
end

-- Legacy compatibility: day boundaries no longer reset special eligibility.
function CustomerService.BeginDay(_player: Player) end

local function ensureCustomerCounterGlow(customerModel: Model): ParticleEmitter?
    local existingGlow = customerModel:FindFirstChild("CustomerCounterGlow")
    if existingGlow and existingGlow:IsA("ParticleEmitter") then
        return existingGlow
    end

    local rootPart = customerModel.PrimaryPart
        or customerModel:FindFirstChild("HumanoidRootPart")
        or customerModel:FindFirstChild("Head")
        or customerModel:FindFirstChild("Torso")

    if not rootPart then
        return nil
    end

    local counterGlow = Instance.new("ParticleEmitter")
    counterGlow.Name = "CustomerCounterGlow"
    counterGlow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    counterGlow.Rate = 0
    counterGlow.Speed = NumberRange.new(0.5, 1)
    counterGlow.Lifetime = NumberRange.new(0.4, 0.7)
    counterGlow.Color = ColorSequence.new(Color3.fromRGB(255, 224, 100))
    counterGlow.Parent = rootPart

    return counterGlow
end

local function escapeRichText(message: string): string
    local escaped = message:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    return escaped
end

function CustomerService.FormatRequestText(request: CustomerRequests.Request): string
    local names: { { Name: string, Color: Color3 } } = {}
    local seen: { [string]: boolean } = {}
    local requiredIngredients: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    for _, requirement in requiredIngredients do
        local alternatives: { string } = if type(requirement) == "string" then { requirement } else requirement
        for _, id in alternatives do
            local definition = Ingredients[id]
            if definition then
                local name = string.lower(definition.DisplayName or definition.Id)
                if name ~= "" and not seen[name] then
                    seen[name] = true
                    table.insert(names, { Name = name, Color = definition.BlendColor })
                end
            end
        end
    end
    -- Ingredient names were added first, so a tag cannot replace their catalog color.
    local function addTag(tag: string)
        local normalized = string.lower(tag)
        local highlight = Presentation.TagHighlights[normalized]
        if not highlight then
            return
        end
        local phrases = { normalized }
        local aliases: { string } = highlight.Aliases or {}
        for _, alias in aliases do
            table.insert(phrases, alias)
        end
        for _, phrase in phrases do
            if not seen[phrase] then
                seen[phrase] = true
                table.insert(names, { Name = phrase, Color = highlight.Color })
            end
        end
    end
    local requiredTags: { string } = request.RequiredTags or {}
    for _, tag in requiredTags do
        addTag(tag)
    end
    local forbiddenTags: { string } = request.ForbiddenTags or {}
    for _, tag in forbiddenTags do
        addTag(tag)
    end
    -- Prefer full multiword names over shorter names contained within them.
    table.sort(names, function(a, b)
        return #a.Name > #b.Name
    end)
    local message = request.DisplayText
    local lower = string.lower(message)
    local output: { string } = {}
    local index = 1
    while index <= #message do
        local matched = false
        for _, entry in names do
            local last = index + #entry.Name - 1
            if
                lower:sub(index, last) == entry.Name
                and not lower:sub(index - 1, index - 1):match("[%w_]")
                and not lower:sub(last + 1, last + 1):match("[%w_]")
            then
                local color = entry.Color
                table.insert(
                    output,
                    string.format(
                        '<font color="rgb(%d,%d,%d)">%s</font>',
                        math.round(color.R * 255),
                        math.round(color.G * 255),
                        math.round(color.B * 255),
                        escapeRichText(message:sub(index, last))
                    )
                )
                index = last + 1
                matched = true
                break
            end
        end
        if not matched then
            table.insert(output, escapeRichText(message:sub(index, index)))
            index += 1
        end
    end
    return table.concat(output)
end

local function typewriterText(textLabel: TextLabel, message: string, dialogueSound: Sound?, richMessage: string?)
    local currentToken = {}
    activeTypingTasks[textLabel] = currentToken
    local dialogueStep = 3

    if dialogueSound and dialogueSound.Parent then
        dialogueSound:Stop()
    end

    textLabel.RichText = true
    textLabel.MaxVisibleGraphemes = 0
    textLabel.Text = richMessage or escapeRichText(message)

    task.spawn(function()
        local index = 0
        for first, last in utf8.graphemes(message) do
            index += 1
            if not textLabel.Parent or activeTypingTasks[textLabel] ~= currentToken then
                return
            end

            local character = string.sub(message, first, last)
            textLabel.MaxVisibleGraphemes = index

            local shouldPlayDialogueSound = dialogueSound
                and dialogueSound.Parent
                and character ~= " "
                and (index % dialogueStep == 0 or last == #message)

            if shouldPlayDialogueSound and dialogueSound then
                dialogueSound.TimePosition = 0
                dialogueSound.PlaybackSpeed = math.random(90, 120) / 100

                local pitchShift: PitchShiftSoundEffect? = dialogueSound:FindFirstChildOfClass("PitchShiftSoundEffect")
                if not pitchShift then
                    local created = Instance.new("PitchShiftSoundEffect")
                    created.Parent = dialogueSound
                    pitchShift = created
                end

                (pitchShift :: PitchShiftSoundEffect).Octave = math.random(92, 108) / 100
                dialogueSound:Play()
            end

            task.wait(0.04)
        end

        if textLabel.Parent and activeTypingTasks[textLabel] == currentToken then
            textLabel.MaxVisibleGraphemes = -1
            activeTypingTasks[textLabel] = nil
        end
    end)
end

function CustomerService.Init(services, servedCallback, _servingCallback)
    deps = services
    onServed = servedCallback
    if RunService:IsStudio() then
        for _, request in CustomerRequests.Definitions do
            for _, message in CustomerService.ValidateRequestDefinition(request) do
                warn("[CustomerService] Request " .. request.Id .. ": " .. message)
            end
        end
    end
end

-- Grade and reaction are deliberately independent, pure decision functions.
function CustomerService.CalculateGrade(result: Types.Smoothie, preference: string): Types.Grade
    if preference == "Surprise Me" then
        local unique = {}
        for _, id in result.Ingredients do
            unique[id] = true
        end
        local count = 0
        for _ in unique do
            count += 1
        end
        return if count >= 3 then "A" elseif count == 2 then "B" else "C"
    end
    local matching = 0
    for _, id in result.Ingredients do
        if table.find(deps.IngredientService.GetDefinition(id).Tags, preference) then
            matching += 1
        end
    end
    local ratio = matching / math.max(1, #result.Ingredients)
    return if ratio >= 2 / 3 then "A" elseif ratio >= 1 / 3 then "B" elseif matching > 0 then "C" else "D"
end
function CustomerService.SelectReaction(): string
    local total = 0
    for _, reaction in Customers.Reactions do
        total += reaction.Weight
    end
    local roll = math.random() * total
    for _, reaction in Customers.Reactions do
        roll -= reaction.Weight
        if roll <= 0 then
            return reaction.Id
        end
    end
    return Customers.Reactions[1].Id
end
function CustomerService.CalculatePayout(player: Player, grade: Types.Grade): number
    local upgrade = Upgrades.Payout[deps.PlayerDataService.GetUpgrade(player, "Payout")].Value
    local multiplier = if deps.PlayerDataService.HasEntitlement(player, "DoubleCash") then 2 else 1
    return math.round(Economy.BasePayout * Economy.CashScale * Economy.GradeMultiplier[grade] * upgrade * multiplier)
end

-- Called only with the consumed server cup and the customer's assigned request.
function CustomerService.CalculateOrderPayout(
    player: Player,
    result: Types.Smoothie,
    request: CustomerRequests.Request,
    success: boolean
): (number, number)
    local rarity = 1
    local requirements: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    for _, id in result.Ingredients do
        local definition = Ingredients[id]
        if not definition then
            continue
        end
        local qualifies = not success
        for _, requestedTag in request.RequiredTags do
            local normalized = string.lower(requestedTag)
            local group = CustomerRequests.TagGroups[normalized]
            for _, tag in definition.Tags do
                local actual = string.lower(tag)
                if actual == normalized or (group and group[actual]) then
                    qualifies = true
                end
            end
        end
        -- On a validated order, an ingredient matching a slot can satisfy that
        -- slot (including alternatives). Extras unrelated to any slot/tag cannot.
        for _, requirement in requirements do
            if
                (type(requirement) == "string" and requirement == id)
                or (type(requirement) == "table" and table.find(requirement, id) ~= nil)
            then
                qualifies = true
            end
        end
        if qualifies then
            rarity = math.max(rarity, Economy.PayoutRarityMultiplier[definition.Rarity])
        end
    end
    local upgrade = Upgrades.Payout[deps.PlayerDataService.GetUpgrade(player, "Payout")].Value
    local entitlement = if deps.PlayerDataService.HasEntitlement(player, "DoubleCash") then 2 else 1
    local amount = request.BasePayout * Economy.CashScale * Economy.GradeMultiplier.A * rarity * upgrade * entitlement
    return math.round(amount * (if success then 1 else Economy.MissedOrderFraction)), rarity
end
function CustomerService.CanSpawn(player: Player): (boolean, string?)
    local queue = queues[player]
    if not queue or not current(player, queue) then
        return false, "Plot flow inactive"
    end
    if #queue.Customers >= Economy.MaxCustomersPerPlot then
        return false, "Customer queue full"
    end
    if #eligibleRequests(player) == 0 then
        return false, "No eligible customer requests"
    end
    for _, name in { "CustomerSpawn", "CustomerCounter", "CustomerWait1", "CustomerWait2", "CustomerExit" } do
        local marker, reason = deps.TycoonService.GetReference(player, name)
        if not marker then
            local message = "Cannot resolve "
                .. name
                .. " in "
                .. player.Name
                .. "'s plot: "
                .. (reason or "Missing marker")
            if RunService:IsStudio() then
                warn("[CustomerService] " .. message)
            end
            return false, message
        end
    end
    return true
end
-- Keep all low-level traversal and pose handling in the existing walking helper.
local function move(record: any, destination: CFrame, finished: () -> (), via: { CFrame }?)
    local targets = via or {}
    local entryIndex = record.EntryIndex or 3
    table.insert(targets, destination)
    Walk.Move(
        record,
        targets,
        function(reached)
            if reached then
                finished()
            elseif record.Model.Parent then
                -- Existing Destroying cleanup removes the failed entry and advances waiters.
                warn("[CustomerWalk] route exhausted; removing unreachable customer")
                record.Model:Destroy()
            end
        end,
        nil,
        function(leg)
            if not record.EnteredQueue then
                record.EntryIndex = entryIndex - leg
            end
        end
    )
end
-- One ordered queue owns both destinations and eligibility. Route tokens invalidate old arrivals.
function CustomerService.RefreshQueue(player: Player)
    local queue = queues[player]
    if not queue then
        return
    end
    if not current(player, queue) then
        CustomerService.DeactivateForPlayer(player)
        return
    end
    for index, record in queue.Customers do
        local marker = deps.TycoonService.GetReference(player, queueMarkers[index])
        record.Model:SetAttribute("QueuePosition", index)
        if not marker then
            Walk.Cancel(record)
            record.TargetMarker = nil
            record.Ready = false
            record.Prompt.Enabled = false
            record.Walk.SetMoving(false)
        else
            local destination = Placement.AtMarker(marker, record.BottomOffset)
            if record.TargetMarker ~= marker or record.MarkerFrame ~= marker.CFrame or record.QueueIndex ~= index then
                record.TargetMarker = marker
                record.MarkerFrame = marker.CFrame
                record.QueueIndex = index
                record.Ready = false
                record.Prompt.Enabled = false
                local via = {}
                -- New arrivals visit the entrance slots before their assigned slot.
                if not record.EnteredQueue then
                    for entranceIndex = record.EntryIndex or 3, index + 1, -1 do
                        local entrance = deps.TycoonService.GetReference(player, queueMarkers[entranceIndex])
                        if entrance then
                            table.insert(via, Placement.AtMarker(entrance, record.BottomOffset))
                        end
                    end
                end
                move(record, destination, function()
                    record.EnteredQueue = true
                    if current(player, queue) and table.find(queue.Customers, record) then
                        record.Ready = queue.Customers[1] == record
                        record.Prompt.Enabled = record.Ready and record.OrderTaken
                    end
                end, via)
            else
                record.Ready = index == 1 and record.Ready
                record.Prompt.Enabled = record.Ready and record.OrderTaken
            end
        end
    end
end

function CustomerService.ActivateForPlayer(player: Player): boolean
    local plot = deps.TycoonService.GetPlot(player)
    if not plot or deps.TycoonService.GetOwner(plot) ~= player then
        CustomerService.DeactivateForPlayer(player)
        return false
    end
    local existing = queues[player]
    if existing and current(player, existing) then
        return true
    end
    CustomerService.DeactivateForPlayer(player)
    local queue: any = { Customers = {}, Plot = plot, Full = false }
    queues[player] = queue
    queue.PlotConnection = plot.AncestryChanged:Connect(function()
        if queues[player] == queue and not current(player, queue) then
            CustomerService.DeactivateForPlayer(player)
        end
    end)
    player:SetAttribute("CustomerFlowState", "PLOT_ACTIVE")
    diagnostic("flow started owner=" .. player.Name)
    local function tick()
        if queues[player] ~= queue then
            return
        end
        if not current(player, queue) then
            CustomerService.DeactivateForPlayer(player)
            return
        end
        CustomerService.RefreshQueue(player)
        local full = #queue.Customers >= Economy.MaxCustomersPerPlot
        if full and not queue.Full then
            diagnostic("queue full owner=" .. player.Name)
        end
        queue.Full = full
        local spawned = not full and CustomerService.SpawnForPlayer(player) ~= nil
        if not current(player, queue) then
            return
        end
        task.delay(
            if spawned
                then math.random(Economy.CustomerSpawnMinSeconds, Economy.CustomerSpawnMaxSeconds)
                else math.random(Economy.CustomerFullRetryMinSeconds, Economy.CustomerFullRetryMaxSeconds),
            tick
        )
    end
    task.delay(math.random(Economy.InitialCustomerDelayMin, Economy.InitialCustomerDelayMax), tick)
    return true
end

function CustomerService.SpawnForPlayer(player: Player): Model?
    if not CustomerService.CanSpawn(player) then
        return nil
    end
    local spawn = deps.TycoonService.GetReference(player, "CustomerSpawn")
    local counter = deps.TycoonService.GetReference(player, "CustomerCounter")
    local exit = deps.TycoonService.GetReference(player, "CustomerExit")
    if not spawn or not counter or not exit then
        return nil
    end
    diagnostic(
        string.format(
            "route owner=%s %s -> %s -> %s",
            player.Name,
            spawn:GetFullName(),
            counter:GetFullName(),
            exit:GetFullName()
        )
    )
    local customModel, candidate = cloneNPC(player)
    local templateName = if candidate then candidate.Template.Name else nil
    local template = ServerStorage:FindFirstChild("Customer")
    local selectedModel = customModel
    local legacyCandidate = if template and template:IsA("Model") then candidateFor(player, template) else nil
    if
        not selectedModel
        and template
        and template:IsA("Model")
        and template.Archivable
        and legacyCandidate
        and legacyCandidate.CustomerType == "Regular"
    then
        local ok, clone = pcall(function()
            return template:Clone()
        end)
        if ok and clone then
            cleanClone(clone)
            if npcRoot(clone) then
                selectedModel = clone
                templateName = template.Name
            else
                clone:Destroy()
                rejectTemplate(template, "clone has no usable root after cleanup")
            end
        end
    end
    if not selectedModel then
        local generic = Instance.new("Model")
        local torso = Instance.new("Part")
        torso.Name = "Torso"
        torso.Size = Vector3.new(2, 2.5, 1)
        torso.Color = Color3.fromRGB(220, 170, 110)
        torso.Parent = generic
        local head = Instance.new("Part")
        head.Name = "Head"
        head.Size = Vector3.new(2, 1, 1)
        head.Position = Vector3.new(0, 2, 0)
        head.Color = Color3.fromRGB(245, 205, 170)
        head.Parent = generic
        generic.PrimaryPart = torso
        selectedModel = generic
    end
    local model = selectedModel :: Model
    model.Name = "CustomerNPC"
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
        end
    end
    local root = npcRoot(model) :: BasePart
    model.PrimaryPart = root
    -- Normalize the clone upright before measuring; standard rigs face root -Z.
    model:PivotTo(CFrame.new(model:GetPivot().Position))
    local bottomOffset = Placement.BottomOffset(model)
    local spawnAt = Placement.AtMarker(spawn, bottomOffset)
    local counterAt = Placement.AtMarker(counter, bottomOffset)
    local exitAt = Placement.AtMarker(exit, bottomOffset)
    model:PivotTo(Placement.Face(spawnAt.Position, counterAt.Position, spawn.CFrame))
    if model:FindFirstChildOfClass("Humanoid") then
        Walk.PrepareRig(model, root)
    end
    model.Parent = workspace
    local pose = Walk.HoldRig(model, root)
    local walk = Walk.Create(model, templateName)
    ownedModels[player] = ownedModels[player] or {}
    ownedModels[player][model] = true
    local bubble = Instance.new("BillboardGui")
    bubble.Name = "OrderBubble"
    bubble.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CUSTOMER_ORDER_TEXT_HEIGHT)
    bubble.AlwaysOnTop = true
    bubble.MaxDistance = CUSTOMER_ORDER_MAX_DISTANCE
    -- Fail closed on every client; the owner's controller enables this locally.
    bubble.Enabled = false
    local head = model:FindFirstChild("Head", true)
    bubble.Adornee = Presentation.CreateAnchor(root, if head and head:IsA("BasePart") then head else nil)
    bubble.StudsOffset = Vector3.zero
    bubble.SizeOffset = Vector2.new(0, 0.5) -- Bottom edge stays at the rig anchor.
    bubble.Parent = root
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.BorderSizePixel = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.TextStrokeTransparency = 0.1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.Font = Enum.Font.GothamBold
    text.TextSize = CUSTOMER_ORDER_TEXT_SIZE
    text.TextWrapped = true
    text.LineHeight = 0.95
    text.TextXAlignment = Enum.TextXAlignment.Center
    text.TextYAlignment = Enum.TextYAlignment.Center
    text.Text = ""
    text.Parent = bubble
    local displayName = if candidate then candidate.DisplayName else "CustomerNPC"
    if displayName then
        -- Fixed separate rows keep the smaller name below the floating dialogue.
        bubble.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CUSTOMER_ORDER_TEXT_HEIGHT + CustomerNameHeight)
        text.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CUSTOMER_ORDER_TEXT_HEIGHT)
        text.Position = UDim2.fromOffset(0, 0)
        local nameText = text:Clone()
        nameText.Name = "CustomerName"
        nameText.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CustomerNameHeight)
        nameText.Position = UDim2.fromOffset(0, CUSTOMER_ORDER_TEXT_HEIGHT)
        nameText.TextSize = 18
        nameText.Text = displayName
        nameText.Parent = bubble
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- A single name row works even on imported rigs with hidden nameplates.
            humanoid.DisplayName = displayName
            Presentation.HideDefaultDisplay(humanoid)
        end
    end
    Presentation.StyleDialogue(bubble, text, candidate ~= nil and candidate.CustomerType ~= "Regular")
    local audio = AudioService.CreateBlendGroup(root)
    local prompt = WorldUtil.Prompt(root, "ServePrompt", "Serve smoothie")
    prompt.Enabled = false
    prompt:SetAttribute("InteractionOrigin", "ServePromptOrigin")
    prompt:SetAttribute("InteractionActionText", "SERVE")
    prompt.Style = Enum.ProximityPromptStyle.Custom
    local takeOrder = WorldUtil.Prompt(root, "TakeOrderPrompt", "Take Order")
    takeOrder.Enabled = true
    takeOrder.Style = Enum.ProximityPromptStyle.Custom
    takeOrder:SetAttribute("InteractionOrigin", "ServePromptOrigin")
    takeOrder:SetAttribute("InteractionActionText", "TAKE ORDER")
    for _, interaction in { takeOrder, prompt } do
        interaction:SetAttribute("InteractionOwnerUserId", player.UserId)
        interaction:SetAttribute("InteractionCustomerAction", if interaction == takeOrder then "TakeOrder" else "Serve")
    end
    local record: any = {
        OrderTaken = false,
        TakeOrderPrompt = takeOrder,
        Owner = player,
        BottomOffset = bottomOffset,
        Pose = pose,
        CustomerType = if candidate then candidate.CustomerType else "Regular",
        FixedRequest = if candidate then candidate.Request else nil,
        DisplayName = displayName,
        CustomerId = CustomerRequests.NormalizeCustomerId(model:GetAttribute("CustomerId")),
        TemplateName = templateName or "<generic>",
        RequestId = nil :: string?,
        Served = false,
        Model = model,
        Walk = walk,
        Root = root,
        Preference = "",
        Request = nil,
        Ready = false,
        Text = text,
        Bubble = bubble,
        Audio = audio,
        Prompt = prompt,
        Exit = exitAt,
        ForcedReaction = nil,
    }
    local queue = queues[player]
    if not queue or not current(player, queue) or not assignRequest(player, record) then
        walk.Destroy()
        if ownedModels[player] then
            ownedModels[player][model] = nil
        end
        model:Destroy()
        return nil
    end
    table.insert(queue.Customers, record)
    if record.CustomerType == "Special" then
        lastSpecialSpawn[player] = os.clock()
    end
    model:SetAttribute("CustomerId", record.CustomerId)
    model:SetAttribute("OwnerUserId", player.UserId)
    model:SetAttribute("OrderRevealed", false)
    diagnostic(string.format("queued owner=%s position=%d request=%s", player.Name, #queue.Customers, record.RequestId))
    takeOrder.Triggered:Connect(function(actor)
        CustomerService.TakeOrder(actor, model)
    end)
    prompt.Triggered:Connect(function(actor)
        if actor == player then
            CustomerService.Serve(actor, model)
        end
    end)
    model.Destroying:Connect(function()
        walk.Destroy()
        activeTypingTasks[text] = nil
        if ownedModels[player] then
            ownedModels[player][model] = nil
        end
        record.MoveToken = (record.MoveToken or 0) + 1
        if queues[player] == queue then
            local index = table.find(queue.Customers, record)
            if index then
                table.remove(queue.Customers, index)
                CustomerService.RefreshQueue(player)
            end
        end
    end)
    CustomerService.RefreshQueue(player)
    return model
end
-- Reveal only the assigned request; waiting customers are eligible too.
function CustomerService.TakeOrder(player: Player, model: Model): boolean
    local queue = queues[player]
    if not queue or not current(player, queue) then
        return false
    end
    for _, record in queue.Customers do
        if record.Model == model then
            if
                record.OrderTaken
                or record.Served
                or not record.Request
                or not model.Parent
                or not WorldUtil.Near(player, record.Root, Economy.InteractionDistance)
            then
                return false
            end
            record.OrderTaken = true
            record.TakeOrderPrompt.Enabled = false
            record.Prompt.Enabled = record.Ready
            model:SetAttribute("OrderRevealed", true)
            typewriterText(
                record.Text,
                record.Request.DisplayText,
                record.Audio.dialogueSound,
                CustomerService.FormatRequestText(record.Request)
            )
            return true
        end
    end
    return false
end
function CustomerService.GetSnapshot(player: Player): {
    Preference: string,
    CustomerId: string?,
    RequestId: string?,
    Ready: boolean,
    Model: Model,
}?
    local record = front(player)
    if not record then
        return nil
    end
    return {
        Preference = record.Preference,
        CustomerId = record.CustomerId,
        RequestId = if record.Request then record.Request.Id else nil,
        Ready = record.Ready,
        Model = record.Model,
    }
end
function CustomerService.Serve(player: Player, expectedModel: Model?): (boolean, string?)
    local queue = queues[player]
    local record = front(player)
    if
        not record
        or not record.Ready
        or not record.Request
        or record.Served
        or (expectedModel ~= nil and expectedModel ~= record.Model)
        or not queue
        or not current(player, queue)
        or not WorldUtil.Near(player, record.Root, Economy.InteractionDistance)
    then
        diagnostic("serve rejected owner=" .. player.Name .. " reason=No customer ready nearby")
        return false, "No customer ready nearby"
    end
    -- Lock this customer before consuming the selected reservation: destroying
    -- its visual can synchronously emit signals under Immediate signal behavior.
    record.Ready = false
    local result = deps.BlendService.ConsumeCup(player)
    if not result then
        record.Ready = true
        diagnostic("serve rejected owner=" .. player.Name .. " reason=No valid cup")
        record.Audio.notReadySound:Play()
        return false, "No valid cup"
    end
    -- No yield between consumption, payout, and removal from active state.
    record.Served = true
    record.TakeOrderPrompt.Enabled = false
    record.Model:SetAttribute("OrderRevealed", true)
    record.Prompt.Enabled = false
    table.remove(queue.Customers, 1)
    record.Model:SetAttribute("QueuePosition", nil)
    local success, reason = CustomerService.ValidateRequest(result, record.Request)
    local grade: Types.Grade = if success then "A" else "D"
    local response = Presentation.Response(record.Request, grade)
    local reaction = record.ForcedReaction or (if success then "Smile" else "Disgust")
    local payout, rarity = CustomerService.CalculateOrderPayout(player, result, record.Request, success)
    deps.PlayerDataService.AddCash(player, payout)
    diagnostic(
        string.format(
            "served owner=%s request=%s blend=%s ingredients=[%s] success=%s reason=%s payout=%d cash=%d",
            player.Name,
            record.Request.Id,
            tostring(result.BlendId),
            table.concat(result.Ingredients, ", "),
            tostring(success),
            reason,
            payout,
            deps.PlayerDataService.GetCash(player)
        )
    )
    deps.PlayerDataService.IncrementStat(player, "CustomersServed")
    player:SetAttribute("CustomerSatisfaction", grade)
    player:SetAttribute("CustomerReaction", reaction)
    record.Model:SetAttribute("Reaction", reaction)
    record.Model:SetAttribute("Grade", grade)
    record.Model:SetAttribute("OrderSucceeded", success)
    local resultGui = Presentation.ShowResult(record.Bubble, grade, payout, rarity)
    record.Model:SetAttribute("RequestId", nil)
    record.Request = nil
    record.RequestId = nil
    Film.Emit(
        player,
        "CustomerReaction",
        { BlendId = result.BlendId, Customer = record.Model, ReactionId = reaction, Grade = grade, Payout = payout }
    )
    Film.Log(
        "Customer",
        string.format(
            "served blend=%s grade=%s reaction=%s payout=%d",
            tostring(result.BlendId),
            grade,
            reaction,
            payout
        )
    )
    -- Feedback uses the assigned order; reaction audio/VFX/attributes stay independent.
    activeTypingTasks[record.Text] = nil
    if response then
        typewriterText(record.Text, response, record.Audio.dialogueSound)
    else
        record.Bubble:Destroy()
    end
    local glow = ensureCustomerCounterGlow(record.Model)
    if glow and success then
        glow:Emit(20)
    end
    if success then
        record.Audio.customerServeSound:Play()
    else
        record.Audio.notReadySound:Play()
    end
    Debris:AddItem(record.Model, 15)
    task.delay(2, function()
        if record.Model.Parent then
            move(record, record.Exit, function()
                Presentation.PreserveResult(resultGui)
                record.Model:Destroy()
            end)
        end
    end)
    CustomerService.RefreshQueue(player)
    diagnostic(string.format("advanced owner=%s count=%d", player.Name, #queue.Customers))
    onServed(player, grade)
    return true
end
-- Only DevContentService exposes this through its Studio gate; no remote.
function CustomerService.SetForcedReaction(player: Player, reaction: string?): boolean
    if not front(player) then
        return false
    end
    if reaction then
        local valid = false
        for _, definition in Customers.Reactions do
            if definition.Id == reaction then
                valid = true
            end
        end
        if not valid then
            return false
        end
    end
    front(player).ForcedReaction = reaction
    return true
end
-- Legacy colon-call compatibility. Unowned auto-spawns and attribute-based cup checks were removed.
function CustomerService:CreateCustomer(_spawnTarget: any, plotOwner: Player?): Model?
    if not plotOwner then
        warn("[CustomerService] CreateCustomer now requires a plot owner")
        return nil
    end
    return CustomerService.SpawnForPlayer(plotOwner)
end
function CustomerService:ServeCheck(player: Player, item: Instance?): boolean
    return deps.BlendService.GetCup(player, item) ~= nil
end
function CustomerService:GetSatisfaction(player: Player, item: Instance?, preference: string?): string
    local result = deps.BlendService.GetCup(player, item)
    if not result then
        return "D"
    end
    return CustomerService.CalculateGrade(
        result,
        preference or (front(player) and front(player).Preference) or "Surprise Me"
    )
end
function CustomerService:RefreshOrder(model: Model)
    for player, queue in queues do
        for _, record in queue.Customers do
            if record.Model == model then
                if assignRequest(player, record) and record.OrderTaken then
                    typewriterText(
                        record.Text,
                        record.Request.DisplayText,
                        record.Audio.dialogueSound,
                        CustomerService.FormatRequestText(record.Request)
                    )
                end
                return
            end
        end
    end
end
-- Snapshots expose presentation state, never mutable authoritative records.
function CustomerService.GetQueueSnapshot(player: Player): { any }
    local result = {}
    local queue = queues[player]
    if queue then
        for index, record in queue.Customers do
            table.insert(
                result,
                { Model = record.Model, RequestId = record.RequestId, Ready = record.Ready, Position = index }
            )
        end
    end
    return result
end
function CustomerService.DeactivateForPlayer(player: Player)
    local queue = queues[player]
    queues[player] = nil -- Invalidate scheduler and movement callbacks before destroying models.
    if queue and queue.PlotConnection then
        queue.PlotConnection:Disconnect()
    end
    player:SetAttribute("CustomerFlowState", "PLOT_INACTIVE")
    local models = ownedModels[player]
    ownedModels[player] = nil
    if models then
        for model in models do
            model:Destroy()
        end
    end
    if queue then
        diagnostic("flow stopped owner=" .. player.Name)
    end
end
function CustomerService.RemovePlayer(player: Player)
    CustomerService.DeactivateForPlayer(player)
    lastSpecialSpawn[player] = nil
    lastTemplates[player] = nil
    recentTemplates[player] = nil
    recentRequests[player] = nil
end
return require(script.Parent.StudioServices).Wrap("CustomerService", CustomerService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">CustomerWalk</string>
            <string name="Source"><![CDATA[--!strict
-- CustomerService owns queue destinations; this module owns locomotion and animation.
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local Movement = require(game:GetService("ReplicatedStorage").Shared.Constants.CustomerMovement)
local Placement = require(script.Parent.CustomerPlacement)
local CustomerWalk = {}
local DEFAULT_WALK = {
    R15 = "rbxassetid://507777826",
    R6 = "rbxassetid://180426354",
}
local FADE_TIME = 0.15
local WALK_WEIGHT = 1
local WALK_SPEED = 0.8
local LOAD_TIMEOUT = 5
local LOAD_POLL_INTERVAL = 0.1

-- Validate body structure only. Roblox owns the underlying animated joint representation.
local REQUIRED_PARTS = {
    R15 = {
        "HumanoidRootPart",
        "LowerTorso",
        "UpperTorso",
        "LeftUpperLeg",
        "RightUpperLeg",
        "LeftLowerLeg",
        "RightLowerLeg",
        "LeftFoot",
        "RightFoot",
    },
    R6 = { "HumanoidRootPart", "Torso", "Left Leg", "Right Leg" },
}
local OTHER_BODY_PARTS = {
    R15 = { "Head", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand" },
    R6 = { "Head", "Left Arm", "Right Arm" },
}

local function missingParts(model: Model, rig: string): { string }
    local missing = {}
    for _, name in REQUIRED_PARTS[rig] do
        local part = model:FindFirstChild(name)
        if not part or not part:IsA("BasePart") then
            table.insert(missing, name)
        end
    end
    return missing
end

function CustomerWalk.PrepareRig(model: Model, root: BasePart)
    -- Standard body parts can animate regardless of joint type.
    -- Disconnected decorative parts retain the old anchored behavior.
    local connected: { [BasePart]: boolean } = { [root] = true }
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local rig = if humanoid then humanoid.RigType.Name else ""
    if REQUIRED_PARTS[rig] and #missingParts(model, rig) == 0 then
        for _, names in { REQUIRED_PARTS[rig], OTHER_BODY_PARTS[rig] } do
            for _, name in names do
                local part = model:FindFirstChild(name)
                if part and part:IsA("BasePart") then
                    connected[part] = true
                end
            end
        end
    end
    -- Preserve existing welded accessories without treating welds as rig validation.
    local descendants = model:GetDescendants()
    local changed = true
    while changed do
        changed = false
        for _, joint in descendants do
            if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
                local a, b = joint.Part0, joint.Part1
                if a and b and a:IsDescendantOf(model) and b:IsDescendantOf(model) then
                    if connected[a] and not connected[b] then
                        connected[b], changed = true, true
                    elseif connected[b] and not connected[a] then
                        connected[a], changed = true, true
                    end
                end
            end
        end
    end
    for part in connected do
        part.Anchored = false
    end
end

-- Retain the existing non-colliding, controlled PivotTo locomotion style. These
-- constraints hold the unanchored assembly between steps and while idle, without
-- adding colliders or changing imported animation joints.
function CustomerWalk.HoldRig(model: Model, root: BasePart): (CFrame) -> ()
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        -- This route owns forces and orientation, as the old anchored route did.
        -- Keep the engine from enabling body collisions or fighting the pose hold.
        -- Animator playback remains explicitly owned by Create below.
        humanoid.EvaluateStateMachine = false
    end
    local attachment = Instance.new("Attachment")
    attachment.Name = "CustomerRouteAttachment"
    attachment.Parent = root
    local position = Instance.new("AlignPosition")
    position.Mode = Enum.PositionAlignmentMode.OneAttachment
    position.Attachment0 = attachment
    position.ApplyAtCenterOfMass = true
    position.RigidityEnabled = true
    position.Parent = root
    local orientation = Instance.new("AlignOrientation")
    orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    orientation.Attachment0 = attachment
    orientation.RigidityEnabled = true
    orientation.Parent = root
    local function pose(at: CFrame)
        model:PivotTo(at)
        position.Position = root.Position
        orientation.CFrame = root.CFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    pose(model:GetPivot())
    root.Anchored = false
    if root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end
    return pose
end

function CustomerWalk.Cancel(record: any)
    record.MoveToken = (record.MoveToken or 0) + 1
    record.Walk.SetMoving(false)
    local humanoid = record.Model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.AutoRotate = false
    end
end

-- Path factory and step clock are injectable engine boundaries for deterministic tests.
function CustomerWalk.Move(
    record: any,
    targets: { CFrame },
    finished: (boolean) -> (),
    adapter: any?,
    arrived: ((number) -> ())?
)
    CustomerWalk.Cancel(record)
    local token = record.MoveToken
    local model: Model = record.Model
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local createPath = if adapter
        then adapter.CreatePath
        else function()
            return PathfindingService:CreatePath(Movement.Agent)
        end
    local step = if adapter
        then adapter.Step
        else function()
            return RunService.Heartbeat:Wait()
        end
    local function valid(): boolean
        return model.Parent ~= nil and record.MoveToken == token
    end
    local function pose(at: CFrame)
        record.Pose(at)
    end
    local function clearApproach(destination: Vector3): boolean
        local start = model:GetPivot().Position
        local delta = destination - start
        if delta.Magnitude < 0.0001 then
            return true
        end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { model }
        params.RespectCanCollide = true
        local height = Movement.Agent.AgentHeight
        local radius = Movement.Agent.AgentRadius
        local center = start + Vector3.new(0, height / 2 - record.BottomOffset + 0.1, 0)
        return workspace:Blockcast(CFrame.new(center), Vector3.new(radius * 2, height, radius * 2), delta, params)
            == nil
    end
    local function travel(destination: CFrame, blocked: () -> boolean): boolean
        local current = model:GetPivot()
        local start = Placement.Face(current.Position, destination.Position, current)
        local goal = Placement.Face(destination.Position, destination.Position + start.LookVector, start)
        local duration = (start.Position - goal.Position).Magnitude / Movement.Speed
        local elapsed = 0
        while elapsed < duration do
            local dt = step()
            if not valid() or blocked() then
                return false
            end
            elapsed += dt
            pose(start:Lerp(goal, math.min(1, elapsed / duration)))
        end
        return valid() and not blocked()
    end
    if humanoid then
        humanoid.AutoRotate = true
    end
    record.Walk.SetMoving(true)
    task.spawn(function()
        if not valid() then
            return
        end
        local success = true
        for leg, destination in targets do
            local reached = false
            for _ = 1, Movement.MaxPathAttempts do
                if not valid() then
                    return
                end
                local path: any = nil
                local ok = pcall(function()
                    path = createPath()
                    path:ComputeAsync(
                        model:GetPivot().Position - Vector3.new(0, record.BottomOffset, 0),
                        destination.Position - Vector3.new(0, record.BottomOffset, 0)
                    )
                end)
                if not valid() then
                    if path then
                        path:Destroy()
                    end
                    return
                end
                if ok and path.Status == Enum.PathStatus.Success then
                    local blocked, index = false, 1
                    local connection = path.Blocked:Connect(function(at: number)
                        if at >= index then
                            blocked = true
                        end
                    end)
                    local function isBlocked(): boolean
                        return blocked
                    end
                    local points = path:GetWaypoints()
                    reached = #points > 0
                    for i, waypoint in points do
                        index = i
                        if waypoint.Action == Enum.PathWaypointAction.Jump then
                            reached = false
                            break
                        end
                        local at = waypoint.Position + Vector3.new(0, record.BottomOffset, 0)
                        -- Only shorten the final segment; never cut a corner just because
                        -- an earlier waypoint happens to be close to the marker.
                        if
                            i == #points
                            and (model:GetPivot().Position - destination.Position).Magnitude
                                <= Movement.FinalApproachDistance
                        then
                            break
                        end
                        if not travel(CFrame.new(at), isBlocked) then
                            reached = false
                            break
                        end
                    end
                    if reached then
                        -- Path endpoints can be projected far from an unreachable marker.
                        reached = (model:GetPivot().Position - destination.Position).Magnitude
                                <= Movement.FinalApproachDistance
                            and clearApproach(destination.Position)
                            and travel(destination, isBlocked)
                    end
                    connection:Disconnect()
                end
                if path then
                    path:Destroy()
                end
                if reached then
                    break
                end
            end
            if not reached then
                success = false
                break
            end
            if arrived and valid() then
                arrived(leg)
            end
        end
        if not valid() then
            return
        end
        record.Walk.SetMoving(false)
        if humanoid then
            humanoid.AutoRotate = false
        end
        if success then
            local start = model:GetPivot()
            local target = targets[#targets]
            local goal = Placement.Face(start.Position, start.Position + target.LookVector, target)
            local elapsed = 0
            while elapsed < Movement.TurnSeconds do
                elapsed += step()
                if not valid() then
                    return
                end
                pose(start:Lerp(goal, math.min(1, elapsed / Movement.TurnSeconds)))
            end
        end
        if valid() then
            finished(success)
        end
    end)
end

function CustomerWalk.Create(model: Model, templateName: string?)
    local track: AnimationTrack? = nil
    local animation: Animation? = nil
    local animator: Animator? = nil
    local moving, ready, destroyed = false, false, false
    local segment = 0
    local usableRig = false
    local controller = {}
    local warned = false
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local rig = if humanoid then humanoid.RigType.Name else "<no Humanoid>"
    local id = DEFAULT_WALK[rig]
    local function diagnostic(message: string)
        if RunService:IsStudio() then
            print(
                string.format(
                    "[CustomerWalk] template=%s customer=%s rig=%s animation=%s %s",
                    templateName or "<generic>",
                    model.Name,
                    rig,
                    id or "<unsupported>",
                    message
                )
            )
        end
    end
    local function warnOnce(message: string)
        if RunService:IsStudio() and not warned then
            warned = true
            warn(string.format("[CustomerWalk] template=%s rig=%s %s", templateName or model.Name, rig, message))
        end
    end
    local function snapshot(phase: string)
        if not RunService:IsStudio() then
            return
        end
        local current = track
        if current then
            diagnostic(
                string.format(
                    "%s IsPlaying=%s Length=%.3f weight=%.3f targetWeight=%.3f speed=%.3f priority=%s",
                    phase,
                    tostring(current.IsPlaying),
                    current.Length,
                    current.WeightCurrent,
                    current.WeightTarget,
                    current.Speed,
                    current.Priority.Name
                )
            )
        end
        if animator then
            for _, other in animator:GetPlayingAnimationTracks() do
                if other ~= current then
                    diagnostic(
                        string.format(
                            "competing track=%s priority=%s weight=%.3f",
                            other.Animation.AnimationId,
                            other.Priority.Name,
                            other.WeightCurrent
                        )
                    )
                end
            end
        end
    end
    local function play()
        local current = track
        if not current or not ready or not moving or destroyed then
            return
        end
        local ok, reason = pcall(function()
            current:Play(FADE_TIME, WALK_WEIGHT, WALK_SPEED)
        end)
        if not ok then
            warnOnce("Play failed: " .. tostring(reason))
        end
        diagnostic("Play success=" .. tostring(ok))
        snapshot("after Play")
        if RunService:IsStudio() then
            local token = segment
            task.delay(FADE_TIME + 0.2, function()
                if not destroyed and moving and segment == token then
                    snapshot("after fade")
                end
            end)
        end
    end
    function controller.SetMoving(value: boolean)
        if destroyed or not usableRig or value == moving then
            return
        end
        moving = value
        segment += 1
        if value then
            diagnostic("route start ready=" .. tostring(ready))
            play()
        elseif track then
            track:Stop(FADE_TIME)
            diagnostic("route stop")
        end
    end
    function controller.Destroy()
        if destroyed then
            return
        end
        destroyed = true
        moving = false
        if track then
            track:Stop(0)
            track:Destroy()
            track = nil
        end
        if animation then
            animation:Destroy()
            animation = nil
        end
    end
    if not humanoid or not id then
        diagnostic("walk disabled: missing Humanoid or unsupported rig")
        return controller
    end
    local missing = missingParts(model, rig)
    if #missing > 0 then
        warnOnce("walk skipped; missing R15/R6 body parts: " .. table.concat(missing, ", "))
        return controller
    end
    animator = humanoid:FindFirstChildOfClass("Animator")
    local foundAnimator = animator ~= nil
    if not animator then
        local created = Instance.new("Animator")
        created.Parent = humanoid
        animator = created
    end
    diagnostic("Animator=" .. (if foundAnimator then "found" else "created") .. " health=" .. tostring(humanoid.Health))
    -- Use a rig-specific standard walk, not unverified assets copied from Animate.
    -- Keep the Animation alive with its track, including while the asset loads.
    local source = Instance.new("Animation")
    source.Name = "CustomerWalkAnimation"
    source.AnimationId = id
    source.Parent = animator
    animation = source
    local ok, loaded = pcall(function()
        return (animator :: Animator):LoadAnimation(source)
    end)
    if not ok or not loaded or not loaded:IsA("AnimationTrack") then
        warnOnce("Animator present=true LoadAnimation failed: " .. tostring(loaded))
        source:Destroy()
        animation = nil
        return controller
    end
    diagnostic("Animator present=true LoadAnimation success=true Length=" .. tostring(loaded.Length))
    usableRig = true
    track = loaded
    loaded.Looped = true
    loaded.Priority = Enum.AnimationPriority.Movement
    ready = loaded.Length > 0
    if not ready then
        -- A successful LoadAnimation can return before clip data is available.
        -- Never delay the route, and never start a late track after arrival/removal.
        task.spawn(function()
            local elapsed = 0
            while not destroyed and loaded.Length <= 0 and elapsed < LOAD_TIMEOUT do
                elapsed += task.wait(LOAD_POLL_INTERVAL)
            end
            if destroyed then
                return
            end
            ready = loaded.Length > 0
            if ready then
                diagnostic("clip ready Length=" .. tostring(loaded.Length))
                play()
            else
                warnOnce("clip unavailable after timeout; check asset permissions/Output errors")
                usableRig = false
                loaded:Destroy()
                track = nil
                source:Destroy()
                animation = nil
            end
        end)
    end
    return controller
end

return CustomerWalk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">DevContentService</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local DevContentService = {}
local deps: any
function DevContentService.Init(services)
    deps = services
end
function DevContentService.IsEnabled(): boolean
    return RunService:IsStudio() and ServerStorage:GetAttribute("EnableDevContent") == true
end
local function allowed(player: Player): boolean
    if not DevContentService.IsEnabled() or player.Parent ~= game:GetService("Players") then
        return false
    end
    return true
end

function DevContentService.ValidatePlot(player: Player): (boolean, { string })
    if not allowed(player) then
        return false, { "Studio and EnableDevContent=true required" }
    end
    local plot = deps.TycoonService.GetPlot(player)
    local lines: { string } = {}
    local valid = true
    local function report(role: string, ok: boolean, detail: string?)
        valid = valid and ok
        table.insert(lines, (if ok then "PASS " else "FAIL ") .. role .. (if detail then " - " .. detail else ""))
    end
    if not plot then
        report("PlayerPlot", false, "No assigned plot in Workspace")
    else
        report(
            "PlayerPlot",
            CollectionService:HasTag(plot, "PlayerPlot")
                and (plot:IsA("Model") or plot:IsA("Folder"))
                and deps.TycoonService.GetOwner(plot) == player,
            "assigned " .. plot:GetFullName()
        )
        for _, other in CollectionService:GetTagged("PlayerPlot") do
            if other ~= plot and (other:IsDescendantOf(plot) or plot:IsDescendantOf(other)) then
                report("PlayerPlot", false, "Nested plot: " .. other:GetFullName())
            end
        end
        local stash: Instance? = nil
        for _, role in
            {
                "BlenderInput",
                "TurbineWheel",
                "DispenseButton",
                "CustomerSpawn",
                "CustomerCounter",
                "CustomerWait1",
                "CustomerWait2",
                "CustomerExit",
                "PlayerStash",
            }
        do
            local fixtures = deps.TycoonService.GetFixtures(plot, role)
            if
                role == "CustomerSpawn"
                or role == "CustomerCounter"
                or role == "CustomerWait1"
                or role == "CustomerWait2"
                or role == "CustomerExit"
            then
                local marker, reason = deps.TycoonService.GetReference(player, role)
                report(
                    role,
                    marker ~= nil,
                    if marker
                        then marker:GetFullName()
                        else "Missing/invalid marker. Must resolve to a BasePart: " .. (reason or role)
                )
            elseif #fixtures == 0 then
                report(role, false, "Missing tag inside assigned plot (tags outside this plot do not count)")
            elseif #fixtures > 1 then
                local paths = {}
                for _, fixture in fixtures do
                    table.insert(paths, fixture:GetFullName())
                end
                table.sort(paths)
                report(role, false, "Duplicate tags: " .. table.concat(paths, ", "))
            else
                local fixture = fixtures[1]
                local part = deps.TycoonService.GetReference(player, role)
                if role == "BlenderInput" and not fixture:IsA("BasePart") then
                    report(role, false, "Tag the InputZone BasePart itself: " .. fixture:GetFullName())
                elseif
                    not part
                    or not part:IsA("BasePart")
                    or not part:IsDescendantOf(plot)
                    or deps.TycoonService.GetOwner(part) ~= player
                then
                    report(role, false, "Must resolve to a BasePart in the assigned plot: " .. fixture:GetFullName())
                elseif role == "BlenderInput" and not part.CanQuery then
                    report(role, false, "CanQuery must be true: " .. part:GetFullName())
                else
                    report(role, true)
                end
                if role == "PlayerStash" then
                    stash = fixture
                end
            end
        end
        local indices: { [number]: { Instance } } = {}
        if stash then
            for _, slot in stash:GetDescendants() do
                local index = slot:GetAttribute("SlotIndex")
                if index ~= nil then
                    if
                        not slot:IsA("BasePart")
                        or type(index) ~= "number"
                        or index ~= index
                        or index % 1 ~= 0
                        or index < 1
                        or index > 10
                    then
                        report(
                            "SlotIndex",
                            false,
                            slot:GetFullName() .. " must be a BasePart with integer SlotIndex 1-10"
                        )
                    else
                        indices[index] = indices[index] or {}
                        table.insert(indices[index], slot)
                    end
                end
            end
        end
        for index = 1, 10 do
            local slots = indices[index] or {}
            if index <= 5 or #slots > 0 then
                report(
                    "SlotIndex " .. index,
                    #slots == 1,
                    if #slots == 0
                        then "Missing BasePart under tagged PlayerStash"
                        elseif #slots > 1 then "Duplicate SlotIndex"
                        else nil
                )
            end
        end
    end
    print("[Plot Validation] " .. (if plot then plot.Name else player.Name))
    for _, line in lines do
        print(line)
    end
    return valid, lines
end

local function stagingFrame(player: Player): CFrame?
    -- GetReference resolves a unique tagged BasePart inside the player's assigned plot.
    local input = deps.TycoonService.GetReference(player, "BlenderInput")
    if not input then
        return nil
    end
    return input.CFrame * CFrame.new(0, 4, 0)
end
function DevContentService.ResetBlender(player: Player): boolean
    if not allowed(player) then
        return false
    end
    deps.BlendService.Reset(player)
    return true
end
function DevContentService.SpawnIngredient(player: Player, id: string): Instance?
    if not allowed(player) then
        return nil
    end
    local at = stagingFrame(player)
    if not at then
        return nil
    end
    if not deps.IngredientService.GetDefinition(id) then
        warn("[DevContentService] Unknown ingredient: " .. tostring(id))
        return nil
    end
    return deps.IngredientService.Spawn(id, at, player)
end
function DevContentService.PrepareCombination(player: Player, ids: { string }): boolean
    if not allowed(player) or #ids < 1 or #ids > Economy.MaxIngredients then
        return false
    end
    for _, id in ids do
        if not deps.IngredientService.GetDefinition(id) then
            return false
        end
    end
    local staging = stagingFrame(player)
    if not staging then
        return false
    end
    deps.InventoryService.ClearHeld(player)
    deps.IngredientService.RemovePlayer(player)
    deps.BlendService.Reset(player)
    for index, id in ids do
        local at = staging * CFrame.new((index - (#ids + 1) / 2) * 3, 0, 0)
        if not deps.IngredientService.Spawn(id, at, player) then
            deps.IngredientService.RemovePlayer(player)
            return false
        end
    end
    return true
end
function DevContentService.SpawnCustomer(player: Player): Model?
    if not allowed(player) then
        return nil
    end
    local existing = deps.CustomerService.GetSnapshot(player)
    if existing then
        return existing.Model
    end
    deps.TycoonService.AssignPlot(player)
    if not deps.CustomerService.ActivateForPlayer(player) then
        return nil
    end
    return deps.CustomerService.SpawnForPlayer(player)
end
function DevContentService.ForceReaction(player: Player, reaction: string?): boolean
    return allowed(player) and deps.CustomerService.SetForcedReaction(player, reaction)
end
function DevContentService.ResetScene(player: Player): boolean
    if not allowed(player) then
        return false
    end
    deps.InventoryService.ClearHeld(player)
    deps.GameService.Reset(player)
    deps.BlendService.Reset(player)
    deps.IngredientService.RemovePlayer(player)
    return true
end
local function movementAllowed(player: Player): boolean
    -- Movement-only tools are safe temporary overrides; no content-spawning opt-in needed.
    if not (RunService:IsStudio() and RunService:IsServer() and RunService:IsRunning()) then
        warn("[Movement debug] Use the SERVER Command Bar during Studio Play")
        return false
    end
    if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= game:GetService("Players") then
        warn("[Movement debug] Expected a connected Player; select a player from Players")
        return false
    end
    return true
end
local function requireMovementRuntime(method: string)
    assert(
        deps and deps.MovementService and type(deps.MovementService[method]) == "function",
        "[Movement debug] Runtime MovementService." .. method .. " is not bound; sync scripts and restart Play"
    )
    assert(
        deps.SprintService and type(deps.SprintService.ResetCharacter) == "function",
        "[Movement debug] Runtime SprintService is not bound; sync scripts and restart Play"
    )
end
local function setMovementLevel(player: Player, track: string, level: number): boolean
    if not movementAllowed(player) then
        return false
    end
    if type(level) ~= "number" or level ~= level or level < 0 or level > 3 or level ~= math.floor(level) then
        warn("[Movement debug] " .. track .. " level must be an integer from 0 to 3; received " .. tostring(level))
        return false
    end
    requireMovementRuntime("SetStudioLevel")
    deps.MovementService.SetStudioLevel(player, track, level)
    if track == "SprintStamina" then
        -- Fresh full-bar timing test; real purchases still use capacity-delta behavior.
        deps.SprintService.ResetCharacter(player)
    end
    return true
end
function DevContentService.SetMovementSpeedLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "MovementSpeed", level)
end
function DevContentService.SetSprintStaminaLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "SprintStamina", level)
end
function DevContentService.SetJumpLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "Jump", level)
end
function DevContentService.ResetMovement(player: Player): boolean
    if not movementAllowed(player) then
        return false
    end
    requireMovementRuntime("ResetStudioOverrides")
    deps.MovementService.ResetStudioOverrides(player)
    deps.SprintService.ResetCharacter(player)
    return true
end
function DevContentService.PrintMovement(player: Player): string?
    if not movementAllowed(player) then
        return nil
    end
    requireMovementRuntime("GetStudioSnapshot")
    local stats, overrides = deps.MovementService.GetStudioSnapshot(player)
    local runtime = deps.SprintService.GetSnapshot(player)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local lines = { "[Movement] " .. player.Name }
    for _, track in { "MovementSpeed", "SprintStamina", "Jump" } do
        local purchased = deps.PlayerDataService.GetUpgrade(player, track) - 1
        local override = overrides[track]
        local effective = if override ~= nil then override else purchased
        table.insert(
            lines,
            string.format(
                "  %sLevel: %d (purchased: %d; Studio override: %s)",
                track,
                effective,
                purchased,
                tostring(override)
            )
        )
    end
    for _, key in { "BaseWalkSpeed", "SprintWalkSpeed", "JumpPower" } do
        table.insert(lines, "  " .. key .. " (resolved): " .. tostring(stats[key]))
    end
    for _, key in { "StaminaCurrent", "StaminaMax", "IsSprinting" } do
        table.insert(lines, "  " .. key .. ": " .. tostring(runtime[key]))
    end
    for _, key in { "WalkSpeed", "JumpPower", "JumpHeight", "UseJumpPower" } do
        table.insert(lines, "  Humanoid." .. key .. ": " .. tostring(if humanoid then (humanoid :: any)[key] else nil))
    end
    table.insert(lines, "  StunnedUntil: " .. tostring(player:GetAttribute("StunnedUntil")))
    local output = table.concat(lines, "\n")
    print(output)
    return output
end

-- Keep legacy names callable; all aliases retain the same Studio/opt-in gate.
DevContentService.ClearBlender = DevContentService.ResetBlender
DevContentService.ResetPlot = DevContentService.ResetScene
return require(script.Parent.StudioServices).Wrap("DevContentService", DevContentService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">FilmingUtil</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Events = game:GetService("ReplicatedStorage").Shared.Events
local FilmingUtil = {}
local remote: RemoteEvent?

function FilmingUtil.Init()
    if remote then
        return
    end
    local existing = Events:FindFirstChild("GameplayPresentation")
    if existing then
        assert(existing:IsA("RemoteEvent"), "GameplayPresentation must be a RemoteEvent")
        remote = existing
        return
    end
    local event = Instance.new("RemoteEvent")
    event.Name = "GameplayPresentation"
    event.Parent = Events
    remote = event
end

-- Output only: no OnServerEvent listener, reward requests, or mutable service records.
function FilmingUtil.Emit(player: Player, moment: string, payload: any)
    if remote then
        remote:FireAllClients(moment, player.UserId, payload)
    end
end

function FilmingUtil.Log(scope: string, message: string)
    if RunService:IsStudio() and ServerStorage:GetAttribute("DebugFilmLoop") == true then
        print(string.format("[%s] %s", scope, message))
    end
end

return FilmingUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local GameService = {}
local deps: any
type Session = { State: Types.DayState, Day: number, Grades: { Types.Grade }, Grade: Types.Grade?, Served: number }
local sessions: { [Player]: Session } = {}
local function publish(player: Player)
    local session = sessions[player]
    player:SetAttribute("DayState", session.State)
    player:SetAttribute("DayNumber", session.Day)
    player:SetAttribute("CustomersServedToday", session.Served)
    player:SetAttribute("DayGrade", session.Grade or "")
end
function GameService.Init(services)
    deps = services
end
function GameService.AddPlayer(player: Player)
    sessions[player] = { State = "PREP", Day = 0, Grades = {}, Grade = nil, Served = 0 }
    publish(player)
end
function GameService.GetSnapshot(player: Player): Session?
    local session = sessions[player]
    if not session then
        return nil
    end
    return {
        State = session.State,
        Day = session.Day,
        Grades = table.clone(session.Grades),
        Grade = session.Grade,
        Served = session.Served,
    }
end
-- Legacy remote/Studio entry point. Idempotently activates flow; never spawns a day batch.
function GameService.StartDay(player: Player): (boolean, string?)
    deps.TycoonService.AssignPlot(player)
    local ok = deps.CustomerService.ActivateForPlayer(player)
    return ok, if ok then nil else "No active plot"
end
function GameService.IsServing(player: Player): boolean
    return player:GetAttribute("CustomerFlowState") == "PLOT_ACTIVE"
end
-- Retained for callers compiled against the old API. Endless flow has no day completion.
function GameService.FinishDay(_player: Player): boolean
    return false
end
function GameService.CustomerServed(player: Player, grade: Types.Grade)
    local session = sessions[player]
    if not session then
        return
    end
    session.State = "SERVING"
    session.Served += 1
    session.Grade = grade
    session.Grades = { grade } -- Bounded legacy summary; lifetime stats belong to PlayerDataService.
    publish(player)
end
function GameService.ResumeDay(player: Player): boolean
    return deps.CustomerService.ActivateForPlayer(player)
end
function GameService.Reset(player: Player)
    deps.CustomerService.DeactivateForPlayer(player)
    GameService.AddPlayer(player)
end
function GameService.RemovePlayer(player: Player)
    sessions[player] = nil
end
return require(script.Parent.StudioServices).Wrap("GameService", GameService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">GameplayService</string>
            <string name="Source"><![CDATA[--!strict
-- Narrow request adapter for future inventory UI. No client-supplied state, positions, or awards.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameplayService = {}
local nextRequest: { [Player]: number } = {}
function GameplayService.Init(services: any)
    local remote = Instance.new("RemoteEvent")
    remote.Name = "GameplayRequest"
    remote.Parent = ReplicatedStorage.Shared.Events
    remote.OnServerEvent:Connect(function(player, action, id, slot)
        local now = os.clock()
        if now < (nextRequest[player] or 0) then
            return
        end
        nextRequest[player] = now + 0.15
        if type(action) ~= "string" or #action > 32 then
            return
        end
        local validId = type(id) == "string" and #id <= 64
        local validSlot = type(slot) == "number"
            and slot == slot
            and slot >= 1
            and slot <= 10
            and slot == math.floor(slot)
        if action == "StartDay" then
            services.GameService.StartDay(player)
        elseif action == "ThrowHeld" then
            services.InventoryService.ThrowHeld(player, id)
        elseif action == "ReleaseIngredient" and validId then
            services.InventoryService.ReleaseUnit(player, id)
        elseif action == "Deposit" and validId and validSlot then
            services.InventoryService.Deposit(player, id, slot)
        elseif action == "Withdraw" and validSlot then
            services.InventoryService.Withdraw(player, slot)
        elseif action == "PurchaseUpgrade" then
            local success, reason = false, "InvalidUpgrade"
            if validId then
                success, reason = services.PlayerDataService.PurchaseUpgrade(player, id, slot)
            end
            if success and (id == "MovementSpeed" or id == "Jump" or id == "SprintStamina") then
                services.MovementService.RefreshPlayer(player)
            end
            remote:FireClient(player, "PurchaseUpgradeResult", {
                success = success,
                reason = if success then "Success" else reason,
                upgradeId = if validId then id else nil,
                level = if validId and reason ~= "InvalidUpgrade"
                    then services.PlayerDataService.GetUpgrade(player, id) - 1
                    else nil,
            })
        end
    end)
end
function GameplayService.RemovePlayer(player: Player)
    nextRequest[player] = nil
end
return require(script.Parent.StudioServices).Wrap("GameplayService", GameplayService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">IngredientCarryPresentation</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IngredientCarry)
local WorldUtil = require(script.Parent.WorldUtil)
local Presentation = {}

-- Measure every oriented part in character-local space, including off-center
-- PrimaryParts. The lowest corner, rather than the root center, clears the head.
function Presentation.Offset(visual: Instance, characterRoot: BasePart, stackHeight: number?): (CFrame, number)
    local ingredientRoot = WorldUtil.Part(visual)
    assert(ingredientRoot, "Carried ingredient needs a BasePart")
    local degrees = Config.RotationDegrees
    local rotation = CFrame.Angles(math.rad(degrees.X), math.rad(degrees.Y), math.rad(degrees.Z))
    local lowest = math.huge
    local highest = -math.huge
    local parts = visual:GetDescendants()
    table.insert(parts, visual)
    for _, part in parts do
        if part:IsA("BasePart") then
            local at = rotation * ingredientRoot.CFrame:ToObjectSpace(part.CFrame)
            local half = part.Size * 0.5
            local radiusY = math.abs(at.RightVector.Y) * half.X
                + math.abs(at.UpVector.Y) * half.Y
                + math.abs(at.LookVector.Y) * half.Z
            lowest = math.min(lowest, at.Position.Y - radiusY)
            highest = math.max(highest, at.Position.Y + radiusY)
        end
    end
    local head = characterRoot.Parent and characterRoot.Parent:FindFirstChild("Head")
    local top = characterRoot.Size.Y * 0.5 + 1.5
    if head and head:IsA("BasePart") then
        local at = characterRoot.CFrame:ToObjectSpace(head.CFrame)
        top = at.Position.Y
            + (
                    math.abs(at.RightVector.Y) * head.Size.X
                    + math.abs(at.UpVector.Y) * head.Size.Y
                    + math.abs(at.LookVector.Y) * head.Size.Z
                )
                * 0.5
    end
    return CFrame.new(0, top + math.max(0, Config.HeightAboveHead) - lowest + (stackHeight or 0), -Config.ForwardOffset)
        * rotation,
        highest - lowest + Config.StackGap
end

-- Visuals live on the character independently of Backpack selection.
-- All placement is server-owned; no hand grip is created.
function Presentation.Attach(
    visual: Instance,
    host: Instance,
    root: BasePart,
    stackHeight: number?
): (CFrame, () -> (), number, (number) -> ())
    local ingredientRoot = WorldUtil.Part(visual)
    assert(ingredientRoot, "Carried ingredient needs a BasePart")
    local offset, height = Presentation.Offset(visual, root, stackHeight)
    local physical = visual :: any
    local rootToPivot = ingredientRoot.CFrame:ToObjectSpace(physical:GetPivot())
    physical:PivotTo(root.CFrame * offset * rootToPivot)
    local anchor = Instance.new("Part")
    anchor.Name = "CarryAnchor"
    anchor.Size = Vector3.new(0.1, 0.1, 0.1)
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.CanTouch = false
    anchor.CanQuery = false
    anchor.Massless = true
    anchor.CFrame = root.CFrame * offset
    anchor.Parent = host
    local parts = visual:GetDescendants()
    table.insert(parts, visual)
    -- The successful pickup consumed the authoritative world object. Its cloned
    -- visual releases every part before creating any carry welds.
    for _, part in parts do
        if part:IsA("BasePart") then
            part.Anchored = false
        end
    end
    visual:SetAttribute("FrozenUntilPickup", nil)
    for _, part in parts do
        game:GetService("CollectionService"):RemoveTag(part, "IngredientWorldItem")
        if part:IsA("ProximityPrompt") then
            part:Destroy()
        elseif part:IsA("BasePart") then
            part.CanCollide = false
            part.CanTouch = false
            part.Massless = true
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = anchor
            weld.Part1 = part
            weld.Parent = anchor
        end
    end
    visual.Parent = host
    local carryWeld = Instance.new("Weld")
    carryWeld.Name = "OverheadCarry"
    carryWeld.Part0 = root
    carryWeld.Part1 = anchor
    carryWeld.C0 = offset
    carryWeld.Parent = anchor

    return offset * rootToPivot,
        function()
            anchor:Destroy()
            visual:Destroy()
        end,
        height,
        function(amount: number)
            carryWeld.C0 = CFrame.new(0, -amount, 0) * carryWeld.C0
        end
end

return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">IngredientGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Geometry only: safe to require from the Edit-mode Command Bar; no registration.
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local WorldUtil = require(script.Parent.WorldUtil)
local Geometry = {}

-- Shared by world spawns and stash/carry visuals; registration stays in Spawn.
local function prepareAssembly(object: Instance)
    -- An explicit pivot root avoids choosing an arbitrary leaf/stem/mesh. It also
    -- keeps a no-PrimaryPart model's authored pivot unchanged when made physical.
    if object:IsA("Model") and not object.PrimaryPart then
        local root = Instance.new("Part")
        root.Name = "IngredientRoot"
        root.Size = Vector3.new(0.1, 0.1, 0.1)
        root.Transparency = 1
        root.CanCollide = false
        root.CanTouch = false
        root.Massless = true
        root.CFrame = object:GetPivot()
        root.Parent = object
        object.PrimaryPart = root
    end
    local root = WorldUtil.Part(object)
    for _, part in object:GetDescendants() do
        if root and part:IsA("BasePart") and part ~= root then
            local weld = Instance.new("WeldConstraint")
            weld.Name = "IngredientAssembly"
            weld.Part0 = root
            weld.Part1 = part
            weld.Parent = part
        end
    end
end

function Geometry.CreateVisual(id: string, definition: any): Instance?
    if not definition then
        return nil
    end
    local templates = ServerStorage:FindFirstChild("Ingredients")
    local template = templates and templates:FindFirstChild(id)
    local object: Instance
    if template and (template:IsA("Model") or template:IsA("BasePart")) and WorldUtil.Part(template) then
        object = template:Clone()
    else
        local part = Instance.new("Part")
        part.Size = Vector3.new(1.5, 1.5, 1.5)
        part.Color = definition.BlendColor
        object = part
    end
    -- Templates are geometry, not live components. Register only the new world
    -- root after its private record exists; cloned tags must not bind early.
    local descendants = object:GetDescendants()
    table.insert(descendants, object)
    for _, child in descendants do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        if child:IsA("ProximityPrompt") or child:IsA("ClickDetector") or child:IsA("LuaSourceContainer") then
            child:Destroy()
        end
    end
    prepareAssembly(object)
    return object
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">IngredientService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Definitions = require(Shared.Constants.Ingredients)
local Economy = require(Shared.Constants.Economy)
local WorldUtil = require(script.Parent.WorldUtil)
local Geometry = require(script.Parent.IngredientGeometry)
local IngredientService = {}
-- Tags/attributes are presentation metadata, never proof of ownership or validity.
local records: { [Instance]: { Id: string, Owner: Player?, Claimable: boolean } } = {}

function IngredientService.GetDefinition(id: string)
    return (Definitions :: any)[id]
end
function IngredientService.CreateVisual(id: string): Instance?
    return Geometry.CreateVisual(id, IngredientService.GetDefinition(id))
end
function IngredientService.Spawn(
    id: string,
    at: CFrame,
    owner: Player?,
    claimable: boolean?,
    options: { FreezeUntilPickup: boolean?, BeforePublish: ((Instance) -> ())? }?
): Instance?
    local object = IngredientService.CreateVisual(id)
    if not object then
        return nil
    end
    object.Name = id
    object:SetAttribute("IngredientId", id)
    object:SetAttribute("WorldItemId", HttpService:GenerateGUID(false))
    object:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
    local frozen = options ~= nil and options.FreezeUntilPickup == true
    object:SetAttribute("FrozenUntilPickup", if frozen then true else nil)
    -- Preparation has succeeded, but no world physics or pickup listeners can see it yet.
    if options and options.BeforePublish then
        options.BeforePublish(object)
    end
    local physical = object :: any
    physical:PivotTo(at)
    local root = WorldUtil.Part(object)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            part.Anchored = frozen
            part.CanQuery = true
        end
    end
    object.Parent = workspace
    if root and root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end
    records[object] = { Id = id, Owner = owner, Claimable = claimable ~= false }
    object.Destroying:Connect(function()
        records[object] = nil
    end)
    CollectionService:AddTag(object, "IngredientWorldItem")
    Debris:AddItem(object, Economy.WorldItemLifetime)
    return object
end
function IngredientService.Resolve(hit: Instance): Instance?
    local current: Instance? = hit
    while current and current ~= workspace do
        if records[current] then
            return current
        end
        current = current.Parent
    end
    return nil
end
function IngredientService.GetRecord(object: Instance): { Id: string, Owner: Player?, Claimable: boolean }?
    local record = records[object]
    if not record or not object:IsDescendantOf(workspace) then
        return nil
    end
    return table.clone(record)
end
-- Pickup callers set pickedUp only after inventory authorization/reservation succeeds.
-- Other removal paths (including cleanup) never release frozen physics.
function IngredientService.Consume(object: Instance, pickedUp: boolean?): string?
    local record = IngredientService.GetRecord(object)
    if not record then
        return nil
    end
    records[object] = nil
    if pickedUp and object:GetAttribute("FrozenUntilPickup") == true then
        local parts = object:GetDescendants()
        table.insert(parts, object)
        for _, part in parts do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end
        object:SetAttribute("FrozenUntilPickup", nil)
    end
    object:Destroy()
    return record.Id
end
function IngredientService.RemovePlayer(player: Player)
    local remove = {}
    for object, record in records do
        if record.Owner == player then
            table.insert(remove, object)
        end
    end
    for _, object in remove do
        IngredientService.Consume(object)
    end
end
return require(script.Parent.StudioServices).Wrap("IngredientService", IngredientService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">IngredientThrow</string>
            <string name="Source"><![CDATA[--!strict
local Debris = game:GetService("Debris")
local IngredientThrow = {}
local OFFSET = CFrame.new(0, 2, -5)
local GRACE_SECONDS = 0.2

-- A conceptual attachment on HRP: independent of head, body and carry geometry.
function IngredientThrow.Origin(root: BasePart): CFrame
    return root.CFrame * OFFSET
end

-- Pairwise exclusions preserve collisions with the world, blender and other players.
-- Install before publishing the object to Workspace; no global collision groups change.
function IngredientThrow.IgnoreCharacter(object: Instance, character: Model)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            for _, body in character:GetDescendants() do
                if body:IsA("BasePart") then
                    local exclusion = Instance.new("NoCollisionConstraint")
                    exclusion.Part0 = part
                    exclusion.Part1 = body
                    exclusion.Parent = part
                    Debris:AddItem(exclusion, GRACE_SECONDS)
                end
            end
        end
    end
end

return IngredientThrow
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local Types = require(Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local CarryPresentation = require(script.Parent.IngredientCarryPresentation)
local IngredientThrow = require(script.Parent.IngredientThrow)
local SmoothieItem = require(script.Parent.SmoothieItem)
local SmoothieGeometry = require(script.Parent.SmoothieGeometry)
local InventoryService = {}
local deps: any
local carried: { [Player]: { [string]: number? } } = {}
local stashes: { [Player]: { [number]: Types.StashSlot } } = {}
local stashChanged = Instance.new("BindableEvent")
InventoryService.StashChanged = stashChanged.Event
local releaseAt: { [Player]: number } = {}
local STASH_BURST_TIMEOUT = 1.2
type StashIntent = {
    Direction: "STORE" | "TAKE",
    LastInteraction: number,
}
local stashIntents: { [Player]: StashIntent } = {}
type HeldItem = {
    Tool: Tool,
    CarryItemId: number,
    VisualHost: Model?,
    ItemType: "Ingredient" | "Smoothie",
    Id: string?,
    Smoothie: Types.SmoothieData?,
    Root: BasePart,
    ClearVisual: () -> (),
    Height: number,
    ShiftDown: ((number) -> ())?,
    Releasing: boolean,
    Destroying: boolean,
    Connections: { RBXScriptConnection },
}
local held: { [Player]: { HeldItem } } = {}
local nextCarryItemId = 0
local function topItem(player: Player): HeldItem?
    local stack = held[player]
    return if stack then stack[#stack] else nil
end
local switching: { [Player]: boolean } = {}
local function selectedItem(player: Player): HeldItem?
    local stack = held[player] or {}
    for index = #stack, 1, -1 do
        if stack[index].Tool.Parent == player.Character then
            return stack[index]
        end
    end
    return nil
end
-- Client IDs are preferences, never ownership proof. Only this player's live records qualify.
local function resolveActionItem(player: Player, requestedCarryItemId: any?): HeldItem?
    local stack: { HeldItem } = held[player] or {}
    local function available(item: HeldItem): boolean
        return not item.Releasing and not item.Destroying
    end
    local selected = selectedItem(player)
    -- Smoothies keep their existing exact equipped selection, independent of ingredient hints.
    if selected and selected.ItemType == "Smoothie" and available(selected) then
        return selected
    end
    local requested = requestedCarryItemId
    if requested == nil and selected and selected.ItemType == "Ingredient" then
        requested = selected.Tool:GetAttribute("CarryItemId")
    end
    if type(requested) == "number" and requested == requested and requested > 0 and requested % 1 == 0 then
        for _, item in stack do
            if item.CarryItemId == requested and item.ItemType == "Ingredient" and available(item) then
                return item
            end
        end
    end
    for index = #stack, 1, -1 do
        local item = stack[index]
        if item.ItemType == "Ingredient" and available(item) then
            return item
        end
    end
    return nil
end
local function equipTool(player: Player, humanoid: Humanoid, tool: Tool)
    switching[player] = true
    humanoid:EquipTool(tool)
    switching[player] = nil
end
function InventoryService.GetCarryCount(player: Player): number
    return #(held[player] or {})
end
function InventoryService.GetCarryCapacity(player: Player): number
    return Upgrades.CarryCapacity[deps.PlayerDataService.GetUpgrade(player, "CarryCapacity")].Value
end
local function syncHeld(player: Player)
    -- These attributes describe the action target, including unequipped ingredient fallback.
    local top = resolveActionItem(player)
    player:SetAttribute("HeldIngredientId", if top and top.ItemType == "Ingredient" then top.Id else nil)
    player:SetAttribute("HeldItemType", if top then top.ItemType else nil)
    local hasSmoothie = false
    local stack = held[player]
    if stack then
        for _, item in stack do
            hasSmoothie = hasSmoothie or item.ItemType == "Smoothie"
        end
    end
    player:SetAttribute("HasSmoothie", hasSmoothie)
    player:SetAttribute("CarryCount", InventoryService.GetCarryCount(player))
end
local function removeAt(player: Player, index: number?)
    local stack = held[player]
    if not stack then
        return
    end
    local removedIndex = index or #stack
    local record = table.remove(stack, removedIndex)
    if not record then
        return
    end
    for _, connection in record.Connections do
        connection:Disconnect()
    end
    if #stack == 0 then
        held[player] = nil
    end
    for i = removedIndex, #stack do
        local item = stack[i]
        if item.ShiftDown then
            item.ShiftDown(record.Height)
        end
    end
    local wasEquipped = record.Tool.Parent == player.Character
    record.ClearVisual()
    if record.VisualHost then
        record.VisualHost:Destroy()
    end
    if not record.Destroying then
        record.Tool:Destroy()
    end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if wasEquipped and #stack > 0 and humanoid and humanoid.Health > 0 and not switching[player] then
        local nextItem = stack[#stack]
        -- Continue the ingredient stack when removing its selected slot in mixed carry.
        if record.ItemType == "Ingredient" then
            for i = #stack, 1, -1 do
                if stack[i].ItemType == "Ingredient" then
                    nextItem = stack[i]
                    break
                end
            end
        end
        equipTool(player, humanoid, nextItem.Tool)
    end
    syncHeld(player)
end
local function removeTop(player: Player)
    removeAt(player)
end

-- Authorization for the loose-world pickup context only. Never use this owner rule
-- as a global inventory-transfer policy: stash acquisition must separately validate
-- its server-owned slot/protection state before granting a unit or held reservation.
-- No caller-supplied owner, slot attributes, or "allow stealing" flag grants rights here.
local function getLoosePickupRecord(player: Player, object: Instance)
    local record = deps.IngredientService.GetRecord(object)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not record
        or not record.Claimable
        or (record.Owner ~= nil and record.Owner ~= player)
        or not humanoid
        or humanoid.Health <= 0
        or not WorldUtil.Near(player, object, Economy.InteractionDistance)
    then
        return nil
    end
    return record
end

function InventoryService.ClearHeld(player: Player)
    while topItem(player) do
        removeTop(player)
    end
    syncHeld(player)
end

-- Spawn is synchronous. Keep reservations through fallible geometry preparation;
-- ingredient throws clear/reflow carry before publishing the new physical object.
local function releaseHeld(player: Player, throwing: boolean, dropIndex: number?, itemIndex: number?): Instance?
    local record = if itemIndex then (held[player] or {})[itemIndex] else topItem(player)
    if not record or record.Releasing then
        return nil
    end
    record.Releasing = true
    if throwing and not record.Smoothie then
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not root or not root:IsA("BasePart") then
            record.Releasing = false
            return nil
        end
        local at = IngredientThrow.Origin(root)
        local object = deps.IngredientService.Spawn(record.Id :: string, at, nil, true, {
            BeforePublish = function(prepared: Instance)
                removeAt(player, itemIndex)
                IngredientThrow.IgnoreCharacter(prepared, character)
            end,
        })
        if not object then
            record.Releasing = false
            return nil
        end
        local part = WorldUtil.Part(object)
        if part then
            part.AssemblyLinearVelocity = at.LookVector * 25 + Vector3.new(0, 18, 0)
        end
        return object
    end
    -- Retain the original character root for death/removal, even after Character changes.
    local at = record.Root.CFrame
    -- The held[player] reservation is exclusive only while carried. Both drop
    -- and throw release ownership so anyone can claim the loose world unit.
    local offset = if throwing then CFrame.new(0, 1, -3) else CFrame.new(((dropIndex or 1) - 1) * 2, 2, -3)
    local object = if record.Smoothie
        then deps.SmoothieWorldItemService.Spawn(record.Smoothie, at * offset)
        else deps.IngredientService.Spawn(record.Id :: string, at * offset, nil, true)
    if not object then
        record.Releasing = false
        return nil
    end
    removeAt(player, itemIndex)
    local part = WorldUtil.Part(object)
    if part and throwing then
        part.AssemblyLinearVelocity = at.LookVector * 25 + Vector3.new(0, 18, 0)
    end
    return object
end

function InventoryService.DropHeld(player: Player): Instance?
    local first: Instance? = nil
    local count = InventoryService.GetCarryCount(player)
    for index = count, 1, -1 do
        local record = (held[player] or {})[index]
        if not record then
            break
        end
        local object = releaseHeld(player, false, count - index + 1, index)
        if not object then
            break
        end
        first = first or object
    end
    return first
end

-- Release all carried items before clearing any remaining character reservations.
function InventoryService.CleanupCharacter(player: Player)
    InventoryService.DropHeld(player)
    InventoryService.ClearHeld(player)
end

-- Exact selected identity takes priority; unselected/invalid ingredient hints use newest-first.
function InventoryService.ThrowHeld(player: Player, requestedCarryItemId: any?): Instance?
    local record = resolveActionItem(player, requestedCarryItemId)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not record or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
        return nil
    end
    return releaseHeld(player, true, nil, table.find(held[player], record))
end

-- Private synchronous equip path shared by loose pickup and stash withdrawal.
local function equipVisual(player: Player, id: string?, visual: Instance, smoothie: Types.SmoothieData?): boolean
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if
        InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player)
        or not backpack
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
    then
        visual:Destroy()
        return false
    end
    local stack: { HeldItem } = held[player] or {}
    local tool = if smoothie then visual :: Tool else Instance.new("Tool")
    nextCarryItemId += 1
    if smoothie then
        tool.Name = "Smoothie"
    else
        local definition = deps.IngredientService.GetDefinition(id)
        tool.Name = definition.DisplayName or (id :: string)
        tool:SetAttribute("IngredientId", id)
        tool:SetAttribute("CarryItemId", nextCarryItemId)
        tool:SetAttribute("ItemType", "Ingredient")
    end
    tool.CanBeDropped = false
    tool.RequiresHandle = smoothie ~= nil
    local height = 0
    for _, item in stack do
        if item.ItemType == "Ingredient" then
            height += item.Height
        end
    end
    local clearVisual: () -> () = function() end
    local itemHeight = 0
    local shiftDown: ((number) -> ())? = nil
    local visualHost = if smoothie then nil else Instance.new("Model")
    if visualHost then
        visualHost.Name = "IngredientCarryVisuals"
        visualHost:SetAttribute("CarryItemId", nextCarryItemId)
        visualHost.Parent = root.Parent
        local _visualOffset
        _visualOffset, clearVisual, itemHeight, shiftDown = CarryPresentation.Attach(visual, visualHost, root, height)
    end
    local reservation: HeldItem = {
        VisualHost = visualHost,
        Tool = tool,
        CarryItemId = nextCarryItemId,
        Id = id,
        ItemType = if smoothie then "Smoothie" else "Ingredient",
        Smoothie = if smoothie then SmoothieItem.Copy(smoothie) else nil,
        Root = root,
        ClearVisual = clearVisual,
        Height = itemHeight,
        ShiftDown = shiftDown,
        Releasing = false,
        Destroying = false,
        Connections = {},
    }
    table.insert(stack, reservation)
    held[player] = stack
    syncHeld(player)
    local function ownsTool(): boolean
        local current: { HeldItem } = held[player] or {}
        for _, item in current do
            if item.Tool == tool then
                return true
            end
        end
        return false
    end
    local function cleanupThisTool()
        if ownsTool() then
            InventoryService.CleanupCharacter(player)
        end
    end
    table.insert(
        reservation.Connections,
        tool.Equipped:Connect(function()
            syncHeld(player)
        end)
    )
    table.insert(
        reservation.Connections,
        tool.Unequipped:Connect(function()
            if not ownsTool() then
                return
            end
            -- Selection changes never transfer ownership or remove overhead visuals.
            syncHeld(player)
        end)
    )
    table.insert(reservation.Connections, humanoid.Died:Connect(cleanupThisTool))
    table.insert(reservation.Connections, player.CharacterRemoving:Connect(cleanupThisTool))
    table.insert(
        reservation.Connections,
        tool.Destroying:Connect(function()
            local current = held[player] or {}
            for index = #current, 1, -1 do
                local item = current[index]
                if item.Tool == tool then
                    item.Destroying = true
                    releaseHeld(player, false, nil, index)
                end
            end
        end)
    )
    tool.Parent = backpack
    equipTool(player, humanoid, tool)
    return true
end

function InventoryService.GrantSmoothie(player: Player, data: Types.SmoothieData): boolean
    if
        not carried[player]
        or not SmoothieItem.Valid(data)
        or InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player)
    then
        return false
    end
    local visual = SmoothieGeometry.CreateTool(data)
    return visual ~= nil and equipVisual(player, nil, visual, data)
end

-- Separate loose smoothie path; replicated contents never enter this transaction.
function InventoryService.CarryWorldSmoothie(player: Player, object: Instance): boolean
    if not WorldUtil.Near(player, object, Economy.InteractionDistance) then
        return false
    end
    return deps.SmoothieWorldItemService.Claim(object, function(data)
        return InventoryService.GrantSmoothie(player, data)
    end)
end

-- The equipped Tool selects its server-owned reservation; attributes never authorize contents.
function InventoryService.GetHeldSmoothie(player: Player, requested: Instance?): Types.SmoothieData?
    local record = selectedItem(player)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not record
        or record.ItemType ~= "Smoothie"
        or not record.Smoothie
        or record.Releasing
        or record.Destroying
        or record.Tool.Parent ~= player.Character
        or not humanoid
        or humanoid.Health <= 0
        or (requested ~= nil and requested ~= record.Tool)
    then
        return nil
    end
    return SmoothieItem.Copy(record.Smoothie)
end

function InventoryService.ConsumeHeldSmoothie(player: Player): Types.SmoothieData?
    local record = selectedItem(player)
    local data = InventoryService.GetHeldSmoothie(player)
    if data and record then
        removeAt(player, table.find(held[player], record))
    end
    return data
end

function InventoryService.CarryWorldItem(player: Player, object: Instance): boolean
    local record = getLoosePickupRecord(player, object)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if
        InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player)
        or not record
        or not backpack
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
    then
        return false
    end
    -- This claim-to-reservation transaction must not yield. Consume removes the server
    -- identity before another request can claim it; only the visual is cloned for carry.
    local visual = object:Clone()
    if not InventoryService.ClaimWorldItem(player, object) then
        visual:Destroy()
        return false
    end
    InventoryService.RemoveUnit(player, record.Id)
    return equipVisual(player, record.Id, visual)
end

function InventoryService.Init(services)
    deps = services
end
function InventoryService.AddPlayer(player: Player)
    stashIntents[player] = nil
    carried[player] = {}
    syncHeld(player)
    stashes[player] = {}
    for index = 1, 5 do
        stashes[player][index] =
            { SlotIndex = index, IngredientId = nil, Count = 0, Capacity = 5, Protected = index <= 2 }
    end
    stashChanged:Fire(player)
end
function InventoryService.GetStackCap(player: Player): number
    return Upgrades.StackSize[deps.PlayerDataService.GetUpgrade(player, "StackSize")].Value
end
function InventoryService.GetStashLayout(_player: Player)
    return { Slots = 5, Protected = 2 }
end
function InventoryService.GetHeldIngredientId(player: Player): string?
    local record = resolveActionItem(player)
    return if record and record.ItemType == "Ingredient" and not record.Releasing then record.Id else nil
end
function InventoryService.GetSnapshot(player: Player)
    local stash = {}
    local source = stashes[player]
    if source then
        for index, stack in source do
            stash[index] = table.clone(stack)
            if stack.Smoothie then
                stash[index].Smoothie = SmoothieItem.Copy(stack.Smoothie)
            end
        end
    end
    return {
        Carried = table.clone(carried[player] or {}),
        Stash = stash,
        Layout = InventoryService.GetStashLayout(player),
    }
end
function InventoryService.AddUnit(player: Player, id: string): boolean
    if not carried[player] or not deps.IngredientService.GetDefinition(id) then
        return false
    end
    local count = carried[player][id] or 0
    if count >= InventoryService.GetStackCap(player) then
        return false
    end
    carried[player][id] = count + 1
    return true
end
function InventoryService.RemoveUnit(player: Player, id: string): boolean
    local count = carried[player] and carried[player][id] or 0
    if count < 1 then
        return false
    end
    carried[player][id] = if count == 1 then nil else count - 1
    return true
end
function InventoryService.ClaimWorldItem(player: Player, object: Instance): boolean
    local record = getLoosePickupRecord(player, object)
    if not record then
        return false
    end
    if not InventoryService.AddUnit(player, record.Id) then
        return false
    end
    if not deps.IngredientService.Consume(object, true) then
        InventoryService.RemoveUnit(player, record.Id)
        return false
    end
    return true
end
-- Materialize ONE reserved unit. Caller cannot supply a spawn position or contents.
function InventoryService.ReleaseUnit(player: Player, id: string): Instance?
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local now = os.clock()
    if
        not root
        or not root:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0
        or now < (releaseAt[player] or 0)
        or not InventoryService.RemoveUnit(player, id)
    then
        return nil
    end
    releaseAt[player] = now + 0.25
    local object = deps.IngredientService.Spawn(id, root.CFrame * CFrame.new(0, 2, -3), player)
    if not object then
        InventoryService.AddUnit(player, id)
    end
    local part = WorldUtil.Part(object)
    if part then
        part.AssemblyLinearVelocity = root.CFrame.LookVector * 25 + Vector3.new(0, 18, 0)
    end
    return object
end
function InventoryService.DropOne(player: Player): Instance?
    if topItem(player) then
        return InventoryService.DropHeld(player)
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then
        return nil
    end
    local id = next(carried[player] or {})
    if not id then
        return nil
    end
    InventoryService.RemoveUnit(player, id)
    local object = deps.IngredientService.Spawn(id, root.CFrame * CFrame.new(0, 1, -3), nil)
    if not object then
        InventoryService.AddUnit(player, id)
    end
    return object
end
-- Resolve the unique server-tagged fixture and actual slot, never a client position.
local function getSlotPart(owner: Player, index: number): BasePart?
    if type(index) ~= "number" or index ~= index or index % 1 ~= 0 or index < 1 or index > 5 then
        return nil
    end
    local plot = deps.TycoonService.GetPlot(owner)
    if not plot then
        return nil
    end
    local fixtures = deps.TycoonService.GetFixtures(plot, "PlayerStash")
    if #fixtures ~= 1 or deps.TycoonService.GetOwner(fixtures[1]) ~= owner then
        return nil
    end
    local found: BasePart? = nil
    for _, part in fixtures[1]:GetDescendants() do
        if part:IsA("BasePart") and part:GetAttribute("SlotIndex") == index then
            if found then
                return nil
            end
            found = part
        end
    end
    return found
end
local function accessible(player: Player, owner: Player, index: number): boolean
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil
        and humanoid.Health > 0
        and WorldUtil.Near(player, getSlotPart(owner, index), Economy.InteractionDistance)
end
-- Authorization seam for future stealing. Protection lives in server state even when empty.
function InventoryService.CanWithdraw(player: Player, owner: Player, index: number): boolean
    local slot = stashes[owner] and stashes[owner][index]
    if not slot then
        return false
    end
    if player == owner then
        return true
    end
    if slot.Protected then
        return false
    end
    return false -- Unprotected theft is deliberately disabled in V1.
end
local function heldKey(record: HeldItem): string?
    return if record.Smoothie then record.Smoothie.BlendId else record.Id
end
local function slotKey(slot: Types.StashSlot): string?
    return if slot.Smoothie then slot.Smoothie.BlendId else slot.IngredientId
end
local function clearSlot(slot: Types.StashSlot)
    slot.ItemType, slot.IngredientId, slot.Smoothie = nil, nil, nil
    slot.Count, slot.Capacity = 0, 5
end
local function depositSelected(player: Player, itemType: string, key: string, index: number): boolean
    local record = resolveActionItem(player)
    if
        not record
        or record.Releasing
        or record.Destroying
        or record.ItemType ~= itemType
        or heldKey(record) ~= key
        or not accessible(player, player, index)
    then
        return false
    end
    local slot = stashes[player] and stashes[player][index]
    if not slot then
        return false
    end
    if record.ItemType == "Smoothie" then
        if slot.Count ~= 0 or not record.Smoothie then
            return false
        end
        slot.IngredientId = nil
        slot.Smoothie = SmoothieItem.Copy(record.Smoothie)
        slot.Count, slot.Capacity = 1, 1
    else
        if
            slot.Count >= 5 or (slot.Count > 0 and (slot.ItemType ~= "Ingredient" or slot.IngredientId ~= record.Id))
        then
            return false
        end
        slot.Smoothie = nil
        slot.IngredientId = record.Id
        slot.Count += 1
        slot.Capacity = 5
    end
    slot.ItemType = record.ItemType
    removeAt(player, table.find(held[player], record))
    stashChanged:Fire(player)
    return true
end
-- Preserve the legacy ingredient-only signature; id is a match assertion.
function InventoryService.Deposit(player: Player, id: string, index: number): boolean
    return depositSelected(player, "Ingredient", id, index)
end
function InventoryService.Withdraw(player: Player, index: number, stashOwner: Player?): boolean
    local owner = stashOwner or player
    if
        InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player)
        or not InventoryService.CanWithdraw(player, owner, index)
        or not accessible(player, owner, index)
    then
        return false
    end
    local slot = stashes[owner][index]
    local id = slot.IngredientId
    local smoothie = if slot.Smoothie then SmoothieItem.Copy(slot.Smoothie) else nil
    if slot.Count < 1 or (not id and not smoothie) then
        return false
    end
    local visual = if smoothie then SmoothieGeometry.CreateTool(smoothie) else deps.IngredientService.CreateVisual(id)
    if not visual then
        return false
    end
    -- No yield between reserving this unit and equipping. Failed equip restores the slot.
    slot.Count -= 1
    if slot.Count == 0 then
        clearSlot(slot)
    end
    if not equipVisual(player, id, visual, smoothie) then
        slot.Count += 1
        slot.IngredientId = id
        slot.Smoothie = if smoothie then SmoothieItem.Copy(smoothie) else nil
        slot.ItemType = if smoothie then "Smoothie" else "Ingredient"
        slot.Capacity = if smoothie then 1 else 5
        return false
    end
    stashChanged:Fire(owner)
    return true
end
function InventoryService.Steal(_player: Player, _owner: Player, _index: number): boolean
    return false
end
-- Prompt direction is server-owned and survives changes caused by each transfer.
-- Direction follows the player across slots/items; failed transfers preserve it
-- until the idle timeout after the last successful transfer.
function InventoryService.InteractStash(player: Player, index: number, owner: Player?): boolean
    local now = os.clock()
    local part = if owner then getSlotPart(owner, index) else nil
    local intent: StashIntent? = stashIntents[player]
    if intent and now - intent.LastInteraction >= STASH_BURST_TIMEOUT then
        intent = nil
        stashIntents[player] = nil
    end
    if not owner or not part then
        return false
    end
    local slot = stashes[owner] and stashes[owner][index]
    if not slot then
        return false
    end
    if not intent then
        local selected = resolveActionItem(player)
        local key = if selected then heldKey(selected) else slotKey(slot)
        local itemType: ("Ingredient" | "Smoothie")? = if selected then selected.ItemType else slot.ItemType
        if not key or not itemType then
            return false
        end
        intent = {
            Direction = if selected then "STORE" else "TAKE",
            LastInteraction = now,
        }
    end
    assert(intent)
    local success = false
    if intent.Direction == "STORE" then
        local selected = resolveActionItem(player)
        local key = if selected then heldKey(selected) else nil
        if selected and key then
            success = owner == player and depositSelected(player, selected.ItemType, key, index)
        end
    else
        success = InventoryService.Withdraw(player, index, owner)
    end
    if success then
        intent.LastInteraction = now
        stashIntents[player] = intent
    end
    return success
end
function InventoryService.RemovePlayer(player: Player)
    stashIntents[player] = nil
    InventoryService.DropHeld(player)
    InventoryService.ClearHeld(player)
    carried[player] = nil
    stashes[player] = nil
    stashChanged:Fire(player)
    releaseAt[player] = nil
end
return require(script.Parent.StudioServices).Wrap("InventoryService", InventoryService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local WorldUtil = require(script.Parent.WorldUtil)
local MarketService = {}
local CollectionService = game:GetService("CollectionService")
local deps: any
local pedestals: { [BasePart]: { Item: Instance?, RespawnAt: number, Id: string, Seconds: number } } = {}
function MarketService.Init(services)
    deps = services
end
function MarketService.Register(pedestal: BasePart)
    if
        CollectionService:HasTag(pedestal, "IngredientSpawn")
        or CollectionService:HasTag(pedestal, "AnnouncedIngredientSpawn")
    then
        warn("[MarketService] Use only one spawn tag: " .. pedestal:GetFullName())
        return
    end
    if not pedestals[pedestal] then
        local id = pedestal:GetAttribute("IngredientId")
        if typeof(id) ~= "string" or not deps.IngredientService.GetDefinition(id) then
            warn("[MarketService] Set an explicit valid IngredientId: " .. pedestal:GetFullName())
            return
        end
        local seconds = pedestal:GetAttribute("RespawnSeconds")
        if typeof(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 or seconds == math.huge then
            seconds = Economy.MarketRespawnSeconds
        end
        pedestals[pedestal] = { Item = nil, RespawnAt = 0, Id = id, Seconds = seconds :: number }
    end
end
function MarketService.Unregister(pedestal: BasePart)
    local state = pedestals[pedestal]
    pedestals[pedestal] = nil
    pedestal:SetAttribute("StockIngredientId", nil)
    if state and state.Item then
        state.Item:Destroy()
    end
end
function MarketService.Step()
    local now = os.clock()
    for pedestal, state in pedestals do
        if state.Item and not deps.IngredientService.GetRecord(state.Item) then
            -- Retire stock moved out of Workspace before allowing a replacement.
            state.Item:Destroy()
            state.Item = nil
            state.RespawnAt = now + state.Seconds
            pedestal:SetAttribute("StockIngredientId", nil)
        end
        if pedestal:IsDescendantOf(workspace) and not state.Item and now >= state.RespawnAt then
            local id = state.Id
            state.Item =
                deps.IngredientService.Spawn(id, pedestal.CFrame * CFrame.new(0, pedestal.Size.Y / 2 + 1, 0), nil, true)
            if state.Item then
                pedestal:SetAttribute("StockIngredientId", id)
            else
                state.RespawnAt = now + state.Seconds
            end
        end
    end
end
function MarketService.Claim(player: Player, pedestal: BasePart): boolean
    local state = pedestals[pedestal]
    if not state or not state.Item or not WorldUtil.Near(player, pedestal, Economy.InteractionDistance) then
        return false
    end
    if not deps.InventoryService.CarryWorldItem(player, state.Item) then
        return false
    end
    state.Item = nil
    state.RespawnAt = os.clock() + state.Seconds
    pedestal:SetAttribute("StockIngredientId", nil)
    return true
end
-- Server-only drop boundary for future ant defeat handlers.
function MarketService.SpawnDrop(at: CFrame, id: string): Instance?
    return deps.IngredientService.Spawn(id, at, nil)
end
return require(script.Parent.StudioServices).Wrap("MarketService", MarketService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local RunService = game:GetService("RunService")
local Upgrades = require(Shared.Constants.Upgrades)
local SprintConfig = require(Shared.Constants.SprintConfig)
local MovementService = {}
local data: any
type Stats = { BaseWalkSpeed: number, SprintWalkSpeed: number, MaxStamina: number, JumpPower: number }
local resolved: { [Player]: Stats } = {}
local overrides: { [Player]: { [string]: number? } } = {}
local changed = Instance.new("BindableEvent")
MovementService.Changed = changed.Event

function MovementService.Init(dependencies)
    data = dependencies.PlayerDataService
end

function MovementService.GetBaseWalkSpeed(player: Player): number
    return resolved[player].BaseWalkSpeed
end
function MovementService.GetSprintWalkSpeed(player: Player): number
    return resolved[player].SprintWalkSpeed
end
function MovementService.GetMaxStamina(player: Player): number
    return resolved[player].MaxStamina
end
function MovementService.GetJumpPower(player: Player): number
    return resolved[player].JumpPower
end

local function applyJump(player: Player, humanoid: Humanoid)
    local power = MovementService.GetJumpPower(player)
    if humanoid.UseJumpPower then
        humanoid.JumpPower = power
    else
        humanoid.JumpHeight = power * power / (2 * workspace.Gravity)
    end
end

function MovementService.RefreshPlayer(player: Player)
    local speedIndex = data.GetUpgrade(player, "MovementSpeed")
    local jumpIndex = data.GetUpgrade(player, "Jump")
    local staminaIndex = data.GetUpgrade(player, "SprintStamina")
    local debugLevels: { [string]: number? } = overrides[player] or {}
    local effectiveSpeed = if debugLevels.MovementSpeed ~= nil then debugLevels.MovementSpeed + 1 else speedIndex
    local effectiveJump = if debugLevels.Jump ~= nil then debugLevels.Jump + 1 else jumpIndex
    local effectiveStamina = if debugLevels.SprintStamina ~= nil then debugLevels.SprintStamina + 1 else staminaIndex
    local speed = Upgrades.MovementSpeed[effectiveSpeed].Value
    resolved[player] = {
        BaseWalkSpeed = speed,
        SprintWalkSpeed = speed * SprintConfig.SPRINT_SPEED_MULTIPLIER,
        MaxStamina = Upgrades.SprintStamina[effectiveStamina].Value,
        JumpPower = Upgrades.Jump[effectiveJump].Value,
    }
    player:SetAttribute("MovementSpeedLevel", effectiveSpeed - 1)
    player:SetAttribute("JumpLevel", effectiveJump - 1)
    player:SetAttribute("SprintStaminaLevel", effectiveStamina - 1)
    player:SetAttribute("BaseWalkSpeed", speed)
    player:SetAttribute("SprintWalkSpeed", resolved[player].SprintWalkSpeed)
    player:SetAttribute("StaminaMax", resolved[player].MaxStamina)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    end
    changed:Fire(player)
end

-- Bootstrap owns the sole CharacterAdded connection. Never block its other resets.
function MovementService.ApplyCharacter(player: Player, character: Model)
    MovementService.RefreshPlayer(player)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    else
        task.spawn(function()
            local pending = character:WaitForChild("Humanoid", 5)
            if pending and pending:IsA("Humanoid") and player.Character == character and resolved[player] then
                applyJump(player, pending)
            end
        end)
    end
end

local function assertStudioServer()
    assert(RunService:IsServer() and RunService:IsStudio() and RunService:IsRunning(), "Studio Play server only")
end

function MovementService.SetStudioLevel(player: Player, track: string, level: number?)
    assertStudioServer()
    assert(track == "MovementSpeed" or track == "Jump" or track == "SprintStamina", "Invalid movement track")
    assert(
        level == nil or (type(level) == "number" and level >= 0 and level <= 3 and level == math.floor(level)),
        "Invalid displayed level; expected 0-3"
    )
    assert(resolved[player] ~= nil, "Movement player is not initialized")
    local levels = overrides[player] or {}
    levels[track] = level
    overrides[player] = levels
    MovementService.RefreshPlayer(player)
end

function MovementService.ResetStudioOverrides(player: Player)
    assertStudioServer()
    overrides[player] = nil
    MovementService.RefreshPlayer(player)
end

function MovementService.GetStudioSnapshot(player: Player)
    assertStudioServer()
    local result = table.clone(resolved[player])
    return result, table.clone(overrides[player] or {})
end

function MovementService.RemovePlayer(player: Player)
    resolved[player] = nil
    overrides[player] = nil
end
return require(script.Parent.StudioServices).Wrap("MovementService", MovementService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">PhysicsService</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local PhysicsService = {}

function PhysicsService.GetSpinStrength(part: BasePart): number
    if not part or not part:IsA("BasePart") then
        return 0
    end

    local angularVelocity = part.AssemblyAngularVelocity
    return angularVelocity.Magnitude
end

function PhysicsService.GetBlendDelta(part: BasePart, deltaTime: number?): number
    -- Preserve the old one-argument API; dt-aware callers no longer depend on framerate.
    return PhysicsService.GetSpinStrength(part) * Economy.BlendProgressScale * (deltaTime or 1 / 60)
end

-- Display/debugging only; gameplay uses angular speed directly.
function PhysicsService.GetRPM(part: BasePart): number
    return PhysicsService.GetSpinStrength(part) * 60 / (2 * math.pi)
end

return PhysicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local Upgrades = require(game:GetService("ReplicatedStorage").Shared.Constants.Upgrades)
local PlayerDataService = {}
local records: { [Player]: Types.PlayerData } = {}
local entitlements: { [Player]: { [string]: boolean } } = {}

local function data(player: Player): Types.PlayerData
    assert(records[player], "PlayerDataService: player is not initialized")
    return records[player]
end
function PlayerDataService.AddPlayer(player: Player)
    records[player] = {
        Cash = 0,
        Upgrades = {
            Hand = 1,
            CarryCapacity = 1,
            StackSize = 1,
            BlendSpeed = 1,
            Payout = 1,
            MovementSpeed = 1,
            Jump = 1,
            SprintStamina = 1,
        },
        Discoveries = {},
        Stats = { CustomersServed = 0, SmoothiesMade = 0, PlayersSlapped = 0, IngredientsStolen = 0 },
    }
    entitlements[player] = { VIPStorage = false, DoubleCash = false }
    player:SetAttribute("playerCash", 0)
    player:SetAttribute("HasSmoothie", false)
    player:SetAttribute("CarryCapacity", 1)
    player:SetAttribute("CarryCapacityLevel", 0)
    for _, id in { "MovementSpeed", "Jump", "SprintStamina" } do
        player:SetAttribute(id .. "Level", 0)
    end
end
function PlayerDataService.GetSnapshot(player: Player): Types.PlayerData
    local source = data(player)
    return {
        Cash = source.Cash,
        Upgrades = table.clone(source.Upgrades),
        Discoveries = table.clone(source.Discoveries),
        Stats = table.clone(source.Stats),
    }
end
function PlayerDataService.GetCash(player: Player): number
    return data(player).Cash
end
function PlayerDataService.SetCash(player: Player, amount: number): number
    assert(amount == amount and math.abs(amount) < math.huge and amount >= 0, "Invalid cash")
    data(player).Cash = math.floor(amount)
    player:SetAttribute("playerCash", data(player).Cash)
    return data(player).Cash
end
function PlayerDataService.AddCash(player: Player, amount: number): number
    assert(amount >= 0, "Awards cannot subtract cash")
    return PlayerDataService.SetCash(player, data(player).Cash + amount)
end
function PlayerDataService.GetUpgrade(player: Player, id: string): number
    return (data(player).Upgrades :: any)[id] or 1
end
function PlayerDataService.PurchaseUpgrade(player: Player, id: string, requestedLevel: number?): (boolean, string?)
    local levels = (Upgrades :: any)[id]
    if not levels then
        return false, "InvalidUpgrade"
    end
    local nextLevel = PlayerDataService.GetUpgrade(player, id) + 1
    if id == "CarryCapacity" and requestedLevel ~= nextLevel then
        return false, "InvalidLevel"
    end
    local definition = levels[nextLevel]
    if not definition then
        return false, "MaxLevel"
    end
    if data(player).Cash < definition.Cost then
        return false, "InsufficientCash"
    end
    PlayerDataService.SetCash(player, data(player).Cash - definition.Cost)
    local ownedUpgrades = data(player).Upgrades :: any
    ownedUpgrades[id] = nextLevel
    if id == "CarryCapacity" then
        player:SetAttribute("CarryCapacity", definition.Value)
        player:SetAttribute("CarryCapacityLevel", nextLevel - 1)
    end
    if id == "MovementSpeed" or id == "Jump" or id == "SprintStamina" then
        player:SetAttribute(id .. "Level", nextLevel - 1)
    end
    return true
end
function PlayerDataService.HasEntitlement(player: Player, id: string): boolean
    return entitlements[player] ~= nil and entitlements[player][id] == true
end
-- Server-only boundary for a future verified MarketplaceService entitlement adapter.
function PlayerDataService.SetEntitlement(player: Player, id: string, enabled: boolean)
    assert(id == "VIPStorage" or id == "DoubleCash", "Unknown entitlement")
    entitlements[player][id] = enabled
end
function PlayerDataService.RecordDiscovery(player: Player, id: string)
    data(player).Discoveries[id] = true
end
function PlayerDataService.IncrementStat(player: Player, id: string)
    local stats = data(player).Stats :: any
    assert(stats[id] ~= nil, "Unknown stat")
    stats[id] += 1
end
function PlayerDataService.RemovePlayer(player: Player)
    -- TODO: persist a snapshot before releasing state; no DataStore writes in this skeleton.
    records[player] = nil
    entitlements[player] = nil
end
return require(script.Parent.StudioServices).Wrap("PlayerDataService", PlayerDataService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">SmoothieGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetic geometry only. The source Tool never becomes an inventory authority.
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local SmoothieItem = require(script.Parent.SmoothieItem)
local Geometry = {}

function Geometry.CreateTool(data: Types.SmoothieData): Tool?
    local template = ServerStorage:FindFirstChild("Smoothie")
    if not template or not template:IsA("Tool") or not template.Archivable then
        return nil
    end
    local clone = template:Clone()
    local handle = clone:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        clone:Destroy()
        return nil
    end
    -- Keep nested geometry, meshes and appearance, but rebuild all assembly joints.
    -- No scripts, prompts, live component tags or authored external welds escape.
    for _, child in clone:GetDescendants() do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        if
            child:IsA("LuaSourceContainer")
            or child:IsA("ProximityPrompt")
            or child:IsA("ClickDetector")
            or child:IsA("JointInstance")
            or child:IsA("Constraint")
            or child:IsA("WeldConstraint")
        then
            child:Destroy()
        elseif child:IsA("BasePart") then
            child.Anchored = false
            child.CanCollide = false
            child.CanTouch = false
            child.CanQuery = false
            child.Massless = true
        end
    end
    for _, tag in CollectionService:GetTags(clone) do
        CollectionService:RemoveTag(clone, tag)
    end
    clone.Enabled, clone.ManualActivationOnly = true, false
    clone.RequiresHandle, clone.CanBeDropped = true, false
    handle.Color = SmoothieItem.Result(data).Color
    for _, part in clone:GetDescendants() do
        if part:IsA("BasePart") and part ~= handle then
            local weld = Instance.new("WeldConstraint")
            weld.Name = "SmoothieAssembly"
            weld.Part0, weld.Part1 = handle, part
            weld.Parent = handle
        end
    end
    return clone
end

function Geometry.CreateVisual(data: Types.SmoothieData): Model?
    local tool = Geometry.CreateTool(data)
    if not tool then
        return nil
    end
    local handle = tool:FindFirstChild("Handle") :: BasePart
    local model = Instance.new("Model")
    model.Name = "SmoothieVisual"
    for _, child in tool:GetChildren() do
        child.Parent = model
    end
    tool:Destroy()
    handle.Name = "SmoothieRoot"
    model.PrimaryPart = handle
    return model
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">SmoothieItem</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Ingredients = require(Shared.Constants.Ingredients)
local SmoothieItem = {}

function SmoothieItem.Valid(data: Types.SmoothieData): boolean
    if
        type(data) ~= "table"
        or type(data.BlendId) ~= "string"
        or data.BlendId == ""
        or type(data.Ingredients) ~= "table"
    then
        return false
    end
    local count = 0
    for index, id in data.Ingredients do
        if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 3 or not Ingredients[id] then
            return false
        end
        count += 1
    end
    return count == 3
end

function SmoothieItem.Copy(data: Types.SmoothieData): Types.SmoothieData
    return { BlendId = data.BlendId, Ingredients = table.clone(data.Ingredients) }
end

-- Compatibility result for existing customer/film consumers. Inventory only stores IDs.
function SmoothieItem.Result(data: Types.SmoothieData): Types.Smoothie
    local sum = Vector3.zero
    local tags = {}
    for _, id in data.Ingredients do
        local definition = Ingredients[id]
        local color = definition.BlendColor
        sum += Vector3.new(color.R, color.G, color.B)
        for _, tag in definition.Tags do
            if not table.find(tags, tag) then
                table.insert(tags, tag)
            end
        end
    end
    sum /= 3
    return {
        BlendId = data.BlendId,
        Ingredients = table.clone(data.Ingredients),
        Tags = tags,
        Color = Color3.new(sum.X, sum.Y, sum.Z),
        Discovery = nil,
    }
end

return SmoothieItem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">SmoothieWorldItemService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local SmoothieItem = require(script.Parent.SmoothieItem)
local Geometry = require(script.Parent.SmoothieGeometry)
local Service = {}
type Record = { Data: Types.SmoothieData, Claiming: boolean }
local records: { [Instance]: Record } = {}

function Service.GetData(object: Instance): Types.SmoothieData?
    local record = records[object]
    return if record
            and not record.Claiming
            and object:IsDescendantOf(workspace)
        then SmoothieItem.Copy(record.Data)
        else nil
end

function Service.Spawn(data: Types.SmoothieData, at: CFrame): Model?
    if not SmoothieItem.Valid(data) then
        return nil
    end
    local object = Geometry.CreateVisual(data)
    if not object then
        return nil
    end
    object.Name = "SmoothieWorldItem"
    object:SetAttribute("BlendId", data.BlendId)
    for index = 1, 3 do
        object:SetAttribute("IngredientId" .. index, data.Ingredients[index])
    end
    object:PivotTo(at)
    local root = object.PrimaryPart :: BasePart
    root.CanCollide, root.CanQuery, root.Massless = true, true, false
    records[object] = { Data = SmoothieItem.Copy(data), Claiming = false }
    object.Destroying:Connect(function()
        records[object] = nil
    end)
    object.Parent = workspace
    if root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end
    CollectionService:AddTag(object, "SmoothieWorldItem")
    return object
end

-- Server-only transaction. The callback must not yield. Lock before inventory
-- signals can reenter; failure retains the same object and authoritative data.
function Service.Claim(object: Instance, receive: (Types.SmoothieData) -> boolean): boolean
    local data = Service.GetData(object)
    if not data then
        return false
    end
    local record = records[object]
    record.Claiming = true
    if not receive(data) then
        record.Claiming = false
        return false
    end
    records[object] = nil
    object:Destroy()
    return true
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">SprintService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SprintConfig = require(ReplicatedStorage.Shared.Constants.SprintConfig)
local getSprintEvent = require(ReplicatedStorage.Shared.Events.SprintEvents)

local SprintService = {}
local movement: any
local started = false

local staminaCurrent: { [Player]: number } = {}
local staminaMax: { [Player]: number } = {}
local isSprinting: { [Player]: boolean } = {}

local function ensurePlayer(player: Player)
    if staminaMax[player] == nil then
        staminaMax[player] = movement.GetMaxStamina(player)
    end
    if staminaCurrent[player] == nil then
        staminaCurrent[player] = staminaMax[player]
    end
    if isSprinting[player] == nil then
        isSprinting[player] = false
    end

    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
end

local function getHumanoid(player: Player): Humanoid?
    local character = player.Character
    if character == nil then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function setSprinting(player: Player, wantsToSprint: boolean)
    ensurePlayer(player)

    if wantsToSprint and staminaCurrent[player] <= 0 then
        wantsToSprint = false
    end

    local humanoid = getHumanoid(player)
    isSprinting[player] = wantsToSprint and humanoid ~= nil and humanoid.Health > 0
end

function SprintService.ApplySpeed(player: Player)
    local humanoid = getHumanoid(player)
    if humanoid then
        humanoid.WalkSpeed = if os.clock() < (tonumber(player:GetAttribute("StunnedUntil")) or 0)
            then 0
            elseif isSprinting[player] then movement.GetSprintWalkSpeed(player)
            else movement.GetBaseWalkSpeed(player)
    end
end

function SprintService.ResetCharacter(player: Player)
    ensurePlayer(player)
    isSprinting[player] = false
    staminaMax[player] = movement.GetMaxStamina(player)
    staminaCurrent[player] = staminaMax[player]
    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
    player:SetAttribute("IsSprinting", false)
    SprintService.ApplySpeed(player)
end

-- Copy authoritative runtime values for server diagnostics; never read UI attributes.
function SprintService.GetSnapshot(player: Player)
    ensurePlayer(player)
    return {
        StaminaCurrent = staminaCurrent[player],
        StaminaMax = staminaMax[player],
        IsSprinting = isSprinting[player],
    }
end

function SprintService.RemovePlayer(player: Player)
    staminaCurrent[player] = nil
    staminaMax[player] = nil
    isSprinting[player] = nil
end

function SprintService.Init(dependencies)
    if started then
        return
    end
    started = true
    movement = dependencies.MovementService
    local sprintEvent = getSprintEvent()
    movement.Changed:Connect(function(player: Player)
        SprintService.SetStaminaMax(player, movement.GetMaxStamina(player))
        SprintService.ApplySpeed(player)
    end)

    sprintEvent.OnServerEvent:Connect(function(player: Player, wantsToSprint: boolean)
        if type(wantsToSprint) ~= "boolean" then
            return
        end
        setSprinting(player, wantsToSprint)
    end)

    RunService.Heartbeat:Connect(function(deltaTime: number)
        for _, player in Players:GetPlayers() do
            ensurePlayer(player)

            local humanoid = getHumanoid(player)
            if not humanoid or humanoid.Health <= 0 then
                isSprinting[player] = false
            end
            if isSprinting[player] then
                staminaCurrent[player] =
                    math.max(0, staminaCurrent[player] - SprintConfig.STAMINA_DRAIN_RATE * deltaTime)
                if staminaCurrent[player] <= 0 then
                    isSprinting[player] = false
                end
            else
                staminaCurrent[player] =
                    math.min(staminaMax[player], staminaCurrent[player] + SprintConfig.STAMINA_REGEN_RATE * deltaTime)
            end

            -- Player attributes replicate authoritative state; SprintRequest is input only.
            player:SetAttribute("StaminaCurrent", staminaCurrent[player])

            player:SetAttribute("IsSprinting", isSprinting[player])
            SprintService.ApplySpeed(player)
        end
    end)
end

-- Extension point for future upgrades that increase a player's stamina capacity
function SprintService.SetStaminaMax(player: Player, newMax: number)
    assert(
        type(newMax) == "number" and newMax == newMax and newMax > 0 and newMax < math.huge,
        "Invalid stamina maximum"
    )
    ensurePlayer(player)
    local increase = math.max(0, newMax - staminaMax[player])
    staminaMax[player] = newMax
    staminaCurrent[player] = math.clamp(staminaCurrent[player] + increase, 0, newMax)
    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
end

return require(script.Parent.StudioServices).Wrap("SprintService", SprintService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">StudioServices</string>
            <string name="Source"><![CDATA[--!strict
-- No service requires here. Bootstrap owns initialization and publishes its live instances.
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local StudioServices = {}
local isRuntime = false
local bridgeName = "StudioServiceCalls"

local function assertStudioServer()
    assert(
        RunService:IsStudio() and RunService:IsServer() and RunService:IsRunning(),
        "[StudioServices] Use the Server Command Bar in Play mode"
    )
end

function StudioServices.BeginBootstrap()
    if RunService:IsStudio() then
        assertStudioServer()
        isRuntime = true
    end
end

function StudioServices.Publish(services: { [string]: any })
    if not RunService:IsStudio() then
        return
    end
    assertStudioServer()
    assert(isRuntime, "[StudioServices] Only server bootstrap can publish services")
    assert(not ServerStorage:FindFirstChild(bridgeName), "[StudioServices] Runtime already published")
    local bridge = Instance.new("BindableFunction")
    bridge.Name = bridgeName
    bridge.OnInvoke = function(serviceName: string, methodName: string, ...: any)
        assertStudioServer()
        assert(methodName ~= "Init", "[StudioServices] Service initialization belongs to bootstrap")
        local service = services[serviceName]
        local method = service and service[methodName]
        assert(type(method) == "function", "[StudioServices] Unknown service method")
        return method(...)
    end
    -- Parent only after the callback is ready; tooling never waits on an unbound callback.
    bridge.Parent = ServerStorage
end

function StudioServices.Wrap(name: string, service: any): any
    if not RunService:IsStudio() or isRuntime then
        return service
    end
    local proxy = {}
    for methodName, method in service do
        if type(method) == "function" then
            proxy[methodName] = function(...: any)
                assertStudioServer()
                assert(methodName ~= "Init", "[StudioServices] Service initialization belongs to bootstrap")
                local bridge = ServerStorage:FindFirstChild(bridgeName)
                assert(
                    bridge and bridge:IsA("BindableFunction"),
                    "[StudioServices] Runtime unavailable; wait for the server initialized message"
                )
                return bridge:Invoke(name, methodName, ...)
            end
        end
    end
    return proxy
end

return StudioServices
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">TycoonService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local WorldUtil = require(script.Parent.WorldUtil)
local TycoonService = {}
local data: any
local activate: ((Player) -> ())?
local deactivate: ((Player) -> ())?
local plots: { [Player]: Instance } = {}

function TycoonService.Init(playerDataService, onActivate: ((Player) -> ())?, onDeactivate: ((Player) -> ())?)
    activate = onActivate
    deactivate = onDeactivate
    data = playerDataService
end
function TycoonService.GetPlot(player: Player): Instance?
    local plot = plots[player]
    if plot and plot:IsDescendantOf(workspace) then
        return plot
    end
    return nil
end
function TycoonService.GetOwner(object: Instance): Player?
    for player, plot in plots do
        if plot:IsDescendantOf(workspace) and (object == plot or object:IsDescendantOf(plot)) then
            return player
        end
    end
    return nil
end
function TycoonService.GetFixtures(plot: Instance, role: string): { Instance }
    local fixtures = {}
    for _, object in CollectionService:GetTagged(role) do
        if object:IsDescendantOf(plot) then
            table.insert(fixtures, object)
        end
    end
    return fixtures
end

-- Compatibility runs before binding. An explicitly tagged role always wins over old names.
function TycoonService.AutoTagLegacyPlot(plot: Instance)
    CollectionService:AddTag(plot, "PlayerPlot")
    for _, role in
        {
            "BlenderInput",
            "BlenderVacuum",
            "IngredientSpawn",
            "DispenseButton",
            "CustomerSpawn",
            "CustomerCounter",
            "CustomerWait1",
            "CustomerWait2",
            "CustomerExit",
            "StartDayButton",
            "PlayerStash",
            "TurbineWheel",
        }
    do
        if #TycoonService.GetFixtures(plot, role) == 0 then
            local object = plot:FindFirstChild(role, true)
            if not object and role == "TurbineWheel" then
                local turbine = plot:FindFirstChild("Turbine", true)
                object = turbine
                    and (
                        turbine:FindFirstChild("blade", true)
                        or turbine:FindFirstChild("stem", true)
                        or WorldUtil.Part(turbine)
                    )
            end
            if object then
                CollectionService:AddTag(object, role)
            end
        end
    end
end

local customerRoles =
    { CustomerSpawn = true, CustomerCounter = true, CustomerWait1 = true, CustomerWait2 = true, CustomerExit = true }

-- Customer destinations must be explicit markers, never an arbitrary part of a tagged area.
-- Prefer tagged parts over legacy tagged containers so tagging the actual marker repairs
-- an old area-level tag without making the reference ambiguous.
local function customerReference(fixtures: { Instance }, name: string): (BasePart?, string?)
    local markers: { BasePart } = {}
    for _, fixture in fixtures do
        if fixture:IsA("BasePart") then
            table.insert(markers, fixture)
        end
    end
    if #markers == 0 then
        for _, fixture in fixtures do
            local parts: { BasePart } = {}
            local named: { BasePart } = {}
            for _, child in fixture:GetDescendants() do
                if child:IsA("BasePart") then
                    table.insert(parts, child)
                    if child.Name == name then
                        table.insert(named, child)
                    end
                end
            end
            local marker = if #named == 1 then named[1] elseif #parts == 1 then parts[1] else nil
            if not marker then
                return nil,
                    "Tag the " .. name .. " marker BasePart itself; ambiguous/empty container " .. fixture:GetFullName()
            end
            if not table.find(markers, marker) then
                table.insert(markers, marker)
            end
        end
    end
    if #markers ~= 1 then
        local paths = {}
        for _, fixture in fixtures do
            table.insert(paths, fixture:GetFullName())
        end
        return nil,
            string.format(
                "%s: expected one marker, found %d; tagged objects=[%s]",
                name,
                #markers,
                table.concat(paths, ", ")
            )
    end
    local marker = markers[1]
    if
        CollectionService:HasTag(marker, "StartDayButton")
        or marker.Name == "StartDayButton"
        or marker:FindFirstChild("StartDayPrompt")
    then
        return nil,
            name .. " resolves to Start Day button " .. marker:GetFullName() .. "; tag a separate customer marker"
    end
    return marker
end

function TycoonService.GetReference(player: Player, name: string): (BasePart?, string?)
    local plot = TycoonService.GetPlot(player)
    if not plot then
        return nil, "No assigned plot"
    end
    local fixtures = TycoonService.GetFixtures(plot, name)
    if (customerRoles :: any)[name] then
        return customerReference(fixtures, name)
    end
    if #fixtures ~= 1 then
        return nil
    end
    local fixture = fixtures[1]
    if (name == "BlenderInput" or name == "BlenderVacuum") and not fixture:IsA("BasePart") then
        return nil
    end
    local part = WorldUtil.Part(fixture)
    if part and (part == fixture or part:IsDescendantOf(fixture)) then
        return part
    end
    return nil
end
function TycoonService.AssignPlot(player: Player): Instance?
    if TycoonService.GetPlot(player) then
        return plots[player]
    end
    local candidates = CollectionService:GetTagged("PlayerPlot")
    local folder = workspace:FindFirstChild("Plots")
    if folder then
        for _, plot in folder:GetChildren() do
            if not table.find(candidates, plot) then
                TycoonService.AutoTagLegacyPlot(plot)
                table.insert(candidates, plot)
            end
        end
    end
    table.sort(candidates, function(a, b)
        return a.Name < b.Name
    end)
    for _, plot in candidates do
        if plot:IsDescendantOf(workspace) and not TycoonService.GetOwner(plot) then
            plots[player] = plot
            plot:SetAttribute("OwnerUserId", player.UserId)
            if activate then
                activate(player)
            end
            return plot
        end
    end
    warn("[TycoonService] No free PlayerPlot / workspace.Plots child for " .. player.Name)
    return nil
end
function TycoonService.RemovePlayer(player: Player)
    if deactivate then
        deactivate(player)
    end
    local plot = plots[player]
    if plot then
        plot:SetAttribute("OwnerUserId", nil)
    end
    plots[player] = nil
end
-- Compatibility with existing server callers; PlayerDataService now owns cash.
function TycoonService.GetCash(player: Player): number
    return data.GetCash(player)
end
function TycoonService.AddCash(player: Player, amount: number): number
    return data.AddCash(player, amount)
end
function TycoonService.SetCash(player: Player, amount: number): number
    return data.SetCash(player, amount)
end
return require(script.Parent.StudioServices).Wrap("TycoonService", TycoonService)
]]></string>
          </Properties>
