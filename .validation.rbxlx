        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">HealthRegen</string>
            <string name="Source"><![CDATA[--!strict
-- Tuning for HealthRegenService: deliberately much slower than Roblox's
-- built-in regeneration so surviving a fall/fight/knockback has lasting cost.
return {
    HealthRegenDelaySeconds = 10,
    HealthRegenPerSecond = 1.25,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">IngredientCarry</string>
            <string name="Source"><![CDATA[--!strict
return {
    -- Studs between the head top and the lowest ingredient corner.
    HeightAboveHead = 0.35,
    -- Consistent edge-to-edge vertical gap, including oversized ingredient templates.
    StackGap = 0.5,
    -- Positive is forward (character-local -Z).
    ForwardOffset = 0,
    RotationDegrees = Vector3.new(0, 0, 0),
}
]]></string>
          </Properties>
        </Item>
