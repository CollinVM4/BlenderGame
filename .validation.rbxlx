          <Item class="ModuleScript" referent="618">
            <Properties>
              <string name="Name">RipenessPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage").Shared
local DisplayState = require(script.Parent.Parent.UI.RipenessDisplayState)
local RadialProgress = require(script.Parent.Parent.UI.RadialProgress)
local Tooltip = require(script.Parent.Parent.UI.TutorialTooltip)
local TutorialText = require(script.Parent.Parent.UI.RipenessTutorialText)
local RipenessStyle = require(Shared.Constants.RipenessPresentation)

local Controller = {}
local started = false
local gold = RipenessStyle.IndicatorGold
local fresh = Color3.fromRGB(185, 204, 185)
local track = Color3.fromRGB(58, 68, 62)

type Pip = { Root: Frame, RadialProgress: RadialProgress.View, Center: Frame, Ripe: boolean }
type Slot = { Gui: BillboardGui?, Pips: { [string]: Pip }, Signature: string }
local function pip(parent: BillboardGui, order: number): Pip
    local root = Instance.new("Frame")
    root.Name = "RipenessPip"
    root.BackgroundTransparency = 1
    root.Size = UDim2.fromOffset(22, 22)
    root.Position = UDim2.fromOffset(18 + (order - 1) * 28, 1)
    root.Parent = parent
    local radial = RadialProgress.Create(root, gold, track)
    local center = Instance.new("Frame")
    center.Name = "Center"
    center.AnchorPoint = Vector2.new(0.5, 0.5)
    center.Position = UDim2.fromOffset(11, 11)
    center.Size = UDim2.fromOffset(7, 7)
    center.BackgroundColor3 = fresh
    center.BorderSizePixel = 0
    Instance.new("UICorner", center).CornerRadius = UDim.new(1, 0)
    center.Parent = root
    return { Root = root, RadialProgress = radial, Center = center, Ripe = false }
end

local function renderPip(view: Pip, amount: number, ripe: boolean)
    view.RadialProgress.Root.Visible = not ripe
    if not ripe then
        RadialProgress.SetProgress(view.RadialProgress, amount)
    end
    view.Center.BackgroundColor3 = if ripe then gold else fresh
    view.Center.Size = if ripe then UDim2.fromOffset(15, 15) else UDim2.fromOffset(7, 7)
    if ripe and not view.Ripe then
        view.Center.Size = UDim2.fromOffset(19, 19)
        TweenService:Create(view.Center, TweenInfo.new(0.22, Enum.EasingStyle.Back), {
            Size = UDim2.fromOffset(15, 15),
        }):Play()
    end
    view.Ripe = ripe
end

local function showTutorial(playerGui: PlayerGui)
    Tooltip.Show(playerGui, "RipenessTutorial", TutorialText.Rich())
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
    local tutorialShown = false
    local function tutorial()
        if not tutorialShown and player:GetAttribute("RipenessTutorialShown") == true then
            tutorialShown = true
            showTutorial(playerGui)
        end
    end
    player:GetAttributeChangedSignal("RipenessTutorialShown"):Connect(tutorial)
    tutorial()

    local pads: { [BasePart]: Slot } = {}
    local boundFixtures: { [Instance]: boolean } = {}
    local function bind(pad: Instance)
        if pad:IsA("BasePart") and (pad:GetAttribute("SlotIndex") ~= nil or pad.Name:match("^Slot%d+$")) then
            pads[pad] = pads[pad] or { Pips = {}, Signature = "" }
        end
    end
    local function fixture(root: Instance)
        if boundFixtures[root] then
            return
        end
        boundFixtures[root] = true
        root.Destroying:Connect(function()
            boundFixtures[root] = nil
        end)
        for _, part in root:GetDescendants() do
            bind(part)
        end
        root.DescendantAdded:Connect(bind)
        local plot = root.Parent
        if plot then
            local expansion = plot:FindFirstChild("UpgradeStash")
            if expansion then
                for _, part in expansion:GetDescendants() do
                    bind(part)
                end
            end
            plot.DescendantAdded:Connect(function(part)
                if part.Name == "UpgradeStash" then
                    for _, child in part:GetDescendants() do
                        bind(child)
                    end
                elseif part:FindFirstAncestor("UpgradeStash") then
                    bind(part)
                end
            end)
        end
    end
    for _, root in CollectionService:GetTagged("PlayerStash") do
        fixture(root)
    end
    CollectionService:GetInstanceAddedSignal("PlayerStash"):Connect(fixture)

    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        local now = workspace:GetServerTimeNow()
        for pad, slot in pads do
            if not pad:IsDescendantOf(workspace) then
                if slot.Gui then
                    slot.Gui:Destroy()
                end
                pads[pad] = nil
                continue
            end
            local slotCount = pad:GetAttribute("StashCount")
            local count = if typeof(slotCount) == "number" then slotCount else 0
            if count == 0 or pad:GetAttribute("StashItemType") ~= "Ingredient" then
                if slot.Gui then
                    slot.Gui:Destroy()
                end
                slot.Gui, slot.Signature, slot.Pips = nil, "", {}
                continue
            end
            local items, key = DisplayState.Read(pad, now)
            if not slot.Gui or slot.Signature ~= key then
                local old = slot.Pips
                if slot.Gui then
                    slot.Gui:Destroy()
                end
                local gui = Instance.new("BillboardGui")
                gui.Name = "StashRipeness"
                RipenessStyle.ConfigureIndicator(gui, pad)
                gui.AlwaysOnTop = true
                gui.ResetOnSpawn = false
                gui.Parent = playerGui
                slot.Pips = {}
                for order, item in items do
                    local view = pip(gui, order)
                    view.Ripe = old[item.Id] and old[item.Id].Ripe or item.Ripe
                    slot.Pips[item.Id] = view
                end
                slot.Gui, slot.Signature = gui, key
            end
            local gui = slot.Gui
            if gui then
                local origin = RipenessStyle.ResolveOrigin(pad)
                if gui.Adornee ~= origin then
                    gui.Adornee = origin
                end
                for _, item in items do
                    local view = slot.Pips[item.Id]
                    if view then
                        renderPip(view, item.Progress, item.Ripe or item.Progress >= 1)
                    end
                end
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="619">
            <Properties>
              <string name="Name">ScrapbookController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Presentation = require(script.Parent.Parent.UI.ScrapbookPresentation)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)
local Controller = {}
local started = false

-- Snapshot and live events share the same monotonic merge path.
function Controller.MergeDelta(state: Types.DiscoveryState, event: Types.DiscoveryEvent): boolean
    local entries = if event.Kind == "Ingredient" then state.Ingredients else state.SpecialCustomers
    if entries[event.Id] then
        return false
    end
    entries[event.Id] = true
    return true
end

function Controller.MergeSnapshot(state: Types.DiscoveryState, snapshot: Types.DiscoveryState)
    for id, discovered in snapshot.Ingredients do
        if discovered then
            Controller.MergeDelta(state, { Kind = "Ingredient", Id = id })
        end
    end
    for id, discovered in snapshot.SpecialCustomers do
        if discovered then
            Controller.MergeDelta(state, { Kind = "SpecialCustomer", Id = id })
        end
    end
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local state: Types.DiscoveryState = { Ingredients = {}, SpecialCustomers = {} }
    local view: Presentation.View? = nil
    local panel: PanelManager.Handle? = nil
    local isOpen = false
    local tab: Presentation.Tab = "Ingredients"
    local function refreshWindow()
        if view then
            view.SetWindow(isOpen, tab)
        end
    end
    task.spawn(function()
        local events = Shared:WaitForChild("Events", 10)
        if not events then
            warn("[Scrapbook] ReplicatedStorage.Shared.Events missing")
            return
        end
        local added = events:WaitForChild("DiscoveryAdded", 10)
        if not added or not added:IsA("RemoteEvent") then
            warn("[Scrapbook] ReplicatedStorage.Shared.Events.DiscoveryAdded missing or not a RemoteEvent")
            return
        end
        added.OnClientEvent:Connect(function(event: Types.DiscoveryEvent)
            if Controller.MergeDelta(state, event) and view then
                view.UpdateDiscovery(event)
            end
        end)
        local snapshot = events:WaitForChild("DiscoverySnapshot", 10)
        if not snapshot or not snapshot:IsA("RemoteFunction") then
            warn("[Scrapbook] ReplicatedStorage.Shared.Events.DiscoverySnapshot missing or not a RemoteFunction")
            return
        end
        local ok, result = pcall(function()
            return snapshot:InvokeServer()
        end)
        if ok then
            Controller.MergeSnapshot(state, result)
            if view then
                view.RenderState(state)
            end
        else
            warn("[Scrapbook] DiscoverySnapshot failed: " .. tostring(result))
        end
    end)
    task.spawn(function()
        local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui", 10)
        local gui = if playerGui then playerGui:WaitForChild("ScrapbookGui", 10) else nil
        if not gui or not gui:IsA("ScreenGui") then
            warn("[Scrapbook] PlayerGui.ScrapbookGui missing or not a ScreenGui; create it in StarterGui")
            return
        end
        local ok, result = pcall(function()
            return Presentation.Create(gui, state, {
                Open = function()
                    if panel then
                        panel.Open()
                    end
                end,
                Close = function()
                    if panel then
                        panel.Close()
                    end
                end,
                SelectTab = function(selected: Presentation.Tab)
                    tab = selected
                    refreshWindow()
                end,
            })
        end)
        if not ok then
            warn("[Scrapbook] " .. tostring(result))
            return
        end
        view = result
        local handle = PanelManager.Register("Scrapbook", {
            Open = function()
                isOpen = true
                refreshWindow()
            end,
            Close = function()
                isOpen = false
                refreshWindow()
            end,
        })
        panel = handle
        gui.Destroying:Connect(function()
            handle.Destroy()
            view = nil
        end)
        refreshWindow()
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="620">
            <Properties>
              <string name="Name">SessionInteractionController</string>
              <string name="Source"><![CDATA[--!strict
-- Preserve native/custom prompt presentation while carrying the actor's request revision.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Controller = {}
local started = false
function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local remote = events:WaitForChild("GameplayRequest") :: RemoteEvent
        ProximityPromptService.PromptTriggered:Connect(function(prompt)
            if prompt:GetAttribute("SessionInteraction") ~= true then
                return
            end
            local player = Players.LocalPlayer
            remote:FireServer("PlotInteraction", prompt, nil, {
                PlotSessionId = player:GetAttribute("PlotSessionId"),
                MembershipRevision = player:GetAttribute("PlotMembershipRevision"),
            })
        end)
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="621">
            <Properties>
              <string name="Name">SmoothiePickupPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Presentation = require(script.Parent.Parent.UI.SmoothiePickupPromptPresentation)
local Controller = {}
local started = false

-- Resolve display metadata only; the server validates its private smoothie record.
function Controller.Resolve(prompt: ProximityPrompt): (BasePart | Model)?
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        if CollectionService:HasTag(ancestor, "SmoothieWorldItem") then
            if ancestor:IsA("BasePart") or ancestor:IsA("Model") then
                return ancestor
            end
            return nil
        end
        ancestor = ancestor.Parent
    end
    return nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    type Entry = {
        InputType: Enum.ProximityPromptInputType,
        Object: Instance?,
        Id: string?,
        Cleanup: (() -> ())?,
        Update: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Entry } = {}
    local function clear(entry: Entry)
        if entry.Cleanup then
            entry.Cleanup()
        end
        entry.Cleanup, entry.Update, entry.Object, entry.Id = nil, nil, nil, nil
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if entry then
            visible[prompt] = nil
            for _, connection in entry.Connections do
                connection:Disconnect()
            end
            clear(entry)
        end
    end
    local function refresh(prompt: ProximityPrompt, entry: Entry)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled or not ProximityPromptService.Enabled then
            hide(prompt)
            return
        end
        local object = Controller.Resolve(prompt)
        local rows = if object then Presentation.Rows(object) else nil
        local id = if rows then rows[1].Id .. "/" .. rows[2].Id .. "/" .. rows[3].Id else nil
        if object and object:IsA("Model") and not object:FindFirstChildWhichIsA("BasePart", true) then
            clear(entry)
            return
        end
        if
            prompt.Style ~= Enum.ProximityPromptStyle.Custom
            or prompt:GetAttribute("SmoothiePickupPrompt") ~= true
            or not rows
            or not object
        then
            clear(entry)
            return
        end
        if entry.Object ~= (object :: Instance) or entry.Id ~= id then
            clear(entry)
            entry.Object, entry.Id = object, id
            entry.Cleanup, entry.Update = Presentation.Create(prompt, object, rows, playerGui, entry.InputType)
        elseif entry.Update then
            entry.Update()
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        hide(prompt)
        -- Track shown prompts only. No distance checks, pickup remotes, or scans.
        if prompt:GetAttribute("SmoothiePickupPrompt") ~= true and prompt.Name ~= "SmoothieCarryPrompt" then
            return
        end
        local entry: Entry = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.Destroying:Connect(function()
                hide(prompt)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(hide)
    -- Only engine-visible prompts: tracks rolling/dropped geometry and tolerates
    -- tags/ingredient rows arriving after PromptShown during replication/streaming.
    RunService.RenderStepped:Connect(function()
        for prompt, entry in visible do
            refresh(prompt, entry)
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="622">
            <Properties>
              <string name="Name">SprintController</string>
              <string name="Source"><![CDATA[--!strict
-- Detects held sprint input (keyboard Shift or mobile button) and requests it from the server.
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MobileControlLayout = require(script.Parent.Parent.UI.MobileControlLayout)
local getSprintEvent = require(ReplicatedStorage.Shared.Events.SprintEvents)

local player = game:GetService("Players").LocalPlayer
local SprintController = {}
local started = false
local requested = false
local heldShift: { [Enum.KeyCode]: boolean } = {}
local heldTouch = false

local function requestSprint(sprintEvent: RemoteEvent, wantsToSprint: boolean)
    wantsToSprint = wantsToSprint and player:GetAttribute("Stunned") ~= true
    if requested == wantsToSprint then
        return
    end
    requested = wantsToSprint
    sprintEvent:FireServer(wantsToSprint)
end

function SprintController.Init()
    if started then
        return
    end
    started = true
    local sprintEvent = getSprintEvent()
    player:GetAttributeChangedSignal("Stunned"):Connect(function()
        if player:GetAttribute("Stunned") == true then
            table.clear(heldShift)
            heldTouch = false
            requestSprint(sprintEvent, false)
        end
    end)

    UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessedEvent: boolean)
        if gameProcessedEvent then
            return
        end
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = true
            requestSprint(sprintEvent, true)
        end
    end)

    UserInputService.InputEnded:Connect(function(input: InputObject)
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = nil
            requestSprint(sprintEvent, heldTouch or next(heldShift) ~= nil)
        end
    end)

    UserInputService.WindowFocusReleased:Connect(function()
        table.clear(heldShift)
        heldTouch = false
        requestSprint(sprintEvent, false)
    end)

    local function sprintTouch(_action: string, state: Enum.UserInputState): Enum.ContextActionResult
        if state == Enum.UserInputState.Begin then
            heldTouch = player:GetAttribute("Stunned") ~= true
        elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
            heldTouch = false
        else
            return Enum.ContextActionResult.Sink
        end
        requestSprint(sprintEvent, heldTouch or next(heldShift) ~= nil)
        return Enum.ContextActionResult.Sink
    end
    ContextActionService:BindAction("SprintHeld", sprintTouch, true)
    ContextActionService:SetTitle("SprintHeld", "Sprint")
    MobileControlLayout.Register("SprintHeld")

    -- Presentation reads the server-replicated StaminaCurrent/StaminaMax/IsSprinting attributes.
end

return SprintController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="623">
            <Properties>
              <string name="Name">StandIdentityController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Constants.StandIdentity)
local Editor = require(script.Parent.Parent.UI.StandNameEditor)
local TurbineCamera = require(script.Parent.TurbineCameraController)
local Controller = {}
local player = Players.LocalPlayer
type Sequence = {
    Plot: Instance,
    Marker: BasePart,
    Character: Model,
    Camera: Camera,
    Context: any,
    CameraType: Enum.CameraType,
    Subject: (Humanoid | BasePart)?,
    From: CFrame,
    RootPosition: Vector3,
    Tween: Tween?,
    Closing: boolean,
    Saving: boolean,
    FocusUsed: boolean,
}
local current: Sequence? = nil
local ui: Editor.View
local remote: RemoteFunction
local initialized = false
local version = 0

local function humanoid(): Humanoid?
    return if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
end

local function restore(sequence: Sequence)
    if sequence.Tween then
        sequence.Tween:Cancel()
    end
    sequence.Camera:SetAttribute("StandNameEditorActive", nil)
    local subject = humanoid()
    sequence.Camera.CameraSubject = subject or sequence.Subject
    -- Never restore a borrowed Scriptable camera after this editor owns it.
    sequence.Camera.CameraType = if sequence.CameraType == Enum.CameraType.Scriptable
        then Enum.CameraType.Custom
        else sequence.CameraType
end

function Controller.Close(immediate: boolean?)
    version += 1
    local token = version
    local sequence = current
    if not sequence then
        return
    end
    local wasClosing = sequence.Closing
    sequence.Closing = true
    ui.Hide(if immediate then "immediate cancellation" else "Close")
    if sequence.Tween then
        sequence.Tween:Cancel()
    end
    if immediate or wasClosing then
        current = nil
        restore(sequence)
        return
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local offset = if root and root:IsA("BasePart") then root.Position - sequence.RootPosition else Vector3.zero
    local tween = TweenService:Create(
        sequence.Camera,
        TweenInfo.new(Config.CameraOutSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = sequence.From + offset }
    )
    sequence.Tween = tween
    tween:Play()
    task.spawn(function()
        tween.Completed:Wait()
        if token ~= version or current ~= sequence then
            return
        end
        current = nil
        restore(sequence)
    end)
end

local function valid(sequence: Sequence): boolean
    local subject = humanoid()
    return type(sequence.Context.PlotSessionId) == "string"
        and type(sequence.Context.MembershipRevision) == "number"
        and type(sequence.Context.StandNameRevision) == "number"
        and player.Parent ~= nil
        and player.Character == sequence.Character
        and sequence.Character:IsDescendantOf(workspace)
        and subject ~= nil
        and subject.Health > 0
        and workspace.CurrentCamera == sequence.Camera
        and sequence.Plot:IsDescendantOf(workspace)
        and sequence.Marker.Parent == sequence.Plot
        and sequence.Plot:FindFirstChild("SignCamera") == sequence.Marker
        and sequence.Plot:GetAttribute("OwnerUserId") == player.UserId
        and sequence.Plot:GetAttribute("PlotSessionId") == sequence.Context.PlotSessionId
        and player:GetAttribute("PlotSessionId") == sequence.Context.PlotSessionId
        and sequence.Plot:GetAttribute("PlotMembershipRevision") == sequence.Context.MembershipRevision
end

-- TODO(Settings): Reuse OpenNameEditor from Settings > Stand so the owner
-- can rename the stand after the initial claim sequence.
function Controller.OpenNameEditor(plot: Instance)
    Controller.Close(true)
    if not initialized then
        return
    end
    TurbineCamera.ReleaseCamera()
    local marker = plot:FindFirstChild("SignCamera")
    local camera, character = workspace.CurrentCamera, player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if
        not camera
        or not character
        or not root
        or not root:IsA("BasePart")
        or not marker
        or not marker:IsA("BasePart")
    then
        return
    end
    local sequence: Sequence = {
        Plot = plot,
        Marker = marker,
        Camera = camera,
        Character = character,
        Context = {
            PlotSessionId = plot:GetAttribute("PlotSessionId"),
            MembershipRevision = plot:GetAttribute("PlotMembershipRevision"),
            StandNameRevision = plot:GetAttribute("StandNameRevision"),
        },
        CameraType = camera.CameraType,
        Subject = camera.CameraSubject,
        From = camera.CFrame,
        RootPosition = root.Position,
        Closing = false,
        Saving = false,
        FocusUsed = false,
    }
    if not valid(sequence) then
        return
    end
    current = sequence
    local token = version
    camera:SetAttribute("StandNameEditorActive", true)
    camera.CameraType = Enum.CameraType.Scriptable
    local tween = TweenService:Create(
        camera,
        TweenInfo.new(Config.CameraInSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
        { CFrame = marker.CFrame }
    )
    sequence.Tween = tween
    tween:Play()
    task.spawn(function()
        tween.Completed:Wait()
        if token ~= version or current ~= sequence then
            return
        end
        if not valid(sequence) then
            Controller.Close(true)
            return
        end
        ui.Box.Text = tostring(plot:GetAttribute("StandName") or "")
        ui.Status.Text, ui.Save.Text = "", "SAVE"
        ui.Show()
        task.delay(3, function()
            if
                token == version
                and current == sequence
                and not sequence.Closing
                and not sequence.FocusUsed
                and ui.Gui.Enabled
                and valid(sequence)
            then
                ui.Box:CaptureFocus()
            end
        end)
    end)
end

function Controller.Init()
    if initialized then
        return
    end
    initialized = true
    remote = ReplicatedStorage.Shared.Events:WaitForChild("SetStandName") :: RemoteFunction
    ui = Editor.Create(player:WaitForChild("PlayerGui"), function()
        ui.TraceSelection("Save requested")
        local sequence = current
        if not sequence or sequence.Closing or sequence.Saving or not ui.Gui.Enabled then
            return
        end
        local raw = ui.Box.Text
        local text = Config.Normalize(raw)
        if not text then
            ui.Status.Text = string.format("Enter a name of 1–%d characters.", Config.MaxCharacters)
            return
        end
        sequence.Saving = true
        ui.Save.Text = "SAVING…"
        task.spawn(function()
            local ok, success, message = pcall(function()
                return remote:InvokeServer(sequence.Plot, raw, sequence.Context)
            end)
            if current ~= sequence or sequence.Closing then
                return
            end
            sequence.Saving = false
            ui.Save.Text = "SAVE"
            if ok and success then
                if type(message) == "string" then
                    ui.Box.Text = message
                end
                Controller.Close()
            else
                ui.Status.Text = if ok and type(message) == "string" then message else "Could not save. Try again."
            end
        end)
    end, function()
        Controller.Close()
    end)
    ui.Box.Focused:Connect(function()
        if current and ui.Gui.Enabled then
            current.FocusUsed = true
        end
    end)
    UserInputService.InputBegan:Connect(function(input)
        if ui.Gui.Enabled and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
            ui.TraceSelection(if input.KeyCode == Enum.KeyCode.Escape then "Escape" else "Button B")
            Controller.Close()
        end
    end)
    local function cancel()
        Controller.Close(true)
    end
    player.CharacterRemoving:Connect(cancel)
    player.CharacterAdded:Connect(cancel)
    player.AncestryChanged:Connect(function()
        if player.Parent == nil then
            cancel()
        end
    end)
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(cancel)
    ui.Gui.AncestryChanged:Connect(function()
        if not ui.Gui:IsDescendantOf(player) then
            cancel()
        end
    end)
    ui.Gui:GetPropertyChangedSignal("Enabled"):Connect(function()
        if current and not current.Closing and not ui.Gui.Enabled then
            Controller.Close()
        end
    end)
    RunService.Heartbeat:Connect(function()
        if current and not valid(current) then
            cancel()
        end
    end)
    local claimed = ReplicatedStorage.Shared.Events:WaitForChild("PlotClaimed") :: RemoteEvent
    claimed.OnClientEvent:Connect(function(plot: Instance, id: string, revision: number)
        Controller.Close(true)
        local token = version
        -- Remote events and replicated attributes can arrive on different frames.
        task.spawn(function()
            local deadline = os.clock() + 3
            repeat
                if token ~= version or not plot:IsDescendantOf(workspace) then
                    return
                end
                if
                    plot:GetAttribute("PlotSessionId") == id
                    and player:GetAttribute("PlotSessionId") == id
                    and plot:GetAttribute("PlotMembershipRevision") == revision
                then
                    Controller.OpenNameEditor(plot)
                    return
                end
                RunService.Heartbeat:Wait()
            until os.clock() >= deadline
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="624">
            <Properties>
              <string name="Name">StashExpansionController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Constants = game:GetService("ReplicatedStorage").Shared.Constants
local Upgrades = require(Constants.Upgrades)
local TextStyle = require(Constants.DialogueTextStyle)
local Style = require(script.Parent.Parent.UI.WorldBillboardStyle)
local Controller = {}
function Controller.Init()
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local pads: { [BasePart]: BillboardGui } = {}
    local function bind(object: Instance)
        if
            not object:IsA("BasePart")
            or object.Name ~= "PurchasePoint"
            or not object.Parent
            or object.Parent.Name ~= "UpgradeStash"
            or pads[object]
        then
            return
        end
        local gui = Instance.new("BillboardGui")
        gui.Name, gui.Adornee = "SecondStorageDisplay", object
        Style.ApplyBillboard(gui, { Width = 340, Height = 64, MaxDistance = 28 })
        gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
        local price =
            tostring(Upgrades.SecondStorage[2].Cost):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        for index, text in { "SECOND STORAGE", "$" .. price } do
            local label = Instance.new("TextLabel")
            Style.ApplyText(label, {})
            TextStyle.Apply(label, 24)
            label.Size, label.Position = UDim2.new(1, 0, 0, 32), UDim2.fromOffset(0, (index - 1) * 32)
            label.Text, label.TextColor3 = text, if index == 1 then TextStyle.White else TextStyle.Gold
            label.Parent = gui
        end
        gui.Enabled = false
        gui.Parent = playerGui
        pads[object] = gui
    end
    workspace.DescendantAdded:Connect(bind)
    for _, object in workspace:GetDescendants() do
        bind(object)
    end
    RunService.Heartbeat:Connect(function()
        for pad, gui in pads do
            if not pad:IsDescendantOf(workspace) then
                gui:Destroy()
                pads[pad] = nil
            else
                gui.Enabled = pad:GetAttribute("SecondStoragePad") == true and pad.CanTouch and pad.Transparency < 1
            end
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="625">
            <Properties>
              <string name="Name">StashPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Style = require(ReplicatedStorage.Shared.Constants.DialogueTextStyle)
local Economy = require(ReplicatedStorage.Shared.Constants.Economy)
local Controller = {}
local started = false

-- Cosmetic availability only; every press is validated against the server ledger.
function Controller.Unavailable(player: Player, slot: Instance, action: string): string?
    local session = player:GetAttribute("PlotSessionId")
    local friendly = session ~= nil and session == slot:GetAttribute("StashSessionId")
    local now = workspace:GetServerTimeNow()
    if not session or not slot:GetAttribute("StashSessionId") then
        return "UNAVAILABLE!"
    end
    if action == "STORE" then
        if not friendly then
            return "PROTECTED!"
        end
        local itemType = player:GetAttribute("HeldItemType")
        if not itemType then
            return "NOTHING TO STORE!"
        end
        local count = slot:GetAttribute("StashCount") or 0
        if
            count >= (slot:GetAttribute("StashCapacity") or 3)
            or (count > 0 and (itemType == "Smoothie" or slot:GetAttribute("StashItemType") == "Smoothie"))
        then
            return "SLOT FULL!"
        end
    else
        if
            not friendly
            and (
                slot:GetAttribute("StashProtected") == true
                or (
                    now >= (slot:GetAttribute("StashRaidEndsAt") or 0)
                    and now < (slot:GetAttribute("StashProtectionEndsAt") or 0)
                )
            )
        then
            return "PROTECTED!"
        end
        if (slot:GetAttribute("StashCount") or 0) == 0 then
            return "SLOT EMPTY!"
        end
        if (player:GetAttribute("CarryCount") or 0) >= (player:GetAttribute("CarryCapacity") or 3) then
            return "CARRY FULL!"
        end
    end
    return nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui")
        local remote = ReplicatedStorage.Shared:WaitForChild("Events"):WaitForChild("StashAction") :: RemoteFunction
        local gui = Instance.new("ScreenGui")
        gui.Name = "StashActions"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 15
        gui.Enabled = false
        local panel = Instance.new("Frame")
        panel.Name = "Actions"
        panel.AnchorPoint = Vector2.new(0.5, 1)
        -- Center lane avoids the right-hand Jump, Throw and Sprint controls.
        panel.Position = UDim2.fromScale(0.5, 0.72)
        panel.Size = UDim2.fromOffset(284, 112)
        panel.BackgroundTransparency = 1
        panel.Parent = gui
        local title = Instance.new("TextLabel")
        title.Name = "Count"
        title.Size = UDim2.fromOffset(284, 28)
        title.BackgroundTransparency = 1
        Style.Apply(title, 22)
        title.Parent = panel
        local feedback = Instance.new("TextLabel")
        feedback.Name = "Feedback"
        feedback.Position = UDim2.fromOffset(0, 88)
        feedback.Size = UDim2.fromOffset(284, 24)
        feedback.BackgroundTransparency = 1
        Style.Apply(feedback, 18)
        feedback.TextColor3 = Style.Gold
        feedback.Text = ""
        feedback.Parent = panel
        local buttons: { [string]: TextButton } = {}
        local scales: { [string]: UIScale } = {}
        local icons: { [string]: ImageLabel } = {}
        for i, action in { "STORE", "TAKE" } do
            local button = Instance.new("TextButton")
            button.Name = action
            button.Position = UDim2.fromOffset((i - 1) * 146, 30)
            button.Size = UDim2.fromOffset(138, 56)
            button.BackgroundColor3 = Style.Dark
            button.BackgroundTransparency = 0.12
            button.AutoButtonColor = false
            button.Selectable = true
            Style.Apply(button, 20)
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 12)
            corner.Parent = button
            local scale = Instance.new("UIScale")
            scale.Parent = button
            local icon = Instance.new("ImageLabel")
            icon.Name = "InputIcon"
            icon.Position = UDim2.fromOffset(12, 16)
            icon.Size = UDim2.fromOffset(24, 24)
            icon.BackgroundTransparency = 1
            icon.Visible = false
            icon.Parent = button
            icons[action] = icon
            scales[action] = scale
            button.Parent = panel
            buttons[action] = button
        end
        buttons.STORE.NextSelectionRight = buttons.TAKE
        buttons.STORE.NextSelectionLeft = buttons.TAKE
        buttons.TAKE.NextSelectionLeft = buttons.STORE
        buttons.TAKE.NextSelectionRight = buttons.STORE
        gui.Parent = playerGui
        local focusHighlight = Instance.new("Highlight")
        focusHighlight.Name = "StashFocus"
        focusHighlight.FillTransparency = 1
        focusHighlight.OutlineColor = Style.Gold
        focusHighlight.OutlineTransparency = 0.2
        focusHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
        focusHighlight.Enabled = false
        focusHighlight.Parent = workspace
        local focused: ProximityPrompt? = nil
        local pending = false
        local requestId = 0
        local feedbackUntil = 0
        local inputType = Enum.ProximityPromptInputType.Keyboard
        local previousSelection: GuiObject? = nil
        local function ownsSelection(): boolean
            return GuiService.SelectedObject == buttons.STORE or GuiService.SelectedObject == buttons.TAKE
        end
        local function hide()
            focused = nil
            focusHighlight.Enabled = false
            focusHighlight.Adornee = nil
            gui.Enabled = false
            ContextActionService:UnbindAction("StashTAKE")
            if ownsSelection() then
                GuiService.SelectedObject = if previousSelection and previousSelection.Parent
                    then previousSelection
                    else nil
            end
            previousSelection = nil
        end
        local function message(text: string)
            feedback.Text = text
            feedbackUntil = os.clock() + 1.3
        end
        local function refresh()
            local prompt = focused
            local slot = if prompt then prompt.Parent else nil
            if not prompt or not slot then
                return
            end
            title.Text = string.format(
                "STASH %d/%d",
                tonumber(slot:GetAttribute("StashCount")) or 0,
                tonumber(slot:GetAttribute("StashCapacity")) or 3
            )
            for _, action in { "STORE", "TAKE" } do
                local unavailable = Controller.Unavailable(player, slot, action)
                local button = buttons[action]
                button.TextColor3 = if pending or unavailable then Color3.fromRGB(140, 145, 155) else Style.White
                local hint = if inputType == Enum.ProximityPromptInputType.Touch
                    then ""
                    elseif inputType == Enum.ProximityPromptInputType.Gamepad then "[" .. (if action
                            == "STORE"
                        then "X"
                        else "Y") .. "] "
                    else "[" .. (if action == "STORE" then "E" else "R") .. "] "
                local icon = icons[action]
                icon.Visible = inputType == Enum.ProximityPromptInputType.Gamepad
                if icon.Visible then
                    icon.Image = UserInputService:GetImageForKeyCode(
                        if action == "STORE" then Enum.KeyCode.ButtonX else Enum.KeyCode.ButtonY
                    )
                    icon.ImageColor3 = button.TextColor3
                    hint = ""
                end
                button.Text = hint .. action
            end
            if os.clock() >= feedbackUntil then
                feedback.Text = ""
            end
        end
        local function press(action: string)
            local prompt = focused
            if not prompt or not prompt.Parent or pending then
                return
            end
            -- Animation is local; counts and carried items are never predicted.
            scales[action].Scale = 0.94
            task.delay(0.08, function()
                scales[action].Scale = 1
            end)
            local reason = Controller.Unavailable(player, prompt.Parent, action)
            if reason then
                message(reason)
                return
            end
            pending = true
            requestId += 1
            local context = {
                PlotSessionId = player:GetAttribute("PlotSessionId"),
                MembershipRevision = player:GetAttribute("PlotMembershipRevision"),
                TargetSessionId = prompt.Parent:GetAttribute("StashSessionId"),
                RequestId = requestId,
            }
            refresh()
            task.spawn(function()
                local ok, success, rejection = pcall(function()
                    return remote:InvokeServer(prompt, action, context)
                end)
                pending = false
                if focused == prompt then
                    if not ok or not success then
                        message(if ok and type(rejection) == "string" then rejection else "UNAVAILABLE!")
                    end
                    refresh()
                end
            end)
        end
        for _, action in { "STORE", "TAKE" } do
            buttons[action].Activated:Connect(function()
                press(action)
            end)
        end
        ProximityPromptService.PromptShown:Connect(function(prompt, shownInput)
            if prompt:GetAttribute("PlayerStashPrompt") ~= true then
                hide()
                return
            end
            hide()
            focused = prompt
            focusHighlight.Adornee = prompt.Parent
            focusHighlight.Enabled = true
            inputType = shownInput
            gui.Enabled = true
            feedback.Text = ""
            feedbackUntil = 0
            previousSelection = GuiService.SelectedObject
            if inputType == Enum.ProximityPromptInputType.Gamepad then
                GuiService.SelectedObject = buttons.STORE
            end
            ContextActionService:BindAction("StashTAKE", function(_, state)
                if UserInputService:GetFocusedTextBox() or GuiService.MenuIsOpen then
                    return Enum.ContextActionResult.Pass
                end
                if state == Enum.UserInputState.Begin then
                    press("TAKE")
                end
                return Enum.ContextActionResult.Sink
            end, false, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
            refresh()
        end)
        -- E / ButtonX already belong to the native focus prompt. Route its activation
        -- to explicit STORE rather than competing for the same input with CAS.
        ProximityPromptService.PromptTriggered:Connect(function(prompt, actor)
            if
                prompt == focused
                and actor == player
                and not UserInputService:GetFocusedTextBox()
                and not GuiService.MenuIsOpen
            then
                press("STORE")
            end
        end)
        ProximityPromptService.PromptHidden:Connect(function(prompt)
            if focused == prompt then
                hide()
            end
        end)
        UserInputService.LastInputTypeChanged:Connect(function(last)
            inputType = if last == Enum.UserInputType.Touch
                then Enum.ProximityPromptInputType.Touch
                elseif string.find(last.Name, "Gamepad") then Enum.ProximityPromptInputType.Gamepad
                else Enum.ProximityPromptInputType.Keyboard
            if focused and inputType == Enum.ProximityPromptInputType.Gamepad and not ownsSelection() then
                previousSelection = GuiService.SelectedObject
                GuiService.SelectedObject = buttons.STORE
            elseif inputType ~= Enum.ProximityPromptInputType.Gamepad and ownsSelection() then
                GuiService.SelectedObject = nil
            end
            refresh()
        end)
        RunService.Heartbeat:Connect(function()
            local prompt = focused
            if not prompt then
                return
            end
            local slot = prompt.Parent
            local character = player.Character
            local rootPart = if character then character:FindFirstChild("HumanoidRootPart") else nil
            local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
            if
                not slot
                or not slot:IsA("BasePart")
                or not prompt.Enabled
                or not prompt:IsDescendantOf(workspace)
                or not rootPart
                or not rootPart:IsA("BasePart")
                or not humanoid
                or humanoid.Health <= 0
                or (rootPart.Position - slot.Position).Magnitude > Economy.InteractionDistance
                or not player:GetAttribute("PlotSessionId")
            then
                hide()
                return
            end
            refresh()
        end)
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="626">
            <Properties>
              <string name="Name">TurbineCameraController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Controller = {}
local DURATION = 0.3
local BEFORE_CAMERA = "TurbineCameraPrepare"
local AFTER_CAMERA = "TurbineCameraRender"
local cleanup: (() -> ())? = nil
local releaseCamera: (() -> ())? = nil

function Controller.ReleaseCamera()
    if releaseCamera then
        releaseCamera()
    end
end

type View = {
    Camera: Camera,
    Root: BasePart,
    Humanoid: Humanoid,
    Zone: BasePart,
    Target: BasePart,
    Leaving: boolean,
    Elapsed: number,
    From: CFrame,
    FromFocus: CFrame,
    Normal: CFrame,
    NormalFocus: CFrame,
    RootPosition: Vector3,
    VisibilityReset: boolean,
}

local function inside(zone: BasePart, position: Vector3): boolean
    local point = zone.CFrame:PointToObjectSpace(position)
    local half = zone.Size * 0.5
    return math.abs(point.X) <= half.X and math.abs(point.Y) <= half.Y and math.abs(point.Z) <= half.Z
end

local function makeCharacterLocallyVisible(character: Model)
    for _, descendant in character:GetDescendants() do
        if descendant:IsA("BasePart") then
            descendant.LocalTransparencyModifier = 0
        end
    end
end

function Controller.Destroy()
    if cleanup then
        cleanup()
        cleanup = nil
    end
end

function Controller.Init()
    if cleanup then
        return
    end
    local player = Players.LocalPlayer
    local plot: Instance? = nil
    local view: View? = nil
    local removingCharacter: Model? = nil
    local connections: { RBXScriptConnection } = {}
    local plots: { [Instance]: { RBXScriptConnection } } = {}

    local function humanoid(): Humanoid?
        local character = player.Character
        return if character then character:FindFirstChildOfClass("Humanoid") else nil
    end

    local function restore()
        local current = view
        if not current then
            return
        end
        view = nil
        current.Camera.CameraType = Enum.CameraType.Custom
        current.Camera.CameraSubject = humanoid()
        current.Camera.CFrame = current.Normal
        current.Camera.Focus = current.NormalFocus
    end

    releaseCamera = restore

    local function resolvePlot()
        local assigned: Instance? = nil
        local session = player:GetAttribute("PlotSessionId")
        if type(session) == "string" then
            for candidate in plots do
                if candidate:IsDescendantOf(workspace) and candidate:GetAttribute("PlotSessionId") == session then
                    assigned = candidate
                    break
                end
            end
        end
        if assigned ~= plot then
            restore()
            plot = assigned
        end
    end

    local function track(candidate: Instance)
        if plots[candidate] then
            return
        end
        plots[candidate] = {
            candidate:GetAttributeChangedSignal("PlotSessionId"):Connect(resolvePlot),
            candidate.AncestryChanged:Connect(resolvePlot),
        }
        resolvePlot()
    end

    table.insert(connections, CollectionService:GetInstanceAddedSignal("PlayerPlot"):Connect(track))
    table.insert(
        connections,
        CollectionService:GetInstanceRemovedSignal("PlayerPlot"):Connect(function(candidate)
            local listeners = plots[candidate]
            if listeners then
                for _, connection in listeners do
                    connection:Disconnect()
                end
                plots[candidate] = nil
            end
            resolvePlot()
        end)
    )
    table.insert(
        connections,
        player:GetAttributeChangedSignal("PlotSessionId"):Connect(function()
            restore()
            resolvePlot()
        end)
    )
    table.insert(
        connections,
        player.CharacterRemoving:Connect(function(character)
            removingCharacter = character
            restore()
        end)
    )
    table.insert(
        connections,
        workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            if view then
                restore()
                local camera = workspace.CurrentCamera
                if camera then
                    camera.CameraType = Enum.CameraType.Custom
                    camera.CameraSubject = humanoid()
                end
            end
        end)
    )
    for _, candidate in CollectionService:GetTagged("PlayerPlot") do
        track(candidate)
    end

    -- Before Roblox's camera update, restore its unblended view during the exit.
    -- Otherwise our rendered interpolation would feed back into its next update.
    RunService:BindToRenderStep(BEFORE_CAMERA, Enum.RenderPriority.Camera.Value - 1, function()
        local character = player.Character
        local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
        local subject = humanoid()
        local camera = workspace.CurrentCamera
        if camera and camera:GetAttribute("StandNameEditorActive") then
            return
        end
        local assigned = plot
        local blender = if assigned and assigned:IsDescendantOf(workspace)
            then assigned:FindFirstChild("Blender")
            else nil
        -- Only three direct lookups on the cached plot; also handles streamed/replaced parts.
        local zone = if blender then blender:FindFirstChild("TurbineCameraZone") else nil
        local target = if blender then blender:FindFirstChild("TurbineCamera") else nil
        if
            not character
            or character == removingCharacter
            or not character:IsDescendantOf(workspace)
            or not root
            or not root:IsA("BasePart")
            or not subject
            or subject.Health <= 0
            or not camera
            or not camera:IsDescendantOf(workspace)
            or not zone
            or not zone:IsA("BasePart")
            or not target
            or not target:IsA("BasePart")
        then
            restore()
            return
        end

        local current = view
        if
            current
            and (
                current.Camera ~= camera
                or current.Root ~= root
                or current.Humanoid ~= subject
                or current.Zone ~= zone
                or current.Target ~= target
            )
        then
            restore()
            return
        end

        if inside(zone, root.Position) then
            if not current then
                current = {
                    Camera = camera,
                    Root = root,
                    Humanoid = subject,
                    Zone = zone,
                    Target = target,
                    Leaving = false,
                    Elapsed = 0,
                    From = camera.CFrame,
                    FromFocus = camera.Focus,
                    Normal = camera.CFrame,
                    NormalFocus = camera.Focus,
                    RootPosition = root.Position,
                    VisibilityReset = false,
                }
                view = current
            elseif current.Leaving then
                current.Leaving = false
                current.Elapsed = 0
                current.From = camera.CFrame
                current.FromFocus = camera.Focus
                current.RootPosition = root.Position
                current.VisibilityReset = false
            end
            camera.CameraType = Enum.CameraType.Scriptable
        elseif current and not current.Leaving then
            current.Leaving = true
            current.Elapsed = 0
            current.From = camera.CFrame
            current.FromFocus = camera.Focus
            local displacement = root.Position - current.RootPosition
            current.Normal += displacement
            current.NormalFocus += displacement
            camera.CameraSubject = subject
            camera.CameraType = Enum.CameraType.Custom
        end
        if current and current.Leaving then
            camera.CFrame = current.Normal
            camera.Focus = current.NormalFocus
        end
    end)

    RunService:BindToRenderStep(AFTER_CAMERA, Enum.RenderPriority.Camera.Value + 1, function(dt)
        local current = view
        if not current then
            return
        end
        if workspace.CurrentCamera ~= current.Camera then
            restore()
            return
        end
        current.Elapsed = math.min(current.Elapsed + dt, DURATION)
        local t = current.Elapsed / DURATION
        local alpha = t * t * (3 - 2 * t)
        local camera = current.Camera
        if current.Leaving then
            -- Sample Roblox's live result, including zoom, orbit and collision handling.
            current.Normal = camera.CFrame
            current.NormalFocus = camera.Focus
            camera.CFrame = current.From:Lerp(current.Normal, alpha)
            camera.Focus = current.FromFocus:Lerp(current.NormalFocus, alpha)
            if t == 1 then
                view = nil
            end
        else
            camera.CFrame = current.From:Lerp(current.Target.CFrame, alpha)
            camera.Focus = current.FromFocus:Lerp(CFrame.new(current.Root.Position), alpha)
            if not current.VisibilityReset then
                current.VisibilityReset = true
                local character = player.Character
                if character then
                    makeCharacterLocallyVisible(character)
                    task.defer(function()
                        if view == current and not current.Leaving and player.Character == character then
                            makeCharacterLocallyVisible(character)
                        end
                    end)
                end
            end
        end
    end)

    cleanup = function()
        RunService:UnbindFromRenderStep(BEFORE_CAMERA)
        RunService:UnbindFromRenderStep(AFTER_CAMERA)
        for _, connection in connections do
            connection:Disconnect()
        end
        for _, listeners in plots do
            for _, connection in listeners do
                connection:Disconnect()
            end
        end
        restore()
    end
    table.insert(connections, script.Destroying:Connect(Controller.Destroy))
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="627">
            <Properties>
              <string name="Name">TutorialGleamController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Targets = require(game:GetService("ReplicatedStorage").Shared.TutorialTargets)
local Controller = {}
local DEBUG_TUTORIAL_GLEAM = false
local debugSignature = ""
local spawnTarget: ObjectValue? = nil
local spawnTargetConnection: RBXScriptConnection? = nil
local player = Players.LocalPlayer
local initialized = false
local stopped = false
local removingCharacter: Model? = nil
local connections: { RBXScriptConnection } = {}
local highlights: { Highlight } = {}
local tweens: { Tween } = {}
local current: { Instance } = {}
local activeClaimHintPlot: Instance? = nil
local activeClaimHintTargets: { Instance } = {}
local glassProxy: UnionOperation? = nil
local glassSource: UnionOperation? = nil
local failedGlassSource: UnionOperation? = nil
local targetConnections: { RBXScriptConnection } = {}
local function clearClaimPin()
    activeClaimHintPlot = nil
    table.clear(activeClaimHintTargets)
end
local function claimAvailable(plot: Instance?): boolean
    return plot ~= nil and plot:IsDescendantOf(workspace) and plot:GetAttribute("PlotSessionId") == nil
end
local function clear()
    for _, tween in tweens do
        tween:Cancel()
    end
    for _, highlight in highlights do
        highlight:Destroy()
    end
    for _, connection in targetConnections do
        connection:Disconnect()
    end
    table.clear(targetConnections)
    if glassProxy then
        glassProxy:Destroy()
        glassProxy = nil
    end
    glassSource = nil
    table.clear(tweens)
    table.clear(highlights)
    table.clear(current)
end
local function plotFor(stage: string): Instance?
    if stage == "ClaimPlot" then
        local target = player:FindFirstChild("TutorialSpawnTarget")
        local intended = if target and target:IsA("ObjectValue") then target.Value else nil
        if intended and claimAvailable(intended) then
            if activeClaimHintPlot and activeClaimHintPlot ~= intended then
                clearClaimPin()
            end
            return intended
        end
        if claimAvailable(activeClaimHintPlot) then
            return activeClaimHintPlot
        end
        clearClaimPin()
        return nil
    end
    local id = player:GetAttribute("PlotSessionId")
    if id then
        for _, plot in CollectionService:GetTagged("PlayerPlot") do
            if plot:GetAttribute("PlotSessionId") == id then
                return plot
            end
        end
    end
    return nil
end
local function debugging(): boolean
    return DEBUG_TUTORIAL_GLEAM or player:GetAttribute("DebugTutorialGleam") == true
end
local function describe(object: Instance?): string
    return if object then object:GetFullName() .. " class=" .. object.ClassName else "nil"
end
local function renderDetails(object: Instance): string
    local lines = {
        "target=" .. describe(object) .. " parent=" .. describe(object.Parent) .. " inWorkspace=" .. tostring(
            object:IsDescendantOf(workspace)
        ),
    }
    local parts = object:GetDescendants()
    table.insert(parts, 1, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            table.insert(
                lines,
                "part="
                    .. describe(part)
                    .. " Transparency="
                    .. tostring(part.Transparency)
                    .. " LocalTransparencyModifier="
                    .. tostring(part.LocalTransparencyModifier)
                    .. " Material="
                    .. tostring(part.Material)
                    .. " Size="
                    .. tostring(part.Size)
            )
        end
    end
    return table.concat(lines, "\n")
end
local function diagnose(stage: any, plot: Instance?, targets: { Instance })
    if not debugging() then
        debugSignature = ""
        return
    end
    local lines = {
        "stage="
            .. tostring(stage)
            .. " hintReady="
            .. tostring(player:GetAttribute("TutorialHintReady"))
            .. " active="
            .. tostring(player:GetAttribute("TutorialActive")),
        "plot=" .. describe(plot),
    }
    local slot = player:GetAttribute("TutorialStashSlot")
    local roots: { Instance } = if type(stage) == "string"
        then Targets.GetRoots(plot, stage, if type(slot) == "number" then slot else nil)
        else {}
    local keys = table.clone(lines)
    table.insert(keys, "adornableTargets=" .. tostring(#targets))
    for _, root in roots do
        table.insert(keys, describe(root))
    end
    local signature = table.concat(keys, "\n")
    if signature == debugSignature then
        return
    end
    debugSignature = signature
    for _, root in roots do
        table.insert(lines, renderDetails(root))
    end
    if #roots == 0 and type(stage) == "string" then
        table.insert(
            lines,
            if stage == "ClaimPlot" and not plot
                then "ClaimPlot: TutorialSpawnTarget=nil"
                elseif stage == "Blender" then "Blender: Glass target missing"
                else stage .. ": authored target missing"
        )
    elseif #targets == 0 then
        table.insert(
            lines,
            "No adornable target (hint inactive, character unavailable, or assembly has no visible parts)"
        )
    end
    print("[TutorialGleam] " .. table.concat(lines, "\n"))
end
-- This workaround is deliberately exclusive to the authored Blender.Glass union.
local function createGlassProxy(source: UnionOperation): UnionOperation?
    local clone = source:Clone()
    if not clone then
        return nil
    end
    for _, child in clone:GetChildren() do
        child:Destroy()
    end
    for name in clone:GetAttributes() do
        clone:SetAttribute(name, nil)
    end
    for _, tag in CollectionService:GetTags(clone) do
        CollectionService:RemoveTag(clone, tag)
    end
    clone.Name = "TutorialGlassGleamProxy"
    clone.Anchored = true
    clone.CanCollide, clone.CanTouch, clone.CanQuery = false, false, false
    clone.CastShadow = false
    clone.Transparency = 1
    clone.LocalTransparencyModifier = 0
    clone.Material = Enum.Material.Glass
    clone.CFrame, clone.Size = source.CFrame, source.Size
    clone.Parent = workspace
    return clone
end
local function refresh()
    if stopped then
        return
    end
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    local stage = player:GetAttribute("TutorialStage")
    if
        stage ~= "ClaimPlot"
        or player:GetAttribute("TutorialActive") ~= true
        or player:GetAttribute("PlotSessionId") ~= nil
    then
        clearClaimPin()
    end
    local targets: { Instance } = {}
    local plot = if type(stage) == "string" then plotFor(stage) else nil
    if
        player.Parent ~= nil
        and character
        and character ~= removingCharacter
        and character:IsDescendantOf(workspace)
        and humanoid
        and humanoid.Health > 0
        and player:GetAttribute("TutorialActive") == true
        and player:GetAttribute("TutorialHintReady") == true
        and type(stage) == "string"
    then
        if stage ~= "ClaimPlot" or player:GetAttribute("PlotSessionId") == nil then
            local slot = player:GetAttribute("TutorialStashSlot")
            local customer = player:FindFirstChild("TutorialCustomerTarget")
            targets = Targets.Resolve(
                plot,
                stage,
                if type(slot) == "number" then slot else nil,
                if customer and customer:IsA("ObjectValue") then customer.Value else nil
            )
        end
        if stage == "ClaimPlot" and activeClaimHintPlot == plot and #activeClaimHintTargets > 0 then
            local valid = #targets == #activeClaimHintTargets
            for _, target in activeClaimHintTargets do
                if not target:IsDescendantOf(workspace) or not table.find(targets, target) then
                    valid = false
                    break
                end
            end
            if valid then
                targets = table.clone(activeClaimHintTargets)
            else
                table.clear(activeClaimHintTargets)
            end
        end
    end
    diagnose(stage, plot, targets)
    local same = #targets == #current
    for i, object in targets do
        if current[i] ~= object then
            same = false
            break
        end
    end
    if same and glassProxy and glassSource then
        if glassProxy.Parent ~= workspace then
            same = false
        else
            glassProxy.CFrame, glassProxy.Size = glassSource.CFrame, glassSource.Size
        end
    end
    if same then
        return
    end
    clear()
    for _, object in targets do
        local adornee = object
        if stage == "Blender" and object:IsA("UnionOperation") and Targets.GetRoots(plot, "Blender")[1] == object then
            local proxy = createGlassProxy(object)
            if not proxy then
                if debugging() and failedGlassSource ~= object then
                    failedGlassSource = object
                    warn("[TutorialGleam] Blender.Glass could not be cloned; retrying")
                end
                continue
            end
            failedGlassSource = nil
            glassProxy, glassSource = proxy, object
            adornee = proxy
        end
        table.insert(targetConnections, object.Destroying:Connect(clear))
        table.insert(
            targetConnections,
            object.AncestryChanged:Connect(function()
                if not object:IsDescendantOf(workspace) then
                    clear()
                end
            end)
        )
        local highlight = Instance.new("Highlight")
        highlight.Name = "TutorialGleam"
        highlight.Adornee = adornee
        highlight.Enabled = true
        highlight.FillColor = Color3.fromRGB(255, 224, 65)
        highlight.OutlineColor = Color3.fromRGB(255, 250, 205)
        highlight.FillTransparency, highlight.OutlineTransparency = 0.70, 0.05
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = workspace -- created locally, never replicated by server
        if debugging() then
            print(
                "[TutorialGleam] highlight created stage="
                    .. tostring(stage)
                    .. " target="
                    .. describe(object)
                    .. " highlight="
                    .. describe(highlight)
                    .. " parent="
                    .. describe(highlight.Parent)
                    .. " Adornee="
                    .. describe(highlight.Adornee)
                    .. " Enabled="
                    .. tostring(highlight.Enabled)
                    .. " DepthMode="
                    .. tostring(highlight.DepthMode)
                    .. " FillTransparency="
                    .. tostring(highlight.FillTransparency)
                    .. " OutlineTransparency="
                    .. tostring(highlight.OutlineTransparency)
            )
        end
        local tween = TweenService:Create(
            highlight,
            TweenInfo.new(0.85, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            { FillTransparency = 0.35, OutlineTransparency = 0.15 }
        )
        table.insert(highlights, highlight)
        table.insert(tweens, tween)
        table.insert(current, object)
        tween:Play()
    end
    if stage == "ClaimPlot" and #current > 0 then
        activeClaimHintPlot = plot
        activeClaimHintTargets = table.clone(current)
    end
end
local function bindSpawnTarget()
    local candidate = player:FindFirstChild("TutorialSpawnTarget")
    local target = if candidate and candidate:IsA("ObjectValue") then candidate else nil
    if target == spawnTarget then
        return
    end
    if spawnTargetConnection then
        spawnTargetConnection:Disconnect()
        spawnTargetConnection = nil
    end
    spawnTarget = target
    if target then
        spawnTargetConnection = target:GetPropertyChangedSignal("Value"):Connect(function()
            if player:GetAttribute("TutorialStage") == "ClaimPlot" then
                refresh() -- nil after reservation expiry retains the active claim pin
            end
        end)
    end
    if player:GetAttribute("TutorialStage") == "ClaimPlot" then
        refresh()
    end
end
function Controller.Init()
    if initialized then
        return
    end
    initialized = true
    bindSpawnTarget()
    for _, event in { player.ChildAdded, player.ChildRemoved } do
        table.insert(
            connections,
            event:Connect(function(child)
                if child.Name == "TutorialSpawnTarget" then
                    bindSpawnTarget()
                end
            end)
        )
    end
    for _, attribute in
        {
            "TutorialStage",
            "TutorialActive",
            "TutorialHintReady",
            "TutorialStashSlot",
            "TutorialOrderIndex",
            "PlotSessionId",
            "PlotMembershipRevision",
            "DebugTutorialGleam",
        }
    do
        table.insert(
            connections,
            player:GetAttributeChangedSignal(attribute):Connect(function()
                clear() -- invalidate immediately, before resolving the next replicated target
                refresh()
            end)
        )
    end
    table.insert(
        connections,
        player.CharacterRemoving:Connect(function(character)
            removingCharacter = character
            clear()
        end)
    )
    table.insert(
        connections,
        player.CharacterAdded:Connect(function()
            removingCharacter = nil
            clear()
            refresh()
        end)
    )
    -- Re-resolve streaming/recreated targets and death state without waiting for missing assets.
    table.insert(connections, RunService.Heartbeat:Connect(refresh))
    script.Destroying:Connect(function()
        stopped = true
        clearClaimPin()
        if spawnTargetConnection then
            spawnTargetConnection:Disconnect()
            spawnTargetConnection = nil
        end
        clear()
        for _, connection in connections do
            connection:Disconnect()
        end
        table.clear(connections)
    end)
    refresh()
end
return Controller
]]></string>
