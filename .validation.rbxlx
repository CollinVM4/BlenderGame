        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">CustomerWalk</string>
            <string name="Source"><![CDATA[--!strict
-- CustomerService owns queue destinations; this module owns locomotion and animation.
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local Movement = require(game:GetService("ReplicatedStorage").Shared.Constants.CustomerMovement)
local CustomerWalk = {}
local DEFAULT_WALK = {
    R15 = "rbxassetid://507777826",
    R6 = "rbxassetid://180426354",
}
local FADE_TIME = 0.15
local WALK_WEIGHT = 1
local WALK_SPEED = 0.8
local LOAD_TIMEOUT = 5
local LOAD_POLL_INTERVAL = 0.1

-- Validate body structure only. Roblox owns the underlying animated joint representation.
local REQUIRED_PARTS = {
    R15 = {
        "HumanoidRootPart",
        "LowerTorso",
        "UpperTorso",
        "LeftUpperLeg",
        "RightUpperLeg",
        "LeftLowerLeg",
        "RightLowerLeg",
        "LeftFoot",
        "RightFoot",
    },
    R6 = { "HumanoidRootPart", "Torso", "Left Leg", "Right Leg" },
}
local OTHER_BODY_PARTS = {
    R15 = { "Head", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm", "LeftHand", "RightHand" },
    R6 = { "Head", "Left Arm", "Right Arm" },
}

local function missingParts(model: Model, rig: string): { string }
    local missing = {}
    for _, name in REQUIRED_PARTS[rig] do
        local part = model:FindFirstChild(name)
        if not part or not part:IsA("BasePart") then
            table.insert(missing, name)
        end
    end
    return missing
end

function CustomerWalk.PrepareRig(model: Model, root: BasePart)
    -- Standard body parts can animate regardless of joint type.
    -- Disconnected decorative parts retain the old anchored behavior.
    local connected: { [BasePart]: boolean } = { [root] = true }
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local rig = if humanoid then humanoid.RigType.Name else ""
    if REQUIRED_PARTS[rig] and #missingParts(model, rig) == 0 then
        for _, names in { REQUIRED_PARTS[rig], OTHER_BODY_PARTS[rig] } do
            for _, name in names do
                local part = model:FindFirstChild(name)
                if part and part:IsA("BasePart") then
                    connected[part] = true
                end
            end
        end
    end
    -- Preserve existing welded accessories without treating welds as rig validation.
    local descendants = model:GetDescendants()
    local changed = true
    while changed do
        changed = false
        for _, joint in descendants do
            if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
                local a, b = joint.Part0, joint.Part1
                if a and b and a:IsDescendantOf(model) and b:IsDescendantOf(model) then
                    if connected[a] and not connected[b] then
                        connected[b], changed = true, true
                    elseif connected[b] and not connected[a] then
                        connected[a], changed = true, true
                    end
                end
            end
        end
    end
    for part in connected do
        part.Anchored = false
    end
end

local function removeLegacyHoldRig(model: Model, root: BasePart)
    local attachment = root:FindFirstChild("CustomerRouteAttachment")
    if not attachment or not attachment:IsA("Attachment") then
        return
    end
    for _, object in model:GetDescendants() do
        if
            (object:IsA("AlignPosition") or object:IsA("AlignOrientation"))
            and (object.Attachment0 == attachment or object.Attachment1 == attachment)
        then
            object:Destroy()
        end
    end
    attachment:Destroy()
end

-- Hand the spawned clone to native Humanoid locomotion and normal character physics.
function CustomerWalk.Prepare(model: Model, root: BasePart)
    removeLegacyHoldRig(model, root)
    for _, descendant in model:GetDescendants() do
        if descendant:IsA("BasePart") then
            descendant.Anchored = false
        end
    end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.EvaluateStateMachine = true
        humanoid.PlatformStand = false
        humanoid.Sit = false
        humanoid.AutoRotate = true
        humanoid.WalkSpeed = Movement.Speed
    end
    if root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end
end

function CustomerWalk.Cancel(record: any)
    record.MoveToken = (record.MoveToken or 0) + 1
    record.Walk.SetMoving(false)
    local humanoid = record.Model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.AutoRotate = false
        -- Halt in-flight autonomous movement without going through MoveTo/MoveToFinished.
        humanoid:Move(Vector3.zero)
    end
end

-- Path factory is the only injectable engine boundary; Humanoid:MoveTo/MoveToFinished
-- drive the actual walk so slopes and minor terrain variation are handled natively.
-- A model without a Humanoid (e.g. the no-template placeholder) has no rig to drive
-- and glides directly between waypoints instead.
function CustomerWalk.Move(record: any, destination: CFrame, finished: (boolean) -> (), adapter: any?)
    CustomerWalk.Cancel(record)
    local token = record.MoveToken
    local model: Model = record.Model
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local createPath = if adapter
        then adapter.CreatePath
        else function()
            return PathfindingService:CreatePath(Movement.Agent)
        end
    local step = if adapter
        then adapter.Step
        else function()
            return RunService.Heartbeat:Wait()
        end
    local didLogFirstMoveTo = false
    local function valid(): boolean
        return model.Parent ~= nil and record.MoveToken == token
    end
    local function groundPosition(): Vector3
        return model:GetPivot().Position - Vector3.new(0, record.BottomOffset, 0)
    end
    local goalGround = destination.Position - Vector3.new(0, record.BottomOffset, 0)
    if humanoid then
        humanoid.AutoRotate = true
        humanoid.WalkSpeed = Movement.Speed
    end
    record.Walk.SetMoving(true)

    local function settle(reached: boolean)
        if not valid() then
            return
        end
        record.Walk.SetMoving(false)
        if humanoid then
            humanoid.AutoRotate = false
        end
        if reached then
            model:PivotTo(destination)
        end
        finished(reached)
    end

    -- Drive one waypoint to completion; onDone reports whether it was actually reached.
    local function driveTo(at: Vector3, onDone: (boolean) -> ())
        if humanoid then
            local moveConnection: any
            moveConnection = humanoid.MoveToFinished:Connect(function(reached: boolean)
                moveConnection:Disconnect()
                onDone(reached)
            end)
            if not didLogFirstMoveTo and RunService:IsStudio() then
                didLogFirstMoveTo = true
                local root = model:FindFirstChild("HumanoidRootPart")
                local anchoredBodyParts = {}
                local bodyPartStates = {}
                local staleMovementObjects = {}
                for _, descendant in model:GetDescendants() do
                    if descendant:IsA("BasePart") then
                        if descendant.Anchored then
                            table.insert(anchoredBodyParts, descendant:GetFullName())
                        end
                        table.insert(
                            bodyPartStates,
                            descendant:GetFullName()
                                .. "(Anchored="
                                .. tostring(descendant.Anchored)
                                .. ",CanCollide="
                                .. tostring(descendant.CanCollide)
                                .. ")"
                        )
                    end
                    if
                        descendant:IsA("AlignPosition")
                        or descendant:IsA("AlignOrientation")
                        or descendant:IsA("BodyPosition")
                        or descendant:IsA("BodyVelocity")
                        or descendant:IsA("BodyGyro")
                        or descendant:IsA("LinearVelocity")
                        or descendant:IsA("VectorForce")
                    then
                        table.insert(staleMovementObjects, descendant.ClassName .. ":" .. descendant:GetFullName())
                    end
                end
                local rootAnchored = if root and root:IsA("BasePart") then tostring(root.Anchored) else "<missing>"
                local distance =
                    if root and root:IsA("BasePart") then (root.Position - destination.Position).Magnitude else 0
                print(
                    "[CustomerWalk] rootAnchored="
                        .. rootAnchored
                        .. " anchoredBodyParts="
                        .. table.concat(anchoredBodyParts, ",")
                        .. " evaluateStateMachine="
                        .. tostring(humanoid.EvaluateStateMachine)
                        .. " platformStand="
                        .. tostring(humanoid.PlatformStand)
                        .. " sit="
                        .. tostring(humanoid.Sit)
                        .. " walkSpeed="
                        .. tostring(humanoid.WalkSpeed)
                        .. " humanoidState="
                        .. tostring(humanoid:GetState())
                        .. " destination="
                        .. tostring(destination.Position)
                        .. " distance="
                        .. tostring(distance)
                        .. " moveToWaypoint="
                        .. tostring(at)
                        .. " bodyParts="
                        .. table.concat(bodyPartStates, ",")
                        .. " staleMovementObjects="
                        .. table.concat(staleMovementObjects, ",")
                )
            end
            humanoid:MoveTo(at)
            return
        end
        local start = model:GetPivot()
        local duration = (start.Position - at).Magnitude / Movement.Speed
        local elapsed = 0
        while elapsed < duration do
            if not valid() then
                return
            end
            elapsed += step()
            model:PivotTo(start:Lerp(CFrame.new(at), math.min(1, elapsed / math.max(duration, 0.0001))))
        end
        onDone(valid())
    end

    -- Walk one computed path to completion; reports success/failure of this attempt only.
    local function walkPath(onDone: (boolean) -> ())
        local path: any = nil
        local ok = pcall(function()
            path = createPath()
            path:ComputeAsync(groundPosition(), goalGround)
        end)
        if not valid() then
            if path then
                path:Destroy()
            end
            return
        end
        if not ok or path.Status ~= Enum.PathStatus.Success then
            if path then
                path:Destroy()
            end
            onDone(false)
            return
        end
        local points = path:GetWaypoints()
        if #points == 0 then
            path:Destroy()
            onDone(false)
            return
        end
        local blocked = false
        local connection = path.Blocked:Connect(function()
            blocked = true
        end)
        local function cleanup()
            connection:Disconnect()
            path:Destroy()
        end
        local index = 1
        local function advance()
            if not valid() then
                cleanup()
                return
            end
            if blocked then
                cleanup()
                onDone(false)
                return
            end
            local waypoint = points[index]
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                cleanup()
                onDone(false)
                return
            end
            local at = waypoint.Position + Vector3.new(0, record.BottomOffset, 0)
            driveTo(at, function(reached: boolean)
                if not valid() then
                    cleanup()
                    return
                end
                if blocked or not reached then
                    cleanup()
                    onDone(false)
                    return
                end
                index += 1
                if index > #points then
                    cleanup()
                    onDone(true)
                else
                    advance()
                end
            end)
        end
        advance()
    end

    local attempts = 0
    local function attempt()
        attempts += 1
        walkPath(function(reached)
            if not valid() then
                return
            end
            if reached then
                settle(true)
                return
            end
            if attempts < Movement.MaxPathAttempts then
                attempt()
                return
            end
            -- Bounded retries exhausted: only recover if we already ended up close
            -- to the marker; genuinely unreachable destinations still fail.
            settle((groundPosition() - goalGround).Magnitude <= Movement.FinalApproachDistance)
        end)
    end
    task.spawn(function()
        if valid() then
            attempt()
        end
    end)
end

function CustomerWalk.Create(model: Model, templateName: string?)
    local track: AnimationTrack? = nil
    local animation: Animation? = nil
    local animator: Animator? = nil
    local moving, ready, destroyed = false, false, false
    local segment = 0
    local usableRig = false
    local controller = {}
    local warned = false
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local rig = if humanoid then humanoid.RigType.Name else "<no Humanoid>"
    local id = DEFAULT_WALK[rig]
    local function diagnostic(message: string)
        if RunService:IsStudio() then
            print(
                string.format(
                    "[CustomerWalk] template=%s customer=%s rig=%s animation=%s %s",
                    templateName or "<generic>",
                    model.Name,
                    rig,
                    id or "<unsupported>",
                    message
                )
            )
        end
    end
    local function warnOnce(message: string)
        if RunService:IsStudio() and not warned then
            warned = true
            warn(string.format("[CustomerWalk] template=%s rig=%s %s", templateName or model.Name, rig, message))
        end
    end
    local function snapshot(phase: string)
        if not RunService:IsStudio() then
            return
        end
        local current = track
        if current then
            diagnostic(
                string.format(
                    "%s IsPlaying=%s Length=%.3f weight=%.3f targetWeight=%.3f speed=%.3f priority=%s",
                    phase,
                    tostring(current.IsPlaying),
                    current.Length,
                    current.WeightCurrent,
                    current.WeightTarget,
                    current.Speed,
                    current.Priority.Name
                )
            )
        end
        if animator then
            for _, other in animator:GetPlayingAnimationTracks() do
                if other ~= current then
                    diagnostic(
                        string.format(
                            "competing track=%s priority=%s weight=%.3f",
                            other.Animation.AnimationId,
                            other.Priority.Name,
                            other.WeightCurrent
                        )
                    )
                end
            end
        end
    end
    local function play()
        local current = track
        if not current or not ready or not moving or destroyed then
            return
        end
        local ok, reason = pcall(function()
            current:Play(FADE_TIME, WALK_WEIGHT, WALK_SPEED)
        end)
        if not ok then
            warnOnce("Play failed: " .. tostring(reason))
        end
        diagnostic("Play success=" .. tostring(ok))
        snapshot("after Play")
        if RunService:IsStudio() then
            local token = segment
            task.delay(FADE_TIME + 0.2, function()
                if not destroyed and moving and segment == token then
                    snapshot("after fade")
                end
            end)
        end
    end
    function controller.SetMoving(value: boolean)
        if destroyed or not usableRig or value == moving then
            return
        end
        moving = value
        segment += 1
        if value then
            diagnostic("route start ready=" .. tostring(ready))
            play()
        elseif track then
            track:Stop(FADE_TIME)
            diagnostic("route stop")
        end
    end
    function controller.Destroy()
        if destroyed then
            return
        end
        destroyed = true
        moving = false
        if track then
            track:Stop(0)
            track:Destroy()
            track = nil
        end
        if animation then
            animation:Destroy()
            animation = nil
        end
    end
    if not humanoid or not id then
        diagnostic("walk disabled: missing Humanoid or unsupported rig")
        return controller
    end
    local missing = missingParts(model, rig)
    if #missing > 0 then
        warnOnce("walk skipped; missing R15/R6 body parts: " .. table.concat(missing, ", "))
        return controller
    end
    animator = humanoid:FindFirstChildOfClass("Animator")
    local foundAnimator = animator ~= nil
    if not animator then
        local created = Instance.new("Animator")
        created.Parent = humanoid
        animator = created
    end
    diagnostic("Animator=" .. (if foundAnimator then "found" else "created") .. " health=" .. tostring(humanoid.Health))
    -- Use a rig-specific standard walk, not unverified assets copied from Animate.
    -- Keep the Animation alive with its track, including while the asset loads.
    local source = Instance.new("Animation")
    source.Name = "CustomerWalkAnimation"
    source.AnimationId = id
    source.Parent = animator
    animation = source
    local ok, loaded = pcall(function()
        return (animator :: Animator):LoadAnimation(source)
    end)
    if not ok or not loaded or not loaded:IsA("AnimationTrack") then
        warnOnce("Animator present=true LoadAnimation failed: " .. tostring(loaded))
        source:Destroy()
        animation = nil
        return controller
    end
    diagnostic("Animator present=true LoadAnimation success=true Length=" .. tostring(loaded.Length))
    usableRig = true
    track = loaded
    loaded.Looped = true
    loaded.Priority = Enum.AnimationPriority.Movement
    ready = loaded.Length > 0
    if not ready then
        -- A successful LoadAnimation can return before clip data is available.
        -- Never delay the route, and never start a late track after arrival/removal.
        task.spawn(function()
            local elapsed = 0
            while not destroyed and loaded.Length <= 0 and elapsed < LOAD_TIMEOUT do
                elapsed += task.wait(LOAD_POLL_INTERVAL)
            end
            if destroyed then
                return
            end
            ready = loaded.Length > 0
            if ready then
                diagnostic("clip ready Length=" .. tostring(loaded.Length))
                play()
            else
                warnOnce("clip unavailable after timeout; check asset permissions/Output errors")
                usableRig = false
                loaded:Destroy()
                track = nil
                source:Destroy()
                animation = nil
            end
        end)
    end
    return controller
end

return CustomerWalk
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">DevContentService</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local Upgrades = require(game:GetService("ReplicatedStorage").Shared.Constants.Upgrades)
local DevContentService = {}
local deps: any
function DevContentService.Init(services)
    deps = services
end
function DevContentService.IsEnabled(): boolean
    return RunService:IsStudio() and ServerStorage:GetAttribute("EnableDevContent") == true
end
local function allowed(player: Player): boolean
    if not DevContentService.IsEnabled() or player.Parent ~= game:GetService("Players") then
        return false
    end
    return true
end

function DevContentService.ValidatePlot(player: Player): (boolean, { string })
    if not allowed(player) then
        return false, { "Studio and EnableDevContent=true required" }
    end
    local plot = deps.TycoonService.GetPlot(player)
    local lines: { string } = {}
    local valid = true
    local function report(role: string, ok: boolean, detail: string?)
        valid = valid and ok
        table.insert(lines, (if ok then "PASS " else "FAIL ") .. role .. (if detail then " - " .. detail else ""))
    end
    if not plot then
        report("PlayerPlot", false, "No assigned plot in Workspace")
    else
        report(
            "PlayerPlot",
            CollectionService:HasTag(plot, "PlayerPlot")
                and (plot:IsA("Model") or plot:IsA("Folder"))
                and deps.TycoonService.GetOwner(plot) == player,
            "assigned " .. plot:GetFullName()
        )
        for _, other in CollectionService:GetTagged("PlayerPlot") do
            if other ~= plot and (other:IsDescendantOf(plot) or plot:IsDescendantOf(other)) then
                report("PlayerPlot", false, "Nested plot: " .. other:GetFullName())
            end
        end
        local stash: Instance? = nil
        for _, role in
            {
                "BlenderInput",
                "TurbineWheel",
                "DispenseButton",
                "CustomerSpawn",
                "CustomerCounter",
                "CustomerWait1",
                "CustomerWait2",
                "CustomerExit",
                "PlayerStash",
            }
        do
            local fixtures = deps.TycoonService.GetFixtures(plot, role)
            if
                role == "CustomerSpawn"
                or role == "CustomerCounter"
                or role == "CustomerWait1"
                or role == "CustomerWait2"
                or role == "CustomerExit"
            then
                local marker, reason = deps.TycoonService.GetReference(player, role)
                report(
                    role,
                    marker ~= nil,
                    if marker
                        then marker:GetFullName()
                        else "Missing/invalid marker. Must resolve to a BasePart: " .. (reason or role)
                )
            elseif #fixtures == 0 then
                report(role, false, "Missing tag inside assigned plot (tags outside this plot do not count)")
            elseif #fixtures > 1 then
                local paths = {}
                for _, fixture in fixtures do
                    table.insert(paths, fixture:GetFullName())
                end
                table.sort(paths)
                report(role, false, "Duplicate tags: " .. table.concat(paths, ", "))
            else
                local fixture = fixtures[1]
                local part = deps.TycoonService.GetReference(player, role)
                if role == "BlenderInput" and not fixture:IsA("BasePart") then
                    report(role, false, "Tag the InputZone BasePart itself: " .. fixture:GetFullName())
                elseif
                    not part
                    or not part:IsA("BasePart")
                    or not part:IsDescendantOf(plot)
                    or deps.TycoonService.GetOwner(part) ~= player
                then
                    report(role, false, "Must resolve to a BasePart in the assigned plot: " .. fixture:GetFullName())
                elseif role == "BlenderInput" and not part.CanQuery then
                    report(role, false, "CanQuery must be true: " .. part:GetFullName())
                else
                    report(role, true)
                end
                if role == "PlayerStash" then
                    stash = fixture
                end
            end
        end
        local indices: { [number]: { Instance } } = {}
        if stash then
            for _, slot in stash:GetDescendants() do
                local index = slot:GetAttribute("SlotIndex")
                if index ~= nil then
                    if
                        not slot:IsA("BasePart")
                        or type(index) ~= "number"
                        or index ~= index
                        or index % 1 ~= 0
                        or index < 1
                        or index > 10
                    then
                        report(
                            "SlotIndex",
                            false,
                            slot:GetFullName() .. " must be a BasePart with integer SlotIndex 1-10"
                        )
                    else
                        indices[index] = indices[index] or {}
                        table.insert(indices[index], slot)
                    end
                end
            end
        end
        for index = 1, 10 do
            local slots = indices[index] or {}
            if index <= 5 or #slots > 0 then
                report(
                    "SlotIndex " .. index,
                    #slots == 1,
                    if #slots == 0
                        then "Missing BasePart under tagged PlayerStash"
                        elseif #slots > 1 then "Duplicate SlotIndex"
                        else nil
                )
            end
        end
    end
    print("[Plot Validation] " .. (if plot then plot.Name else player.Name))
    for _, line in lines do
        print(line)
    end
    return valid, lines
end

local function stagingFrame(player: Player): CFrame?
    -- GetReference resolves a unique tagged BasePart inside the player's assigned plot.
    local input = deps.TycoonService.GetReference(player, "BlenderInput")
    if not input then
        return nil
    end
    return input.CFrame * CFrame.new(0, 4, 0)
end
function DevContentService.ResetBlender(player: Player): boolean
    if not allowed(player) then
        return false
    end
    deps.BlendService.Reset(player)
    return true
end
function DevContentService.SpawnIngredient(player: Player, id: string): Instance?
    if not allowed(player) then
        return nil
    end
    local at = stagingFrame(player)
    if not at then
        return nil
    end
    if not deps.IngredientService.GetDefinition(id) then
        warn("[DevContentService] Unknown ingredient: " .. tostring(id))
        return nil
    end
    return deps.IngredientService.Spawn(id, at, player, nil, { Origin = "Unknown" })
end
function DevContentService.PrepareCombination(player: Player, ids: { string }): boolean
    if not allowed(player) or #ids < 1 or #ids > Economy.MaxIngredients then
        return false
    end
    for _, id in ids do
        if not deps.IngredientService.GetDefinition(id) then
            return false
        end
    end
    local staging = stagingFrame(player)
    if not staging then
        return false
    end
    deps.InventoryService.ClearHeld(player)
    deps.IngredientService.RemovePlayer(player)
    deps.BlendService.Reset(player)
    for index, id in ids do
        local at = staging * CFrame.new((index - (#ids + 1) / 2) * 3, 0, 0)
        if not deps.IngredientService.Spawn(id, at, player, nil, { Origin = "Unknown" }) then
            deps.IngredientService.RemovePlayer(player)
            return false
        end
    end
    return true
end
function DevContentService.SpawnCustomer(player: Player): Model?
    if not allowed(player) then
        return nil
    end
    local existing = deps.CustomerService.GetSnapshot(player)
    if existing then
        return existing.Model
    end
    if not deps.TycoonService.GetPlot(player) then
        return nil
    end
    if not deps.CustomerService.ActivateForPlayer(player) then
        return nil
    end
    return deps.CustomerService.SpawnForPlayer(player)
end
function DevContentService.ForceReaction(player: Player, reaction: string?): boolean
    return allowed(player) and deps.CustomerService.SetForcedReaction(player, reaction)
end
function DevContentService.ResetScene(player: Player): boolean
    if not allowed(player) then
        return false
    end
    deps.InventoryService.ClearHeld(player)
    deps.GameService.Reset(player)
    deps.BlendService.Reset(player)
    deps.IngredientService.RemovePlayer(player)
    return true
end
local function movementAllowed(player: Player): boolean
    -- Movement-only tools are safe temporary overrides; no content-spawning opt-in needed.
    if not (RunService:IsStudio() and RunService:IsServer() and RunService:IsRunning()) then
        warn("[Movement debug] Use the SERVER Command Bar during Studio Play")
        return false
    end
    if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= game:GetService("Players") then
        warn("[Movement debug] Expected a connected Player; select a player from Players")
        return false
    end
    return true
end
local function requireMovementRuntime(method: string)
    assert(
        deps and deps.MovementService and type(deps.MovementService[method]) == "function",
        "[Movement debug] Runtime MovementService." .. method .. " is not bound; sync scripts and restart Play"
    )
    assert(
        deps.SprintService and type(deps.SprintService.ResetCharacter) == "function",
        "[Movement debug] Runtime SprintService is not bound; sync scripts and restart Play"
    )
end
local function setMovementLevel(player: Player, track: string, level: number): boolean
    if not movementAllowed(player) then
        return false
    end
    local maxLevel = #(Upgrades :: any)[track] - 1
    if type(level) ~= "number" or level ~= level or level < 0 or level > maxLevel or level ~= math.floor(level) then
        warn(
            "[Movement debug] "
                .. track
                .. " step must be an integer from 0 to "
                .. tostring(maxLevel)
                .. "; received "
                .. tostring(level)
        )
        return false
    end
    requireMovementRuntime("SetStudioLevel")
    deps.MovementService.SetStudioLevel(player, track, level)
    if track == "SprintStamina" then
        -- Fresh full-bar timing test; real purchases still use capacity-delta behavior.
        deps.SprintService.ResetCharacter(player)
    end
    return true
end
function DevContentService.SetMovementSpeedLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "MovementSpeed", level)
end
function DevContentService.SetSprintStaminaLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "SprintStamina", level)
end
function DevContentService.SetJumpLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "Jump", level)
end
function DevContentService.ResetMovement(player: Player): boolean
    if not movementAllowed(player) then
        return false
    end
    requireMovementRuntime("ResetStudioOverrides")
    deps.MovementService.ResetStudioOverrides(player)
    deps.SprintService.ResetCharacter(player)
    return true
end
function DevContentService.PrintMovement(player: Player): string?
    if not movementAllowed(player) then
        return nil
    end
    requireMovementRuntime("GetStudioSnapshot")
    local stats, overrides = deps.MovementService.GetStudioSnapshot(player)
    local runtime = deps.SprintService.GetSnapshot(player)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local lines = { "[Movement] " .. player.Name }
    for _, track in { "MovementSpeed", "SprintStamina", "Jump" } do
        local purchased = deps.TycoonService.GetUpgrade(player, track) - 1
        local override = overrides[track]
        local effective = if override ~= nil then override else purchased
        table.insert(
            lines,
            string.format(
                "  %sLevel: %d (purchased: %d; Studio override: %s)",
                track,
                effective,
                purchased,
                tostring(override)
            )
        )
    end
    for _, key in { "BaseWalkSpeed", "SprintWalkSpeed", "JumpPower" } do
        table.insert(lines, "  " .. key .. " (resolved): " .. tostring(stats[key]))
    end
    for _, key in { "StaminaCurrent", "StaminaMax", "IsSprinting" } do
        table.insert(lines, "  " .. key .. ": " .. tostring(runtime[key]))
    end
    for _, key in { "WalkSpeed", "JumpPower", "JumpHeight", "UseJumpPower" } do
        table.insert(lines, "  Humanoid." .. key .. ": " .. tostring(if humanoid then (humanoid :: any)[key] else nil))
    end
    table.insert(lines, "  StunnedUntil: " .. tostring(player:GetAttribute("StunnedUntil")))
    local output = table.concat(lines, "\n")
    print(output)
    return output
end

-- Keep legacy names callable; all aliases retain the same Studio/opt-in gate.
DevContentService.ClearBlender = DevContentService.ResetBlender
DevContentService.ResetPlot = DevContentService.ResetScene
return require(script.Parent.StudioServices).Wrap("DevContentService", DevContentService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">DiscoveryService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Ingredients = require(Shared.Constants.Ingredients)
local Catalog = require(Shared.Constants.DiscoveryCatalog)
local DiscoveryService = {}
local deps: any
local active: { [Player]: boolean } = {}
local discovered: RemoteEvent

local function state(player: Player): Types.DiscoveryState?
    return if active[player] then deps.PlayerDataService.GetDiscoveryState(player) else nil
end
function DiscoveryService.GetSnapshot(player: Player): Types.DiscoveryState
    local source = state(player)
    return {
        Ingredients = if source then table.clone(source.Ingredients) else {},
        SpecialCustomers = if source then table.clone(source.SpecialCustomers) else {},
    }
end
function DiscoveryService.Init(services: any)
    deps = services
    discovered = Instance.new("RemoteEvent")
    discovered.Name = "DiscoveryAdded"
    discovered.Parent = Shared.Events
    local snapshot = Instance.new("RemoteFunction")
    snapshot.Name = "DiscoverySnapshot"
    snapshot.OnServerInvoke = function(player: Player): Types.DiscoveryState
        -- Roblox supplies the caller; arguments cannot select a different player's state.
        return DiscoveryService.GetSnapshot(player)
    end
    snapshot.Parent = Shared.Events
end
function DiscoveryService.PlayerAdded(player: Player)
    if deps.PlayerDataService.GetDiscoveryState(player) then
        active[player] = true
    end
end
function DiscoveryService.PlayerRemoving(player: Player)
    active[player] = nil
end
DiscoveryService.RemovePlayer = DiscoveryService.PlayerRemoving

local function discover(player: Player, kind: "Ingredient" | "SpecialCustomer", id: string): boolean
    local source = state(player)
    if not source then
        return false
    end
    local entries = if kind == "Ingredient" then source.Ingredients else source.SpecialCustomers
    if entries[id] then
        return false
    end
    entries[id] = true
    local event: Types.DiscoveryEvent = { Kind = kind, Id = id }
    discovered:FireClient(player, event)
    return true
end
function DiscoveryService.DiscoverIngredient(player: Player, id: string): boolean
    if type(id) ~= "string" or not Ingredients[id] then
        return false
    end
    return discover(player, "Ingredient", id)
end
function DiscoveryService.DiscoverSpecialCustomer(player: Player, id: string): boolean
    if type(id) ~= "string" or not Catalog.GetSpecialCustomer(id) then
        return false
    end
    return discover(player, "SpecialCustomer", id)
end
function DiscoveryService.HasIngredient(player: Player, id: string): boolean
    local source = state(player)
    return source ~= nil and source.Ingredients[id] == true
end
function DiscoveryService.HasSpecialCustomer(player: Player, id: string): boolean
    local source = state(player)
    return source ~= nil and source.SpecialCustomers[id] == true
end
return require(script.Parent.StudioServices).Wrap("DiscoveryService", DiscoveryService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">FallDamageDiagnostics</string>
            <string name="Source"><![CDATA[--!strict
-- Server-only, explicitly enabled per character. No remotes or gameplay writes.
local Diagnostics = {}
export type Trace = {
    Emit: (Trace, string, { [string]: any }?) -> (),
    SampleDue: (Trace, number) -> boolean,
    Stop: (Trace) -> (),
    Active: (Trace) -> boolean,
}

function Diagnostics.new(
    player: Player,
    snapshot: () -> { [string]: any },
    seconds: number?,
    maxRecords: number?
): Trace
    local duration = math.clamp(seconds or 30, 1, 60)
    local limit = math.floor(math.clamp(maxRecords or 240, 1, 600))
    local deadline = os.clock() + duration
    local elapsed, nextSample, records = 0, 0, 0
    local stopped = false
    local trace = {} :: Trace
    function trace:Active(): boolean
        return not stopped and records < limit and elapsed < duration and os.clock() < deadline
    end
    function trace:Stop()
        stopped = true
    end
    function trace:Emit(event, fields)
        if not self:Active() then
            return
        end
        records += 1
        local values = snapshot()
        if fields then
            for key, value in fields do
                values[key] = value
            end
        end
        values.event, values.player, values.userId = event, player.Name, player.UserId
        values.t, values.record = elapsed, records
        values.lastRecord = records == limit
        local keys = {}
        for key in values do
            table.insert(keys, key)
        end
        table.sort(keys)
        local parts = {}
        for _, key in keys do
            table.insert(parts, key .. "=" .. tostring(values[key]))
        end
        warn("[FallDamageDiagnostic] " .. table.concat(parts, " "))
    end
    function trace:SampleDue(dt): boolean
        elapsed += dt
        if not self:Active() or elapsed < nextSample then
            return false
        end
        nextSample = elapsed + 0.1
        return true
    end
    return trace
end

return Diagnostics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">FallDamageService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-authoritative fall damage. Tracks the strongest downward velocity
-- reached during a fall and evaluates it once the character genuinely lands,
-- rather than measuring raw Y-distance fallen.
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.FallDamage)
local Diagnostics = require(script.Parent.FallDamageDiagnostics)
local FallDamageService = {}
local MovementService: any = nil

type State = {
    Character: Model,
    Humanoid: Humanoid,
    Root: BasePart,
    Supports: { BasePart },
    Ray: RaycastParams,
    Airborne: boolean,
    Peak: number,
    SoftTime: number,
    LastPosition: Vector3,
    LastVelocity: Vector3,
    Connections: { RBXScriptConnection },
    Trace: Diagnostics.Trace?,
}
local states: { [Player]: State } = {}

-- Sampled locomotion states are support evidence, never landing events.
local GROUNDED_STATES: { [Enum.HumanoidStateType]: boolean } = {
    [Enum.HumanoidStateType.Landed] = true,
    [Enum.HumanoidStateType.Running] = true,
    [Enum.HumanoidStateType.RunningNoPhysics] = true,
    [Enum.HumanoidStateType.GettingUp] = true,
}

local function reset(state: State)
    state.Airborne = false
    state.Peak = 0
    state.SoftTime = 0
    state.LastPosition = state.Root.Position
    state.LastVelocity = state.Root.AssemblyLinearVelocity
end

local function probeSupport(state: State, observations: { string }?): (boolean, string)
    local matchedSource: string? = nil
    -- Probe the actual torso colliders, including rotated rigs.
    -- Appearance loading can replace torso Instances after this service attaches.
    -- Resolve the three current parts without disturbing the active fall peak.
    table.clear(state.Supports)
    for _, name in { "UpperTorso", "LowerTorso", "Torso" } do
        local body = state.Character:FindFirstChild(name)
        if body and body:IsA("BasePart") then
            table.insert(state.Supports, body)
        end
    end
    for _, body in state.Supports do
        if body:IsDescendantOf(state.Character) and body.CanCollide then
            local cf, size = body.CFrame, body.Size
            local halfHeight = (
                math.abs(cf.RightVector.Y) * size.X
                + math.abs(cf.UpVector.Y) * size.Y
                + math.abs(cf.LookVector.Y) * size.Z
            ) * 0.5
            state.Ray.CollisionGroup = body.CollisionGroup
            local result =
                workspace:Raycast(body.Position, Vector3.new(0, -halfHeight - Config.ImpactProbePadding, 0), state.Ray)
            if observations then
                table.insert(
                    observations,
                    string.format(
                        "%s:size=%s:length=%.3f:group=%s:velocity=%s:hit=%s:normal=%s",
                        body.Name,
                        tostring(size),
                        halfHeight + Config.ImpactProbePadding,
                        body.CollisionGroup,
                        tostring(body.AssemblyLinearVelocity),
                        if result then tostring(result.Instance) else "none",
                        if result then tostring(result.Normal) else "none"
                    )
                )
            end
            if result and result.Normal.Y >= Config.MinimumGroundNormalY then
                matchedSource = "torso-ray:" .. body.Name
                if not observations then
                    return true, "torso-ray:" .. body.Name
                end
            end
        elseif observations then
            table.insert(observations, body.Name .. ":removed-or-noncollidable")
        end
    end
    if observations then
        return matchedSource ~= nil, matchedSource or "no-support"
    end
    return false, "no-support"
end

local function footSupport(state: State): (boolean, string)
    local root = state.Root
    state.Ray.CollisionGroup = root.CollisionGroup
    local height = state.Humanoid.HipHeight + root.Size.Y * 0.5
    if state.Humanoid.RigType == Enum.HumanoidRigType.R6 then
        -- R6 HipHeight is an offset above its leg, unlike R15's absolute clearance.
        local leg = state.Character:FindFirstChild("Left Leg")
        if leg and leg:IsA("BasePart") then
            height += leg.Size.Y
        end
    end
    local length = math.max(0, height) + Config.ImpactProbePadding
    local result = workspace:Raycast(root.Position, Vector3.new(0, -length, 0), state.Ray)
    return result ~= nil and result.Normal.Y >= Config.MinimumGroundNormalY, "foot-ray"
end

local function supported(state: State, mode: Enum.HumanoidStateType): boolean
    -- Physics/ragdoll support comes from the collidable torso, not stale feet/floor.
    if not state.Humanoid.PlatformStand and mode ~= Enum.HumanoidStateType.Physics then
        if footSupport(state) then
            return true
        end
    end
    return probeSupport(state, nil) or GROUNDED_STATES[mode] == true
end

local function compensation(player: Player): number
    return if MovementService and MovementService.IsInitialized(player)
        then math.min(MovementService.GetJumpPower(player), Config.CompensationCap)
        else 0
end

local function emit(state: State, event: string, fields: { [string]: any }?)
    if state.Trace then
        state.Trace:Emit(event, fields)
    end
end

function FallDamageService.DisableDiagnostics(player: Player)
    local state = states[player]
    if state then
        if state.Trace then
            state.Trace:Stop()
        end
        state.Trace = nil
    end
end

function FallDamageService.EnableDiagnostics(player: Player, seconds: number?, maxRecords: number?): boolean
    assert(RunService:IsServer(), "Fall damage diagnostics are server-only")
    local state = states[player]
    if not state then
        return false
    end
    FallDamageService.DisableDiagnostics(player)
    state.Trace = Diagnostics.new(player, function()
        local h, root = state.Humanoid, state.Root
        local ok, owner = pcall(function()
            return root:GetNetworkOwner()
        end)
        local scales = {}
        for _, name in
            {
                "BodyHeightScale",
                "BodyWidthScale",
                "BodyDepthScale",
                "HeadScale",
                "BodyTypeScale",
                "BodyProportionScale",
            }
        do
            local value = h:FindFirstChild(name)
            table.insert(
                scales,
                name .. ":" .. if value and value:IsA("NumberValue") then tostring(value.Value) else "n/a"
            )
        end
        return {
            serverTime = workspace:GetServerTimeNow(),
            mode = tostring(h:GetState()),
            floor = tostring(h.FloorMaterial),
            jump = h.Jump,
            down = math.max(0, -root.AssemblyLinearVelocity.Y),
            velocityY = root.AssemblyLinearVelocity.Y,
            peak = state.Peak,
            airborne = state.Airborne,
            softTime = state.SoftTime,
            platformStand = h.PlatformStand,
            anchored = root.Anchored,
            health = h.Health,
            hipHeight = h.HipHeight,
            rootSize = tostring(root.Size),
            rig = tostring(h.RigType),
            scales = table.concat(scales, ","),
            networkOwner = if ok then (if owner then tostring(owner) else "server") else "unavailable",
            jumpPower = h.JumpPower,
            jumpHeight = h.JumpHeight,
            useJumpPower = h.UseJumpPower,
            compensation = compensation(player),
            forceField = state.Character:FindFirstChildOfClass("ForceField") ~= nil,
        }
    end, seconds, maxRecords)
    emit(state, "enabled")
    return true
end

local function smoothstep(t: number): number
    t = math.clamp(t, 0, 1)
    return t * t * (3 - 2 * t)
end

local function lerp(a: number, b: number, t: number): number
    return a + (b - a) * t
end

-- Pure curve, exported for tests. effectiveVelocity already excludes the
-- capped jump-power allowance.
function FallDamageService.ComputeDamage(effectiveVelocity: number): number
    if effectiveVelocity <= Config.SafeImpactVelocity then
        return 0
    elseif effectiveVelocity <= Config.LightImpactVelocity then
        local t = (effectiveVelocity - Config.SafeImpactVelocity)
            / (Config.LightImpactVelocity - Config.SafeImpactVelocity)
        return lerp(0, Config.LightDamage, smoothstep(t))
    elseif effectiveVelocity <= Config.HeavyImpactVelocity then
        local t = (effectiveVelocity - Config.LightImpactVelocity)
            / (Config.HeavyImpactVelocity - Config.LightImpactVelocity)
        return lerp(Config.LightDamage, Config.HeavyDamage, smoothstep(t))
    elseif effectiveVelocity <= Config.LethalImpactVelocity then
        local t = (effectiveVelocity - Config.HeavyImpactVelocity)
            / (Config.LethalImpactVelocity - Config.HeavyImpactVelocity)
        return lerp(Config.HeavyDamage, Config.LethalDamage, smoothstep(t))
    else
        return Config.LethalDamage
    end
end

local function evaluateLanding(player: Player, state: State, cause: string)
    local humanoid = state.Humanoid
    local peak = state.Peak
    local compensated = compensation(player)
    local effective = math.max(0, peak - compensated)
    local damage = FallDamageService.ComputeDamage(effective)
    -- Consume before TakeDamage, which can synchronously trigger death/reset.
    state.Airborne, state.Peak, state.SoftTime = false, 0, 0
    local before = humanoid.Health
    if damage > 0 then
        humanoid:TakeDamage(damage)
    end
    local applied = math.max(0, before - humanoid.Health)
    emit(state, "damage", {
        peak = peak,
        impactPeak = peak,
        effective = effective,
        compensation = compensated,
        calculated = damage,
        applied = applied,
        cause = cause,
        healthBefore = before,
        healthAfter = humanoid.Health,
        reason = if damage <= 0
            then "safe-effective-speed"
            elseif applied > 0 then "applied"
            elseif state.Character:FindFirstChildOfClass("ForceField") then "forcefield-protected"
            else "no-health-decrease",
    })
end

function FallDamageService.RemovePlayer(player: Player)
    local state = states[player]
    if state then
        emit(state, "removed")
        FallDamageService.DisableDiagnostics(player)
        for _, connection in state.Connections do
            connection:Disconnect()
        end
        states[player] = nil
    end
end

function FallDamageService.ApplyCharacter(player: Player, character: Model)
    FallDamageService.RemovePlayer(player)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or not root:IsA("BasePart") then
        return
    end
    local state: State = {
        Character = character,
        Humanoid = humanoid,
        Root = root,
        Supports = {},
        Ray = RaycastParams.new(),
        Airborne = false,
        Peak = 0,
        SoftTime = 0,
        LastPosition = root.Position,
        LastVelocity = root.AssemblyLinearVelocity,
        Connections = {},
    }
    state.Ray.FilterType = Enum.RaycastFilterType.Exclude
    state.Ray.FilterDescendantsInstances = { character }
    state.Ray.RespectCanCollide = true
    state.Ray.IgnoreWater = true
    states[player] = state
    table.insert(
        state.Connections,
        player.CharacterRemoving:Connect(function(removing)
            if removing == character and states[player] == state then
                FallDamageService.RemovePlayer(player)
            end
        end)
    )
    table.insert(
        state.Connections,
        humanoid.Died:Connect(function()
            if state.Airborne then
                emit(state, "reset", { reason = "death" })
            end
            reset(state)
        end)
    )
end

-- Explicitly separate an authorized recovery reposition from physical travel.
-- The next real descent/landing is tracked normally; this grants no damage immunity.
function FallDamageService.NotifyRecoveryTeleport(player: Player, character: Model)
    local state = states[player]
    if state and state.Character == character and player.Character == character then
        reset(state)
        emit(state, "reset", { reason = "authorized-recovery-teleport" })
    end
end

function FallDamageService.Init(dependencies)
    MovementService = dependencies.MovementService
    RunService.Heartbeat:Connect(function(dt)
        for player, state in states do
            local root, humanoid = state.Root, state.Humanoid
            if player.Character ~= state.Character or not root:IsDescendantOf(workspace) then
                FallDamageService.RemovePlayer(player)
                continue
            end
            local velocity = root.AssemblyLinearVelocity
            local mode = humanoid:GetState()
            if state.Trace then
                -- Advance the trace lifetime without emitting per-sample records.
                state.Trace:SampleDue(dt)
                if not state.Trace:Active() then
                    FallDamageService.DisableDiagnostics(player)
                end
            end
            -- Discontinuous repositioning is not a physical landing. Allow
            -- ordinary integration/replication error without carrying a peak
            -- through a teleport. Anchoring also cancels the current fall.
            local travelBudget = math.max(state.LastVelocity.Magnitude, velocity.Magnitude) * dt
                + workspace.Gravity * dt * dt * 0.5
                + Config.RepositionTolerance
            if
                humanoid.Health <= 0
                or root.Anchored
                or mode == Enum.HumanoidStateType.Swimming
                or mode == Enum.HumanoidStateType.Climbing
                or mode == Enum.HumanoidStateType.Seated
                or (root.Position - state.LastPosition).Magnitude > travelBudget
            then
                if state.Airborne then
                    emit(state, "reset", {
                        reason = if humanoid.Health <= 0
                            then "dead"
                            elseif root.Anchored then "anchored"
                            elseif mode == Enum.HumanoidStateType.Swimming then "swimming"
                            elseif mode == Enum.HumanoidStateType.Climbing then "climbing"
                            elseif mode == Enum.HumanoidStateType.Seated then "seated"
                            else "reposition-budget",
                        travelBudget = travelBudget,
                        travel = (root.Position - state.LastPosition).Magnitude,
                    })
                end
                reset(state)
                continue
            end
            state.LastPosition, state.LastVelocity = root.Position, velocity
            local down = math.max(0, -velocity.Y)
            local support = supported(state, mode)
            if not state.Airborne then
                if not support then
                    state.Airborne, state.Peak, state.SoftTime = true, down, 0
                    emit(state, "episode-start")
                end
                continue
            end
            state.Peak = math.max(state.Peak, down)
            if support and down <= state.Peak - Config.ImpactSpeedDrop then
                evaluateLanding(player, state, "impact")
            elseif support and down <= Config.SettleVerticalSpeed then
                state.SoftTime += dt
                if state.SoftTime >= Config.GroundConfirmSeconds then
                    evaluateLanding(player, state, "soft")
                end
            else
                -- A graze at essentially the peak speed never consumes the episode.
                state.SoftTime = 0
            end
        end
    end)
end

return require(script.Parent.StudioServices).Wrap("FallDamageService", FallDamageService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">FarmService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.FarmConfig)
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local Eligibility = require(game:GetService("ReplicatedStorage").Shared.Constants.FarmEligibility)
local WorldUtil = require(script.Parent.WorldUtil)
local GameplaySfx = require(script.Parent.GameplaySfxService)
local FarmService = {}
local deps: any
local farms: { [Instance]: any } = {}

local function live(farm: any, session: string?): boolean
    return session ~= nil
        and farms[farm.Plot] == farm
        and farm.Session == session
        and deps.TycoonService.GetSessionOwner(session) ~= nil
end

local function appearance(object: Instance): { any }
    local saved: { any } = {}
    local objects = object:GetDescendants()
    table.insert(objects, object)
    for _, item in objects do
        if item:IsA("BasePart") then
            table.insert(saved, {
                Part = item,
                Frame = item.CFrame,
                Transparency = item.Transparency,
                Collide = item.CanCollide,
                Touch = item.CanTouch,
                Query = item.CanQuery,
            })
        elseif item:IsA("Decal") or item:IsA("Texture") then
            table.insert(saved, { Decoration = item, Transparency = item.Transparency })
        elseif item:IsA("SurfaceGui") or item:IsA("BillboardGui") then
            table.insert(saved, { Gui = item, Enabled = item.Enabled })
        end
    end
    return saved
end

local function show(saved: { any }, visible: boolean)
    for _, item in saved do
        if item.Part then
            item.Part.Transparency = if visible then item.Transparency else 1
            item.Part.CanCollide = visible and item.Collide
            item.Part.CanTouch = visible and item.Touch
            item.Part.CanQuery = visible and item.Query
        elseif item.Decoration then
            item.Decoration.Transparency = if visible then item.Transparency else 1
        else
            item.Gui.Enabled = visible and item.Enabled
        end
    end
end

local function setState(row: any, state: string)
    row.State = state
    if state ~= "GROWING" then
        row.Object:SetAttribute("FarmGrowEnd", nil)
    end
    row.Object:SetAttribute("FarmState", state)
    row.Prompt.Enabled = state == "EMPTY"
end

local function refreshPads(farm: any)
    for index, row in farm.Rows do
        local available = row.State == "LOCKED" and (index == 1 or farm.Rows[index - 1].State ~= "LOCKED")
        show(row.PadAppearance, available)
        row.Pad.CanTouch = available
    end
end

local function stopReveal(row: any)
    for _, motion in row.Motions do
        motion.Connection:Disconnect()
        motion.Tween:Cancel()
    end
    table.clear(row.Motions)
    for _, item in row.VisualAppearance do
        if item.Part then
            item.Part.CFrame = item.Frame
        end
    end
end

local function reveal(row: any)
    show(row.VisualAppearance, true)
    for _, item in row.VisualAppearance do
        if item.Part then
            item.Part.CFrame = CFrame.new(0, -Config.RevealDepth, 0) * item.Frame
            local tween = TweenService:Create(
                item.Part,
                TweenInfo.new(Config.RevealSeconds, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
                { CFrame = item.Frame }
            )
            local connection = tween.Completed:Connect(function()
                item.Part.CFrame = item.Frame
            end)
            table.insert(row.Motions, { Tween = tween, Connection = connection })
            tween:Play()
        end
    end
end

local function authorized(farm: any, player: Player): boolean
    return live(farm, farm.Session) and deps.TycoonService.IsMember(player, farm.Plot)
end

local function purchase(farm: any, row: any, index: number, player: Player)
    if
        not authorized(farm, player)
        or row.State ~= "LOCKED"
        or row.Busy
        or (index > 1 and farm.Rows[index - 1].State == "LOCKED")
        or not WorldUtil.Near(player, row.Pad, Config.PlantDistance)
    then
        return
    end
    row.Busy = true
    deps.TycoonService.PurchaseFarmRow(player, index, deps.TycoonService.GetRequestContext(player), function()
        setState(row, "EMPTY")
        refreshPads(farm)
        reveal(row)
    end)
    row.Busy = false
end

local function emptyWhenHarvestGone(farm: any, row: any, session: string, generation: number)
    if
        live(farm, session)
        and row.Generation == generation
        and row.State == "READY"
        and not row.Spawning
        and next(row.Products) == nil
    then
        row.IngredientId = nil
        setState(row, "EMPTY")
    end
end

local function grow(farm: any, row: any, session: string, generation: number, id: string)
    if not live(farm, session) or row.Generation ~= generation or row.State ~= "GROWING" then
        return
    end
    row.Spawning = true
    setState(row, "READY")
    for _, marker in row.Grow do
        if not live(farm, session) or row.Generation ~= generation then
            break
        end
        local product = deps.IngredientService.Spawn(
            id,
            CFrame.new(0, Config.HarvestVerticalOffset, 0) * marker.WorldCFrame,
            nil,
            true,
            {
                Origin = "Farm",
                FreezeUntilPickup = true,
                FarmManaged = true,
                BeforePublish = function(object: Instance)
                    object:SetAttribute("SpawnSource", "Farm")
                    object:SetAttribute("FarmSpawnTime", workspace:GetServerTimeNow())
                    local connections: { RBXScriptConnection } = {}
                    row.Products[object] = connections
                    local target = Instance.new("ObjectValue")
                    target.Name = "TutorialHarvestTarget"
                    target.Value = object
                    target.Parent = row.Object
                    local function removed()
                        if row.Products[object] ~= connections then
                            return
                        end
                        row.Products[object] = nil
                        target:Destroy()
                        for _, connection in connections do
                            connection:Disconnect()
                        end
                        emptyWhenHarvestGone(farm, row, session, generation)
                    end
                    table.insert(connections, object.Destroying:Connect(removed))
                    table.insert(
                        connections,
                        object.AncestryChanged:Connect(function()
                            if not object:IsDescendantOf(workspace) then
                                removed()
                                object:Destroy()
                            end
                        end)
                    )
                end,
            }
        )
        if not product then
            warn("[FarmService] Failed to spawn " .. id)
        elseif not live(farm, session) or row.Generation ~= generation then
            product:Destroy()
        end
    end
    if live(farm, session) and row.Generation == generation then
        row.Spawning = false
        emptyWhenHarvestGone(farm, row, session, generation)
    end
end

local function plant(farm: any, row: any, player: Player)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if
        not authorized(farm, player)
        or row.State ~= "EMPTY"
        or row.Busy
        or not root
        or not root:IsA("BasePart")
        or (root.Position - row.Plant.WorldPosition).Magnitude > Config.PlantDistance
        or not deps.MovementService.CanPerformGameplayAction(player)
    then
        return
    end
    local id = deps.InventoryService.GetHeldIngredientId(player)
    local definition = if id then deps.IngredientService.GetDefinition(id) else nil
    if not id or not definition or not Eligibility.CanPlant(definition) then
        return
    end
    local duration = Economy.RefillSeconds[definition.JumpLocation] * #row.Grow
    local token = deps.TycoonService.BeginTransaction(player, deps.TycoonService.GetRequestContext(player))
    if not token then
        return
    end
    row.Busy = true
    if deps.InventoryService.ConsumeHeldIngredient(player, id) then
        row.Generation += 1
        row.IngredientId = id
        row.Object:SetAttribute("FarmGrowEnd", workspace:GetServerTimeNow() + duration)
        setState(row, "GROWING")
        GameplaySfx.Emit("IngredientPlant", row.Plant.WorldPosition)
        local generation = row.Generation
        task.delay(duration, function()
            grow(farm, row, token, generation, id)
        end)
    end
    row.Busy = false
    deps.TycoonService.EndTransaction(token)
end

local function resetRow(row: any)
    row.Generation += 1
    local products = row.Products
    row.Products = {}
    for product, connections in products do
        for _, connection in connections do
            connection:Disconnect()
        end
        product:Destroy()
    end
    for _, reference in row.Object:GetChildren() do
        if reference.Name == "TutorialHarvestTarget" and reference:IsA("ObjectValue") then
            reference:Destroy()
        end
    end
    stopReveal(row)
    row.IngredientId, row.Busy, row.Spawning = nil, false, false
    setState(row, "LOCKED")
    show(row.VisualAppearance, false)
end

local function reset(farm: any)
    farm.Session = nil -- invalidate before destruction signals or tween cancellation
    for _, row in farm.Rows do
        resetRow(row)
    end
    refreshPads(farm)
end

local function activate(farm: any, player: Player)
    local session = deps.TycoonService.GetSessionId(player)
    if farm.Session == session then
        return
    end
    reset(farm)
    farm.Session = session
    local unlocked = deps.TycoonService.GetUpgrade(player, "FarmRows") - 1
    for index, row in farm.Rows do
        if index <= unlocked then
            setState(row, "EMPTY")
            show(row.VisualAppearance, true)
        end
    end
    refreshPads(farm)
end

local function bind(plot: Instance): (() -> ())?
    if farms[plot] then
        return nil
    end
    local folder = plot:FindFirstChild("Farm")
    if not folder then
        return nil
    end
    local farm: any = { Plot = plot, Rows = {}, Connections = {} }
    -- Validate the complete authored hierarchy before hiding or binding anything.
    for index = 1, #Config.RowPrices do
        local object = folder:FindFirstChild("Row" .. index)
        local pad = object and object:FindFirstChild("PurchasePoint" .. index)
        local visual = object and object:FindFirstChild("Visual")
        local markers = object and object:FindFirstChild("FarmMarkers")
        local plantPoint = markers and markers:FindFirstChild("PlantPoint")
        local growPoints = {}
        for n = 1, 3 do
            local point = markers and markers:FindFirstChild("Grow" .. n)
            if point and point:IsA("Attachment") then
                table.insert(growPoints, point)
            end
        end
        if
            not object
            or not pad
            or not pad:IsA("BasePart")
            or not visual
            or not markers
            or not markers:IsA("BasePart")
            or not plantPoint
            or not plantPoint:IsA("Attachment")
            or #growPoints ~= 3
        then
            warn("[FarmService] Invalid Row" .. index .. " hierarchy in " .. plot:GetFullName())
            return nil
        end
        table.insert(farm.Rows, {
            Object = object,
            Pad = pad,
            Markers = markers,
            Plant = plantPoint,
            Grow = growPoints,
            VisualAppearance = appearance(visual),
            PadAppearance = appearance(pad),
            Generation = 0,
            Products = {},
            Motions = {},
        })
    end
    farms[plot] = farm
    for index, row in farm.Rows do
        table.insert(
            farm.Connections,
            row.Object.AncestryChanged:Connect(function()
                if not row.Object:IsDescendantOf(plot) then
                    resetRow(row)
                    refreshPads(farm)
                end
            end)
        )
        row.Markers.Anchored, row.Markers.Transparency = true, 1
        row.Markers.CanCollide, row.Markers.CanTouch, row.Markers.CanQuery = false, false, false
        row.Pad.Anchored = true
        for _, item in row.VisualAppearance do
            if item.Part then
                item.Part.Anchored = true
            end
        end
        local old = row.Plant:FindFirstChild("FarmPlantPrompt")
        if old then
            old:Destroy()
        end
        local prompt = Instance.new("ProximityPrompt")
        prompt.Name, prompt.ActionText, prompt.ObjectText = "FarmPlantPrompt", "Plant ingredient", "Farm row " .. index
        prompt.MaxActivationDistance, prompt.RequiresLineOfSight = Config.PlantDistance, false
        prompt.Style = Enum.ProximityPromptStyle.Custom
        prompt.Parent = row.Plant
        row.Prompt = prompt
        table.insert(
            farm.Connections,
            prompt.Triggered:Connect(function(player)
                plant(farm, row, player)
            end)
        )
        table.insert(
            farm.Connections,
            row.Pad.Touched:Connect(function(hit: BasePart)
                local ancestor: Instance? = hit.Parent
                while ancestor and ancestor ~= workspace do
                    local player = if ancestor:IsA("Model") then Players:GetPlayerFromCharacter(ancestor) else nil
                    if player then
                        purchase(farm, row, index, player)
                        return
                    end
                    ancestor = ancestor.Parent
                end
            end)
        )
    end
    reset(farm)
    local owner = deps.TycoonService.GetOwner(plot)
    if owner then
        activate(farm, owner)
    end
    return function()
        reset(farm)
        farms[plot] = nil
        for _, connection in farm.Connections do
            connection:Disconnect()
        end
        for _, row in farm.Rows do
            row.Prompt:Destroy()
        end
    end
end

-- Read-only tutorial boundary: authoritative state for the active plot session.
function FarmService.GetRowSnapshot(
    plot: Instance,
    index: number
): { State: string, IngredientId: string?, Products: { Instance } }?
    local farm = farms[plot]
    local row = if farm and live(farm, farm.Session) then farm.Rows[index] else nil
    if not row then
        return nil
    end
    local products: { Instance } = {}
    for object in row.Products do
        table.insert(products, object)
    end
    return { State = row.State, IngredientId = row.IngredientId, Products = products }
end

function FarmService.StartSession(player: Player)
    local plot = deps.TycoonService.GetPlot(player)
    local farm = plot and farms[plot]
    if farm then
        activate(farm, player)
    end
end

function FarmService.CleanupSession(id: string)
    for _, farm in farms do
        if farm.Session == id then
            reset(farm)
        end
    end
end

function FarmService.Init(services: any)
    deps = services
    WorldUtil.BindTag("PlayerPlot", bind)
end

return FarmService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">FilmingUtil</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Events = game:GetService("ReplicatedStorage").Shared.Events
local FilmingUtil = {}
local remote: RemoteEvent?

function FilmingUtil.Init()
    if remote then
        return
    end
    local existing = Events:FindFirstChild("GameplayPresentation")
    if existing then
        assert(existing:IsA("RemoteEvent"), "GameplayPresentation must be a RemoteEvent")
        remote = existing
        return
    end
    local event = Instance.new("RemoteEvent")
    event.Name = "GameplayPresentation"
    event.Parent = Events
    remote = event
end

-- Output only: no OnServerEvent listener, reward requests, or mutable service records.
function FilmingUtil.Emit(player: Player, moment: string, payload: any)
    if remote then
        remote:FireAllClients(moment, player.UserId, payload)
    end
end

function FilmingUtil.Log(scope: string, message: string)
    if RunService:IsStudio() and ServerStorage:GetAttribute("DebugFilmLoop") == true then
        print(string.format("[%s] %s", scope, message))
    end
end

return FilmingUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">FreezeStatusService</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IceGunConfig)
local Service = {}
local deps: any
type State = { Character: Model, Until: number, ImmuneUntil: number, Active: boolean }
local states: { [Player]: State } = {}
local connections: { [Player]: { RBXScriptConnection } } = {}

function Service.Init(services)
    deps = services
end

function Service.Clear(player: Player)
    local state = states[player]
    states[player] = nil
    if state then
        state.Character:SetAttribute("FrozenUntil", nil)
        state.Character:SetAttribute("FreezeImmuneUntil", nil)
        deps.IceGunEffects.ClearFreeze(state.Character, false)
    end
    deps.MovementService.SetFrozen(player, false)
end

function Service.Apply(player: Player): boolean
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid or humanoid.Health <= 0 then
        return false
    end
    local previous = states[player]
    local now = os.clock()
    if previous and previous.Character == character and (previous.Active or now < previous.ImmuneUntil) then
        return false
    end
    local state: State = {
        Character = character,
        Until = now + Config.FreezeSeconds,
        ImmuneUntil = now + Config.FreezeSeconds + Config.ImmunitySeconds,
        Active = true,
    }
    states[player] = state
    deps.MovementService.SetFrozen(player, true)
    character:SetAttribute("FreezeImmuneUntil", nil)
    character:SetAttribute("FrozenUntil", workspace:GetServerTimeNow() + Config.FreezeSeconds)
    deps.IceGunEffects.Freeze(character)
    task.delay(Config.FreezeSeconds, function()
        if states[player] ~= state or player.Character ~= character then
            return
        end
        state.Active = false
        -- Immunity starts at actual thaw, including a delayed server frame.
        state.ImmuneUntil = os.clock() + Config.ImmunitySeconds
        deps.MovementService.SetFrozen(player, false)
        character:SetAttribute("FreezeImmuneUntil", workspace:GetServerTimeNow() + Config.ImmunitySeconds)
        character:SetAttribute("FrozenUntil", nil)
        deps.IceGunEffects.ClearFreeze(character, true)
    end)
    return true
end

function Service.ApplyCharacter(player: Player, character: Model)
    Service.RemovePlayer(player)
    local list: { RBXScriptConnection } = {}
    connections[player] = list
    table.insert(
        list,
        player.CharacterRemoving:Connect(function(old)
            if old == character then
                Service.Clear(player)
            end
        end)
    )
    task.spawn(function()
        local h = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        if connections[player] == list and player.Character == character and h and h:IsA("Humanoid") then
            table.insert(
                list,
                h.Died:Connect(function()
                    Service.Clear(player)
                end)
            )
        end
    end)
end

function Service.RemovePlayer(player: Player)
    Service.Clear(player)
    for _, connection in (connections[player] or {}) :: { RBXScriptConnection } do
        connection:Disconnect()
    end
    connections[player] = nil
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local GameService = {}
local deps: any
type Session = { State: Types.DayState, Day: number, Grades: { Types.Grade }, Grade: Types.Grade?, Served: number }
local sessions: { [Player]: Session } = {}
local function publish(player: Player)
    local session = sessions[player]
    player:SetAttribute("DayState", session.State)
    player:SetAttribute("DayNumber", session.Day)
    player:SetAttribute("CustomersServedToday", session.Served)
    player:SetAttribute("DayGrade", session.Grade or "")
end
function GameService.Init(services)
    deps = services
end
function GameService.AddPlayer(player: Player)
    sessions[player] = { State = "PREP", Day = 0, Grades = {}, Grade = nil, Served = 0 }
    publish(player)
end
function GameService.GetSnapshot(player: Player): Session?
    local session = sessions[player]
    if not session then
        return nil
    end
    return {
        State = session.State,
        Day = session.Day,
        Grades = table.clone(session.Grades),
        Grade = session.Grade,
        Served = session.Served,
    }
end
-- Legacy remote/Studio entry point. Idempotently activates flow; never spawns a day batch.
function GameService.StartDay(player: Player): (boolean, string?)
    if not deps.TycoonService.GetPlot(player) then
        return false, "No active plot"
    end
    local ok = deps.CustomerService.ActivateForPlayer(player)
    return ok, if ok then nil else "No active plot"
end
function GameService.IsServing(player: Player): boolean
    return player:GetAttribute("CustomerFlowState") == "PLOT_ACTIVE"
end
-- Retained for callers compiled against the old API. Endless flow has no day completion.
function GameService.FinishDay(_player: Player): boolean
    return false
end
function GameService.CustomerServed(player: Player, grade: Types.Grade?)
    local session = sessions[player]
    if not session then
        return
    end
    session.State = "SERVING"
    session.Served += 1
    session.Grade = grade
    -- Bounded legacy summary; lifetime stats belong to PlayerDataService.
    session.Grades = if grade then { grade } else {}
    publish(player)
end
function GameService.ResumeDay(player: Player): boolean
    return deps.CustomerService.ActivateForPlayer(player)
end
function GameService.Reset(player: Player)
    deps.CustomerService.DeactivateForPlayer(player)
    GameService.AddPlayer(player)
end
function GameService.RemovePlayer(player: Player)
    sessions[player] = nil
end
return require(script.Parent.StudioServices).Wrap("GameService", GameService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">GameplayService</string>
            <string name="Source"><![CDATA[--!strict
-- Narrow request adapter for future inventory UI. No client-supplied state, positions, or awards.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local GameplayService = {}
local IngredientThrow = require(script.Parent.IngredientThrow)
local MovementService = require(script.Parent.MovementService)
local plotInteractions = setmetatable({} :: { [ProximityPrompt]: (Player, any) -> () }, { __mode = "k" })
function GameplayService.RegisterPlotInteraction(prompt: ProximityPrompt, callback: (Player, any) -> ())
    plotInteractions[prompt] = callback
    prompt:SetAttribute("SessionInteraction", true)
end
local nextRequest: { [Player]: number } = {}
-- All world/team operations enter here; submitted contexts are never repaired.
function GameplayService.HandlePlotRequest(
    services: any,
    player: Player,
    action: string,
    plot: any,
    value: any,
    context: any
): boolean
    -- Claims/joins originate exclusively from server-authored zone detection now.
    if action == "ClaimPlot" or action == "JoinTeam" then
        return false
    end
    if not MovementService.CanPerformGameplayAction(player) then
        return false
    end
    if typeof(plot) ~= "Instance" or not plot:IsDescendantOf(workspace) then
        return false
    end
    local authority = services.TycoonService
    if authority.GetPlot(player) ~= plot or not authority.ValidateActor(player, context) then
        return false
    end
    if action == "LeaveTeam" then
        return authority.LeaveTeam(player, context)
    elseif action == "SetJoinMode" then
        return authority.SetJoinMode(player, value, context)
    elseif action == "KickTeammate" then
        for _, member in authority.GetMembers(context.PlotSessionId) do
            if member.UserId == value then
                return authority.Kick(player, member, context)
            end
        end
    end
    return false
end
function GameplayService.Init(services: any)
    local remote = Instance.new("RemoteEvent")
    remote.Name = "GameplayRequest"
    remote.Parent = ReplicatedStorage.Shared.Events
    remote.OnServerEvent:Connect(function(player, action, id, slot, context)
        -- Observe receipt before *any* adapter gate. Do not consume the one-shot
        -- CombatService flag here; it must survive through rejection or dispatch.
        local tracing = RunService:IsStudio() and action == "SwingBat"
        local function trace(message: string)
            if tracing then
                print("[BatServer] " .. message)
            end
        end
        if tracing then
            trace(
                "GameplayRequest received: SwingBat from "
                    .. player.Name
                    .. " debugArmed="
                    .. tostring(player:GetAttribute("BatDebugNextSwing"))
            )
        end
        if action == "ThrowHeld" then
            IngredientThrow.BeginRequest(player, context)
            IngredientThrow.Trace(player, "request received")
        end
        if action == "Reject" or action == "RejectCustomer" then
            return -- legacy clients cannot bypass Bat combat
        end
        local now = os.clock()
        if now < (nextRequest[player] or 0) then
            if action == "ThrowHeld" then
                IngredientThrow.Trace(player, "rejected: gameplay throttle")
            end
            trace(
                string.format(
                    "request adapter rejected: gameplay throttle (%.3fs remaining)",
                    (nextRequest[player] or 0) - now
                )
            )
            if action == "SwingBat" then
                services.CombatService.TraceRejectedSwing(player, "GameplayRequest throttle")
            end
            return
        end
        nextRequest[player] = now + 0.15
        if type(action) ~= "string" or #action > 32 then
            return
        end
        if
            action == "ClaimPlot"
            or action == "JoinTeam"
            or action == "LeaveTeam"
            or action == "SetJoinMode"
            or action == "KickTeammate"
        then
            local success = GameplayService.HandlePlotRequest(services, player, action, id, slot, context)
            remote:FireClient(player, "PlotRequestResult", { success = success, action = action })
            return
        end
        if not MovementService.CanPerformGameplayAction(player) then
            if action == "ThrowHeld" then
                IngredientThrow.Trace(player, "rejected: gameplay action disabled")
            end
            trace("request adapter rejected: MovementService.IsStunned(attacker)")
            if action == "SwingBat" then
                services.CombatService.TraceRejectedSwing(player, "GameplayRequest attacker stunned")
            end
            return
        end
        if action == "SwingBat" then
            trace("request adapter accepted: SwingBat (no plot/context gate in adapter)")
            trace("calling CombatService SwingBat")
            local accepted = services.CombatService.SwingBat(player)
            trace("CombatService SwingBat returned: " .. tostring(accepted))
            return
        end
        if action == "PlotInteraction" then
            if
                typeof(id) == "Instance"
                and id:IsA("ProximityPrompt")
                and id.Enabled
                and id:IsDescendantOf(workspace)
                and services.TycoonService.ValidateActor(player, context)
            then
                local callback = plotInteractions[id]
                if callback then
                    callback(player, context)
                end
            end
            return
        end
        local validId = type(id) == "string" and #id <= 64
        local validSlot = type(slot) == "number"
            and slot == slot
            and slot >= 1
            and slot <= 10
            and slot == math.floor(slot)
        if action == "StartDay" then
            services.GameService.StartDay(player)
        elseif action == "ThrowHeld" then
            -- Use the issued Tool identity, without coupling inventory back to combat.
            if services.CombatService.IsBatEquipped(player) then
                IngredientThrow.Trace(player, "rejected: bat equipped")
                return
            end
            if services.IceGunService and services.IceGunService.IsEquipped(player) then
                IngredientThrow.Trace(player, "rejected: issued IceGun equipped")
                return
            end
            services.InventoryService.ThrowHeld(player, nil, false)
        elseif action == "ReleaseIngredient" and validId then
            services.InventoryService.ReleaseUnit(player, id)
        elseif action == "Deposit" and validId and validSlot then
            services.InventoryService.Deposit(player, id, slot)
        elseif action == "Withdraw" and validSlot then
            services.InventoryService.Withdraw(player, slot)
        elseif action == "PurchaseUpgrade" then
            local success, reason = false, "InvalidUpgrade"
            if validId then
                success, reason = services.PlayerDataService.PurchaseUpgrade(player, id, slot, context)
            end
            remote:FireClient(player, "PurchaseUpgradeResult", {
                PlotSessionId = if type(context) == "table" then context.PlotSessionId else nil,
                MembershipRevision = if type(context) == "table" then context.MembershipRevision else nil,
                success = success,
                reason = if success then "Success" else reason,
                upgradeId = if validId then id else nil,
                level = if validId and reason ~= "InvalidUpgrade"
                    then services.PlayerDataService.GetUpgrade(player, id) - 1
                    else nil,
            })
        end
    end)
    if RunService:IsStudio() then
        remote:SetAttribute("BatRequestTraceVersion", "input-v1")
        local named = 0
        for _, event in ReplicatedStorage.Shared.Events:GetChildren() do
            if event.Name == "GameplayRequest" then
                named += 1
            end
        end
        print(
            "[BatServer] GameplayRequest adapter ready trace=input-v1 remote="
                .. remote:GetFullName()
                .. " namedRemotes="
                .. tostring(named)
        )
    end
end
function GameplayService.RemovePlayer(player: Player)
    nextRequest[player] = nil
end
return require(script.Parent.StudioServices).Wrap("GameplayService", GameplayService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">GameplaySfxService</string>
            <string name="Source"><![CDATA[--!strict
local Events = game:GetService("ReplicatedStorage").Shared.Events
local GameplaySfx = {}
export type Event = "IngredientPickup" | "IngredientPlant" | "IngredientThrow" | "BatSwing" | "CustomerHurt"
local remote: RemoteEvent?

function GameplaySfx.Init()
    if remote then
        return
    end
    local existing = Events:FindFirstChild("GameplaySfx")
    if existing then
        assert(existing:IsA("RemoteEvent"), "GameplaySfx must be a RemoteEvent")
        remote = existing
    else
        local event = Instance.new("RemoteEvent")
        event.Name = "GameplaySfx"
        event.Parent = Events
        remote = event
    end
end

-- Server output only. There is deliberately no OnServerEvent listener.
function GameplaySfx.Emit(event: Event, position: Vector3)
    if remote then
        remote:FireAllClients(event, position)
    end
end

return GameplaySfx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">HealthRegenService</string>
            <string name="Source"><![CDATA[--!strict
-- Passive server regeneration. StarterCharacterScripts.Health replaces Roblox's
-- default regen script; Humanoid.Health remains the sole health authority.
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.HealthRegen)
local HealthRegenService = {}

type State = {
    Humanoid: Humanoid,
    LastDamageAt: number,
    Connections: { RBXScriptConnection },
}
local states: { [Player]: State } = {}
local heartbeat: RBXScriptConnection? = nil

function HealthRegenService.RemovePlayer(player: Player)
    local state = states[player]
    if state then
        for _, connection in state.Connections do
            connection:Disconnect()
        end
        states[player] = nil
    end
end

function HealthRegenService.ApplyCharacter(player: Player, character: Model)
    HealthRegenService.RemovePlayer(player)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return
    end
    local state: State = {
        Humanoid = humanoid,
        LastDamageAt = os.clock(),
        Connections = {},
    }
    states[player] = state
    -- Observation only: never restore this value to Health. Using the signal
    -- catches damage followed by healing between two Heartbeats.
    local previousHealth = humanoid.Health
    table.insert(
        state.Connections,
        humanoid.HealthChanged:Connect(function(health: number)
            if states[player] ~= state then
                return
            end
            if health < previousHealth then
                state.LastDamageAt = os.clock()
            end
            previousHealth = health
        end)
    )
    local function cleanup()
        if states[player] == state then
            HealthRegenService.RemovePlayer(player)
        end
    end
    table.insert(state.Connections, humanoid.Died:Connect(cleanup))
    table.insert(
        state.Connections,
        player.CharacterRemoving:Connect(function(removing: Model)
            if removing == character then
                cleanup()
            end
        end)
    )
end

function HealthRegenService.Init()
    if heartbeat then
        return
    end
    heartbeat = RunService.Heartbeat:Connect(function(dt: number)
        local now = os.clock()
        for player, state in states do
            local humanoid = state.Humanoid
            if humanoid.Health <= 0 or not humanoid.Parent then
                HealthRegenService.RemovePlayer(player)
                continue
            end
            -- Only credit the portion of this frame after the damage delay.
            local elapsed = math.min(dt, now - state.LastDamageAt - Config.HealthRegenDelaySeconds)
            if elapsed > 0 and humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + Config.HealthRegenPerSecond * elapsed)
            end
        end
    end)
end

return require(script.Parent.StudioServices).Wrap("HealthRegenService", HealthRegenService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">IceGunEffects</string>
            <string name="Source"><![CDATA[--!strict
-- Original asset instances only. Cosmetic physics never alters character motion.
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IceGunConfig)
local Audio = require(game:GetService("ReplicatedStorage").Shared.Constants.IceShotgunPresentationConfig)
local Effects = {}
local blocks: { [Model]: BasePart } = {}

local function templates(): Instance
    return ServerStorage:WaitForChild("IceGunEffects")
end

function Effects.Inert(part: BasePart, anchored: boolean)
    part.Anchored = anchored
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.Massless = true
end

local function emit(part: BasePart, source: Instance, name: string, count: number)
    local template = source:FindFirstChild(name)
    if template and template:IsA("ParticleEmitter") then
        local clone = template:Clone()
        clone.Enabled = false
        clone.Parent = part
        clone:Emit(count)
    end
end

-- All audible nearby freeze/thaw voices share one budget. A listener can hear
-- only sources within MaxDistance; every such pair is within twice that range.
-- Count overlapping clips, including different casters, instead of only one AoE.
type Voice = { Clip: Sound, Root: BasePart, Volume: number }
local voices: { Voice } = {}
local function balanceVoices()
    for _, voice in voices do
        local count = 0
        for _, other in voices do
            if (voice.Root.Position - other.Root.Position).Magnitude <= Audio.SoundMaxDistance * 2 then
                count += 1
            end
        end
        voice.Clip.Volume = voice.Volume / math.max(count, 1)
    end
end
local function sound(part: BasePart, source: Instance, name: string)
    local template = source:FindFirstChild(name)
    if template and template:IsA("Sound") then
        local clone = template:Clone()
        clone.Name = if name == "IceCrack" then "IceRayFreeze" else "IceRayThaw"
        clone.RollOffMode = Enum.RollOffMode.InverseTapered
        clone.RollOffMinDistance, clone.RollOffMaxDistance = Audio.SoundMinDistance, Audio.SoundMaxDistance
        clone.Looped, clone.PlayOnRemove = false, false
        local voice: Voice = {
            Clip = clone,
            Root = part,
            Volume = if name == "IceCrack" then Audio.FreezeVolume else Audio.ThawVolume,
        }
        clone.Parent = part
        table.insert(voices, voice)
        balanceVoices()
        clone:Play()
        local function retire()
            local index = table.find(voices, voice)
            if index then
                table.remove(voices, index)
                clone:Destroy()
                balanceVoices()
            end
        end
        clone.Ended:Once(retire)
        clone.Destroying:Once(retire)
        task.delay(Audio.SoundLifetime, retire)
    end
end

function Effects.CreateProjectile(at: CFrame): BasePart
    local part = templates():FindFirstChild("Projectile") :: BasePart
    local clone = part:Clone()
    clone.Name = "IceGunProjectile"
    Effects.Inert(clone, true)
    clone.CFrame = at
    local trail = templates():FindFirstChild("SnowBullet") :: ParticleEmitter
    local snow = trail:Clone()
    snow.Enabled = true
    snow.Parent = clone
    clone.Parent = workspace
    Debris:AddItem(clone, Config.ProjectileLifetime + 0.5)
    return clone
end

function Effects.Impact(position: Vector3)
    local part = (templates():FindFirstChild("Projectile") :: BasePart):Clone()
    part.Name = "IceGunImpact"
    part.Transparency = 1
    Effects.Inert(part, true)
    part.CFrame = CFrame.new(position)
    part.Parent = workspace
    emit(part, templates(), "SnowSplosion", 100)
    sound(part, templates(), "Shatter")
    Debris:AddItem(part, 4)
end

function Effects.Freeze(character: Model)
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not torso or not torso:IsA("BasePart") then
        return
    end
    Effects.ClearFreeze(character, false)
    local block = (templates():FindFirstChild("IceBlock") :: BasePart):Clone()
    local fullSize = block.Size
    local mesh = block:FindFirstChildOfClass("SpecialMesh") :: SpecialMesh
    local fullScale = mesh.Scale
    block.Size = fullSize * 0.1
    mesh.Scale = fullScale * 0.1
    Effects.Inert(block, false)
    block.CFrame = torso.CFrame * CFrame.Angles(-math.pi / 2, 0, 0)
    -- Keep the visual out of CharacterPhysicsService's body-part descendants.
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = torso
    weld.Part1 = block
    weld.Parent = block
    blocks[character] = block
    block.Parent = workspace
    local source = templates():FindFirstChild("FreezeEffects") :: Folder
    sound(torso, source, "IceCrack")
    emit(block, source, "Puff", 30)
    local info = TweenInfo.new(Config.FreezeGrowthSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(block, info, { Size = fullSize }):Play()
    TweenService:Create(mesh, info, { Scale = fullScale }):Play()
    -- FreezeStatusService owns lifetime, including delayed thaw and early cancellation.
end

function Effects.ClearFreeze(character: Model, shatter: boolean)
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    local freezeSound = torso and torso:FindFirstChild("IceRayFreeze")
    if freezeSound then
        freezeSound:Destroy()
    end
    local block = blocks[character]
    blocks[character] = nil
    if not block then
        return
    end
    local at = block.CFrame
    block:Destroy()
    if shatter then
        local residue = (templates():FindFirstChild("IceBlock") :: BasePart):Clone()
        Effects.Inert(residue, true)
        residue.CFrame = at
        residue.Transparency = 1
        residue.Parent = workspace
        local source = templates():FindFirstChild("FreezeEffects") :: Folder
        local root = character:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then
            sound(root, source, "Shatter")
        end
        emit(residue, source, "FrostSparkles", 80)
        Debris:AddItem(residue, 4)
        -- Small inert shards reuse the original ice mesh and texture; no collision platforms.
        for i = 1, 6 do
            local shard = (templates():FindFirstChild("IceBlock") :: BasePart):Clone()
            Effects.Inert(shard, true)
            shard.Size *= 0.12
            local mesh = shard:FindFirstChildOfClass("SpecialMesh") :: SpecialMesh
            mesh.Scale *= 0.12
            shard.CFrame = at
            shard.Parent = workspace
            local offset = Vector3.new(math.cos(i) * 3, i % 3 - 1, math.sin(i) * 3)
            TweenService:Create(shard, TweenInfo.new(0.4), { CFrame = at + offset, Transparency = 1 }):Play()
            Debris:AddItem(shard, 0.5)
        end
    end
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">IceGunProjectileService</string>
            <string name="Source"><![CDATA[--!strict
-- Ice Ray radial blast resolver. Module name/API retained for existing tool lifecycle wiring.
-- Camera data is untrusted aim intent, never a damage target or attack origin.
-- Hits are radius-only: no cone angle, no muzzle, no line-of-sight raycast and
-- no projectile travel may gate them, so a target inside the sphere is hit
-- regardless of the direction the caster faces or what stands between them.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Constants.IceGunConfig)
local Presentation = require(script.Parent.IceShotgunPresentationService)
local Service = {}
local REVISION = "ice-ray-radial-2026-10-28"
local lastDiagnostic: { [string]: number } = {}
local function trace(player: Player, stage: string)
    if not Config.DebugLogging or not RunService:IsStudio() then
        return
    end
    local key = tostring(player.UserId) .. ":" .. stage
    local now = os.clock()
    if now < (lastDiagnostic[key] or 0) then
        return
    end
    lastDiagnostic[key] = now + 1
    warn("[IceGun] " .. tostring(player.UserId) .. " " .. stage)
end

local deps: any
local cooldown: { [Player]: number } = {}
local requests: { [Player]: number } = {}

local function finite(v: number): boolean
    return v == v and math.abs(v) < 1000000
end

function Service.ClearPlayer(_player: Player)
    -- Shots resolve synchronously; putting away the Tool must not reset cooldown.
end

function Service.RemovePlayer(player: Player)
    cooldown[player], requests[player] = nil, nil
    player:SetAttribute("IceGunCooldownEnd", 0)
end

local function attack(player: Player, origin: Vector3, character: Model): { Presentation.Hit }
    -- Snapshot every target before creating effects or triggering death/drop
    -- callbacks, so a hit cannot change the membership of this same blast.
    local targets: { { Player: Player, Character: Model, Position: Vector3 } } = {}
    local seen: { [Player]: boolean } = {}
    for _, victim in Players:GetPlayers() do
        -- The caster is excluded here, not only by CombatService, so a future
        -- eligibility change can never turn a radial blast into self-damage.
        if victim == player or seen[victim] then
            continue
        end
        local victimCharacter = victim.Character
        local root = victimCharacter and victimCharacter:FindFirstChild("HumanoidRootPart")
        if
            not victimCharacter
            or not root
            or not root:IsA("BasePart")
            or not root:IsDescendantOf(workspace)
            or victimCharacter:FindFirstChildOfClass("ForceField")
            or not deps.CombatService.CanDamagePlayer(player, victim, Config.TeamDamage)
        then
            continue
        end
        -- Radius only, in 3D. A NaN root position fails this comparison, so an
        -- invalid pose is excluded without a Unit/NaN crash. No direction dot
        -- product and no occlusion raycast are consulted.
        local distance = (root.Position - origin).Magnitude
        if not (distance <= Config.BlastRadius) then
            continue
        end
        seen[victim] = true
        table.insert(targets, { Player = victim, Character = victimCharacter, Position = root.Position })
    end
    local hits: { Presentation.Hit } = {}
    for _, target in targets do
        -- Revalidate current eligibility/character at damage time; never trust client targets.
        if
            deps.CombatService.DamagePlayer(
                player,
                target.Player,
                target.Character,
                Config.DirectDamage,
                Config.TeamDamage
            )
        then
            local frozen = deps.FreezeStatusService.Apply(target.Player)
            table.insert(hits, { Position = target.Position, UserId = target.Player.UserId, Frozen = frozen })
        end
    end
    -- NPC customers, if the customer system is wired in: reuse their existing
    -- bat reaction (ragdoll, then return to the queue marker) without touching
    -- their order, payout or queue membership. Bad (thief/freeloader) customers
    -- stay ineligible here because CanHitCustomer requires a bat for them, so
    -- an ice blast can never reject or steal through that path. Each model is
    -- reacted to at most once per blast, and a model whose root is outside the
    -- sphere is skipped even if another of its parts intersects the query.
    local customers = deps.CustomerService
    if customers then
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character }
        params.RespectCanCollide = false
        params.MaxParts = 0
        local reacted: { [Model]: boolean } = {}
        for _, part in workspace:GetPartBoundsInRadius(origin, Config.BlastRadius, params) do
            local ancestor: Instance? = part
            while ancestor and ancestor ~= workspace do
                if ancestor:IsA("Model") then
                    local model = ancestor :: Model
                    local root = model:FindFirstChild("HumanoidRootPart")
                    if
                        not reacted[model]
                        and not Players:GetPlayerFromCharacter(model)
                        and root
                        and root:IsA("BasePart")
                        and (root.Position - origin).Magnitude <= Config.BlastRadius
                        and customers.CanHitCustomer(player, model)
                    then
                        reacted[model] = true
                        local direction = if (root.Position - origin).Magnitude > 0
                            then (root.Position - origin).Unit
                            else Vector3.new(0, 0, -1)
                        customers.HitCustomer(player, model, {
                            Direction = direction,
                            Duration = Config.CustomerRagdollSeconds,
                        })
                    end
                    break
                end
                ancestor = ancestor.Parent
            end
        end
    end
    return hits
end

function Service.Fire(player: Player, aim: any, cameraOrigin: any?, cameraDirection: any?): (boolean, string?)
    local now = os.clock()
    trace(player, "fire remote received")
    if Config.DebugLogging and RunService:IsStudio() then
        trace(
            player,
            "request state session="
                .. tostring(deps.TycoonService.GetSessionId(player))
                .. " ownership="
                .. tostring(player:GetAttribute("IceGunOwnership"))
                .. " character="
                .. tostring(player.Character)
        )
    end
    local function reject(reason: string): (boolean, string?)
        trace(player, "fire rejected: " .. reason)
        return false, reason
    end
    -- Reject spam before inspecting geometry or touching any Marketplace API.
    if now < (requests[player] or 0) then
        return reject("request throttle")
    end
    requests[player] = now + 0.1
    if typeof(aim) ~= "Vector3" or not finite(aim.X) or not finite(aim.Y) or not finite(aim.Z) then
        return reject("malformed aim")
    end
    local tool = deps.IceGunService.GetEquipped(player)
    local character = player.Character
    local h = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if Config.DebugLogging and RunService:IsStudio() then
        trace(
            player,
            "action state allowed="
                .. tostring(deps.MovementService.CanPerformGameplayAction(player))
                .. " PlatformStand="
                .. tostring(h and h.PlatformStand)
                .. " Stunned="
                .. tostring(player:GetAttribute("Stunned"))
                .. " Frozen="
                .. tostring(player:GetAttribute("Frozen"))
        )
    end
    if tool then
        trace(player, "server equipped issue=" .. tostring(tool:GetAttribute("IceGunIssueId")))
    end
    if not tool then
        return reject("no entitled equipped issued Tool")
    elseif player.Parent ~= Players or not character or not h or h.Health <= 0 then
        return reject("invalid firing character")
    elseif not root or not root:IsA("BasePart") or not root:IsDescendantOf(workspace) then
        return reject("invalid character root")
    elseif not finite(root.Position.X) or not finite(root.Position.Y) or not finite(root.Position.Z) then
        return reject("invalid character root")
    elseif h.PlatformStand or not deps.MovementService.CanPerformGameplayAction(player) then
        return reject("gameplay action blocked")
    end
    -- The blast is centered on the caster root, so Handle/GunBarrel pose,
    -- root-to-muzzle clearance and muzzle-against-wall checks are removed:
    -- none of them can affect a radial hit, and each of them could previously
    -- block a blast that the radius alone should have landed. The issued-tool
    -- check above is the only weapon check that remains.
    -- Aim and camera data are still sanity-checked when supplied (finite
    -- vectors, unit camera direction, bounded camera position), because a
    -- malformed payload must still be rejected. They are no longer used to
    -- derive a direction, an aim distance, or world occlusion: the crosshair
    -- is activation intent only, and the server hit area is the caster sphere.
    if cameraOrigin ~= nil or cameraDirection ~= nil then
        if
            typeof(cameraOrigin) ~= "Vector3"
            or typeof(cameraDirection) ~= "Vector3"
            or not finite(cameraOrigin.X)
            or not finite(cameraOrigin.Y)
            or not finite(cameraOrigin.Z)
            or not finite(cameraDirection.X)
            or not finite(cameraDirection.Y)
            or not finite(cameraDirection.Z)
            or (cameraOrigin - root.Position).Magnitude > Config.MaximumCameraDistance
            or math.abs(cameraDirection.Magnitude - 1) > 0.01
        then
            return reject("invalid camera ray")
        end
    end
    if now < (cooldown[player] or 0) then
        return reject("shot cooldown")
    end
    -- Entitlement permits firing before plot claim; CombatService still gates PvP.
    trace(player, "fire eligible")
    cooldown[player] = now + Config.ShotCooldown
    player:SetAttribute("IceGunCooldownEnd", workspace:GetServerTimeNow() + Config.ShotCooldown)
    local origin = root.Position
    local hits = attack(player, origin, character)
    Presentation.Emit(player, origin, hits)
    trace(player, "radial blast resolved")
    return true
end

function Service.Init(services)
    deps = services
    Presentation.Init()
    if Config.DebugLogging and RunService:IsStudio() then
        warn("[IceGun] radial blast initialized revision=" .. REVISION .. " module=" .. script:GetFullName())
    end
    local event = Instance.new("RemoteEvent")
    event.Name = "IceGunFire"
    event.OnServerEvent:Connect(function(player, aim, origin, direction, character)
        -- Keep selection and fire on the same reliable ordered stream. Neither
        -- path yields, so an immediate shot observes the preceding selection.
        if character ~= nil and character ~= player.Character then
            trace(player, "request rejected: stale character")
            return
        end
        if aim == "Select" then
            if character == nil then
                return
            end
            deps.IceGunService.RequestSelection(player, origin, direction)
        else
            local accepted, reason = Service.Fire(player, aim, origin, direction)
            event:FireClient(player, accepted, player.Character, player:GetAttribute("IceGunCooldownEnd") or 0, reason)
        end
    end)
    event.Parent = ReplicatedStorage
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">IceGunService</string>
            <string name="Source"><![CDATA[--!strict
-- Account entitlement and issued Tool lifecycle. No cash ledger or plot-owned grants.
local Players = game:GetService("Players")
local Marketplace = game:GetService("MarketplaceService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Constants.IceGunConfig)
local Simulator = require(script.Parent.StudioIceGunEntitlement)
local Service = {}
local lastDiagnostic: { [string]: number } = {}
local function trace(player: Player, stage: string, tool: Tool?)
    if not Config.DebugLogging or not RunService:IsStudio() then
        return
    end
    local key = tostring(player.UserId) .. ":" .. stage
    local now = os.clock()
    if now < (lastDiagnostic[key] or 0) then
        return
    end
    lastDiagnostic[key] = now + 1
    local detail = if tool
        then string.format(
            " issue=%s parent=%s weapon=%s Enabled=%s ManualActivationOnly=%s RequiresHandle=%s",
            tostring(tool:GetAttribute("IceGunIssueId")),
            tostring(tool.Parent),
            tostring(tool:GetAttribute("IceGunWeapon")),
            tostring(tool.Enabled),
            tostring(tool.ManualActivationOnly),
            tostring(tool.RequiresHandle)
        )
        else ""
    warn("[IceGun server] " .. tostring(player.UserId) .. " " .. stage .. detail)
end

local deps: any
local passId = Config.IceGunGamePassId
local configured = passId > 0 and passId == math.floor(passId) and passId < math.huge
type State = {
    Owned: boolean?,
    Checking: boolean,
    Recheck: boolean,
    NextCheck: number,
    Pending: boolean,
    RequestAt: number,
    AutoEquip: boolean?,
}
local states: { [Player]: State } = {}
local nextIssueId = 0
local issued: { [Player]: Tool? } = {}
local temporary: { [Player]: Tool? } = {}
local connections: { [Player]: { RBXScriptConnection } } = {}

local function stateFor(player: Player): State
    local state = states[player]
    if not state then
        state = { Owned = nil, Checking = false, Recheck = false, NextCheck = 0, Pending = false, RequestAt = 0 }
        states[player] = state
    end
    return state
end

function Service.PlayerOwns(player: Player, force: boolean?): boolean?
    if player.Parent ~= Players or not configured then
        player:SetAttribute("IceGunOwnership", "Unavailable")
        return nil
    end
    local state = stateFor(player)
    if Simulator.Supports(player, passId) then
        state.Owned = Simulator.PlayerOwns(player, passId)
        if state.Owned then
            trace(player, "Studio entitlement verified")
        end
        player:SetAttribute("IceGunOwnership", if state.Owned then "Owned" else "Unowned")
        return state.Owned
    end
    if state.Owned == true then
        return true
    end
    if state.Checking then
        state.Recheck = state.Recheck or force == true
        return nil
    end
    if not force and os.clock() < state.NextCheck then
        return state.Owned
    end
    state.Checking = true
    player:SetAttribute("IceGunOwnership", "Loading")
    local ok, owns = pcall(function()
        return Marketplace:UserOwnsGamePassAsync(player.UserId, passId)
    end)
    if states[player] ~= state or player.Parent ~= Players then
        return nil
    end
    state.Checking = false
    state.NextCheck = os.clock() + Config.OwnershipRetrySeconds
    state.Owned = if ok and typeof(owns) == "boolean" then owns else nil
    player:SetAttribute(
        "IceGunOwnership",
        if state.Owned == true then "Owned" elseif state.Owned == false then "Unowned" else "Unavailable"
    )
    if state.Owned == true then
        trace(player, "entitlement verified")
    end
    if not ok then
        warn("[IceGun] Marketplace ownership check failed: " .. tostring(owns))
    end
    if state.Recheck then
        state.Recheck = false
        task.defer(function()
            if states[player] == state and Service.PlayerOwns(player, true) then
                Service.GrantIfOwned(player)
            end
        end)
    end
    return state.Owned
end

local function removeTool(player: Player)
    local tool = issued[player]
    issued[player] = nil
    temporary[player] = nil
    player:SetAttribute("IceGunEquipped", false)
    if tool then
        tool:Destroy()
    end
    deps.IceGunProjectileService.ClearPlayer(player)
end

local function issueTool(player: Player): Tool?
    local state = states[player]
    if player.Parent ~= Players or not state then
        return nil
    end
    local character = player.Character
    local h = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not character or not h or h.Health <= 0 or not backpack then
        return nil
    end
    local existing = issued[player]
    if existing and existing.Parent ~= character and existing.Parent ~= backpack then
        removeTool(player)
        existing = nil
    end
    -- Name/attributes never authorize a foreign/legacy copy, even beside an issued one.
    for _, container in { character :: Instance, backpack :: Instance } do
        for _, child in container:GetChildren() do
            if child:IsA("Tool") and child.Name == "IcicleGun" and child ~= existing then
                child:Destroy()
            end
        end
    end
    if existing then
        trace(player, "grant reused issued Tool", existing)
        state.AutoEquip = nil
        return existing
    end
    removeTool(player)
    local weapons = ServerStorage:FindFirstChild("Weapons")
    local template = weapons and weapons:FindFirstChild("IcicleGun")
    if not template or not template:IsA("Tool") then
        warn("[IceGun] Missing sanitized ServerStorage.Weapons.IcicleGun")
        return nil
    end
    local clone = template:Clone()
    clone.CanBeDropped = false
    for _, object in clone:GetDescendants() do
        if object:IsA("BaseScript") or object:IsA("RemoteEvent") or object:IsA("RemoteFunction") then
            object:Destroy()
        elseif object:IsA("BasePart") then
            deps.IceGunEffects.Inert(object, false)
        end
    end
    clone:SetAttribute("IceGunWeapon", true)
    nextIssueId += 1
    clone:SetAttribute("IceGunIssueId", nextIssueId) -- Diagnostic correlation only; never authorization.
    issued[player] = clone
    trace(player, "Tool issued and registered", clone)
    clone.AncestryChanged:Connect(function()
        if issued[player] == clone then
            player:SetAttribute("IceGunEquipped", clone.Parent == player.Character)
            if clone.Parent == player.Character then
                trace(player, "Tool equipped (ancestry)", clone)
            end
        end
        task.defer(function()
            if issued[player] == clone and clone.Parent ~= backpack and clone.Parent ~= character then
                trace(player, "issued Tool removed", clone)
                removeTool(player)
            end
        end)
    end)
    clone.Parent = backpack
    trace(player, "Tool granted to Backpack", clone)
    -- Consume the purchase preference once; later grants/refreshes never steal hotbar selection.
    if state.AutoEquip then
        state.AutoEquip = nil
        if deps.MovementService.CanPerformGameplayAction(player) and not h.PlatformStand then
            h:EquipTool(clone)
        end
    end
    return clone
end

function Service.GrantIfOwned(player: Player): Tool?
    -- Grant is deliberately nonyielding; only a server-confirmed cached entitlement qualifies.
    local state = states[player]
    if not configured or not state or state.Owned ~= true then
        return nil
    end
    return issueTool(player)
end

-- Server-only admin grant. Authorizes this instance, never account entitlement or a future life.
function Service.GrantOnce(player: Player): Tool?
    if player.Parent ~= Players then
        return nil
    end
    stateFor(player)
    local tool = issueTool(player)
    if tool then
        temporary[player] = tool
    end
    return tool
end

local function authorized(player: Player): boolean
    local state, tool = states[player], issued[player]
    return tool ~= nil and (temporary[player] == tool or (configured and state ~= nil and state.Owned == true))
end

function Service.IsEquipped(player: Player): boolean
    local tool = issued[player]
    return player.Parent == Players and authorized(player) and tool ~= nil and tool.Parent == player.Character
end

function Service.GetEquipped(player: Player): Tool?
    if Service.IsEquipped(player) then
        return issued[player]
    end
    local tool = issued[player]
    local reason = if not configured and not authorized(player)
        then "pass unavailable"
        elseif not authorized(player) then "entitlement unverified"
        elseif not tool then "no registered Tool"
        else "registered Tool not in current Character"
    trace(player, "fire authorization rejected: " .. reason, tool)
    return nil
end

-- Hotbar selection is intent; only this server's live issued instance may move.
function Service.RequestSelection(player: Player, requested: any, equip: any): boolean
    local tool = issued[player]
    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if
        player.Parent ~= Players
        or not authorized(player)
        or not tool
        or requested ~= tool
        or typeof(equip) ~= "boolean"
        or not character
        or not backpack
        or not humanoid
        or humanoid.Health <= 0
        or (tool.Parent ~= backpack and tool.Parent ~= character)
    then
        trace(player, "selection rejected: invalid issued Tool/owner/character", tool)
        return false
    end
    if equip then
        if humanoid.PlatformStand or not deps.MovementService.CanPerformGameplayAction(player) then
            return false
        end
        if tool.Parent ~= character then
            humanoid:EquipTool(tool)
        end
    elseif tool.Parent == character then
        -- Put away only our weapon; never unequip a newly selected Bat/carry Tool.
        tool.Parent = backpack
    end
    player:SetAttribute("IceGunEquipped", tool.Parent == character)
    trace(player, if equip then "hotbar selection equipped" else "hotbar selection put away", tool)
    return true
end

function Service.RequestEquip(player: Player): boolean
    if not deps.MovementService.CanPerformGameplayAction(player) then
        return false
    end
    local before = issued[player]
    trace(player, "pedestal equip before reconciliation", before)
    local tool = Service.GrantIfOwned(player)
    trace(player, if tool == before then "pedestal reused issued Tool" else "pedestal replaced issued Tool", tool)
    if not tool or not Service.RequestSelection(player, tool, true) then
        return false
    end
    trace(
        player,
        if Service.IsEquipped(player)
            then "pedestal EquipTool: server equipped"
            else "pedestal EquipTool: server not equipped",
        tool
    )
    return true
end

-- Optional proximity validator belongs to the world entry point, checked again after async ownership.
function Service.RequestPurchase(player: Player, validate: (() -> boolean)?): boolean
    if player.Parent ~= Players or not configured or (validate and not validate()) then
        return false
    end
    local state = stateFor(player)
    if os.clock() < state.RequestAt or state.Pending or state.Checking then
        return false
    end
    state.RequestAt = os.clock() + Config.RequestInterval
    local owns = Service.PlayerOwns(player)
    if states[player] ~= state or player.Parent ~= Players or (validate and not validate()) then
        return false
    end
    if owns == true then
        return Service.RequestEquip(player)
    elseif owns == nil then
        return false
    end
    state.Pending = true
    local ok, problem = pcall(function()
        Marketplace:PromptGamePassPurchase(player, passId)
    end)
    if not ok and states[player] == state then
        state.Pending = false
        state.Owned = nil
        player:SetAttribute("IceGunOwnership", "Unavailable")
        warn("[IceGun] Purchase prompt failed: " .. tostring(problem))
    end
    return ok
end

function Service.AddPlayer(player: Player)
    player:SetAttribute("IceGunOwnership", if configured then "Loading" else "Unavailable")
    task.spawn(function()
        if Service.PlayerOwns(player) then
            Service.GrantIfOwned(player)
        end
    end)
end

function Service.ApplyCharacter(player: Player, character: Model)
    removeTool(player)
    deps.IceGunProjectileService.RemovePlayer(player)
    for _, c in (connections[player] or {}) :: { RBXScriptConnection } do
        c:Disconnect()
    end
    local list: { RBXScriptConnection } = {}
    connections[player] = list
    table.insert(
        list,
        player.CharacterRemoving:Connect(function(old)
            if old == character then
                removeTool(player)
            end
        end)
    )
    table.insert(
        list,
        player.ChildAdded:Connect(function(child)
            if child:IsA("Backpack") then
                Service.GrantIfOwned(player)
            end
        end)
    )
    task.spawn(function()
        local h = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        if connections[player] ~= list or player.Character ~= character or not h or not h:IsA("Humanoid") then
            return
        end
        table.insert(
            list,
            h.Died:Connect(function()
                removeTool(player)
            end)
        )
        if Service.PlayerOwns(player) then
            Service.GrantIfOwned(player)
        end
    end)
end

function Service.RemovePlayer(player: Player)
    Simulator.RemovePlayer(player)
    states[player] = nil -- Invalidates outstanding Marketplace results before cleanup.
    removeTool(player)
    for _, c in (connections[player] or {}) :: { RBXScriptConnection } do
        c:Disconnect()
    end
    connections[player] = nil
end

function Service.Init(services)
    deps = services
    if Config.DebugLogging and RunService:IsStudio() then
        warn("[IceGun server] ownership initialized revision=icegun-reequip-2026-10-11 module=" .. script:GetFullName())
    end
    if not configured then
        warn("[IceGun] IceGunGamePassId is unconfigured/invalid; purchases and grants disabled.")
    end
    local remote = Instance.new("RemoteEvent")
    remote.Name = "IceGunRequest"
    remote.Parent = ReplicatedStorage
    remote.OnServerEvent:Connect(function(player, action)
        if action == "Purchase" or action == "Equip" then
            Service.RequestPurchase(player)
        elseif action == "Refresh" then
            local state = stateFor(player)
            if os.clock() >= state.RequestAt then
                state.RequestAt = os.clock() + Config.RequestInterval
                if Service.PlayerOwns(player) then
                    Service.GrantIfOwned(player)
                end
            end
        end
    end)
    Marketplace.PromptGamePassPurchaseFinished:Connect(function(player, id, purchased)
        if id ~= passId or not states[player] or player.Parent ~= Players then
            return
        end
        local state = states[player]
        local pending = state.Pending
        state.Pending = false
        if purchased ~= true then
            return
        end
        if Simulator.Supports(player, id) then
            if pending and Simulator.Complete(player, id) then
                Service.PlayerOwns(player)
                state.AutoEquip = true
                Service.GrantIfOwned(player)
            end
            return
        end
        -- Production: server event is only a reason to recheck; never itself entitlement.
        task.spawn(function()
            for attempt = 1, 3 do
                if player.Parent ~= Players or not states[player] then
                    return
                end
                if Service.PlayerOwns(player, true) then
                    states[player].AutoEquip = true
                    Service.GrantIfOwned(player)
                    return
                end
                if attempt < 3 then
                    task.wait(attempt * 2)
                end
            end
        end)
    end)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">IceShotgunPresentationService</string>
            <string name="Source"><![CDATA[--!strict
-- Server output only. Cosmetic clients never choose hits or acknowledge damage.
local Events = game:GetService("ReplicatedStorage").Shared.Events
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IceGunConfig)
local Service = {}
export type Hit = { Position: Vector3, UserId: number, Frozen: boolean }
local remote: RemoteEvent?

function Service.Init()
    if remote then
        return
    end
    local event = Instance.new("RemoteEvent")
    event.Name = "IceShotgunResult"
    event.Parent = Events
    remote = event
end

-- Origin is the caster root and Radius is the authoritative hit radius, so
-- clients render a pulse whose size is exactly the server hit sphere. No
-- direction or angle is broadcast: there is no cone to draw anymore.
function Service.Emit(player: Player, origin: Vector3, hits: { Hit })
    if remote then
        remote:FireAllClients({
            ShooterUserId = player.UserId,
            Origin = origin,
            Radius = Config.BlastRadius,
            Hits = hits,
            ServerTime = workspace:GetServerTimeNow(),
        })
    end
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">IngredientCarryPresentation</string>
            <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IngredientCarry)
local Item = require(game:GetService("ReplicatedStorage").Shared.IngredientItem)
local MoneyFormat = require(game:GetService("ReplicatedStorage").Shared.MoneyFormat)
local WorldUtil = require(script.Parent.WorldUtil)
local Presentation = {}

local function headTop(characterRoot: BasePart): number
    local head = characterRoot.Parent and characterRoot.Parent:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        local at = characterRoot.CFrame:ToObjectSpace(head.CFrame)
        return at.Position.Y
            + (
                    math.abs(at.RightVector.Y) * head.Size.X
                    + math.abs(at.UpVector.Y) * head.Size.Y
                    + math.abs(at.LookVector.Y) * head.Size.Z
                )
                * 0.5
    end
    return characterRoot.Size.Y * 0.5 + 1.5
end

-- Called only by inventory synchronization, using its private held records.
-- Height uses the same measured stack extents as Attach, without waiting for weld physics.
function Presentation.RefreshValue(player: Player, stack: { any })
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then
        return
    end
    local previous = root:FindFirstChild("CarryValue")
    if #stack == 0 then
        if previous then
            previous:Destroy()
        end
        return
    end
    local total, height = 0, 0
    local hasIngredient = false
    for _, item in stack do
        if not item.Smoothie then
            hasIngredient = true
            total += Item.GetIngredientValue(item.Item, workspace:GetServerTimeNow())
            height += item.Height
        end
    end
    if not hasIngredient then
        if previous then
            previous:Destroy()
        end
        return
    end
    local gui = if previous then previous :: BillboardGui else Instance.new("BillboardGui")
    local staleDetails = gui:FindFirstChild("RipenessDetails")
    if staleDetails then
        staleDetails:Destroy()
    end
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    BillboardStyle.ApplyBillboard(gui, { WidthStuds = 7.2, HeightStuds = 1.8, MaxDistance = 100 })
    if not previous then
        gui.Name = "CarryValue"
        gui.Adornee = root
        gui.AlwaysOnTop = true
        gui.ResetOnSpawn = false
        local label = Instance.new("TextLabel")
        label.Name = "Value"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextSize = 28
        label.TextScaled = true
        label.TextColor3 = Color3.fromRGB(100, 235, 120)
        BillboardStyle.ApplyWorldStroke(label, gui, { Color = Color3.new(0, 0, 0) })
        label.Parent = gui
        gui.Parent = root
    end
    local top = headTop(root) + math.max(0, Config.HeightAboveHead) + math.max(0, height - Config.StackGap)
    gui.StudsOffsetWorldSpace = Vector3.new(0, top + 1, -Config.ForwardOffset)
    local label = gui:FindFirstChild("Value") :: TextLabel
    label.Size = UDim2.fromScale(1, 1)
    label.Text = MoneyFormat.Compact(total)
end

-- Measure every oriented part in character-local space, including off-center
-- PrimaryParts. The lowest corner, rather than the root center, clears the head.
function Presentation.Offset(visual: Instance, characterRoot: BasePart, stackHeight: number?): (CFrame, number)
    local ingredientRoot = WorldUtil.Part(visual)
    assert(ingredientRoot, "Carried ingredient needs a BasePart")
    local degrees = Config.RotationDegrees
    local rotation = CFrame.Angles(math.rad(degrees.X), math.rad(degrees.Y), math.rad(degrees.Z))
    local lowest = math.huge
    local highest = -math.huge
    local parts = visual:GetDescendants()
    table.insert(parts, visual)
    for _, part in parts do
        if part:IsA("BasePart") then
            local at = rotation * ingredientRoot.CFrame:ToObjectSpace(part.CFrame)
            local half = part.Size * 0.5
            local radiusY = math.abs(at.RightVector.Y) * half.X
                + math.abs(at.UpVector.Y) * half.Y
                + math.abs(at.LookVector.Y) * half.Z
            lowest = math.min(lowest, at.Position.Y - radiusY)
            highest = math.max(highest, at.Position.Y + radiusY)
        end
    end
    local top = headTop(characterRoot)
    return CFrame.new(0, top + math.max(0, Config.HeightAboveHead) - lowest + (stackHeight or 0), -Config.ForwardOffset)
        * rotation,
        highest - lowest + Config.StackGap
end

-- Visuals live on the character independently of Backpack selection.
-- All placement is server-owned; no hand grip is created.
function Presentation.Attach(
    visual: Instance,
    host: Instance,
    root: BasePart,
    stackHeight: number?
): (CFrame, () -> (), number, (number) -> ())
    local ingredientRoot = WorldUtil.Part(visual)
    assert(ingredientRoot, "Carried ingredient needs a BasePart")
    local offset, height = Presentation.Offset(visual, root, stackHeight)
    local physical = visual :: any
    local rootToPivot = ingredientRoot.CFrame:ToObjectSpace(physical:GetPivot())
    physical:PivotTo(root.CFrame * offset * rootToPivot)
    local anchor = Instance.new("Part")
    anchor.Name = "CarryAnchor"
    anchor.Size = Vector3.new(0.1, 0.1, 0.1)
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.CanTouch = false
    anchor.CanQuery = false
    anchor.Massless = true
    anchor.CFrame = root.CFrame * offset
    anchor.Parent = host
    local parts = visual:GetDescendants()
    table.insert(parts, visual)
    -- The successful pickup consumed the authoritative world object. Its cloned
    -- visual releases every part before creating any carry welds.
    for _, part in parts do
        if part:IsA("BasePart") then
            part.Anchored = false
        end
    end
    visual:SetAttribute("FrozenUntilPickup", nil)
    for _, part in parts do
        game:GetService("CollectionService"):RemoveTag(part, "IngredientWorldItem")
        if part:IsA("ProximityPrompt") then
            part:Destroy()
        elseif part:IsA("BasePart") then
            part.CanCollide = false
            part.CanTouch = false
            part.Massless = true
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = anchor
            weld.Part1 = part
            weld.Parent = anchor
        end
    end
    visual.Parent = host
    local carryWeld = Instance.new("Weld")
    carryWeld.Name = "OverheadCarry"
    carryWeld.Part0 = root
    carryWeld.Part1 = anchor
    carryWeld.C0 = offset
    carryWeld.Parent = anchor

    return offset * rootToPivot,
        function()
            anchor:Destroy()
            visual:Destroy()
        end,
        height,
        function(amount: number)
            carryWeld.C0 = CFrame.new(0, -amount, 0) * carryWeld.C0
        end
end

return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">IngredientGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- Geometry only: safe to require from the Edit-mode Command Bar; no registration.
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local WorldUtil = require(script.Parent.WorldUtil)
local Geometry = {}
-- Item copies share an opaque key. When the final item/snapshot releases it,
-- this weak-key entry releases its detached, behavior-free template as well.
local headTemplates = setmetatable({} :: { [{}]: BasePart }, { __mode = "k" })

function Geometry.CapturePlayerHead(template: Instance?): {}?
    if not template or not template:IsA("BasePart") then
        return nil
    end
    local clone: BasePart? = nil
    local success = pcall(function()
        clone = template:Clone()
        local head = clone
        if not head then
            return
        end
        -- Keep rendered head data, including dynamic-head bones/FaceControls,
        -- but no rig joints, character references, scripts, sounds or effects.
        for _, child in head:GetDescendants() do
            if
                not (
                    child:IsA("DataModelMesh")
                    or child:IsA("Decal")
                    or child:IsA("Texture")
                    or child:IsA("SurfaceAppearance")
                    or child:IsA("Attachment")
                    or child:IsA("FaceControls")
                    or child:IsA("BaseWrap")
                    or child:IsA("Folder")
                )
            then
                child:Destroy()
            end
        end
        local descendants = head:GetDescendants()
        table.insert(descendants, head)
        for _, child in descendants do
            for _, tag in CollectionService:GetTags(child) do
                CollectionService:RemoveTag(child, tag)
            end
            for name in child:GetAttributes() do
                child:SetAttribute(name, nil)
            end
        end
        head.Anchored = false
        head.CanCollide, head.CanTouch, head.CanQuery = true, true, true
        head.Massless = false
        head.CollisionGroup = "Default"
        -- Roblox accepts nil to restore material defaults; the installed API typings do not.
        head.CustomPhysicalProperties = nil :: any
        head.AssemblyLinearVelocity, head.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
    end)
    if not success or not clone then
        if clone then
            clone:Destroy()
        end
        return nil
    end
    local key = table.freeze({})
    headTemplates[key] = clone
    return key
end

-- Shared by world spawns and stash/carry visuals; registration stays in Spawn.
local function prepareAssembly(object: Instance)
    -- An explicit pivot root avoids choosing an arbitrary leaf/stem/mesh. It also
    -- keeps a no-PrimaryPart model's authored pivot unchanged when made physical.
    if object:IsA("Model") and not object.PrimaryPart then
        local root = Instance.new("Part")
        root.Name = "IngredientRoot"
        root.Size = Vector3.new(0.1, 0.1, 0.1)
        root.Transparency = 1
        root.CanCollide = false
        root.CanTouch = false
        root.Massless = true
        root.CFrame = object:GetPivot()
        root.Parent = object
        object.PrimaryPart = root
    end
    local root = WorldUtil.Part(object)
    for _, part in object:GetDescendants() do
        if root and part:IsA("BasePart") and part ~= root then
            local weld = Instance.new("WeldConstraint")
            weld.Name = "IngredientAssembly"
            weld.Part0 = root
            weld.Part1 = part
            weld.Parent = part
        end
    end
end

function Geometry.CreateVisual(id: string, definition: any, visualKey: {}?): Instance?
    if not definition then
        return nil
    end
    local templates = ServerStorage:FindFirstChild("Ingredients")
    local appearance = if id == "PlayerHead" and visualKey then headTemplates[visualKey] else nil
    local template = appearance or (templates and templates:FindFirstChild(id))
    local object: Instance
    if template and (template:IsA("Model") or template:IsA("BasePart")) and WorldUtil.Part(template) then
        object = template:Clone()
    else
        local part = Instance.new("Part")
        part.Size = Vector3.new(1.5, 1.5, 1.5)
        part.Color = definition.BlendColor
        object = part
    end
    -- Templates are geometry, not live components. Register only the new world
    -- root after its private record exists; cloned tags must not bind early.
    local descendants = object:GetDescendants()
    table.insert(descendants, object)
    for _, child in descendants do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        if child:IsA("ProximityPrompt") or child:IsA("ClickDetector") or child:IsA("LuaSourceContainer") then
            child:Destroy()
        end
    end
    prepareAssembly(object)
    return object
end

return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">IngredientService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Definitions = require(Shared.Constants.Ingredients)
local Economy = require(Shared.Constants.Economy)
local WorldUtil = require(script.Parent.WorldUtil)
local Geometry = require(script.Parent.IngredientGeometry)
local Item = require(Shared.IngredientItem)
local Types = require(Shared.Types)
local IngredientService = {}
-- Tags/attributes are presentation metadata, never proof of ownership or validity.
type Record = {
    Id: string,
    Owner: Player?,
    Claimable: boolean,
    Item: Types.IngredientItem,
    FarmManaged: boolean,
    FeedingActor: Player?,
    FeedingSessionId: string?,
    MuncherImmune: boolean,
    Reserved: boolean?,
}
local records: { [Instance]: Record } = {}
local reservations: { [Instance]: {} } = {}

function IngredientService.GetDefinition(id: string)
    return (Definitions :: any)[id]
end
function IngredientService.CreateVisual(id: string, item: Types.IngredientItem?): Instance?
    return Geometry.CreateVisual(id, IngredientService.GetDefinition(id), item and item.VisualKey)
end
function IngredientService.Spawn(
    id: string,
    at: CFrame,
    owner: Player?,
    claimable: boolean?,
    options: {
        Item: Types.IngredientItem?,
        Origin: Types.IngredientOrigin?,
        VisualTemplate: Instance?,
        FreezeUntilPickup: boolean?,
        FarmManaged: boolean?,
        FeedingActor: Player?,
        FeedingSessionId: string?,
        MuncherImmune: boolean?,
        PrepareSpawn: ((Instance, CFrame) -> CFrame?)?,
        BeforePublish: ((Instance) -> ())?,
    }?
): Instance?
    -- Only creation may assign provenance. Drop/throw/respawn records are copied untouched.
    local item: Types.IngredientItem = if options and options.Item
        then table.clone(options.Item)
        else Item.New(id, HttpService:GenerateGUID(false), if options then options.Origin else nil)
    if id == "PlayerHead" and options and options.VisualTemplate then
        item.VisualKey = Geometry.CapturePlayerHead(options.VisualTemplate)
    end
    local object = IngredientService.CreateVisual(id, item)
    if not object then
        return nil
    end
    if options and options.PrepareSpawn then
        local preparedAt = options.PrepareSpawn(object, at)
        if not preparedAt then
            object:Destroy()
            return nil
        end
        at = preparedAt
    end
    object.Name = id
    object:SetAttribute("IngredientId", id)
    object:SetAttribute("WorldItemId", item.ItemId)
    Item.ApplySourceMetadata(object, item)
    object:SetAttribute("EffectiveIngredientValue", Item.GetIngredientValue(item, workspace:GetServerTimeNow()))
    object:SetAttribute("IsRipe", item.IsRipe)
    object:SetAttribute("RipenessStoredSeconds", item.RipenessStoredSeconds)
    object:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
    local frozen = options ~= nil and options.FreezeUntilPickup == true
    object:SetAttribute("FrozenUntilPickup", if frozen then true else nil)
    -- Preparation has succeeded, but no world physics or pickup listeners can see it yet.
    if options and options.BeforePublish then
        options.BeforePublish(object)
    end
    local physical = object :: any
    physical:PivotTo(at)
    local root = WorldUtil.Part(object)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            part.Anchored = frozen
            part.CanQuery = true
        end
    end
    object.Parent = workspace
    if root and root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end
    records[object] = {
        Id = id,
        Owner = owner,
        FeedingActor = if options then options.FeedingActor else nil,
        FeedingSessionId = if options then options.FeedingSessionId else nil,
        MuncherImmune = options ~= nil and options.MuncherImmune == true,
        Claimable = claimable ~= false,
        Item = item,
        -- Server lifecycle state, deliberately separate from presentation/item metadata.
        -- Consume retires this record on harvest; drop/throw spawn a fresh loose record.
        FarmManaged = options ~= nil and options.FarmManaged == true,
    }
    object.Destroying:Connect(function()
        records[object] = nil
        reservations[object] = nil
    end)
    CollectionService:AddTag(object, "IngredientWorldItem")
    return object
end
function IngredientService.Resolve(hit: Instance): Instance?
    local current: Instance? = hit
    while current and current ~= workspace do
        if records[current] then
            return current
        end
        current = current.Parent
    end
    return nil
end
function IngredientService.GetRecord(object: Instance): Record?
    local record = records[object]
    if not record or not object:IsDescendantOf(workspace) then
        return nil
    end
    local copy = table.clone(record)
    copy.Item = table.clone(record.Item)
    copy.Reserved = reservations[object] ~= nil
    return copy
end
-- Short, non-yielding claims shared by world consumers. Existing callers without a
-- token cannot consume a reserved item; pickup/blender callers already handle nil.
function IngredientService.Reserve(object: Instance): {}?
    if not IngredientService.GetRecord(object) or reservations[object] then
        return nil
    end
    local token = {}
    reservations[object] = token
    return token
end
function IngredientService.ReleaseReservation(object: Instance, token: {})
    if reservations[object] == token then
        reservations[object] = nil
    end
end

-- Pickup callers set pickedUp only after inventory authorization/reservation succeeds.
-- Other removal paths (including cleanup) never release frozen physics.
function IngredientService.Consume(object: Instance, pickedUp: boolean?, token: {}?): string?
    local record = IngredientService.GetRecord(object)
    if not record or (reservations[object] ~= nil and reservations[object] ~= token) then
        return nil
    end
    -- Pickup retires this spawn and its immunity; item metadata never inherits it.
    records[object] = nil
    reservations[object] = nil
    if pickedUp and object:GetAttribute("FrozenUntilPickup") == true then
        local parts = object:GetDescendants()
        table.insert(parts, object)
        for _, part in parts do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end
        object:SetAttribute("FrozenUntilPickup", nil)
    end
    object:Destroy()
    return record.Id
end
-- Snapshot the registry: removal callbacks may replenish spawn systems.
-- Carry, stash and accepted blender contents have already left this registry.
-- Farm products stay registered for pickup, but belong to their row until consumed.
function IngredientService.ClearLooseIngredients()
    local remove = {}
    for object, record in records do
        if not record.FarmManaged then
            table.insert(remove, object)
        end
    end
    for _, object in remove do
        local record = records[object]
        if record and not record.FarmManaged then
            IngredientService.Consume(object)
        end
    end
end

local started = false
function IngredientService.Init(services: any)
    if started then
        return
    end
    started = true
    local interval = Economy.WorldIngredientCleanupInterval
    local warningSeconds = Economy.WorldIngredientCleanupWarningSeconds
    local countdownSeconds = Economy.WorldIngredientCleanupCountdownSeconds
    local nextCleanup = os.clock() + interval
    local function scheduleCycle()
        task.delay(math.max(0, nextCleanup - warningSeconds - os.clock()), function()
            services.AnnouncementService.Publish({
                Type = "ServerAnnouncement",
                Text = "LOOSE INGREDIENTS CLEAR IN 1 MINUTE!",
                Duration = 5,
                Priority = 100,
                Immediate = true,
            })
            task.delay(math.max(0, nextCleanup - countdownSeconds - os.clock()), function()
                local remaining = nextCleanup - os.clock()
                if remaining > 0 then
                    services.AnnouncementService.Publish({
                        Type = "IngredientCleanupCountdown",
                        EndsAt = workspace:GetServerTimeNow() + remaining,
                        Priority = 100,
                    })
                end
                task.delay(math.max(0, nextCleanup - os.clock()), function()
                    IngredientService.ClearLooseIngredients()
                    -- Keep the original cadence without replaying missed cycles after a stall.
                    repeat
                        nextCleanup += interval
                    until nextCleanup - warningSeconds > os.clock()
                    scheduleCycle()
                end)
            end)
        end)
    end
    scheduleCycle()
end

function IngredientService.RemovePlayer(player: Player)
    local remove = {}
    for object, record in records do
        if record.Owner == player then
            table.insert(remove, object)
        end
    end
    for _, object in remove do
        IngredientService.Consume(object)
    end
end
return require(script.Parent.StudioServices).Wrap("IngredientService", IngredientService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">IngredientThrow</string>
            <string name="Source"><![CDATA[--!strict
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")
local IngredientThrow = {}
local GRACE_SECONDS = 0.2
local CLEARANCE = 0.25
local MAX_DISTANCE = 32

local diagnostics =
    setmetatable({} :: { [Player]: { Attempt: string, Window: number, Count: number } }, { __mode = "k" })

-- Correlation metadata never participates in gameplay validation.
function IngredientThrow.BeginRequest(player: Player, attempt: any)
    if player:GetAttribute("ThrowDebug") ~= true then
        diagnostics[player] = nil
        return
    end
    local state: { Attempt: string, Window: number, Count: number } = diagnostics[player]
        or { Attempt = "none", Window = os.clock(), Count = 0 }
    state.Attempt = if type(attempt) == "number"
            and attempt == attempt
            and attempt >= 0
            and attempt <= 2147483647
            and attempt == math.floor(attempt)
        then tostring(attempt)
        else "none"
    diagnostics[player] = state
end

function IngredientThrow.Trace(player: Player, message: string)
    if player:GetAttribute("ThrowDebug") ~= true then
        return
    end
    local state = diagnostics[player]
    if not state then
        IngredientThrow.BeginRequest(player, nil)
        state = diagnostics[player]
    end
    if not state then
        return
    end
    local now = os.clock()
    if now - state.Window >= 5 then
        state.Window, state.Count = now, 0
    end
    if state.Count >= 40 then
        return
    end
    state.Count += 1
    print("[ThrowServer] player=" .. player.Name .. " attempt=" .. state.Attempt .. " " .. message)
end

-- Retain the nominal facing frame for callers; placement is validated after preparation.
function IngredientThrow.Origin(root: BasePart): CFrame
    return root.CFrame * CFrame.new(0, 2, -5)
end

local function extent(part: BasePart, direction: Vector3): number
    local frame, half = part.CFrame, part.Size * 0.5
    return math.abs(frame.RightVector:Dot(direction)) * half.X
        + math.abs(frame.UpVector:Dot(direction)) * half.Y
        + math.abs(frame.LookVector:Dot(direction)) * half.Z
end

-- A pivot-centered radius also covers multipart templates with off-center pivots.
local function radius(object: Instance): number
    local pivot = (object :: any):GetPivot().Position
    local result = 0
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            result = math.max(result, (part.CFrame.Position - pivot).Magnitude + part.Size.Magnitude * 0.5)
        end
    end
    return result + CLEARANCE
end

-- Bounds in the object's pivot frame become oriented bounds under the spawn rotation.
-- Preserve the center offset so asymmetric multipart templates are queried correctly.
local function bounds(object: Instance): (Vector3, Vector3)
    local pivot = (object :: any):GetPivot()
    local low = Vector3.new(math.huge, math.huge, math.huge)
    local high = Vector3.new(-math.huge, -math.huge, -math.huge)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            local relative = pivot:ToObjectSpace(part.CFrame).Position
            local half = Vector3.new(
                extent(part, pivot.RightVector),
                extent(part, pivot.UpVector),
                extent(part, pivot.LookVector * -1)
            )
            local lower, upper = relative - half, relative + half
            low = Vector3.new(math.min(low.X, lower.X), math.min(low.Y, lower.Y), math.min(low.Z, lower.Z))
            high = Vector3.new(math.max(high.X, upper.X), math.max(high.Y, upper.Y), math.max(high.Z, upper.Z))
        end
    end
    return (low + high) * 0.5, high - low + Vector3.new(2, 2, 2) * CLEARANCE
end

-- No client position, cursor target, head height, or character-wide bounding box.
-- Carried visuals/Tools must not inflate the avatar's physical clearance.
function IngredientThrow.FindOrigin(root: BasePart, character: Model, object: Instance): (CFrame?, string)
    local facing = root.CFrame.LookVector
    local direction = Vector3.new(facing.X, 0, facing.Z).Unit
    local itemRadius = radius(object)
    local front = 0
    for _, part in character:GetDescendants() do
        if
            part:IsA("BasePart")
            and not part:FindFirstAncestorWhichIsA("Tool")
            and not part:FindFirstAncestor("IngredientCarryVisuals")
        then
            front =
                math.max(front, (part.CFrame.Position - root.CFrame.Position):Dot(direction) + extent(part, direction))
        end
    end
    local minimum = front + itemRadius + CLEARANCE
    if minimum > MAX_DISTANCE then
        return nil, "avatar/item clearance exceeds safe distance"
    end
    local boxCenter, boxSize = bounds(object)
    local excluded: { Instance } = { character }
    -- Running receptors resolve arrivals through their vacuum, including busy shake-off.
    for _, plot in CollectionService:GetTagged("PlayerPlot") do
        local muncher = plot:FindFirstChild("Muncher")
        if muncher and muncher:GetAttribute("Purchased") == true and muncher:GetAttribute("Active") == true then
            table.insert(excluded, muncher)
        end
    end
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = excluded
    overlap.RespectCanCollide = true
    local start = root.CFrame.Position + Vector3.new(0, math.max(2, itemRadius), 0)
    local distances = {}
    local distance = math.max(5, minimum)
    while distance > minimum do
        table.insert(distances, distance)
        distance -= 1
    end
    table.insert(distances, minimum)
    for _, angle in { 0, 20, -20, 40, -40 } do
        local radians = math.rad(angle)
        local candidateDirection = Vector3.new(
            direction.X * math.cos(radians) + direction.Z * math.sin(radians),
            0,
            -direction.X * math.sin(radians) + direction.Z * math.cos(radians)
        )
        for _, candidateDistance in distances do
            local position = start + candidateDirection * candidateDistance
            local origin = CFrame.new(position) * root.CFrame.Rotation
            local occupied = workspace:GetPartBoundsInBox(origin * CFrame.new(boxCenter), boxSize, overlap)
            if #occupied == 0 then
                return origin, string.format("clear distance=%.3f angle=%d", candidateDistance, angle)
            end
        end
    end
    return CFrame.new(start + direction * minimum) * root.CFrame.Rotation,
        string.format("placement forced distance=%.3f", minimum)
end

-- Pairwise exclusions preserve collisions with the world, blender and other players.
-- Install before publishing the object to Workspace; no global collision groups change.
function IngredientThrow.IgnoreCharacter(object: Instance, character: Model)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            for _, body in character:GetDescendants() do
                if body:IsA("BasePart") then
                    local exclusion = Instance.new("NoCollisionConstraint")
                    exclusion.Part0 = part
                    exclusion.Part1 = body
                    exclusion.Parent = part
                    Debris:AddItem(exclusion, GRACE_SECONDS)
                end
            end
        end
    end
end

return IngredientThrow
]]></string>
          </Properties>
