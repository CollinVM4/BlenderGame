          <token name="RunContext">0</token>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{86A76A5F-6155-4636-8903-861DD50F00AA}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- Framewisp: keeps text and stroke sizes accurate at any screen resolution.
-- Safe to delete only if your UI never changes resolution (text will stop scaling).
local TextService = game:GetService("TextService")
local gui = script.Parent
do
	local okv, v = pcall(function() return script:GetAttribute("FWv") end)
	print("[Framewisp] TextScaler v" .. tostring(okv and v or "?") .. " in " .. gui.Name .. " — baselines are static, Play moves nothing")
end
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end
local function findRoot()
	local dw, dh = gui:GetAttribute("BB_DesignW"), gui:GetAttribute("BB_DesignH")
	for _, d in ipairs(fwAll()) do -- slots transport the design; only stampDesign marks its actual bounds
		if d:IsA("GuiObject") and d:GetAttribute("FW_Owned") == true then
			local w, h = d:GetAttribute("BB_DesignW"), d:GetAttribute("BB_DesignH")
			if type(w) == "number" and w > 0 and type(h) == "number" and h > 0
				and (dw == nil or w == dw) and (dh == nil or h == dh) then
				return d -- retain this object when Card3D reparents it into a SurfaceGui
			end
		end
	end
	local fallback = nil
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("BillboardGui") then -- _billboard: the design lives one level deeper
			local inner = child:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("ObjectValue") and child.Name == "FW_ExtraRoot" and child.Value then
			local inner = child.Value:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("GuiObject") then
			fallback = fallback or child
			if child:GetAttribute("FW_Owned") == true then return child end
		end
	end
	return fallback
end
local root = findRoot()
if not root then return end
local designH = gui:GetAttribute("BB_DesignH") or 1080
local designW = gui:GetAttribute("BB_DesignW")
local factor = gui:GetAttribute("BB_TextFactor") or 1.16
local byKey, facesReady = {}, {}
local reverified = false
local EM = { -- TextSize per design em of each bundled face: a label not sized by its width uses its em
	["rbxasset://fonts/families/AccanthisADFStd.json"] = 1.168,
	["rbxasset://fonts/families/AmaticSC.json"] = 1.261,
	["rbxasset://fonts/families/Arimo.json"] = 1.1172,
	["rbxasset://fonts/families/Balthazar.json"] = 1.018,
	["rbxasset://fonts/families/Bangers.json"] = 1.064,
	["rbxasset://fonts/families/BuilderExtended.json"] = 1.26,
	["rbxasset://fonts/families/BuilderMono.json"] = 1.26,
	["rbxasset://fonts/families/BuilderSans.json"] = 1.26,
	["rbxasset://fonts/families/ComicNeueAngular.json"] = 1.209,
	["rbxasset://fonts/families/Creepster.json"] = 1.1689,
	["rbxasset://fonts/families/DenkOne.json"] = 1.25,
	["rbxasset://fonts/families/Fondamento.json"] = 1.3838,
	["rbxasset://fonts/families/FredokaOne.json"] = 1.21,
	["rbxasset://fonts/families/GrenzeGotisch.json"] = 1.48,
	["rbxasset://fonts/families/Guru.json"] = 1.1846,
	["rbxasset://fonts/families/HighwayGothic.json"] = 1.107,
	["rbxasset://fonts/families/Inconsolata.json"] = 1.049,
	["rbxasset://fonts/families/IndieFlower.json"] = 1.459,
	["rbxasset://fonts/families/JosefinSans.json"] = 1.0,
	["rbxasset://fonts/families/Jura.json"] = 1.183,
	["rbxasset://fonts/families/Kalam.json"] = 1.594,
	["rbxasset://fonts/families/LegacyArial.json"] = 1.1172,
	["rbxasset://fonts/families/LegacyArimo.json"] = 1.1172,
	["rbxasset://fonts/families/LuckiestGuy.json"] = 1.0,
	["rbxasset://fonts/families/Merriweather.json"] = 1.257,
	["rbxasset://fonts/families/Michroma.json"] = 1.4219,
	["rbxasset://fonts/families/Montserrat.json"] = 1.219,
	["rbxasset://fonts/families/Nunito.json"] = 1.364,
	["rbxasset://fonts/families/Oswald.json"] = 1.482,
	["rbxasset://fonts/families/PatrickHand.json"] = 1.354,
	["rbxasset://fonts/families/PermanentMarker.json"] = 1.4268,
	["rbxasset://fonts/families/PressStart2P.json"] = 1.834, -- Figma's face is 1.790x wider than this file: 1.0244 x 1.790
	["rbxasset://fonts/families/Roboto.json"] = 1.1719,
	["rbxasset://fonts/families/RobotoCondensed.json"] = 1.1719,
	["rbxasset://fonts/families/RobotoMono.json"] = 1.3188,
	["rbxasset://fonts/families/RomanAntique.json"] = 1.049,
	["rbxasset://fonts/families/Sarpanch.json"] = 1.4,
	["rbxasset://fonts/families/SourceSansPro.json"] = 1.257,
	["rbxasset://fonts/families/SpecialElite.json"] = 1.0,
	["rbxasset://fonts/families/TitilliumWeb.json"] = 1.521,
	["rbxasset://fonts/families/Ubuntu.json"] = 1.121,
	["rbxasset://fonts/families/Zekton.json"] = 1.2,
}
local ContentProvider = game:GetService("ContentProvider")
local function faceOf(d)
	local f = d.FontFace
	if not f then return "?" end
	return tostring(f.Family) .. "|" .. tostring(f.Weight) .. "|" .. tostring(f.Style)
end
local function textKey(d)
	return faceOf(d) .. "|" .. (d.ContentText:gsub("^%s+", ""):gsub("%s+$", ""))
end
local gridInfo = setmetatable({}, { __mode = "k" })
local function fwRenders()
	local cam = workspace.CurrentCamera
	return cam ~= nil and cam.ViewportSize.X >= 2 and cam.ViewportSize.Y >= 2
end

local function fwHoverRoom(cells, cellW, cellH)
	local hs = 1
	if cells then
		for _, c in ipairs(cells:GetChildren()) do
			if c:IsA("GuiObject") and c:GetAttribute("FigmaSmooth") then
				local v = c:GetAttribute("SmoothHover") or c:GetAttribute("FigmaSmoothHover") or 1.08
				if type(v) == "number" and v > hs then hs = v end
			end
		end
	end
	if hs <= 1 then return 0, 0 end
	return cellW * (hs - 1) / 2, cellH * (hs - 1) / 2
end

local gridGeometry, gridScroll -- mutually recursive: a re-fit updates the canvas

local function gridRatio(cells, fallback, smScale)
	local grid = cells and cells:FindFirstChildWhichIsA("UIGridLayout")
	if not grid then return fallback end
	local winW = grid:GetAttribute("FigmaWinW") or 0
	if winW <= 0 then return fallback end
	local host = cells.Parent
	local live = ((host and host:IsA("ScrollingFrame")) and host.AbsoluteSize.X or cells.AbsoluteSize.X) / smScale
	if live <= 1 then return fallback end
	return live / winW
end

function gridGeometry(d, k, kx, smScale)
	if d:IsA("UIPadding") and d:GetAttribute("FigmaPadL") ~= nil then
		local gs = gridRatio(d.Parent, kx, smScale)
		d.PaddingLeft = UDim.new(0, (d:GetAttribute("FigmaPadL") or 0) * gs)
		d.PaddingTop = UDim.new(0, (d:GetAttribute("FigmaPadT") or 0) * gs)
		d.PaddingBottom = UDim.new(0, (d:GetAttribute("FigmaPadB") or 0) * gs)
		return
	end
	if not (d:IsA("UIGridLayout") and d:GetAttribute("FigmaCellW") ~= nil) then return end
	local cells = d.Parent
	local cols = math.max(1, d.FillDirectionMaxCells)
	local gs = gridRatio(cells, kx, smScale)
	local cellWD = d:GetAttribute("FigmaCellW") or 0
	local cellHD = d:GetAttribute("FigmaCellH") or 0
	local gapXD = d:GetAttribute("FigmaGapX") or 0
	local gapYD = d:GetAttribute("FigmaGapY") or 0
	local pad = cells and cells:FindFirstChildWhichIsA("UIPadding")
	local padLD = (pad and pad:GetAttribute("FigmaPadL")) or 0

	local sf = cells and cells.Parent
	local barD = 0
	if sf and sf:IsA("ScrollingFrame") then
		barD = sf:GetAttribute("FigmaBar") or sf.ScrollBarThickness
		local mineBar = sf:GetAttribute("FW_BarPx")
		if type(mineBar) == "number" and math.abs(sf.ScrollBarThickness - mineBar) > 0.5 then
			barD = sf.ScrollBarThickness / (gs > 0.001 and gs or 1)
			sf:SetAttribute("FigmaBar", barD)
		end
		local wantBar = math.max(2, barD * gs)
		sf.ScrollBarThickness = wantBar
		sf:SetAttribute("FW_BarPx", wantBar)
	end

	local roomD = d:GetAttribute("FigmaHoverRoom")
	if roomD == nil then roomD = select(1, fwHoverRoom(cells, cellWD, cellHD)) end
	local hostW = ((sf and sf:IsA("ScrollingFrame")) and sf.AbsoluteSize.X) or (cells and cells.AbsoluteSize.X) or 0
	local availD = (hostW / smScale) / math.max(gs, 1e-6)
	local cellW = cellWD
	if availD > 1 then
		local maxD = (availD - padLD - (cols - 1) * gapXD - barD - roomD) / cols
		if maxD > 0 and maxD < cellW then cellW = maxD end
	end
	local cellH = cellHD * (cellW / math.max(cellWD, 1e-6)) -- keep the card's shape

	d.CellSize = UDim2.fromOffset(math.max(1, cellW * gs), math.max(1, cellH * gs))
	d.CellPadding = UDim2.fromOffset(gapXD * gs, gapYD * gs)

	local info = gridInfo[d]
	if not info then
		info = {}
		gridInfo[d] = info
	end
	if cells and not info.sizeWired then
		info.sizeWired = true
		cells:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if info.refit and not info.busy and fwRenders() then
				info.busy = true
				info.refit()
				info.busy = false
			end
		end)
	end
	info.refit = function()
		gridGeometry(d, k, kx, smScale)
		if pad then gridGeometry(pad, k, kx, smScale) end -- the origin rides along
		if sf then gridScroll(sf) end
	end
end

function gridScroll(sf)
	if not (sf:IsA("ScrollingFrame") and sf:GetAttribute("FWGridScroll")) then return end
	local cells, grid
	for _, c in ipairs(sf:GetChildren()) do
		if c.Name == "Cells" and c:GetAttribute("FW_Owned") then
			local g = c:FindFirstChildWhichIsA("UIGridLayout")
			if g then cells, grid = c, g break end
		end
	end
	if not grid then return end
	local pad = cells:FindFirstChildWhichIsA("UIPadding")
	local info = gridInfo[grid]
	if not info then
		info = {}
		gridInfo[grid] = info
	end
	if not info.canvasWired then
		info.canvasWired = true
		grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			if info.set and fwRenders() then info.set() end
		end)
		cells.ChildAdded:Connect(function() if info.set and fwRenders() then info.set() end end)
		cells.ChildRemoved:Connect(function() if info.set and fwRenders() then info.set() end end)
	end
	info.set = function()
		local cellH = grid.CellSize.Y.Offset
		local gapY = grid.CellPadding.Y.Offset
		local pt = pad and pad.PaddingTop.Offset or 0
		local pb = pad and pad.PaddingBottom.Offset or 0
		local step = cellH + gapY
		local rows = 0
		if step > 0 then
			rows = math.max(0, math.floor((grid.AbsoluteContentSize.Y + gapY) / step + 0.5))
		end
		if rows == 0 then
			local n = 0
			for _, c in ipairs(cells:GetChildren()) do
				if c:IsA("GuiObject") and c.Visible then n = n + 1 end
			end
			rows = math.ceil(n / math.max(1, grid.FillDirectionMaxCells))
		end
		local h = rows > 0 and (pt + rows * cellH + (rows - 1) * gapY + pb) or 0
		if h <= sf.AbsoluteWindowSize.Y + 1 then h = 0 end
		sf.CanvasSize = UDim2.fromOffset(0, h)
	end
	info.set()
end

local function measure(d) -- per face + text, after the face is downloaded
	local key = textKey(d)
	local cached = byKey[key]
	if cached ~= nil then return cached or nil end
	local face = faceOf(d)
	if not facesReady[face] then
		facesReady[face] = true
		pcall(function() ContentProvider:PreloadAsync({ d }) end)
	end
	local ok, b = pcall(function()
		local prm = Instance.new("GetTextBoundsParams")
		prm.Text = (d.ContentText:gsub("^%s+", ""):gsub("%s+$", ""))
		prm.Font = d.FontFace
		prm.Size = 100
		prm.Width = 1e6
		return TextService:GetTextBoundsAsync(prm)
	end)
	if ok and b and b.X > 0 then
		byKey[key] = b.X
		return b.X
	end
	if ok then
		byKey[key] = false
	end
	return nil
end
local function stampVote() -- twins agree: the stamp most labels of one face + text carry
	local votes, best = {}, {}
	for _, d in ipairs(root:GetDescendants()) do
		local st = d:GetAttribute("FW_M100")
		if type(st) == "number" and st > 0 and d:GetAttribute("FigmaTextW") then
			local key = textKey(d)
			local r = math.floor(st * 10 + 0.5) / 10
			votes[key] = votes[key] or {}
			votes[key][r] = (votes[key][r] or 0) + 1
		end
	end
	for key, tally in pairs(votes) do
		local top, n = nil, 0
		for v, c in pairs(tally) do
			if c > n or (c == n and top and v > top) then top, n = v, c end
		end
		best[key] = top
	end
	return best
end
local padWired = setmetatable({}, { __mode = "k" })
local function textPad(d, s) -- the spill grows the box about its AnchorPoint: inset the text back to the design box
	local pad = d:FindFirstChild("FW_TextPad")
	if s <= 1.0001 then
		if pad then pad:Destroy() end
		return
	end
	if not pad then
		if d:FindFirstChildWhichIsA("UIPadding") then return end -- the developer's padding owns the text area
		pad = Instance.new("UIPadding")
		pad.Name = "FW_TextPad"
		pad:SetAttribute("FW_Owned", true)
		pad.Parent = d
	end
	local a, g = d.AnchorPoint, 1 - 1 / s
	pad.PaddingLeft = UDim.new(a.X * g, 0)
	pad.PaddingRight = UDim.new((1 - a.X) * g, 0)
	pad.PaddingTop = UDim.new(a.Y * g, 0)
	pad.PaddingBottom = UDim.new((1 - a.Y) * g, 0)
	if not padWired[d] then
		padWired[d] = true
		d:GetPropertyChangedSignal("AnchorPoint"):Connect(function() -- a layout slot re-anchors it later
			local h = d:FindFirstChild("FW_Scale")
			local c = h and h:FindFirstChild("k_text")
			textPad(d, c and c.Value or 1)
		end)
	end
end
local function spillOver(x) -- a stroke or a gleam copy is drawn inside its label's spill
	local sp, n = 1, x.Parent
	while n and n ~= root do
		local h = n:FindFirstChild("FW_Scale")
		local c = h and h:FindFirstChild("k_text")
		if c and c.Value > 0 then sp = sp * c.Value end
		n = n.Parent
	end
	return sp
end
local function setTextPx(d, t, exact)
	if d:FindFirstAncestorWhichIsA("BillboardGui") then return end -- billboards size their own text
	local mine = d:GetAttribute("FW_TextMine")
	if type(mine) == "number" and (math.abs(d.TextSize - mine) > 0.5
		or d.TextScaled ~= (d:GetAttribute("FW_TextScaledMine") == true)) then
		d:SetAttribute("FW_TextOwn", true)
	end
	if d:GetAttribute("FW_TextOwn") then return end
	local sc = fwChannel(d, "k_text")
	local con = d:FindFirstChild("FWTextBig")
	if con then con:Destroy() end -- TextScaled + Min==Max stops at 100 too: the spill is the only way past it
	d.TextScaled = false
	if t > 100 then
		sc.Value = t / 100
		d.TextSize = 100
	else
		sc.Value = 1
		local px = exact and math.floor(t) or math.floor(t + 0.5)
		d.TextSize = math.max(1, px)
	end
	textPad(d, sc.Value)
	d:SetAttribute("FW_TextMine", d.TextSize)
	d:SetAttribute("FW_TextScaledMine", d.TextScaled)
end
local gen = 0
local coldTries = 0
local printedPass = false
local smHooked, smPend = nil, false
local apply
local function smRerun()
	if smPend then return end
	smPend = true
	task.delay(0.2, function()
		smPend = false
		apply()
	end)
end
function apply()
	gen = gen + 1
	local myGen = gen
	local sm = root:FindFirstChild("FW_Scale") or root:FindFirstChild("FramewispSmooth") or root:FindFirstChild("FWActScale")
	local smScale = (sm and sm:IsA("UIScale") and sm.Scale > 0) and sm.Scale or 1
	if sm and sm ~= smHooked and sm:IsA("UIScale") then
		smHooked = sm
		sm:GetPropertyChangedSignal("Scale"):Connect(smRerun) -- solved mid-tween = a size compensating a scale that finished at 1
	end
	local k = root.AbsoluteSize.Y / designH / smScale
	if k <= 0 then return end
	if not fwRenders() then return end
	if root.AbsoluteSize.X < 2 or root.AbsoluteSize.Y < 2 then return end
	local kx = (type(designW) == "number" and designW > 0) and root.AbsoluteSize.X / designW / smScale or k
	local transient = false
	local nExact, nFallback = 0, 0
	local measured = false
	local agreed = stampVote()
	for _, d in ipairs(root:GetDescendants()) do
		if myGen ~= gen then return end
		local fs = d:GetAttribute("FigmaFontSize")
		if fs and d.Name ~= "FW_GleamShine" then -- a gleam copy inherits its label's spill: solving it again doubled it
			local m = nil
			local tw = d:GetAttribute("FigmaTextW")
			if type(tw) == "number" and tw > 0 then
				local t0 = d:GetAttribute("FW_Text0")
				if t0 == nil then
					t0 = d.ContentText
					d:SetAttribute("FW_Text0", t0)
				end
				if d.ContentText == t0 then
					m = agreed[textKey(d)] or d:GetAttribute("FW_M100")
					if m == nil then m = measure(d); measured = true end -- stamped at import; twins vote; else measured here
					if m == nil and byKey[textKey(d)] == nil then transient = true end
				end
				if myGen ~= gen then return end
			end
			if m then
				setTextPx(d, 100 * (tw * kx) / m, true)
				nExact = nExact + 1
			else
				local f = d.FontFace
				setTextPx(d, fs * k * ((f and EM[tostring(f.Family)]) or factor))
				nFallback = nFallback + 1
			end
		end
		local swMine = d:GetAttribute("FW_StrokeMine")
		if type(swMine) == "number" and math.abs(d.Thickness - swMine) > 0.01 then
			d:SetAttribute("FW_StrokeOwn", true)
		end
		local okMode, isFrac = pcall(function() return d.StrokeSizingMode == Enum.StrokeSizingMode.ScaledSize end)
		if d:GetAttribute("FW_StrokeScaled") or (okMode and isFrac) then -- a fraction, not pixels
			d:SetAttribute("FW_StrokeScaled", true)
			local host = d.Parent
			if d.Thickness > 0.5 and (d:GetAttribute("FigmaStrokeW") or d:GetAttribute("FigmaTextStrokeW"))
				and host and host:IsA("GuiObject") and math.min(host.AbsoluteSize.X, host.AbsoluteSize.Y) > 1 then
				d.Thickness = d.Thickness / math.min(host.AbsoluteSize.X, host.AbsoluteSize.Y)
			end
		elseif not d:GetAttribute("FW_StrokeOwn") then
			local sw = d:GetAttribute("FigmaStrokeW")
			if sw then d.Thickness = math.max(0.35, sw * k) end
			local tsw = d:GetAttribute("FigmaTextStrokeW")
			if tsw then
				d.Thickness = math.max(0.35, (tsw * k + (d:GetAttribute("FW_StrokeExtra") or 0)) / spillOver(d)) -- geometry, not font compensation; a gleam halo keeps its extra
			end
			if sw or tsw then d:SetAttribute("FW_StrokeMine", d.Thickness) end
		end
		gridGeometry(d, k, kx, smScale)
		gridScroll(d)
	end
	gridScroll(root) -- the root can BE the scrolling grid
	if not printedPass and (nExact + nFallback) > 0 then
		printedPass = true
		print(("[Framewisp] TextScaler: %d width-exact, %d fallback"):format(nExact, nFallback))
		local rootH = root.AbsoluteSize.Y
		local worst, shown = {}, 0
		if rootH > 1 then
			for _, d in ipairs(root:GetDescendants()) do
				local tag = d:GetAttribute("FW_EDbg")
				if type(tag) == "string" and d:IsA("TextLabel") and d.AbsoluteSize.Y > 0 then
					local eL, eC = tag:match("([%d.]+)|([%d.]+)")
					eL, eC = tonumber(eL), tonumber(eC)
					if eL and eC then
						local pL = d.TextSize / rootH
						local pC = (d.AbsolutePosition.Y - root.AbsolutePosition.Y + d.AbsoluteSize.Y / 2) / rootH
						local dl, dc = pL - eL, pC - eC
						if math.abs(dl) > 0.002 or math.abs(dc) > 0.002 then
							worst[#worst + 1] = { n = d.Name, dl = dl * rootH, dc = dc * rootH }
						end
					end
				end
			end
		end
		table.sort(worst, function(a, b) return math.abs(a.dc) + math.abs(a.dl) > math.abs(b.dc) + math.abs(b.dl) end)
		for i = 1, math.min(3, #worst) do
			local x = worst[i]
			print(("[Framewisp] play vs edit %q: size %+.1f px, centre %+.1f px"):format(x.n, x.dl, x.dc))
		end
		if #worst == 0 then
			print("[Framewisp] play matches the editor within 0.2% — any remaining shift is pure rendering")
		end
	end
	if transient and coldTries < 6 then
		coldTries = coldTries + 1
		task.delay(0.5, function()
			if myGen == gen then apply() end
		end)
	elseif measured and not reverified then
		reverified = true
		task.delay(2, function() table.clear(byKey); apply() end) -- once more with every face surely downloaded
	end
end
local pending = false
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	if pending then return end
	pending = true
	task.spawn(function()
		task.wait()
		pending = false
		apply()
	end)
end)
apply()
]]></string>
          <int64 name="SourceAssetId">-1</int64>
          <BinaryString name="Tags"></BinaryString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="800">
        <Properties>
          <string name="Name">FramewispButtonFX</string>
          <BinaryString name="AttributesSerialize">AwAAAAgAAABGV19Pd25lZAMBBgAAAEZXX1NyYwYAAADO6WejQQMAAABGV3YGAAAAAAAAQUA=</BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="Disabled">false</bool>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <token name="RunContext">0</token>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{C383A8AC-5B48-4C86-8E92-F5565C96C1B5}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- Framewisp: hover/press feedback for buttons (darkens their images).
-- Tag a layer "_nodim" in Figma to keep it at full brightness.
-- Safe to delete: buttons stay, only the hover effect stops.
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end
local function findRoot()
	local fallback = nil
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("BillboardGui") then -- _billboard: the design lives one level deeper
			local inner = child:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("ObjectValue") and child.Name == "FW_ExtraRoot" and child.Value then
			local inner = child.Value:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("GuiObject") then
			fallback = fallback or child
			if child:GetAttribute("FW_Owned") == true then return child end
		end
	end
	return fallback
end
local root = findRoot()
if not root then return end
local HOVER, PRESS = 0.8, 0.62
local TIME = 0.08
local UP_DIST, UP_TIME = 6, 0.12
local TURN_ANGLE, TURN_TIME = -5, 0.14
local LEAN_ANGLE, LEAN_TIME = -8, 0.14
-- ========================== tune the feel here ==========================
-- MAGNET_PULL — how far a _magnet button leans toward the cursor.
--   0.15 = shy   ·   0.35 = default, juicy   ·   0.6 = clingy
-- MAGNET_RADIUS — attraction zone around the button, in screen px.
--   30 = touchy   ·   60 = default   ·   120 = feels it from afar
-- ========================================================================
local MAGNET_PULL = 0.35
local MAGNET_RADIUS = 60
local GuiService = game:GetService("GuiService")
local function magnetPx() -- design px -> screen px, defined here because the loop runs first
	local r = gui:FindFirstChildWhichIsA("GuiObject")
	if not r then -- a billboard design lives one level deeper, or hangs off FW_ExtraRoot
		for _, v in ipairs(gui:GetChildren()) do
			if v:IsA("BillboardGui") then -- clickable _billboard: kept inside this ScreenGui
				r = v:FindFirstChildWhichIsA("GuiObject")
				break
			end
			if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
				r = v.Value:FindFirstChildWhichIsA("GuiObject")
				break
			end
		end
	end
	local dh = gui:GetAttribute("BB_DesignH")
	if r and type(dh) == "number" and dh > 0 and r.AbsoluteSize.Y > 1 then return r.AbsoluteSize.Y / dh end
	return 1
end
local magnets = {}
local magnetLoop = nil
local function startMagnetLoop()
	if magnetLoop then return end
	magnetLoop = RunService.RenderStepped:Connect(function(dt)
		dt = math.min(dt, 1 / 20)
		local mouse = UserInputService:GetMouseLocation()
		local inset = GuiService:GetGuiInset()
		for _, m in ipairs(magnets) do
			local b = m.btn
			if b.Parent then
				if not m.base then m.base = b.Position end
				local p = b.AbsolutePosition
				local sz = b.AbsoluteSize
				local mx, my = mouse.X - inset.X, mouse.Y - inset.Y
				local radius = m.radius * magnetPx() -- a DESIGN distance: 15 px must mean 15 px of the mockup
				local col = b:FindFirstAncestorWhichIsA("SurfaceGui")
				if col and col:GetAttribute("FW_RectW") then
					local rx, ry = col:GetAttribute("FW_RectX"), col:GetAttribute("FW_RectY")
					local rw, rh = col:GetAttribute("FW_RectW"), col:GetAttribute("FW_RectH")
					if rw and rw > 0 and rh and rh > 0 then
						local cs = col.CanvasSize
						local kx = cs.X / rw
						mx = (mouse.X - rx) * kx
						my = (mouse.Y - ry) * (cs.Y / rh)
						radius = radius * kx
					end
				end
				local par = b.Parent -- rest centre from the LAYOUT: stable, and never our own output
				local ppos = par and par:IsA("GuiObject") and par.AbsolutePosition or Vector2.new(0, 0)
				local psz = par and par:IsA("GuiObject") and par.AbsoluteSize or sz
				local cx, cy
				if par and par:IsA("GuiObject") and psz.X > 1 then
					local ap = b.AnchorPoint
					cx = ppos.X + m.base.X.Scale * psz.X + m.base.X.Offset + (0.5 - ap.X) * sz.X
					cy = ppos.Y + m.base.Y.Scale * psz.Y + m.base.Y.Offset + (0.5 - ap.Y) * sz.Y
				else
					cx = p.X + sz.X / 2 - m.ox
					cy = p.Y + sz.Y / 2 - m.oy
				end
				m.cx0, m.cy0 = cx, cy
				local dx, dy = mx - cx, my - cy
				local nearX = math.abs(dx) - sz.X / 2
				local nearY = math.abs(dy) - sz.Y / 2
				local tx, ty = 0, 0
				if math.max(nearX, nearY) < radius then
					tx = dx * m.pull
					ty = dy * m.pull
					local len = math.sqrt(tx * tx + ty * ty)
					if len > radius then
						tx = tx / len * radius
						ty = ty / len * radius
					end
				end
				local K, C = 260, 14
				m.vx = m.vx + (-K * (m.ox - tx) - C * m.vx) * dt
				m.vy = m.vy + (-K * (m.oy - ty) - C * m.vy) * dt
				m.ox = m.ox + m.vx * dt
				m.oy = m.oy + m.vy * dt
				if math.abs(m.ox - tx) < 0.2 and math.abs(m.oy - ty) < 0.2 -- settle on ANY target: writing Position every frame re-lays out the subtree
					and math.abs(m.vx) < 2 and math.abs(m.vy) < 2 then
					m.ox, m.oy, m.vx, m.vy = tx, ty, 0, 0
				end
				local px, py = math.floor(m.ox + 0.5), math.floor(m.oy + 0.5)
				if px ~= m.lastX or py ~= m.lastY then
					m.lastX, m.lastY = px, py
					b.Position = m.base + UDim2.fromOffset(px, py)
				end
			end
		end
	end)
end

local wired = setmetatable({}, { __mode = "k" })

local function dimTargets(btn)
	local t = {}
	local function insideState(inst)
		local n = inst
		while n and n ~= btn do
			if n:GetAttribute("FigmaState") ~= nil then return true end
			n = n.Parent
		end
		return false
	end
	local function add(inst, prop)
		local pick = inst:GetAttribute("FigmaColorPick") -- a layer with its own hover colour is not dimmed: the pick IS its hover look
		if type(pick) == "number" and pick >= 0 and inst:GetAttribute("FigmaColor") ~= nil then return end
		local e = { inst = inst, prop = prop, base = inst[prop], own = 0 }
		inst:GetPropertyChangedSignal(prop):Connect(function()
			if e.own == 0 then e.base = inst[prop] end
		end)
		t[#t + 1] = e
	end
	if btn:IsA("ImageButton") and btn.Image ~= "" and btn.ImageTransparency < 1 then
		add(btn, "ImageColor3")
	end
	if btn.BackgroundTransparency < 1 then
		add(btn, "BackgroundColor3")
	end
	for _, d in ipairs(btn:GetDescendants()) do
		if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d:GetAttribute("FigmaNoDim") == nil and not insideState(d) then
			add(d, "ImageColor3")
		end
	end
	if #t == 0 then
		if btn:IsA("TextButton") and btn.TextTransparency < 1 then add(btn, "TextColor3") end
		for _, d in ipairs(btn:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.TextTransparency < 1
				and d:GetAttribute("FigmaNoDim") == nil and not insideState(d) then
				add(d, "TextColor3")
			end
		end
	end
	return t
end

local function centreAnchor(btn)
	if btn.AnchorPoint == Vector2.new(0.5, 0.5) then return end
	if btn.Parent then
		for _, ch in ipairs(btn.Parent:GetChildren()) do
			if ch:IsA("UIListLayout") or ch:IsA("UIGridLayout") or ch:IsA("UITableLayout") or ch:IsA("UIPageLayout") then
				return
			end
		end
	end
	local ap, pos, sz = btn.AnchorPoint, btn.Position, btn.Size
	btn.Position = UDim2.new(
		pos.X.Scale + (0.5 - ap.X) * sz.X.Scale,
		pos.X.Offset + (0.5 - ap.X) * sz.X.Offset,
		pos.Y.Scale + (0.5 - ap.Y) * sz.Y.Scale,
		pos.Y.Offset + (0.5 - ap.Y) * sz.Y.Offset
	)
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
end

local function buttonSound(btn, names, fallbackId)
	local id
	for _, a in ipairs(names) do
		id = btn:GetAttribute(a)
		if id ~= nil then break end
	end
	if id == nil then id = fallbackId end
	if type(id) == "number" then id = string.format("%.0f", id) end
	id = tostring(id)
	if id == "" or id == "0" then return nil end
	if not id:match("^rbxassetid://") then id = "rbxassetid://" .. id end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Parent = btn
	return s
end
local function voice(template)
	if not template then return end
	local s = template:Clone()
	s.Parent = template.Parent
	s.Ended:Once(function() s:Destroy() end)
	s:Play()
	Debris:AddItem(s, 15)
end

local function wire(btn)
	if wired[btn] then return end
	wired[btn] = true

	local sndHover = buttonSound(btn, { "HoverSound", "FigmaHoverSound", "SmoothHoverSound" }, "139800881181209") -- "" or 0 = silent
	local sndClick = buttonSound(btn, { "ClickSound", "FigmaClickSound", "SmoothClickSound" }, "102702078778790")
	if sndHover then btn.MouseEnter:Connect(function() voice(sndHover) end) end
	if sndClick then btn.MouseButton1Down:Connect(function() voice(sndClick) end) end

	if btn:GetAttribute("FigmaMagnet") and UserInputService.MouseEnabled then
		magnets[#magnets + 1] = {
			btn = btn,
			pull = btn:GetAttribute("MagnetPull") or btn:GetAttribute("FigmaMagnetPull") or MAGNET_PULL,
			radius = btn:GetAttribute("MagnetRadius") or btn:GetAttribute("FigmaMagnetRadius") or MAGNET_RADIUS,
			ox = 0, oy = 0, vx = 0, vy = 0,
		}
		startMagnetLoop()
	end

	if btn:GetAttribute("FigmaSmooth") then
		btn.AutoButtonColor = false
		centreAnchor(btn)
		local scale = fwChannel(btn, "k_btn") -- a channel, so an idle pulse survives the hover
		local base = scale.Value
		local hoverK = btn:GetAttribute("SmoothHover") or btn:GetAttribute("FigmaSmoothHover") or 1.08
		local pressK = btn:GetAttribute("SmoothPress") or btn:GetAttribute("FigmaSmoothPress") or 0.9
		local hovering, held, tween = false, false, nil
		local function glide(target, t)
			if tween then tween:Cancel() end
			tween = TweenService:Create(scale, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = target })
			tween:Play()
		end
		btn.MouseEnter:Connect(function()
			hovering = true
			if not held then glide(base * hoverK, 0.15) end
		end)
		btn.MouseLeave:Connect(function()
			hovering = false
			if not held then glide(base, 0.15) end
		end)
		btn.MouseButton1Down:Connect(function()
			held = true
			glide(base * pressK, 0.08)
		end)
		local function release()
			if not held then return end
			held = false
			glide(hovering and base * hoverK or base, 0.1)
		end
		btn.MouseButton1Up:Connect(release)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				release()
			end
		end)
	end

	local states = {}
	for _, c in ipairs(btn:GetDescendants()) do
		local s = c:GetAttribute("FigmaState")
			if (s == "hover" or s == "clicked" or s == "disabled" or s == "default") and not states[s] then
			local owned, n = true, c.Parent
			while n and n ~= btn do
				if n:IsA("GuiButton") then owned = false break end
				n = n.Parent
			end
			if owned then states[s] = c end
		end
	end
	if next(states) then
		local function show(name)
			for s, c in pairs(states) do
				if s == "default" then
					c.Visible = (name == nil)
				else
					c.Visible = (s == name)
				end
			end
		end
		local function disabled()
			local ok, value = pcall(function() return btn.Interactable == false end)
			return (ok and value) or btn.Active == false
		end
		local function rest() show(disabled() and states.disabled and "disabled" or nil) end
		btn.MouseEnter:Connect(function() if not disabled() and states.hover then show("hover") end end)
		btn.MouseLeave:Connect(rest)
		btn.MouseButton1Down:Connect(function() if not disabled() and states.clicked then show("clicked") end end)
		btn.MouseButton1Up:Connect(function() if disabled() then rest() else show(states.hover and "hover" or nil) end end)
		btn:GetPropertyChangedSignal("Active"):Connect(rest)
		pcall(function() btn:GetPropertyChangedSignal("Interactable"):Connect(rest) end)
		rest()
		if states.hover or states.clicked then return end
	end

	if btn:GetAttribute("FigmaSmooth") then return end

	local targets = dimTargets(btn)
	if #targets == 0 then
		btn.AutoButtonColor = true
		return
	end
	btn.AutoButtonColor = false
	centreAnchor(btn)
	local hoverDim = btn:GetAttribute("HoverDim") or btn:GetAttribute("FigmaHoverDim") or HOVER
	local pressDim = btn:GetAttribute("PressDim") or btn:GetAttribute("FigmaPressDim") or PRESS
	local pressIn = btn:GetAttribute("PressScale") or btn:GetAttribute("FigmaSmoothPress") or 0.985
	local scale = fwChannel(btn, "k_press")
	local function to(k, s)
		for _, tg in ipairs(targets) do
			local c = tg.base
			tg.own = tg.own + 1
			local tw = TweenService:Create(tg.inst, TweenInfo.new(TIME), { [tg.prop] = Color3.new(c.R * k, c.G * k, c.B * k) })
			tw.Completed:Once(function()
				if tg.own > 0 then tg.own = tg.own - 1 end
			end)
			tw:Play()
		end
		TweenService:Create(scale, TweenInfo.new(TIME), { Value = s }):Play()
	end
	btn.MouseEnter:Connect(function() to(hoverDim, 1) end)
	btn.MouseLeave:Connect(function() to(1, 1) end)
	btn.MouseButton1Down:Connect(function() to(pressDim, pressIn) end)
	btn.MouseButton1Up:Connect(function() to(hoverDim, 1) end)
end

local function onScrollMoved(btn, fn)
	local sf = btn:FindFirstAncestorWhichIsA("ScrollingFrame")
	if not sf then return end
	sf:GetPropertyChangedSignal("CanvasPosition"):Connect(fn)
end
local function laidOutBy(btn)
	local p = btn.Parent
	if not p then return false end
	return p:FindFirstChildWhichIsA("UIGridLayout") ~= nil
		or p:FindFirstChildWhichIsA("UIListLayout") ~= nil
		or p:FindFirstChildWhichIsA("UITableLayout") ~= nil
		or p:FindFirstChildWhichIsA("UIPageLayout") ~= nil
end
local function slotFor(btn)
	if not laidOutBy(btn) then return end
	local slot = Instance.new("Frame")
	slot.Name = btn.Name .. "_LiftSlot"
	slot:SetAttribute("FW_LiftSlot", true)
	slot.BackgroundTransparency = 1
	slot.BorderSizePixel = 0
	slot.Size = btn.Size
	slot.Position = btn.Position
	slot.AnchorPoint = btn.AnchorPoint
	slot.LayoutOrder = btn.LayoutOrder
	slot.ZIndex = btn.ZIndex
	slot.Visible = btn.Visible
	slot.Parent = btn.Parent
	btn.AnchorPoint = Vector2.new(0, 0)
	btn.Position = UDim2.fromScale(0, 0)
	btn.Size = UDim2.fromScale(1, 1)
	btn.Parent = slot
	centreAnchor(btn)
end
local function cardAround(el)
	local n = el.Parent
	while n and n ~= gui do
		if n:IsA("GuiButton") then return n end
		n = n.Parent
	end
	return nil
end

local function wireSquish(btn)
	if not btn:GetAttribute("FigmaSquish") then return end
	if btn:GetAttribute("FW_Squish") then return end
	btn:SetAttribute("FW_Squish", true)
	slotFor(btn)
	centreAnchor(btn)
	local base = nil
	local tw = nil
	local function squash(on)
		if base == nil then base = btn.Size end
		local amp = (btn:GetAttribute("SquishAmp") or btn:GetAttribute("FigmaSquishAmp") or 10) / 100
		local t = btn:GetAttribute("SquishTime") or btn:GetAttribute("FigmaSquishTime") or 0.18
		if tw then tw:Cancel() end
		local target = on
			and UDim2.new(base.X.Scale * (1 + amp), base.X.Offset * (1 + amp), base.Y.Scale * (1 - amp), base.Y.Offset * (1 - amp))
			or base
		tw = TweenService:Create(btn, TweenInfo.new(on and t / 3 or t, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = target })
		tw:Play()
	end
	btn.MouseButton1Down:Connect(function() squash(true) end)
	btn.MouseButton1Up:Connect(function() squash(false) end)
	btn.MouseLeave:Connect(function() if base and btn.Size ~= base then squash(false) end end)
end

local function wireRipple(btn)
	if not btn:GetAttribute("FigmaRipple") then return end
	if btn:GetAttribute("FW_Ripple") then return end
	btn:SetAttribute("FW_Ripple", true)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local host = Instance.new("Frame")
		host.BackgroundTransparency = 1
		host.Size = UDim2.fromScale(1, 1)
		host.ClipsDescendants = true
		host:SetAttribute("FW_Owned", true)
		local corner = btn:FindFirstChildWhichIsA("UICorner")
		if corner then corner:Clone().Parent = host end
		local top = btn.ZIndex -- above the button's own content, or the wash hides under it
		for _, d in ipairs(btn:GetChildren()) do
			if d:IsA("GuiObject") and d.ZIndex > top then top = d.ZIndex end
		end
		host.ZIndex = top + 1
		host.Parent = btn
		local c = btn:GetAttribute("RippleColor") or btn:GetAttribute("FigmaRippleColor") or 16777215
		local op = btn:GetAttribute("RippleOp") or btn:GetAttribute("FigmaRippleOp") or 0.4
		local t = btn:GetAttribute("RippleTime") or btn:GetAttribute("FigmaRippleTime") or 0.45
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.BorderSizePixel = 0
		dot.BackgroundColor3 = Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
		dot.BackgroundTransparency = 1 - op
		dot.Position = UDim2.fromOffset(input.Position.X - btn.AbsolutePosition.X, input.Position.Y - btn.AbsolutePosition.Y)
		dot.Size = UDim2.fromOffset(0, 0)
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(1, 0)
		round.Parent = dot
		dot.Parent = host
		local sz = btn.AbsoluteSize -- reach the farthest corner from the touch, no further
		local px = input.Position.X - btn.AbsolutePosition.X
		local py = input.Position.Y - btn.AbsolutePosition.Y
		local far = math.sqrt(math.max(px, sz.X - px) ^ 2 + math.max(py, sz.Y - py) ^ 2)
		local m = far * 2 -- diameter
		dot.ZIndex = host.ZIndex
		TweenService:Create(dot, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.fromOffset(m, m) }):Play()
		TweenService:Create(dot, TweenInfo.new(t * 0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.In), -- fades as it travels
			{ BackgroundTransparency = 1 }):Play()
		task.delay(t + 0.1, function() host:Destroy() end)
	end)
end

local function wireLean(el)
	if not el:GetAttribute("FigmaLean") then return end
	if el:GetAttribute("FW_Lean") then return end
	el:SetAttribute("FW_Lean", true)
	local card = cardAround(el)
	if not card then return end
	local knob = Instance.new("NumberValue") -- rotation goes through the compositor
	knob.Name = "FW_LeanKnob"
	knob:SetAttribute("FW_Owned", true)
	knob.Parent = el
	knob.Changed:Connect(function() fwRotSet(el, "r_hover", knob.Value) end)
	local function lean(on)
		local a = el:GetAttribute("LeanAngle")
		if type(a) ~= "number" then a = el:GetAttribute("FigmaLeanAngle") end
		if type(a) ~= "number" then a = LEAN_ANGLE end
		local t = el:GetAttribute("LeanTime")
		if type(t) ~= "number" then t = el:GetAttribute("FigmaLeanTime") end
		if type(t) ~= "number" then t = LEAN_TIME end
		TweenService:Create(knob, TweenInfo.new(t, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Value = on and a or 0 }):Play()
	end
	local hovered = false
	card.MouseEnter:Connect(function() hovered = true; lean(true) end)
	card.MouseLeave:Connect(function() hovered = false; lean(false) end)
	onScrollMoved(el, function()
		if hovered then hovered = false; lean(false) end
	end)
end

local COLOR_PROP = { -- what paints each class (same rule as the Color runtime)
	Frame = "BackgroundColor3", ScrollingFrame = "BackgroundColor3", CanvasGroup = "BackgroundColor3",
	ImageLabel = "ImageColor3", ImageButton = "ImageColor3",
	TextLabel = "TextColor3", TextButton = "TextColor3", TextBox = "TextColor3",
}
local function hexColor(n)
	if type(n) ~= "number" or n < 0 then return nil end
	return Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
end
local function hoverCoat(el, c1, c2, angle) -- a copy of the layer that carries the gradient and fades over the original
	local coat = el:FindFirstChild("FW_HoverCoat")
	if coat then return coat end
	local fadeProp = "BackgroundTransparency"
	if (el:IsA("TextLabel") or el:IsA("TextButton") or el:IsA("TextBox")) and el.Text ~= "" then
		coat = Instance.new("TextLabel")
		coat.Text = el.Text
		coat.RichText = el.RichText == true
		coat.FontFace = el.FontFace
		coat.TextScaled = el.TextScaled == true
		coat.TextSize = el.TextSize
		coat.TextWrapped = el.TextWrapped == true
		coat.LineHeight = el.LineHeight
		coat.TextXAlignment = el.TextXAlignment
		coat.TextYAlignment = el.TextYAlignment
		coat.TextColor3 = Color3.new(1, 1, 1)
		coat.TextStrokeTransparency = 1
		coat.BackgroundTransparency = 1
		fadeProp = "TextTransparency"
	elseif el:IsA("ImageLabel") or el:IsA("ImageButton") then
		coat = Instance.new("ImageLabel")
		coat.Image = el.Image
		coat.ImageColor3 = Color3.new(1, 1, 1)
		coat.ScaleType = el.ScaleType
		coat.SliceCenter = el.SliceCenter
		coat.SliceScale = el.SliceScale
		coat.TileSize = el.TileSize
		coat.ImageRectOffset = el.ImageRectOffset
		coat.ImageRectSize = el.ImageRectSize
		coat.BackgroundTransparency = 1
		fadeProp = "ImageTransparency"
	else
		coat = Instance.new("Frame")
		coat.BackgroundColor3 = Color3.new(1, 1, 1)
		local corner = el:FindFirstChildOfClass("UICorner")
		if corner then corner:Clone().Parent = coat end
	end
	coat.Name = "FW_HoverCoat"
	coat[fadeProp] = 1
	coat.Size = UDim2.fromScale(1, 1)
	coat.ZIndex = el.ZIndex + 1
	coat:SetAttribute("FW_Owned", true)
	coat:SetAttribute("FW_FadeProp", fadeProp)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = angle
	g:SetAttribute("FW_Owned", true)
	g.Parent = coat
	coat.Parent = el
	if fadeProp == "TextTransparency" then -- the text scaler resizes the label later: the copy follows it
		for _, prop in ipairs({ "Text", "TextSize", "TextScaled" }) do
			el:GetPropertyChangedSignal(prop):Connect(function() coat[prop] = el[prop] end)
		end
	end
	return coat
end
local function wireHoverColor(el) -- _color inside a button: the picked colour is the HOVER colour, rest is as drawn
	if not el:GetAttribute("FigmaColor") then return end
	if el:GetAttribute("FW_HoverColor") then return end
	local card = el:IsA("GuiButton") and el or cardAround(el)
	if not card then return end
	local prop = COLOR_PROP[el.ClassName]
	if prop == "TextColor3" then
		local ok, txt = pcall(function() return el.Text end)
		if ok and txt == "" then prop = "BackgroundColor3" end -- a button shell holds no text: its fill IS its colour
	end
	if not prop then return end
	local function hoverColor()
		local c = el:GetAttribute("HoverColor")
		if typeof(c) == "Color3" then return c end
		return hexColor(el:GetAttribute("FigmaColorPick"))
	end
	local function secondColor()
		local c = el:GetAttribute("HoverColor2")
		if typeof(c) == "Color3" then return c end
		return hexColor(el:GetAttribute("FigmaColorPick2"))
	end
	if not hoverColor() then return end
	el:SetAttribute("FW_HoverColor", true)
	local rest = el[prop] -- the design's colour, read BEFORE any hover dim has touched the layer
	el:GetAttributeChangedSignal("Color"):Connect(function() -- code repainted the slot: that is the rest colour now
		local c = el:GetAttribute("Color")
		if typeof(c) == "Color3" then rest = c end
	end)
	local function secs(on)
		local t = el:GetAttribute(on and "ColorIn" or "ColorOut")
		if type(t) ~= "number" then t = el:GetAttribute(on and "FigmaColorIn" or "FigmaColorOut") end
		if type(t) ~= "number" then t = on and LEAN_TIME or 0.25 end -- leaving is slower than arriving, like a real glow cooling
		return math.max(0, t)
	end
	local function paint(on)
		local info = TweenInfo.new(secs(on), Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local c1, c2 = hoverColor(), secondColor()
		if c2 then -- a gradient: a copy of the layer carrying it fades over the original
			local angle = el:GetAttribute("HoverAngle")
			if type(angle) ~= "number" then angle = el:GetAttribute("FigmaColorAngle") or 0 end
			local coat = hoverCoat(el, c1, c2, angle)
			local g = coat:FindFirstChildOfClass("UIGradient")
			if g then g.Color = ColorSequence.new(c1, c2); g.Rotation = angle end
			TweenService:Create(coat, info, { [coat:GetAttribute("FW_FadeProp")] = on and 0 or 1 }):Play()
			return
		end
		local goal = on and c1 or rest
		TweenService:Create(el, info, { [prop] = goal }):Play()
	end
	local hovered = false
	card.MouseEnter:Connect(function() hovered = true; paint(true) end)
	card.MouseLeave:Connect(function() hovered = false; paint(false) end)
	onScrollMoved(el, function()
		if hovered then hovered = false; paint(false) end
	end)
end

local function wireTurn(btn)
	if not btn:GetAttribute("FigmaTurn") then return end
	if btn:GetAttribute("FW_Turn") then return end -- DescendantAdded re-fires on every reparent
	btn:SetAttribute("FW_Turn", true)
	slotFor(btn)
	local knob = Instance.new("NumberValue") -- rotation goes through the compositor
	knob.Name = "FW_TurnKnob"
	knob:SetAttribute("FW_Owned", true)
	knob.Parent = btn
	knob.Changed:Connect(function() fwRotSet(btn, "r_hover", knob.Value) end)
	local function turn(on)
		local a = btn:GetAttribute("TurnAngle")
		if type(a) ~= "number" then a = btn:GetAttribute("FigmaTurnAngle") end
		if type(a) ~= "number" then a = TURN_ANGLE end
		local t = btn:GetAttribute("TurnTime")
		if type(t) ~= "number" then t = btn:GetAttribute("FigmaTurnTime") end
		if type(t) ~= "number" then t = TURN_TIME end
		TweenService:Create(knob, TweenInfo.new(t, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Value = on and a or 0 }):Play()
	end
	local hovered = false
	btn.MouseEnter:Connect(function() hovered = true; turn(true) end)
	btn.MouseLeave:Connect(function() hovered = false; turn(false) end)
	onScrollMoved(btn, function()
		if hovered then hovered = false; turn(false) end
	end)
end

local function wireLift(btn)
	if not btn:GetAttribute("FigmaUp") then return end
	if btn:GetAttribute("FW_Lift") then return end
	btn:SetAttribute("FW_Lift", true)
	slotFor(btn)
	local base = nil
	local function px()
		local r = gui:FindFirstChildWhichIsA("GuiObject")
		if not r then
			for _, v in ipairs(gui:GetChildren()) do
				if v:IsA("BillboardGui") then -- clickable _billboard: kept inside this ScreenGui
					r = v:FindFirstChildWhichIsA("GuiObject")
					break
				end
				if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
					r = v.Value:FindFirstChildWhichIsA("GuiObject")
					break
				end
			end
		end
		local dh = gui:GetAttribute("BB_DesignH")
		if r and type(dh) == "number" and dh > 0 and r.AbsoluteSize.Y > 1 then return r.AbsoluteSize.Y / dh end
		return 1
	end
	local function lift(on)
		local d = btn:GetAttribute("UpDist")
		if type(d) ~= "number" then d = btn:GetAttribute("FigmaUpDist") end
		if type(d) ~= "number" then d = UP_DIST end
		local t = btn:GetAttribute("UpTime")
		if type(t) ~= "number" then t = btn:GetAttribute("FigmaUpTime") end
		if type(t) ~= "number" then t = UP_TIME end
		local info = TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		if not base then base = btn.Position end
		local goal = on and (base + UDim2.fromOffset(0, -d * px())) or base
		TweenService:Create(btn, info, { Position = goal }):Play()
	end
	local raised = false
	btn.MouseEnter:Connect(function() raised = true; lift(true) end)
	btn.MouseLeave:Connect(function() raised = false; lift(false) end)
	if btn:IsA("GuiButton") then
		btn.MouseButton1Up:Connect(function() raised = true; lift(true) end)
	end
	onScrollMoved(btn, function()
		if raised then raised = false; lift(false) end
	end)
end

local function scan(inst)
	if (inst:IsA("TextButton") or inst:IsA("ImageButton")) and inst:GetAttribute("FW_Owned") == true then
		wire(inst)
		wireLift(inst)
		wireTurn(inst)
		wireSquish(inst)
		wireRipple(inst)
	elseif inst:IsA("GuiObject") then
		wireLift(inst) -- hover effects need no button: _scroll/_canvas win the class
		wireTurn(inst)
	end
	if inst:IsA("GuiObject") then wireLean(inst); wireHoverColor(inst) end
end
scan(root)
for _, d in ipairs(root:GetDescendants()) do scan(d) end
root.DescendantAdded:Connect(scan)
]]></string>
          <int64 name="SourceAssetId">-1</int64>
          <BinaryString name="Tags"></BinaryString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="801">
        <Properties>
          <string name="Name">FramewispJuice</string>
          <BinaryString name="AttributesSerialize">AwAAAAgAAABGV19Pd25lZAMBBgAAAEZXX1NyYwYAAICjbDnBQQMAAABGV3YGAAAAAAAAPUA=</BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <bool name="Disabled">false</bool>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <token name="RunContext">0</token>
          <bool name="DefinesCapabilities">false</bool>
          <string name="ScriptGuid">{0375D10E-9252-49B8-B5F5-88A933C9E31A}</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- Framewisp: juice — idle motion (_pulse/_wiggle/_shake/_jelly/_glow/_rays/_pixels)
-- and entrances (_pop/_cascade/_reveal/_swing/_drop). Every number comes from the
-- plugin; a Studio attribute without the Figma prefix wins (DropHeight, DropTime,
-- DropBounce, DropSquash, DropFade, DropDelay, DropKids, DropStep, DropSound).
-- Safe to delete: everything just holds still.
local RunService = game:GetService("RunService")
do
	local okv, v = pcall(function() return script:GetAttribute("FWv") end)
	print("[Framewisp] Juice v" .. tostring(okv and v or "?") .. " in " .. script.Parent.Name)
end
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local gui = script.Parent
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end

local function attr(el, name, def)
	local v = el:GetAttribute(name)
	if v == nil then v = el:GetAttribute("Figma" .. name) end
	if type(v) ~= "number" then return def end
	return v
end
local function pxScale() -- design px -> rendered px, the same factor _float and _up use
	local root = gui:FindFirstChildWhichIsA("GuiObject")
	if not root then -- a billboard design lives one level deeper, or hangs off FW_ExtraRoot
		for _, v in ipairs(gui:GetChildren()) do
			if v:IsA("BillboardGui") then -- clickable _billboard: kept inside this ScreenGui
				root = v:FindFirstChildWhichIsA("GuiObject")
				break
			end
			if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
				root = v.Value:FindFirstChildWhichIsA("GuiObject")
				break
			end
		end
	end
	local designH = gui:GetAttribute("BB_DesignH")
	if root and type(designH) == "number" and designH > 0 and root.AbsoluteSize.Y > 1 then
		return root.AbsoluteSize.Y / designH
	end
	return 1
end
local function slotFor(el, force) -- also the host for juice scaling: Roblox honours one UIScale per object
	local p = el.Parent
	if not p then return end
	local laid = p:FindFirstChildWhichIsA("UIGridLayout") or p:FindFirstChildWhichIsA("UIListLayout")
		or p:FindFirstChildWhichIsA("UITableLayout") or p:FindFirstChildWhichIsA("UIPageLayout")
	if not laid and not force then return end
	if p:GetAttribute("FW_JuiceSlot") then return end
	local slot = Instance.new("Frame")
	slot.Name = el.Name .. "_JSlot"
	slot.BackgroundTransparency = 1
	slot.Size = el.Size
	slot.Position = el.Position -- the wrapper must stand exactly where the layer stood
	slot.AnchorPoint = el.AnchorPoint
	slot.ZIndex = el.ZIndex
	slot.LayoutOrder = el.LayoutOrder
	slot:SetAttribute("FW_Owned", true)
	slot:SetAttribute("FW_JuiceSlot", true)
	slot.Parent = p
	el.Size = UDim2.fromScale(1, 1)
	el.Position = UDim2.fromScale(0.5, 0.5)
	el.AnchorPoint = Vector2.new(0.5, 0.5)
	el.Parent = slot
	return slot
end

local function scaleOf(el)
	return fwChannel(el, "k_juice") -- a channel, never the UIScale itself
end

local function shown(el) -- visible TO THE PLAYER: every ancestor counts, not just this layer
	local n = el
	while n and not n:IsA("LayerCollector") do
		if n:IsA("GuiObject") and not n.Visible then return false end
		n = n.Parent
	end
	return n ~= nil
end
local function onShown(el, fn)
	local was = shown(el)
	if was then fn() end
	local n = el
	while n and not n:IsA("LayerCollector") do
		if n:IsA("GuiObject") then
			n:GetPropertyChangedSignal("Visible"):Connect(function()
				local now = shown(el)
				if now and not was then fn() end
				was = now
			end)
		end
		n = n.Parent
	end
end

local idle = {}
local function popIn(el)
	local sc = fwChannel(el, "k_pop") -- its own channel: the idle tick owns k_juice
	local from = attr(el, "PopFrom", 0.8)
	sc.Value = from
	TweenService:Create(sc, TweenInfo.new(attr(el, "PopTime", 0.3), Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 }):Play()
end
local function wirePop(el)
	if el:GetAttribute("FW_Pop") then return end
	el:SetAttribute("FW_Pop", true)
	onShown(el, function() popIn(el) end)
end
local function cascadeIn(el)
	local gap = attr(el, "CascadeGap", 70) / 1000
	local i = 0
	local function cardish(c) -- a card is something you CLICK, not decoration that animates
		return c:IsA("GuiButton") or c:GetAttribute("FigmaAction") ~= nil
	end
	local kids, actors = {}, {}
	local function sweep(host, depth)
		for _, c in ipairs(host:GetChildren()) do
			if c:IsA("GuiObject") and c:GetAttribute("FW_Owned") ~= false then
				if depth == 0 then kids[#kids + 1] = c end
				if cardish(c) then
					actors[#actors + 1] = c
				elseif depth < 3 then
					sweep(c, depth + 1) -- a plain container is not a card: look inside it
				end
			end
		end
	end
	sweep(el, 0)
	if #actors > 1 then kids = actors end -- the preview staggers the CARDS, not the plate
	if #kids == 0 then -- fully baked: nothing to stagger, so at least make it arrive
		popIn(el)
		return
	end
	if #kids == 1 and #kids[1]:GetChildren() > 1 then
		local n = kids[1].Name
		if n:sub(-7) == "Content" or n:sub(-4) == "Mask" or n:sub(-6) == "Masked" then
			return cascadeIn(kids[1])
		end
	end
	local laid = false -- design order, like the preview; a layout's own order still wins
	for _, c in ipairs(kids) do
		if c.LayoutOrder ~= 0 then laid = true break end
	end
	if laid then
		table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	end
	for _, c in ipairs(kids) do
		local sc = fwChannel(c, "k_pop")
		sc.Value = 0.001
		task.delay(i * gap, function()
			if c.Parent then
				TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 }):Play()
			end
		end)
		i += 1
	end
end
local function wireCascade(el)
	if el:GetAttribute("FW_Cascade") then return end
	el:SetAttribute("FW_Cascade", true)
	onShown(el, function() cascadeIn(el) end)
end
local function wireGlow(el)
	if el:GetAttribute("FW_Glow") then return end
	el:SetAttribute("FW_Glow", true)
	local host = el
	local sw = attr(el, "GlowSW", 1)
	local sh = attr(el, "GlowSH", 1)
	local rot = attr(el, "GlowRot", 0)
	if sw < 0.999 or sw > 1.001 or sh < 0.999 or sh > 1.001 or math.abs(rot) > 0.05 then
		local ring = Instance.new("Frame")
		ring.Name = "FW_GlowRing"
		ring.BackgroundTransparency = 1
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.Position = UDim2.fromScale(0.5, 0.5)
		ring.Size = UDim2.fromScale(sw, sh)
		ring.Rotation = rot
		ring:SetAttribute("FW_Owned", true)
		local rad = attr(el, "GlowRad", 0)
		if rad > 0 then
			local uc = Instance.new("UICorner")
			uc.CornerRadius = UDim.new(rad, 0)
			uc.Parent = ring
		end
		ring.Parent = el
		host = ring
	end
	local stroke = host:FindFirstChildWhichIsA("UIStroke")
	if stroke and stroke:GetAttribute("FW_Owned") ~= true then stroke = nil end -- the DESIGNED border is sacred
	if not stroke then
		stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- on text, Contextual outlines the GLYPHS
		stroke:SetAttribute("FW_Owned", true)
		local c = attr(el, "GlowColor", 16777215)
		stroke.Color = Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
		stroke.Thickness = 0
		stroke.Parent = host
	end
	idle[#idle + 1] = { kind = "glow", el = el, stroke = stroke, base = stroke.Thickness,
		frac = stroke:GetAttribute("FW_StrokeScaled") == true, t = math.random() * 7 }
end
local function wirePixels(el)
	if el:GetAttribute("FW_Pixels") then return end
	el:SetAttribute("FW_Pixels", true)
	local wrap = Instance.new("Frame")
	wrap.Name = "FW_PixelHost"
	wrap.BackgroundTransparency = 1
	wrap.Size = UDim2.fromScale(1, 1)
	wrap.ClipsDescendants = true
	wrap:SetAttribute("FW_Owned", true)
	local corner = el:FindFirstChildWhichIsA("UICorner")
	if corner then corner:Clone().Parent = wrap end
	local top = el.ZIndex
	for _, d in ipairs(el:GetChildren()) do
		if d:IsA("GuiObject") and d.ZIndex > top then top = d.ZIndex end
	end
	wrap.ZIndex = top + 1 -- the preview draws the mosaic OVER the layer's contents
	wrap.Parent = el
	local c = attr(el, "PixColor", 16777215)
	local col = Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
	local alpha = attr(el, "PixAlpha", 0.35)
	for _ = 1, 240 do -- a grid cut before the layout exists collapses to one cell
		if el.AbsoluteSize.X > 2 and el.AbsoluteSize.Y > 2 then break end
		task.wait()
		if not el.Parent then return end
	end
	local w, h = el.AbsoluteSize.X, el.AbsoluteSize.Y
	local cellPx = math.max(1, attr(el, "PixCell", 14)) * pxScale() -- a DESIGN size, like every other
	local k = math.max(1, math.ceil(math.sqrt((math.ceil(w / cellPx) * math.ceil(h / cellPx)) / 1600))) -- same cap as the preview
	local cw = cellPx * k
	local cells = {}
	local sx, sy = cw / math.max(1, w), cw / math.max(1, h) -- square in RENDERED px, and scales with the box
	local y = 0
	while y < h do
		local x = 0
		while x < w do
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = col
			f.BackgroundTransparency = 1
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Size = UDim2.fromScale(sx, sy)
			f.Position = UDim2.fromScale((x + cw / 2) / w, (y + cw / 2) / h)
			f.ZIndex = wrap.ZIndex
			f.Parent = wrap
			cells[#cells + 1] = f
			x = x + cw
		end
		y = y + cw
	end
	idle[#idle + 1] = { kind = "pixels", el = el, t = 0, cells = cells, acc = 0, rate = attr(el, "PixRate", 8), alpha = alpha,
		vary = attr(el, "PixVary", 0) >= 0.5, cw = sx, ch = sy }
end

local function wireReveal(el)
	if el:GetAttribute("FW_Reveal") then return end
	el:SetAttribute("FW_Reveal", true)
	slotFor(el, true)
	local size0, pos0 = el.Size, el.Position -- restore THESE, never an assumed 1x1 at centre
	local function play()
		idle[#idle + 1] = {
			kind = "reveal", el = el, t = 0, size0 = size0, pos0 = pos0,
			T = math.max(0.02, attr(el, "RevealTime", 0.7)),
			A = math.rad(attr(el, "RevealAngle", 35)),
			dir = math.rad(attr(el, "RevealDir", 0)),
			from = attr(el, "RevealFrom", 0.55),
		}
	end
	onShown(el, play)
end

local function gleamSeq(w, peak) -- the preview's core: shoulders at 30/70% of the band
	local h = math.clamp(w * 0.5, 0.04, 0.46) -- w is the FULL band, as in the preview
	if peak then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5 - h, 1),
			NumberSequenceKeypoint.new(0.5, peak),
			NumberSequenceKeypoint.new(0.5 + h, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5 - h, 1),
		NumberSequenceKeypoint.new(0.5 - h * 0.4, 0.45),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(0.5 + h * 0.4, 0.45),
		NumberSequenceKeypoint.new(0.5 + h, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
end
local GLEAM_TILT = -14 -- the preview skews the beam by the same angle
local function textSpill(x) -- the text scaler's k_text on x and every layer above it
	local sp = 1
	while x and x ~= gui do
		local h = x:FindFirstChild("FW_Scale")
		local c = h and h:FindFirstChild("k_text")
		if c and c.Value > 0 then sp = sp * c.Value end
		x = x.Parent
	end
	return sp
end
local GLEAM_TAN = 0.25 -- tan(14 deg): below this aspect the tilt eats the sweep
local function gleamShine(el, w)
	local grads = {}
	local box = el.AbsoluteSize -- a tilt on a wide, short layer collapses the sweep axis
	local tilt = (box.Y >= box.X * GLEAM_TAN) and GLEAM_TILT or 0
	local function band(host, width, peak)
		local g = Instance.new("UIGradient")
		g.Transparency = gleamSeq(width, peak)
		g.Rotation = tilt
		g.Offset = Vector2.new(-2, 0)
		g:SetAttribute("FW_Owned", true)
		g.Parent = host
		grads[#grads + 1] = g
	end
	local function whiteCopy(z)
		local ov
		if el:IsA("TextLabel") or el:IsA("TextButton") then
			ov = Instance.new("TextLabel")
			ov.Text = el.Text
			ov.RichText = el.RichText
			ov.FontFace = el.FontFace
			ov.TextScaled = el.TextScaled
			ov.TextSize = el.TextSize
			ov.TextWrapped = el.TextWrapped
			ov.LineHeight = el.LineHeight
			ov.TextXAlignment = el.TextXAlignment
			ov.TextYAlignment = el.TextYAlignment
			ov.TextColor3 = Color3.new(1, 1, 1)
			ov.TextStrokeTransparency = 1
		elseif el:IsA("ImageLabel") or el:IsA("ImageButton") then
			ov = Instance.new("ImageLabel")
			local sheen = el:FindFirstChild(el.Name .. "_Sheen") -- the white silhouette the plugin exported for this picture
			if sheen and sheen:IsA("ImageLabel") and sheen.Image ~= "" then
				ov.Image = sheen.Image
			else
				ov.Image = el.Image -- tinted white this IS the picture again: the sweep cannot show (older export)
				if not el:GetAttribute("FW_GleamNoSheen") then
					el:SetAttribute("FW_GleamNoSheen", true)
					warn("[Framewisp] _gleam: '" .. el.Name .. "' is a picture without its white silhouette, so the sweep has nothing to paint. Re-export with the current Framewisp plugin.")
				end
			end
			ov.ImageColor3 = Color3.new(1, 1, 1)
			ov.ScaleType = el.ScaleType
			ov.SliceCenter = el.SliceCenter
			ov.SliceScale = el.SliceScale
			ov.TileSize = el.TileSize
			ov.ImageRectOffset = el.ImageRectOffset
			ov.ImageRectSize = el.ImageRectSize
		else
			ov = Instance.new("Frame") -- a layer kept native is a plain Frame: it gets a sheen too
			ov.BackgroundColor3 = Color3.new(1, 1, 1)
		end
		ov.Name = "FW_GleamShine"
		ov.Visible = false -- shown ONLY while the light travels: no ghost copy at rest
		if not ov:IsA("Frame") then ov.BackgroundTransparency = 1 end
		ov.Size = UDim2.fromScale(1, 1)
		ov.Position = UDim2.fromScale(0.5, 0.5)
		ov.AnchorPoint = Vector2.new(0.5, 0.5)
		ov.ZIndex = el.ZIndex + z
		ov:SetAttribute("FW_Owned", true)
		local corner = el:FindFirstChildWhichIsA("UICorner")
		if corner then corner:Clone().Parent = ov end
		local bb = el:FindFirstChild("FW_BBText") -- a billboard's constraint rides along, or the copy fits differently
		if bb then bb:Clone().Parent = ov end -- no FigmaFontSize: the copy sits inside its label's spill and follows its TextSize
		ov.Parent = el
		return ov
	end
	local st = el:FindFirstChildWhichIsA("UIStroke")
	local function whiteStroke(host, extra)
		local c = st and st:Clone() or Instance.new("UIStroke")
		for _, k in ipairs(c:GetChildren()) do k:Destroy() end -- a stroke gradient measures in STROKE space, so it desyncs
		c.Color = Color3.new(1, 1, 1)
		pcall(function() c.BorderStrokePosition = Enum.BorderStrokePosition.Outer end)
		if host:IsA("TextLabel") or host:IsA("TextButton") then
			c.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual -- a cloned Border-mode stroke drew a white BOX around each letter
		end
		if st and st:GetAttribute("FW_StrokeScaled") then
			c.Thickness = st.Thickness * (extra > 0 and 1.7 or 1) -- a fraction, so widen by ratio
		else
			c.Thickness = (st and st.Thickness or 0) + extra / textSpill(el) -- the copy draws inside the label's text spill: the extra stays screen px
			if extra > 0 then c:SetAttribute("FW_StrokeExtra", extra) end -- the text scaler keeps the halo this much wider on every resize
			c:SetAttribute("FW_StrokeMine", c.Thickness) -- written by us, not a hand edit the scaler must leave alone
		end
		c:SetAttribute("FW_Owned", true)
		c.Parent = host
	end
	local isText = el:IsA("TextLabel") or el:IsA("TextButton") -- a stroke on an image outlines its rectangle, not glyphs
	local halo = whiteCopy(1) -- wide and soft: Roblox has no blur, a fatter outline stands in
	if halo then
		if isText then whiteStroke(halo, 3) end
		band(halo, w * 1.6, 0.4)
	end
	local core = whiteCopy(2)
	if not core then return grads end
	if st and isText then whiteStroke(core, 0) end -- the layer's gradient already covers its stroke
	band(core, w)
	return grads
end
local function wireGleam(el)
	if el:GetAttribute("FW_Gleam") then return end
	el:SetAttribute("FW_Gleam", true)
	local w = attr(el, "GleamWidth", 0.22)
	if not (el:IsA("TextLabel") or el:IsA("TextButton") or el:IsA("ImageLabel") or el:IsA("ImageButton")) then
		idle[#idle + 1] = { kind = "gleamG", el = el, t = 0, parts = nil, waited = 0 } -- collected on first tick: a group wires before its letters exist
		return
	end
	idle[#idle + 1] = { kind = "gleam", el = el, t = 0, w = w, grads = gleamShine(el, w) }
end
local function wireSwing(el)
	if el:GetAttribute("FW_Swing") then return end
	el:SetAttribute("FW_Swing", true)
	slotFor(el, true)
	local size0, pos0 = el.Size, el.Position -- restore THESE, never an assumed 1x1 at centre
	local parent0 = el.Parent
	local function playSwing()
		if parent0 ~= el.Parent then -- replay after the 3D host changed coordinate spaces
			parent0, size0, pos0 = el.Parent, el.Size, el.Position
		end
		if not el:GetAttribute("FW_3DHosted") then
			el:SetAttribute("FW_EntrSize0", size0)
			el:SetAttribute("FW_EntrPos0", pos0)
		end
		idle[#idle + 1] = {
			kind = "swing", el = el, t = 0, size0 = size0, pos0 = pos0, par = el.Parent,
			T = math.max(0.02, attr(el, "SwingTime", 1.2)),
			A = attr(el, "SwingAngle", 20),
			n = attr(el, "SwingCount", 4),
			from = attr(el, "SwingFrom", 0.5),
		}
	end
	onShown(el, playSwing)
end

local SoundService = game:GetService("SoundService")
local DROP_FADE = {
	ImageLabel = { "ImageTransparency", "BackgroundTransparency" },
	ImageButton = { "ImageTransparency", "BackgroundTransparency" },
	TextLabel = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	TextButton = { "TextTransparency", "BackgroundTransparency", "TextStrokeTransparency" },
	TextBox = { "TextTransparency", "BackgroundTransparency" },
	Frame = { "BackgroundTransparency" },
	ScrollingFrame = { "BackgroundTransparency" },
	CanvasGroup = { "GroupTransparency" },
	UIStroke = { "Transparency" },
}
local function dropParts(root) -- read ONCE: a replay mid-fade must not take a faded value for the rest
	local parts = {}
	local function add(inst)
		for _, prop in ipairs(DROP_FADE[inst.ClassName] or {}) do
			local ok, rest = pcall(function() return inst[prop] end)
			if ok and type(rest) == "number" then parts[#parts + 1] = { inst = inst, prop = prop, rest = rest } end
		end
	end
	add(root)
	local function under(inst) -- an arrow or a card shows and hides itself: never faded from here
		for _, c in ipairs(inst:GetChildren()) do
			if not (c:GetAttribute("FigmaPointer") or c:GetAttribute("FigmaCard")) then add(c); under(c) end
		end
	end
	under(root)
	return parts
end
local function dropAlpha(parts, a)
	for _, part in ipairs(parts) do
		if part.inst.Parent then pcall(function() part.inst[part.prop] = part.rest + (1 - part.rest) * (1 - a) end) end
	end
end
local function dropPose(e, kx, ky, dy) -- the layer's own box in its slot, scaled, lifted by dy slot heights
	local sz, po = e.size0, e.pos0
	e.el.Size = UDim2.new(sz.X.Scale * kx, sz.X.Offset * kx, sz.Y.Scale * ky, sz.Y.Offset * ky)
	e.el.Position = UDim2.new(po.X.Scale, po.X.Offset, po.Y.Scale + dy, po.Y.Offset)
end
local function dropAt(t, H, T, b, s, fade) -- the preview's dropAt, number for number: y px (up is negative), sx, sy, alpha
	local Tf = 0.55 * T
	local Tb = math.max(0.1, T - Tf - 0.08)
	if t < 0 then return -H, 1, 1, fade and 0 or 1 end
	local y, q = 0, 0
	if t < Tf then
		local p = t / Tf
		y = -H * (1 - p * p) -- speeds up like a weight
	elseif t < Tf + 0.08 then
		q = math.sin((t - Tf) / 0.08 * math.pi / 2) -- squashes where it lands
	else
		local r = t - Tf - 0.08
		y = -H * b * math.sin(math.pi * math.min(1, r / Tb)) -- one soft bounce
		local x = math.min(1, r / 0.2)
		q = 1 - (1 + 3.2 * (x - 1) ^ 3 + 2.2 * (x - 1) ^ 2) -- back out: a small stretch, then rest
	end
	return y, 1 + 0.6 * s * q, 1 - s * q, fade and math.min(1, t / (0.3 * Tf)) or 1
end
local function dropLen(T)
	local Tf = 0.55 * T
	return Tf + 0.08 + math.max(math.max(0.1, T - Tf - 0.08), 0.2)
end
local function dropTargets(el) -- the layer itself, or its children in reading order (their shadows ride along)
	if attr(el, "DropKids", 0) < 0.5 then return { { el } } end
	local kids, byName = {}, {}
	for _, c in ipairs(el:GetChildren()) do
		if c:IsA("GuiObject") and c.Visible and c.Name ~= "Background" and c.Name ~= "TextureClip" then
			kids[#kids + 1] = c
			byName[c.Name] = c
		end
	end
	local laid = el:FindFirstChildWhichIsA("UIListLayout") or el:FindFirstChildWhichIsA("UIGridLayout")
	local main, shadows = {}, {}
	for i, c in ipairs(kids) do
		local base = c.Name:sub(-6) == "Shadow" and byName[c.Name:sub(1, -7)] or nil
		if base and base ~= c then
			shadows[base] = shadows[base] or {}
			table.insert(shadows[base], c)
		else
			main[#main + 1] = { c = c, i = i }
		end
	end
	local measured = el.AbsoluteSize.Y > 1
	local function at(c, axis)
		if measured then return c.AbsolutePosition[axis] end
		return c.Position[axis].Scale * 1e4 + c.Position[axis].Offset
	end
	table.sort(main, function(a, b)
		if laid then
			if a.c.LayoutOrder ~= b.c.LayoutOrder then return a.c.LayoutOrder < b.c.LayoutOrder end
			return a.i < b.i
		end
		local ay, by = at(a.c, "Y"), at(b.c, "Y")
		if math.abs(ay - by) > 1 then return ay < by end -- reading order: top to bottom, then left to right
		local ax, bx = at(a.c, "X"), at(b.c, "X")
		if ax ~= bx then return ax < bx end
		return a.i < b.i
	end)
	local out = {}
	for _, m in ipairs(main) do
		local group = { m.c }
		for _, sh in ipairs(shadows[m.c] or {}) do group[#group + 1] = sh end
		out[#out + 1] = group
	end
	if #out == 0 then return { { el } } end -- baked flat: nothing inside to stagger, so the layer falls whole
	return out
end
local function wireDrop(el)
	if el:GetAttribute("FW_Drop") then return end
	el:SetAttribute("FW_Drop", true)
	local groups = nil
	local live = {}
	local function dropPlay()
		groups = groups or dropTargets(el)
		local step = attr(el, "DropKids", 0) >= 0.5 and attr(el, "DropStep", 0.06) or 0
		local delay = attr(el, "DropDelay", 0)
		for i, group in ipairs(groups) do
			for gi, target in ipairs(group) do
				local e = live[target]
				if not e then
					slotFor(target, true)
					e = { kind = "drop", el = target, src = el, size0 = target.Size, pos0 = target.Position, par = target.Parent,
						parts = dropParts(target), voice = (i == 1 and gi == 1) }
					live[target] = e
				end
				e.t = -(delay + (i - 1) * step)
				e.landed = false
				if not e.on then
					e.on = true
					idle[#idle + 1] = e
				end
				local slotH = target.Parent and target.Parent:IsA("GuiObject") and target.Parent.AbsoluteSize.Y or 0
				if slotH >= 1 and not target:GetAttribute("FW_3DHosted") then -- the first pose now: no frame shows it at rest
					dropPose(e, 1, 1, -attr(el, "DropHeight", 160) * pxScale() / slotH)
				end
				if attr(el, "DropFade", 1) >= 0.5 then dropAlpha(e.parts, 0) end
			end
		end
	end
	onShown(el, dropPlay)
end

local function wire(el)
	if not el:IsA("GuiObject") then return end
	if el:GetAttribute("FigmaTimeline") ~= nil then return end -- the timeline owns this layer
	local function try(fn, ...) -- one tag must never take the rest of the UI down
		local ok, err = pcall(fn, ...)
		if not ok then warn("[Framewisp] " .. el:GetFullName() .. ": " .. tostring(err)) end
	end
	if el:GetAttribute("FigmaGleam") then try(wireGleam, el) end
	if el:GetAttribute("FigmaSwing") then try(wireSwing, el) end
	if el:GetAttribute("FigmaReveal") then try(wireReveal, el) end
	if el:GetAttribute("FigmaDrop") then try(wireDrop, el) -- _drop plays the entrance: a _pop beside it would fight it
	elseif el:GetAttribute("FigmaPop") then try(wirePop, el) end
	if el:GetAttribute("FigmaCascade") then try(wireCascade, el) end
	if el:GetAttribute("FigmaGlow") then try(wireGlow, el) end
	if el:GetAttribute("FigmaPixels") then task.spawn(try, wirePixels, el) end -- waits for a real box
	local function once(name) -- reparenting into a slot re-fires DescendantAdded
		if el:GetAttribute(name) then return false end
		el:SetAttribute(name, true)
		return true
	end
	if el:GetAttribute("FigmaPulse") and once("FW_Pulse") then
		idle[#idle + 1] = { kind = "pulse", el = el, sc = scaleOf(el), t = math.random() * 7 }
	end
	if el:GetAttribute("FigmaJelly") and once("FW_Jelly") then
		idle[#idle + 1] = { kind = "jelly", el = el, sc = scaleOf(el), base = el.Rotation, t = math.random() * 7 }
	end
	if el:GetAttribute("FigmaWiggle") and once("FW_Wiggle") then
		idle[#idle + 1] = { kind = "wiggle", el = el, base = el.Rotation, t = 0 }
	end
	if el:GetAttribute("FigmaRays") and once("FW_Rays") then
		idle[#idle + 1] = { kind = "rays", el = el, sc = scaleOf(el), base = el.Rotation, t = math.random() * 7 }
	end
	if el:GetAttribute("FigmaShake") and once("FW_Shake") then
		slotFor(el)
		idle[#idle + 1] = { kind = "shake", el = el, base = nil, t = 0 }
	end
end
for _, d in ipairs(fwAll()) do wire(d) end
for _, r in ipairs(fwRoots()) do r.DescendantAdded:Connect(wire) end

local function posed(e, kx, ky, dx, dy) -- the layer's own box, scaled and nudged
	local sz, po = e.size0, e.pos0
	e.el.Size = UDim2.new(sz.X.Scale * kx, sz.X.Offset * kx, sz.Y.Scale * ky, sz.Y.Offset * ky)
	e.el.Position = UDim2.new(po.X.Scale + dx, po.X.Offset, po.Y.Scale + dy, po.Y.Offset)
end
local scaleAcc, rotAcc, rotBase = {}, {}, {}
local function tickIdle(dt)
	local dead = nil
	table.clear(scaleAcc)
	table.clear(rotAcc)
	table.clear(rotBase)
	for i, e in ipairs(idle) do
		if e.el.Parent then
			e.t = e.t + dt
			if e.size0 and e.par ~= e.el.Parent then
				e.par = e.el.Parent -- a slot re-hosted it with canonical FULL-size coords; dividing the entrance out again doubled the card
				e.size0 = e.el.Size
				e.pos0 = e.el.Position
			end
			if e.kind == "swing" then
				local p = math.min(1, e.t / e.T)
				if p >= 1 then
					posed(e, 1, 1, 0, 0)
					if e.el:GetAttribute("FW_SwingPitch") then e.el:SetAttribute("FW_SwingPitch", 0) end
					e.el:SetAttribute("FW_HostScale", nil)
					e.el:SetAttribute("FW_EntrK", nil)
					e.el:SetAttribute("FW_EntrSize0", nil)
					e.el:SetAttribute("FW_EntrPos0", nil)
					dead = dead or {}
					dead[#dead + 1] = i
				else
					local deg = e.A * math.exp(-4 * p) * math.cos(p * math.pi * 2 * e.n)
					local th = math.rad(deg)
					local rise = math.min(1, e.t / (e.T * 0.3))
					local c = 2.2
					local sc = e.from + (1 - e.from) * (1 + (c + 1) * (rise - 1) ^ 3 + c * (rise - 1) ^ 2)
					if e.el:GetAttribute("FW_3DHosted") then -- real depth: scale the WORLD QUAD, never the card's box
						e.el:SetAttribute("FW_SwingPitch", deg)
						e.el:SetAttribute("FW_HostScale", sc)
						posed(e, 1, 1, 0, 0) -- the flat frames before hosting left the box shrunken; hold it at full or the finish SNAPS
					else
						e.el:SetAttribute("FW_EntrSize0", e.size0)
						e.el:SetAttribute("FW_EntrPos0", e.pos0)
						e.el:SetAttribute("FW_EntrK", sc) -- the 3D slot reads this if it adopts the card mid-entrance
						posed(e, sc, sc * math.abs(math.cos(th)), 0, -math.sin(th) * 0.09)
					end
				end
			elseif e.kind == "drop" then
				local src = e.src
				local T = math.max(0.1, attr(src, "DropTime", 0.6))
				local y, sx, sy, o = dropAt(e.t, attr(src, "DropHeight", 160) * pxScale(), T,
					attr(src, "DropBounce", 12) / 100, attr(src, "DropSquash", 10) / 100, attr(src, "DropFade", 1) >= 0.5)
				local slot = e.el.Parent
				local slotH = slot and slot:IsA("GuiObject") and slot.AbsoluteSize.Y or 0
				if e.el:GetAttribute("FW_3DHosted") or slotH < 1 then
					dropPose(e, 1, 1, 0) -- a card in the world only fades: its quad follows the slot, not this box
				else
					dropPose(e, sx, sy, y / slotH + (1 - sy) / 2) -- the bottom edge stays put while it squashes
				end
				dropAlpha(e.parts, o)
				if not e.landed and e.t >= 0.55 * T then
					e.landed = true
					local id = attr(src, "DropSound", 0)
					if id > 0 and e.voice then -- one landing sound per drop, not one per child
						local snd = src:FindFirstChild("FW_DropSound")
						if not snd then
							snd = Instance.new("Sound")
							snd.Name = "FW_DropSound"
							snd:SetAttribute("FW_Owned", true)
							snd.Parent = src
						end
						snd.SoundId = "rbxassetid://" .. string.format("%d", id)
						pcall(function() SoundService:PlayLocalSound(snd) end)
					end
				end
				if e.t >= dropLen(T) then
					dropPose(e, 1, 1, 0)
					dropAlpha(e.parts, 1)
					e.on = false
					dead = dead or {}
					dead[#dead + 1] = i
				end
			elseif e.kind == "reveal" then
				local p = math.min(1, e.t / e.T)
				if p >= 1 then
					posed(e, 1, 1, 0, 0)
					dead = dead or {}
					dead[#dead + 1] = i
				else
					local th = e.A * math.exp(-5 * p) * math.cos(p * math.pi * 5)
					local rise = math.min(1, e.t / (e.T * 0.45))
					local c = 2.2
					local sc = e.from + (1 - e.from) * (1 + (c + 1) * (rise - 1) ^ 3 + c * (rise - 1) ^ 2)
					local fore = 1 - math.cos(th)
					local drift = math.sin(th) * 0.07
					posed(e, sc * (1 - fore * math.abs(math.sin(e.dir))), sc * (1 - fore * math.abs(math.cos(e.dir))),
						math.sin(e.dir) * drift, -math.cos(e.dir) * drift)
				end
			elseif e.kind == "pulse" then
				local sp = attr(e.el, "PulseSpeed", 1)
				local w = (1 - math.cos(e.t * math.pi * 2 * sp)) * 0.5 -- even speed: a flattened peak held its last pixel step
				local amp = attr(e.el, "PulseAmp", 5) / 100
				if e.el:GetAttribute("FW_3DHosted") then
					e.el:SetAttribute("FW_HostScale", 1 + amp * w) -- scaled as a 3D quad: no pixel grid
				else
					local px = math.min(e.el.AbsoluteSize.X, e.el.AbsoluteSize.Y) -- UI lays out on WHOLE pixels
					if px > 1 and amp * px < 10 then amp = math.min(amp * 4, 10 / px) end -- more travel = more steps
					scaleAcc[e.sc] = (scaleAcc[e.sc] or 1) * (1 + amp * w)
				end
			elseif e.kind == "jelly" then
				local sp = attr(e.el, "JellySpeed", 1.2)
				rotBase[e.el] = e.base
				rotAcc[e.el] = (rotAcc[e.el] or 0) + math.sin(e.t * math.pi * 2 * sp) * attr(e.el, "JellyAmp", 3)
				scaleAcc[e.sc] = (scaleAcc[e.sc] or 1) * (1 + 0.01 * math.sin(e.t * math.pi * 4 * sp + 1))
			elseif e.kind == "wiggle" then
				local every = attr(e.el, "WiggleEvery", 4)
				local tt = e.t % (every + 0.7)
				rotBase[e.el] = e.base
				rotAcc[e.el] = rotAcc[e.el] or 0
				if tt < 0.7 then
					local p = tt / 0.7
					rotAcc[e.el] = rotAcc[e.el] + math.sin(p * math.pi * 6) * attr(e.el, "WiggleAngle", 12) * (1 - p)
				end
			elseif e.kind == "rays" then
				e.ang = (e.ang or 0) + attr(e.el, "RaysSpeed", 25) * dt
				rotBase[e.el] = e.base or 0
				rotAcc[e.el] = (rotAcc[e.el] or 0) + e.ang
				scaleAcc[e.sc] = (scaleAcc[e.sc] or 1) * (1 + attr(e.el, "RaysPulse", 6) / 100 * (0.5 + 0.5 * math.sin(e.t * 2)))
			elseif e.kind == "shake" then
				local every = attr(e.el, "ShakeEvery", 3)
				local dur = attr(e.el, "ShakeTime", 0.5)
				local tt = e.t % (every + dur)
				if e.base == nil then e.base = e.el.Position end
				if tt < dur then
					local p = tt / dur
					local amp = attr(e.el, "ShakeAmp", 6) * (1 - p)
					e.el.Position = e.base + UDim2.fromOffset(math.sin(e.t * 53) * amp, math.cos(e.t * 47) * amp)
				else
					e.el.Position = e.base
				end
			elseif e.kind == "glow" then
				local sp = attr(e.el, "GlowSpeed", 0.8)
				local size = attr(e.el, "GlowSize", 12)
				local breathe = 0.5 + 0.5 * math.sin(e.t * math.pi * 2 * sp)
				if e.frac then -- a ScaledSize stroke is a FRACTION: pixels here meant 150-600%
					local short = math.max(1, math.min(e.el.AbsoluteSize.X, e.el.AbsoluteSize.Y))
					e.stroke.Thickness = e.base + (size * 0.5 * breathe) / short
				else
					e.stroke.Thickness = math.max(e.base + size * 0.5 * breathe, 1.5) -- same 0.5 factor as the demo ring
				end
				e.stroke.Transparency = 0.15 -- the preview's ring holds its density; only SIZE breathes
			elseif e.kind == "gleam" then
				local dur = attr(e.el, "GleamSpeed", 0.8)
				local cool = attr(e.el, "GleamCooldown", 2)
				local w = attr(e.el, "GleamWidth", 0.22)
				local tt = e.t % (dur + cool)
				if e.grads then
					local live = tt < dur
					local off = -2
					if live then
						local span = 0.5 + w
						off = -span + (tt / dur) * span * 2
					end
					for gi = 1, #e.grads do
						e.grads[gi].Offset = Vector2.new(off, 0)
						local host = e.grads[gi].Parent
						if host and host:IsA("GuiObject") then
							if host.Visible ~= live then host.Visible = live end
							if live and host:IsA("TextLabel") and (e.el:IsA("TextLabel") or e.el:IsA("TextButton")) then -- both text classes share the original's spill
								if host.TextSize ~= e.el.TextSize then host.TextSize = e.el.TextSize end
								if host.TextScaled ~= e.el.TextScaled then host.TextScaled = e.el.TextScaled end
							end
						end
					end
				end
			elseif e.kind == "gleamG" then
				if e.parts == nil then
					local w0 = attr(e.el, "GleamWidth", 0.22)
					local gw0 = math.max(1, e.el.AbsoluteSize.X)
					local found = {}
					if gw0 > 1 then
						for _, d in ipairs(e.el:GetDescendants()) do
							local isText = d:IsA("TextLabel") or d:IsA("TextButton")
							if (isText or d:IsA("ImageLabel") or d:IsA("ImageButton")) -- overlays excluded by NAME: FW_Owned marks every imported instance, letters included
								and d.Name ~= "FW_GleamShine" and d.Name ~= "Background" then
								local dw = d.AbsoluteSize.X
								local pad = d:FindFirstChild("FW_TextPad")
								if pad and pad:IsA("UIPadding") then
									dw = dw * math.max(0, 1 - pad.PaddingLeft.Scale - pad.PaddingRight.Scale) -- the glyph copy lives inside the text spill's inset
								end
								if dw > 0 and (isText or dw < gw0 * 0.95) then -- only a group-sized IMAGE is a backdrop; a full-width title is still text
									local wl = math.clamp(w0 * gw0 / math.max(1, dw), 0.05, 0.6) -- capped: an uncapped band lit each letter WHOLE, a square flash instead of a sheen
									found[#found + 1] = { el = d, grads = gleamShine(d, wl) }
								end
							end
						end
					end
					if #found > 0 then
						e.parts = found
					else
						e.waited = e.waited + dt
						if e.waited > 2 then -- a group with genuinely nothing inside: the single sheen
							e.kind = "gleam"
							e.w = w0
							e.grads = gleamShine(e.el, w0)
						end
						continue
					end
				end
				local dur = math.max(0.02, attr(e.el, "GleamSpeed", 0.8))
				local cool = attr(e.el, "GleamCooldown", 2)
				local w = attr(e.el, "GleamWidth", 0.22)
				local tt = e.t % (dur + cool)
				local live = tt < dur
				local gp = e.el.AbsolutePosition.X
				local gw = math.max(1, e.el.AbsoluteSize.X)
				local m = 0.5 + w
				local c = -m + (tt / dur) * (1 + 2 * m) -- the band's centre, in GROUP fractions
				for pi = 1, #e.parts do
					local p = e.parts[pi]
					if p.el.Parent then
						for gi = 1, #p.grads do
							local host = p.grads[gi].Parent
							if host and host:IsA("GuiObject") then
								local px = (host.AbsolutePosition.X - gp) / gw
								local pw = math.max(0.001, host.AbsoluteSize.X / gw) -- use the rendered copy, not its parent's expanded text-spill box
								local off = live and ((c - px) / pw - 0.5) or -10 -- the ONE light, in this letter's own fractions
								p.grads[gi].Offset = Vector2.new(off, 0)
								if host.Visible ~= live then host.Visible = live end
								if live and host:IsA("TextLabel") and (p.el:IsA("TextLabel") or p.el:IsA("TextButton")) then
									if host.TextSize ~= p.el.TextSize then host.TextSize = p.el.TextSize end
									if host.TextScaled ~= p.el.TextScaled then host.TextScaled = p.el.TextScaled end
								end
							end
						end
					end
				end
			elseif e.kind == "pixels" then
				e.acc = e.acc + dt * e.rate
				while e.acc >= 1 do
					e.acc = e.acc - 1
					local f = e.cells[math.random(#e.cells)]
					if f then
						if e.vary then
							local kk = 0.3 + math.random() * 1.4
							f.Size = UDim2.fromScale(e.cw * kk, e.ch * kk)
						else
							f.Size = UDim2.fromScale(e.cw, e.ch)
						end
						local lit = 1 - e.alpha * (0.55 + 0.45 * math.random()) -- each twinkle its own brightness
						TweenService:Create(f, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
							{ BackgroundTransparency = lit }):Play() -- the preview's envelope: fast lift, hold, slow fall
						local hold = 0.16 + math.random() * 0.48
						local fall = 0.35 + math.random() * 0.45
						task.delay(hold, function()
							if f.Parent then
								TweenService:Create(f, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
									{ BackgroundTransparency = 1 }):Play()
							end
						end)
					end
				end
			end
		end
	end
	for sc, v in pairs(scaleAcc) do -- one write per property: effects multiply, never overwrite
		sc.Value = v
	end
	for el, d in pairs(rotAcc) do
		fwRotSet(el, "r_juice", d)
	end
	if dead then
		for i = #dead, 1, -1 do
			table.remove(idle, dead[i])
		end
	end
end
task.delay(0.4, function() -- after the 3D host has had its turn
	local flat, deep = 0, 0
	for _, e in ipairs(idle) do
		if e.kind == "pulse" then
			if e.el:GetAttribute("FW_3DHosted") then deep = deep + 1 else flat = flat + 1 end
		end
	end
	print(("[Framewisp] juice: %d effect(s) on %s | pulse: %d smooth (3D host), %d on the pixel grid")
		:format(#idle, gui:GetFullName(), deep, flat))
end)
local told = false
RunService.RenderStepped:Connect(function(dt) -- one bad frame must not stop every effect
	local ok, err = pcall(tickIdle, dt)
	if not ok and not told then
		told = true
		warn("[Framewisp] effects: " .. tostring(err))
	end
end)
]]></string>
