        <Item class="ModuleScript" referent="118">
          <Properties>
            <string name="Name">InitialSpawnService</string>
            <string name="Source"><![CDATA[--!strict
local Spawn = {}
local deps: any
local spawnReservationByPlot: { [Instance]: Player } = {}
local spawnReservationByPlayer: { [Player]: Instance } = {}
local claimHintPlotByPlayer: { [Player]: Instance } = {}
local attempted: { [Player]: boolean } = {}
local function availableTarget(player: Player): Instance?
    for _, plot in deps.TycoonService.GetOrderedPlots() do
        local identity = plot:FindFirstChild("PlotIdentity")
        local marker = if identity then identity:FindFirstChild("PlayerSpawnOrigin") else nil
        if
            deps.TycoonService.IsPlotAvailable(plot)
            and (not spawnReservationByPlot[plot] or spawnReservationByPlot[plot] == player)
            and marker
            and marker:IsA("Attachment")
        then
            return plot
        end
    end
    return nil
end
function Spawn.Init(services: any)
    deps = services
    local elapsed = 0
    game:GetService("RunService").Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.25 then
            return
        end
        elapsed = 0
        for player, intended in claimHintPlotByPlayer do
            if
                player.Parent ~= nil
                and player:GetAttribute("TutorialActive") == true
                and player:GetAttribute("TutorialStage") == "ClaimPlot"
                and not deps.TycoonService.GetPlot(player)
                and not deps.TycoonService.IsPlotAvailable(intended)
            then
                -- Retarget help only when the intended plot becomes unavailable.
                -- No teleport, ownership, renewed timeout or additional spawn reservation.
                local nextTarget = availableTarget(player)
                local value = player:FindFirstChild("TutorialSpawnTarget")
                if value and value:IsA("ObjectValue") then
                    value.Value = nextTarget
                end
                if nextTarget then
                    claimHintPlotByPlayer[player] = nextTarget
                end
            end
        end
    end)
end
function Spawn.ClearReservation(player: Player, preserveHint: boolean?)
    local plot = spawnReservationByPlayer[player]
    if plot and spawnReservationByPlot[plot] == player then
        spawnReservationByPlot[plot] = nil
    end
    spawnReservationByPlayer[player] = nil
    if not preserveHint then
        claimHintPlotByPlayer[player] = nil
    end
    local target = player:FindFirstChild("TutorialSpawnTarget")
    if target and target:IsA("ObjectValue") and (not preserveHint or target.Value == plot) then
        target.Value = nil
    end
end
-- Shared, read-only assigned-plot resolution. Never reserves or claims an unowned plot.
-- Returns a model pivot, matching the existing assigned-character respawn placement.
function Spawn.GetAssignedSpawn(player: Player): (CFrame?, Instance?)
    local plot = deps.TycoonService.GetPlot(player)
    if not plot or not plot:IsDescendantOf(workspace) then
        return nil, nil
    end
    local identity = plot:FindFirstChild("PlotIdentity")
    local origin = if identity then identity:FindFirstChild("PlayerSpawnOrigin") else nil
    if not origin or not origin:IsA("Attachment") then
        return nil, plot
    end
    local at = origin.WorldCFrame * CFrame.new(0, 3, 0)
    if deps.TycoonService.GetOwner(plot) ~= player then
        at *= CFrame.new(4, 0, 0)
    end
    return at, plot
end

function Spawn.ApplyCharacter(player: Player, character: Model)
    local firstArrival = not attempted[player]
    attempted[player] = true -- Only unclaimed tutorial routing is limited to the first character.
    task.spawn(function()
        local root = character:WaitForChild("HumanoidRootPart", 10)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if
            not root
            or not root:IsA("BasePart")
            or not humanoid
            or humanoid.Health <= 0
            or player.Parent == nil
            or player.Character ~= character
        then
            return
        end
        -- Resolve after the root wait so a release, team change or reassignment cannot
        -- send this character to a stale session. Nothing below yields before PivotTo.
        local assignedSpawn, assignedPlot = Spawn.GetAssignedSpawn(player)
        if assignedPlot then
            if assignedSpawn then
                character:PivotTo(assignedSpawn)
                root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            end
            return
        end
        if not firstArrival then
            return
        end
        for _, plot in deps.TycoonService.GetOrderedPlots() do
            local identity = plot:FindFirstChild("PlotIdentity")
            local marker = if identity then identity:FindFirstChild("PlayerSpawnOrigin") else nil
            if
                deps.TycoonService.IsPlotAvailable(plot)
                and not spawnReservationByPlot[plot]
                and marker
                and marker:IsA("Attachment")
            then
                spawnReservationByPlot[plot], spawnReservationByPlayer[player] = player, plot
                claimHintPlotByPlayer[player] = plot
                local target = Instance.new("ObjectValue")
                target.Name, target.Value, target.Parent = "TutorialSpawnTarget", plot, player
                -- Attachment specifies HRP, whereas PivotTo specifies the model pivot.
                character:PivotTo(marker.WorldCFrame * root.CFrame:ToObjectSpace(character:GetPivot()))
                root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                task.delay(25, function()
                    if spawnReservationByPlayer[player] == plot then
                        Spawn.ClearReservation(player, true)
                    end
                end)
                return
            end
        end
    end)
end
function Spawn.RemovePlayer(player: Player)
    Spawn.ClearReservation(player)
    attempted[player] = nil
end
return Spawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="119">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local BatConfig = require(Shared.Constants.BatConfig)
local Types = require(Shared.Types)
local Item = require(Shared.IngredientItem)
local IngredientName = require(Shared.IngredientName)
local WorldUtil = require(script.Parent.WorldUtil)
local CarryPresentation = require(script.Parent.IngredientCarryPresentation)
local IngredientThrow = require(script.Parent.IngredientThrow)
local GameplaySfx = require(script.Parent.GameplaySfxService)
local SmoothieItem = require(script.Parent.SmoothieItem)
local SmoothieGeometry = require(script.Parent.SmoothieGeometry)
local InventoryService = {}
local MovementService = require(script.Parent.MovementService)
local deps: any
local carried: { [Player]: { [string]: { Types.IngredientItem } } } = {}
local stashes: { [Player]: { [number]: Types.StashSlot } } = {}
local stashChanged = Instance.new("BindableEvent")
InventoryService.StashChanged = stashChanged.Event
local releaseAt: { [Player]: number } = {}
local starterSessions: { [string]: Player } = {}
local TutorialOrders = require(Shared.Constants.TutorialOrders)
local thrownIngredients: { [Player]: { { Object: Instance, ObserveAfter: number, SessionId: string? } } } = {}
local StashConfig = Economy.NormalStash
local StashSlots = require(script.Parent.StashSlots)
local StashValue = require(script.Parent.StashValue)
local function ingredientSlotCapacity(): number
    return StashConfig.IngredientCapacity
end

local raids: { [string]: { RaidEndsAt: number, ProtectionEndsAt: number } } = {}
local stashBusy: { [Player]: boolean } = {}
local stashRequests: { [Player]: { Id: number, NextAt: number } } = {}
type HeldItem = {
    Item: Types.IngredientItem?,
    AnnouncementOwnership: Types.AnnouncementOwnership?,
    Tool: Tool,
    CarryItemId: number,
    VisualHost: Model?,
    ItemType: "Ingredient" | "Smoothie",
    Id: string?,
    Smoothie: Types.SmoothieData?,
    Root: BasePart,
    ClearVisual: () -> (),
    Height: number,
    ShiftDown: ((number) -> ())?,
    Releasing: boolean,
    Destroying: boolean,
    Connections: { RBXScriptConnection },
}
local held: { [Player]: { HeldItem } } = {}
local nextCarryItemId = 0
-- Prepared Lucky grants are synchronous and private to this module. Discovery
-- is deferred until the entire batch commits; rollback removes only new records.
local preparedGrants: { [Player]: { [string]: { Instance } } } = {}
local function topItem(player: Player): HeldItem?
    local stack = held[player]
    return if stack then stack[#stack] else nil
end
local switching: { [Player]: boolean } = {}
local function selectedItem(player: Player): HeldItem?
    local stack = held[player] or {}
    for index = #stack, 1, -1 do
        if stack[index].Tool.Parent == player.Character then
            return stack[index]
        end
    end
    return nil
end
-- Client IDs are preferences, never ownership proof. Only this player's live records qualify.
local function resolveActionItem(player: Player, requestedCarryItemId: any?, newestFirst: boolean?): HeldItem?
    local stack: { HeldItem } = held[player] or {}
    local function available(item: HeldItem): boolean
        return not item.Releasing and not item.Destroying
    end
    local selected = selectedItem(player)
    -- Smoothies keep their existing exact equipped selection, independent of ingredient hints.
    if selected and selected.ItemType == "Smoothie" and available(selected) then
        return selected
    end
    local requested = if newestFirst then nil else requestedCarryItemId
    if not newestFirst and requested == nil and selected and selected.ItemType == "Ingredient" then
        requested = selected.Tool:GetAttribute("CarryItemId")
    end
    if type(requested) == "number" and requested == requested and requested > 0 and requested % 1 == 0 then
        for _, item in stack do
            if item.CarryItemId == requested and item.ItemType == "Ingredient" and available(item) then
                return item
            end
        end
    end
    for index = #stack, 1, -1 do
        local item = stack[index]
        if item.ItemType == "Ingredient" and available(item) then
            return item
        end
    end
    return nil
end
local function equipTool(player: Player, humanoid: Humanoid, tool: Tool)
    switching[player] = true
    humanoid:EquipTool(tool)
    switching[player] = nil
end
function InventoryService.GetCarryCount(player: Player): number
    return #(held[player] or {})
end
function InventoryService.GetCarryCapacity(player: Player): number
    return Upgrades.CarryCapacity[deps.PlayerDataService.GetUpgrade(player, "CarryCapacity")].Value
end
local function syncHeld(player: Player)
    -- These attributes describe the action target, including unequipped ingredient fallback.
    local top = resolveActionItem(player)
    player:SetAttribute("HeldIngredientId", if top and top.ItemType == "Ingredient" then top.Id else nil)
    player:SetAttribute("HeldItemType", if top then top.ItemType else nil)
    local hasSmoothie = false
    local stack = held[player]
    if stack then
        for _, item in stack do
            hasSmoothie = hasSmoothie or item.ItemType == "Smoothie"
        end
    end
    player:SetAttribute("HasSmoothie", hasSmoothie)
    player:SetAttribute("CarryCount", InventoryService.GetCarryCount(player))
    CarryPresentation.RefreshValue(player, stack or {})
end
local function removeAt(player: Player, index: number?)
    local stack = held[player]
    if not stack then
        return
    end
    local removedIndex = index or #stack
    local record = table.remove(stack, removedIndex)
    if not record then
        return
    end
    for _, connection in record.Connections do
        connection:Disconnect()
    end
    if #stack == 0 then
        held[player] = nil
    end
    for i = removedIndex, #stack do
        local item = stack[i]
        if item.ShiftDown then
            item.ShiftDown(record.Height)
        end
    end
    local wasEquipped = record.Tool.Parent == player.Character
    record.ClearVisual()
    if record.VisualHost then
        record.VisualHost:Destroy()
    end
    if not record.Destroying then
        record.Tool:Destroy()
    end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if wasEquipped and #stack > 0 and humanoid and humanoid.Health > 0 and not switching[player] then
        local nextItem = stack[#stack]
        -- Continue the ingredient stack when removing its selected slot in mixed carry.
        if record.ItemType == "Ingredient" then
            for i = #stack, 1, -1 do
                if stack[i].ItemType == "Ingredient" then
                    nextItem = stack[i]
                    break
                end
            end
        end
        equipTool(player, humanoid, nextItem.Tool)
    end
    syncHeld(player)
end
local function removeTop(player: Player)
    removeAt(player)
end

-- Authorization for the loose-world pickup context only. Never use this owner rule
-- as a global inventory-transfer policy: stash acquisition must separately validate
-- its server-owned slot/protection state before granting a unit or held reservation.
-- No caller-supplied owner, slot attributes, or "allow stealing" flag grants rights here.
local function getLoosePickupRecord(player: Player, object: Instance): { Id: string, Item: Types.IngredientItem }?
    local record = deps.IngredientService.GetRecord(object)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not record
        or not record.Claimable
        or (record.Owner ~= nil and record.Owner ~= player)
        or not humanoid
        or humanoid.Health <= 0
        or not WorldUtil.Near(player, object, Economy.InteractionDistance)
    then
        return nil
    end
    return record
end

function InventoryService.ClearHeld(player: Player)
    while topItem(player) do
        removeTop(player)
    end
    syncHeld(player)
end

-- Spawn is synchronous. Keep reservations through fallible geometry preparation;
-- ingredient throws clear/reflow carry before publishing the new physical object.
local function releaseHeld(
    player: Player,
    throwing: boolean,
    dropIndex: number?,
    itemIndex: number?,
    scatter: Vector3?
): Instance?
    local record = if itemIndex then (held[player] or {})[itemIndex] else topItem(player)
    if not record or record.Releasing then
        return nil
    end
    record.Releasing = true
    if throwing and not record.Smoothie then
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not root or not root:IsA("BasePart") then
            record.Releasing = false
            return nil
        end
        local at = IngredientThrow.Origin(root)
        local object = deps.IngredientService.Spawn(record.Id :: string, at, nil, true, {
            Item = record.Item,
            FeedingActor = player,
            FeedingSessionId = deps.TycoonService.GetSessionId(player),
            PrepareSpawn = function(prepared: Instance): CFrame?
                local origin, reason = IngredientThrow.FindOrigin(root, character, prepared)
                IngredientThrow.Trace(player, "placement: " .. reason)
                if origin then
                    at = origin
                end
                return origin
            end,
            BeforePublish = function(prepared: Instance)
                if deps.AnnouncementService then
                    deps.AnnouncementService.TrackWorld(prepared, record.AnnouncementOwnership)
                end
                removeAt(player, itemIndex)
                IngredientThrow.IgnoreCharacter(prepared, character)
            end,
        })
        if not object then
            record.Releasing = false
            return nil
        end
        local part = WorldUtil.Part(object)
        if part then
            part.AssemblyLinearVelocity = at.LookVector * 25 + Vector3.new(0, 18, 0)
        end
        if player:GetAttribute("TutorialActive") == true then
            InventoryService.HasIngredientInFlight(player)
            local pending = thrownIngredients[player] or {}
            thrownIngredients[player] = pending
            table.insert(pending, {
                Object = object,
                ObserveAfter = os.clock() + 0.25,
                SessionId = deps.TycoonService.GetSessionId(player),
            })
        end
        return object
    end
    -- Retain the original character root for death/removal, even after Character changes.
    local at = record.Root.CFrame
    -- The held[player] reservation is exclusive only while carried. Both drop
    -- and throw release ownership so anyone can claim the loose world unit.
    local offset = if throwing then CFrame.new(0, 1, -3) else CFrame.new(((dropIndex or 1) - 1) * 2, 2, -3)
    local spawnAt = if scatter
        then CFrame.new(
            at.Position + scatter * BatConfig.Scatter.SpawnRadius + Vector3.new(0, BatConfig.Scatter.SpawnHeight, 0)
        )
        else at * offset
    local object = if record.Smoothie
        then deps.SmoothieWorldItemService.Spawn(record.Smoothie, at * offset)
        else deps.IngredientService.Spawn(record.Id :: string, spawnAt, nil, true, {
            Item = record.Item,
            FeedingActor = player,
            FeedingSessionId = deps.TycoonService.GetSessionId(player),
        })
    if not object then
        record.Releasing = false
        return nil
    end
    if deps.AnnouncementService then
        deps.AnnouncementService.TrackWorld(object, record.AnnouncementOwnership)
    end
    removeAt(player, itemIndex)
    local part = WorldUtil.Part(object)
    if part and throwing then
        part.AssemblyLinearVelocity = at.LookVector * 25 + Vector3.new(0, 18, 0)
    elseif part and scatter then
        local tuning = BatConfig.Scatter
        part.AssemblyLinearVelocity = scatter
                * (tuning.HorizontalMin + math.random() * (tuning.HorizontalMax - tuning.HorizontalMin))
            + Vector3.new(0, tuning.UpwardMin + math.random() * (tuning.UpwardMax - tuning.UpwardMin), 0)
        if player.Character then
            IngredientThrow.IgnoreCharacter(object, player.Character)
        end
    end
    return object
end

-- Forced drops use held records, never Backpack contents; smoothies remain reserved.
function InventoryService.DropCarriedIngredients(player: Player, reason: string?, away: Vector3?): number
    local dropped = 0
    local count = 0
    local stack: { HeldItem } = held[player] or {}
    for _, record in stack do
        if record.ItemType == "Ingredient" then
            count += 1
        end
    end
    local flat = if away then Vector3.new(away.X, 0, away.Z) else Vector3.new(0, 0, -1)
    local direction: Vector3 = if flat.Magnitude > 0.001 then flat.Unit else Vector3.new(0, 0, -1)
    for index = #(held[player] or {}), 1, -1 do
        local record = (held[player] or {})[index]
        if record and record.ItemType == "Ingredient" then
            local scatter: Vector3? = nil
            if reason == "BatStun" then
                -- Stratified random fan prevents a multi-item burst sharing one trajectory.
                local angle = ((dropped + 0.2 + math.random() * 0.6) / math.max(count, 1) - 0.5)
                    * math.rad(BatConfig.Scatter.FanAngle)
                scatter = direction * math.cos(angle) + Vector3.new(-direction.Z, 0, direction.X) * math.sin(angle)
            end
            if releaseHeld(player, false, dropped + 1, index, scatter) then
                dropped += 1
            end
        end
    end
    return dropped
end

function InventoryService.DropHeld(player: Player): Instance?
    local first: Instance? = nil
    local count = InventoryService.GetCarryCount(player)
    for index = count, 1, -1 do
        local record = (held[player] or {})[index]
        if not record then
            break
        end
        local object = releaseHeld(player, false, count - index + 1, index)
        if not object then
            break
        end
        first = first or object
    end
    return first
end

-- Release all carried items before clearing any remaining character reservations.
function InventoryService.CleanupCharacter(player: Player)
    InventoryService.DropHeld(player)
    InventoryService.ClearHeld(player)
end

-- Exact selected identity takes priority; unselected/invalid ingredient hints use newest-first.
function InventoryService.ThrowHeld(player: Player, requestedCarryItemId: any?, newestFirst: boolean?): Instance?
    if not MovementService.CanPerformGameplayAction(player) then
        IngredientThrow.Trace(player, "rejected: gameplay action disabled")
        return nil
    end
    -- Input prefers the equipped item, with the newest available ingredient as fallback.
    local record = resolveActionItem(player, requestedCarryItemId, newestFirst)
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not record or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
        IngredientThrow.Trace(
            player,
            "rejected: "
                .. (
                    if not record
                        then "no valid held item"
                        elseif not root or not root:IsA("BasePart") then "missing character root"
                        else "missing/dead humanoid"
                )
        )
        return nil
    end
    IngredientThrow.Trace(
        player,
        "resolved held item=" .. tostring(record.Id) .. " carryId=" .. tostring(record.CarryItemId)
    )
    if player:GetAttribute("ThrowDebug") == true then
        local selected = selectedItem(player)
        IngredientThrow.Trace(
            player,
            "selection carryId="
                .. tostring(if selected then selected.CarryItemId else nil)
                .. " matchesThrown="
                .. tostring(selected == record)
                .. " newestFirst="
                .. tostring(newestFirst)
                .. " authoritativeCount="
                .. tostring(InventoryService.GetCarryCount(player))
        )
    end
    local object = releaseHeld(player, true, nil, table.find(held[player], record))
    if object and record.ItemType == "Ingredient" then
        GameplaySfx.Emit("IngredientThrow", (object :: any):GetPivot().Position)
    end
    IngredientThrow.Trace(
        player,
        if object
            then "published world item; carryCount=" .. tostring(InventoryService.GetCarryCount(player))
            else "rejected: release/spawn failed; inventory retained"
    )
    return object
end

-- Private synchronous equip path shared by loose pickup and stash withdrawal.
-- onCommitted fires the instant the reservation enters the authoritative held
-- stack, before Tool parenting/EquipTool presentation work runs.
local function equipVisual(
    player: Player,
    id: string?,
    visual: Instance,
    smoothie: Types.SmoothieData?,
    onCommitted: (() -> ())?,
    announcementOwnership: Types.AnnouncementOwnership?,
    ingredientItem: Types.IngredientItem?,
    allowOverfill: boolean?
): boolean
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if
        (not allowOverfill and InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player))
        or not backpack
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
    then
        visual:Destroy()
        return false
    end
    local stack: { HeldItem } = held[player] or {}
    local tool = if smoothie then visual :: Tool else Instance.new("Tool")
    nextCarryItemId += 1
    if smoothie then
        tool.Name = "Smoothie"
    else
        local definition = deps.IngredientService.GetDefinition(id)
        tool.Name = IngredientName.Resolve(
            id :: string,
            definition.DisplayName or (id :: string),
            ingredientItem and ingredientItem.SourceUserId,
            ingredientItem and ingredientItem.SourceDisplayName
        )
        if ingredientItem then
            Item.ApplySourceMetadata(tool, ingredientItem)
            Item.ApplySourceMetadata(visual, ingredientItem)
        end
        tool:SetAttribute("IngredientId", id)
        tool:SetAttribute("CarryItemId", nextCarryItemId)
        tool:SetAttribute("ItemType", "Ingredient")
    end
    tool.CanBeDropped = false
    tool.RequiresHandle = smoothie ~= nil
    local height = 0
    for _, item in stack do
        if item.ItemType == "Ingredient" then
            height += item.Height
        end
    end
    local clearVisual: () -> () = function() end
    local itemHeight = 0
    local shiftDown: ((number) -> ())? = nil
    local visualHost = if smoothie then nil else Instance.new("Model")
    if visualHost then
        visualHost.Name = "IngredientCarryVisuals"
        visualHost:SetAttribute("CarryItemId", nextCarryItemId)
        visualHost.Parent = root.Parent
        local _visualOffset
        _visualOffset, clearVisual, itemHeight, shiftDown = CarryPresentation.Attach(visual, visualHost, root, height)
    end
    local reservation: HeldItem = {
        AnnouncementOwnership = announcementOwnership,
        Item = ingredientItem,
        VisualHost = visualHost,
        Tool = tool,
        CarryItemId = nextCarryItemId,
        Id = id,
        ItemType = if smoothie then "Smoothie" else "Ingredient",
        Smoothie = if smoothie then SmoothieItem.Copy(smoothie) else nil,
        Root = root,
        ClearVisual = clearVisual,
        Height = itemHeight,
        ShiftDown = shiftDown,
        Releasing = false,
        Destroying = false,
        Connections = {},
    }
    table.insert(stack, reservation)
    held[player] = stack
    syncHeld(player)
    if onCommitted then
        onCommitted()
    end
    local function ownsTool(): boolean
        local current: { HeldItem } = held[player] or {}
        for _, item in current do
            if item.Tool == tool then
                return true
            end
        end
        return false
    end
    local function cleanupThisTool()
        if ownsTool() then
            InventoryService.CleanupCharacter(player)
        end
    end
    table.insert(
        reservation.Connections,
        tool.Equipped:Connect(function()
            syncHeld(player)
        end)
    )
    table.insert(
        reservation.Connections,
        tool.Unequipped:Connect(function()
            if not ownsTool() then
                return
            end
            -- Selection changes never transfer ownership or remove overhead visuals.
            syncHeld(player)
        end)
    )
    table.insert(reservation.Connections, humanoid.Died:Connect(cleanupThisTool))
    table.insert(reservation.Connections, player.CharacterRemoving:Connect(cleanupThisTool))
    table.insert(
        reservation.Connections,
        tool.Destroying:Connect(function()
            local current = held[player] or {}
            for index = #current, 1, -1 do
                local item = current[index]
                if item.Tool == tool then
                    item.Destroying = true
                    releaseHeld(player, false, nil, index)
                end
            end
        end)
    )
    tool.Parent = backpack
    local equipped = pcall(equipTool, player, humanoid, tool)
    if not equipped or tool.Parent ~= player.Character then
        -- Suppress automatic re-equip while removing a failed reservation.
        switching[player] = true
        local failedIndex = table.find(held[player] or {}, reservation)
        if failedIndex then
            removeAt(player, failedIndex)
        end
        switching[player] = nil
        return false
    end
    if id and not smoothie and deps.DiscoveryService and not preparedGrants[player] then
        deps.DiscoveryService.DiscoverIngredient(player, id)
    end
    return true
end

function InventoryService.GrantSmoothie(player: Player, data: Types.SmoothieData): boolean
    if
        not MovementService.CanPerformGameplayAction(player)
        or not carried[player]
        or not SmoothieItem.Valid(data)
        or InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player)
    then
        return false
    end
    local visual = SmoothieGeometry.CreateTool(data)
    return visual ~= nil and equipVisual(player, nil, visual, data)
end

-- Server-only direct reward path. Use the same item identity, geometry and held
-- stack as a world pickup, without publishing an unclaimed object to Workspace.
function InventoryService.GrantIngredient(player: Player, id: string, allowOverfill: boolean?): boolean
    if
        not MovementService.CanPerformGameplayAction(player)
        or not carried[player]
        or not deps.IngredientService.GetDefinition(id)
        or (not allowOverfill and InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player))
    then
        return false
    end
    local prepared = preparedGrants[player]
    local visual = if prepared then table.remove(prepared[id]) else deps.IngredientService.CreateVisual(id)
    if not visual then
        return false
    end
    local item = Item.New(id, game:GetService("HttpService"):GenerateGUID(false), "Unknown")
    return equipVisual(player, id, visual, nil, nil, nil, item, allowOverfill)
end

-- Validates all non-capacity conditions and builds every visual before the
-- caller commits a pickup. The returned one-shot transaction never yields.
function InventoryService.PrepareIngredientReward(player: Player, ids: { string }): (() -> boolean)?
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if
        not MovementService.CanPerformGameplayAction(player)
        or not carried[player]
        or not player:FindFirstChildOfClass("Backpack")
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
        or preparedGrants[player]
    then
        return nil
    end
    local visuals: { [string]: { Instance } } = {}
    local function dispose()
        for _, list in visuals do
            for _, visual in list do
                visual:Destroy()
            end
        end
    end
    for _, id in ids do
        -- Lucky rewards require authored art. Ordinary grants retain their
        -- existing geometry behavior, including its legacy fallback path.
        local templates = game:GetService("ServerStorage"):FindFirstChild("Ingredients")
        local template = templates and templates:FindFirstChild(id)
        if
            not deps.IngredientService.GetDefinition(id)
            or not template
            or not (template:IsA("Model") or template:IsA("BasePart"))
            or not template.Archivable
            or not WorldUtil.Part(template)
        then
            dispose()
            return nil
        end
        local ok, visual = pcall(deps.IngredientService.CreateVisual, id)
        if not ok or not visual then
            dispose()
            return nil
        end
        visuals[id] = visuals[id] or {}
        table.insert(visuals[id], visual)
    end
    local used = false
    return function(): boolean
        if used then
            return false
        end
        used = true
        local equipped = selectedItem(player)
        local previous: { [HeldItem]: boolean } = {}
        local existing: { HeldItem } = held[player] or {}
        for _, record in existing do
            previous[record] = true
        end
        preparedGrants[player] = visuals
        local ok, granted = pcall(function(): boolean
            for _, id in ids do
                if not InventoryService.GrantIngredient(player, id, true) then
                    return false
                end
            end
            return true
        end)
        if not ok or not granted then
            switching[player] = true
            local stack = held[player] or {}
            for index = #stack, 1, -1 do
                if not previous[stack[index]] then
                    removeAt(player, index)
                end
            end
            switching[player] = nil
            if equipped and previous[equipped] and equipped.Tool.Parent then
                pcall(equipTool, player, humanoid :: Humanoid, equipped.Tool)
            end
        end
        preparedGrants[player] = nil
        dispose()
        if not ok or not granted then
            return false
        end
        if deps.DiscoveryService then
            for _, id in ids do
                -- Notification failure cannot turn an already committed grant into a retry.
                local discovered, problem = pcall(deps.DiscoveryService.DiscoverIngredient, player, id)
                if not discovered then
                    warn("[LuckyBlock] Discovery notification failed: " .. tostring(problem))
                end
            end
        end
        return true
    end
end

-- Separate loose smoothie path; replicated contents never enter this transaction.
function InventoryService.CarryWorldSmoothie(player: Player, object: Instance): boolean
    if not MovementService.CanPerformGameplayAction(player) then
        return false
    end
    if not WorldUtil.Near(player, object, Economy.InteractionDistance) then
        return false
    end
    return deps.SmoothieWorldItemService.Claim(object, function(data)
        return InventoryService.GrantSmoothie(player, data)
    end)
end

-- The equipped Tool selects its server-owned reservation; attributes never authorize contents.
function InventoryService.GetHeldSmoothie(player: Player, requested: Instance?): Types.SmoothieData?
    if not MovementService.CanPerformGameplayAction(player) then
        return nil
    end
    local record = selectedItem(player)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not record
        or record.ItemType ~= "Smoothie"
        or not record.Smoothie
        or record.Releasing
        or record.Destroying
        or record.Tool.Parent ~= player.Character
        or not humanoid
        or humanoid.Health <= 0
        or (requested ~= nil and requested ~= record.Tool)
    then
        return nil
    end
    return SmoothieItem.Copy(record.Smoothie)
end

function InventoryService.ConsumeHeldSmoothie(player: Player): Types.SmoothieData?
    local record = selectedItem(player)
    local data = InventoryService.GetHeldSmoothie(player)
    if data and record then
        removeAt(player, table.find(held[player], record))
    end
    return data
end

-- Reserve/consume privately so failed carry equips cannot unlock a discovery.
local claimWorldItem: (Player, Instance) -> boolean

function InventoryService.CarryWorldItem(player: Player, object: Instance): boolean
    if not MovementService.CanPerformGameplayAction(player) then
        return false
    end
    local record = getLoosePickupRecord(player, object)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if
        InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player)
        or not record
        or not backpack
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
    then
        return false
    end
    -- This claim-to-reservation transaction must not yield. Consume removes the server
    -- identity before another request can claim it; only the visual is cloned for carry.
    local pickupPart = WorldUtil.Part(object)
    local pickupPosition = if pickupPart then pickupPart.Position else nil
    local ownership = if deps.AnnouncementService then deps.AnnouncementService.GetOwnership(object) else nil
    local visual = object:Clone()
    if not claimWorldItem(player, object) then
        visual:Destroy()
        return false
    end
    InventoryService.RemoveUnit(player, record.Id)
    local equipped = equipVisual(player, record.Id, visual, nil, function()
        if pickupPosition then
            GameplaySfx.Emit("IngredientPickup", pickupPosition)
        end
    end, ownership, record.Item)
    if equipped and deps.AnnouncementService then
        deps.AnnouncementService.Acquired(player, ownership)
    end
    return equipped
end

local ripenessConnection: RBXScriptConnection? = nil
function InventoryService.Init(services)
    deps = services
    local events = Shared.Events
    if events and not events:FindFirstChild("StashAction") then
        local remote = Instance.new("RemoteFunction")
        remote.Name = "StashAction"
        remote.OnServerInvoke = InventoryService.RequestStash
        remote.Parent = events
    end
    if ripenessConnection then
        ripenessConnection:Disconnect()
    end
    local elapsed = 0
    ripenessConnection = game:GetService("RunService").Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 1 then
            return
        end
        elapsed = 0
        local now = workspace:GetServerTimeNow()
        for owner, slots in stashes do
            local changed = false
            for _, slot in slots do
                for _, unit in slot.Ingredients do
                    if not unit.IsRipe and Item.IsRipe(unit, now) then
                        Item.Resolve(unit, now)
                        changed = true
                    end
                end
            end
            if changed then
                stashChanged:Fire(owner)
            end
        end
    end)
end
local function refreshSlotMetadata(slot: Types.StashSlot, part: BasePart?)
    slot.Protected = part ~= nil and StashSlots.IsProtected(part, slot.SlotIndex)
    slot.Capacity = if slot.ItemType == "Smoothie" then 1 else ingredientSlotCapacity()
end
local function refreshStashMetadata(player: Player)
    local plot = deps.TycoonService.GetPlot(player)
    local fixtures = if plot then deps.TycoonService.GetFixtures(plot, "PlayerStash") else {}
    local parts = if plot
            and #fixtures == 1
            and deps.TycoonService.GetOwner(fixtures[1]) == player
        then StashSlots.Resolve(fixtures[1], StashSlots.Expansion(plot))
        else {}
    local slots: { [number]: Types.StashSlot } = stashes[player] or {}
    for index, slot in slots do
        refreshSlotMetadata(slot, parts[index])
    end
end
local function ensureStash(player: Player)
    if stashes[player] then
        refreshStashMetadata(player)
        return
    end
    stashes[player] = {}
    for index = 1, Upgrades.SecondStorage[2].Value do
        stashes[player][index] = {
            SlotIndex = index,
            Ingredients = {},
            Count = 0,
            Capacity = ingredientSlotCapacity(),
            Protected = false,
        }
    end
    refreshStashMetadata(player)
end
function InventoryService.AddPlayer(player: Player)
    if carried[player] then
        return
    end
    player:SetAttribute("RipenessTutorialShown", false)
    carried[player] = {}
    syncHeld(player)
    ensureStash(player)
    stashChanged:Fire(player)
end
-- Membership publication runs before departing-player cleanup. Transfer the same
-- authoritative stash, including withdrawals, to the promoted session owner.
function InventoryService.BindPlayer(player: Player)
    local id = deps.TycoonService.GetSessionId(player)
    local previous = if id then starterSessions[id] else nil
    if not id or not previous or previous == player or deps.TycoonService.GetSessionOwner(id) ~= player then
        return
    end
    stashes[player], stashes[previous] = stashes[previous], nil
    starterSessions[id] = player
    stashChanged:Fire(player)
end
function InventoryService.GetStackCap(player: Player): number
    return Upgrades.StackSize[deps.PlayerDataService.GetUpgrade(player, "StackSize")].Value
end
function InventoryService.GetStashLayout(player: Player)
    refreshStashMetadata(player)
    local tier = if deps.TycoonService.GetUpgrade then deps.TycoonService.GetUpgrade(player, "SecondStorage") else 1
    local protected = 0
    local slots: { [number]: Types.StashSlot } = stashes[player] or {}
    for index, slot in slots do
        if index <= Upgrades.SecondStorage[tier].Value and slot.Protected then
            protected += 1
        end
    end
    return { Slots = Upgrades.SecondStorage[tier].Value, Protected = protected }
end
function InventoryService.GetHeldIngredientId(player: Player, newestFirst: boolean?): string?
    local record = resolveActionItem(player, nil, newestFirst)
    return if record and record.ItemType == "Ingredient" and not record.Releasing then record.Id else nil
end
function InventoryService.HasCarriedIngredient(player: Player): boolean
    local stack: { HeldItem } = held[player] or {}
    for _, record in stack do
        if
            record.ItemType == "Ingredient"
            and not record.Releasing
            and not record.Destroying
            and record.Tool.Parent
        then
            return true
        end
    end
    return false
end
function InventoryService.GetCarriedIngredientIds(player: Player): { string }
    local ids: { string } = {}
    local stack: { HeldItem } = held[player] or {}
    for _, record in stack do
        if
            record.ItemType == "Ingredient"
            and not record.Releasing
            and not record.Destroying
            and record.Tool.Parent
        then
            table.insert(ids, record.Id :: string)
        end
    end
    return ids
end
-- Copies of owned cups, including stored cups, for server guidance reconciliation.
function InventoryService.GetSmoothieInventory(player: Player): { any }
    local result = {}
    local stack: { HeldItem } = held[player] or {}
    for _, record in stack do
        if record.Smoothie and not record.Releasing and not record.Destroying and record.Tool.Parent then
            table.insert(result, { Data = SmoothieItem.Copy(record.Smoothie) })
        end
    end
    local plot = deps.TycoonService.GetPlot(player)
    local owner = if plot then deps.TycoonService.GetOwner(plot) else nil
    local stash: { [number]: Types.StashSlot } = (if owner then stashes[owner] else nil) or {}
    for index, slot in stash do
        if slot.Smoothie then
            table.insert(result, { Data = SmoothieItem.Copy(slot.Smoothie), Slot = index })
        end
    end
    return result
end
-- Guide-only query. In-flight throws never count as accepted blender ingredients.
function InventoryService.HasIngredientInFlight(player: Player): boolean
    local pending = thrownIngredients[player]
    if not pending then
        return false
    end
    for index = #pending, 1, -1 do
        local entry = pending[index]
        local part = WorldUtil.Part(entry.Object)
        local settled = os.clock() >= entry.ObserveAfter and (not part or part.AssemblyLinearVelocity.Magnitude < 1)
        if
            entry.SessionId ~= deps.TycoonService.GetSessionId(player)
            or settled
            or not deps.IngredientService.GetRecord(entry.Object)
        then
            table.remove(pending, index)
        end
    end
    return #pending > 0
end
-- Called only for a newly created authoritative plot session, never from a client.
function InventoryService.InitializeTutorialStash(player: Player): (boolean, string?)
    local id = deps.TycoonService.GetSessionId(player)
    if not id or deps.TycoonService.GetSessionOwner(id) ~= player then
        return false, "NotSessionOwner"
    end
    if starterSessions[id] then
        return true
    end
    ensureStash(player)
    local stash = stashes[player]
    -- Prepare everything before touching live slots or recording success. No yield
    -- occurs here; a failed preparation leaves legitimate stash contents intact.
    local prepared: { [number]: { Types.IngredientItem } } = {}
    local now = workspace:GetServerTimeNow()
    local ok, problem = pcall(function()
        for _, order in TutorialOrders do
            local slot = stash[order.Slot]
            if not slot or slot.Count ~= 0 or #slot.Ingredients > 0 or slot.Smoothie then
                error("StarterSlotUnavailable slot=" .. tostring(order.Slot))
            end
            if #order.Ingredients > ingredientSlotCapacity() then
                error("StarterSlotCapacity slot=" .. tostring(order.Slot))
            end
            local units: { Types.IngredientItem } = {}
            for _, ingredientId in order.Ingredients do
                if not deps.IngredientService.GetDefinition(ingredientId) then
                    error("InvalidIngredient id=" .. ingredientId)
                end
                local unit = Item.New(ingredientId, game:GetService("HttpService"):GenerateGUID(false), "Unknown")
                Item.EnterStash(unit, now)
                table.insert(units, unit)
            end
            prepared[order.Slot] = units
        end
    end)
    if not ok then
        warn("[TutorialInit] SeedFailed session=" .. id .. " reason=" .. tostring(problem))
        return false, tostring(problem)
    end
    for index, units in prepared do
        local slot = stash[index]
        slot.Ingredients = units
        slot.ItemType, slot.Count, slot.Capacity = "Ingredient", #units, ingredientSlotCapacity()
        slot.IngredientId = units[#units].IngredientId
    end
    starterSessions[id] = player
    stashChanged:Fire(player)
    return true
end
-- Server-only consumption of the same selected/fallback carry record as throw.
-- Remove the reservation before destroying its Tool so reentrant actions cannot
-- consume it twice. Attributes and caller-provided ingredient IDs grant no rights.
function InventoryService.ConsumeHeldIngredient(player: Player, expectedId: string, newestFirst: boolean?): string?
    local record = resolveActionItem(player, nil, newestFirst)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not MovementService.CanPerformGameplayAction(player)
        or not humanoid
        or humanoid.Health <= 0
        or not record
        or record.ItemType ~= "Ingredient"
        or record.Id ~= expectedId
        or not record.Tool.Parent
        or (record.Tool.Parent ~= player.Character and record.Tool.Parent ~= backpack)
        or not record.Root.Parent
    then
        return nil
    end
    record.Releasing = true
    removeAt(player, table.find(held[player], record))
    return record.Id
end
-- Deadlines are evaluated on demand; no delayed callback can reach a recycled plot.
function InventoryService.GetStashRaidState(owner: Player)
    local sessionId = deps.TycoonService.GetSessionId(owner)
    local raid = if sessionId then raids[sessionId] else nil
    local now = workspace:GetServerTimeNow()
    return {
        SessionId = sessionId,
        State = if not raid or now >= raid.ProtectionEndsAt
            then "Normal"
            elseif now < raid.RaidEndsAt then "RaidActive"
            else "Protected",
        RaidEndsAt = if raid then raid.RaidEndsAt else 0,
        ProtectionEndsAt = if raid then raid.ProtectionEndsAt else 0,
    }
end
function InventoryService.CleanupSession(sessionId: string)
    local owner = starterSessions[sessionId]
    starterSessions[sessionId] = nil
    if owner then
        stashes[owner] = nil
        ensureStash(owner)
        stashChanged:Fire(owner)
    end
    for player, pending in thrownIngredients do
        for index = #pending, 1, -1 do
            if pending[index].SessionId == sessionId then
                table.remove(pending, index)
            end
        end
        if #pending == 0 then
            thrownIngredients[player] = nil
        end
    end
    raids[sessionId] = nil
end
function InventoryService.GetSnapshot(player: Player)
    local layout = InventoryService.GetStashLayout(player)
    local stash = {}
    local promoted = false
    local now = workspace:GetServerTimeNow()
    local source = stashes[player]
    if source then
        for index, stack in source do
            if index > layout.Slots then
                continue
            end
            for _, item in stack.Ingredients do
                if not item.IsRipe and Item.IsRipe(item, now) then
                    Item.Resolve(item, now)
                    promoted = true
                end
            end
            stash[index] = table.clone(stack)
            stash[index].Value = StashValue.Calculate(stack)
            stash[index].Ingredients = {}
            for _, item in stack.Ingredients do
                Item.Resolve(item, workspace:GetServerTimeNow())
                local copy = table.clone(item)
                copy.AnnouncementOwnership = nil
                table.insert(stash[index].Ingredients, copy)
            end
            if stack.Smoothie then
                stash[index].Smoothie = SmoothieItem.Copy(stack.Smoothie)
            end
        end
    end
    if promoted then
        stashChanged:Fire(player)
    end
    local counts = {}
    local reservations: { [string]: { Types.IngredientItem } } = carried[player] or {}
    for id, units in reservations do
        counts[id] = #units
    end
    return {
        Carried = counts,
        Stash = stash,
        Layout = InventoryService.GetStashLayout(player),
    }
end
local function reserveUnit(player: Player, id: string, item: Types.IngredientItem?): boolean
    if not carried[player] or not deps.IngredientService.GetDefinition(id) then
        return false
    end
    local units = carried[player][id] or {}
    local count = #units
    if count >= InventoryService.GetStackCap(player) then
        return false
    end
    table.insert(units, item or Item.New(id, game:GetService("HttpService"):GenerateGUID(false), "Unknown"))
    carried[player][id] = units
    return true
end
function InventoryService.AddUnit(player: Player, id: string): boolean
    if not reserveUnit(player, id) then
        return false
    end
    if deps.DiscoveryService then
        deps.DiscoveryService.DiscoverIngredient(player, id)
    end
    return true
end
function InventoryService.RemoveUnit(player: Player, id: string): (boolean, Types.IngredientItem?)
    local units = carried[player] and carried[player][id]
    if not units or #units == 0 then
        return false, nil
    end
    local unit = table.remove(units)
    if #units == 0 then
        carried[player][id] = nil
    end
    return true, unit
end
claimWorldItem = function(player: Player, object: Instance): boolean
    if not MovementService.CanPerformGameplayAction(player) then
        return false
    end
    local record = getLoosePickupRecord(player, object)
    if not record then
        return false
    end
    if not reserveUnit(player, record.Id, record.Item) then
        return false
    end
    if not deps.IngredientService.Consume(object, true) then
        InventoryService.RemoveUnit(player, record.Id)
        return false
    end
    return true
end
function InventoryService.ClaimWorldItem(player: Player, object: Instance): boolean
    local record = getLoosePickupRecord(player, object)
    if not record or not claimWorldItem(player, object) then
        return false
    end
    if deps.DiscoveryService then
        deps.DiscoveryService.DiscoverIngredient(player, record.Id)
    end
    return true
end
-- Materialize ONE reserved unit. Caller cannot supply a spawn position or contents.
function InventoryService.ReleaseUnit(player: Player, id: string): Instance?
    if not MovementService.CanPerformGameplayAction(player) then
        return nil
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local now = os.clock()
    if
        not root
        or not root:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0
        or now < (releaseAt[player] or 0)
    then
        return nil
    end
    local removed, unit = InventoryService.RemoveUnit(player, id)
    if not removed then
        return nil
    end
    releaseAt[player] = now + 0.25
    local object = deps.IngredientService.Spawn(id, root.CFrame * CFrame.new(0, 2, -3), player, nil, { Item = unit })
    if not object then
        reserveUnit(player, id, unit)
    end
    local part = WorldUtil.Part(object)
    if part then
        part.AssemblyLinearVelocity = root.CFrame.LookVector * 25 + Vector3.new(0, 18, 0)
    end
    return object
end
function InventoryService.DropOne(player: Player): Instance?
    if topItem(player) then
        return InventoryService.DropHeld(player)
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then
        return nil
    end
    local id = next(carried[player] or {})
    if not id then
        return nil
    end
    local _, unit = InventoryService.RemoveUnit(player, id)
    local object = deps.IngredientService.Spawn(id, root.CFrame * CFrame.new(0, 1, -3), nil, nil, { Item = unit })
    if not object then
        reserveUnit(player, id, unit)
    end
    return object
end
-- Resolve the unique server-tagged fixture and actual slot, never a client position.
local function getSlotPart(owner: Player, index: number): BasePart?
    if
        type(index) ~= "number"
        or index ~= index
        or index % 1 ~= 0
        or index < 1
        or index > InventoryService.GetStashLayout(owner).Slots
    then
        return nil
    end
    local plot = deps.TycoonService.GetPlot(owner)
    if not plot then
        return nil
    end
    local fixtures = deps.TycoonService.GetFixtures(plot, "PlayerStash")
    if #fixtures ~= 1 or deps.TycoonService.GetOwner(fixtures[1]) ~= owner then
        return nil
    end
    local expansion = StashSlots.Expansion(plot)
    if index > StashConfig.Slots and (not expansion or expansion:GetAttribute("StashExpansionReady") ~= true) then
        return nil
    end
    local part = StashSlots.Resolve(fixtures[1], expansion)[index]
    local slot = stashes[owner] and stashes[owner][index]
    if slot then
        refreshSlotMetadata(slot, part)
    end
    return part
end
local function accessible(player: Player, owner: Player, index: number): boolean
    if not MovementService.CanPerformGameplayAction(player) then
        return false
    end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil
        and humanoid.Health > 0
        and WorldUtil.Near(player, getSlotPart(owner, index), Economy.InteractionDistance)
end
local function friendly(player: Player, owner: Player): boolean
    local plot = deps.TycoonService.GetPlot(owner)
    return plot ~= nil and deps.TycoonService.GetOwner(plot) == owner and deps.TycoonService.GetPlot(player) == plot
end
function InventoryService.CanWithdraw(player: Player, owner: Player, index: number): boolean
    local slot = stashes[owner] and stashes[owner][index]
    if not slot or not getSlotPart(owner, index) or not deps.TycoonService.GetPlot(player) then
        return false
    end
    if friendly(player, owner) then
        return true
    end
    local plot = deps.TycoonService.GetPlot(owner)
    if plot and deps.LockBaseService and deps.LockBaseService.IsLocked(plot) then
        return false
    end
    return not slot.Protected and InventoryService.GetStashRaidState(owner).State ~= "Protected"
end
local function heldKey(record: HeldItem): string?
    return if record.Smoothie then record.Smoothie.BlendId else record.Id
end
local function clearSlot(slot: Types.StashSlot)
    slot.ItemType, slot.IngredientId, slot.Smoothie = nil, nil, nil
    slot.Ingredients = {}
    slot.Count, slot.Capacity = 0, ingredientSlotCapacity()
end
-- Server-only NPC theft. Caller holds the plot transaction and claims
-- its one theft attempt before entering. Never transfers the unit to another inventory.
function InventoryService.RemoveThiefIngredient(
    owner: Player,
    sessionId: string,
    committed: ((Types.IngredientItem) -> ())?
): Types.IngredientItem?
    local plot = deps.TycoonService.GetPlot(owner)
    if
        not plot
        or deps.TycoonService.GetOwner(plot) ~= owner
        or deps.TycoonService.GetSessionId(owner) ~= sessionId
        or InventoryService.GetStashRaidState(owner).State == "Protected"
    then
        return nil
    end
    local candidates: { { Slot: Types.StashSlot, UnitIndex: number } } = {}
    refreshStashMetadata(owner)
    local slots: { [number]: Types.StashSlot } = stashes[owner] or {}
    for index, slot in slots do
        if not slot.Protected and slot.ItemType == "Ingredient" and getSlotPart(owner, index) then
            for unitIndex in slot.Ingredients do
                table.insert(candidates, { Slot = slot, UnitIndex = unitIndex })
            end
        end
    end
    if #candidates == 0 then
        return nil
    end
    local chosen = candidates[math.random(1, #candidates)]
    local slot = chosen.Slot
    -- No yield or presentation event between selection and removal: this is commit.
    local unit = assert(table.remove(slot.Ingredients, chosen.UnitIndex))
    Item.ExitStash(unit, workspace:GetServerTimeNow())
    slot.Count = #slot.Ingredients
    if slot.Count == 0 then
        clearSlot(slot)
    else
        slot.IngredientId = slot.Ingredients[1].IngredientId
    end
    -- Transfer the exact unit before Immediate stash listeners can reject/destroy
    -- the thief. This callback must not yield or publish presentation.
    if committed then
        committed(unit)
    end
    stashChanged:Fire(owner)
    return unit
end

-- The caller relinquishes its exclusive thief reservation before publishing.
-- This uses the same registry, pickup and cleanup path as ordinary held drops.
function InventoryService.ReleaseThiefIngredient(item: Types.IngredientItem, at: CFrame): Instance?
    local object = deps.IngredientService.Spawn(item.IngredientId, at, nil, true, { Item = item })
    if object and deps.AnnouncementService then
        deps.AnnouncementService.TrackWorld(object, item.AnnouncementOwnership)
    end
    return object
end
local function depositSelected(player: Player, itemType: string, key: string, index: number, owner: Player): boolean
    local record = resolveActionItem(player)
    if
        not record
        or record.Releasing
        or record.Destroying
        or record.ItemType ~= itemType
        or heldKey(record) ~= key
        or not friendly(player, owner)
        or not accessible(player, owner, index)
    then
        return false
    end
    local slot = stashes[owner] and stashes[owner][index]
    if not slot then
        return false
    end
    if record.ItemType == "Smoothie" then
        if slot.Count ~= 0 or not record.Smoothie then
            return false
        end
        slot.IngredientId = nil
        slot.Smoothie = SmoothieItem.Copy(record.Smoothie)
        slot.Count, slot.Capacity = 1, 1
    else
        local capacity = ingredientSlotCapacity()
        if slot.Count >= capacity or (slot.Count > 0 and slot.ItemType ~= "Ingredient") then
            return false
        end
        slot.Smoothie = nil
        local unit = assert(record.Item)
        unit.AnnouncementOwnership = record.AnnouncementOwnership
        Item.EnterStash(unit, workspace:GetServerTimeNow())
        table.insert(slot.Ingredients, unit)
        slot.IngredientId = record.Id
        slot.Count += 1
        slot.Capacity = capacity
    end
    slot.ItemType = record.ItemType
    if record.ItemType == "Ingredient" and player:GetAttribute("RipenessTutorialShown") ~= true then
        player:SetAttribute("RipenessTutorialShown", true)
    end
    removeAt(player, table.find(held[player], record))
    stashChanged:Fire(owner)
    return true
end
-- Preserve the legacy ingredient-only signature; id is a match assertion.
function InventoryService.Deposit(player: Player, id: string, index: number): boolean
    local plot = deps.TycoonService.GetPlot(player)
    local owner = if plot then deps.TycoonService.GetOwner(plot) else nil
    return owner ~= nil and depositSelected(player, "Ingredient", id, index, owner)
end
function InventoryService.Withdraw(player: Player, index: number, stashOwner: Player?): boolean
    local owner = stashOwner or player
    if
        InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player)
        or not InventoryService.CanWithdraw(player, owner, index)
        or not accessible(player, owner, index)
    then
        return false
    end
    local slot = stashes[owner][index]
    local now = workspace:GetServerTimeNow()
    local unitIndex = 1
    for i, candidate in slot.Ingredients do
        Item.Resolve(candidate, now)
        if
            Item.GetStoredRipenessSeconds(candidate, now)
            > Item.GetStoredRipenessSeconds(slot.Ingredients[unitIndex], now)
        then
            unitIndex = i
        end
    end
    local unit = slot.Ingredients[unitIndex]
    local id = if unit then unit.IngredientId else slot.IngredientId
    local smoothie = if slot.Smoothie then SmoothieItem.Copy(slot.Smoothie) else nil
    if slot.Count < 1 or (not id and not smoothie) then
        return false
    end
    local visual = if smoothie
        then SmoothieGeometry.CreateTool(smoothie)
        else deps.IngredientService.CreateVisual(id, unit)
    if not visual then
        return false
    end
    -- Recheck after visual creation and immediately before the slot reservation.
    -- A rejected TAKE leaves the exact stored units and held inventory untouched.
    if not InventoryService.CanWithdraw(player, owner, index) then
        visual:Destroy()
        return false
    end
    -- Synchronous reservation; restore the exact record list on failed equip.
    local ownership = if unit then unit.AnnouncementOwnership else nil
    local previous = table.clone(slot)
    slot.Ingredients = table.clone(slot.Ingredients)
    if not smoothie then
        table.remove(slot.Ingredients, unitIndex)
    end
    slot.Count -= 1
    if slot.Count == 0 then
        clearSlot(slot)
    else
        slot.IngredientId = slot.Ingredients[#slot.Ingredients].IngredientId
    end
    local taken = if unit then table.clone(unit) else nil
    if taken then
        Item.ExitStash(taken, now)
    end
    if not equipVisual(player, id, visual, smoothie, nil, ownership, taken) then
        stashes[owner][index] = previous
        return false
    end
    if deps.AnnouncementService then
        deps.AnnouncementService.Acquired(player, ownership)
    end
    if not friendly(player, owner) then
        local state = InventoryService.GetStashRaidState(owner)
        if state.SessionId and state.State == "Normal" then
            local raidEnd = workspace:GetServerTimeNow() + StashConfig.RaidWindowSeconds
            raids[state.SessionId] = {
                RaidEndsAt = raidEnd,
                ProtectionEndsAt = raidEnd + StashConfig.RaidProtectionSeconds,
            }
        end
    end
    if not smoothie and friendly(player, owner) and deps.TutorialService then
        deps.TutorialService.Mark(player, "TookStashItem")
    end
    stashChanged:Fire(owner)
    return true
end
function InventoryService.Steal(player: Player, owner: Player, index: number): boolean
    return not friendly(player, owner) and InventoryService.Withdraw(player, index, owner)
end
-- Both directions use the existing item ledger and synchronous transfer paths.
function InventoryService.InteractStash(
    player: Player,
    index: number,
    owner: Player?,
    fixture: Instance?,
    action: any
): (boolean, string?)
    if action ~= "STORE" and action ~= "TAKE" then
        return false, "INVALID ACTION!"
    end
    local part = if owner then getSlotPart(owner, index) else nil
    if
        not owner
        or not part
        or not deps.TycoonService.GetSessionId(player)
        or (fixture and part ~= fixture and not part:IsDescendantOf(fixture))
        or not accessible(player, owner, index)
    then
        return false, "UNAVAILABLE!"
    end
    local slot = stashes[owner] and stashes[owner][index]
    if not slot then
        return false, "UNAVAILABLE!"
    end
    if
        (action == "STORE" and not friendly(player, owner))
        or (action == "TAKE" and not InventoryService.CanWithdraw(player, owner, index))
    then
        return false, "PROTECTED!"
    end
    if stashBusy[player] or stashBusy[owner] then
        return false, "PLEASE WAIT!"
    end
    local selected = resolveActionItem(player)
    if action == "STORE" then
        if not selected or not heldKey(selected) then
            return false, "NOTHING TO STORE!"
        end
        if
            slot.Count >= slot.Capacity
            or (slot.Count > 0 and (selected.ItemType == "Smoothie" or slot.ItemType == "Smoothie"))
        then
            return false, "SLOT FULL!"
        end
    else
        if slot.Count == 0 then
            return false, "SLOT EMPTY!"
        end
        if InventoryService.GetCarryCount(player) >= InventoryService.GetCarryCapacity(player) then
            return false, "CARRY FULL!"
        end
    end
    -- Lock actor and target sessions against reentrant transfers and membership changes.
    local transactions = {}
    if deps.TycoonService.BeginTransaction then
        local actors: { Player } = if deps.TycoonService.GetSessionId(player)
                == deps.TycoonService.GetSessionId(owner)
            then { player }
            else { player, owner }
        for _, actor in actors do
            local token = deps.TycoonService.BeginTransaction(actor, deps.TycoonService.GetRequestContext(actor))
            if not token then
                for _, previous in transactions do
                    deps.TycoonService.EndTransaction(previous)
                end
                return false, "PLEASE WAIT!"
            end
            table.insert(transactions, token)
        end
    end
    stashBusy[player], stashBusy[owner] = true, true
    local ok, success = pcall(function()
        if action == "STORE" then
            return depositSelected(player, assert(selected).ItemType, assert(heldKey(assert(selected))), index, owner)
        end
        return InventoryService.Withdraw(player, index, owner)
    end)
    stashBusy[player], stashBusy[owner] = nil, nil
    for _, token in transactions do
        deps.TycoonService.EndTransaction(token)
    end
    if not ok then
        warn("Stash transfer failed: " .. tostring(success))
    end
    return ok and success == true, if ok and success then nil else "UNAVAILABLE!"
end

-- Network requests identify only an authored prompt, explicit action and session revision.
function InventoryService.RequestStash(player: Player, prompt: any, action: any, context: any): (boolean, string?)
    if
        type(context) ~= "table"
        or not deps.TycoonService.ValidateActor(player, context)
        or (action ~= "STORE" and action ~= "TAKE")
        or typeof(prompt) ~= "Instance"
        or not prompt:IsA("ProximityPrompt")
        or not prompt.Enabled
        or not prompt:IsDescendantOf(workspace)
        or prompt.Name ~= "StashPrompt"
        or prompt:GetAttribute("PlayerStashPrompt") ~= true
    then
        return false, "UNAVAILABLE!"
    end
    local part = prompt.Parent
    local owner = if part then deps.TycoonService.GetOwner(part) else nil
    local index = if part then part:GetAttribute("StashLogicalSlotIndex") else nil
    if
        not owner
        or not part
        or part:FindFirstChild("StashPrompt") ~= prompt
        or type(index) ~= "number"
        or getSlotPart(owner, index) ~= part
        or context.TargetSessionId ~= deps.TycoonService.GetSessionId(owner)
    then
        return false, "UNAVAILABLE!"
    end
    local id = context.RequestId
    if type(id) ~= "number" or id ~= id or id % 1 ~= 0 or id < 1 or id > 2 ^ 53 then
        return false, "UNAVAILABLE!"
    end
    local previous = stashRequests[player]
    if previous and id <= previous.Id then
        return false, "PLEASE WAIT!"
    end
    local now = workspace:GetServerTimeNow()
    stashRequests[player] = { Id = id, NextAt = now + 0.06 }
    if previous and now < previous.NextAt then
        return false, "PLEASE WAIT!"
    end
    return InventoryService.InteractStash(player, index, owner, part, action)
end
function InventoryService.RemovePlayer(player: Player)
    thrownIngredients[player] = nil
    stashRequests[player] = nil
    InventoryService.DropHeld(player)
    InventoryService.ClearHeld(player)
    carried[player] = nil
    stashes[player] = nil
    stashChanged:Fire(player)
    releaseAt[player] = nil
end
return require(script.Parent.StudioServices).Wrap("InventoryService", InventoryService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="120">
          <Properties>
            <string name="Name">JackedNoobHitReaction</string>
            <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local Shared = game:GetService("ReplicatedStorage").Shared
local TweenService = game:GetService("TweenService")
local Config = require(Shared.Constants.JackedNoob)
local TextStyle = require(Shared.Constants.DialogueTextStyle)
local Reaction = {}
local current: BillboardGui? = nil
local sound: Sound? = nil
local soundUntil = 0

function Reaction.Clear()
    if current then
        current:Destroy()
        current = nil
    end
    if sound then
        sound:Destroy()
        sound = nil
    end
    soundUntil = 0
end

function Reaction.Play(head: BasePart)
    if current then
        current:Destroy()
    end
    local gui = Instance.new("BillboardGui")
    gui.Name = "JackedNoobHitReaction"
    gui.Adornee = head
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    BillboardStyle.ApplyBillboard(gui, { WidthStuds = 6, HeightStuds = 1.8, MaxDistance = 30, ResetOnSpawn = true })
    gui.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y / 2 + 2.5, 0)
    gui.AlwaysOnTop = true
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = "HEY STOP THAT"
    TextStyle.Apply(label, 27, gui)
    label.TextScaled = true
    label.Parent = gui
    local scale = Instance.new("UIScale")
    scale.Scale = 0.7
    scale.Parent = label
    gui.Parent = head
    current = gui
    TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
        :Play()
    task.delay(Config.HitDialogueSeconds - 0.3, function()
        if current ~= gui or not gui:IsDescendantOf(workspace) then
            return
        end
        local outline = label:FindFirstChild("DialogueOutline") :: UIStroke
        TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
        TweenService:Create(outline, TweenInfo.new(0.3), { Transparency = 1 }):Play()
        task.delay(0.3, function()
            if current == gui then
                current = nil
            end
            gui:Destroy()
        end)
    end)
    if os.clock() >= soundUntil then
        soundUntil = os.clock() + Config.HitReactionCooldownSeconds
        if not sound then
            local created = Instance.new("Sound")
            created.Name = "JackedNoobHurt"
            created.SoundId = Config.HurtSoundId
            created.Volume = Config.HurtSoundVolume
            created.RollOffMinDistance = 10
            created.RollOffMaxDistance = 50
            created.Parent = head
            sound = created
        end
        local playing = sound :: Sound
        playing:Stop()
        playing:Play()
    end
end

return Reaction
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="121">
          <Properties>
            <string name="Name">JackedNoobLogic</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.JackedNoob)
local Logic = {}

export type State = { [Player]: number }

function Logic.TryReward(
    deadlines: State,
    player: Player,
    now: number,
    hasSpace: () -> boolean,
    grant: () -> boolean
): string
    if now < (deadlines[player] or 0) then
        return "Greedy.. Come back later.."
    end
    if not hasSpace() then
        return "Your hands are full, buddy."
    end
    if not grant() then
        return "Can't grab it right now, buddy."
    end
    deadlines[player] = now + Config.ProteinCooldownSeconds
    return "lil bro, you look like you need this."
end

function Logic.LocalTarget(size: Vector3, margin: number, random: Random): Vector3
    local x = math.max(0, size.X / 2 - margin)
    local z = math.max(0, size.Z / 2 - margin)
    return Vector3.new(random:NextNumber(-x, x), 0, random:NextNumber(-z, z))
end

function Logic.ReturnTarget(localPosition: Vector3, size: Vector3, margin: number): Vector3
    local x = math.max(0, size.X / 2 - margin)
    local z = math.max(0, size.Z / 2 - margin)
    return Vector3.new(math.clamp(localPosition.X, -x, x), 0, math.clamp(localPosition.Z, -z, z))
end

return Logic
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="122">
          <Properties>
            <string name="Name">JackedNoobService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Constants.JackedNoob)
local Logic = require(script.Parent.JackedNoobLogic)
local WorldUtil = require(script.Parent.WorldUtil)
local Reaction = require(script.Parent.JackedNoobHitReaction)
local BatConfig = require(ReplicatedStorage.Shared.Constants.BatConfig)
local Knockback = require(script.Parent.BatKnockback)
local RunService = game:GetService("RunService")

local Service = {}
local deadlines: Logic.State = {}
local busy: { [Player]: boolean } = {}
local talkDeadlines: { [Player]: number } = {}
local active: Model? = nil
local template: Model? = nil
local spawn: CFrame? = nil
local response: RemoteEvent
local inventory: any
local deps: any
local hitUntil = 0
local immuneUntil = 0
local random = Random.new()

local function validRig(model: Model): (Humanoid?, BasePart?, BasePart?)
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    local head = model:FindFirstChild("Head")
    if humanoid and root and root:IsA("BasePart") and head and head:IsA("BasePart") then
        return humanoid, root, head
    end
    return nil, nil, nil
end

local function disableLegacy(model: Model)
    for _, name in { "Move", "Respawn" } do
        local old = model:FindFirstChild(name, true)
        if old and (old:IsA("Script") or old:IsA("LocalScript")) then
            old.Disabled = true
        end
    end
end

local bind: (Model) -> ()
bind = function(model: Model)
    if active or model:GetAttribute("NPCId") ~= Config.NPCId then
        return
    end
    local humanoid, root, head = validRig(model)
    local zone = workspace:FindFirstChild("NoobRoam")
    if not humanoid or not root or not head or not zone or not zone:IsA("BasePart") then
        warn("[JackedNoob] Requires a tagged R6 NPC and Workspace.NoobRoam BasePart")
        return
    end
    active = model
    hitUntil, immuneUntil = 0, 0
    Reaction.Clear()
    if not template then
        spawn = model:GetPivot()
        disableLegacy(model)
        model.Archivable = true
        template = model:Clone()
    end
    disableLegacy(model)
    if root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end

    local origin = head:FindFirstChild("JackedNoobTalkOrigin")
    if not origin or not origin:IsA("Attachment") then
        origin = Instance.new("Attachment")
        origin.Name = "JackedNoobTalkOrigin"
        origin.Position = Vector3.new(0, head.Size.Y * 0.55, 0)
        origin.Parent = head
    end
    local prompt = WorldUtil.Prompt(head, "JackedNoobTalk", "TALK")
    prompt.Style = Enum.ProximityPromptStyle.Custom
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.MaxActivationDistance = Config.InteractionDistance
    prompt:SetAttribute("JackedNoobPrompt", true)
    prompt:SetAttribute("InteractionOrigin", origin.Name)
    prompt:SetAttribute("InteractionActionText", "TALK")
    local promptConnection = prompt.Triggered:Connect(function(player: Player)
        if busy[player] or not player:IsDescendantOf(Players) or active ~= model or humanoid.Health <= 0 then
            return
        end
        if not WorldUtil.Near(player, head, Config.InteractionDistance) then
            return
        end
        local now = workspace:GetServerTimeNow()
        if now < (talkDeadlines[player] or 0) then
            return
        end
        talkDeadlines[player] = now + 1
        busy[player] = true
        local ok, line = pcall(Logic.TryReward, deadlines, player, now, function()
            return inventory.GetCarryCount(player) < inventory.GetCarryCapacity(player)
        end, function()
            return inventory.GrantIngredient(player, Config.ProteinIngredientId)
        end)
        busy[player] = nil
        if not ok then
            warn("[JackedNoob] Reward failed: " .. tostring(line))
            line = "Can't grab it right now, buddy."
        end
        response:FireClient(player, head, line)
    end)

    local alive = true
    task.spawn(function()
        while alive and active == model and humanoid.Health > 0 do
            task.wait(random:NextNumber(Config.RoamIdleMinSeconds, Config.RoamIdleMaxSeconds))
            if not alive or active ~= model or humanoid.Health <= 0 then
                break
            end
            if os.clock() < hitUntil then
                continue
            end
            local localPosition = zone.CFrame:PointToObjectSpace(root.Position)
            local halfX = zone.Size.X / 2
            local halfZ = zone.Size.Z / 2
            local outside = math.abs(localPosition.X) > halfX + Config.RoamEdgeMargin
                or math.abs(localPosition.Z) > halfZ + Config.RoamEdgeMargin
            local localTarget = if outside
                then Logic.ReturnTarget(localPosition, zone.Size, Config.RoamEdgeMargin)
                else Logic.LocalTarget(zone.Size, Config.RoamEdgeMargin, random)
            local worldTarget = zone.CFrame:PointToWorldSpace(localTarget)
            humanoid:MoveTo(Vector3.new(worldTarget.X, root.Position.Y, worldTarget.Z))
            humanoid.MoveToFinished:Wait()
        end
    end)

    local removalConnection = model.AncestryChanged:Connect(function()
        if active == model and not model:IsDescendantOf(workspace) then
            alive = false
            active = nil
            promptConnection:Disconnect()
            Reaction.Clear()
        end
    end)

    humanoid.Died:Connect(function()
        if active ~= model then
            return
        end
        alive = false
        removalConnection:Disconnect()
        Reaction.Clear()
        promptConnection:Disconnect()
        prompt:Destroy()
        active = nil
        task.delay(Config.RespawnSeconds, function()
            if active or not template or not spawn then
                return
            end
            model:Destroy()
            local replacement = template:Clone()
            replacement:PivotTo(spawn)
            active = replacement -- Guard DescendantAdded while parenting the clone.
            replacement.Parent = workspace
            active = nil
            bind(replacement)
        end)
    end)
end

-- Only CombatService dispatches Hit after issued-bat geometry and actor validation.
function Service.CanHit(player: Player, model: Model): boolean
    if active ~= model or not model:IsDescendantOf(workspace) or not deps.TycoonService.GetSessionId(player) then
        return false
    end
    local humanoid, root = validRig(model)
    return humanoid ~= nil
        and humanoid.Health > 0
        and root ~= nil
        and not root.Anchored
        and not model:FindFirstChildOfClass("ForceField")
        and os.clock() >= immuneUntil
end

function Service.Hit(player: Player, model: Model, context: { Direction: Vector3, Duration: number }): boolean
    if not Service.CanHit(player, model) then
        return false
    end
    local humanoid, root, head = validRig(model)
    if not humanoid or not root or not head then
        return false
    end
    hitUntil = os.clock() + context.Duration
    immuneUntil = hitUntil + BatConfig.ImmunitySeconds
    -- Authored R6 Noob has no native R15 ragdoll; preserve the existing rig policy.
    if humanoid.RigType == Enum.HumanoidRigType.R15 and deps.RagdollService.PrepareCharacter(model) then
        if deps.RagdollService.SetRagdolled(model, true) then
            RunService.Heartbeat:Once(function()
                if active == model and humanoid.Health > 0 and deps.RagdollService.IsRagdolled(model) then
                    Knockback.Apply(root, context.Direction)
                end
            end)
            task.delay(context.Duration, function()
                if active == model and humanoid.Health > 0 and model:IsDescendantOf(workspace) then
                    deps.RagdollService.SetRagdolled(model, false)
                end
            end)
        end
    end
    Reaction.Play(head)
    return true
end

function Service.Init(services: any)
    deps = services
    inventory = services.InventoryService
    response = Instance.new("RemoteEvent")
    response.Name = "JackedNoobResponse"
    response.Parent = ReplicatedStorage
    Players.PlayerRemoving:Connect(function(player)
        deadlines[player] = nil
        talkDeadlines[player] = nil
        busy[player] = nil
    end)
    workspace.DescendantAdded:Connect(function(object)
        if object:IsA("Model") and object:GetAttribute("NPCId") == Config.NPCId then
            task.defer(bind, object)
        end
    end)
    for _, object in workspace:GetDescendants() do
        if object:IsA("Model") and object:GetAttribute("NPCId") == Config.NPCId then
            bind(object)
            break
        end
    end
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">LockBaseCollision</string>
            <string name="Source"><![CDATA[--!strict
local Helpers = require(script.Parent.PlayerOnlyCollisionService)
local Collision = {}

-- Retain the shared Players/PlayerOnly matrix. Only member character/wall pairs
-- receive exceptions, so members still collide with every OTHER plot's walls.
function Collision.Bind(plot: Instance, walls: { BasePart })
    local members: { [Player]: any } = {}
    local enabled = false
    local api = {}
    for _, wall in walls do
        wall.Transparency = 1
        wall.Anchored = true
        Helpers.SetControlled(wall, false)
    end
    local function remove(player: Player)
        local state = members[player]
        if state then
            for _, connection in state.Connections do
                connection:Disconnect()
            end
            state.Folder:Destroy()
            members[player] = nil
        end
    end
    function api.Refresh(players: { Player })
        for player, state in members do
            if not enabled or not table.find(players, player) or player.Character ~= state.Character then
                remove(player)
            end
        end
        if not enabled then
            return
        end
        for _, player in players do
            local character = player.Character
            if not character or members[player] then
                continue
            end
            local folder = Instance.new("Folder")
            folder.Name = "LockBaseMemberExemptions"
            folder.Parent = plot
            local state: any = { Character = character, Folder = folder, Connections = {}, Parts = {} }
            members[player] = state
            local function add(part: Instance)
                if members[player] ~= state or not part:IsA("BasePart") or state.Parts[part] then
                    return
                end
                local constraints = {}
                for _, wall in walls do
                    local constraint = Instance.new("NoCollisionConstraint")
                    constraint.Part0, constraint.Part1 = wall, part
                    constraint.Parent = folder
                    table.insert(constraints, constraint)
                end
                state.Parts[part] = constraints
            end
            table.insert(state.Connections, character.DescendantAdded:Connect(add))
            table.insert(
                state.Connections,
                character.DescendantRemoving:Connect(function(part)
                    for _, constraint in state.Parts[part] or {} do
                        constraint:Destroy()
                    end
                    state.Parts[part] = nil
                end)
            )
            for _, part in character:GetDescendants() do
                add(part)
            end
        end
    end
    function api.SetLocked(locked: boolean, players: { Player })
        enabled = locked
        -- Exceptions exist before enabling walls. Revocation is synchronous.
        api.Refresh(players)
        for _, wall in walls do
            Helpers.SetControlled(wall, locked)
        end
    end
    function api.Destroy()
        enabled = false
        for _, wall in walls do
            Helpers.ReleaseControlled(wall)
        end
        for player in members do
            remove(player)
        end
    end
    return api
end

return Collision
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="124">
          <Properties>
            <string name="Name">LockBasePresentation</string>
            <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.LockBaseConfig)
local TextStyle = require(Shared.Constants.DialogueTextStyle)
local Presentation = {}

function Presentation.Bind(button: BasePart?, attachment: Attachment?, visual: Model?)
    local connections: { RBXScriptConnection } = {}
    local tween: Tween? = nil
    local pressTween: Tween? = nil
    local revision = 0
    local closed = false
    local active = false
    local parts: { [BasePart]: number } = {}
    local raised = if visual then visual:GetAttribute("LockBaseRaisedPivot") else nil
    if visual and typeof(raised) ~= "CFrame" then
        raised = visual:GetPivot()
        visual:SetAttribute("LockBaseRaisedPivot", raised)
    end
    local depth = 0
    if visual then
        local box, size = visual:GetBoundingBox()
        depth = math.abs(box.RightVector.Y) * size.X
            + math.abs(box.UpVector.Y) * size.Y
            + math.abs(box.LookVector.Y) * size.Z
            + 1
        for _, child in visual:GetDescendants() do
            if child:IsA("BasePart") then
                local transparency = child:GetAttribute("LockBaseAuthoredTransparency")
                if type(transparency) ~= "number" then
                    transparency = child.Transparency
                    child:SetAttribute("LockBaseAuthoredTransparency", transparency)
                end
                parts[child] = transparency :: number
                child.Anchored = true
                child.CanCollide, child.CanTouch, child.CanQuery = false, false, false
            end
        end
    end
    local offset = Instance.new("NumberValue")
    offset.Value = -depth
    local function move()
        if visual and typeof(raised) == "CFrame" then
            visual:PivotTo(raised + Vector3.new(0, offset.Value, 0))
        end
    end
    table.insert(connections, offset.Changed:Connect(move))
    local function visible(enabled: boolean)
        for part, transparency in parts do
            part.Transparency = if enabled then transparency else 1
        end
    end
    move()
    visible(false)

    local display: BillboardGui? = nil
    local label: TextLabel? = nil
    -- Only use the authored Button attachment; never relocate it or synthesize an anchor.
    attachment = if button then button:FindFirstChild("LockAttachment") :: Attachment? else nil
    if attachment and not attachment:IsA("Attachment") then
        attachment = nil
    end
    if attachment then
        local existing = attachment:FindFirstChild("LockBaseDisplay")
        if existing then
            existing:Destroy()
        end
        local gui = Instance.new("BillboardGui")
        gui.Name = "LockBaseDisplay"
        gui.Adornee = attachment
        -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
        BillboardStyle.ApplyBillboard(gui, { WidthStuds = 7.68, HeightStuds = 2.88, MaxDistance = 35 })
        gui.AlwaysOnTop = true
        gui.StudsOffset = Vector3.zero
        gui.StudsOffsetWorldSpace = Vector3.zero
        gui.ResetOnSpawn = false
        gui.Enabled = false
        gui.Parent = attachment
        local text = Instance.new("TextLabel")
        text.Name = "State"
        text.Size = UDim2.fromScale(1, 1)
        text.BackgroundTransparency = 1
        text.TextTransparency = 0
        text.ZIndex = 2
        text.TextXAlignment = Enum.TextXAlignment.Center
        text.TextYAlignment = Enum.TextYAlignment.Center
        TextStyle.Apply(text, 24, gui)
        text.TextScaled = true
        text.TextColor3 = Color3.fromRGB(255, 95, 95)
        text.Parent = gui
        display, label = gui, text
    end
    local buttonOrigin = if button then button:GetAttribute("LockBaseButtonOrigin") else nil
    if button then
        button.Anchored = true
        -- Reject's support ray respects CanCollide. A decorative/noncollidable
        -- authored plate would otherwise always hit BlackBase or the ground.
        button.CanCollide, button.CanQuery, button.CanTouch = true, true, true
    end
    if button and typeof(buttonOrigin) ~= "CFrame" then
        buttonOrigin = button.CFrame
        button:SetAttribute("LockBaseButtonOrigin", buttonOrigin)
    end
    local api = {}
    function api.SetLocked(locked: boolean, immediate: boolean?)
        revision += 1
        local token = revision
        active = locked
        if tween then
            tween:Cancel()
            tween = nil
        end
        if locked then
            visible(true)
        end
        local target = if locked then 0 else -depth
        if immediate then
            offset.Value = target
            move()
            visible(locked)
            return
        end
        local running = TweenService:Create(
            offset,
            TweenInfo.new(
                if locked then Config.LaserRaiseDuration else Config.LaserLowerDuration,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),
            { Value = target }
        )
        -- One bounded completion task per transition; canceled callbacks cannot hide a new lock.
        tween = running
        task.spawn(function()
            running.Completed:Wait()
            if not closed and revision == token and not active then
                visible(false)
            end
        end)
        running:Play()
    end
    function api.Update(occupied: boolean, deadline: number, now: number)
        -- Enabled belongs to each client's distance controller. Occupancy and text replicate.
        if display and display:GetAttribute("LockBaseOccupied") ~= occupied then
            display:SetAttribute("LockBaseOccupied", occupied)
        end
        if label then
            local remaining = math.max(0, math.ceil(deadline - now))
            local text = if remaining > 0
                then string.format("LOCKED\n%d:%02d", math.floor(remaining / 60), remaining % 60)
                else "LOCK BASE"
            if label.Text ~= text then
                label.Text = text
            end
        end
    end
    function api.Press()
        if not button or typeof(buttonOrigin) ~= "CFrame" then
            return
        end
        if pressTween then
            pressTween:Cancel()
        end
        local running = TweenService:Create(
            button,
            TweenInfo.new(Config.ButtonPressDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                CFrame = buttonOrigin + Vector3.new(0, -Config.ButtonPressDepth, 0),
            }
        )
        pressTween = running
        task.spawn(function()
            running.Completed:Wait()
            if not closed and pressTween == running then
                local release = TweenService:Create(
                    button,
                    TweenInfo.new(Config.ButtonReleaseDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                    { CFrame = buttonOrigin }
                )
                pressTween = release
                release:Play()
            end
        end)
        running:Play()
    end
    function api.Destroy()
        closed = true
        revision += 1
        if tween then
            tween:Cancel()
        end
        if pressTween then
            pressTween:Cancel()
        end
        for _, connection in connections do
            connection:Disconnect()
        end
        offset:Destroy()
        if display then
            display:Destroy()
        end
        if button and typeof(buttonOrigin) == "CFrame" then
            button.CFrame = buttonOrigin
        end
        -- Retain absolute authored metadata for safe rebinds after hierarchy changes.
        visible(false)
        if visual and typeof(raised) == "CFrame" then
            visual:PivotTo(raised + Vector3.new(0, -depth, 0))
        end
    end
    return api
end

return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="125">
          <Properties>
            <string name="Name">LockBaseService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.LockBaseConfig)
local FloorButton = require(script.Parent.RejectFloorButton)
local Collision = require(script.Parent.LockBaseCollision)
local Presentation = require(script.Parent.LockBasePresentation)
local Service = {}
local authority: any
local states: { [Instance]: any } = {}
local initialized = false

local function diagnostic(state: any, event: string, player: Player?, accepted: boolean?, reason: string?)
    if workspace:GetAttribute("LockBaseDiagnostics") ~= true then
        return
    end
    print(
        string.format(
            "[LockBase] event=%s plot=%s player=%s member=%s locked=%s remaining=%d accepted=%s reason=%s",
            event,
            state.Plot:GetFullName(),
            if player then player.Name else "-",
            tostring(player ~= nil and authority.IsMember(player, state.Plot)),
            tostring(state.Deadline > workspace:GetServerTimeNow()),
            math.max(0, math.ceil(state.Deadline - workspace:GetServerTimeNow())),
            tostring(accepted),
            reason or "-"
        )
    )
end

-- Keep the lookup shared with the inspector; LockButton may itself be a Part.
function Service.ResolveAssets(plot: Instance): any
    local lock = if plot.Name == "LockBase" then plot else plot:FindFirstChild("LockBase", true)
    local assembly = lock and lock:FindFirstChild("LockButton")
    local button = assembly and assembly:FindFirstChild("Button")
    local attachment = button and button:FindFirstChild("LockAttachment")
    local visual = assembly and assembly:FindFirstChild("Visual")
    return {
        Lock = lock,
        Assembly = assembly,
        Button = if button and button:IsA("BasePart") then button else nil,
        Attachment = if attachment and attachment:IsA("Attachment") then attachment else nil,
        Visual = if visual and visual:IsA("Model") then visual else nil,
    }
end

-- Use Reject's unchanged exact support rule first. Only a sibling support plate
-- gets a fallback, and that still requires a downward hit on Button itself.
function Service.CheckStanding(player: Player, plot: Instance): (boolean, string)
    local assets = if states[plot] and states[plot].Assets then states[plot].Assets else Service.ResolveAssets(plot)
    local button: BasePart? = assets.Button
    if not button or not button:IsDescendantOf(plot) or not button:IsDescendantOf(workspace) then
        return false, "MissingButton"
    end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
        return false, "NoLiveCharacter"
    end
    if root.AssemblyLinearVelocity.Y > 2 then
        return false, "Ascending"
    end
    if FloorButton.IsStanding(player, button) then
        return true, "ButtonSupport"
    end
    local leg = character:FindFirstChild("Left Leg")
    local legHeight = if leg and leg:IsA("BasePart") then leg.Size.Y else 0
    local direction = Vector3.new(0, -(root.Size.Y / 2 + humanoid.HipHeight + legHeight + 0.5), 0)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    params.RespectCanCollide = true
    local hit = workspace:Raycast(root.Position, direction, params)
    if not hit then
        return false, "NoSupport"
    end
    local blackBase = assets.Assembly and assets.Assembly:FindFirstChild("BlackBase")
    local decorative = hit.Instance == assets.Assembly
        or hit.Instance == blackBase
        or (blackBase ~= nil and hit.Instance:IsDescendantOf(blackBase))
    if not decorative then
        return false, "Support=" .. hit.Instance:GetFullName()
    end
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = { button }
    local plate = workspace:Raycast(root.Position, direction, params)
    return plate ~= nil and plate.Instance == button,
        if plate and plate.Instance == button then "ButtonOverSupport" else "OutsideButton"
end

-- Tagged walls can be below LockBase or elsewhere in this plot's Walls hierarchy.
-- An explicit association handles unnamed sibling walls without taking over helpers.
function Service.DiscoverWalls(plot: Instance, lock: Instance?): { BasePart }
    local walls = {}
    local assembly = lock and lock:FindFirstChild("LockButton")
    local visual = assembly and assembly:FindFirstChild("Visual")
    local button = assembly and assembly:FindFirstChild("Button")
    local base = assembly and assembly:FindFirstChild("BlackBase")
    for _, part in CollectionService:GetTagged("PlayerOnlyCollision") do
        if
            not part:IsA("BasePart")
            or not part:IsDescendantOf(plot)
            or part == button
            or part == base
            or part == assembly
            or (base and part:IsDescendantOf(base))
            or (visual and part:IsDescendantOf(visual))
        then
            continue
        end
        local associated = (lock ~= nil and part:IsDescendantOf(lock)) or part:GetAttribute("LockBaseWall") == true
        local ancestor: Instance? = part
        while ancestor and ancestor ~= plot do
            if ancestor.Name == "Walls" or ancestor.Name == "Wall" then
                associated = true
            end
            ancestor = ancestor.Parent
        end
        if associated then
            table.insert(walls, part)
        end
    end
    return walls
end

local function members(state: any): { Player }
    return if state.SessionId then authority.GetMembers(state.SessionId) else {}
end
local function publish(state: any)
    state.Plot:SetAttribute("LockBaseSessionId", state.SessionId)
    state.Plot:SetAttribute("LockBaseLockedUntil", state.Deadline)
    state.Plot:SetAttribute("LockBaseLocked", state.Deadline > workspace:GetServerTimeNow())
end
local function unlock(state: any, immediate: boolean?)
    local wasLocked = state.Deadline > 0
    state.Deadline = 0
    state.NextLockAt = workspace:GetServerTimeNow() + Config.RelockCooldown
    if state.Collision then
        state.Collision.SetLocked(false, {})
    end
    if state.Presentation then
        state.Presentation.SetLocked(false, immediate)
    end
    publish(state)
    if wasLocked then
        diagnostic(state, "unlock", nil, true, if immediate then "LifecycleReset" else "Expired")
    end
end
local function refreshState(state: any)
    local owner = authority.GetOwner(state.Plot)
    local id = if owner then authority.GetSessionId(owner) else nil
    if owner ~= state.Owner or id ~= state.SessionId then
        unlock(state, true)
        state.Owner, state.SessionId = owner, id
        state.Latched = {}
        -- Claim/handoff placement is not a fresh button entry. Every member must
        -- first be observed off the plate before standing can activate security.
        for _, member in members(state) do
            state.Latched[member] = true
        end
        state.NextLockAt = 0
        publish(state)
    end
    if state.Collision then
        state.Collision.Refresh(members(state))
    end
    if state.Presentation then
        state.Presentation.Update(owner ~= nil, state.Deadline, workspace:GetServerTimeNow())
    end
end
local function lockFor(state: any, duration: number): boolean
    refreshState(state)
    local now = workspace:GetServerTimeNow()
    if not state.Owner or state.Deadline > now or now < state.NextLockAt then
        return false
    end
    state.Deadline = now + duration
    if state.Collision then
        state.Collision.SetLocked(true, members(state))
    end
    if state.Presentation then
        state.Presentation.SetLocked(true)
        state.Presentation.Update(true, state.Deadline, now)
    end
    publish(state)
    diagnostic(state, "lock", nil, true, "Manual")
    return true
end

local function bindAssets(state: any)
    local previousVisual = state.Assets and state.Assets.Visual
    if state.TouchConnection then
        state.TouchConnection:Disconnect()
        state.TouchConnection = nil
    end
    if state.TouchEndConnection then
        state.TouchEndConnection:Disconnect()
        state.TouchEndConnection = nil
    end
    state.Contacts = {}
    if state.Collision then
        state.Collision.Destroy()
    end
    if state.Presentation then
        state.Presentation.Destroy()
    end
    local plot = state.Plot
    local assets = Service.ResolveAssets(plot)
    state.Assets = assets
    local lock = assets.Lock
    state.Button = assets.Button
    local origin, model = assets.Attachment, assets.Visual
    local walls = Service.DiscoverWalls(plot, lock)
    local missing = {}
    if not lock then
        table.insert(missing, "LockBase")
    end
    if not state.Button then
        table.insert(missing, "LockButton.Button BasePart")
    end
    if not origin then
        table.insert(missing, "LockAttachment Attachment")
    end
    if not model then
        table.insert(missing, "LockButton.Visual Model")
    end
    if #walls == 0 then
        table.insert(missing, "associated PlayerOnlyCollision walls (under LockBase/Walls, or LockBaseWall=true)")
    end
    if model then
        for _, name in { "Laser", "LaserBase" } do
            local found = model:FindFirstChild(name, true)
            if not found or not found:IsA("BasePart") then
                table.insert(missing, "Visual." .. name .. " BaseParts")
            end
        end
    end
    local missingSummary = table.concat(missing, ", ")
    if missingSummary ~= "" and missingSummary ~= state.Diagnostic then
        warn("[LockBase] " .. plot:GetFullName() .. " missing: " .. missingSummary)
    end
    state.Diagnostic = missingSummary
    -- Hide the authored active geometry before setting up any physical helpers.
    state.Presentation = Presentation.Bind(state.Button, origin, model)
    state.Collision = Collision.Bind(plot, walls)
    state.Collision.SetLocked(state.Deadline > workspace:GetServerTimeNow(), members(state))
    local active = state.Deadline > workspace:GetServerTimeNow()
    state.Presentation.SetLocked(active, not active or previousVisual == model)
    state.Presentation.Update(state.Owner ~= nil, state.Deadline, workspace:GetServerTimeNow())
    state.Dirty = false
    plot:SetAttribute(
        "LockBaseAssetsReady",
        state.Button ~= nil
            and model ~= nil
            and origin ~= nil
            and origin.Parent ~= nil
            and origin.Parent:IsA("BasePart")
            and #walls > 0
    )
    if state.Button then
        local function actor(part: BasePart): Player?
            local ancestor: Instance? = part.Parent
            while ancestor and ancestor ~= workspace do
                if ancestor:IsA("Model") then
                    local player = Players:GetPlayerFromCharacter(ancestor)
                    if player then
                        return player
                    end
                end
                ancestor = ancestor.Parent
            end
            return nil
        end
        state.TouchConnection = state.Button.Touched:Connect(function(part)
            if workspace:GetAttribute("LockBaseDiagnostics") ~= true then
                return
            end
            local player = actor(part)
            if not player then
                return
            end
            local contacts = state.Contacts[player]
            if not contacts then
                contacts = {}
                state.Contacts[player] = contacts
                -- Touch never activates gameplay; standing is checked separately.
                local reason = if not authority.GetOwner(plot)
                    then "Unclaimed"
                    elseif not authority.IsMember(player, plot) then "NotMember"
                    elseif state.Deadline > workspace:GetServerTimeNow() then "AlreadyLocked"
                    else "AwaitStandingCheck"
                diagnostic(state, "contact", player, false, reason)
            end
            contacts[part] = true
        end)
        state.TouchEndConnection = state.Button.TouchEnded:Connect(function(part)
            local player = actor(part)
            local contacts = player and state.Contacts[player]
            if contacts then
                contacts[part] = nil
                if next(contacts) == nil then
                    state.Contacts[player] = nil
                end
            end
        end)
    end
    if workspace:GetAttribute("LockBaseDiagnostics") == true then
        print(
            "[LockBase] event=bind plot=" .. plot:GetFullName() .. " walls=" .. #walls .. " missing=" .. missingSummary
        )
    end
end
local function bindPlot(plot: Instance)
    if states[plot] or not plot:IsDescendantOf(workspace) then
        return
    end
    local state: any = { Plot = plot, Deadline = 0, NextLockAt = 0, Latched = {}, Connections = {} }
    states[plot] = state
    refreshState(state)
    bindAssets(state)
    local function changed(instance: Instance)
        if
            instance.Name == "LockBase"
            or instance.Name == "LockButton"
            or instance.Name == "Button"
            or instance.Name == "LockAttachment"
            or instance.Name == "Visual"
            or instance.Name == "Laser"
            or instance.Name == "LaserBase"
            or CollectionService:HasTag(instance, "PlayerOnlyCollision")
        then
            state.Dirty = true
        end
    end
    table.insert(state.Connections, plot.DescendantAdded:Connect(changed))
    table.insert(state.Connections, plot.DescendantRemoving:Connect(changed))
end

function Service.RefreshMembership()
    if not authority then
        return
    end
    for _, state in states do
        refreshState(state)
    end
end
function Service.ApplyCharacter(player: Player, _character: Model)
    Service.RefreshMembership()
    local plot = authority.GetPlot(player)
    if plot and states[plot] then
        states[plot].Latched[player] = true
    end
end
function Service.RemoveCharacter(player: Player)
    for _, state in states do
        if state.Collision then
            local remaining = members(state)
            local index = table.find(remaining, player)
            if index then
                table.remove(remaining, index)
            end
            state.Collision.Refresh(remaining)
        end
        state.Latched[player] = nil
        if state.Contacts then
            state.Contacts[player] = nil
        end
        if state.Support then
            state.Support[player] = nil
        end
    end
end
function Service.StartSession(player: Player)
    local plot = authority.GetPlot(player)
    if not plot then
        return
    end
    bindPlot(plot)
    -- Keep the lifecycle API, but a claim only binds the unlocked presentation.
    refreshState(states[plot])
    for _, member in members(states[plot]) do
        states[plot].Latched[member] = true
    end
end
function Service.CleanupSession(id: string)
    for _, state in states do
        if state.SessionId == id then
            unlock(state, true)
            state.Owner, state.SessionId = nil, nil
            state.Latched = {}
            publish(state)
            state.Presentation.Update(false, 0, workspace:GetServerTimeNow())
        end
    end
end
function Service.IsLocked(object: Instance): boolean
    local owner = authority and authority.GetOwner(object)
    local plot = if owner then authority.GetPlot(owner) else nil
    local state = if plot then states[plot] else nil
    return state ~= nil
        and state.Owner == owner
        and state.SessionId == authority.GetSessionId(owner)
        and state.Deadline > workspace:GetServerTimeNow()
end
-- Server-only physical interaction: no client timer, target, or activation remote.
function Service.Activate(player: Player, plot: Instance): boolean
    local state = states[plot]
    if not state then
        return false
    end
    local reason: string? = nil
    if not plot:IsDescendantOf(workspace) then
        reason = "PlotRemoved"
    elseif not authority.GetOwner(plot) then
        reason = "Unclaimed"
    elseif not authority.IsMember(player, plot) then
        reason = "NotMember"
    else
        local standing, support = Service.CheckStanding(player, plot)
        if not standing then
            reason = support
        end
    end
    if reason then
        diagnostic(state, "activate", player, false, reason)
        return false
    end
    if lockFor(state, Config.ManualLockDuration) then
        state.Presentation.Press()
        diagnostic(state, "activate", player, true, "Manual")
        return true
    end
    diagnostic(
        state,
        "activate",
        player,
        false,
        if state.Deadline > workspace:GetServerTimeNow() then "AlreadyLocked" else "Cooldown"
    )
    return false
end
function Service.Init(services: any)
    if initialized then
        return
    end
    initialized = true
    authority = services.TycoonService
    for _, plot in authority.GetOrderedPlots() do
        bindPlot(plot)
    end
    workspace:SetAttribute("LockBaseInitialized", true)
    CollectionService:GetInstanceAddedSignal("PlayerPlot"):Connect(bindPlot)
    for _, tag in { "PlayerOnlyCollision" } do
        local function dirty(instance: Instance)
            for plot, state in states do
                if instance:IsDescendantOf(plot) then
                    state.Dirty = true
                end
            end
        end
        CollectionService:GetInstanceAddedSignal(tag):Connect(dirty)
        CollectionService:GetInstanceRemovedSignal(tag):Connect(dirty)
    end
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.05 then
            return
        end
        elapsed = 0
        local now = workspace:GetServerTimeNow()
        for plot, state in states do
            if not plot:IsDescendantOf(workspace) or not CollectionService:HasTag(plot, "PlayerPlot") then
                unlock(state, true)
                state.Collision.Destroy()
                state.Presentation.Destroy()
                if state.TouchConnection then
                    state.TouchConnection:Disconnect()
                end
                if state.TouchEndConnection then
                    state.TouchEndConnection:Disconnect()
                end
                for _, connection in state.Connections do
                    connection:Disconnect()
                end
                states[plot] = nil
                continue
            end
            if state.Dirty then
                bindAssets(state)
            end
            if state.Deadline > 0 and state.Deadline <= now then
                unlock(state)
            end
            state.Presentation.Update(state.Owner ~= nil, state.Deadline, now)
            if state.Button then
                local current = members(state)
                for player in state.Latched do
                    if not table.find(current, player) then
                        state.Latched[player] = nil
                    end
                end
                for _, player in current do
                    local standing, support = Service.CheckStanding(player, plot)
                    if workspace:GetAttribute("LockBaseDiagnostics") == true then
                        state.Support = state.Support or {}
                        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                        if
                            root
                            and root:IsA("BasePart")
                            and (root.Position - state.Button.Position).Magnitude <= 12
                            and state.Support[player] ~= support
                        then
                            state.Support[player] = support
                            diagnostic(state, "support", player, standing, support)
                        end
                    end
                    if not standing then
                        state.Latched[player] = nil
                    elseif not state.Latched[player] then
                        -- Contacts during an active lock also require stepping off.
                        state.Latched[player] = true
                        Service.Activate(player, plot)
                    end
                end
            end
        end
    end)
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">LuckyBlockService</string>
            <string name="Source"><![CDATA[--!strict
-- Session-only rolls, public reward pickups, and buff clocks.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.LuckyBlockConfig)
local Presentation = require(Shared.Constants.LuckyBlockPresentation)
local WorldUtil = require(script.Parent.WorldUtil)
local BillboardStyle = require(Shared.WorldBillboardStyle)
local RewardVisual = require(Shared.LuckyBlockRewardVisual)
local Ingredients = require(Shared.Constants.Ingredients)
local Service = {}
local deps: any
local buffs: { [Player]: { [string]: number } } = {}
local pickupClaim: { [Player]: number } = {}
type Pickup = {
    PickupId: number,
    RewardId: string,
    Position: Vector3,
    PickedUpAt: number,
    ExpiresAt: number,
    Model: Model?,
    LabelAnchor: Attachment?,
}
local pickups: { [number]: Pickup } = {}
local level0Waiting = false
local spawnPickup: (Pickup) -> ()
type Slot = { Level: string, Model: Model?, Previous: BasePart?, Waiting: boolean }
local slots: { Slot } = {}
local populate: (Slot) -> boolean
type Record = { Marker: BasePart, Origin: CFrame, Connections: { RBXScriptConnection }, Slot: Slot }
local markers: { [BasePart]: boolean } = {}
local records: { [Model]: Record } = {}
local levelWarnings: { [string]: boolean } = {}
local markerWarnings: { [BasePart]: boolean } = {}
local schedule: (Slot, number) -> ()
local lastClaim: { [Player]: number } = {}
local folder: Folder
local remote: RemoteEvent
local nearbyRemote: RemoteEvent
local pickupId = 0
local started = false
local assetWarning = false
local rewardWarnings: { [string]: boolean } = {}

function Service.IsBuffActive(player: Player, rewardId: string): boolean
    local state = buffs[player]
    return state ~= nil and (state[rewardId] or 0) > workspace:GetServerTimeNow()
end

function Service.GetCashMultiplier(player: Player): number
    return if Service.IsBuffActive(player, "CashBoost") then 1.5 else 1
end

local function respawn(slot: Slot)
    local seconds = Config.Respawn.MinRespawnSeconds
        + math.random() * (Config.Respawn.MaxRespawnSeconds - Config.Respawn.MinRespawnSeconds)
    if slot.Level ~= "Level0" or not Config.Spawn.Level0Sync then
        schedule(slot, seconds)
    elseif not level0Waiting then
        level0Waiting = true
        task.delay(seconds, function()
            level0Waiting = false
            for _, candidate in slots do
                if candidate.Level == "Level0" and not candidate.Model and not populate(candidate) then
                    schedule(candidate, Config.Spawn.RetrySeconds)
                end
            end
        end)
    end
end

local function retire(model: Model, alreadyDestroying: boolean?)
    local record = records[model]
    if not record then
        return
    end
    -- Commit before Destroy/events: another player or reentrant callback cannot claim.
    records[model] = nil
    for _, connection in record.Connections do
        connection:Disconnect()
    end
    record.Slot.Model = nil
    respawn(record.Slot)
    if not alreadyDestroying then
        model:Destroy()
    end
end

function Service.TryClaim(player: Player, model: Model): boolean
    local record = records[model]
    local now = os.clock()
    if not record or player.Parent ~= Players or not model:IsDescendantOf(folder) then
        return false
    end
    if lastClaim[player] and now - lastClaim[player] < Config.Pickup.PlayerCooldownSeconds then
        return false
    end
    if not WorldUtil.Near(player, model, Config.Pickup.Radius) then
        return false
    end
    lastClaim[player] = now
    -- Config is shared for presentation, but selection uses only the server's copy.
    local total = 0
    for _, reward in Config.Rewards do
        total += reward.Weight
    end
    local roll = math.random() * total
    local selected = Config.Rewards[#Config.Rewards]
    for _, reward in Config.Rewards do
        roll -= reward.Weight
        if roll < 0 then
            selected = reward
            break
        end
    end
    local position = record.Origin.Position
    local character = player.Character
    local pickedUpAt = workspace:GetServerTimeNow()
    pickupId += 1
    retire(model)
    remote:FireClient(player, {
        RewardId = selected.Id,
        DurationSeconds = selected.DurationSeconds,
        Position = position,
        Character = character,
        PickedUpAt = pickedUpAt,
        PickupId = pickupId,
    })
    -- Output only; observers receive one committed reward, never silhouette ticks.
    for _, observer in Players:GetPlayers() do
        local root = observer.Character and observer.Character:FindFirstChild("HumanoidRootPart")
        if
            observer ~= player
            and root
            and root:IsA("BasePart")
            and (root.Position - position).Magnitude <= Presentation.NearbyDistance
        then
            nearbyRemote:FireClient(observer, {
                Position = position,
                UserId = player.UserId,
                Character = character,
                RewardId = selected.Id,
                DurationSeconds = selected.DurationSeconds,
                PickedUpAt = pickedUpAt,
                PickupId = pickupId,
            })
        end
    end
    -- Replicate identity before the deadline. Clients can retain a revealed prize
    -- until this same container's art arrives, or observe a claim before art arrives.
    local container = Instance.new("Model")
    container.Name = "LuckyRewardPickup"
    container:SetAttribute("PickupId", pickupId)
    container:SetAttribute("RewardId", selected.Id)
    container:SetAttribute("PickedUpAt", pickedUpAt)
    container:SetAttribute("PickupPosition", position)
    container:SetAttribute("PickupState", "Pending")
    CollectionService:AddTag(model, Presentation.PickupTag)
    container.Parent = folder
    local pickup: Pickup = {
        PickupId = pickupId,
        RewardId = selected.Id,
        Position = position,
        PickedUpAt = pickedUpAt,
        ExpiresAt = 0,
        Model = container,
        LabelAnchor = nil,
    }
    container.Destroying:Connect(function()
        if pickup.LabelAnchor then
            pickup.LabelAnchor:Destroy()
            pickup.LabelAnchor = nil
        end
    end)
    task.delay(Presentation.RevealSeconds + Presentation.HoldSeconds + Presentation.FadeSeconds, function()
        pickup.ExpiresAt = workspace:GetServerTimeNow() + 60
        container:SetAttribute("ExpiresAt", pickup.ExpiresAt)
        pickups[pickup.PickupId] = pickup
        spawnPickup(pickup)
    end)
    return true
end

local function spawnAt(marker: BasePart, slot: Slot): boolean
    local templates = ServerStorage:FindFirstChild(Config.TemplateFolderName)
    local template = templates and templates:FindFirstChild(Config.ModelName)
    if not template or not template:IsA("Model") or not template.PrimaryPart or not template.Archivable then
        if not assetWarning then
            warn(
                "[LuckyBlock] Add an archivable Model with PrimaryPart at ServerStorage."
                    .. Config.TemplateFolderName
                    .. "."
                    .. Config.ModelName
            )
            assetWarning = true
        end
        return false
    end
    assetWarning = false
    local model = template:Clone()
    -- Authored templates are visual assets, never executable gameplay or inventory.
    local descendants = model:GetDescendants()
    table.insert(descendants, model)
    for _, child in descendants do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        if child:IsA("BaseScript") or child:IsA("ModuleScript") or child:IsA("ProximityPrompt") then
            child:Destroy()
        elseif child:IsA("BasePart") then
            child.Anchored = true
            child.CanCollide = false
            child.CanTouch = false
            child.CanQuery = false
        end
    end
    local origin = marker.CFrame * CFrame.new(0, marker.Size.Y / 2 + Config.Spawn.HeightOffset, 0)
    model:PivotTo(origin)
    model:SetAttribute("LuckyBlockOrigin", origin)
    model:SetAttribute("LuckyBlockSpawnTime", workspace:GetServerTimeNow())
    local blockSlot = slot :: Slot
    model:SetAttribute("Level", blockSlot.Level)
    records[model] = { Marker = marker :: BasePart, Origin = origin, Connections = {}, Slot = blockSlot }
    blockSlot.Model = model
    blockSlot.Previous = marker
    model.Parent = folder
    local connections = records[model].Connections
    table.insert(
        connections,
        model.Destroying:Connect(function()
            retire(model, true)
        end)
    )
    table.insert(
        connections,
        model.AncestryChanged:Connect(function()
            if not model:IsDescendantOf(folder) then
                retire(model)
            end
        end)
    )
    CollectionService:AddTag(model, Config.WorldTag)
    return true
end

local function clearPickupAppearance(pickup: Pickup)
    if pickup.LabelAnchor then
        pickup.LabelAnchor:Destroy()
        pickup.LabelAnchor = nil
    end
    local visual = pickup.Model and pickup.Model:FindFirstChild("RewardVisual")
    if visual then
        visual:Destroy()
    end
end

spawnPickup = function(pickup: Pickup)
    local model = pickup.Model
    if not model or workspace:GetServerTimeNow() >= pickup.ExpiresAt then
        return
    end
    local sourceFolder = game:GetService("ReplicatedStorage"):FindFirstChild(Presentation.VisualFolderName)
    local visualName = Presentation.Rewards[pickup.RewardId].Visual
    local visual = RewardVisual.Clone(sourceFolder and sourceFolder:FindFirstChild(visualName), false)
    local partCount = 0
    if visual then
        visual.Name = "RewardVisual"
        visual:PivotTo(RewardVisual.Pose(pickup.Position))
        for _, object in visual:GetDescendants() do
            if object:IsA("BasePart") then
                partCount += 1
            end
        end
        visual.Parent = model
        rewardWarnings[visualName] = nil
    elseif not rewardWarnings[visualName] then
        rewardWarnings[visualName] = true
        warn(
            "[LuckyBlock] Missing usable "
                .. Presentation.VisualFolderName
                .. "."
                .. visualName
                .. "; label only (Collin asset task)"
        )
    end
    -- An Attachment on Terrain gives the fallback label a world position without
    -- inventing a part/mesh. Pickup proximity uses the original server position.
    local anchor = Instance.new("Attachment")
    anchor.Name = "LuckyRewardLabelAnchor"
    anchor.CFrame = CFrame.new(pickup.Position)
    anchor.Parent = workspace.Terrain
    pickup.LabelAnchor = anchor
    local gui = Instance.new("BillboardGui")
    gui.Name = "LuckyRewardLabel"
    gui.Adornee = anchor
    gui.StudsOffsetWorldSpace = Vector3.new(0, Presentation.HeightOffset + 2, 0)
    BillboardStyle.ApplyBillboard(
        gui,
        { WidthStuds = 5, HeightStuds = 1, MaxDistance = Config.Pickup.LabelMaxDistance }
    )
    local label = Instance.new("TextLabel")
    BillboardStyle.ApplyText(label, { TextScaled = true })
    label.Text = Presentation.Rewards[pickup.RewardId].Name
    label.Parent = gui
    gui.Parent = anchor
    model:SetAttribute("VisualPartCount", partCount)
    model:SetAttribute("PickupState", "Available")
end

local function prepareReward(player: Player, rewardId: string): (() -> boolean)?
    for _, reward in Config.Rewards do
        if reward.Id == rewardId and reward.DurationSeconds then
            return function(): boolean
                buffs[player] = buffs[player] or {}
                buffs[player][rewardId] = workspace:GetServerTimeNow() + (reward.DurationSeconds :: number)
                player:SetAttribute("LuckyBuff" .. rewardId .. "ExpiresAt", buffs[player][rewardId])
                return true
            end
        end
    end
    local tier = deps.TycoonService.GetJumpTier(player)
    local pool: { string } = {}
    -- TODO(LuckyMysteryAnnouncedOnly): catalog has no announced-only flag/set.
    -- Authored announced spawn tags describe markers, not ingredient eligibility.
    for id, definition in Ingredients do
        local eligible = if rewardId == "PantryPack"
            then definition.JumpLocation >= 0 and definition.JumpLocation <= tier
            elseif rewardId == "TopShelf" then definition.JumpLocation == tier
            else id ~= "Player_Head" and id ~= "PlayerHead" and id ~= "Dragon_Fruit"
        if eligible then
            table.insert(pool, id)
        end
    end
    if #pool == 0 then
        return nil
    end
    table.sort(pool)
    local ids = {}
    for _ = 1, if rewardId == "PantryPack" then 3 else 1 do
        table.insert(ids, pool[math.random(1, #pool)])
    end
    return deps.InventoryService.PrepareIngredientReward(player, ids)
end

function Service.TryClaimPickup(player: Player, model: Model): boolean
    local id = model:GetAttribute("PickupId")
    local pickup = if typeof(id) == "number" then pickups[id] else nil
    local now = workspace:GetServerTimeNow()
    if
        not pickup
        or pickup.Model ~= model
        or player.Parent ~= Players
        or now >= pickup.ExpiresAt
        or not model:IsDescendantOf(folder)
        or (pickupClaim[player] and now - pickupClaim[player] < Config.Pickup.PlayerCooldownSeconds)
        or not WorldUtil.NearPosition(player, pickup.Position, Config.Pickup.Radius)
    then
        return false
    end
    local award = prepareReward(player, pickup.RewardId)
    if not award then
        return false
    end
    -- No yields: prepared inventory transaction rolls back the whole batch on failure.
    pickups[pickup.PickupId] = nil
    model:SetAttribute("PickupState", "Claimed")
    clearPickupAppearance(pickup)
    if not award() then
        pickups[pickup.PickupId] = pickup
        spawnPickup(pickup)
        return false
    end
    pickupClaim[player] = now
    if not buffs[player] or not buffs[player][pickup.RewardId] then
        player:SetAttribute("LuckyInstant" .. pickup.RewardId .. "Until", now + Presentation.InstantMessageSeconds)
    end
    -- Keep only replicated terminal identity until original expiry. A client that
    -- receives the claim before the art can still dispose its local reveal.
    task.delay(math.max(0, pickup.ExpiresAt - workspace:GetServerTimeNow()), function()
        model:Destroy()
    end)
    return true
end

local function markerLevel(marker: BasePart): string?
    local attribute = marker:GetAttribute("Level")
    if attribute ~= nil then
        local name = if typeof(attribute) == "number" then "Level" .. tostring(attribute) else attribute
        if typeof(name) == "string" and table.find(Config.Spawn.Levels, name) then
            return name
        end
        if not markerWarnings[marker] then
            warn("[LuckyBlock] Invalid Level attribute on " .. marker:GetFullName() .. "; use 0–3 or Level0–Level3")
            markerWarnings[marker] = true
        end
        return nil
    end
    local ancestor = marker.Parent
    while ancestor and ancestor ~= workspace do
        if table.find(Config.Spawn.Levels, ancestor.Name) then
            local parent = ancestor.Parent
            if
                (ancestor:IsA("Folder") or ancestor:IsA("Model"))
                and parent
                and parent.Name == Config.Spawn.ContainerName
                and (parent:IsA("Folder") or parent:IsA("Model"))
            then
                return ancestor.Name
            end
            return nil
        end
        ancestor = ancestor.Parent
    end
    if not markerWarnings[marker] then
        warn(
            "[LuckyBlock] Unassigned marker "
                .. marker:GetFullName()
                .. "; defaulting to Level0. Set Level or group under "
                .. Config.Spawn.ContainerName
        )
        markerWarnings[marker] = true
    end
    return "Level0"
end

populate = function(slot: Slot): boolean
    if slot.Model then
        return true
    end
    local available: { BasePart } = {}
    local occupied: { [BasePart]: boolean } = {}
    for _, record in records do
        occupied[record.Marker] = true
    end
    local validCount = 0
    for marker in markers do
        if marker:IsDescendantOf(workspace) and markerLevel(marker) == slot.Level then
            validCount += 1
            if not occupied[marker] then
                table.insert(available, marker)
            end
        end
    end
    if validCount < (Config.Spawn.SlotsPerLevel :: { [string]: number })[slot.Level] then
        if not levelWarnings[slot.Level] then
            warn(
                "[LuckyBlock] "
                    .. slot.Level
                    .. " has "
                    .. validCount
                    .. " valid markers; needs "
                    .. (Config.Spawn.SlotsPerLevel :: { [string]: number })[slot.Level]
                    .. "; retrying empty slots"
            )
            levelWarnings[slot.Level] = true
        end
    else
        levelWarnings[slot.Level] = nil
    end
    if #available == 0 then
        return false
    end
    if #available > 1 then
        local previousMarker = slot.Previous
        local previous = if previousMarker then table.find(available, previousMarker) else nil
        if previous then
            table.remove(available, previous)
        end
    end
    return spawnAt(available[math.random(1, #available)], slot)
end

schedule = function(slot: Slot, seconds: number)
    if slot.Waiting or slot.Model then
        return
    end
    slot.Waiting = true
    task.delay(seconds, function()
        slot.Waiting = false
        if not populate(slot) then
            schedule(slot, Config.Spawn.RetrySeconds)
        end
    end)
end

local function tick()
    for id, pickup in pickups do
        if workspace:GetServerTimeNow() >= pickup.ExpiresAt then
            pickups[id] = nil
            clearPickupAppearance(pickup)
            if pickup.Model then
                pickup.Model:SetAttribute("PickupState", "Expired")
                pickup.Model:Destroy()
            end
        elseif pickup.Model then
            for _, player in Players:GetPlayers() do
                -- A failed award can leave recovery waiting for repaired art.
                local model = pickup.Model
                if not model then
                    break
                end
                if Service.TryClaimPickup(player, model) then
                    break
                end
            end
        end
    end
    for model in records do
        for _, player in Players:GetPlayers() do
            if Service.TryClaim(player, model) then
                break
            end
        end
    end
    task.delay(Config.Pickup.PollSeconds, tick)
end

function Service.RemovePlayer(player: Player)
    lastClaim[player] = nil
    pickupClaim[player] = nil
    buffs[player] = nil
    for _, reward in Config.Rewards do
        player:SetAttribute("LuckyBuff" .. reward.Id .. "ExpiresAt", nil)
        player:SetAttribute("LuckyInstant" .. reward.Id .. "Until", nil)
    end
end

function Service.Init(services: any)
    if started then
        return
    end
    started = true
    deps = services
    local existing = workspace:FindFirstChild(Config.WorldFolderName)
    assert(not existing or existing:IsA("Folder"), "LuckyBlocks must be a Folder")
    folder = if existing then existing :: Folder else Instance.new("Folder")
    folder.Name = Config.WorldFolderName
    folder.Parent = workspace
    local event = Shared.Events:FindFirstChild(Config.RewardEventName)
    assert(not event or event:IsA("RemoteEvent"), "LuckyBlockPickedUp must be a RemoteEvent")
    remote = if event then event :: RemoteEvent else Instance.new("RemoteEvent")
    remote.Name = Config.RewardEventName
    remote.Parent = Shared.Events
    local nearby = Shared.Events:FindFirstChild(Presentation.NearbyEventName)
    assert(not nearby or nearby:IsA("RemoteEvent"), "LuckyBlockRevealed must be a RemoteEvent")
    nearbyRemote = if nearby then nearby :: RemoteEvent else Instance.new("RemoteEvent")
    nearbyRemote.Name = Presentation.NearbyEventName
    nearbyRemote.Parent = Shared.Events
    -- Output only: there is deliberately no OnServerEvent pickup endpoint.
    WorldUtil.BindTag(Config.MarkerTag, function(object: Instance): (() -> ())?
        if not object:IsA("BasePart") then
            warn("[LuckyBlock] Tag a BasePart spawn marker")
            return nil
        end
        markers[object] = true
        return function()
            markers[object] = nil
            markerWarnings[object] = nil
            for model, record in records do
                if record.Marker == object then
                    retire(model)
                end
            end
        end
    end)
    for _, level in Config.Spawn.Levels do
        for _ = 1, (Config.Spawn.SlotsPerLevel :: { [string]: number })[level] do
            local slot: Slot = { Level = level, Model = nil, Previous = nil, Waiting = false }
            table.insert(slots, slot)
            if not populate(slot) then
                schedule(slot, Config.Spawn.RetrySeconds)
            end
        end
    end
    tick()
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="127">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local WorldUtil = require(script.Parent.WorldUtil)
local MarketService = {}
local CollectionService = game:GetService("CollectionService")
local deps: any
local pedestals: { [BasePart]: { Item: Instance?, RespawnAt: number, Id: string, Seconds: number } } = {}
function MarketService.Init(services)
    deps = services
end
function MarketService.Register(pedestal: BasePart)
    if
        CollectionService:HasTag(pedestal, "IngredientSpawn")
        or CollectionService:HasTag(pedestal, "AnnouncedIngredientSpawn")
    then
        warn("[MarketService] Use only one spawn tag: " .. pedestal:GetFullName())
        return
    end
    if not pedestals[pedestal] then
        local id = pedestal:GetAttribute("IngredientId")
        if typeof(id) ~= "string" or not deps.IngredientService.GetDefinition(id) then
            warn("[MarketService] Set an explicit valid IngredientId: " .. pedestal:GetFullName())
            return
        end
        local definition = deps.IngredientService.GetDefinition(id)
        local seconds = Economy.SpecialRefillSeconds[id] or Economy.RefillSeconds[definition.JumpLocation]
        pedestals[pedestal] = { Item = nil, RespawnAt = 0, Id = id, Seconds = seconds :: number }
    end
end
function MarketService.Unregister(pedestal: BasePart)
    local state = pedestals[pedestal]
    pedestals[pedestal] = nil
    pedestal:SetAttribute("StockIngredientId", nil)
    if state and state.Item then
        state.Item:Destroy()
    end
end
function MarketService.Step()
    local now = os.clock()
    for pedestal, state in pedestals do
        if state.Item and not deps.IngredientService.GetRecord(state.Item) then
            -- Retire stock moved out of Workspace before allowing a replacement.
            state.Item:Destroy()
            state.Item = nil
            state.RespawnAt = now + state.Seconds
            pedestal:SetAttribute("StockIngredientId", nil)
        end
        if pedestal:IsDescendantOf(workspace) and not state.Item and now >= state.RespawnAt then
            local id = state.Id
            state.Item = deps.IngredientService.Spawn(
                id,
                pedestal.CFrame * CFrame.new(0, pedestal.Size.Y / 2 + 1, 0),
                nil,
                true,
                { Origin = "Market" }
            )
            if state.Item then
                pedestal:SetAttribute("StockIngredientId", id)
            else
                state.RespawnAt = now + state.Seconds
            end
        end
    end
end
function MarketService.Claim(player: Player, pedestal: BasePart): boolean
    local state = pedestals[pedestal]
    if not state or not state.Item or not WorldUtil.Near(player, pedestal, Economy.InteractionDistance) then
        return false
    end
    if not deps.InventoryService.CarryWorldItem(player, state.Item) then
        return false
    end
    state.Item = nil
    state.RespawnAt = os.clock() + state.Seconds
    pedestal:SetAttribute("StockIngredientId", nil)
    return true
end
-- Server-only drop boundary for future ant defeat handlers.
function MarketService.SpawnDrop(at: CFrame, id: string): Instance?
    return deps.IngredientService.Spawn(id, at, nil, nil, { Origin = "Market" })
end
return require(script.Parent.StudioServices).Wrap("MarketService", MarketService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local RunService = game:GetService("RunService")
local Upgrades = require(Shared.Constants.Upgrades)
local SprintConfig = require(Shared.Constants.SprintConfig)
local MovementService = {}
local data: any
local frozen: { [Player]: boolean? } = {}
local stunned: { [Player]: boolean? } = {}
type Stats = { BaseWalkSpeed: number, SprintWalkSpeed: number, MaxStamina: number, JumpPower: number }
local resolved: { [Player]: Stats } = {}
local overrides: { [Player]: { [string]: number? } } = {}
local changed = Instance.new("BindableEvent")
MovementService.Changed = changed.Event

function MovementService.Init(dependencies)
    data = dependencies.TycoonService
end

function MovementService.IsInitialized(player: Player): boolean
    return resolved[player] ~= nil
end

function MovementService.GetBaseWalkSpeed(player: Player): number
    return resolved[player].BaseWalkSpeed
end
function MovementService.GetSprintWalkSpeed(player: Player): number
    return resolved[player].SprintWalkSpeed
end
function MovementService.GetMaxStamina(player: Player): number
    return resolved[player].MaxStamina
end
function MovementService.GetJumpPower(player: Player): number
    return resolved[player].JumpPower
end

local function applyJump(player: Player, humanoid: Humanoid)
    local power = if MovementService.IsMovementLocked(player) then 0 else MovementService.GetJumpPower(player)
    if humanoid.UseJumpPower then
        humanoid.JumpPower = power
    else
        humanoid.JumpHeight = power * power / (2 * workspace.Gravity)
    end
end

function MovementService.IsStunned(player: Player): boolean
    return stunned[player] == true
end

function MovementService.CanPerformGameplayAction(player: Player): boolean
    return not MovementService.IsMovementLocked(player)
end

function MovementService.IsFrozen(player: Player): boolean
    return frozen[player] == true
end

function MovementService.IsMovementLocked(player: Player): boolean
    return MovementService.IsStunned(player) or MovementService.IsFrozen(player)
end

local function applyLock(player: Player)
    local locked = MovementService.IsMovementLocked(player)
    -- Existing clients use Stunned as the aggregate input lock. Bat state stays separate.
    player:SetAttribute("Stunned", locked)
    player:SetAttribute("Frozen", MovementService.IsFrozen(player))
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid and resolved[player] then
        applyJump(player, humanoid)
        humanoid.WalkSpeed = if locked then 0 else MovementService.GetBaseWalkSpeed(player)
        if locked then
            humanoid.Jump = false
        end
    end
    if resolved[player] then
        changed:Fire(player)
    end
end

function MovementService.SetStunned(player: Player, value: boolean)
    stunned[player] = if value then true else nil
    applyLock(player)
end

function MovementService.SetFrozen(player: Player, value: boolean)
    frozen[player] = if value then true else nil
    applyLock(player)
end

function MovementService.RefreshPlayer(player: Player)
    local speedIndex = data.GetUpgrade(player, "MovementSpeed")
    local jumpIndex = data.GetUpgrade(player, "Jump")
    local staminaIndex = data.GetUpgrade(player, "SprintStamina")
    local debugLevels: { [string]: number? } = overrides[player] or {}
    local effectiveSpeed = if debugLevels.MovementSpeed ~= nil then debugLevels.MovementSpeed + 1 else speedIndex
    local effectiveJump = if debugLevels.Jump ~= nil then debugLevels.Jump + 1 else jumpIndex
    local effectiveStamina = if debugLevels.SprintStamina ~= nil then debugLevels.SprintStamina + 1 else staminaIndex
    local speed = Upgrades.MovementSpeed[effectiveSpeed].Value
    resolved[player] = {
        BaseWalkSpeed = speed,
        SprintWalkSpeed = speed * SprintConfig.SPRINT_SPEED_MULTIPLIER,
        MaxStamina = Upgrades.SprintStamina[effectiveStamina].Value,
        JumpPower = Upgrades.Jump[effectiveJump].Value,
    }
    player:SetAttribute("MovementSpeedLevel", effectiveSpeed - 1)
    player:SetAttribute("JumpLevel", effectiveJump - 1)
    player:SetAttribute("SprintStaminaLevel", effectiveStamina - 1)
    player:SetAttribute("BaseWalkSpeed", speed)
    player:SetAttribute("SprintWalkSpeed", resolved[player].SprintWalkSpeed)
    player:SetAttribute("StaminaMax", resolved[player].MaxStamina)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    end
    changed:Fire(player)
end

-- Bootstrap owns the sole CharacterAdded connection. Never block its other resets.
function MovementService.ApplyCharacter(player: Player, character: Model)
    MovementService.RefreshPlayer(player)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    else
        task.spawn(function()
            local pending = character:WaitForChild("Humanoid", 5)
            if pending and pending:IsA("Humanoid") and player.Character == character and resolved[player] then
                applyJump(player, pending)
            end
        end)
    end
end

local function assertStudioServer()
    assert(RunService:IsServer() and RunService:IsStudio() and RunService:IsRunning(), "Studio Play server only")
end

function MovementService.SetStudioLevel(player: Player, track: string, level: number?)
    assertStudioServer()
    assert(track == "MovementSpeed" or track == "Jump" or track == "SprintStamina", "Invalid movement track")
    local maxLevel = #(Upgrades :: any)[track] - 1
    assert(
        level == nil or (type(level) == "number" and level >= 0 and level <= maxLevel and level == math.floor(level)),
        "Invalid purchased step; expected 0-" .. tostring(maxLevel)
    )
    assert(resolved[player] ~= nil, "Movement player is not initialized")
    local levels = overrides[player] or {}
    levels[track] = level
    overrides[player] = levels
    MovementService.RefreshPlayer(player)
end

function MovementService.ResetStudioOverrides(player: Player)
    assertStudioServer()
    overrides[player] = nil
    MovementService.RefreshPlayer(player)
end

function MovementService.GetStudioSnapshot(player: Player)
    assertStudioServer()
    local result = table.clone(resolved[player])
    return result, table.clone(overrides[player] or {})
end

function MovementService.RemovePlayer(player: Player)
    stunned[player] = nil
    frozen[player] = nil
    resolved[player] = nil
    overrides[player] = nil
end
return require(script.Parent.StudioServices).Wrap("MovementService", MovementService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">MuncherDiagnostics</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Muncher)
local Diagnostics = {}
local count = 0
function Diagnostics.Log(event: string, input: BasePart, object: Instance?, reason: string?, source: string?)
    if
        not RunService:IsStudio()
        or ServerStorage:GetAttribute("DebugMuncherVacuum") ~= true
        or count >= Config.Vacuum.DiagnosticLimit
    then
        return
    end
    count += 1
    local model = input.Parent
    local plot = model and model.Parent
    print(
        string.format(
            "[MuncherVacuum] plot=%s ingredient=%s source=%s event=%s reason=%s",
            if plot then tostring(plot:GetAttribute("PlotSessionId")) else "unknown",
            if object then tostring(object:GetAttribute("IngredientId")) else "none",
            source or "WorldVacuum",
            event,
            reason or "none"
        )
    )
end
return Diagnostics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">MuncherOutput</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.WorldUtil)
local Output = {}

function Output.Location(model: Instance, input: BasePart): CFrame
    local mouth = model:FindFirstChild("MouthOrigin", true)
    if mouth and mouth:IsA("Attachment") then
        return mouth.WorldCFrame
    elseif mouth and mouth:IsA("BasePart") then
        return mouth.CFrame
    end
    return input.CFrame
end

-- Test the arc in short segments, then choose a local, grounded fallback.
function Output.Placement(model: Instance, at: CFrame): (CFrame, Vector3)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    params.RespectCanCollide = true
    local direction = at.LookVector
    local velocity = direction * 10 + Vector3.new(0, 13, 0)
    local previous = at.Position
    local blocked = false
    for step = 1, 6 do
        local t = step * 0.08
        local point = at.Position + velocity * t - Vector3.new(0, workspace.Gravity * t * t / 2, 0)
        local hit = workspace:Spherecast(previous, 0.8, point - previous, params)
        if hit then
            -- A floor reached on descent is the intended landing, not an obstruction.
            if hit.Normal and hit.Normal.Y > 0.65 and velocity.Y - workspace.Gravity * t < 0 then
                return at, velocity
            end
            blocked = true
            break
        end
        previous = point
    end
    if not blocked and workspace:Raycast(previous + Vector3.new(0, 2, 0), Vector3.new(0, -24, 0), params) then
        return at, velocity
    end
    for _, offset in { Vector3.new(0, 0, 3), Vector3.new(3, 0, 0), Vector3.new(-3, 0, 0), Vector3.new(0, 0, -3) } do
        local candidate = at.Position + offset
        local floor = workspace:Raycast(candidate + Vector3.new(0, 4, 0), Vector3.new(0, -24, 0), params)
        if floor then
            local position = floor.Position + Vector3.new(0, 1.5, 0)
            local clearance = OverlapParams.new()
            clearance.RespectCanCollide = true
            if #workspace:GetPartBoundsInBox(CFrame.new(position), Vector3.new(2, 2, 2), clearance) == 0 then
                return CFrame.new(position), Vector3.zero
            end
        end
    end
    error("No collectible Muncher landing position; retain reward for recovery")
end

function Output.Spawn(ingredients: any, transaction: any): boolean
    if transaction.Output then
        return true
    end
    local at, velocity = Output.Placement(transaction.Model, transaction.At)
    local candidate: Instance? = nil
    local ok, result = pcall(function()
        return ingredients.Spawn(transaction.Reward, at, nil, true, {
            Origin = "Muncher",
            MuncherImmune = true,
            BeforePublish = function(object: Instance)
                candidate = object
                object:SetAttribute("MuncherReward", true)
            end,
        })
    end)
    if not ok or not result then
        if candidate then
            candidate:Destroy()
        end
        return false
    end
    -- Commit before optional physics/presentation, so a failed impulse cannot duplicate output.
    transaction.Output = result
    pcall(function()
        local root = WorldUtil.Part(result)
        if root then
            root:ApplyImpulse(velocity * root.AssemblyMass)
        end
    end)
    return true
end
return Output
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">MuncherRewards</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Muncher)
local Rewards = {}

function Rewards.BaseValue(id: string, definition: any): number?
    local value = if definition then definition.Value else nil
    if type(value) == "number" and value > 0 and value < math.huge then
        return value
    end
    if id == "PlayerHead" or id == "Player_Head" then
        return Config.PlayerHeadFallbackBaseValue
    end
    return nil
end

-- Compare catalog base values only; this label never participates in selection.
function Rewards.ResultKind(inputValue: number, outputValue: number): "Win" | "Lose" | "Push"
    return if outputValue > inputValue then "Win" elseif outputValue < inputValue then "Lose" else "Push"
end

function Rewards.Tier(value: number): number
    for tier = #Config.TierMinimums, 2, -1 do
        if value >= Config.TierMinimums[tier] then
            return tier
        end
    end
    return 1
end

-- Move up to 70% of non-jackpot bottom mass proportionally to the top half.
-- Fractional basis points retain the exact interpolation and jackpot probability.
function Rewards.Weights(tier: number, value: number): { { Id: string, Weight: number } }
    local pool = Config.RewardPools[tier]
    local split = math.floor((#pool - 1) / 2)
    local bottom, top = 0, 0
    for index, entry in pool do
        if entry.Id ~= "Dragon_Fruit" then
            if index <= split then
                bottom += entry.Weight
            else
                top += entry.Weight
            end
        end
    end
    local t =
        math.clamp((value - Config.TierMinimums[tier]) / (Config.TierMaximums[tier] - Config.TierMinimums[tier]), 0, 1)
    local moved = t * 0.7 * bottom
    local effective = {}
    for index, entry in pool do
        local weight = entry.Weight
        if entry.Id ~= "Dragon_Fruit" then
            weight *= if index <= split then 1 - t * 0.7 else 1 + moved / top
        end
        table.insert(effective, { Id = entry.Id, Weight = weight })
    end
    return effective
end

-- RNG and the unmodified catalog input value come only from the server.
function Rewards.Roll(tier: number, rng: any, definition: (string) -> any, value: number?): string
    local pool = Rewards.Weights(tier, value or Config.TierMinimums[tier])
    local total = 0
    for _, entry in pool do
        assert(entry.Id ~= "PlayerHead" and entry.Id ~= "Player_Head", "Player heads cannot be rewards")
        assert(definition(entry.Id) and entry.Weight > 0, "Invalid Muncher reward")
        total += entry.Weight
    end
    assert(math.abs(total - 10000) < 0.000001, "Muncher pool must total 10000 basis points")
    local roll = rng:NextNumber() * total
    local cumulative = 0
    for _, entry in pool do
        cumulative += entry.Weight
        if roll < cumulative then
            return entry.Id
        end
    end
    return pool[#pool].Id
end
return Rewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">MuncherService</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Muncher)
local WorldUtil = require(script.Parent.WorldUtil)
local MovementService = require(script.Parent.MovementService)
local Rewards = require(script.Parent.MuncherRewards)
local Output = require(script.Parent.MuncherOutput)
local WorldInput = require(script.Parent.MuncherWorldInput)
local Diagnostics = require(script.Parent.MuncherDiagnostics)
local Service = {}
local deps: any
local states: { [string]: any } = {}
local pending: { [any]: boolean } = {}
local random = Random.new()
local logCount = 0

local function log(transaction: any, result: string)
    if not Config.DebugLogging or logCount >= Config.LogLimit then
        return
    end
    logCount += 1
    print(
        string.format(
            "[Muncher] time=%.2f plot=%s input=%s value=%g tier=%d output=%s value=%g rarity=%s result=%s",
            workspace:GetServerTimeNow(),
            transaction.SessionId,
            transaction.Input,
            transaction.Value,
            transaction.Tier,
            transaction.Reward,
            transaction.OutputValue,
            transaction.Rarity,
            result
        )
    )
end

function Service.Step()
    local now = workspace:GetServerTimeNow()
    for transaction in pending do
        if now < transaction.NextAt then
            continue
        end
        local state = transaction.State
        state.Phase = "Spitting"
        transaction.Attempts += 1
        local ok, spawned = pcall(Output.Spawn, deps.IngredientService, transaction)
        if ok and spawned then
            pending[transaction] = nil
            log(transaction, "Success")
            Diagnostics.Log("RewardPublished", transaction.InputZone, transaction.Output, nil, transaction.Source)
            if state.Transaction == transaction then
                state.Transaction = nil
                state.Phase = "Idle"
                state.AvailableAt = now + Config.SpitSeconds
            end
        else
            transaction.NextAt = now
                + (if transaction.Attempts < Config.QuickRetries then Config.RetrySeconds else Config.RecoverySeconds)
            log(transaction, "SpawnRetry")
            if transaction.Attempts == Config.QuickRetries then
                warn("[Muncher] Output pending recovery for plot " .. transaction.SessionId)
            end
        end
    end
end

function Service.Init(services: any)
    deps = services
    game:GetService("RunService").Heartbeat:Connect(Service.Step)
end

function Service.Reset(player: Player)
    local id = deps.TycoonService.GetSessionId(player)
    if id then
        -- Detached committed transactions remain in the recovery queue at their captured location.
        states[id] = { Purchased = false, Revealed = false, ReadyAt = 0, Phase = "Idle", AvailableAt = 0, Sequence = 0 }
    end
end
function Service.CleanupSession(id: string)
    states[id] = nil
end
function Service.RemovePlayer(_player: Player)
    -- A consumed ingredient belongs to its committed transaction, not the actor's lifetime.
end
function Service.GetSnapshot(player: Player): any
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    if not state then
        return nil
    end
    local transaction = state.Transaction
    return {
        Purchased = state.Purchased,
        Active = state.Revealed,
        ReadyAt = state.ReadyAt,
        Phase = state.Phase,
        AvailableAt = state.AvailableAt,
        Sequence = state.Sequence,
        StartedAt = if transaction then transaction.StartedAt else 0,
        OutputRarity = if transaction then transaction.Rarity else nil,
        OutputId = if transaction then transaction.Reward else nil,
        ResultKind = if transaction then transaction.ResultKind else nil,
        InputTier = if transaction then transaction.Tier else nil,
        Multiplier = 1,
        ExpiresAt = 0,
    }
end

-- Reuse the existing shared-cash cost/callback transaction adapter. Its name is
-- historical; it debits the plot session ledger, including for teammates.
function Service.TryPurchase(player: Player, pad: BasePart, context: any): (boolean, string?)
    local plot = deps.TycoonService.GetPlot(player)
    local model = plot and plot:FindFirstChild("Muncher")
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    if
        not state
        or not model
        or model:FindFirstChild("PurchasePoint1") ~= pad
        or not WorldUtil.Near(player, pad, Config.FeedDistance)
    then
        return false, "InvalidPurchase"
    end
    if state.Purchased then
        return false, "AlreadyPurchased"
    end
    return deps.TycoonService.PurchasePersonalUpgrade(
        player,
        context or deps.TycoonService.GetRequestContext(player),
        Config.PurchaseCost,
        function()
            state.Purchased = true
            state.ReadyAt = workspace:GetServerTimeNow() + Config.RevealSeconds
        end
    )
end

-- Called only by the server assembly presenter after placing every part at rest.
function Service.CompleteReveal(player: Player, model: Instance): boolean
    local plot = deps.TycoonService.GetPlot(player)
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    if
        not state
        or not plot
        or plot:FindFirstChild("Muncher") ~= model
        or not state.Purchased
        or workspace:GetServerTimeNow() < state.ReadyAt
    then
        return false
    end
    if not state.Revealed then
        local input = model:FindFirstChild("InputZone")
        if input and input:IsA("BasePart") then
            Diagnostics.Log("RevealCompleted", input, nil, nil, "Lifecycle")
        end
    end
    state.Revealed = true
    return true
end

-- Compatibility for customer payout callers; Muncher no longer grants cash buffs.
function Service.GetCashMultiplier(_player: Player): number
    return 1
end

-- UI-independent machine gate; both attraction and conversion use this state.
function Service.CanVacuum(player: Player, input: BasePart): boolean
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    local plot = deps.TycoonService.GetPlot(player)
    local model = plot and plot:FindFirstChild("Muncher")
    return state ~= nil
        and state.Revealed
        and state.Phase == "Idle"
        and workspace:GetServerTimeNow() >= state.AvailableAt
        and model ~= nil
        and model:FindFirstChild("InputZone") == input
        and input:IsDescendantOf(workspace)
end

-- Presentation notification only. Never reserves, consumes, queues or alters a transaction.
function Service.ReportBusy(player: Player, input: BasePart, object: Instance)
    local id = deps.TycoonService.GetSessionId(player)
    local state = if id then states[id] else nil
    local plot = deps.TycoonService.GetPlot(player)
    local model = plot and plot:FindFirstChild("Muncher")
    if not state or not state.Revealed or not model or model:FindFirstChild("InputZone") ~= input then
        return
    end
    if state.Phase ~= "Processing" and state.Phase ~= "Spitting" then
        return
    end
    local actor, _, root = WorldInput.Eligible(deps, input, object)
    if actor ~= player or not root or (root.Position - input.Position).Magnitude > Config.Vacuum.OverlapTolerance then
        return
    end
    local now = workspace:GetServerTimeNow()
    if now >= (model:GetAttribute("BusyUntil") or 0) then
        model:SetAttribute("BusyUntil", now + Config.BusySeconds)
    end
end

-- The sole feed entry point is physical vacuum intake.
function Service.TryStartConversion(
    player: Player,
    input: BasePart,
    object: Instance?,
    source: string,
    context: any
): (boolean, string?)
    if
        source ~= "WorldVacuum"
        or not Service.CanVacuum(player, input)
        or not MovementService.CanPerformGameplayAction(player)
    then
        if source == "WorldVacuum" and object then
            Service.ReportBusy(player, input, object)
        end
        return false, "MachineBusy"
    end
    local id = deps.TycoonService.GetSessionId(player)
    local state = states[id]
    local model = deps.TycoonService.GetPlot(player):FindFirstChild("Muncher")
    if not object then
        return false, "InvalidWorldItem"
    end
    local actor, reason, root = WorldInput.Eligible(deps, input, object)
    if actor ~= player or not root then
        return false, reason or "UnauthorizedOwner"
    end
    local distance = (root.Position - input.Position).Magnitude
    if distance > Config.Vacuum.CaptureTolerance then
        local overlaps = false
        for _, touching in workspace:GetPartsInPart(input) do
            if deps.IngredientService.Resolve(touching) == object then
                overlaps = true
                break
            end
        end
        if not overlaps or distance > Config.Vacuum.OverlapTolerance then
            return false, "OutsideIntake"
        end
    end
    local ingredientId = deps.IngredientService.GetRecord(object).Id
    if not ingredientId then
        return false, "InvalidWorldItem"
    end
    local value = Rewards.BaseValue(ingredientId, deps.IngredientService.GetDefinition(ingredientId))
    if not value then
        return false
    end
    local token = deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not token then
        return false
    end
    local reservation = nil
    if object then
        -- Revalidate under the lifecycle lock, then claim the specific registry identity.
        local lockedActor, lockedReason = WorldInput.Eligible(deps, input, object)
        if lockedActor ~= player then
            deps.TycoonService.EndTransaction(token)
            return false, lockedReason
        end
        reservation = deps.IngredientService.Reserve(object)
        if not reservation then
            deps.TycoonService.EndTransaction(token)
            return false, "AlreadyReserved"
        end
    end
    if object then
        Diagnostics.Log("CandidateReserved", input, object)
    end
    state.Phase = "Processing"
    -- Prepare every fallible decision before removing ownership. No yield under lifecycle lock.
    local ok, transaction = pcall(function()
        local tier = Rewards.Tier(value)
        local reward = Rewards.Roll(tier, random, deps.IngredientService.GetDefinition, value)
        local definition = deps.IngredientService.GetDefinition(reward)
        return {
            SessionId = id,
            Source = source,
            InputZone = input,
            State = state,
            Model = model,
            At = Output.Location(model, input),
            Input = ingredientId,
            Value = value,
            Tier = tier,
            Reward = reward,
            OutputValue = definition.Value,
            ResultKind = Rewards.ResultKind(value, definition.Value),
            Rarity = definition.Rarity or "Common",
            StartedAt = workspace:GetServerTimeNow(),
            NextAt = workspace:GetServerTimeNow() + Config.ChewSeconds,
            Attempts = 0,
        }
    end)
    if not ok then
        if object and reservation then
            deps.IngredientService.ReleaseReservation(object, reservation)
        end
        state.Phase = "Idle"
        deps.TycoonService.EndTransaction(token)
        warn("[Muncher] Invalid reward configuration: " .. tostring(transaction))
        return false
    end
    local consumed = deps.IngredientService.Consume(object, false, reservation)
    if object and reservation then
        deps.IngredientService.ReleaseReservation(object, reservation)
    end
    if consumed then
        state.Transaction = transaction
        state.Sequence += 1
        pending[transaction] = true
        if value < Config.TierMinimums[1] then
            warn("[Muncher] Positive input below Tier 1 minimum")
        end
        log(transaction, "Committed")
        if object then
            Diagnostics.Log("ConversionCommitted", input, object)
        end
    else
        state.Phase = "Idle"
    end
    deps.TycoonService.EndTransaction(token)
    return consumed ~= nil, consumed
end
return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">MuncherVacuum</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Muncher)
local WorldInput = require(script.Parent.MuncherWorldInput)
local Physics = require(script.Parent.BlenderVacuumPhysics)
local Diagnostics = require(script.Parent.MuncherDiagnostics)
local Vacuum = {}

-- Bound to the existing per-plot component heartbeat. No global ingredient scan,
-- no persistent force/anchor, and no reservation until the commit boundary.
function Vacuum.Bind(services: any, input: BasePart, model: Instance): ((number) -> (), () -> ())
    local active: Instance? = nil
    local startedAt = 0
    local elapsed = Config.ScanInterval
    local wasAvailable = false
    local busySeen: { [Instance]: boolean } = {}
    local rejected = setmetatable({} :: { [Instance]: string }, { __mode = "k" })
    local retryAt = setmetatable({} :: { [Instance]: number }, { __mode = "k" })
    local warned = false
    local query = OverlapParams.new()
    query.FilterType = Enum.RaycastFilterType.Exclude
    query.FilterDescendantsInstances = { model }
    query.MaxParts = Config.Vacuum.MaxParts
    local function release()
        if active then
            Diagnostics.Log("Released", input, active)
        end
        active = nil
    end
    local function reject(object: Instance, reason: string)
        if rejected[object] ~= reason then
            rejected[object] = reason
            Diagnostics.Log("CandidateRejected", input, object, reason)
        end
    end
    local function visible(object: Instance, position: Vector3): boolean
        local ray = RaycastParams.new()
        ray.FilterType = Enum.RaycastFilterType.Exclude
        ray.FilterDescendantsInstances = { object, input }
        ray.RespectCanCollide = true
        return workspace:Raycast(position, input.Position - position, ray) == nil
    end
    return function(dt: number)
        local owner = services.TycoonService.GetOwner(input)
        local available = model:IsDescendantOf(workspace)
            and input:IsDescendantOf(model)
            and owner ~= nil
            and services.MuncherService.CanVacuum(owner, input)
        if available ~= wasAvailable then
            Diagnostics.Log(if available then "VacuumActivated" else "VacuumDeactivated", input, nil)
            wasAvailable = available
        end
        if not available then
            release()
            -- Observe rejected items at the mouth without attracting or committing them.
            -- CanVacuum deliberately disables the ordinary intake scan while busy.
            elapsed += dt
            local snapshot = if owner then services.MuncherService.GetSnapshot(owner) else nil
            if
                owner
                and model:IsDescendantOf(workspace)
                and input:IsDescendantOf(model)
                and elapsed >= Config.ScanInterval
                and snapshot
                and (snapshot.Phase == "Processing" or snapshot.Phase == "Spitting")
            then
                elapsed = 0
                local observed: { [Instance]: boolean } = {}
                for _, part in workspace:GetPartBoundsInRadius(input.Position, Config.Vacuum.OverlapTolerance, query) do
                    local object = services.IngredientService.Resolve(part)
                    if object then
                        local actor, _, root = WorldInput.Eligible(services, input, object)
                        if
                            actor
                            and root
                            and (root.Position - input.Position).Magnitude <= Config.Vacuum.OverlapTolerance
                            and visible(object, root.Position)
                        then
                            observed[object] = true
                            if not busySeen[object] then
                                services.MuncherService.ReportBusy(actor, input, object)
                            end
                        end
                    end
                end
                busySeen = observed
            end
            return
        end
        table.clear(busySeen)
        local now = workspace:GetServerTimeNow()
        elapsed += dt
        if not active and elapsed >= Config.ScanInterval then
            elapsed = 0
            local nearest = Config.Vacuum.Radius
            local seen: { [Instance]: boolean } = {}
            for _, part in workspace:GetPartBoundsInRadius(input.Position, Config.Vacuum.Radius, query) do
                local object = services.IngredientService.Resolve(part)
                if not object or seen[object] or now < (retryAt[object] or 0) then
                    continue
                end
                seen[object] = true
                local actor, reason, root = WorldInput.Eligible(services, input, object)
                if not actor or not root then
                    reject(object, reason or "InvalidWorldItem")
                    continue
                end
                local distance = (root.Position - input.Position).Magnitude
                if distance <= nearest then
                    nearest, active = distance, object
                end
            end
            if active then
                startedAt = now
                Diagnostics.Log("PullStarted", input, active)
            end
        end
        local object = active
        if not object then
            return
        end
        local actor, reason, root = WorldInput.Eligible(services, input, object)
        if not actor or not root then
            reject(object, reason or "InvalidWorldItem")
            release()
            return
        end
        local distance = (root.Position - input.Position).Magnitude
        if distance > Config.Vacuum.Radius or now - startedAt > Config.Vacuum.MaxPullSeconds then
            retryAt[object] = now + Config.Vacuum.ReleaseSeconds
            Diagnostics.Log("PullTimedOut", input, object)
            release()
            return
        end
        if not visible(object, root.Position) then
            if not warned then
                warned = true
                warn(
                    "[Muncher] Intake path blocked at "
                        .. input:GetFullName()
                        .. "; place InputZone at the accessible mouth opening"
                )
            end
            retryAt[object] = now + Config.Vacuum.ReleaseSeconds
            release()
            return
        end
        -- Commit performs its own threshold, permission and lifecycle revalidation.
        if distance <= Config.Vacuum.OverlapTolerance then
            local accepted, failure =
                services.MuncherService.TryStartConversion(actor, input, object, "WorldVacuum", nil)
            if accepted then
                release()
                return
            elseif failure ~= "OutsideIntake" then
                reject(object, failure or "InvalidWorldItem")
                release()
                return
            end
        end
        root.AssemblyLinearVelocity = Physics.SteerToward(
            root.AssemblyLinearVelocity,
            root.Position,
            input.Position,
            Config.Vacuum.Radius,
            dt,
            Config.Vacuum
        )
    end,
        release
end
return Vacuum
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">MuncherWorldInput</string>
            <string name="Source"><![CDATA[--!strict
-- One server-owned lifecycle/attribution predicate for detection and commit.
local CollectionService = game:GetService("CollectionService")
local WorldUtil = require(script.Parent.WorldUtil)
local Input = {}

function Input.Eligible(services: any, zone: BasePart, object: Instance): (Player?, string?, BasePart?)
    local ancestor: Instance? = object
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Tool") or ancestor:IsA("Accessory") or ancestor:FindFirstChildOfClass("Humanoid") then
            return nil, "CarriedIngredient"
        end
        if CollectionService:HasTag(ancestor, "PlayerStash") then
            return nil, "StashedIngredient"
        end
        ancestor = ancestor.Parent
    end
    local record = services.IngredientService.GetRecord(object)
    if not record then
        return nil, "InvalidWorldItem"
    end
    if record.FarmManaged then
        return nil, "FarmCrop"
    end
    if record.MuncherImmune then
        return nil, "OutputImmune"
    end
    if record.Reserved then
        return nil, "AlreadyReserved"
    end
    if not record.Claimable or object:GetAttribute("FrozenUntilPickup") == true then
        return nil, "InvalidWorldItem"
    end
    local actor = record.FeedingActor or record.Owner
    if not actor then
        return nil, "MissingAttribution"
    end
    if record.FeedingActor and record.Owner and record.FeedingActor ~= record.Owner then
        return nil, "UnauthorizedOwner"
    end
    local authority = services.TycoonService
    if
        not authority.IsMember(actor, zone)
        or (record.FeedingSessionId and record.FeedingSessionId ~= authority.GetSessionId(actor))
    then
        return nil, "UnauthorizedOwner"
    end
    local root = WorldUtil.Part(object)
    if not root or root.Anchored then
        return nil, "InvalidWorldItem"
    end
    -- Reject registered items welded outside their own multipart assembly, including
    -- overhead carry rigs. FarmManaged above protects even unanchored crops.
    for _, part in root:GetConnectedParts(true) do
        if part.Anchored or (part ~= object and not part:IsDescendantOf(object)) then
            return nil, "CarriedIngredient"
        end
    end
    return actor, nil, root
end
return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">PhysicsService</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local PhysicsService = {}

function PhysicsService.GetSpinStrength(part: BasePart): number
    if not part or not part:IsA("BasePart") then
        return 0
    end

    local angularVelocity = part.AssemblyAngularVelocity
    return angularVelocity.Magnitude
end

function PhysicsService.GetBlendDelta(part: BasePart, deltaTime: number?): number
    -- Preserve the old one-argument API; dt-aware callers no longer depend on framerate.
    return PhysicsService.GetSpinStrength(part) * Economy.BlendProgressScale * (deltaTime or 1 / 60)
end

-- Display/debugging only; gameplay uses angular speed directly.
function PhysicsService.GetRPM(part: BasePart): number
    return PhysicsService.GetSpinStrength(part) * 60 / (2 * math.pi)
end

return PhysicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local Upgrades = require(game:GetService("ReplicatedStorage").Shared.Constants.Upgrades)
local PlayerDataService = {}
local records: { [Player]: Types.PersonalPlayerData } = {}
local runtime: any
function PlayerDataService.BindRuntimeAuthority(authority: any)
    runtime = authority
end
local entitlements: { [Player]: { [string]: boolean } } = {}

local function data(player: Player): Types.PersonalPlayerData
    assert(records[player], "PlayerDataService: player is not initialized")
    return records[player]
end
function PlayerDataService.AddPlayer(player: Player)
    records[player] = {
        Upgrades = {
            CarryCapacity = 1,
            StackSize = 1,
        },
        Discoveries = {},
        Discovery = { Ingredients = {}, SpecialCustomers = {} },
        Stats = { CustomersServed = 0, SmoothiesMade = 0, PlayersSlapped = 0, IngredientsStolen = 0 },
    }
    entitlements[player] = { VIPStorage = false, DoubleCash = false }
    player:SetAttribute("playerCash", 0)
    player:SetAttribute("HasSmoothie", false)
    player:SetAttribute("CarryCapacity", Upgrades.CarryCapacity[1].Value)
    player:SetAttribute("CarryCapacityLevel", 0)
    for _, id in { "Bat", "MovementSpeed", "Jump", "SprintStamina" } do
        player:SetAttribute(id .. "Level", 0)
    end
end
-- Server-only mutable save-data boundary. Older in-memory profiles may omit Discovery.
function PlayerDataService.GetDiscoveryState(player: Player): Types.DiscoveryState?
    local record = records[player]
    if not record then
        return nil
    end
    local discovery: Types.DiscoveryState = record.Discovery or { Ingredients = {}, SpecialCustomers = {} }
    discovery.Ingredients = discovery.Ingredients or {}
    discovery.SpecialCustomers = discovery.SpecialCustomers or {}
    record.Discovery = discovery
    return discovery
end
function PlayerDataService.GetSnapshot(player: Player): Types.PlayerData
    local source = data(player)
    local discovery = PlayerDataService.GetDiscoveryState(player) :: Types.DiscoveryState
    return {
        Discovery = {
            Ingredients = table.clone(discovery.Ingredients),
            SpecialCustomers = table.clone(discovery.SpecialCustomers),
        },
        Cash = PlayerDataService.GetCash(player),
        Upgrades = {
            Bat = PlayerDataService.GetUpgrade(player, "Bat"),
            Hand = PlayerDataService.GetUpgrade(player, "Hand"),
            CarryCapacity = PlayerDataService.GetUpgrade(player, "CarryCapacity"),
            StackSize = PlayerDataService.GetUpgrade(player, "StackSize"),
            BlendSpeed = PlayerDataService.GetUpgrade(player, "BlendSpeed"),
            Payout = PlayerDataService.GetUpgrade(player, "Payout"),
            MovementSpeed = PlayerDataService.GetUpgrade(player, "MovementSpeed"),
            Jump = PlayerDataService.GetUpgrade(player, "Jump"),
            SprintStamina = PlayerDataService.GetUpgrade(player, "SprintStamina"),
        },
        Discoveries = table.clone(source.Discoveries),
        Stats = table.clone(source.Stats),
    }
end
-- Compatibility projection only: no personal cash or shared-upgrade copies are stored.
function PlayerDataService.GetCash(player: Player): number
    return if runtime then runtime.GetCash(player) else 0
end
function PlayerDataService.SetCash(player: Player, amount: number): number
    assert(runtime, "Session authority is not bound")
    return runtime.SetCash(player, amount)
end
function PlayerDataService.AddCash(player: Player, amount: number): number
    assert(runtime, "Session authority is not bound")
    return runtime.AddCash(player, amount)
end
function PlayerDataService.GetUpgrade(player: Player, id: string): number
    if id ~= "CarryCapacity" and id ~= "StackSize" then
        return if runtime then runtime.GetUpgrade(player, id) else 1
    end
    return (data(player).Upgrades :: any)[id] or 1
end
function PlayerDataService.PurchaseUpgrade(
    player: Player,
    id: string,
    requestedLevel: number?,
    context: any
): (boolean, string?)
    if not runtime then
        return false, "NoSession"
    end
    if runtime.IsSharedUpgrade(id) then
        return runtime.PurchaseUpgrade(player, id, requestedLevel, context)
    end
    if id ~= "CarryCapacity" and id ~= "StackSize" then
        return false, "InvalidUpgrade"
    end
    local levels = (Upgrades :: any)[id]
    local nextLevel = PlayerDataService.GetUpgrade(player, id) + 1
    if requestedLevel ~= nextLevel then
        return false, "InvalidLevel"
    end
    local definition = levels[nextLevel]
    if not definition then
        return false, "MaxLevel"
    end
    return runtime.PurchasePersonalUpgrade(player, context, definition.Cost, function()
        (data(player).Upgrades :: any)[id] = nextLevel
        if id == "CarryCapacity" then
            player:SetAttribute("CarryCapacity", definition.Value)
            player:SetAttribute("CarryCapacityLevel", nextLevel - 1)
        end
    end)
end
function PlayerDataService.HasEntitlement(player: Player, id: string): boolean
    return entitlements[player] ~= nil and entitlements[player][id] == true
end
-- Server-only boundary for a future verified MarketplaceService entitlement adapter.
function PlayerDataService.SetEntitlement(player: Player, id: string, enabled: boolean)
    assert(id == "VIPStorage" or id == "DoubleCash", "Unknown entitlement")
    entitlements[player][id] = enabled
end
function PlayerDataService.RecordDiscovery(player: Player, id: string)
    data(player).Discoveries[id] = true
end
function PlayerDataService.IncrementStat(player: Player, id: string)
    local stats = data(player).Stats :: any
    assert(stats[id] ~= nil, "Unknown stat")
    stats[id] += 1
end
function PlayerDataService.RemovePlayer(player: Player)
    -- TODO: persist a snapshot before releasing state; no DataStore writes in this skeleton.
    records[player] = nil
    entitlements[player] = nil
end
return require(script.Parent.StudioServices).Wrap("PlayerDataService", PlayerDataService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">PlayerHeadDropService</string>
            <string name="Source"><![CDATA[--!strict
-- Observe actual character death; damage and ingredient ownership stay in their services.
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Item = require(game:GetService("ReplicatedStorage").Shared.IngredientItem)
local Service = {}
local deps: any
local states: { [Player]: { Character: Model, Connections: { RBXScriptConnection } } } = {}
-- Retain the guard through teardown/rebinding, without keeping old characters alive.
local observed = setmetatable({} :: { [Model]: boolean }, { __mode = "k" })

function Service.Init(services: any)
    deps = services
end

function Service.RemovePlayer(player: Player)
    local state = states[player]
    if state then
        states[player] = nil
        for _, connection in state.Connections do
            connection:Disconnect()
        end
    end
end

function Service.ApplyCharacter(player: Player, character: Model)
    if player.Character ~= character or Players:GetPlayerFromCharacter(character) ~= player then
        return
    end
    if states[player] and states[player].Character == character then
        return
    end
    Service.RemovePlayer(player)
    if observed[character] then
        return
    end
    observed[character] = true
    local state = { Character = character, Connections = {} :: { RBXScriptConnection } }
    states[player] = state
    local bound, dropped = false, false
    local function bind(humanoid: Humanoid)
        if bound or states[player] ~= state then
            return
        end
        bound = true
        table.insert(
            state.Connections,
            humanoid.Died:Connect(function()
                if
                    dropped
                    or states[player] ~= state
                    or player.Character ~= character
                    or Players:GetPlayerFromCharacter(character) ~= player
                then
                    return
                end
                dropped = true -- Reserve before spawning or publishing any world item.
                local at = character:GetPivot()
                for _, name in { "Head", "UpperTorso", "HumanoidRootPart" } do
                    local part = character:FindFirstChild(name)
                    if part and part:IsA("BasePart") then
                        at = part.CFrame
                        break
                    end
                end
                local unit = Item.New("PlayerHead", HttpService:GenerateGUID(false), "Unknown")
                unit.SourceUserId = player.UserId
                unit.SourceDisplayName = player.DisplayName
                unit.SourceUsername = player.Name
                deps.IngredientService.Spawn(
                    "PlayerHead",
                    CFrame.new(at.Position + Vector3.new(0.75, 0.5, 0)),
                    nil,
                    true,
                    {
                        Item = unit,
                        VisualTemplate = character:FindFirstChild("Head"),
                    }
                )
            end)
        )
    end
    table.insert(
        state.Connections,
        player.CharacterRemoving:Connect(function(removing: Model)
            if removing == character and states[player] == state then
                Service.RemovePlayer(player)
            end
        end)
    )
    -- CharacterAdded may arrive before the Humanoid. Bind without blocking bootstrap.
    table.insert(
        state.Connections,
        character.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then
                bind(child)
            end
        end)
    )
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        bind(humanoid)
    end
end

return require(script.Parent.StudioServices).Wrap("PlayerHeadDropService", Service)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">PlayerOnlyCollisionService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")

local PlayerOnlyCollisionService = { PlayerGroup = "Players" }
local HELPER_GROUP = "PlayerOnly"
local TAG = "PlayerOnlyCollision"
local initialized = false
local controlled: { [BasePart]: boolean } = {}

local function configurePart(instance: Instance)
    if instance:IsA("BasePart") then
        instance.CollisionGroup = HELPER_GROUP
        instance.CanCollide = if controlled[instance] ~= nil then controlled[instance] else true
    end
end

-- Scoped server override. Tags and all other helper behavior remain intact.
function PlayerOnlyCollisionService.SetControlled(part: BasePart, enabled: boolean)
    controlled[part] = enabled
    configurePart(part)
end

function PlayerOnlyCollisionService.ReleaseControlled(part: BasePart)
    controlled[part] = nil
    -- A detached security wall stays inactive until explicitly bound again.
    part.CanCollide = false
end

function PlayerOnlyCollisionService.Init()
    if initialized then
        return
    end
    for _, name in { PlayerOnlyCollisionService.PlayerGroup, HELPER_GROUP } do
        if not PhysicsService:IsCollisionGroupRegistered(name) then
            PhysicsService:RegisterCollisionGroup(name)
        end
    end
    -- Only the new helper's relationships change; all existing pairs stay intact.
    -- This includes any ingredient/world-item groups authored in Studio.
    for _, group in PhysicsService:GetRegisteredCollisionGroups() do
        PhysicsService:CollisionGroupSetCollidable(HELPER_GROUP, group.name, false)
    end
    PhysicsService:CollisionGroupSetCollidable(HELPER_GROUP, PlayerOnlyCollisionService.PlayerGroup, true)
    initialized = true

    CollectionService:GetInstanceAddedSignal(TAG):Connect(configurePart)
    for _, instance in CollectionService:GetTagged(TAG) do
        configurePart(instance)
    end
end

return PlayerOnlyCollisionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">PlotClaimZones</string>
            <string name="Source"><![CDATA[--!strict
-- Server samples live character roots in authored oriented boxes. No client entry
-- report or Touched callback can authorize a claim. Session creation never yields.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Constants.StandIdentity)
local Sign = require(script.Parent.StandSignPresentation)
local MovementService = require(script.Parent.MovementService)
local Zones = {}
local authority: any
local claimed: RemoteEvent
local visuals: { [BasePart]: number } = setmetatable({}, { __mode = "k" }) :: any
local styled: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local entered: { [BasePart]: { [Player]: Model } } = {}
local pendingEntry: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any

function Zones.Inside(zone: BasePart, position: Vector3): boolean
    local point = zone.CFrame:PointToObjectSpace(position)
    local half = zone.Size * 0.5
    return math.abs(point.X) <= half.X and math.abs(point.Y) <= half.Y and math.abs(point.Z) <= half.Z
end

function Zones.Enter(player: Player, plot: Instance, zone: BasePart): boolean
    local identity = plot:FindFirstChild("PlotIdentity")
    local character = player.Character
    local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
    local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
    if
        not MovementService.CanPerformGameplayAction(player)
        or not player:IsDescendantOf(Players)
        or not character
        or not character:IsDescendantOf(workspace)
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
        or not CollectionService:HasTag(plot, "PlayerPlot")
        or not plot:IsDescendantOf(workspace)
        or not identity
        or zone.Parent ~= identity
        or not Zones.Inside(zone, root.Position)
    then
        return false
    end
    if identity:FindFirstChild("ClaimZone") == zone then
        local success =
            authority.ClaimPlot(player, plot, { ClaimRevision = plot:GetAttribute("PlotClaimRevision") or 0 })
        if success and authority.GetOwner(plot) == player then
            local context = authority.GetRequestContext(player)
            claimed:FireClient(player, plot, context.PlotSessionId, context.MembershipRevision)
        end
        return success
    elseif identity:FindFirstChild("TeammateZone") == zone then
        local owner = authority.GetOwner(plot)
        return owner ~= nil
            and owner ~= player
            and authority.RequestJoin(player, plot, authority.GetRequestContext(owner))
    end
    return false
end

local function showVisual(object: Instance?, active: boolean)
    if not object then
        return
    end
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            if visuals[part] == nil then
                -- Hidden authored pads still need a visible active appearance.
                -- ActiveTransparency also lets nested invisible helpers stay invisible.
                local authored = part:GetAttribute("ActiveTransparency")
                visuals[part] = if type(authored) == "number"
                        and authored >= 0
                        and authored <= 1
                    then authored
                    elseif part.Transparency < 1 then part.Transparency
                    else 0
            end
            part.Transparency = if active then visuals[part] else 1
        end
    end
end

function Zones.Refresh(plot: Instance)
    local occupancy = plot:GetAttribute("PlotOccupancy") or 0
    local identity = plot:FindFirstChild("PlotIdentity")
    if identity then
        for _, role in { "Claim", "Teammate" } do
            local active = if role == "Claim" then occupancy == 0 else occupancy == 1
            local zone = identity:FindFirstChild(role .. "Zone")
            if zone and zone:IsA("BasePart") then
                zone.Transparency, zone.CanCollide, zone.CanTouch, zone.CanQuery = 1, false, false, false
                zone:SetAttribute("PlotZoneActive", active)
            end
            showVisual(identity:FindFirstChild(role .. "Visual"), active)
        end
    end
    local area = plot:FindFirstChild("Customer Area")
    local sign = if area then area:FindFirstChild("Dynamic Sign Text") else nil
    if sign then
        local gui = sign:FindFirstChild("SurfaceGui")
        if gui and not styled[gui] then
            Sign.Style(sign)
            styled[gui] = true
        end
        Sign.SetStandName(sign, tostring(plot:GetAttribute("StandName") or ""))
    end
end

function Zones.Step()
    local live: { [BasePart]: boolean } = {}
    for _, plot in CollectionService:GetTagged("PlayerPlot") do
        if not plot:IsDescendantOf(workspace) then
            continue
        end
        Zones.Refresh(plot)
        local identity = plot:FindFirstChild("PlotIdentity")
        if not identity then
            continue
        end
        for _, name in { "ClaimZone", "TeammateZone" } do
            local zone = identity:FindFirstChild(name)
            if not zone or not zone:IsA("BasePart") then
                continue
            end
            live[zone] = true
            local previous = entered[zone] or {}
            local current: { [Player]: Model } = {}
            local arrivals: { Player } = {}
            for _, player in Players:GetPlayers() do
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root and root:IsA("BasePart") and Zones.Inside(zone, root.Position) then
                    current[player] = player.Character :: Model
                    if previous[player] ~= player.Character and zone:GetAttribute("PlotZoneActive") then
                        table.insert(arrivals, player)
                    end
                end
            end
            entered[zone] = current
            -- Record entry before dispatch. Friendship policies can yield; the
            -- heartbeat must keep sampling without launching duplicate joins.
            for _, player in arrivals do
                if not pendingEntry[player] then
                    pendingEntry[player] = true
                    task.spawn(function()
                        local ok, message = pcall(Zones.Enter, player, plot, zone)
                        pendingEntry[player] = nil
                        if not ok then
                            warn("[PlotClaimZones] " .. tostring(message))
                        end
                        if plot:IsDescendantOf(workspace) then
                            Zones.Refresh(plot)
                        end
                    end)
                end
            end
        end
    end
    for zone in entered do
        if not live[zone] then
            entered[zone] = nil
        end
    end
end

function Zones.Init(services: any)
    authority = services.TycoonService
    claimed = Instance.new("RemoteEvent")
    claimed.Name = "PlotClaimed"
    claimed.Parent = ReplicatedStorage.Shared.Events
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed >= Config.ZoneInterval then
            elapsed = 0
            Zones.Step()
        end
    end)
end

return Zones
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="140">
          <Properties>
            <string name="Name">RagdollService</string>
            <string name="Source"><![CDATA[--!strict
-- Native Avatar Joint Upgrade R15 physics only. No combat, input, inventory or gameplay stun dependencies.
local RunService = game:GetService("RunService")
local RagdollService = {}
local ragdollChanged = Instance.new("BindableEvent")
RagdollService.Changed = ragdollChanged.Event
type JointState = {
    IsKinematic: boolean,
    MaxForce: number,
    MaxTorque: number,
    LinearStrength: number,
    LinearDamping: number,
    AngularStrength: number,
    AngularDamping: number,
}
type Joint = { Constraint: AnimationConstraint, Saved: JointState }
type Rig = {
    Humanoid: Humanoid,
    Root: AnimationConstraint,
    Joints: { Joint },
    Sockets: { BallSocketConstraint },
    TorsoCollision: { [BasePart]: boolean },
    LimbCollision: { [BasePart]: boolean },
    Connections: { RBXScriptConnection },
    Active: boolean,
    PlatformStand: boolean,
    AutoRotate: boolean,
}
local rigs: { [Model]: Rig } = {}
local limbNames: { [string]: boolean } = {}
for _, side in { "Left", "Right" } do
    for _, segment in { "UpperArm", "LowerArm", "Hand", "UpperLeg", "LowerLeg", "Foot" } do
        limbNames[side .. segment] = true
    end
end
-- Expected avatar body pairs. Root is validated separately and never modified.
local joints: { [string]: { string } } = {
    Neck = { "UpperTorso", "Head" },
    Waist = { "LowerTorso", "UpperTorso" },
    LeftShoulder = { "UpperTorso", "LeftUpperArm" },
    LeftElbow = { "LeftUpperArm", "LeftLowerArm" },
    LeftWrist = { "LeftLowerArm", "LeftHand" },
    RightShoulder = { "UpperTorso", "RightUpperArm" },
    RightElbow = { "RightUpperArm", "RightLowerArm" },
    RightWrist = { "RightLowerArm", "RightHand" },
    LeftHip = { "LowerTorso", "LeftUpperLeg" },
    LeftKnee = { "LeftUpperLeg", "LeftLowerLeg" },
    LeftAnkle = { "LeftLowerLeg", "LeftFoot" },
    RightHip = { "LowerTorso", "RightUpperLeg" },
    RightKnee = { "RightUpperLeg", "RightLowerLeg" },
    RightAnkle = { "RightLowerLeg", "RightFoot" },
}

-- Optional read-only Studio inventory, retained for inspecting runtime failures.
function RagdollService.InspectCharacter(character: Model)
    assert(RunService:IsStudio() and RunService:IsServer(), "Use the Studio Server Command Bar")
    local function path(object: Instance?): string
        return if object then object:GetFullName() else "nil"
    end
    local function property(object: Instance, name: string): string
        local ok, value = pcall(function()
            return (object :: any)[name]
        end)
        return if ok then tostring(value) else "unavailable"
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    print(
        string.format(
            "[Ragdoll] inspect character=%s rig=%s StarterPlayer.AvatarJointUpgrade=%s",
            path(character),
            if humanoid then tostring(humanoid.RigType) else "missing Humanoid",
            property(game:GetService("StarterPlayer"), "AvatarJointUpgrade")
        )
    )
    local counts: { [string]: number } = {
        AnimationConstraint = 0,
        Motor6D = 0,
        BallSocketConstraint = 0,
        NoCollisionConstraint = 0,
    }
    local discovered: { [string]: { string } } = {}
    local descendants = character:GetDescendants()
    table.sort(descendants, function(a, b)
        return a:GetFullName() < b:GetFullName()
    end)
    for _, object in descendants do
        local class = object.ClassName
        if counts[class] ~= nil then
            counts[class] += 1
        end
        local a: Instance? = nil
        local b: Instance? = nil
        if object:IsA("Motor6D") or object:IsA("NoCollisionConstraint") then
            a, b = object.Part0, object.Part1
            print(
                string.format(
                    "[Ragdoll] %s %s Part0=%s Part1=%s Enabled=%s",
                    class,
                    path(object),
                    path(a),
                    path(b),
                    tostring(object.Enabled)
                )
            )
        elseif object:IsA("Constraint") then
            local first, second = object.Attachment0, object.Attachment1
            a, b = if first then first.Parent else nil, if second then second.Parent else nil
            print(
                string.format(
                    "[Ragdoll] %s %s Attachment0=%s parent0=%s Attachment1=%s parent1=%s Enabled=%s",
                    class,
                    path(object),
                    path(first),
                    path(a),
                    path(second),
                    path(b),
                    tostring(object.Enabled)
                )
            )
            if class == "AnimationConstraint" then
                for _, name in
                    {
                        "IsKinematic",
                        "MaxForce",
                        "MaxTorque",
                        "LinearStrength",
                        "LinearDamping",
                        "AngularStrength",
                        "AngularDamping",
                    }
                do
                    print("[Ragdoll]   " .. name .. "=" .. property(object, name))
                end
            elseif object:IsA("BallSocketConstraint") then
                print(
                    string.format(
                        "[Ragdoll]   LimitsEnabled=%s UpperAngle=%s TwistLimitsEnabled=%s TwistLowerAngle=%s TwistUpperAngle=%s",
                        tostring(object.LimitsEnabled),
                        tostring(object.UpperAngle),
                        tostring(object.TwistLimitsEnabled),
                        tostring(object.TwistLowerAngle),
                        tostring(object.TwistUpperAngle)
                    )
                )
            end
        end
        if a and b and a.Parent == character and b.Parent == character then
            local key = a.Name .. "/" .. b.Name
            discovered[key] = discovered[key] or {}
            table.insert(discovered[key], class .. ":" .. object.Name)
        end
    end
    for class, count in counts do
        print(string.format("[Ragdoll] %s count=%d", class, count))
    end
    local expected = table.clone(joints)
    expected.Root = { "HumanoidRootPart", "LowerTorso" }
    for name, pair in expected do
        local forward = discovered[pair[1] .. "/" .. pair[2]] or {}
        local reverse = discovered[pair[2] .. "/" .. pair[1]] or {}
        print(
            string.format(
                "[Ragdoll] expected=%s pair=%s/%s forward=[%s] reverse=[%s]",
                name,
                pair[1],
                pair[2],
                table.concat(forward, ", "),
                table.concat(reverse, ", ")
            )
        )
    end
    print("[Ragdoll] inspection complete; no character properties changed")
end

local function capture(joint: AnimationConstraint): JointState
    return {
        IsKinematic = joint.IsKinematic,
        MaxForce = joint.MaxForce,
        MaxTorque = joint.MaxTorque,
        LinearStrength = joint.LinearStrength,
        LinearDamping = joint.LinearDamping,
        AngularStrength = joint.AngularStrength,
        AngularDamping = joint.AngularDamping,
    }
end

local function reject(reason: string): boolean
    warn("[Ragdoll] rejected jointSystem=AnimationConstraint: " .. reason)
    return false
end

-- Resolve the owning body part, including Roblox's nested JointRotation attachments.
local function bodyOf(attachment: Attachment?): BasePart?
    local object: Instance? = attachment
    while object do
        if object:IsA("BasePart") then
            return object
        end
        object = object.Parent
    end
    return nil
end

local function matches(character: Model, constraint: AnimationConstraint, pair: { string }): boolean
    local a, b = bodyOf(constraint.Attachment0), bodyOf(constraint.Attachment1)
    return a ~= nil
        and b ~= nil
        and a.Parent == character
        and b.Parent == character
        and ((a.Name == pair[1] and b.Name == pair[2]) or (a.Name == pair[2] and b.Name == pair[1]))
end

function RagdollService.IsRagdolled(character: Model): boolean
    local rig = rigs[character]
    return rig ~= nil and rig.Active
end

function RagdollService.PrepareCharacter(character: Model): boolean
    assert(RunService:IsServer(), "RagdollService is server-only")
    if rigs[character] then
        return true
    end
    local h = character:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 or h.RigType ~= Enum.HumanoidRigType.R15 then
        return reject("a living R15 Humanoid is required")
    end
    local found: { [string]: AnimationConstraint } = {}
    local sockets: { [string]: BallSocketConstraint } = {}
    for _, object in character:GetDescendants() do
        if object:IsA("AnimationConstraint") and (object.Name == "Root" or joints[object.Name]) then
            local pair = if object.Name == "Root" then { "HumanoidRootPart", "LowerTorso" } else joints[object.Name]
            if not matches(character, object, pair) or not object.Enabled then
                return reject("invalid/disabled avatar AnimationConstraint " .. object.Name)
            end
            if found[object.Name] then
                return reject("duplicate avatar AnimationConstraint " .. object.Name)
            end
            found[object.Name] = object
        elseif object:IsA("BallSocketConstraint") then
            -- Validate the built-in named sockets without demanding identical attachments
            -- or rebuilding their articulation. Shoulders can use nested JointRotation.
            sockets[object.Name] = object
        end
    end
    local root = found.Root
    if not root or not root.IsKinematic then
        return reject("enabled kinematic Root AnimationConstraint required")
    end
    local rig: Rig = {
        Humanoid = h,
        Root = root,
        Joints = {},
        Sockets = {},
        TorsoCollision = {},
        LimbCollision = {},
        Connections = {},
        Active = false,
        PlatformStand = h.PlatformStand,
        AutoRotate = h.AutoRotate,
    }
    for name in joints do
        local joint, socket = found[name], sockets[name .. "BallSocket"]
        if not joint then
            return reject("missing body AnimationConstraint " .. name)
        end
        if
            not socket
            or not socket.Enabled
            or not socket.Attachment0
            or not socket.Attachment1
            or not socket.Attachment0:IsDescendantOf(character)
            or not socket.Attachment1:IsDescendantOf(character)
        then
            return reject("missing/disabled built-in " .. name .. "BallSocket or its attachments")
        end
        table.insert(rig.Joints, { Constraint = joint, Saved = capture(joint) })
        table.insert(rig.Sockets, socket)
    end
    rigs[character] = rig
    for _, body in character:GetChildren() do
        if body:IsA("BasePart") and limbNames[body.Name] then
            table.insert(
                rig.Connections,
                body:GetPropertyChangedSignal("CanCollide"):Connect(function()
                    if rig.Active and rig.LimbCollision[body] ~= nil and body.CanCollide then
                        body.CanCollide = false
                    end
                end)
            )
        end
    end
    table.insert(
        rig.Connections,
        h.Died:Connect(function()
            RagdollService.CleanupCharacter(character)
        end)
    )
    table.insert(
        rig.Connections,
        character.Destroying:Connect(function()
            RagdollService.CleanupCharacter(character)
        end)
    )
    table.insert(
        rig.Connections,
        character.AncestryChanged:Connect(function()
            if not character:IsDescendantOf(workspace) then
                RagdollService.CleanupCharacter(character)
            end
        end)
    )
    if RunService:IsStudio() then
        print("[Ragdoll] prepared rig=R15 jointSystem=AnimationConstraint bodyJoints=14 root=Root")
    end
    return true
end

function RagdollService.SetRagdolled(character: Model, enabled: boolean): boolean
    assert(RunService:IsServer(), "RagdollService is server-only")
    if enabled and not RagdollService.PrepareCharacter(character) then
        return false
    end
    local rig = rigs[character]
    if not rig or rig.Active == enabled then
        return true
    end
    local h = rig.Humanoid
    local changed = 0
    if enabled then
        -- Reject a rig changed since preparation before altering any physical state.
        if
            h.Health <= 0
            or not rig.Root:IsDescendantOf(character)
            or not rig.Root.Enabled
            or not rig.Root.IsKinematic
        then
            return reject("rig no longer has a living Humanoid and kinematic Root")
        end
        for _, joint in rig.Joints do
            if not joint.Constraint:IsDescendantOf(character) or not joint.Constraint.Enabled then
                return reject("body AnimationConstraint removed/disabled since preparation")
            end
        end
        for _, socket in rig.Sockets do
            if not socket:IsDescendantOf(character) or not socket.Enabled then
                return reject("built-in BallSocket removed/disabled since preparation")
            end
        end
        -- Refresh snapshots at each OFF -> ON edge; repeated ON cannot overwrite them.
        local upper, lower = character:FindFirstChild("UpperTorso"), character:FindFirstChild("LowerTorso")
        if not upper or not upper:IsA("BasePart") or not lower or not lower:IsA("BasePart") then
            return reject("UpperTorso and LowerTorso required for core world collision")
        end
        rig.TorsoCollision = { [upper] = upper.CanCollide, [lower] = lower.CanCollide }
        rig.LimbCollision = {}
        for _, body in character:GetChildren() do
            if body:IsA("BasePart") and limbNames[body.Name] then
                rig.LimbCollision[body] = body.CanCollide
                body.CanCollide = false
            end
        end
        rig.PlatformStand, rig.AutoRotate = h.PlatformStand, h.AutoRotate
        for _, joint in rig.Joints do
            joint.Saved = capture(joint.Constraint)
        end
        rig.Active = true
        h.AutoRotate, h.PlatformStand = false, true
        for torso in rig.TorsoCollision do
            torso.CanCollide = true
        end
        for _, joint in rig.Joints do
            local constraint = joint.Constraint
            constraint.MaxForce, constraint.MaxTorque = 0, 0
            constraint.IsKinematic = false
            changed += 1
        end
        h:ChangeState(Enum.HumanoidStateType.Physics)
    else
        rig.Active = false -- Release collision guards before restoring healthy snapshots.
        for _, joint in rig.Joints do
            local constraint, saved = joint.Constraint, joint.Saved
            if constraint.Parent then
                constraint.MaxForce, constraint.MaxTorque = saved.MaxForce, saved.MaxTorque
                constraint.LinearStrength, constraint.LinearDamping = saved.LinearStrength, saved.LinearDamping
                constraint.AngularStrength, constraint.AngularDamping = saved.AngularStrength, saved.AngularDamping
                constraint.IsKinematic = saved.IsKinematic
                changed += 1
            end
        end
        for torso, canCollide in rig.TorsoCollision do
            if torso.Parent then
                torso.CanCollide = canCollide
            end
        end
        for limb, canCollide in rig.LimbCollision do
            if limb.Parent then
                limb.CanCollide = canCollide
            end
        end
        if h.Parent then
            h.PlatformStand, h.AutoRotate = rig.PlatformStand, rig.AutoRotate
            if h.Health > 0 and not rig.PlatformStand then
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
        rig.Active = false
    end
    ragdollChanged:Fire(character, enabled)
    if RunService:IsStudio() then
        if enabled then
            print(string.format("[Ragdoll] ON changed=%d RootKinematic=%s", changed, tostring(rig.Root.IsKinematic)))
        else
            print(string.format("[Ragdoll] OFF restored=%d", changed))
        end
    end
    return true
end

-- Reapply the last known healthy joint/collision snapshot even if OFF already ran.
-- Caller must validate recent ragdoll history and reject gameplay locks/death.
function RagdollService.RecoverCharacter(character: Model): boolean
    local rig = rigs[character]
    if not rig or rig.Humanoid.Health <= 0 then
        return false
    end
    if not rig.Root:IsDescendantOf(character) or not rig.Root.Enabled or not rig.Root.IsKinematic then
        return false
    end
    for _, joint in rig.Joints do
        if not joint.Constraint:IsDescendantOf(character) then
            return false
        end
    end
    for _, socket in rig.Sockets do
        if not socket:IsDescendantOf(character) or not socket.Enabled then
            return false
        end
    end
    for _, joint in rig.Joints do
        joint.Constraint.Enabled = true
    end
    rig.Active = true
    return RagdollService.SetRagdolled(character, false)
end

function RagdollService.CleanupCharacter(character: Model)
    local rig = rigs[character]
    if not rig then
        return
    end
    RagdollService.SetRagdolled(character, false)
    rigs[character] = nil
    for _, connection in rig.Connections do
        connection:Disconnect()
    end
end

return require(script.Parent.StudioServices).Wrap("RagdollService", RagdollService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="141">
          <Properties>
            <string name="Name">RejectFloorButton</string>
            <string name="Source"><![CDATA[--!strict
local FloorButton = {}

-- A downward ground query verifies actual support, rather than counting limb
-- touches from someone brushing past the plate or standing beside it.
local function standing(actor: Player, button: BasePart): boolean
    local character = actor.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then
        return false
    end
    if root.AssemblyLinearVelocity.Y > 2 then
        return false
    end
    local leg = character and character:FindFirstChild("Left Leg")
    local legHeight = if leg and leg:IsA("BasePart") then leg.Size.Y else 0
    local distance = root.Size.Y / 2 + humanoid.HipHeight + legHeight + 0.5
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character :: Model }
    params.RespectCanCollide = true
    local hit = workspace:Raycast(root.Position, Vector3.new(0, -distance, 0), params)
    return hit ~= nil and hit.Instance == button
end

-- Retained support helper for LockBase. The legacy REJECT UI/action is retired.
FloorButton.IsStanding = standing

return FloorButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="142">
          <Properties>
            <string name="Name">ScrapbookPreviewAssets</string>
            <string name="Source"><![CDATA[--!strict
local ServerStorage = game:GetService("ServerStorage")
local Shared = game:GetService("ReplicatedStorage").Shared
local Allowed = require(Shared.Constants.ScrapbookPreviews)
local Geometry = require(Shared.IngredientPreviewGeometry)
local Assets = {}

function Assets.Init()
    local previous = Shared:FindFirstChild("ScrapbookPreviewAssets")
    if previous then
        previous:Destroy()
    end
    local folder = Instance.new("Folder")
    folder.Name = "ScrapbookPreviewAssets"
    local sources = ServerStorage:FindFirstChild("Ingredients")
    for id in Allowed :: { [string]: boolean } do
        local model = Geometry.Clone(if sources then sources:FindFirstChild(id) else nil)
        if model then
            model.Name = id
            model.Parent = folder
        else
            warn("[Scrapbook] Preview prefab unavailable: " .. id)
        end
    end
    -- Publish only sanitized allowlisted visuals. No remotes or inventory APIs.
    folder.Parent = Shared
end

return Assets
]]></string>
