        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">BadCustomerBehavior</string>
            <string name="Source"><![CDATA[--!strict
-- CustomerService owns claims/queue/economy. This helper only runs cancellable routes/physics.
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BadCustomers)
local Walk = require(script.Parent.CustomerWalk)
local Placement = require(script.Parent.CustomerPlacement)
local Knockback = require(script.Parent.BatKnockback)
local RunService = game:GetService("RunService")
local Behavior = {}

local function route(record: any, context: any, name: string, finished: () -> ())
    if not context.Valid() then
        return
    end
    local marker = context.Marker(name)
    if not marker then
        finished()
        return
    end
    Walk.Move(record, Placement.AtMarker(marker, record.BottomOffset), function(reached)
        if not context.Valid() then
            return
        end
        if reached then
            finished()
        else
            context.Destroy()
        end
    end)
end

function Behavior.Thief(record: any, context: any)
    task.delay(Config.BehaviorTimeout, function()
        if context.Valid() then
            context.Destroy()
        end
    end)
    local function escape()
        if not context.Valid() then
            return
        end
        record.State = "Escaping"
        route(record, context, "CustomerWait2", context.Exit)
    end
    if record.State == "Escaping" then
        escape()
        return
    end
    if not context.Marker("CustomerThiefPoint") then
        if RunService:IsStudio() then
            warn("[Customer] Missing CustomerThiefPoint; skipping theft")
        end
        escape()
        return
    end
    route(record, context, "CustomerThiefPoint", function()
        task.delay(Config.TheftWindup, function()
            if context.Valid() and record.State == "Stealing" then
                context.Theft()
                escape()
            end
        end)
    end)
end

function Behavior.Reject(record: any, context: any, ragdoll: any)
    local model, root = record.Model, record.Root
    local tuning = Config.Reject
    local ok, enabled = pcall(function()
        return ragdoll.SetRagdolled(model, true)
    end)
    if not ok or enabled ~= true then
        context.Destroy()
        return
    end
    local started = os.clock()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    params.RespectCanCollide = true
    local function poll()
        if not context.Valid() then
            return
        end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if
            not root.Parent
            or not humanoid
            or humanoid.Health <= 0
            or root.Position.Y <= workspace.FallenPartsDestroyHeight + 10
            or os.clock() - started >= tuning.LandingTimeout
        then
            context.Destroy()
            return
        end
        local floor = workspace:Raycast(
            root.Position,
            Vector3.new(0, -(record.BottomOffset + tuning.LandingClearance), 0),
            params
        )
        if os.clock() - started >= tuning.MinimumFlight and root.AssemblyLinearVelocity.Y <= 3 and floor then
            task.delay(tuning.RecoveryDelay, function()
                if not context.Valid() then
                    return
                end
                local restored, result = pcall(function()
                    return ragdoll.SetRagdolled(model, false)
                end)
                if not restored or result ~= true then
                    context.Destroy()
                    return
                end
                RunService.Heartbeat:Once(function()
                    if context.Valid() then
                        record.Recovering = false
                        context.Exit()
                    end
                end)
            end)
        else
            task.delay(tuning.LandingPoll, poll)
        end
    end
    RunService.Heartbeat:Once(function()
        if not context.Valid() then
            return
        end
        local launched = pcall(function()
            root:SetNetworkOwner(nil)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.new(tuning.TumbleSpeed, 0, tuning.TumbleSpeed / 2)
            local look = root.CFrame.LookVector
            local away = Vector3.new(look.X, 0, look.Z)
            Knockback.Apply(root, if away.Magnitude > 0.001 then away.Unit else Vector3.new(0, 0, -1), {
                HorizontalKnockback = tuning.LaunchHorizontal,
                VerticalKnockback = tuning.LaunchVertical,
            })
        end)
        if not launched then
            context.Destroy()
            return
        end
        poll()
    end)
    task.delay(tuning.LandingTimeout, function()
        if context.Valid() and record.Recovering then
            context.Destroy()
        end
    end)
end

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">BatKnockback</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BatConfig)
local BatKnockback = {}

function BatKnockback.Direction(attackerRoot: BasePart, root: BasePart): Vector3
    local delta = root.Position - attackerRoot.Position
    local away = Vector3.new(delta.X, 0, delta.Z)
    if away.Magnitude < 0.001 then
        local forward = attackerRoot.CFrame.LookVector
        away = Vector3.new(forward.X, 0, forward.Z)
    end
    return if away.Magnitude > 0.001 then away.Unit else Vector3.new(0, 0, -1)
end

function BatKnockback.Apply(
    root: BasePart,
    away: Vector3,
    tuning: { HorizontalKnockback: number, VerticalKnockback: number }?
)
    local mass = root.AssemblyMass
    if not root.Anchored and mass > 0 and mass < math.huge then
        local horizontal = if tuning then tuning.HorizontalKnockback else Config.Knockback.HorizontalSpeed
        local vertical = if tuning then tuning.VerticalKnockback else Config.Knockback.UpwardSpeed
        -- Direction is already a horizontal unit vector; do not normalize the combined launch.
        local velocity = away * horizontal + Vector3.new(0, vertical, 0)
        root:ApplyImpulse(velocity * mass)
    end
end

return BatKnockback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">BlendService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local HttpService = game:GetService("HttpService")
local Economy = require(Shared.Constants.Economy)
local Types = require(Shared.Types)
local Item = require(Shared.IngredientItem)
local WorldUtil = require(script.Parent.WorldUtil)
local Film = require(script.Parent.FilmingUtil)
local SmoothieItem = require(script.Parent.SmoothieItem)
local BlendService = {}
local MovementService = require(script.Parent.MovementService)
local deps: any
local ingredientAccepted = Instance.new("BindableEvent")
local RunService = game:GetService("RunService")
local observers: { RBXScriptConnection } = {}
local nextNotificationToken = 0
local function observerCount(): number
    for index = #observers, 1, -1 do
        if not observers[index].Connected then
            table.remove(observers, index)
        end
    end
    return #observers
end
local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[BlendService] " .. message)
    end
end

-- One canonical color calculation for both the developing liquid and final cup.
local function batchColor(ids: { string }): Color3?
    if #ids == 0 then
        return nil
    end
    local sum = Vector3.zero
    for _, id in ids do
        local color = deps.IngredientService.GetDefinition(id).BlendColor
        sum += Vector3.new(color.R, color.G, color.B)
    end
    sum /= #ids
    return Color3.new(sum.X, sum.Y, sum.Z)
end

type Batch = {
    IngredientItems: { Types.IngredientItem },
    NotificationToken: number,
    State: Types.BlendState,
    Ingredients: { string },
    Progress: number,
    Result: Types.Smoothie?,
    NextProgressPresentationAt: number,
    NextRejectionAt: number,
    NeedsItemsUntil: number,
    Dispensing: boolean,
}
local batches: { [string]: Batch } = {}
local function key(player: Player): string
    return deps.TycoonService.GetSessionId(player) or ""
end
local function authorized(player: Player, context: any): boolean
    return MovementService.CanPerformGameplayAction(player)
        and deps.TycoonService.ValidateActor(player, context or deps.TycoonService.GetRequestContext(player))
end

function BlendService.ObserveIngredientAccepted(callback: (Player, string, CFrame, number) -> ()): RBXScriptConnection
    local connection = ingredientAccepted.Event:Connect(function(sessionId, id, at, index, token)
        -- BindableEvents COPY tables. Compare a scalar token, never table identity.
        local batch = batches[sessionId]
        local owner = deps.TycoonService.GetSessionOwner(sessionId)
        if owner and batch and batch.NotificationToken == token then
            callback(owner, id, at, index)
        else
            diagnostic("accepted notify skipped stale batch ingredient=" .. id)
        end
    end)
    table.insert(observers, connection)
    diagnostic("ingredient observer connected observers=" .. tostring(observerCount()))
    return connection
end

local function publish(player: Player)
    local id = key(player)
    local batch = batches[id]
    if not batch then
        return
    end
    for _, member in deps.TycoonService.GetMembers(id) do
        member:SetAttribute("BlendColor", if batch.Result then batch.Result.Color else batchColor(batch.Ingredients))
        member:SetAttribute("BlendState", batch.State)
        member:SetAttribute("BlendProgress", batch.Progress)
        member:SetAttribute("BlendIngredientCount", #batch.Ingredients)
        member:SetAttribute(
            "BlendNeedsItems",
            #batch.Ingredients < Economy.MaxIngredients and os.clock() < batch.NeedsItemsUntil
        )
    end
end
function BlendService.BindPlayer(player: Player)
    publish(player)
end
local function copyResult(result: Types.Smoothie): Types.Smoothie
    return {
        BlendId = result.BlendId,
        Ingredients = table.clone(result.Ingredients),
        IngredientItems = Item.CopyAll(result.IngredientItems),
        Tags = table.clone(result.Tags),
        Color = result.Color,
        Discovery = result.Discovery,
    }
end
function BlendService.Init(services)
    deps = services
end
function BlendService.Reset(player: Player)
    if key(player) == "" then
        return
    end
    nextNotificationToken += 1
    batches[key(player)] = {
        NotificationToken = nextNotificationToken,
        State = "EMPTY",
        Ingredients = {},
        IngredientItems = {},
        Progress = 0,
        Result = nil,
        NextProgressPresentationAt = 0,
        NextRejectionAt = 0,
        NeedsItemsUntil = 0,
        Dispensing = false,
    }
    publish(player)
    Film.Log("Blend", "reset")
end
function BlendService.GetSnapshot(player: Player): {
    BatchId: number,
    AcceptedIngredientCount: number,
    ReadyToDispense: boolean,
    ProgressPercent: number,
    State: Types.BlendState,
    Ingredients: { string },
    IngredientItems: { Types.IngredientItem }?,
    Progress: number,
    Result: Types.Smoothie?,
}?
    local batch = batches[key(player)]
    if not batch then
        return nil
    end
    return {
        BatchId = batch.NotificationToken,
        ProgressPercent = math.clamp(batch.Progress / Economy.RequiredProgress * 100, 0, 100),
        AcceptedIngredientCount = #batch.Ingredients,
        ReadyToDispense = batch.State == "COMPLETE"
            and batch.Progress >= Economy.RequiredProgress
            and batch.Result ~= nil,
        State = batch.State,
        Ingredients = table.clone(batch.Ingredients),
        IngredientItems = Item.CopyAll(batch.IngredientItems),
        Progress = batch.Progress,
        Result = if batch.Result then copyResult(batch.Result) else nil,
    }
end
function BlendService.TryInput(player: Player, object: Instance, input: BasePart, context: any): boolean
    local batch = batches[key(player)]
    local record = deps.IngredientService.GetRecord(object)
    local part = WorldUtil.Part(object)
    if
        not batch
        or not authorized(player, nil)
        or (batch.State ~= "EMPTY" and batch.State ~= "LOADING" and batch.State ~= "READY")
        or #batch.Ingredients >= Economy.MaxIngredients
        or not record
        or object:GetAttribute("FrozenUntilPickup") == true
        or (record.Owner ~= nil and record.Owner ~= player)
        or (record.Owner == nil and not record.Claimable)
        or not part
        or not deps.TycoonService.IsMember(player, input)
        or not authorized(player, context)
        or deps.TycoonService.GetReference(player, "BlenderInput") ~= input
    then
        return false
    end
    -- Check actual overlap on the server, not only a client-influenced Touched signal.
    local overlaps = false
    for _, touching in workspace:GetPartsInPart(input) do
        if deps.IngredientService.Resolve(touching) == object then
            overlaps = true
            break
        end
    end
    if not overlaps then
        return false
    end
    local acceptedAt = part.CFrame
    local token = deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not token then
        return false
    end
    local id = deps.IngredientService.Consume(object)
    if not id then
        deps.TycoonService.EndTransaction(token)
        return false
    end
    table.insert(batch.Ingredients, id)
    table.insert(batch.IngredientItems, record.Item)
    Film.Log("Blend", string.format("%s accepted (%d/3)", id, #batch.Ingredients))
    batch.State = if #batch.Ingredients == Economy.MaxIngredients then "READY" else "LOADING"
    publish(player)
    Film.Log("Blend", batch.State)
    diagnostic("accepted notify ingredient=" .. id .. " observers=" .. tostring(observerCount()))
    if deps.TutorialService then
        deps.TutorialService.Mark(player, "LoadedBlender")
    end
    ingredientAccepted:Fire(token, id, acceptedAt, #batch.Ingredients, batch.NotificationToken)
    deps.TycoonService.EndTransaction(token)
    return true
end
function BlendService.Ready(player: Player): boolean
    local batch = batches[key(player)]
    if
        not batch
        or not authorized(player, nil)
        or #batch.Ingredients < Economy.MaxIngredients
        or (batch.State ~= "LOADING" and batch.State ~= "READY")
    then
        return false
    end
    batch.State = "READY"
    publish(player)
    Film.Log("Blend", "READY")
    return true
end
local function makeResult(ids: { string }, items: { Types.IngredientItem }): Types.Smoothie
    local tags = {}
    for _, id in ids do
        local definition = deps.IngredientService.GetDefinition(id)
        for _, tag in definition.Tags do
            if not table.find(tags, tag) then
                table.insert(tags, tag)
            end
        end
    end
    return {
        BlendId = HttpService:GenerateGUID(false),
        Ingredients = table.clone(ids),
        IngredientItems = Item.CopyAll(items),
        Tags = tags,
        Color = batchColor(ids) :: Color3,
        -- Retained for compatibility with existing smoothie consumers.
        Discovery = nil,
    }
end
-- Server Heartbeat reports measured physical spin. No progress remote exists.
local function addProgress(player: Player, wheel: BasePart, delta: number, context: any): boolean
    local batch = batches[key(player)]
    if
        not batch
        or not authorized(player, nil)
        or not deps.TycoonService.IsMember(player, wheel)
        or not authorized(player, context)
        or delta ~= delta
        or delta <= 0
        or delta == math.huge
    then
        return false
    end
    -- This private count is the source of BlendIngredientCount. Never authorize
    -- a start from replicated attributes or mutate an underfilled batch.
    if #batch.Ingredients < Economy.MaxIngredients then
        if
            (batch.State == "EMPTY" or batch.State == "LOADING" or batch.State == "READY")
            and os.clock() >= batch.NextRejectionAt
        then
            -- Heartbeat must not continually extend the transient feedback.
            batch.NextRejectionAt = os.clock() + 2.5
            batch.NeedsItemsUntil = os.clock() + 1.75
            local rejectionAt = batch.NextRejectionAt
            local sessionId = key(player)
            for _, member in deps.TycoonService.GetMembers(sessionId) do
                member:SetAttribute("BlendNeedsItems", true)
            end
            task.delay(1.75, function()
                if batches[sessionId] == batch and batch.NextRejectionAt == rejectionAt then
                    batch.NeedsItemsUntil = 0
                    for _, member in deps.TycoonService.GetMembers(sessionId) do
                        member:SetAttribute("BlendNeedsItems", false)
                    end
                end
            end)
        end
        return false
    end
    if batch.State == "LOADING" then
        BlendService.Ready(player)
    end
    if batch.State ~= "READY" and batch.State ~= "BLENDING" then
        return false
    end
    if batch.State == "READY" then
        batch.State = "BLENDING"
        publish(player)
        Film.Emit(player, "BlendStarted", { IngredientIds = table.clone(batch.Ingredients) })
        Film.Log("Blend", "BLENDING")
    end
    -- Physical spin is measured for the shared batch, with no individual input actor.
    -- Credit only living nearby members, including the teammate, after accepted progress.
    if deps.TutorialService then
        for _, member in deps.TycoonService.GetMembers(key(player)) do
            if WorldUtil.Near(member, wheel, 12) then
                deps.TutorialService.Mark(member, "UsedTurbine")
            end
        end
    end
    local oldProgress = batch.Progress
    batch.Progress = math.min(Economy.RequiredProgress, batch.Progress + delta)
    local now = os.clock()
    if
        batch.Progress > oldProgress
        and (now >= batch.NextProgressPresentationAt or batch.Progress >= Economy.RequiredProgress)
    then
        batch.NextProgressPresentationAt = now + 0.1
        Film.Emit(player, "BlendProgressChanged", { Progress = batch.Progress })
    end
    if math.floor(oldProgress / 10) ~= math.floor(batch.Progress / 10) then
        Film.Log("Blend", string.format("progress %.0f", batch.Progress))
    end
    if batch.Progress >= Economy.RequiredProgress then
        batch.State = "COMPLETE"
        local result = makeResult(batch.Ingredients, batch.IngredientItems)
        batch.Result = result
        Film.Emit(player, "BlendCompleted", {
            BlendId = result.BlendId,
            Color = result.Color,
            IngredientIds = table.clone(result.Ingredients),
            RecipeId = result.Discovery,
        })
        Film.Log(
            "Blend",
            string.format("COMPLETE color=(%.3f,%.3f,%.3f)", result.Color.R, result.Color.G, result.Color.B)
        )
        deps.PlayerDataService.IncrementStat(player, "SmoothiesMade")
    end
    publish(player)
    return true
end
function BlendService.AddProgress(player: Player, wheel: BasePart, delta: number, context: any): boolean
    local token = deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not token then
        return false
    end
    local result = addProgress(player, wheel, delta, context)
    deps.TycoonService.EndTransaction(token)
    return result
end
function BlendService.GetCup(player: Player, requested: Instance?): Types.Smoothie?
    local data = deps.InventoryService.GetHeldSmoothie(player, requested)
    return if data then SmoothieItem.Result(data) else nil
end
function BlendService.ConsumeCup(player: Player): Types.Smoothie?
    local data = deps.InventoryService.ConsumeHeldSmoothie(player)
    return if data then SmoothieItem.Result(data) else nil
end
function BlendService.Dispense(player: Player, button: BasePart, context: any): (boolean, string?)
    local batch = batches[key(player)]
    if not batch or batch.State ~= "COMPLETE" or not batch.Result or batch.Dispensing then
        return false, "Not ready"
    end
    if
        not deps.TycoonService.IsMember(player, button)
        or not authorized(player, context)
        or not WorldUtil.Near(player, button, Economy.InteractionDistance)
    then
        return false, "Not your blender or too far"
    end
    if deps.InventoryService.GetCarryCount(player) >= deps.InventoryService.GetCarryCapacity(player) then
        return false, "Inventory full"
    end
    local data: Types.SmoothieData = {
        BlendId = batch.Result.BlendId :: string,
        Ingredients = table.clone(batch.Result.Ingredients),
        IngredientItems = Item.CopyAll(batch.Result.IngredientItems),
    }
    -- Grant is synchronous. Guard signals from equip/presentation against a
    -- reentrant dispense of this same batch, including while it is still COMPLETE.
    local sessionId =
        deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not sessionId then
        return false, "StaleSession"
    end
    batch.Dispensing = true
    local granted = deps.InventoryService.GrantSmoothie(player, data)
    batch.Dispensing = false
    if not granted then
        deps.TycoonService.EndTransaction(sessionId)
        return false, "Cannot carry smoothie"
    end
    if deps.TutorialService then
        deps.TutorialService.Mark(player, "DispensedSmoothie")
    end
    batch.State = "DISPENSED"
    publish(player)
    task.defer(function()
        local owner = deps.TycoonService.GetSessionOwner(sessionId)
        if owner and batches[sessionId] == batch then
            BlendService.Reset(owner)
        end
    end)
    Film.Emit(player, "SmoothieDispensed", { BlendId = data.BlendId, Color = batch.Result.Color })
    Film.Log("Blend", "DISPENSED blend=" .. data.BlendId)
    deps.TycoonService.EndTransaction(sessionId)
    return true
end
function BlendService.CleanupSession(sessionId: string)
    batches[sessionId] = nil
end
function BlendService.RemovePlayer(player: Player)
    player:SetAttribute("BlendState", "EMPTY")
    player:SetAttribute("BlendProgress", 0)
    player:SetAttribute("BlendIngredientCount", 0)
    player:SetAttribute("BlendColor", nil)
    player:SetAttribute("BlendNeedsItems", false)
end
return require(script.Parent.StudioServices).Wrap("BlendService", BlendService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">BlenderVacuumPhysics</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BlenderVacuum)
local Physics = {}

local function clampMagnitude(value: Vector3, limit: number): Vector3
    return if value.Magnitude > limit then value.Unit * limit else value
end

function Physics.Steer(velocity: Vector3, position: Vector3, target: Vector3, radius: number, dt: number): Vector3
    local offset = target - position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    local proximity = 1 - math.clamp(horizontal.Magnitude / math.max(radius, 0.01), 0, 1)
    local strength = Config.EdgeStrength + (1 - Config.EdgeStrength) * proximity
    local desired =
        clampMagnitude(horizontal * Config.CenteringStrength + Vector3.new(0, -Config.DownwardBias, 0), Config.MaxSpeed)
    local step = math.clamp(dt, 0, Config.MaxStep)
    local delta = (desired - velocity) * (1 - math.exp(-Config.PullStrength * strength * step))
    return velocity + clampMagnitude(delta, Config.MaxAcceleration * step)
end

return Physics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">CharacterPhysicsService</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local PlayerOnlyCollisionService = require(script.Parent.PlayerOnlyCollisionService)
local CharacterPhysicsService = {}

-- Enable before spawning in Studio; never prints in live servers.
local DEBUG = true
local ROOT_SIZE = Vector3.new(2, 2, 1)
-- 4 cubic studs * density 4 = 16 mass units, independent of avatar mesh volume.
local ROOT_PHYSICS = PhysicalProperties.new(4, 0.3, 0, 1, 1)
local BODY_PHYSICS = PhysicalProperties.new(0.7, 0.3, 0, 1, 1)
local BODY_NAMES: { [string]: boolean } = {}
for _, name in
    {
        "Head",
        "UpperTorso",
        "LowerTorso",
        "LeftUpperArm",
        "LeftLowerArm",
        "LeftHand",
        "RightUpperArm",
        "RightLowerArm",
        "RightHand",
        "LeftUpperLeg",
        "LeftLowerLeg",
        "LeftFoot",
        "RightUpperLeg",
        "RightLowerLeg",
        "RightFoot",
        "Torso",
        "Left Arm",
        "Right Arm",
        "Left Leg",
        "Right Leg",
    }
do
    BODY_NAMES[name] = true
end
type State = { Character: Model, Connections: { RBXScriptConnection }, Started: boolean }
local states: { [Player]: State } = {}

function CharacterPhysicsService.RemovePlayer(player: Player)
    local state = states[player]
    if state then
        for _, connection in state.Connections do
            connection:Disconnect()
        end
        states[player] = nil
    end
end

-- Called by bootstrap's existing CharacterAdded path; appearance loading must finish
-- before reading its description, otherwise Roblox can overwrite the scales later.
function CharacterPhysicsService.ApplyCharacter(player: Player, character: Model, onReady: ((Model) -> ())?)
    if states[player] and states[player].Character == character then
        return
    end
    CharacterPhysicsService.RemovePlayer(player)
    local state: State = { Character = character, Connections = {}, Started = false }
    states[player] = state
    local function current(): boolean
        return states[player] == state and player.Character == character
    end
    local function normalizePart(instance: Instance)
        if not current() or not instance:IsA("BasePart") or not instance:IsDescendantOf(character) then
            return
        end
        -- Only avatar body parts and cosmetics are ours. Tools and server-authored
        -- gameplay parts retain their own physics, including nested Tool parts.
        if instance:FindFirstAncestorWhichIsA("Tool") then
            return
        end
        local accessory = instance:FindFirstAncestorWhichIsA("Accessory")
        if accessory and accessory.Parent == character then
            if accessory:GetAttribute("PreserveGameplayPhysics") == true then
                return
            end
            instance.CollisionGroup = PlayerOnlyCollisionService.PlayerGroup
            instance.Massless = true
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
            instance.RootPriority = -127
        elseif instance.Parent == character and instance.Name == "HumanoidRootPart" then
            instance.CollisionGroup = PlayerOnlyCollisionService.PlayerGroup
            instance.Size = ROOT_SIZE
            instance.Massless = false
            instance.RootPriority = 127
            instance.CustomPhysicalProperties = ROOT_PHYSICS
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = true
        elseif instance.Parent == character and BODY_NAMES[instance.Name] then
            instance.CollisionGroup = PlayerOnlyCollisionService.PlayerGroup
            instance.Massless = true
            instance.RootPriority = 0
            instance.CustomPhysicalProperties = BODY_PHYSICS
            -- Retain Roblox's body collision/state-machine behavior. In particular,
            -- collidable torso/head parts must keep physically driving the turbine.
            -- Forcing limb collisions adds snagging; disabling torso collisions removes pushing.
        end
    end
    local function scan()
        for _, instance in character:GetDescendants() do
            normalizePart(instance)
        end
    end
    table.insert(
        state.Connections,
        character.DescendantAdded:Connect(function(instance)
            -- Defer until a newly inserted accessory's hierarchy is fully parented.
            task.defer(normalizePart, instance)
        end)
    )
    table.insert(
        state.Connections,
        player.CharacterRemoving:Connect(function(removing)
            if removing == character and states[player] == state then
                CharacterPhysicsService.RemovePlayer(player)
            end
        end)
    )
    scan()

    local function finish(appearanceSource: string)
        if not current() or state.Started then
            return
        end
        state.Started = true
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            local root = character:WaitForChild("HumanoidRootPart", 10)
            if not current() then
                return
            end
            if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") then
                warn("[CharacterPhysics] Missing Humanoid/root for " .. player.Name)
                return
            end
            if humanoid.RigType == Enum.HumanoidRigType.R15 then
                local ok, problem = pcall(function()
                    local description = humanoid:GetAppliedDescription()
                    -- Keep the loaded avatar's assets/cosmetics, but remove the
                    -- taller/slender body morph independently of dimensional scale.
                    -- Head is a collidable body part: its scale affects clearance too.
                    local changed = description.HeightScale ~= 1
                        or description.WidthScale ~= 1
                        or description.DepthScale ~= 1
                        or description.HeadScale ~= 1
                        or description.BodyTypeScale ~= 0
                        or description.ProportionScale ~= 0
                    description.HeightScale = 1
                    description.WidthScale = 1
                    description.DepthScale = 1
                    description.HeadScale = 1
                    description.BodyTypeScale = 0
                    description.ProportionScale = 0
                    humanoid.AutomaticScalingEnabled = true
                    if changed then
                        -- At most one application per spawn. No heartbeat reapplication.
                        local applied, reason = pcall(function()
                            humanoid:ApplyDescriptionAsync(description)
                        end)
                        description:Destroy()
                        if not applied then
                            error(tostring(reason))
                        end
                    else
                        description:Destroy()
                    end
                end)
                if not ok and current() then
                    warn(
                        "[CharacterPhysics] Scale normalization failed for " .. player.Name .. ": " .. tostring(problem)
                    )
                end
            end
            -- R6 receives mass/accessory handling but no R15 scaling or rig conversion.
            if not current() then
                return
            end
            scan() -- Description application can resize the root and replace body parts.
            if onReady then
                onReady(character)
            end
            -- Read back after the yielding application and a simulation step, not
            -- from the requested description. Never reapply in response to this check.
            RunService.Heartbeat:Wait()
            if not current() then
                return
            end
            if DEBUG and RunService:IsStudio() then
                local count = 0
                for _, instance in character:GetDescendants() do
                    if instance:IsA("BasePart") then
                        local accessory = instance:FindFirstAncestorWhichIsA("Accessory")
                        if
                            accessory
                            and accessory.Parent == character
                            and not instance:FindFirstAncestorWhichIsA("Tool")
                            and accessory:GetAttribute("PreserveGameplayPhysics") ~= true
                        then
                            count += 1
                        end
                    end
                end
                local function scale(name: string): string
                    local value = humanoid:FindFirstChild(name)
                    return if value and value:IsA("NumberValue") then tostring(value.Value) else "n/a"
                end
                local appliedRoot = character:FindFirstChild("HumanoidRootPart")
                if appliedRoot and appliedRoot:IsA("BasePart") then
                    local _, boundingSize = character:GetBoundingBox()
                    local final = humanoid:GetAppliedDescription()
                    local finalScales = if humanoid.RigType == Enum.HumanoidRigType.R15
                        then string.format(
                            "HeightScale=%.3f WidthScale=%.3f DepthScale=%.3f HeadScale=%.3f BodyTypeScale=%.3f ProportionScale=%.3f",
                            final.HeightScale,
                            final.WidthScale,
                            final.DepthScale,
                            final.HeadScale,
                            final.BodyTypeScale,
                            final.ProportionScale
                        )
                        else "R6 scales=n/a"
                    final:Destroy()
                    print(
                        string.format(
                            "[CharacterPhysics] FINAL player=%s rig=%s appearance=%s description={%s} liveScales(H/W/D/Head/Type/Proportion)=%s/%s/%s/%s/%s/%s boundingSize=%s rootMass=%.3f assemblyMass=%.3f cosmeticParts=%d",
                            player.Name,
                            humanoid.RigType.Name,
                            appearanceSource,
                            finalScales,
                            scale("BodyHeightScale"),
                            scale("BodyWidthScale"),
                            scale("BodyDepthScale"),
                            scale("HeadScale"),
                            scale("BodyTypeScale"),
                            scale("BodyProportionScale"),
                            tostring(boundingSize),
                            appliedRoot:GetMass(),
                            appliedRoot.AssemblyMass,
                            count
                        )
                    )
                end
            end
        end)
    end
    table.insert(
        state.Connections,
        player.CharacterAppearanceLoaded:Connect(function(loaded)
            if loaded == character then
                finish("CharacterAppearanceLoaded")
            end
        end)
    )
    -- Connect first, then check: covers appearances loaded before bootstrap as well
    -- as the event/check race. Started is set before yielding to prevent duplicates.
    if player:HasAppearanceLoaded() then
        finish("HasAppearanceLoaded")
    elseif not player.LoadCharacterAppearance then
        finish("LoadCharacterAppearance=false")
    end
end

return CharacterPhysicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BatConfig)
local GameplaySfx = require(script.Parent.GameplaySfxService)
local Knockback = require(script.Parent.BatKnockback)
local CombatService = {}
local deps: any
type Weapon = { Tool: Tool, Scale: number }
type EquippedBat = {
    Character: Model?,
    Weapon: Weapon?,
    RuntimeTool: Instance?,
    Tool: Tool?,
    Handle: Instance?,
    Hitbox: Instance?,
    IsUnderCharacter: boolean,
    IssuedValidation: boolean,
}
type Stun = { Character: Model, Until: number, ImmuneUntil: number }
local weapons: { [Player]: Weapon? } = {}
local attackAt: { [Player]: number } = {}
local swings: { [Player]: {} } = {}
local stuns: { [Player]: Stun } = {}
local characters: { [Player]: {} } = {}
local removals: { [Player]: RBXScriptConnection } = {}
local deaths: { [Player]: RBXScriptConnection } = {}
local backpackWatches: { [Player]: RBXScriptConnection } = {}

-- Arm on the server for one request; silent by default and always disabled outside Studio.
local function swingTrace(player: Player): (string) -> ()
    local enabled = RunService:IsStudio() and player:GetAttribute("BatDebugNextSwing") == true
    if enabled then
        player:SetAttribute("BatDebugNextSwing", nil)
    end
    return function(message: string)
        if enabled then
            print("[Bat] " .. player.Name .. " " .. message)
        end
    end
end

function CombatService.TraceRejectedSwing(player: Player, reason: string)
    swingTrace(player)("SwingBat rejected: " .. reason)
end

local function alive(player: Player): (Model?, BasePart?)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if player.Parent ~= Players or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return nil, nil
    end
    return character, root
end
local function levelFor(player: Player): number
    return deps.TycoonService.GetUpgrade(player, "Bat") - 1
end
-- Physical failures must never strand authoritative gameplay stun.
local function setRagdolled(character: Model, enabled: boolean): boolean
    local ok, result = pcall(function()
        return deps.RagdollService.SetRagdolled(character, enabled)
    end)
    if not ok or result ~= true then
        warn("[Bat] Ragdoll " .. (if enabled then "ON" else "OFF") .. " failed: " .. tostring(result))
        return false
    end
    return true
end
local function clearStun(player: Player)
    local state = stuns[player]
    stuns[player] = nil
    if state then
        setRagdolled(state.Character, false)
    end
    deps.MovementService.SetStunned(player, false)
    player:SetAttribute("StunnedUntil", 0)
end
local function intact(tool: Tool): boolean
    local handle = tool:FindFirstChild("Handle")
    local hitbox = tool:FindFirstChild("Hitbox")
    return handle ~= nil and handle:IsA("BasePart") and hitbox ~= nil and hitbox:IsA("BasePart")
end
local function resolveEquippedBat(player: Player): EquippedBat
    local character = player.Character
    local runtimeTool = if character then character:FindFirstChild("Bat") else nil
    local tool: Tool? = if runtimeTool and runtimeTool:IsA("Tool") then runtimeTool :: Tool else nil
    local weapon = weapons[player]
    local isUnderCharacter = character ~= nil and runtimeTool ~= nil and runtimeTool.Parent == character
    return {
        Character = character,
        Weapon = weapon,
        RuntimeTool = runtimeTool,
        Tool = tool,
        Handle = if tool then tool:FindFirstChild("Handle") else nil,
        Hitbox = if tool then tool:FindFirstChild("Hitbox") else nil,
        IsUnderCharacter = isUnderCharacter,
        IssuedValidation = weapon ~= nil and tool ~= nil and weapon.Tool == tool and isUnderCharacter,
    }
end
local function removeWeapon(player: Player)
    local weapon: Weapon? = weapons[player]
    weapons[player] = nil
    if weapon then
        weapon.Tool:Destroy()
    end
end
-- Tool.Grip is inherited unchanged from the authored template; never rotate mesh/hitbox to fix grip.
-- Scale only the clone. Temporarily release constraints so resizing cannot move the character.
local function configure(weapon: Weapon, level: number)
    local tool = weapon.Tool
    local scale = Config.Levels[level].Scale
    local ratio = scale / weapon.Scale
    local handle = tool:FindFirstChild("Handle") :: BasePart
    local parts: { [BasePart]: CFrame } = {}
    local constraints: { WeldConstraint } = {}
    for _, object in tool:GetDescendants() do
        if object:IsA("BasePart") then
            parts[object] = handle.CFrame:ToObjectSpace(object.CFrame)
        elseif object:IsA("WeldConstraint") and object.Enabled then
            object.Enabled = false
            table.insert(constraints, object)
        end
    end
    for part, offset in parts do
        part.Size *= ratio
        part.CFrame = handle.CFrame * (CFrame.new(offset.Position * (ratio - 1)) * offset)
        part.Anchored = false
        part.CanCollide = false
        part.CanTouch = false
        part.Massless = true
    end
    for _, object in tool:GetDescendants() do
        if object:IsA("SpecialMesh") then
            object.Scale *= ratio
            object.Offset *= ratio
        elseif object:IsA("Attachment") then
            object.Position *= ratio
        elseif object:IsA("JointInstance") then
            object.C0 = CFrame.new(object.C0.Position * ratio) * object.C0.Rotation
            object.C1 = CFrame.new(object.C1.Position * ratio) * object.C1.Rotation
        end
    end
    for _, constraint in constraints do
        constraint.Enabled = true
    end
    weapon.Scale = scale
    tool:SetAttribute("BatLevel", level)
    tool.CanBeDropped = false
    local hitbox = tool:FindFirstChild("Hitbox") :: BasePart
    hitbox.Transparency = 1
    hitbox.CanQuery = false
end
function CombatService.Init(services)
    deps = services
end
function CombatService.RefreshPlayer(player: Player)
    local level = levelFor(player)
    player:SetAttribute("BatLevel", level)
    local character = alive(player)
    if not character or not Config.Levels[level] or not deps.TycoonService.GetSessionId(player) then
        removeWeapon(player)
        swings[player] = nil
        return
    end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then
        return
    end
    local weapon: Weapon? = weapons[player]
    if weapon and (not intact(weapon.Tool) or (weapon.Tool.Parent ~= backpack and weapon.Tool.Parent ~= character)) then
        removeWeapon(player)
        weapon = nil
    end
    if not weapon then
        local template = ServerStorage:FindFirstChild("Bat")
        local handle = template and template:FindFirstChild("Handle")
        local hitbox = template and template:FindFirstChild("Hitbox")
        if
            not template
            or not template:IsA("Tool")
            or not template.Archivable
            or not handle
            or not handle:IsA("BasePart")
            or not hitbox
            or not hitbox:IsA("BasePart")
        then
            warn("[Bat] Expected archivable ServerStorage.Bat Tool with Handle and Hitbox BaseParts")
            return
        end
        local clone = template:Clone()
        if not intact(clone) then
            clone:Destroy()
            warn("[Bat] Handle and Hitbox must be archivable BaseParts")
            return
        end
        local created: Weapon = {
            Tool = clone,
            Scale = 1,
        }
        local ok, problem = pcall(function(): string?
            configure(created, level)
            return nil
        end)
        if not ok then
            clone:Destroy()
            warn("[Bat] Could not configure ServerStorage.Bat: " .. tostring(problem))
            return
        end
        weapons[player] = created
        clone.Unequipped:Connect(function()
            if weapons[player] == created then
                swings[player] = nil
            end
        end)
        local characterToken = characters[player]
        clone.Destroying:Connect(function()
            local current = weapons[player]
            if current and current.Tool == clone then
                weapons[player] = nil
                swings[player] = nil
                task.defer(function()
                    if characterToken and characters[player] == characterToken and player.Character == character then
                        CombatService.RefreshPlayer(player)
                    end
                end)
            end
        end)
        clone.Parent = backpack
    elseif weapon.Tool:GetAttribute("BatLevel") ~= level then
        local ok, problem = pcall(function(): string?
            configure(weapon, level)
            return nil
        end)
        if not ok then
            removeWeapon(player)
            warn("[Bat] Could not update Bat: " .. tostring(problem))
        end
    end
end
function CombatService.IsBatEquipped(player: Player): boolean
    return resolveEquippedBat(player).IssuedValidation
end

local function swingRejection(player: Player, equipped: EquippedBat?): string?
    local character = alive(player)
    if not character then
        return "attacker not alive"
    end
    equipped = equipped or resolveEquippedBat(player)
    if not equipped.Weapon then
        return "no issued Bat"
    end
    if equipped.Character ~= character or not equipped.IssuedValidation then
        return "issued Bat not equipped"
    end
    if
        not equipped.Handle
        or not equipped.Handle:IsA("BasePart")
        or not equipped.Hitbox
        or not equipped.Hitbox:IsA("BasePart")
    then
        return "missing Handle/Hitbox"
    end
    if not Config.Levels[levelFor(player)] then
        return "Bat level locked"
    end
    if not deps.TycoonService.GetSessionId(player) then
        return "no plot session"
    end
    if not deps.MovementService.CanPerformGameplayAction(player) then
        return "attacker stunned"
    end
    return nil
end
local function enemyRejection(attacker: Player, victim: Player): string?
    local session = deps.TycoonService.GetSessionId(victim)
    local character = alive(victim)
    local stun = stuns[victim]
    if attacker == victim then
        return "self"
    end
    if not character then
        return "target not alive"
    end
    if not session then
        return "target has no plot session"
    end
    if session == deps.TycoonService.GetSessionId(attacker) then
        return "shared plot session"
    end
    if not attacker.Neutral and not victim.Neutral and attacker.Team == victim.Team then
        return "non-neutral Roblox teammates"
    end
    if deps.MovementService.IsStunned(victim) then
        return "target stunned"
    end
    if stun and os.clock() < stun.ImmuneUntil then
        return "target immune"
    end
    return nil
end
local function hit(attacker: Player, victim: Player, level: typeof(Config.Levels[1]))
    if enemyRejection(attacker, victim) then
        return
    end
    local duration = level.StunDuration
    local character = victim.Character :: Model
    local untilTime = os.clock() + duration
    local state = { Character = character, Until = untilTime, ImmuneUntil = untilTime + Config.ImmunitySeconds }
    stuns[victim] = state
    victim:SetAttribute("StunnedUntil", untilTime)
    deps.MovementService.SetStunned(victim, true)
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
    local attackerRoot = (attacker.Character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
    local away = Knockback.Direction(attackerRoot, root)
    deps.InventoryService.DropCarriedIngredients(victim, "BatStun", away)
    if setRagdolled(character, true) then
        RunService.Heartbeat:Once(function()
            local currentCharacter, currentRoot = alive(victim)
            if
                stuns[victim] ~= state
                or currentCharacter ~= character
                or currentRoot ~= root
                or not character:IsDescendantOf(workspace)
                or os.clock() >= state.Until
                or not deps.MovementService.IsStunned(victim)
            then
                return
            end
            local ok, problem = pcall(function(): boolean
                if not deps.RagdollService.IsRagdolled(character) or root.Anchored then
                    return false
                end
                Knockback.Apply(root, away, level)
                return true
            end)
            if not ok then
                warn("[Bat] Knockback failed: " .. tostring(problem))
            end
        end)
    end
    task.delay(duration, function()
        if stuns[victim] == state and victim.Character == character then
            setRagdolled(character, false)
            deps.MovementService.SetStunned(victim, false)
            victim:SetAttribute("StunnedUntil", 0)
        end
    end)
end
-- No target, level, duration or geometry is accepted from the requester.
function CombatService.SwingBat(player: Player): boolean
    local trace = swingTrace(player)
    local equipped = resolveEquippedBat(player)
    local function fullName(object: Instance?): string
        return if object then object:GetFullName() else "nil"
    end
    trace(
        string.format(
            "BatLevel=%s runtimeTool=%s runtimeToolParent=%s isUnderCharacter=%s handle=%s hitbox=%s issuedValidation=%s",
            tostring(levelFor(player)),
            fullName(equipped.RuntimeTool),
            fullName(if equipped.RuntimeTool then equipped.RuntimeTool.Parent else nil),
            tostring(equipped.IsUnderCharacter),
            fullName(equipped.Handle),
            fullName(equipped.Hitbox),
            tostring(equipped.IssuedValidation)
        )
    )
    local rejection = swingRejection(player, equipped)
    if rejection or os.clock() < (attackAt[player] or 0) then
        trace("SwingBat rejected: " .. (rejection or "cooldown"))
        return false
    end
    trace("SwingBat accepted")
    attackAt[player] = os.clock() + Config.SwingCooldown
    local token = {}
    swings[player] = token
    local character = player.Character :: Model
    local weapon = equipped.Weapon :: Weapon
    local tool = equipped.Tool :: Tool
    local hitbox = equipped.Hitbox :: BasePart
    local _, root = alive(player)
    local position = hitbox.Position
    GameplaySfx.Emit("BatSwing", position)
    local context = deps.TycoonService.GetRequestContext(player)
    local function sampleImpact(sample: number)
        if swings[player] ~= token then
            return
        end
        local currentEquipped = resolveEquippedBat(player)
        trace("impact callback reached sample=" .. tostring(sample))
        if
            swings[player] ~= token
            or player.Character ~= character
            or currentEquipped.Weapon ~= weapon
            or currentEquipped.Tool ~= tool
            or swingRejection(player, currentEquipped) ~= nil
            or not deps.TycoonService.ValidateActor(player, context)
        then
            trace(
                "impact rejected: "
                    .. (swingRejection(player, currentEquipped) or "character/weapon/swing or membership changed")
            )
            swings[player] = nil
            return
        end
        local _, root = alive(player)
        if not root then
            swings[player] = nil
            return
        end
        local level = Config.Levels[levelFor(player)]
        -- Sample the exact issued clone at impact, including authored joints/animation.
        -- configure() owns its size; clients never supply query geometry in the request.
        local hitbox = currentEquipped.Hitbox :: BasePart
        local size, at = hitbox.Size, hitbox.CFrame
        local maxRootDistance = Config.MaxRootDistance * level.Scale
        -- Replicated Tool poses are observations, not authority to hit across the map.
        if not ((at.Position - root.Position).Magnitude <= maxRootDistance) then
            trace("impact rejected: Hitbox pose exceeds sanity distance")
            swings[player] = nil
            return
        end
        trace("Hitbox=" .. hitbox:GetFullName() .. " CFrame=" .. tostring(at) .. " Size=" .. tostring(size))
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character :: Model }
        params.RespectCanCollide = false
        params.MaxParts = 0
        local overlaps = workspace:GetPartBoundsInBox(at, size, params)
        trace("overlap parts=" .. tostring(#overlaps))
        local closest: Model? = nil
        local distance = math.huge
        local candidates: { [Model]: { Player: Player? } } = {}
        for _, part in overlaps do
            local ancestor: Instance? = part
            while ancestor and ancestor ~= workspace do
                if ancestor:IsA("Model") then
                    local victim = Players:GetPlayerFromCharacter(ancestor)
                    if victim then
                        candidates[ancestor] = { Player = victim }
                        trace(
                            "candidate part="
                                .. part.Name
                                .. " character="
                                .. ancestor.Name
                                .. " player="
                                .. victim.Name
                        )
                        break
                    elseif deps.CustomerService.CanHitCustomer(player, ancestor) then
                        candidates[ancestor] = {}
                        break
                    end
                end
                ancestor = ancestor.Parent
            end
        end
        for target, candidate in candidates do
            local victim = candidate.Player
            local targetRoot: BasePart? = nil
            local enemyReason: string? = nil
            if victim then
                local _, playerRoot = alive(victim)
                targetRoot = playerRoot
                enemyReason = enemyRejection(player, victim)
                trace(
                    "candidate="
                        .. victim.Name
                        .. " plot/team/stun/immunity="
                        .. (enemyReason or "pass")
                        .. " sessions="
                        .. tostring(deps.TycoonService.GetSessionId(player))
                        .. "/"
                        .. tostring(deps.TycoonService.GetSessionId(victim))
                )
            elseif deps.CustomerService.CanHitCustomer(player, target) then
                targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
            else
                enemyReason = "customer ineligible"
            end
            if target and targetRoot then
                local direction = targetRoot.Position - root.Position
                local separation = direction.Magnitude
                local forward = root.CFrame.LookVector:Dot(direction)
                local ray = RaycastParams.new()
                ray.FilterType = Enum.RaycastFilterType.Exclude
                ray.FilterDescendantsInstances = { character :: Model }
                local obstruction = workspace:Raycast(root.Position, direction, ray)
                local visible = not obstruction or obstruction.Instance:IsDescendantOf(target)
                trace(
                    string.format(
                        "candidate=%s rootDistance=%.3f sanityDistance=%s forwardDot=%.3f forward=%s LOS=%s obstruction=%s",
                        target.Name,
                        separation,
                        tostring(separation <= maxRootDistance),
                        forward,
                        tostring(forward >= 0),
                        tostring(visible),
                        if obstruction then obstruction.Instance:GetFullName() else "none"
                    )
                )
                if
                    not enemyReason
                    and separation <= maxRootDistance
                    and separation < distance
                    and forward >= 0
                    and visible
                then
                    closest, distance = target, separation
                end
            end
        end
        trace("selected=" .. (if closest then closest.Name else "no valid target"))
        if closest then
            swings[player] = nil
            local victim = Players:GetPlayerFromCharacter(closest)
            if victim then
                hit(player, victim, level)
                trace(
                    "SetStunned result="
                        .. tostring(deps.MovementService.IsStunned(victim))
                        .. " Stunned="
                        .. tostring(victim:GetAttribute("Stunned"))
                        .. " StunnedUntil="
                        .. tostring(victim:GetAttribute("StunnedUntil"))
                )
            else
                local targetRoot = closest:FindFirstChild("HumanoidRootPart") :: BasePart
                deps.CustomerService.HitCustomer(player, closest, {
                    Direction = Knockback.Direction(root, targetRoot),
                    Duration = level.StunDuration,
                })
            end
        end
    end
    -- Keep only one pending sample. Late callbacks expire instead of replaying
    -- missed contacts, and each live sample reads the current Tool geometry.
    local deadline = os.clock() + Config.HitActiveEnd
    local sample = 0
    local function sampleNext()
        if swings[player] ~= token then
            return
        end
        if os.clock() >= deadline then
            swings[player] = nil
            return
        end
        sample += 1
        sampleImpact(sample)
        if swings[player] == token then
            task.delay(math.min(Config.HitSampleInterval, math.max(0, deadline - os.clock())), sampleNext)
        end
    end
    task.delay(Config.HitActiveStart, sampleNext)
    return true
end
function CombatService.ApplyCharacter(player: Player, character: Model)
    local characterToken = {}
    characters[player] = characterToken
    swings[player] = nil
    attackAt[player] = nil
    clearStun(player)
    removeWeapon(player)
    if deaths[player] then
        deaths[player]:Disconnect()
        deaths[player] = nil
    end
    if backpackWatches[player] then
        backpackWatches[player]:Disconnect()
    end
    backpackWatches[player] = player.ChildAdded:Connect(function(child)
        if child:IsA("Backpack") then
            CombatService.RefreshPlayer(player)
        end
    end)
    if removals[player] then
        removals[player]:Disconnect()
    end
    removals[player] = player.CharacterRemoving:Connect(function(removing)
        if removing == character and characters[player] == characterToken then
            characters[player] = nil
            swings[player] = nil
            clearStun(player)
        end
    end)
    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
        if
            characters[player] ~= characterToken
            or not root
            or player.Character ~= character
            or player.Parent ~= Players
            or not humanoid
            or not humanoid:IsA("Humanoid")
        then
            return
        end
        deaths[player] = humanoid.Died:Connect(function()
            swings[player] = nil
            clearStun(player)
            removeWeapon(player)
        end)
        CombatService.RefreshPlayer(player)
    end)
end
function CombatService.RemovePlayer(player: Player)
    if removals[player] then
        removals[player]:Disconnect()
        removals[player] = nil
    end
    characters[player] = nil
    if deaths[player] then
        deaths[player]:Disconnect()
    end
    if backpackWatches[player] then
        backpackWatches[player]:Disconnect()
    end
    deaths[player], backpackWatches[player] = nil, nil
    swings[player], attackAt[player] = nil, nil
    clearStun(player)
    removeWeapon(player)
end
return require(script.Parent.StudioServices).Wrap("CombatService", CombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">CustomerOrderEvaluation</string>
            <string name="Source">--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local CustomerRequests = require(Shared.Constants.CustomerRequests)
local Economy = require(Shared.Constants.Economy)
local Ingredients = require(Shared.Constants.Ingredients)
local Types = require(Shared.Types)

export type Evaluation = {
    Grade: Types.Grade?,
    IsWildcard: boolean,
    MatchCount: number,
    TotalSlots: number,
    RequirementsCovered: boolean,
    RestrictionViolated: boolean,
    IsValid: boolean,
    IsFulfilled: boolean,
    Reason: string,
}

local CustomerOrderEvaluation = {}

local function emptyResult(request: CustomerRequests.Request, reason: string): Evaluation
    local isWildcard = request.Wildcard == true
    return {
        Grade = if isWildcard then nil else "D",
        IsWildcard = isWildcard,
        MatchCount = 0,
        TotalSlots = 0,
        RequirementsCovered = false,
        RestrictionViolated = false,
        IsValid = false,
        IsFulfilled = false,
        Reason = reason,
    }
end

local function matchesTag(tags: { [string]: boolean }, requestedTag: string): boolean
    local normalized = string.lower(requestedTag)
    if tags[normalized] then
        return true
    end
    local group = CustomerRequests.TagGroups[normalized]
    if group then
        for member in group do
            if tags[member] then
                return true
            end
        end
    end
    return false
end

local function matchesRequirement(id: string, requirement: CustomerRequests.IngredientRequirement): boolean
    return if type(requirement) == "string" then requirement == id else table.find(requirement, id) ~= nil
end

function CustomerOrderEvaluation.Evaluate(
    result: Types.Smoothie,
    request: CustomerRequests.Request
): Evaluation
    local ids = result.Ingredients
    local requirements: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    local isWildcard = request.Wildcard == true
    if #ids == 0 then
        return emptyResult(request, "Empty smoothie")
    end
    if #ids &lt; Economy.MaxIngredients then
        return emptyResult(request, "Not enough ingredients")
    end
    if #ids &gt; Economy.MaxIngredients then
        return emptyResult(request, "Too many ingredients")
    end

    local ingredientTags: { [number]: { [string]: boolean } } = {}
    for index, id in ids do
        local definition = Ingredients[id]
        if not definition then
            return emptyResult(request, "Unknown ingredient: " .. id)
        end
        local tags: { [string]: boolean } = {}
        for _, tag in definition.Tags do
            tags[string.lower(tag)] = true
        end
        ingredientTags[index] = tags
    end

    if isWildcard then
        return {
            Grade = nil,
            IsWildcard = true,
            MatchCount = #ids,
            TotalSlots = #ids,
            RequirementsCovered = true,
            RestrictionViolated = false,
            IsValid = true,
            IsFulfilled = true,
            Reason = "Wildcard fulfilled",
        }
    end
    local requiredTags: { string } = request.RequiredTags or {}
    if #requiredTags == 0 and #requirements == 0 then
        return emptyResult(request, "Empty request")
    end
    if request.ExactIngredients and #requirements == 0 then
        return emptyResult(request, "ExactIngredients requires at least one RequiredIngredient")
    end

    local restrictionReason: string? = nil
    local forbiddenTags: { string } = request.ForbiddenTags or {}
    for _, forbiddenTag in forbiddenTags do
        for _, tags in ingredientTags do
            if tags[string.lower(forbiddenTag)] then
                restrictionReason = "Contains forbidden tag: " .. forbiddenTag
                break
            end
        end
        if restrictionReason then
            break
        end
    end
    local forbiddenIngredients: { string } = request.ForbiddenIngredients or {}
    if not restrictionReason then
        for _, id in ids do
            if table.find(forbiddenIngredients, id) then
                restrictionReason = "Contains forbidden ingredient: " .. id
                break
            end
        end
    end
    local allTagsCovered = true
    local missingTag: string? = nil
    for _, requiredTag in requiredTags do
        local covered = false
        for _, tags in ingredientTags do
            if matchesTag(tags, requiredTag) then
                covered = true
                break
            end
        end
        if not covered then
            allTagsCovered = false
            missingTag = missingTag or requiredTag
        end
    end

    -- Find the maximum one-to-one assignment between physical ingredients and request slots.
    local assignedSlots: { [number]: number } = {}
    local function assignSlot(slot: number, visited: { [number]: boolean }): boolean
        local requirement = requirements[slot]
        for index, id in ids do
            if matchesRequirement(id, requirement) and not visited[index] then
                visited[index] = true
                local previousSlot = assignedSlots[index]
                if not previousSlot or assignSlot(previousSlot, visited) then
                    assignedSlots[index] = slot
                    return true
                end
            end
        end
        return false
    end
    local matchedSlots = 0
    for slot in requirements do
        if assignSlot(slot, {}) then
            matchedSlots += 1
        end
    end
    local allIngredientSlotsCovered = matchedSlots == #requirements

    local relevantCount = 0
    for index, id in ids do
        local relevant = false
        for _, requiredTag in requiredTags do
            if matchesTag(ingredientTags[index], requiredTag) then
                relevant = true
                break
            end
        end
        if not relevant then
            for _, requirement in requirements do
                if matchesRequirement(id, requirement) then
                    relevant = true
                    break
                end
            end
        end
        if relevant then
            relevantCount += 1
        end
    end
    local matchCount = if request.ExactIngredients then matchedSlots else relevantCount
    local exactCountMatches = not request.ExactIngredients or #ids == #requirements
    local requirementsCovered = allTagsCovered and allIngredientSlotsCovered and exactCountMatches
    local reason = "Request requirements matched"
    if not allTagsCovered then
        reason = "Missing required tag: " .. (missingTag :: string)
    elseif not allIngredientSlotsCovered then
        for slot, requirement in requirements do
            if not assignSlot(slot, {}) then
                local description = if type(requirement) == "string"
                    then requirement
                    else table.concat(requirement, " or ")
                reason = "Missing required ingredient: " .. description
                break
            end
        end
    elseif not exactCountMatches then
        reason = "Exact ingredient mismatch"
    end
    if restrictionReason then
        return {
            Grade = "D",
            IsWildcard = false,
            MatchCount = matchCount,
            TotalSlots = if request.ExactIngredients then #requirements else #ids,
            RequirementsCovered = requirementsCovered,
            RestrictionViolated = true,
            IsValid = true,
            IsFulfilled = false,
            Reason = restrictionReason,
        }
    end

    local grade: Types.Grade
    if request.ExactIngredients then
        if matchCount == 0 then
            grade = "D"
        elseif matchCount == 1 then
            grade = "C"
        elseif matchCount &lt; #requirements then
            grade = "B"
        elseif requirementsCovered then
            grade = "A"
        else
            grade = "C"
        end
    elseif matchCount == 0 then
        grade = "D"
    elseif matchCount &gt;= 3 and requirementsCovered then
        grade = "A"
    elseif matchCount &gt;= 2 and requirementsCovered then
        grade = "B"
    else
        grade = "C"
    end
    return {
        Grade = grade,
        IsWildcard = false,
        MatchCount = matchCount,
        TotalSlots = if request.ExactIngredients then #requirements else #ids,
        RequirementsCovered = requirementsCovered,
        RestrictionViolated = false,
        IsValid = true,
        IsFulfilled = grade == "A" or grade == "B",
        Reason = reason,
    }
end

return CustomerOrderEvaluation</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">CustomerPlacement</string>
            <string name="Source"><![CDATA[--!strict
-- Markers describe ground surfaces, not avatar pivot heights.
local CustomerPlacement = {}

function CustomerPlacement.BottomOffset(model: Model): number
    local bounds, size = model:GetBoundingBox()
    local halfHeight = (
        math.abs(bounds.RightVector.Y) * size.X
        + math.abs(bounds.UpVector.Y) * size.Y
        + math.abs(bounds.LookVector.Y) * size.Z
    ) / 2
    local offset = model:GetAttribute("CustomerVerticalOffset")
    local extra = if type(offset) == "number" and offset == offset and math.abs(offset) < math.huge then offset else 0
    return model:GetPivot().Position.Y - (bounds.Position.Y - halfHeight) + extra
end

function CustomerPlacement.AtMarker(marker: BasePart, bottomOffset: number): CFrame
    -- Top surface at the marker's center X/Z. Author upright, horizontal route markers.
    local position = marker.CFrame.Position
    local grounded = Vector3.new(position.X, position.Y + marker.Size.Y / 2 + bottomOffset, position.Z)
    return CustomerPlacement.Face(grounded, grounded + marker.CFrame.LookVector, marker.CFrame)
end

function CustomerPlacement.Face(position: Vector3, target: Vector3, fallback: CFrame): CFrame
    local direction = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
    if direction.Magnitude < 0.0001 then
        direction = Vector3.new(fallback.LookVector.X, 0, fallback.LookVector.Z)
        if direction.Magnitude < 0.0001 then
            direction = Vector3.new(0, 0, -1)
        end
    end
    return CFrame.lookAt(position, position + direction)
end

return CustomerPlacement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">CustomerPresentation</string>
            <string name="Source"><![CDATA[--!strict
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local MoneyFormat = require(game:GetService("ReplicatedStorage").Shared.MoneyFormat)
local CustomerPresentation = {}

local RESULT_DURATION = 4
local RESULT_GAP = 6
local RESULT_DROP = 32
local GRADE_COLORS: { [string]: string } = {
    A = "rgb(100,225,120)",
    B = "rgb(100,170,255)",
    C = "rgb(195,135,255)",
    D = "rgb(255,95,95)",
    F = "rgb(255,95,95)",
}

-- Measure once in the resting pose; never follow the animated Head or camera axes.
function CustomerPresentation.CreateAnchor(root: BasePart, head: BasePart?): Attachment
    local height = if head then head.Position.Y - root.Position.Y + head.Size.Y / 2 else root.Size.Y / 2
    local anchor = Instance.new("Attachment")
    anchor.Name = "ServePromptOrigin"
    anchor.Position = Vector3.new(0, math.max(0, height) + 0.35, 0)
    anchor.Parent = root
    return anchor
end

local function outline(text: TextLabel)
    TextStyle.Outline(text)
end

-- Both customer types share lettering; specials retain their separate name row.
local function styleDialogueText(text: TextLabel, size: number)
    text.Font = TextStyle.Font
    text.TextSize = size
    text.TextScaled = false
    text.TextWrapped = true
    text.TextColor3 = Color3.new(1, 1, 1)
    text.LineHeight = 1
    outline(text)
end

function CustomerPresentation.StyleDialogue(bubble: BillboardGui, text: TextLabel, special: boolean)
    if not special then
        bubble.Size = UDim2.fromOffset(300, 112)
        text.Size = UDim2.fromScale(1, 1)
    end
    styleDialogueText(text, 21)
    local name = bubble:FindFirstChild("CustomerName")
    if name and name:IsA("TextLabel") then
        name.Visible = special
        if special then
            styleDialogueText(name, 18)
        end
    end
end

function CustomerPresentation.ShowResult(
    order: BillboardGui,
    grade: string?,
    payout: number,
    ingredientValue: number?
): BillboardGui
    -- Serving has disabled both action prompts. Lower the reaction and reward as
    -- one fixed-pixel stack, keeping their gap and special name row intact.
    order.SizeOffset = Vector2.new(order.SizeOffset.X, 0.5 - RESULT_DROP / order.Size.Y.Offset)
    local cash = tostring(math.abs(payout)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    local reward = (if payout < 0 then "-$" else "+$") .. cash
    local rewardColor = if payout < 0 then "rgb(255,95,95)" else "rgb(255,222,115)"
    local gui = Instance.new("BillboardGui")
    gui.Name = "CustomerResult"
    gui.Adornee = order.Adornee
    gui.StudsOffset = Vector3.zero
    local height = if ingredientValue == nil then 32 elseif grade == "D" then 76 else 54
    gui.Size = UDim2.fromOffset(300, height)
    -- Same stable anchor, fixed pixel rows above the entire reaction dialogue.
    local dialogueTop = (order.SizeOffset.Y + 0.5) * order.Size.Y.Offset
    gui.SizeOffset = Vector2.new(0, (dialogueTop + height / 2 + RESULT_GAP) / height)
    gui.AlwaysOnTop = true
    gui.MaxDistance = order.MaxDistance
    gui.Enabled = false
    local function row(name: string, y: number, height: number, size: number, content: string): TextLabel
        local text = Instance.new("TextLabel")
        text.Name = name
        text.Size = UDim2.fromOffset(300, height)
        text.Position = UDim2.fromOffset(0, y)
        text.BackgroundTransparency = 1
        text.Font = TextStyle.Font
        text.TextSize = size
        text.TextScaled = false
        text.TextColor3 = Color3.new(1, 1, 1)
        text.RichText = true
        text.Text = content
        outline(text)
        text.Parent = gui
        return text
    end
    local resultText = if grade
        then string.format(
            '<font color="%s">%s</font>  <font color="%s">%s</font>',
            GRADE_COLORS[grade] or "rgb(255,255,255)",
            grade,
            rewardColor,
            reward
        )
        else '<font color="' .. rewardColor .. '">' .. reward .. "</font>"
    row("Result", 0, 32, 24, resultText)
    if ingredientValue ~= nil then
        row(
            "Ingredients",
            34,
            20,
            18,
            'Ingredients: <font color="rgb(100,225,120)">' .. MoneyFormat.Compact(ingredientValue) .. "</font>"
        )
    end
    if grade == "D" then
        local retry = row("Retry", 56, 20, 16, "TRY AGAIN \u{00B7} 15% PAYOUT")
        retry.TextColor3 = Color3.fromRGB(255, 95, 95)
    end
    gui.Parent = order.Parent
    gui:SetAttribute("ResultExpiresAt", os.clock() + RESULT_DURATION)
    game:GetService("Debris"):AddItem(gui, RESULT_DURATION)
    return gui
end

-- Cosmetic geometry only: never call IngredientService.Spawn or register an item.
function CustomerPresentation.AttachStolenIngredient(model: Model, visual: Instance): Instance?
    local root = model:FindFirstChild("HumanoidRootPart")
    local part = if visual:IsA("BasePart") then visual elseif visual:IsA("Model") then visual.PrimaryPart else nil
    if not root or not root:IsA("BasePart") or not part then
        visual:Destroy()
        return nil
    end
    local descendants = visual:GetDescendants()
    table.insert(descendants, visual)
    for _, child in descendants do
        for name in child:GetAttributes() do
            child:SetAttribute(name, nil)
        end
        if child:IsA("BasePart") then
            child.Anchored = false
            child.CanCollide, child.CanTouch, child.CanQuery = false, false, false
            child.Massless = true
        end
    end
    local at = root.CFrame * CFrame.new(1.4, 0, -0.8)
    if visual:IsA("Model") then
        visual:PivotTo(at)
    else
        part.CFrame = at
    end
    visual.Name = "StolenIngredientVisual"
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1 = root, part
    weld.Parent = part
    visual.Parent = model
    return visual
end

-- A short exit route must not truncate the readable hold or delay the next customer.
-- Snapshot only the presentation at the final root position before normal rig cleanup.
function CustomerPresentation.PreserveResult(gui: BillboardGui)
    local expires = gui:GetAttribute("ResultExpiresAt")
    local anchor = gui.Adornee
    if
        not gui.Parent
        or typeof(expires) ~= "number"
        or expires <= os.clock()
        or not anchor
        or not anchor:IsA("Attachment")
    then
        return
    end
    local root = anchor.Parent
    if not root or not root:IsA("BasePart") then
        return
    end
    local customer = root.Parent
    if not customer then
        return
    end
    local holder = Instance.new("Model")
    holder.Name = "CustomerResultHold"
    holder:SetAttribute("OwnerUserId", customer:GetAttribute("OwnerUserId"))
    local origin = Instance.new("Part")
    origin.Name = "ResultOrigin"
    origin.Anchored = true
    origin.Transparency = 1
    origin.CanCollide, origin.CanTouch, origin.CanQuery = false, false, false
    origin.CFrame = root.CFrame
    origin.Parent = holder
    local fixedAnchor = Instance.new("Attachment")
    fixedAnchor.Position = anchor.Position
    fixedAnchor.Parent = origin
    local copy = gui:Clone()
    copy.Enabled = false
    copy.Adornee = fixedAnchor
    copy.Parent = origin
    holder.Parent = workspace
    game:GetService("Debris"):AddItem(holder, math.max(0, expires - os.clock()))
end

-- Presentation only: keys are normalized tags, never ingredient-derived colors.
-- Aliases describe wording in authored dialogue; they do not change tag validation.
CustomerPresentation.TagHighlights = {
    red = { Color = Color3.fromRGB(255, 95, 95) },
    yellow = { Color = Color3.fromRGB(255, 220, 65) },
    green = { Color = Color3.fromRGB(100, 225, 120) },
    purple = { Color = Color3.fromRGB(195, 135, 255) },
    blue = { Color = Color3.fromRGB(100, 170, 255) },
    cold = { Color = Color3.fromRGB(105, 225, 255) },
    sweet = { Color = Color3.fromRGB(255, 140, 200) },
    spicy = { Color = Color3.fromRGB(255, 140, 65), Aliases = { "spice", "heat" } },
    protein = { Color = Color3.fromRGB(235, 180, 120) },
    fruit = { Color = Color3.fromRGB(255, 175, 95), Aliases = { "fruity" } },
    seafood = { Color = Color3.fromRGB(95, 215, 200), Aliases = { "ocean", "fish" } },
    ["fast food"] = { Color = Color3.fromRGB(255, 190, 75) },
    milk = { Color = Color3.fromRGB(190, 205, 255) },
    weird = { Color = Color3.fromRGB(210, 145, 245) },
    sour = { Color = Color3.fromRGB(195, 235, 85) },
    veggie = { Color = Color3.fromRGB(135, 215, 105), Aliases = { "veggies" } },
    mushroom = { Color = Color3.fromRGB(220, 180, 145), Aliases = { "mushrooms" } },
    watermelon = { Color = Color3.fromRGB(255, 130, 155) },
    steak = { Color = Color3.fromRGB(225, 140, 120) },
} :: { [string]: { Color: Color3, Aliases: { string }? } }

function CustomerPresentation.HideDefaultDisplay(humanoid: Humanoid)
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
end

local function nonempty(value: any): string?
    return if type(value) == "string" and string.find(value, "%S") then value else nil
end

function CustomerPresentation.DisplayName(
    template: Model,
    special: boolean,
    configured: string?,
    identity: string?
): string
    if not special then
        return "CustomerNPC"
    end
    local humanoid = template:FindFirstChildOfClass("Humanoid")
    return (if humanoid then nonempty(humanoid.DisplayName) else nil)
        or nonempty(configured)
        or nonempty(identity)
        or template.Name
end

function CustomerPresentation.Response(
    request: { GoodResponse: string?, GoodResponses: { string }?, BadResponse: string? },
    grade: string
): string?
    if grade == "A" or grade == "B" then
        local responses = request.GoodResponses
        if responses and #responses > 0 then
            return nonempty(responses[math.random(1, #responses)]) or nonempty(request.GoodResponse)
        end
        return nonempty(request.GoodResponse)
    elseif grade == "C" or grade == "D" or grade == "F" then
        return nonempty(request.BadResponse)
    end
    return nil
end

return CustomerPresentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">CustomerService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local Customers = require(Shared.Constants.Customers)
local CustomerRequests = require(Shared.Constants.CustomerRequests)
local TutorialOrders = require(Shared.Constants.TutorialOrders)
local tutorialRequests: { [number]: CustomerRequests.Request } = {}
for index, order in TutorialOrders do
    for _, request in CustomerRequests.Definitions do
        if request.Id == order.RequestId then
            tutorialRequests[index] = request
            break
        end
    end
end
local Ingredients = require(Shared.Constants.Ingredients)
local RunService = game:GetService("RunService")
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local Types = require(Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local Placement = require(script.Parent.CustomerPlacement)
local Walk = require(script.Parent.CustomerWalk)
local Presentation = require(script.Parent.CustomerPresentation)
local AudioService = require(script.Parent.AudioService)
local Film = require(script.Parent.FilmingUtil)
local BatConfig = require(Shared.Constants.BatConfig)
local Knockback = require(script.Parent.BatKnockback)
local GameplaySfx = require(script.Parent.GameplaySfxService)
local OrderEvaluation = require(script.Parent.CustomerOrderEvaluation)
local BadCustomers = require(Shared.Constants.BadCustomers)
local BadBehavior = require(script.Parent.BadCustomerBehavior)
local RejectFloorButton = require(script.Parent.RejectFloorButton)
local CustomerService = {}
local deps: any
local onServed: (Player, Types.Grade?) -> ()
local queues: { [string]: any } = {}
local function key(player: Player): string
    return deps.TycoonService.GetSessionId(player) or ""
end
local queueMarkers = { "CustomerCounter", "CustomerWait1", "CustomerWait2" }
local function front(player: Player): any
    local queue = queues[key(player)]
    return if queue then queue.Customers[1] else nil
end
local function current(_player: Player, queue: any): boolean
    return queues[queue.SessionId] == queue and deps.TycoonService.GetSessionOwner(queue.SessionId) ~= nil
end
local ownedModels: { [string]: { [Model]: any } } = {}
local lastSpecialSpawn: { [string]: number } = {}
local lastTemplates: { [string]: Model } = {}
-- Runtime-only regular selections survive flow restarts.
local recentTemplates: { [string]: { Model } } = {}
local recentRequests: { [string]: { string } } = {}
local recentRequestGroups: { [string]: { string } } = {}
local recentRequestSimilarity: { [string]: { { string } } } = {}

local function remember<T>(histories: { [string]: { T } }, player: Player, value: T, window: number)
    local history = histories[key(player)] or {}
    table.insert(history, value)
    while #history > math.max(0, window) do
        table.remove(history, 1)
    end
    histories[key(player)] = history
end
local warnedTemplates = setmetatable({} :: { [Instance]: boolean }, { __mode = "k" })
local activeTypingTasks = setmetatable({}, { __mode = "k" })
local CustomerNameHeight = 28
local CUSTOMER_ORDER_MAX_DISTANCE = 30
local CUSTOMER_ORDER_WIDTH = 270
local CUSTOMER_ORDER_TEXT_HEIGHT = 56
local CUSTOMER_ORDER_TEXT_SIZE = 21

local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[CustomerService] " .. message)
    end
end

-- Validate authored request metadata; runtime matching and grading live in OrderEvaluation.
-- Read definitions from actual ingredient IDs, never cup attributes or supplied result.Tags.
-- Only tag comparisons ignore case; ingredient IDs and CustomerIds keep their existing semantics.
function CustomerService.ValidateRequestDefinition(request: CustomerRequests.Request): { string }
    local diagnostics: { string } = {}
    local requiredIngredients: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    for slot, requirement in requiredIngredients do
        if type(requirement) == "table" then
            local accessible = false
            local valid = false
            if #requirement == 0 then
                table.insert(diagnostics, "Empty ingredient alternative group at slot " .. slot)
            end
            for _, id in requirement do
                local definition = Ingredients[id]
                if not definition then
                    table.insert(diagnostics, "Unknown required ingredient: " .. id)
                else
                    valid = true
                    accessible = accessible or definition.JumpLocation <= request.MinJumpTier
                end
            end
            if valid and not accessible then
                table.insert(
                    diagnostics,
                    "No ingredient alternative at slot "
                        .. slot
                        .. " is accessible at MinJumpTier "
                        .. request.MinJumpTier
                )
            end
            continue
        end
        local id = requirement
        local definition = Ingredients[id]
        if not definition then
            table.insert(diagnostics, "Unknown required ingredient: " .. id)
        elseif definition.JumpLocation > request.MinJumpTier then
            table.insert(
                diagnostics,
                string.format(
                    "Required ingredient %s needs JumpLocation %d, above MinJumpTier %d",
                    id,
                    definition.JumpLocation,
                    request.MinJumpTier
                )
            )
        end
    end
    local forbiddenIngredients: { string } = request.ForbiddenIngredients or {}
    for _, id in forbiddenIngredients do
        if not Ingredients[id] then
            table.insert(diagnostics, "Unknown forbidden ingredient: " .. id)
        end
    end
    if request.ExactIngredients and #requiredIngredients == 0 then
        table.insert(diagnostics, "ExactIngredients requires at least one RequiredIngredient")
    end
    return diagnostics
end

function CustomerService.ValidateRequest(result: Types.Smoothie, request: CustomerRequests.Request): (boolean, string)
    local evaluation = OrderEvaluation.Evaluate(result, request)
    return evaluation.IsValid and evaluation.RequirementsCovered and not evaluation.RestrictionViolated,
        evaluation.Reason
end

local function eligibleRequests(player: Player): { CustomerRequests.Request }
    -- Purchased session progression; personal Studio movement overrides are irrelevant.
    local playerJumpTier = deps.TycoonService.GetJumpTier(player)
    local eligible: { CustomerRequests.Request } = {}
    for _, request in CustomerRequests.Definitions do
        if not request.NPCOnly and not request.Wildcard and playerJumpTier >= request.MinJumpTier then
            table.insert(eligible, request)
        end
    end
    if #eligible == 0 then
        warn(
            string.format(
                "[CustomerService] No eligible requests for %s at jump tier %s",
                player.Name,
                tostring(playerJumpTier)
            )
        )
    end
    return eligible
end

-- Group choice is uniform, so large groups do not dominate the request queue.
-- Missing metadata shares a legacy bucket; it never makes a request ineligible.
local function variedRequestPool(player: Player, pool: { CustomerRequests.Request }): { CustomerRequests.Request }
    local groups: { [string]: { CustomerRequests.Request } } = {}
    local groupNames: { string } = {}
    local freshGroups: { string } = {}
    local history = recentRequestGroups[key(player)] or {}
    for _, request in pool do
        local group = request.RequestGroup or "Ungrouped"
        if not groups[group] then
            groups[group] = {}
            table.insert(groupNames, group)
            if not table.find(history, group) then
                table.insert(freshGroups, group)
            end
        end
        table.insert(groups[group], request)
    end
    local choices = if #freshGroups > 0 then freshGroups else groupNames
    local group = choices[if #choices == 1 then 1 else math.random(1, #choices)]
    local candidates = groups[group]
    local recentKeys: { [string]: boolean } = {}
    local similarityHistory: { { string } } = recentRequestSimilarity[key(player)] or {}
    for _, keys in similarityHistory do
        for _, concept in keys do
            recentKeys[concept] = true
        end
    end
    local fresh: { CustomerRequests.Request } = {}
    for _, request in candidates do
        local overlaps = false
        local similarityKeys: { string } = request.SimilarityKeys or {}
        for _, concept in similarityKeys do
            if recentKeys[concept] then
                overlaps = true
                break
            end
        end
        if not overlaps then
            table.insert(fresh, request)
        end
    end
    return if #fresh > 0 then fresh else candidates
end

local function assignRequest(player: Player, record: any): boolean
    local selectedRequest = record.FixedRequest
    local forced = selectedRequest ~= nil
    local recentFiltered, recentFallback = false, false
    if selectedRequest and (deps.TycoonService.GetJumpTier(player)) < selectedRequest.MinJumpTier then
        diagnostic("special became ineligible before assignment; removing customer owner=" .. player.Name)
        record.Model:Destroy()
        return false
    end
    -- Identity is already selected. Keep this encounter's roll stable on RefreshOrder.
    if record.Wildcard == nil then
        local chance = if record.CustomerType == "Special"
            then CustomerRequests.SpecialWildcardChance
            else CustomerRequests.RegularWildcardChance
        record.Wildcard = chance > 0 and math.random() < chance
    end
    if record.Wildcard then
        selectedRequest = CustomerRequests.WildcardRequest
    end
    if not selectedRequest then
        local eligible = eligibleRequests(player)
        if #eligible == 0 then
            record.Model:Destroy()
            return false
        end
        local pool = eligible
        if record.CustomerType == "Regular" then
            local fresh: { CustomerRequests.Request } = {}
            for _, request in eligible do
                if not table.find(recentRequests[key(player)] or {}, request.Id) then
                    table.insert(fresh, request)
                end
            end
            recentFiltered = #fresh < #eligible
            recentFallback = #fresh == 0
            if #fresh > 0 then
                pool = fresh
            end
            pool = variedRequestPool(player, pool)
        end
        selectedRequest = pool[math.random(1, #pool)]
    end
    local request = selectedRequest :: CustomerRequests.Request
    record.Request = request
    record.RequestId = request.Id
    -- RefreshOrder can replace a gameplay request; revisiting an ID on this
    -- customer keeps its original line. UI refreshes never draw dialogue again.
    record.RequestTexts = record.RequestTexts or {}
    if not record.RequestTexts[request.Id] then
        local variants = request.DisplayTexts
        record.RequestTexts[request.Id] = if variants and #variants > 0
            then variants[math.random(1, #variants)]
            else request.DisplayText
    end
    record.RequestText = record.RequestTexts[request.Id]
    record.Preference = request.RequiredTags[1] or "Surprise Me"
    record.Model:SetAttribute("Preference", record.Preference)
    record.Model:SetAttribute("RequestId", request.Id)
    if not forced and not request.Wildcard and record.CustomerType == "Regular" then
        remember(recentRequests, player, request.Id, CustomerRequests.RegularRequestRecencyWindow)
        remember(
            recentRequestGroups,
            player,
            request.RequestGroup or "Ungrouped",
            CustomerRequests.RegularRequestGroupRecencyWindow
        )
        remember(
            recentRequestSimilarity,
            player,
            table.clone(request.SimilarityKeys or {}),
            CustomerRequests.RegularRequestSimilarityRecencyWindow
        )
    end
    diagnostic(
        string.format(
            "selected type=%s template=%s customerId=%s displayName=%s request=%s jumpTier=%s forced=%s requestRecencyFiltered=%s requestRecencyFallback=%s",
            record.CustomerType,
            record.TemplateName,
            record.CustomerId or "<absent>",
            record.DisplayName or "<absent>",
            request.Id,
            tostring(deps.TycoonService.GetJumpTier(player)),
            tostring(forced),
            tostring(recentFiltered),
            tostring(recentFallback)
        )
    )
    return true
end

local function npcRoot(model: Model): BasePart?
    local root = model:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then
        return root
    end
    return WorldUtil.Part(model)
end

local function rejectTemplate(template: Instance, reason: string)
    if RunService:IsStudio() and not warnedTemplates[template] then
        warnedTemplates[template] = true
        warn("[CustomerService] Skipping " .. template:GetFullName() .. ": " .. reason)
    end
end

local function cleanClone(model: Model)
    -- This flow owns customer world-space presentation, including on cloned templates.
    for _, object in model:GetDescendants() do
        if
            object:IsA("Script")
            or object:IsA("LocalScript")
            or object:IsA("ModuleScript")
            or object:IsA("Tool")
            or object:IsA("ProximityPrompt")
            or object:IsA("BillboardGui")
            or object:IsA("SurfaceGui")
        then
            object:Destroy()
        end
    end
end

type Candidate = {
    Template: Model,
    CustomerId: string?,
    DisplayName: string?,
    CustomerType: string,
    Request: CustomerRequests.Request?,
    Weight: number,
    Rejectable: boolean?,
    BadCustomerType: string?,
}

local function candidateFor(player: Player, template: Model): Candidate?
    local id = CustomerRequests.NormalizeCustomerId(template:GetAttribute("CustomerId"))
    local config = if id then CustomerRequests.NPCs[id] else nil
    -- Existing RequestId-only mappings remain special; an explicit Regular ignores overrides.
    local kind = if config and (config.Type == "Special" or (not config.Type and config.RequestId))
        then "Special"
        else "Regular"
    local request, reason = CustomerRequests.GetForNPC(id)
    if kind == "Special" then
        if reason then
            rejectTemplate(template, reason)
            return nil
        end
        if request and (deps.TycoonService.GetJumpTier(player)) < request.MinJumpTier then
            diagnostic(
                string.format(
                    "special ineligible customerId=%s request=%s requiredJumpTier=%d playerJumpTier=%s",
                    id or "<absent>",
                    request.Id,
                    request.MinJumpTier,
                    tostring(deps.TycoonService.GetJumpTier(player))
                )
            )
            return nil
        end
    else
        request = nil
    end
    local weight = if config and config.Weight then config.Weight else 1
    if weight ~= weight or weight <= 0 or weight == math.huge then
        rejectTemplate(template, "Weight must be positive and finite")
        return nil
    end
    return {
        Template = template,
        CustomerId = id,
        DisplayName = Presentation.DisplayName(
            template,
            kind == "Special",
            if config then config.DisplayName else nil,
            id
        ),
        CustomerType = kind,
        Request = request,
        Weight = weight,
        Rejectable = config and config.Rejectable == true,
        BadCustomerType = if config then config.BadCustomerType else nil,
    }
end

local function cloneNPC(player: Player, customerId: string?, regularOnly: boolean?): (Model?, Candidate?)
    local folder = ServerStorage:FindFirstChild("CustomerNPCs")
    if customerId then
        local id = CustomerRequests.NormalizeCustomerId(customerId)
        local special = folder and folder:FindFirstChild("Special")
        if id and special and special:IsA("Folder") then
            for _, template in special:GetChildren() do
                if
                    template:IsA("Model")
                    and CustomerRequests.NormalizeCustomerId(template:GetAttribute("CustomerId")) == id
                then
                    local candidate = candidateFor(player, template)
                    if candidate and candidate.CustomerType == "Special" and template.Archivable then
                        local ok, clone = pcall(function()
                            return template:Clone()
                        end)
                        if ok and clone then
                            cleanClone(clone)
                            if clone:FindFirstChildOfClass("Humanoid") and npcRoot(clone) then
                                lastTemplates[key(player)] = template
                                return clone, candidate
                            end
                            clone:Destroy()
                        end
                    end
                end
            end
        end
        warn("[CustomerService] Cannot inject special customer: " .. customerId .. " (check template and jump tier)")
        return nil, nil
    end
    local regular: { Candidate } = {}
    local special: { Candidate } = {}
    if folder and folder:IsA("Folder") then
        for _, kind in { "Regular", "Special" } do
            local source = folder:FindFirstChild(kind)
            if source and source:IsA("Folder") then
                for _, template in source:GetChildren() do
                    if not template:IsA("Model") then
                        rejectTemplate(template, "expected a Model")
                    elseif not template:FindFirstChildOfClass("Humanoid") or not npcRoot(template) then
                        rejectTemplate(template, "requires Humanoid and a BasePart root")
                    elseif not template.Archivable then
                        rejectTemplate(template, "enable Archivable to allow cloning")
                    else
                        local candidate = candidateFor(player, template)
                        if candidate and candidate.CustomerType == kind then
                            table.insert(if kind == "Special" then special else regular, candidate)
                        elseif candidate then
                            rejectTemplate(template, "CustomerId mapping does not match source folder " .. kind)
                        end
                    end
                end
            elseif source then
                rejectTemplate(source, kind .. " must be a Folder")
            end
        end
    elseif folder then
        rejectTemplate(folder, "CustomerNPCs must be a Folder")
    end
    if #regular > 0 then
        for index = #special, 1, -1 do
            if special[index].Template == lastTemplates[key(player)] then
                table.remove(special, index)
            end
        end
    end
    local useSpecial = not regularOnly
        and #special > 0
        and (lastSpecialSpawn[key(player)] == nil or os.clock() - lastSpecialSpawn[key(player)] >= Economy.SpecialCustomerCooldownSeconds)
        and math.random() < CustomerRequests.SpecialCustomerChance
    local candidates = if useSpecial then special else regular
    -- Regulars use rolling recency; specials retain their existing immediate-repeat rule.
    -- Never increase special frequency to avoid a regular repeat.
    local function take(pool: { Candidate }): (Candidate, boolean, boolean)
        local alternatives: { number } = {}
        for index, candidate in pool do
            local recent = if candidate.CustomerType == "Regular"
                then table.find(recentTemplates[key(player)] or {}, candidate.Template) ~= nil
                else candidate.Template == lastTemplates[key(player)]
            if not recent then
                table.insert(alternatives, index)
            end
        end
        local filtered, fallback = #alternatives < #pool, #alternatives == 0
        if fallback then
            for index in pool do
                table.insert(alternatives, index)
            end
        end
        local total = 0
        for _, index in alternatives do
            total += pool[index].Weight
        end
        local roll = math.random() * total
        local chosen = alternatives[#alternatives]
        for _, index in alternatives do
            roll -= pool[index].Weight
            if roll < 0 then
                chosen = index
                break
            end
        end
        return table.remove(pool, chosen) :: Candidate, filtered, fallback
    end
    while #candidates > 0 do
        local candidate, filtered, fallback = take(candidates)
        local template = candidate.Template
        local ok, clone = pcall(function()
            return template:Clone()
        end)
        if ok and clone then
            cleanClone(clone)
        end
        if ok and clone and clone:FindFirstChildOfClass("Humanoid") and npcRoot(clone) then
            lastTemplates[key(player)] = template
            if candidate.CustomerType == "Regular" then
                remember(recentTemplates, player, template, CustomerRequests.RegularCustomerRecencyWindow)
                diagnostic(
                    string.format(
                        "regular template=%s customerRecencyFiltered=%s customerRecencyFallback=%s owner=%s",
                        template:GetFullName(),
                        tostring(filtered),
                        tostring(fallback),
                        player.Name
                    )
                )
            end
            return clone, candidate
        end
        if ok and clone then
            clone:Destroy()
        end
        rejectTemplate(template, "clone failed or required descendants are not Archivable")
        if #candidates == 0 and useSpecial then
            candidates = regular
            useSpecial = false
        end
    end
    return nil, nil
end

-- Legacy compatibility: day boundaries no longer reset special eligibility.
function CustomerService.BeginDay(_player: Player) end

local function ensureCustomerCounterGlow(customerModel: Model): ParticleEmitter?
    local existingGlow = customerModel:FindFirstChild("CustomerCounterGlow")
    if existingGlow and existingGlow:IsA("ParticleEmitter") then
        return existingGlow
    end

    local rootPart = customerModel.PrimaryPart
        or customerModel:FindFirstChild("HumanoidRootPart")
        or customerModel:FindFirstChild("Head")
        or customerModel:FindFirstChild("Torso")

    if not rootPart then
        return nil
    end

    local counterGlow = Instance.new("ParticleEmitter")
    counterGlow.Name = "CustomerCounterGlow"
    counterGlow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    counterGlow.Rate = 0
    counterGlow.Speed = NumberRange.new(0.5, 1)
    counterGlow.Lifetime = NumberRange.new(0.4, 0.7)
    counterGlow.Color = ColorSequence.new(Color3.fromRGB(255, 224, 100))
    counterGlow.Parent = rootPart

    return counterGlow
end

local function escapeRichText(message: string): string
    local escaped = message:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    return escaped
end

function CustomerService.FormatRequestText(request: CustomerRequests.Request, displayText: string?): string
    local names: { { Name: string, Color: Color3 } } = {}
    local seen: { [string]: boolean } = {}
    local requiredIngredients: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    for _, requirement in requiredIngredients do
        local alternatives: { string } = if type(requirement) == "string" then { requirement } else requirement
        for _, id in alternatives do
            local definition = Ingredients[id]
            if definition then
                local name = string.lower(definition.DisplayName or definition.Id)
                if name ~= "" and not seen[name] then
                    seen[name] = true
                    table.insert(names, { Name = name, Color = definition.BlendColor })
                end
            end
        end
    end
    -- Ingredient names were added first, so a tag cannot replace their catalog color.
    local function addTag(tag: string)
        local normalized = string.lower(tag)
        local highlight = Presentation.TagHighlights[normalized]
        if not highlight then
            return
        end
        local phrases = { normalized }
        local aliases: { string } = highlight.Aliases or {}
        for _, alias in aliases do
            table.insert(phrases, alias)
        end
        for _, phrase in phrases do
            if not seen[phrase] then
                seen[phrase] = true
                table.insert(names, { Name = phrase, Color = highlight.Color })
            end
        end
    end
    local requiredTags: { string } = request.RequiredTags or {}
    for _, tag in requiredTags do
        addTag(tag)
    end
    local forbiddenTags: { string } = request.ForbiddenTags or {}
    for _, tag in forbiddenTags do
        addTag(tag)
    end
    -- Prefer full multiword names over shorter names contained within them.
    table.sort(names, function(a, b)
        return #a.Name > #b.Name
    end)
    local message = displayText or request.DisplayText
    local lower = string.lower(message)
    local output: { string } = {}
    local index = 1
    while index <= #message do
        local matched = false
        for _, entry in names do
            local last = index + #entry.Name - 1
            if
                lower:sub(index, last) == entry.Name
                and not lower:sub(index - 1, index - 1):match("[%w_]")
                and not lower:sub(last + 1, last + 1):match("[%w_]")
            then
                local color = entry.Color
                table.insert(
                    output,
                    string.format(
                        '<font color="rgb(%d,%d,%d)">%s</font>',
                        math.round(color.R * 255),
                        math.round(color.G * 255),
                        math.round(color.B * 255),
                        escapeRichText(message:sub(index, last))
                    )
                )
                index = last + 1
                matched = true
                break
            end
        end
        if not matched then
            table.insert(output, escapeRichText(message:sub(index, index)))
            index += 1
        end
    end
    return table.concat(output)
end

local function typewriterText(textLabel: TextLabel, message: string, dialogueSound: Sound?, richMessage: string?)
    local currentToken = {}
    activeTypingTasks[textLabel] = currentToken
    AudioService.PlayCustomerDialogue(dialogueSound)
    local totalGraphemes = 0
    for _ in utf8.graphemes(message) do
        totalGraphemes += 1
    end

    textLabel.RichText = true
    textLabel.MaxVisibleGraphemes = 0
    textLabel.Text = richMessage or escapeRichText(message)

    task.spawn(function()
        local index = 0
        local replayScheduled = false
        for _ in utf8.graphemes(message) do
            index += 1
            if not textLabel.Parent or activeTypingTasks[textLabel] ~= currentToken then
                return
            end

            textLabel.MaxVisibleGraphemes = index

            task.wait(0.04)

            local remainingGraphemes = totalGraphemes - index
            if
                dialogueSound
                and dialogueSound.Parent
                and not dialogueSound.IsPlaying
                and remainingGraphemes >= 4
                and not replayScheduled
                and textLabel.Parent
                and activeTypingTasks[textLabel] == currentToken
            then
                replayScheduled = true
                task.delay(0.08, function()
                    replayScheduled = false
                    if
                        textLabel.Parent
                        and activeTypingTasks[textLabel] == currentToken
                        and totalGraphemes - index >= 4
                    then
                        AudioService.PlayCustomerDialogue(dialogueSound)
                    end
                end)
            end
        end

        if textLabel.Parent and activeTypingTasks[textLabel] == currentToken then
            textLabel.MaxVisibleGraphemes = -1
            activeTypingTasks[textLabel] = nil
        end
    end)
end

function CustomerService.Init(services, servedCallback, _servingCallback)
    deps = services
    onServed = servedCallback
    if RunService:IsStudio() then
        for _, request in CustomerRequests.Definitions do
            for _, message in CustomerService.ValidateRequestDefinition(request) do
                warn("[CustomerService] Request " .. request.Id .. ": " .. message)
            end
        end
    end
end

-- Grade and reaction are deliberately independent, pure decision functions.
function CustomerService.EvaluateOrder(
    result: Types.Smoothie,
    request: CustomerRequests.Request
): OrderEvaluation.Evaluation
    return OrderEvaluation.Evaluate(result, request)
end
function CustomerService.CalculateGrade(result: Types.Smoothie, preference: string): Types.Grade?
    local request: CustomerRequests.Request = {
        Id = "LegacyPreference",
        DisplayText = preference,
        RequiredTags = if preference == "Surprise Me" then {} else { preference },
        BasePayout = 0,
        MinJumpTier = 0,
        Wildcard = preference == "Surprise Me",
    }
    return OrderEvaluation.Evaluate(result, request).Grade
end
function CustomerService.SelectReaction(): string
    local total = 0
    for _, reaction in Customers.Reactions do
        total += reaction.Weight
    end
    local roll = math.random() * total
    for _, reaction in Customers.Reactions do
        roll -= reaction.Weight
        if roll <= 0 then
            return reaction.Id
        end
    end
    return Customers.Reactions[1].Id
end
function CustomerService.CalculatePayout(player: Player, grade: Types.Grade): number
    local upgrade = Upgrades.Payout[deps.TycoonService.GetUpgrade(player, "Payout")].Value
    local multiplier = if deps.PlayerDataService.HasEntitlement(player, "DoubleCash") then 2 else 1
    local muncher = if deps.MuncherService then deps.MuncherService.GetCashMultiplier(player) else 1
    return math.round(
        Economy.BasePayout * Economy.CashScale * Economy.GradeMultiplier[grade] * upgrade * multiplier * muncher
    )
end

-- Called only with the consumed server cup and the customer's assigned request.
local IngredientItem = require(game:GetService("ReplicatedStorage").Shared.IngredientItem)
function CustomerService.CalculateOrderPayout(
    player: Player,
    result: Types.Smoothie,
    request: CustomerRequests.Request,
    evaluation: OrderEvaluation.Evaluation?
): (number, number)
    local ingredientValue = IngredientItem.GetSmoothieValue(result, workspace:GetServerTimeNow())
    evaluation = evaluation or OrderEvaluation.Evaluate(result, request)
    local upgrade = Upgrades.Payout[deps.TycoonService.GetUpgrade(player, "Payout")].Value
    local entitlement = if deps.PlayerDataService.HasEntitlement(player, "DoubleCash") then 2 else 1
    local gradeMultiplier = if evaluation.IsWildcard
        then 1
        else Economy.GradeMultiplier[evaluation.Grade :: Types.Grade]
    local muncher = if deps.MuncherService then deps.MuncherService.GetCashMultiplier(player) else 1
    local amount = (ingredientValue + request.BasePayout) * gradeMultiplier * upgrade * entitlement * muncher
    return math.round(amount), ingredientValue
end
function CustomerService.CanSpawn(player: Player): (boolean, string?)
    local queue = queues[key(player)]
    if not queue or not current(player, queue) then
        return false, "Plot flow inactive"
    end
    if #queue.Customers >= Economy.MaxCustomersPerPlot then
        return false, "Customer queue full"
    end
    if #eligibleRequests(player) == 0 then
        return false, "No eligible customer requests"
    end
    for _, name in { "CustomerSpawn", "CustomerCounter", "CustomerWait1", "CustomerWait2", "CustomerExit" } do
        local marker, reason = deps.TycoonService.GetReference(player, name)
        if not marker then
            local message = "Cannot resolve "
                .. name
                .. " in "
                .. player.Name
                .. "'s plot: "
                .. (reason or "Missing marker")
            if RunService:IsStudio() then
                warn("[CustomerService] " .. message)
            end
            return false, message
        end
    end
    return true
end
-- Keep all low-level traversal and pose handling in the existing walking helper.
local function move(record: any, destination: CFrame, finished: () -> ())
    Walk.Move(record, destination, function(reached)
        if reached or (record.ReturningFromHit and not record.Served) then
            if not reached then
                -- CustomerWalk already exhausted its bounded retries. Preserve the order.
                record.Root.AssemblyLinearVelocity = Vector3.zero
                record.Root.AssemblyAngularVelocity = Vector3.zero
                record.Model:PivotTo(destination)
            end
            if record.ReturningFromHit then
                record.ReturningFromHit = false
                record.HitImmuneUntil = os.clock() + BatConfig.ImmunitySeconds
                record.TakeOrderPrompt.Enabled = not record.Served and not record.OrderTaken
            end
            finished()
        elseif record.Model.Parent then
            -- Existing Destroying cleanup removes the failed entry and advances waiters.
            warn("[CustomerWalk] route exhausted; removing unreachable customer")
            record.Model:Destroy()
        end
    end)
end
-- Authoritative queue index maps directly to its destination marker; no intermediate entrance route.
function CustomerService.RefreshQueue(player: Player)
    local queue = queues[key(player)]
    if not queue then
        return
    end
    if not current(player, queue) then
        CustomerService.DeactivateForPlayer(player)
        return
    end
    for index, record in queue.Customers do
        local marker = deps.TycoonService.GetReference(player, queueMarkers[index])
        record.Model:SetAttribute("QueuePosition", index)
        if not marker then
            Walk.Cancel(record)
            record.TargetMarker = nil
            record.Ready = false
            record.Prompt.Enabled = false
            record.Walk.SetMoving(false)
        else
            local destination = Placement.AtMarker(marker, record.BottomOffset)
            local changed = record.TargetMarker ~= marker
                or record.MarkerFrame ~= marker.CFrame
                or record.QueueIndex ~= index
            if record.Recovering then
                record.TargetMarker = marker
                record.MarkerFrame = marker.CFrame
                record.QueueIndex = index
                record.Ready = false
                record.Prompt.Enabled = false
            elseif changed then
                record.TargetMarker = marker
                record.MarkerFrame = marker.CFrame
                record.QueueIndex = index
                record.Ready = false
                record.Prompt.Enabled = false
                move(record, destination, function()
                    if current(player, queue) and table.find(queue.Customers, record) then
                        record.Ready = true
                        record.Prompt.Enabled = record.Ready and record.OrderTaken
                    end
                end)
            else
                record.Prompt.Enabled = record.Ready and record.OrderTaken
            end
        end
    end
end

-- Resolve from the physical customer registry, never names, tags or attributes.
local function hitRecord(player: Player, model: Model): (any, any)
    local queue = queues[key(player)]
    if not queue or not current(player, queue) then
        return nil, nil
    end
    local record = ownedModels[queue.SessionId] and ownedModels[queue.SessionId][model]
    if record and record.Model == model and record.SessionId == queue.SessionId and model:IsDescendantOf(workspace) then
        return record, queue
    end
    return nil, nil
end

local function active(record: any): boolean
    return record.State == "Queued"
        or record.State == "OrderTaken"
        or record.State == "Stealing"
        or record.State == "Escaping"
end

local function bad(record: any): boolean
    return record.Rejectable == true and (record.BadCustomerType == "Thief" or record.BadCustomerType == "Freeloader")
end

-- Queue membership is separate from the lifetime registry. Every logical exit
-- uses this operation; destruction after an earlier release is a no-op.
local function releaseQueue(record: any, queue: any)
    local index = table.find(queue.Customers, record)
    if not index then
        return
    end
    table.remove(queue.Customers, index)
    record.Model:SetAttribute("QueuePosition", nil)
    local owner = deps.TycoonService.GetSessionOwner(queue.SessionId)
    if owner and current(owner, queue) then
        CustomerService.RefreshQueue(owner)
    end
end

local function invalidate(record: any)
    record.RuntimeToken = (record.RuntimeToken or 0) + 1
    record.RecoveryToken += 1
    record.ReturningFromHit = false
    record.Ready = false
    record.TakeOrderPrompt.Enabled = false
    record.Prompt.Enabled = false
    record.Request, record.RequestId = nil, nil
    record.Model:SetAttribute("RequestId", nil)
    activeTypingTasks[record.Text] = nil
    Walk.Cancel(record)
end

local function behaviorContext(record: any, queue: any): any
    local token = record.RuntimeToken
    local context: any = {}
    context.Valid = function(): boolean
        local owner = deps.TycoonService.GetSessionOwner(queue.SessionId)
        return owner ~= nil
            and current(owner, queue)
            and (not bad(record) or record.SpawnOwnerUserId == owner.UserId)
            and record.RuntimeToken == token
            and ownedModels[queue.SessionId] ~= nil
            and ownedModels[queue.SessionId][record.Model] == record
            and record.Model:IsDescendantOf(workspace)
    end
    context.Marker = function(name: string): BasePart?
        local owner = deps.TycoonService.GetSessionOwner(queue.SessionId)
        return if owner and context.Valid() then deps.TycoonService.GetReference(owner, name) else nil
    end
    context.Destroy = function()
        if context.Valid() then
            record.Model:Destroy()
        end
    end
    context.Exit = function()
        if not context.Valid() then
            return
        end
        -- An un-rejected thief remains catchable through the final exit leg.
        if record.State ~= "Escaping" then
            record.State = "Leaving"
        end
        local exit = context.Marker("CustomerExit")
        if not exit then
            context.Destroy()
            return
        end
        task.delay(BadCustomers.ExitTimeout, context.Destroy)
        Walk.Move(record, Placement.AtMarker(exit, record.BottomOffset), function()
            context.Destroy()
        end)
    end
    context.Theft = function()
        if not context.Valid() or record.State ~= "Stealing" or record.TheftAttempted then
            return
        end
        local owner = deps.TycoonService.GetSessionOwner(queue.SessionId)
        local transaction = owner
            and deps.TycoonService.BeginTransaction(owner, deps.TycoonService.GetRequestContext(owner))
        if not transaction then
            return
        end
        -- Reserve the exact removed unit before inventory publishes stash signals.
        record.TheftAttempted = true
        deps.InventoryService.RemoveThiefIngredient(owner, transaction, function(unit)
            record.StolenIngredient = unit
        end)
        deps.TycoonService.EndTransaction(transaction)
        if record.StolenIngredient and context.Valid() and deps.IngredientService then
            pcall(function()
                local visual =
                    deps.IngredientService.CreateVisual(record.StolenIngredient.IngredientId, record.StolenIngredient)
                if visual then
                    record.StolenVisual = Presentation.AttachStolenIngredient(record.Model, visual)
                end
            end)
        end
    end
    return context
end

local function badCue(record: any, cue: string)
    -- Audio availability must never hold queue/economy authority hostage.
    pcall(function()
        AudioService.PlayBadCustomerCue(record.Root, cue)
    end)
end

-- Revealed thieves are explicitly associated with this plot's lifetime registry.
-- Hidden queue occupants never get discovered by the override.
function CustomerService.ResolveRejectTarget(player: Player): Model?
    local queue = queues[key(player)]
    if not queue or not current(player, queue) or deps.TycoonService.GetSessionOwner(queue.SessionId) ~= player then
        return nil
    end
    -- Escaping wins over Stealing; ties use the oldest encounter deterministically.
    local fallback: any = nil
    for _, record in queue.Records do
        local humanoid = record.Model:FindFirstChildOfClass("Humanoid")
        if
            bad(record)
            and record.BadCustomerType == "Thief"
            and (record.State == "Stealing" or record.State == "Escaping")
            and record.SessionId == queue.SessionId
            and record.Model:IsDescendantOf(workspace)
            and record.SpawnOwnerUserId == player.UserId
            and (not humanoid or humanoid.Health > 0)
            and (
                not fallback
                or (record.State == "Escaping" and fallback.State ~= "Escaping")
                or (record.State == fallback.State and record.Sequence < fallback.Sequence)
            )
        then
            fallback = record
        end
    end
    if fallback then
        return fallback.Model
    end
    for _, record in queue.Customers do
        if active(record) and record.SessionId == queue.SessionId and record.Model:IsDescendantOf(workspace) then
            return record.Model
        end
    end
    return nil
end

function CustomerService.DismissCustomer(player: Player, model: Model, _reason: string?, context: any): boolean
    local record, queue = hitRecord(player, model)
    if
        not record
        or not active(record)
        or bad(record)
        or deps.TycoonService.GetSessionOwner(queue.SessionId) ~= player
    then
        return false
    end
    local transaction =
        deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not transaction then
        return false
    end
    record.Bubble.MaxDistance = CUSTOMER_ORDER_MAX_DISTANCE
    record.State = "Dismissed" -- Claim before any Immediate signals/presentation.
    invalidate(record)
    releaseQueue(record, queue)
    record.Model:SetAttribute("OrderRevealed", true)
    record.Model:SetAttribute("Reaction", "Disgust")
    local responses = BadCustomers.DismissalResponses
    typewriterText(record.Text, responses[math.random(1, #responses)], record.Audio.dialogueSound)
    Film.Emit(player, "CustomerReaction", { Customer = model, ReactionId = "Disgust", PlotSessionId = transaction })
    local runtime = behaviorContext(record, queue)
    deps.TycoonService.EndTransaction(transaction)
    if record.Recovering then
        pcall(function()
            deps.RagdollService.SetRagdolled(model, false)
        end)
        record.Recovering = false
    end
    -- Like normal service, hold the reaction briefly while queue authority has
    -- already moved on. Missing exits still clean immediately.
    if runtime.Marker("CustomerExit") then
        task.delay(BadCustomers.DismissalResponseHold, runtime.Exit)
    else
        runtime.Destroy()
    end
    return true
end

-- The ONLY bad-customer rejection entry. Button and valid owner Bat hit share it.
function CustomerService.RejectCustomer(player: Player, model: Model, _reason: string, context: any): boolean
    local record, queue = hitRecord(player, model)
    if
        not record
        or not active(record)
        or not bad(record)
        or deps.TycoonService.GetSessionOwner(queue.SessionId) ~= player
    then
        return false
    end
    local transaction =
        deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not transaction then
        return false
    end
    record.Bubble.MaxDistance = CUSTOMER_ORDER_MAX_DISTANCE
    record.State = "Rejected"
    invalidate(record)
    record.Recovering = true
    releaseQueue(record, queue)
    local stolen = record.StolenIngredient
    -- Rejected is the exclusive claim. Relinquish ownership and remove the inert
    -- carried projection before world publication, audio, ragdoll or impulse.
    record.StolenIngredient = nil
    if record.StolenVisual then
        record.StolenVisual:Destroy()
        record.StolenVisual = nil
    end
    if stolen then
        deps.InventoryService.ReleaseThiefIngredient(stolen, record.Root.CFrame * CFrame.new(0, 2, -4))
    end
    badCue(record, "Reject")
    local runtime = behaviorContext(record, queue)
    deps.TycoonService.EndTransaction(transaction)
    if runtime.Valid() then
        BadBehavior.Reject(record, runtime, deps.RagdollService)
    end
    return true
end

function CustomerService.RejectFront(player: Player, plot: Instance?, context: any): boolean
    local queue = queues[key(player)]
    if not queue or (plot and queue.Plot ~= plot) then
        return false
    end
    local model = CustomerService.ResolveRejectTarget(player)
    if not model then
        return false
    end
    local record = hitRecord(player, model)
    if not record then
        return false
    end
    return if bad(record)
        then CustomerService.RejectCustomer(player, model, "RejectButton", context)
        else CustomerService.DismissCustomer(player, model, "RejectedByOwner", context)
end

local function bindRejectButton(queue: any)
    local assembly = queue.Plot:FindFirstChild("RejectButton")
    local button = assembly and assembly:FindFirstChild("Button")
    local base = assembly and assembly:FindFirstChild("BlackBase")
    local origin = assembly and assembly:FindFirstChild("Attachment")
    if
        not button
        or not button:IsA("BasePart")
        or not base
        or not base:IsA("BasePart")
        or not origin
        or not origin:IsA("Attachment")
    then
        if RunService:IsStudio() then
            warn("[Customer] RejectButton needs sibling Button, BlackBase, Attachment; interaction skipped")
        end
        return
    end
    local oldPrompt = button:FindFirstChild("RejectPrompt")
    if oldPrompt then
        oldPrompt:Destroy()
    end
    queue.RejectCleanup = RejectFloorButton.Bind(button, origin, function()
        return if queues[queue.SessionId] == queue then deps.TycoonService.GetSessionOwner(queue.SessionId) else nil
    end, function(actor)
        return current(actor, queue)
            and WorldUtil.Near(actor, button, 10)
            and CustomerService.ResolveRejectTarget(actor) ~= nil
    end, function(actor)
        if queues[queue.SessionId] ~= queue or deps.TycoonService.GetSessionOwner(queue.SessionId) ~= actor then
            return false
        end
        return CustomerService.RejectFront(actor, queue.Plot, deps.TycoonService.GetRequestContext(actor))
    end)
end

function CustomerService.CanHitCustomer(player: Player, model: Model): boolean
    local record = hitRecord(player, model)
    if record and bad(record) and active(record) and deps.TycoonService.GetSessionOwner(record.SessionId) == player then
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        return record.Root.Parent ~= nil and not record.Root.Anchored and humanoid ~= nil and humanoid.Health > 0
    end
    if
        record
        and (
            record.State == "Rejected"
            or record.State == "Dismissed"
            or record.State == "Leaving"
            or record.State == "Destroyed"
        )
    then
        return false
    end
    if not record or record.Recovering or record.ReturningFromHit or os.clock() < (record.HitImmuneUntil or 0) then
        return false
    end
    local root = model:FindFirstChild("HumanoidRootPart")
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if
        not root
        or not root:IsA("BasePart")
        or root ~= record.Root
        or root.Anchored
        or not humanoid
        or humanoid.Health <= 0
    then
        return false
    end
    local ok, compatible = pcall(function()
        return deps.RagdollService.PrepareCharacter(model)
    end)
    return ok and compatible == true
end

function CustomerService.HitCustomer(
    player: Player,
    model: Model,
    context: { Direction: Vector3, Duration: number }
): boolean
    local candidate = hitRecord(player, model)
    if
        candidate
        and bad(candidate)
        and active(candidate)
        and deps.TycoonService.GetSessionOwner(candidate.SessionId) == player
    then
        return CustomerService.RejectCustomer(player, model, "Bat", nil)
    end
    if not CustomerService.CanHitCustomer(player, model) then
        return false
    end
    local record, queue = hitRecord(player, model)
    local specialInterrupted = bad(record) and (record.State == "Stealing" or record.State == "Escaping")
    if specialInterrupted then
        record.RuntimeToken += 1
    end
    local token = (record.RecoveryToken or 0) + 1
    record.RecoveryToken = token
    record.Recovering = true
    record.Ready = false
    record.TakeOrderPrompt.Enabled = false
    record.Prompt.Enabled = false
    Walk.Cancel(record)
    local function valid(): boolean
        return current(player, queue)
            and record.SessionId == queue.SessionId
            and ownedModels[queue.SessionId] ~= nil
            and ownedModels[queue.SessionId][model] == record
            and record.Model == model
            and model:IsDescendantOf(workspace)
            and record.RecoveryToken == token
    end
    local function resumeDestination()
        if not valid() then
            return
        end
        record.Recovering = false
        if specialInterrupted then
            BadBehavior.Thief(record, behaviorContext(record, queue))
            return
        end
        record.ReturningFromHit = true
        if record.Served then
            record.ResumeExit()
            return
        end
        -- Force a fresh route even if the queue marker has not changed.
        record.TargetMarker = nil
        local owner = deps.TycoonService.GetSessionOwner(queue.SessionId)
        if owner then
            CustomerService.RefreshQueue(owner)
        end
    end
    local ok, enabled = pcall(function()
        return deps.RagdollService.SetRagdolled(model, true)
    end)
    if not ok or enabled ~= true then
        pcall(function()
            deps.RagdollService.SetRagdolled(model, false)
        end)
        resumeDestination()
        return false
    end
    GameplaySfx.Emit("CustomerHurt", record.Root.Position)
    RunService.Heartbeat:Once(function()
        if valid() and record.Recovering then
            pcall(function()
                if deps.RagdollService.IsRagdolled(model) then
                    Knockback.Apply(record.Root, context.Direction)
                end
            end)
        end
    end)
    task.delay(context.Duration, function()
        if not valid() then
            return
        end
        local restored, result = pcall(function()
            return deps.RagdollService.SetRagdolled(model, false)
        end)
        if not restored or result ~= true then
            warn("[Customer] ragdoll recovery failed")
            return
        end
        -- Give native GettingUp a physics step before locomotion takes over.
        RunService.Heartbeat:Once(resumeDestination)
    end)
    return true
end

-- Released/unfulfilled tutorial records get a replacement through this same queue.
local function pendingTutorial(queue: any): (number?, boolean)
    if not queue.TutorialOrders then
        return nil, false
    end
    for index, order in TutorialOrders do
        local record = queue.TutorialOrders[index]
        if record and record.TutorialFulfilled then
            continue
        end
        if not record or not table.find(queue.Customers, record) or not record.Model.Parent then
            return if os.clock() >= queue.StartedAt + order.Arrival then index else nil, true
        end
    end
    return nil, false
end

function CustomerService.ActivateForPlayer(player: Player, tutorial: boolean?): boolean
    local plot = deps.TycoonService.GetPlot(player)
    if not plot then
        CustomerService.DeactivateForPlayer(player)
        return false
    end
    local existing = queues[key(player)]
    if existing and current(player, existing) then
        return true
    end
    CustomerService.DeactivateForPlayer(player)
    local queue: any = { Customers = {}, Records = {}, Plot = plot, Full = false, SessionId = key(player) }
    if tutorial then
        queue.TutorialOrders = {}
        queue.StartedAt = os.clock()
        queue.TutorialInserted = 0
        queue.NextNormalAt = 0
    end
    queues[key(player)] = queue
    bindRejectButton(queue)
    queue.PlotConnection = plot.AncestryChanged:Connect(function()
        if queues[queue.SessionId] == queue and not current(player, queue) then
            CustomerService.CleanupSession(queue.SessionId)
        end
    end)
    player:SetAttribute("CustomerFlowState", "PLOT_ACTIVE")
    diagnostic("flow started owner=" .. player.Name)
    local function tick()
        if queues[queue.SessionId] ~= queue then
            return
        end
        local activeOwner = deps.TycoonService.GetSessionOwner(queue.SessionId)
        if not activeOwner then
            CustomerService.CleanupSession(queue.SessionId)
            return
        end
        player = activeOwner
        if queues[queue.SessionId] ~= queue then
            return
        end
        if not current(player, queue) then
            CustomerService.DeactivateForPlayer(player)
            return
        end
        CustomerService.RefreshQueue(player)
        local full = #queue.Customers >= Economy.MaxCustomersPerPlot
        if full and not queue.Full then
            diagnostic("queue full owner=" .. player.Name)
        end
        queue.Full = full
        local tutorialIndex, tutorialPending = pendingTutorial(queue)
        if queue.TutorialOrders then
            local normalDue = not tutorialPending and os.clock() >= queue.NextNormalAt
            if not full and (tutorialIndex or normalDue) then
                local spawned = CustomerService.SpawnForPlayer(player) ~= nil
                if spawned and not tutorialIndex then
                    queue.NextNormalAt = os.clock()
                        + math.random(Economy.CustomerSpawnMinSeconds, Economy.CustomerSpawnMaxSeconds)
                end
            end
            if current(player, queue) then
                task.delay(0.5, tick)
            end
            return
        end
        local spawned = not full and CustomerService.SpawnForPlayer(player) ~= nil
        if not current(player, queue) then
            return
        end
        task.delay(
            if spawned
                then math.random(Economy.CustomerSpawnMinSeconds, Economy.CustomerSpawnMaxSeconds)
                else math.random(Economy.CustomerFullRetryMinSeconds, Economy.CustomerFullRetryMaxSeconds),
            tick
        )
    end
    if tutorial then
        task.defer(tick) -- claim transaction must release before spawning
    else
        task.delay(math.random(Economy.InitialCustomerDelayMin, Economy.InitialCustomerDelayMax), tick)
    end
    return true
end

local function spawnForPlayer(player: Player, customerId: string?, tutorialIndex: number?): Model?
    if not CustomerService.CanSpawn(player) then
        return nil
    end
    local spawn = deps.TycoonService.GetReference(player, "CustomerSpawn")
    local counter = deps.TycoonService.GetReference(player, "CustomerCounter")
    local exit = deps.TycoonService.GetReference(player, "CustomerExit")
    if not spawn or not counter or not exit then
        return nil
    end
    diagnostic(
        string.format(
            "route owner=%s %s -> %s -> %s",
            player.Name,
            spawn:GetFullName(),
            counter:GetFullName(),
            exit:GetFullName()
        )
    )
    local customModel, candidate = cloneNPC(player, customerId, tutorialIndex ~= nil)
    if customerId and not customModel then
        return nil
    end
    local templateName = if candidate then candidate.Template.Name else nil
    local template = ServerStorage:FindFirstChild("Customer")
    local selectedModel = customModel
    local legacyCandidate = if template and template:IsA("Model") then candidateFor(player, template) else nil
    if
        not selectedModel
        and template
        and template:IsA("Model")
        and template.Archivable
        and legacyCandidate
        and legacyCandidate.CustomerType == "Regular"
    then
        local ok, clone = pcall(function()
            return template:Clone()
        end)
        if ok and clone then
            cleanClone(clone)
            if npcRoot(clone) then
                selectedModel = clone
                templateName = template.Name
            else
                clone:Destroy()
                rejectTemplate(template, "clone has no usable root after cleanup")
            end
        end
    end
    if not selectedModel then
        local generic = Instance.new("Model")
        local torso = Instance.new("Part")
        torso.Name = "Torso"
        torso.Size = Vector3.new(2, 2.5, 1)
        torso.Color = Color3.fromRGB(220, 170, 110)
        torso.Parent = generic
        local head = Instance.new("Part")
        head.Name = "Head"
        head.Size = Vector3.new(2, 1, 1)
        head.Position = Vector3.new(0, 2, 0)
        head.Color = Color3.fromRGB(245, 205, 170)
        head.Parent = generic
        generic.PrimaryPart = torso
        selectedModel = generic
    end
    local model = selectedModel :: Model
    model.Name = "CustomerNPC"
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
        end
    end
    local root = npcRoot(model) :: BasePart
    model.PrimaryPart = root
    -- Normalize the clone upright before measuring; standard rigs face root -Z.
    model:PivotTo(CFrame.new(model:GetPivot().Position))
    local bottomOffset = Placement.BottomOffset(model)
    local spawnAt = Placement.AtMarker(spawn, bottomOffset)
    local counterAt = Placement.AtMarker(counter, bottomOffset)
    local exitAt = Placement.AtMarker(exit, bottomOffset)
    model:PivotTo(Placement.Face(spawnAt.Position, counterAt.Position, spawn.CFrame))
    if model:FindFirstChildOfClass("Humanoid") then
        Walk.PrepareRig(model, root)
    end
    model.Parent = workspace
    Walk.Prepare(model, root)
    local walk = Walk.Create(model, templateName)
    ownedModels[key(player)] = ownedModels[key(player)] or {}
    ownedModels[key(player)][model] = true
    local bubble = Instance.new("BillboardGui")
    bubble.Name = "OrderBubble"
    bubble.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CUSTOMER_ORDER_TEXT_HEIGHT)
    bubble.AlwaysOnTop = true
    bubble.MaxDistance = CUSTOMER_ORDER_MAX_DISTANCE
    -- Fail closed on every client; the owner's controller enables this locally.
    bubble.Enabled = false
    local head = model:FindFirstChild("Head", true)
    bubble.Adornee = Presentation.CreateAnchor(root, if head and head:IsA("BasePart") then head else nil)
    bubble.StudsOffset = Vector3.zero
    bubble.SizeOffset = Vector2.new(0, 0.5) -- Bottom edge stays at the rig anchor.
    bubble.Parent = root
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.BorderSizePixel = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.TextStrokeTransparency = 0.1
    text.TextColor3 = Color3.new(1, 1, 1)
    text.Font = Enum.Font.GothamBold
    text.TextSize = CUSTOMER_ORDER_TEXT_SIZE
    text.TextWrapped = true
    text.LineHeight = 0.95
    text.TextXAlignment = Enum.TextXAlignment.Center
    text.TextYAlignment = Enum.TextYAlignment.Center
    text.Text = ""
    text.Parent = bubble
    local displayName = if candidate then candidate.DisplayName else "CustomerNPC"
    if displayName then
        -- Fixed separate rows keep the smaller name below the floating dialogue.
        bubble.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CUSTOMER_ORDER_TEXT_HEIGHT + CustomerNameHeight)
        text.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CUSTOMER_ORDER_TEXT_HEIGHT)
        text.Position = UDim2.fromOffset(0, 0)
        local nameText = text:Clone()
        nameText.Name = "CustomerName"
        nameText.Size = UDim2.fromOffset(CUSTOMER_ORDER_WIDTH, CustomerNameHeight)
        nameText.Position = UDim2.fromOffset(0, CUSTOMER_ORDER_TEXT_HEIGHT)
        nameText.TextSize = 18
        nameText.Text = displayName
        nameText.Parent = bubble
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- A single name row works even on imported rigs with hidden nameplates.
            humanoid.DisplayName = displayName
            Presentation.HideDefaultDisplay(humanoid)
        end
    end
    Presentation.StyleDialogue(bubble, text, candidate ~= nil and candidate.CustomerType ~= "Regular")
    local audio = AudioService.CreateBlendGroup(root)
    local prompt = WorldUtil.Prompt(root, "ServePrompt", "Serve smoothie")
    prompt.Enabled = false
    prompt:SetAttribute("InteractionOrigin", "ServePromptOrigin")
    prompt:SetAttribute("InteractionActionText", "SERVE")
    prompt.Style = Enum.ProximityPromptStyle.Custom
    local takeOrder = WorldUtil.Prompt(root, "TakeOrderPrompt", "Take Order")
    takeOrder.Enabled = true
    takeOrder.Style = Enum.ProximityPromptStyle.Custom
    takeOrder:SetAttribute("InteractionOrigin", "ServePromptOrigin")
    takeOrder:SetAttribute("InteractionActionText", "TAKE ORDER")
    for _, interaction in { takeOrder, prompt } do
        interaction:SetAttribute("InteractionOwnerUserId", player.UserId)
        interaction:SetAttribute("PlotSessionId", key(player))
        interaction:SetAttribute("InteractionCustomerAction", if interaction == takeOrder then "TakeOrder" else "Serve")
    end
    local record: any = {
        State = "Queued",
        SpawnOwnerUserId = player.UserId,
        RuntimeToken = 0,
        Rejectable = candidate and candidate.Rejectable == true,
        BadCustomerType = if candidate then candidate.BadCustomerType else nil,
        Wildcard = if tutorialIndex or (candidate and candidate.Rejectable) then false else nil,
        OrderTaken = false,
        Recovering = false,
        RecoveryToken = 0,
        ReturningFromHit = false,
        TakeOrderPrompt = takeOrder,
        SessionId = key(player),
        BottomOffset = bottomOffset,
        CustomerType = if candidate then candidate.CustomerType else "Regular",
        FixedRequest = if tutorialIndex
            then tutorialRequests[tutorialIndex]
            else if candidate then candidate.Request else nil,
        TutorialIndex = tutorialIndex,
        DisplayName = displayName,
        CustomerId = CustomerRequests.NormalizeCustomerId(model:GetAttribute("CustomerId")),
        TemplateName = templateName or "<generic>",
        RequestId = nil :: string?,
        Served = false,
        Model = model,
        Walk = walk,
        Root = root,
        Preference = "",
        Request = nil,
        Ready = false,
        Text = text,
        Bubble = bubble,
        Audio = audio,
        Prompt = prompt,
        Exit = exitAt,
        ForcedReaction = nil,
    }
    ownedModels[key(player)][model] = record
    local queue = queues[key(player)]
    if not queue or not current(player, queue) or not assignRequest(player, record) then
        walk.Destroy()
        if ownedModels[key(player)] then
            ownedModels[key(player)][model] = nil
        end
        model:Destroy()
        return nil
    end
    queue.Records[model] = record
    queue.Sequence = (queue.Sequence or 0) + 1
    record.Sequence = queue.Sequence
    table.insert(queue.Customers, record)
    if tutorialIndex then
        queue.TutorialOrders[tutorialIndex] = record
        queue.TutorialInserted = math.max(queue.TutorialInserted, tutorialIndex)
        if queue.TutorialInserted == #TutorialOrders then
            queue.NextNormalAt = os.clock()
                + math.random(Economy.CustomerSpawnMinSeconds, Economy.CustomerSpawnMaxSeconds)
        end
        model:SetAttribute("TutorialOrderIndex", tutorialIndex)
    end
    if record.CustomerType == "Special" then
        lastSpecialSpawn[key(player)] = os.clock()
        if deps.DiscoveryService then
            for _, member in deps.TycoonService.GetMembers(record.SessionId) do
                deps.DiscoveryService.DiscoverSpecialCustomer(member, record.CustomerId)
            end
        end
    end
    model:SetAttribute("CustomerId", record.CustomerId)
    model:SetAttribute("OwnerUserId", player.UserId)
    model:SetAttribute("PlotSessionId", key(player))
    model:SetAttribute("OrderRevealed", false)
    diagnostic(string.format("queued owner=%s position=%d request=%s", player.Name, #queue.Customers, record.RequestId))
    deps.GameplayService.RegisterPlotInteraction(takeOrder, function(actor, context)
        CustomerService.TakeOrder(actor, model, context)
    end)
    deps.GameplayService.RegisterPlotInteraction(prompt, function(actor, context)
        CustomerService.Serve(actor, model, context)
    end)
    model.Destroying:Connect(function()
        record.State = "Destroyed"
        -- Escape, death/reset and generic cleanup consume held loot; only the
        -- successful rejection operation above is allowed to publish a drop.
        record.StolenIngredient = nil
        record.StolenVisual = nil
        record.RuntimeToken += 1
        Walk.Cancel(record)
        if deps.RagdollService then
            pcall(function()
                deps.RagdollService.CleanupCharacter(model)
            end)
        end
        queue.Records[model] = nil
        walk.Destroy()
        activeTypingTasks[text] = nil
        if ownedModels[queue.SessionId] then
            ownedModels[queue.SessionId][model] = nil
        end
        record.RecoveryToken += 1
        record.MoveToken = (record.MoveToken or 0) + 1
        releaseQueue(record, queue)
    end)
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Died:Connect(function()
            model:Destroy()
        end)
    end
    CustomerService.RefreshQueue(player)
    return model
end
-- An explicit ID is a Studio-only injection; normal arrivals still use random selection.
function CustomerService.SpawnForPlayer(player: Player, customerId: string?): Model?
    if customerId and not (RunService:IsStudio() and RunService:IsServer()) then
        return nil
    end
    local queue = queues[key(player)]
    local tutorialIndex: number? = nil
    local tutorialPending = false
    if queue then
        tutorialIndex, tutorialPending = pendingTutorial(queue)
    end
    if tutorialPending and not tutorialIndex then
        return nil
    end
    local token = deps.TycoonService.BeginTransaction(player, deps.TycoonService.GetRequestContext(player))
    if not token then
        return nil
    end
    local model = spawnForPlayer(player, if tutorialIndex then nil else customerId, tutorialIndex)
    deps.TycoonService.EndTransaction(token)
    return model
end
-- Reveal only the assigned request; waiting customers are eligible too.
function CustomerService.TakeOrder(player: Player, model: Model, context: any): boolean
    if not deps.TycoonService.ValidateActor(player, context or deps.TycoonService.GetRequestContext(player)) then
        return false
    end
    local queue = queues[key(player)]
    if not queue or not current(player, queue) then
        return false
    end
    for _, record in queue.Customers do
        if record.Model == model then
            if
                record.OrderTaken
                or (bad(record) and record.BadCustomerType == "Thief" and deps.TycoonService.GetSessionOwner(
                    queue.SessionId
                ) ~= player)
                or not active(record)
                or record.Recovering
                or record.ReturningFromHit
                or record.Served
                or not record.Request
                or not model.Parent
                or not WorldUtil.Near(player, record.Root, Economy.InteractionDistance)
            then
                return false
            end
            local token =
                deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
            if not token then
                return false
            end
            record.Bubble.MaxDistance = if bad(record)
                then CUSTOMER_ORDER_MAX_DISTANCE
                else CUSTOMER_ORDER_MAX_DISTANCE * 1.25
            record.OrderTaken = true
            record.State = "OrderTaken"
            record.TakeOrderPrompt.Enabled = false
            record.Prompt.Enabled = record.Ready
            model:SetAttribute("OrderRevealed", true)
            typewriterText(
                record.Text,
                record.RequestText,
                record.Audio.dialogueSound,
                CustomerService.FormatRequestText(record.Request, record.RequestText)
            )
            if bad(record) and record.BadCustomerType == "Thief" then
                record.State = "Stealing"
                local suspiciousText = record.RequestText
                invalidate(record)
                releaseQueue(record, queue)
                typewriterText(record.Text, suspiciousText, record.Audio.dialogueSound)
                badCue(record, "Thief")
                local runtime = behaviorContext(record, queue)
                deps.TycoonService.EndTransaction(token)
                BadBehavior.Thief(record, runtime)
                return true
            end
            deps.TycoonService.EndTransaction(token)
            return true
        end
    end
    return false
end
function CustomerService.GetSnapshot(player: Player): {
    Preference: string,
    CustomerId: string?,
    RequestId: string?,
    Ready: boolean,
    Model: Model,
}?
    local record = front(player)
    if not record then
        return nil
    end
    return {
        Preference = record.Preference,
        CustomerId = record.CustomerId,
        RequestId = if record.Request then record.Request.Id else nil,
        Ready = record.Ready,
        Model = record.Model,
    }
end
function CustomerService.Serve(player: Player, expectedModel: Model?, context: any): (boolean, string?)
    context = context or deps.TycoonService.GetRequestContext(player)
    if not deps.TycoonService.ValidateActor(player, context) then
        return false, "StaleSession"
    end
    local queue = queues[key(player)]
    local record = if expectedModel then hitRecord(player, expectedModel) else front(player)
    local index = if queue and record then table.find(queue.Customers, record) else nil
    if
        not record
        or not index
        or not record.Ready
        or record.Recovering
        or record.ReturningFromHit
        or not record.Request
        or record.Served
        or (bad(record) and record.BadCustomerType == "Thief")
        or not active(record)
        or record.State == "Stealing"
        or record.State == "Escaping"
        or not queue
        or not current(player, queue)
        or not WorldUtil.Near(player, record.Root, Economy.InteractionDistance)
    then
        diagnostic("serve rejected owner=" .. player.Name .. " reason=No customer ready nearby")
        return false, "No customer ready nearby"
    end
    -- Lock this customer before consuming the selected reservation: destroying
    -- its visual can synchronously emit signals under Immediate signal behavior.
    local transaction = deps.TycoonService.BeginTransaction(player, context)
    if not transaction then
        return false, "StaleSession"
    end
    local freeloader = bad(record) and record.BadCustomerType == "Freeloader"
    if freeloader then
        local selected = deps.BlendService.GetCup(player)
        if not selected or not OrderEvaluation.Evaluate(selected, record.Request).IsValid then
            deps.TycoonService.EndTransaction(transaction)
            return false, "No valid cup"
        end
    end
    local previousState = record.State
    record.State = "Serving" -- Exclusive claim before cup destruction can emit signals.
    record.Ready = false
    local result = deps.BlendService.ConsumeCup(player)
    if not result then
        record.State = previousState
        record.Ready = true
        deps.TycoonService.EndTransaction(transaction)
        diagnostic("serve rejected owner=" .. player.Name .. " reason=No valid cup")
        record.Audio.notReadySound:Play()
        return false, "No valid cup"
    end
    -- No yield between consumption, payout, and removal from active state.
    record.Served = true
    record.Bubble.MaxDistance = CUSTOMER_ORDER_MAX_DISTANCE
    record.State = "Served"
    record.TakeOrderPrompt.Enabled = false
    record.Model:SetAttribute("OrderRevealed", true)
    record.Prompt.Enabled = false
    releaseQueue(record, queue)
    local evaluation = OrderEvaluation.Evaluate(result, record.Request)
    local grade = evaluation.Grade
    local success = evaluation.IsFulfilled
    if record.TutorialIndex then
        record.TutorialFulfilled = success and evaluation.IsValid
    end
    local response = Presentation.Response(record.Request, if evaluation.IsWildcard then "A" else grade :: Types.Grade)
    local reaction = record.ForcedReaction
        or (
            if evaluation.IsWildcard
                    or grade == "A"
                    or grade == "B"
                then "Smile"
                elseif grade == "C" then "Shudder"
                else "Disgust"
        )
    local payout, ingredientValue = BadCustomers.FreeloaderPayout, 0
    if freeloader then
        deps.TycoonService.DebitTransaction(transaction, -payout)
    else
        payout, ingredientValue = CustomerService.CalculateOrderPayout(player, result, record.Request, evaluation)
        deps.TycoonService.CreditTransaction(transaction, payout)
    end
    if deps.AnnouncementService then
        deps.AnnouncementService.Served(player, result.Ingredients, payout)
    end
    diagnostic(
        string.format(
            "served owner=%s request=%s blend=%s ingredients=[%s] success=%s reason=%s payout=%d cash=%d",
            player.Name,
            record.Request.Id,
            tostring(result.BlendId),
            table.concat(result.Ingredients, ", "),
            tostring(success),
            evaluation.Reason,
            payout,
            deps.TycoonService.GetCash(player)
        )
    )
    deps.PlayerDataService.IncrementStat(player, "CustomersServed")
    if deps.TutorialService then
        deps.TutorialService.Mark(player, "ServedCustomer")
    end
    for _, member in deps.TycoonService.GetMembers(transaction) do
        member:SetAttribute("CustomerSatisfaction", grade)
        member:SetAttribute("CustomerReaction", reaction)
    end
    record.Model:SetAttribute("Reaction", reaction)
    record.Model:SetAttribute("Grade", grade)
    record.Model:SetAttribute("IsWildcard", evaluation.IsWildcard)
    record.Model:SetAttribute("OrderSucceeded", success)
    local resultGui = Presentation.ShowResult(record.Bubble, grade, payout, if freeloader then nil else ingredientValue)
    record.Model:SetAttribute("RequestId", nil)
    record.Request = nil
    record.RequestId = nil
    -- FilmingUtil broadcasts once to all clients; both members also receive attributes above.
    Film.Emit(player, "CustomerReaction", {
        BlendId = result.BlendId,
        Customer = record.Model,
        ReactionId = reaction,
        Grade = grade,
        IsWildcard = evaluation.IsWildcard,
        Payout = payout,
        IngredientValue = ingredientValue,
        PlotSessionId = transaction,
    })
    Film.Log(
        "Customer",
        string.format(
            "served blend=%s grade=%s reaction=%s payout=%d",
            tostring(result.BlendId),
            tostring(grade),
            reaction,
            payout
        )
    )
    -- Feedback uses the assigned order; reaction audio/VFX/attributes stay independent.
    activeTypingTasks[record.Text] = nil
    if response then
        typewriterText(record.Text, response, record.Audio.dialogueSound)
    else
        record.Bubble:Destroy()
    end
    local glow = ensureCustomerCounterGlow(record.Model)
    if glow and success then
        glow:Emit(20)
    end
    if success then
        record.Audio.customerServeSound:Play()
    else
        record.Audio.notReadySound:Play()
    end
    Debris:AddItem(record.Model, 15)
    record.ResumeExit = function()
        if
            current(player, queue)
            and ownedModels[queue.SessionId] ~= nil
            and ownedModels[queue.SessionId][record.Model] == record
            and record.Model:IsDescendantOf(workspace)
            and not record.Recovering
        then
            move(record, record.Exit, function()
                Presentation.PreserveResult(resultGui)
                record.Model:Destroy()
            end)
        end
    end
    task.delay(2, function()
        if not record.ReturningFromHit then
            record.ResumeExit()
        end
    end)
    CustomerService.RefreshQueue(player)
    diagnostic(string.format("advanced owner=%s count=%d", player.Name, #queue.Customers))
    onServed(player, grade)
    deps.TycoonService.EndTransaction(transaction)
    return true
end
-- Only DevContentService exposes this through its Studio gate; no remote.
function CustomerService.SetForcedReaction(player: Player, reaction: string?): boolean
    if not front(player) then
        return false
    end
    if reaction then
        local valid = false
        for _, definition in Customers.Reactions do
            if definition.Id == reaction then
                valid = true
            end
        end
        if not valid then
            return false
        end
    end
    front(player).ForcedReaction = reaction
    return true
end
-- Legacy colon-call compatibility. Unowned auto-spawns and attribute-based cup checks were removed.
function CustomerService:CreateCustomer(_spawnTarget: any, plotOwner: Player?): Model?
    if not plotOwner then
        warn("[CustomerService] CreateCustomer now requires a plot owner")
        return nil
    end
    return CustomerService.SpawnForPlayer(plotOwner)
end
function CustomerService:ServeCheck(player: Player, item: Instance?): boolean
    return deps.BlendService.GetCup(player, item) ~= nil
end
function CustomerService:GetSatisfaction(player: Player, item: Instance?, preference: string?): Types.Grade?
    local result = deps.BlendService.GetCup(player, item)
    if not result then
        return "D"
    end
    return CustomerService.CalculateGrade(
        result,
        preference or (front(player) and front(player).Preference) or "Surprise Me"
    )
end
function CustomerService:RefreshOrder(model: Model)
    for sessionId, queue in queues do
        local player = deps.TycoonService.GetSessionOwner(sessionId)
        if not player then
            continue
        end
        for _, record in queue.Customers do
            if record.Model == model then
                if assignRequest(player, record) and record.OrderTaken then
                    typewriterText(
                        record.Text,
                        record.RequestText,
                        record.Audio.dialogueSound,
                        CustomerService.FormatRequestText(record.Request, record.RequestText)
                    )
                end
                return
            end
        end
    end
end
-- Snapshots expose presentation state, never mutable authoritative records.
function CustomerService.GetTutorialSnapshot(player: Player): { any }?
    local queue = queues[key(player)]
    if not queue or not queue.TutorialOrders then
        return nil
    end
    local snapshot = {}
    for index, order in TutorialOrders do
        local record = queue.TutorialOrders[index]
        local present = record and table.find(queue.Customers, record) ~= nil and record.Model.Parent ~= nil
        snapshot[index] = {
            RequestId = order.RequestId,
            Served = record ~= nil and record.TutorialFulfilled == true,
            OrderTaken = present and record.OrderTaken == true,
            Model = if present then record.Model else nil,
        }
    end
    return snapshot
end
function CustomerService.GetQueueSnapshot(player: Player): { any }
    local result = {}
    local queue = queues[key(player)]
    if queue then
        for index, record in queue.Customers do
            table.insert(
                result,
                { Model = record.Model, RequestId = record.RequestId, Ready = record.Ready, Position = index }
            )
        end
    end
    return result
end
local function cleanupFlow(sessionId: string)
    local queue = queues[sessionId]
    queues[sessionId] = nil -- Invalidate scheduler/movement before destroying models.
    if queue and queue.PlotConnection then
        queue.PlotConnection:Disconnect()
    end
    if queue and queue.RejectCleanup then
        queue.RejectCleanup()
    end
    local models = ownedModels[sessionId]
    ownedModels[sessionId] = nil
    if models then
        for model in models do
            model:Destroy()
        end
    end
end
function CustomerService.CleanupSession(sessionId: string)
    cleanupFlow(sessionId)
    lastSpecialSpawn[sessionId], lastTemplates[sessionId] = nil, nil
    recentTemplates[sessionId], recentRequests[sessionId] = nil, nil
    recentRequestGroups[sessionId], recentRequestSimilarity[sessionId] = nil, nil
end
-- Explicit server flow reset, not a departing-player cleanup path.
function CustomerService.DeactivateForPlayer(player: Player)
    cleanupFlow(key(player))
    player:SetAttribute("CustomerFlowState", "PLOT_INACTIVE")
end
function CustomerService.BindPlayer(player: Player)
    local queue = queues[key(player)]
    player:SetAttribute("CustomerFlowState", if queue then "PLOT_ACTIVE" else "PLOT_INACTIVE")
    if queue then
        local owner = deps.TycoonService.GetSessionOwner(queue.SessionId)
        if owner then
            for model, record in table.clone((ownedModels[queue.SessionId] or {}) :: { [Model]: any }) do
                if bad(record) and record.SpawnOwnerUserId ~= owner.UserId then
                    model:Destroy()
                else
                    model:SetAttribute("OwnerUserId", owner.UserId)
                end
            end
        end
    end
end
function CustomerService.RemovePlayer(player: Player)
    player:SetAttribute("CustomerFlowState", "PLOT_INACTIVE")
end
return require(script.Parent.StudioServices).Wrap("CustomerService", CustomerService)
]]></string>
