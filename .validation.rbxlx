          <Item class="ModuleScript" referent="604">
            <Properties>
              <string name="Name">BatController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Constants.BatConfig)
local Controller = {}
local teardown: (() -> ())? = nil

-- Temporary boundary trace: independent of attribute replication so a missing
-- server request can still be diagnosed. Remove after the Studio repro is resolved.
local function trace(message: string)
    if RunService:IsStudio() then
        print("[BatInput] " .. message)
    end
end

type Playback = {
    Tool: Tool,
    Character: Model,
    Humanoid: Humanoid?,
    Tracks: { [string]: AnimationTrack },
    Connections: { RBXScriptConnection },
    Phase: string,
}
local function disconnect(connections: { RBXScriptConnection })
    for _, connection in connections do
        connection:Disconnect()
    end
    table.clear(connections)
end

function Controller.Destroy()
    if teardown then
        teardown()
        teardown = nil
    end
end

function Controller.Init()
    if teardown then
        return
    end
    local player = Players.LocalPlayer
    trace("BatController initialized trace=input-v1 player=" .. player.Name)
    local characterConnections: { RBXScriptConnection } = {}
    local playerConnections: { RBXScriptConnection } = {}
    local current: Playback? = nil
    local nextSwingAt = 0

    local function clearTool()
        local state = current
        current = nil -- Invalidate completion callbacks before stopping any track.
        if state then
            disconnect(state.Connections)
            for _, track in state.Tracks do
                track:Stop(0)
                track:Destroy()
            end
        end
    end
    local function clearCharacter()
        clearTool()
        disconnect(characterConnections)
    end
    local function stillEquipped(state: Playback): boolean
        local humanoid = state.Humanoid
        return current == state
            and state.Tool.Parent == state.Character
            and player.Character == state.Character
            and humanoid ~= nil
            and humanoid.Health > 0
    end
    local function play(state: Playback, name: string): boolean
        -- Stop callbacks from the interrupted phase cannot resume idle over the next phase.
        state.Phase = "Transition"
        for _, track in state.Tracks do
            track:Stop(0)
        end
        state.Phase = name
        local track = state.Tracks[name]
        if not track then
            return false
        end
        local ok, problem = pcall(function(): string?
            track:Play(0.05, 1, 1)
            return nil
        end)
        if not ok then
            warn("[Bat] Could not play " .. name .. "Animation: " .. tostring(problem))
        end
        return ok
    end
    local function idle(state: Playback)
        if stillEquipped(state) then
            play(state, "Idle")
        end
    end
    local function prepare(state: Playback, humanoid: Humanoid)
        if state.Humanoid ~= humanoid then
            state.Humanoid = humanoid
            table.insert(
                state.Connections,
                humanoid.Died:Connect(function()
                    if current == state then
                        clearTool()
                    end
                end)
            )
        end
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            return
        end
        for _, name in { "Idle", "Equip", "Swing", "Unequip" } do
            if state.Tracks[name] then
                continue
            end
            local animation = state.Tool:FindFirstChild(name .. "Animation")
            if not animation or not animation:IsA("Animation") or animation.AnimationId == "" then
                continue
            end
            -- Reuse the Humanoid's replicated Animator; never create a client-only Animator.
            local ok, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)
            if not ok then
                warn("[Bat] Could not load " .. name .. "Animation: " .. tostring(track))
                continue
            end
            track.Priority = if name == "Idle" then Enum.AnimationPriority.Idle else Enum.AnimationPriority.Action
            track.Looped = name == "Idle"
            state.Tracks[name] = track
            if name ~= "Idle" then
                table.insert(
                    state.Connections,
                    track.Ended:Connect(function()
                        -- Ended can arrive after a stop/replay of this same track.
                        if current ~= state or state.Phase ~= name or track.IsPlaying then
                            return
                        end
                        if name == "Unequip" then
                            clearTool()
                        else
                            idle(state)
                        end
                    end)
                )
            end
        end
    end
    local function unequip(state: Playback)
        if current ~= state or state.Phase == "Unequip" then
            return
        end
        local humanoid = state.Humanoid
        if player.Character ~= state.Character or not humanoid or humanoid.Health <= 0 then
            clearTool()
            return
        end
        -- Retain the death/destruction listeners until this optional outro finishes.
        if not play(state, "Unequip") then
            clearTool()
        end
    end
    local function bind(character: Model)
        clearCharacter()
        nextSwingAt = 0
        local function equipped(child: Instance)
            if not child:IsA("Tool") then
                return
            end
            if child.Name ~= "Bat" then
                if current and current.Phase == "Unequip" then
                    clearTool()
                end
                return
            end
            if current and current.Tool == child and current.Phase ~= "Unequip" then
                return
            end
            clearTool()
            local state: Playback = {
                Tool = child,
                Character = character,
                Humanoid = nil,
                Tracks = {},
                Connections = {},
                Phase = "Equip",
            }
            current = state
            trace("bound Tool.Activated tool=" .. child:GetFullName())
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                prepare(state, humanoid)
            end
            table.insert(
                state.Connections,
                child.Unequipped:Connect(function()
                    unequip(state)
                end)
            )
            table.insert(
                state.Connections,
                child.Destroying:Connect(function()
                    if current == state then
                        clearTool()
                    end
                end)
            )
            table.insert(
                state.Connections,
                child.AncestryChanged:Connect(function()
                    if child.Parent ~= character then
                        unequip(state)
                    end
                end)
            )
            table.insert(
                state.Connections,
                child.Activated:Connect(function()
                    trace("Tool.Activated player=" .. player.Name .. " tool=" .. child:GetFullName())
                    local living = character:FindFirstChildOfClass("Humanoid")
                    local level = child:GetAttribute("BatLevel")
                    if
                        current ~= state
                        or state.Phase == "Unequip"
                        or child.Parent ~= character
                        or player.Character ~= character
                        or not living
                        or living.Health <= 0
                        or player:GetAttribute("Stunned") == true
                        or player:GetAttribute("PlotSessionId") == nil
                        or type(level) ~= "number"
                        or level < 1
                        or os.clock() < nextSwingAt
                    then
                        local reason = if current ~= state
                            then "stale Tool binding"
                            elseif state.Phase == "Unequip" then "unequipping"
                            elseif child.Parent ~= character then "Tool not equipped"
                            elseif player.Character ~= character then "stale character"
                            elseif not living then "missing Humanoid"
                            elseif living.Health <= 0 then "dead Humanoid"
                            elseif player:GetAttribute("Stunned") == true then "attacker Stunned attribute"
                            elseif player:GetAttribute("PlotSessionId") == nil then "missing PlotSessionId attribute"
                            elseif type(level) ~= "number" then "missing/non-numeric Tool BatLevel"
                            elseif level < 1 then "Tool BatLevel locked"
                            else "local swing cooldown"
                        trace("activation rejected: " .. reason)
                        return
                    end
                    local remote = ReplicatedStorage.Shared.Events:FindFirstChild("GameplayRequest")
                    if not remote or not remote:IsA("RemoteEvent") then
                        trace(
                            "activation rejected: GameplayRequest "
                                .. (if remote then "is not a RemoteEvent" else "missing")
                        )
                        return
                    end
                    nextSwingAt = os.clock() + Config.SwingCooldown
                    prepare(state, living)
                    if not play(state, "Swing") then
                        idle(state)
                    end
                    -- Local prediction only. No pose, animation event or timing authorizes a hit.
                    if RunService:IsStudio() then
                        local named = 0
                        for _, event in ReplicatedStorage.Shared.Events:GetChildren() do
                            if event.Name == "GameplayRequest" then
                                named += 1
                            end
                        end
                        trace(
                            "sending SwingBat remote="
                                .. remote:GetFullName()
                                .. " adapter="
                                .. tostring(remote:GetAttribute("BatRequestTraceVersion"))
                                .. " namedRemotes="
                                .. tostring(named)
                                .. " debugArmed="
                                .. tostring(player:GetAttribute("BatDebugNextSwing"))
                        )
                    end
                    remote:FireServer("SwingBat")
                    trace("FireServer returned: SwingBat")
                end)
            )
            if stillEquipped(state) and not play(state, "Equip") then
                idle(state)
            end
        end
        table.insert(characterConnections, character.ChildAdded:Connect(equipped))
        for _, child in character:GetChildren() do
            equipped(child)
        end
    end
    teardown = function()
        clearCharacter()
        disconnect(playerConnections)
    end
    table.insert(playerConnections, player.CharacterAdded:Connect(bind))
    table.insert(playerConnections, player.CharacterRemoving:Connect(clearCharacter))
    if player.Character then
        bind(player.Character)
    end
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="605">
            <Properties>
              <string name="Name">BlenderStatusDistanceController</string>
              <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Controller = {}
local started = false

-- Scoped visibility ranges; Roblox performs camera-distance culling.
local MAX_DISTANCES: { [string]: number } = {
    IngredientCountDisplay = 60,
    TurbineStatusDisplay = 28,
}

function Controller.Init()
    if started then
        return
    end
    started = true
    local cleanups: { [Instance]: () -> () } = {}
    local function register(object: Instance)
        if not object:IsA("TextLabel") or object.Name ~= "Status" then
            return
        end
        local gui = object.Parent
        if not gui or not gui:IsA("BillboardGui") then
            return
        end
        local maxDistance = MAX_DISTANCES[gui.Name]
        if not maxDistance then
            return
        end
        if gui.Name == "TurbineStatusDisplay" then
            local function guidanceRange()
                gui.MaxDistance = if object.Text == "LOAD INGREDIENTS TO BLEND!" then maxDistance else 40
            end
            guidanceRange()
            if not cleanups[object] then
                local changed = object:GetPropertyChangedSignal("Text"):Connect(guidanceRange)
                cleanups[object] = function()
                    changed:Disconnect()
                end
            end
        else
            gui.MaxDistance = maxDistance
        end
        if gui.Name == "IngredientCountDisplay" then
            -- Retain the label's existing centered layout inside the pixel canvas.
            object.AnchorPoint = Vector2.new(0.5, 0.5)
            object.Position = UDim2.fromScale(0.5, 0.5)
            object.TextScaled = false
            if not cleanups[object] then
                local scale = Instance.new("UIScale")
                scale.Scale = 1
                scale.Parent = object
                local tween: Tween? = nil
                local function complete(): boolean
                    local loaded, required = string.match(object.Text, "^(%d+)%s*/%s*(%d+)")
                    return loaded ~= nil and required ~= nil and tonumber(loaded) >= tonumber(required)
                end
                local wasComplete = complete()
                local changed = object:GetPropertyChangedSignal("Text"):Connect(function()
                    local full = complete()
                    if full ~= wasComplete then
                        if tween then
                            tween:Cancel()
                        end
                        scale.Scale = 1
                        if full then
                            local pop = TweenService:Create(
                                scale,
                                TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
                                { Scale = 1.1 }
                            )
                            tween = pop
                            pop:Play()
                        end
                    end
                    wasComplete = full
                end)
                cleanups[object] = function()
                    changed:Disconnect()
                    if tween then
                        tween:Cancel()
                    end
                    scale:Destroy()
                end
            end
        end
        -- Canvas size, font, opacity, world origin and state text stay authored.
    end
    -- Late replication and streaming use the same idempotent configuration.
    workspace.DescendantAdded:Connect(register)
    workspace.DescendantRemoving:Connect(function(object)
        local cleanup = cleanups[object]
        if cleanup then
            cleanups[object] = nil
            cleanup()
        end
    end)
    for _, object in workspace:GetDescendants() do
        register(object)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="606">
            <Properties>
              <string name="Name">CarryInputController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local MobileControlLayout = require(script.Parent.Parent.UI.MobileControlLayout)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local remote = ReplicatedStorage.Shared.Events:WaitForChild("GameplayRequest") :: RemoteEvent
    local function throw(_action: string, state: Enum.UserInputState): Enum.ContextActionResult
        local character = player.Character
        if character then
            for _, child in character:GetChildren() do
                if child:IsA("Tool") and typeof(child:GetAttribute("BatLevel")) == "number" then
                    -- Leave primary input available to Tool.Activated, including on touch.
                    return Enum.ContextActionResult.Pass
                end
            end
        end
        if player:GetAttribute("Stunned") == true then
            return Enum.ContextActionResult.Sink
        end
        if (player:GetAttribute("CarryCount") or 0) <= 0 or UserInputService:GetFocusedTextBox() then
            return Enum.ContextActionResult.Pass
        end
        if state == Enum.UserInputState.Begin then
            local tool = character and character:FindFirstChildOfClass("Tool")
            local selectedCarryItemId = nil
            if tool and tool:GetAttribute("IngredientId") ~= nil then
                local id = tool:GetAttribute("CarryItemId")
                if typeof(id) == "number" then
                    selectedCarryItemId = id
                end
            end
            -- The server validates this preference against its own held records.
            remote:FireServer("ThrowHeld", selectedCarryItemId)
        end
        return Enum.ContextActionResult.Sink
    end
    -- The existing CAS Throw button and console trigger share this intentional path.
    -- Do not bind touch-world/primary mouse input to the mobile button's action.
    ContextActionService:BindAction("ThrowHeld", throw, true, Enum.KeyCode.ButtonR2)
    ContextActionService:BindAction("ThrowHeldMouse", function(action, state)
        if UserInputService.TouchEnabled then
            -- Touch may also generate primary mouse input. UI, joystick and camera
            -- gestures must never turn that synthesized input into a throw.
            return Enum.ContextActionResult.Pass
        end
        return throw(action, state)
    end, false, Enum.UserInputType.MouseButton1)
    ContextActionService:SetTitle("ThrowHeld", "Throw")
    MobileControlLayout.Register("ThrowHeld")
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="607">
            <Properties>
              <string name="Name">CustomerOrderController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    local tracked: { [BillboardGui]: () -> () } = {}
    local function attach(object: Instance)
        if
            not object:IsA("BillboardGui")
            or (object.Name ~= "OrderBubble" and object.Name ~= "CustomerResult")
            or tracked[object]
        then
            return
        end
        object.Enabled = false
        local customer = object.Parent
        while customer and not customer:IsA("Model") do
            customer = customer.Parent
        end
        if not customer then
            return
        end
        local function refresh()
            object.Enabled = customer:GetAttribute("PlotSessionId") ~= nil
                and customer:GetAttribute("PlotSessionId") == Players.LocalPlayer:GetAttribute("PlotSessionId")
                and (object.Name ~= "OrderBubble" or customer:GetAttribute("OrderRevealed") == true)
        end
        local ownership = customer:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh)
        local membership = Players.LocalPlayer:GetAttributeChangedSignal("PlotSessionId"):Connect(refresh)
        local sessionChanged = customer:GetAttributeChangedSignal("PlotSessionId"):Connect(refresh)
        local reveal = customer:GetAttributeChangedSignal("OrderRevealed"):Connect(refresh)
        tracked[object] = function()
            ownership:Disconnect()
            sessionChanged:Disconnect()
            membership:Disconnect()
            reveal:Disconnect()
            object.Enabled = false
        end
        refresh()
    end
    workspace.DescendantAdded:Connect(attach)
    workspace.DescendantRemoving:Connect(function(object)
        if object:IsA("BillboardGui") then
            local cleanup = tracked[object]
            if cleanup then
                tracked[object] = nil
                cleanup()
            end
        end
    end)
    for _, object in workspace:GetDescendants() do
        attach(object)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="608">
            <Properties>
              <string name="Name">FarmPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Prompts = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Constants = game:GetService("ReplicatedStorage").Shared.Constants
local Config = require(Constants.FarmConfig)
local Definitions = require(Constants.Ingredients)
local TextStyle = require(Constants.DialogueTextStyle)
local Style = require(script.Parent.Parent.UI.WorldBillboardStyle)
local Input = require(script.Parent.Parent.UI.InteractionPromptPresentation)
local Controller = {}
local started = false

local function label(gui: BillboardGui, y: number, text: string): TextLabel
    local result = Instance.new("TextLabel")
    result.Name = if y == 0 then "Title" else "Detail"
    Style.ApplyText(result, {})
    TextStyle.Apply(result, 24)
    result.Size = UDim2.new(1, 0, 0, 32)
    result.Position = UDim2.fromOffset(0, y)
    result.Text = text
    result.Parent = gui
    return result
end

local function billboard(origin: Instance, parent: Instance, height: number): BillboardGui
    local gui = Instance.new("BillboardGui")
    gui.Name = "FarmDisplay"
    gui.Adornee = origin
    Style.ApplyBillboard(gui, { Width = 340, Height = height, MaxDistance = 40 })
    gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
    gui.Parent = parent
    return gui
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    type Row = {
        Object: Instance,
        Origin: Attachment,
        Gui: BillboardGui,
        Title: TextLabel,
        Detail: TextLabel,
        PadGui: BillboardGui?,
        Pad: BasePart?,
        InputGui: BillboardGui?,
        InputTitle: TextLabel?,
        InputName: TextLabel?,
        Cleanup: (() -> ())?,
    }
    local rows: { [ProximityPrompt]: Row } = {}
    local function hide(prompt: ProximityPrompt)
        local row = rows[prompt]
        if row and row.Cleanup then
            row.Cleanup()
            row.Cleanup, row.InputGui, row.InputTitle, row.InputName = nil, nil, nil, nil
        end
    end
    local function bind(object: Instance)
        if not object:IsA("ProximityPrompt") or object.Name ~= "FarmPlantPrompt" or rows[object] then
            return
        end
        local origin = object.Parent
        local row = origin and origin.Parent and origin.Parent.Parent
        if not origin or not origin:IsA("Attachment") or not row then
            return
        end
        local gui = billboard(origin, playerGui, 64)
        gui.Enabled = false
        rows[object] = {
            Object = row,
            Origin = origin,
            Gui = gui,
            Title = label(gui, 0, ""),
            Detail = label(gui, 32, ""),
        }
    end
    local function refresh(prompt: ProximityPrompt, row: Row, now: number)
        local state = row.Object:GetAttribute("FarmState")
        row.Gui.Enabled = state == "GROWING" or state == "READY"
        row.Title.TextColor3 = if state == "READY" then TextStyle.Green else TextStyle.White
        row.Title.Text = if state == "READY"
            then "READY!"
            else "GROWING" .. string.rep(".", math.floor(now / 0.4) % 3 + 1)
        local deadline = row.Object:GetAttribute("FarmGrowEnd")
        local remaining = if typeof(deadline) == "number" then math.max(0, math.ceil(deadline - now)) else 0
        row.Detail.Text = if state == "GROWING"
            then string.format("%d:%02d", math.floor(remaining / 60), remaining % 60)
            else ""
        if state ~= "EMPTY" or not prompt.Enabled or not Prompts.Enabled then
            hide(prompt)
        end
        if row.InputTitle and row.InputName then
            -- InventoryService publishes its selected/fallback action target, including
            -- equipped smoothies. This is display metadata, never an activation payload.
            local id = player:GetAttribute("HeldIngredientId")
            local definition = if typeof(id) == "string" then Definitions[id] else nil
            local valid = definition ~= nil and definition.Farmable ~= false
            row.InputTitle.Text = if valid then "PLANT" else "HOLD AN INGREDIENT"
            row.InputTitle.TextTransparency = if valid then 0 else 0.35
            row.InputName.Text = if valid and definition then definition.DisplayName or definition.Id else ""
            row.InputName.TextColor3 = if definition then definition.BlendColor else TextStyle.White
            local action = row.InputGui and row.InputGui:FindFirstChild("Action")
            if action and action:IsA("TextButton") then
                action.TextTransparency = if valid then 0 else 1
                local outline = action:FindFirstChild("DialogueOutline")
                if outline and outline:IsA("UIStroke") then
                    outline.Transparency = if valid then 0 else 1
                end
            end
        end
        if row.PadGui and row.Pad and not row.Pad:IsDescendantOf(workspace) then
            row.PadGui:Destroy()
            row.PadGui, row.Pad = nil, nil
        end
        if not row.PadGui then
            local index = tonumber(string.match(row.Object.Name, "^Row(%d+)$"))
            local pad = index and row.Object:FindFirstChild("PurchasePoint" .. index)
            local price = index and Config.RowPrices[index]
            if pad and pad:IsA("BasePart") and price then
                row.Pad = pad
                local padGui = billboard(pad, playerGui, 64)
                padGui.MaxDistance = 28 -- Purchase signage only; growing/ready displays retain 40.
                row.PadGui = padGui
                label(padGui, 0, "FARM ROW")
                local amount = tostring(price):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
                label(padGui, 32, "$" .. amount).TextColor3 = TextStyle.Gold
            end
        end
        if row.PadGui and row.Pad then
            row.PadGui.Enabled = row.Pad:IsDescendantOf(workspace) and row.Pad.CanTouch and row.Pad.Transparency < 1
        end
    end
    workspace.DescendantAdded:Connect(bind)
    for _, object in workspace:GetDescendants() do
        bind(object)
    end
    Prompts.PromptShown:Connect(function(object, inputType)
        if not object:IsA("ProximityPrompt") then
            return
        end
        bind(object)
        local prompt = object :: ProximityPrompt
        local row = rows[prompt]
        if not row or row.Object:GetAttribute("FarmState") ~= "EMPTY" then
            return
        end
        hide(prompt)
        local cleanup, gui = Input.Create(prompt, row.Origin, playerGui, inputType, {
            InputOnly = true,
            Width = 340,
            Height = 100,
            TextSize = 24,
        })
        gui.Name = "FarmPlantDisplay"
        gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
        local action = gui:FindFirstChild("Action") :: TextButton
        TextStyle.Apply(action, 24)
        -- Full-canvas hit target; fixed padding places its key below the two labels.
        local padding = Instance.new("UIPadding")
        padding.PaddingTop = UDim.new(0, 64)
        padding.Parent = action
        row.Cleanup, row.InputGui = cleanup, gui
        row.InputTitle, row.InputName = label(gui, 0, ""), label(gui, 32, "")
        refresh(prompt, row, workspace:GetServerTimeNow())
    end)
    Prompts.PromptHidden:Connect(hide)

    -- Animate the existing model's pivot locally. No proxy models, pickup replacements,
    -- or server physics movement. Old streamed harvests do not replay their pop.
    type Pop = { Target: CFrame, Start: number }
    local pops: { [Instance]: Pop } = {}
    local function harvest(object: Instance)
        local time = object:GetAttribute("FarmSpawnTime")
        if
            object:GetAttribute("SpawnSource") ~= "Farm"
            or typeof(time) ~= "number"
            or workspace:GetServerTimeNow() - time > Config.HarvestPopSeconds
            or not (object:IsA("BasePart") or object:IsA("Model"))
        then
            return
        end
        pops[object] = { Target = object:GetPivot(), Start = time }
    end
    CollectionService:GetInstanceAddedSignal("IngredientWorldItem"):Connect(harvest)
    for _, object in CollectionService:GetTagged("IngredientWorldItem") do
        harvest(object)
    end
    local elapsed = 0
    RunService.RenderStepped:Connect(function(dt)
        local now = workspace:GetServerTimeNow()
        for object, pop in pops do
            if not object:IsDescendantOf(workspace) or object:GetAttribute("FrozenUntilPickup") ~= true then
                pops[object] = nil
            elseif object:IsA("Model") or object:IsA("BasePart") then
                local alpha = math.clamp((now - pop.Start) / math.max(0.001, Config.HarvestPopSeconds), 0, 1)
                local eased = TweenService:GetValue(alpha, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                object:PivotTo(pop.Target + Vector3.new(0, -Config.HarvestPopDepth * (1 - eased), 0))
                if alpha >= 1 then
                    object:PivotTo(pop.Target)
                    pops[object] = nil
                end
            end
        end
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        for prompt, row in rows do
            if not prompt:IsDescendantOf(workspace) then
                hide(prompt)
                row.Gui:Destroy()
                if row.PadGui then
                    row.PadGui:Destroy()
                end
                rows[prompt] = nil
            else
                refresh(prompt, row, now)
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="609">
            <Properties>
              <string name="Name">GameplayAudioController</string>
              <string name="Source"><![CDATA[--!strict
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Constants.GameplayAudio)
local Controller = {}
local started = false
local templates: { [string]: Sound } = {}
local eventAssets: { [string]: string } = {
    IngredientPickup = Config.IngredientPickupSoundId,
    IngredientPlant = Config.IngredientPlantSoundId,
    IngredientThrow = Config.IngredientThrowSoundId,
    BatSwing = Config.BatSwingSoundId,
    CustomerHurt = Config.CustomerHurtSoundId,
}

local function play(template: Sound, position: Vector3)
    local camera = workspace.CurrentCamera
    if camera and (camera.CFrame.Position - position).Magnitude > Config.SoundRollOffMaxDistance then
        return
    end
    local emitter = Instance.new("Part")
    emitter.Name = "GameplaySfx"
    emitter.Size = Vector3.new(0.1, 0.1, 0.1)
    emitter.Anchored, emitter.Transparency = true, 1
    emitter.CanCollide, emitter.CanTouch, emitter.CanQuery = false, false, false
    emitter.Position = position
    local sound = template:Clone()
    sound.Parent = emitter
    emitter.Parent = workspace
    sound.Ended:Once(function()
        emitter:Destroy()
    end)
    Debris:AddItem(emitter, 15)
    sound:Play()
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local preload: { Instance } = {}
    for _, id in eventAssets do
        if not templates[id] then
            local sound = Instance.new("Sound")
            sound.SoundId = id
            sound.Volume = Config.SoundVolume
            sound.RollOffMinDistance = Config.SoundRollOffMinDistance
            sound.RollOffMaxDistance = Config.SoundRollOffMaxDistance
            templates[id] = sound
            table.insert(preload, sound)
        end
    end
    local ready = false
    local pending: { { Template: Sound, Position: Vector3 } } = {}
    task.spawn(function()
        local remote = ReplicatedStorage.Shared.Events:WaitForChild("GameplaySfx") :: RemoteEvent
        remote.OnClientEvent:Connect(function(event: any, position: any)
            local id = if type(event) == "string" then eventAssets[event] else nil
            if not id or typeof(position) ~= "Vector3" then
                return
            end
            local template = templates[id]
            if ready then
                play(template, position)
            elseif #pending < 32 then
                -- Preserve early authorized events while the two assets load.
                table.insert(pending, { Template = template, Position = position })
            end
        end)
    end)
    task.spawn(function()
        local ok, message = pcall(function()
            ContentProvider:PreloadAsync(preload)
        end)
        if not ok then
            warn("[GameplayAudio] Preload failed: " .. tostring(message))
        end
        ready = true
        for _, event in pending do
            play(event.Template, event.Position)
        end
        table.clear(pending)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="610">
            <Properties>
              <string name="Name">GameplayPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameplayPresentationController = {}
local started = false

function GameplayPresentationController.Init()
    if started then
        return
    end
    started = true
    -- Waiting for server-created objects must not block other client controllers.
    task.spawn(function()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local remote = events:WaitForChild("GameplayPresentation")
        assert(remote:IsA("RemoteEvent"), "GameplayPresentation must be a RemoteEvent")
        remote.OnClientEvent:Connect(function(_moment: any, _ownerUserId: any, _payload: any)
            -- Drain all presentation messages, including future/unsupported kinds.
            -- Current visuals use replicated attributes and server-created UI/audio.
            -- Add cosmetic handlers here when implemented; never send gameplay requests
            -- or mutate authoritative state in response to these notifications.
        end)
    end)
end

return GameplayPresentationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="611">
            <Properties>
              <string name="Name">IngredientPickupPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Definitions = require(game:GetService("ReplicatedStorage").Shared.Constants.Ingredients)
local Presentation = require(script.Parent.Parent.UI.IngredientPickupPromptPresentation)
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local Controller = {}
local started = false

-- Client mirror of IngredientService's ancestor resolution, using only its
-- replicated registration metadata. The server still validates its private record.
function Controller.Resolve(prompt: ProximityPrompt): (BasePart | Model)?
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        if CollectionService:HasTag(ancestor, "IngredientWorldItem") then
            if ancestor:IsA("BasePart") or ancestor:IsA("Model") then
                return ancestor
            end
            return nil
        end
        ancestor = ancestor.Parent
    end
    return nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    type Entry = {
        InputType: Enum.ProximityPromptInputType,
        Object: Instance?,
        Id: string?,
        Cleanup: (() -> ())?,
        Update: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Entry } = {}
    local function clear(entry: Entry)
        if entry.Cleanup then
            entry.Cleanup()
        end
        entry.Cleanup, entry.Update, entry.Object, entry.Id = nil, nil, nil, nil
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if entry then
            visible[prompt] = nil
            for _, connection in entry.Connections do
                connection:Disconnect()
            end
            clear(entry)
        end
    end
    local function refresh(prompt: ProximityPrompt, entry: Entry)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled or not ProximityPromptService.Enabled then
            hide(prompt)
            return
        end
        local object = Controller.Resolve(prompt)
        local owner = object and object:GetAttribute("OwnerUserId")
        if typeof(owner) == "number" and owner ~= 0 and owner ~= Players.LocalPlayer.UserId then
            clear(entry)
            return
        end
        local id = object and object:GetAttribute("IngredientId")
        local definition = if typeof(id) == "string" then Definitions[id] else nil
        if object and object:IsA("Model") and not object:FindFirstChildWhichIsA("BasePart", true) then
            clear(entry)
            return
        end
        if
            prompt.Style ~= Enum.ProximityPromptStyle.Custom
            or prompt:GetAttribute("IngredientPickupPrompt") ~= true
            or not definition
            or not object
        then
            clear(entry)
            return
        end
        if entry.Object ~= (object :: Instance) or entry.Id ~= id then
            clear(entry)
            entry.Object, entry.Id = object, definition.Id
            entry.Cleanup, entry.Update = Presentation.Create(prompt, object, definition, playerGui, entry.InputType)
        elseif entry.Update then
            entry.Update()
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        hide(prompt)
        -- Track shown prompts only. No distance checks, pickup remotes, or scans.
        if prompt:GetAttribute("IngredientPickupPrompt") ~= true and prompt.Name ~= "CarryPrompt" then
            return
        end
        if inputType == Enum.ProximityPromptInputType.Touch then
            Debug.Log(prompt, "SHOWN", "client ingredient")
        end
        local entry: Entry = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.Destroying:Connect(function()
                hide(prompt)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(hide)
    -- Only engine-visible prompts: tracks rolling/dropped geometry and tolerates
    -- tags/IngredientId arriving after PromptShown during replication/streaming.
    RunService.RenderStepped:Connect(function()
        for prompt, entry in visible do
            refresh(prompt, entry)
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="612">
            <Properties>
              <string name="Name">InteractionPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Presentation = require(script.Parent.Parent.UI.InteractionPromptPresentation)
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local Controller = {}
local started = false

-- Never recursively search a plot/workspace and accidentally bind another interactable.
local function findOrigin(prompt: ProximityPrompt): (Attachment?, string?)
    local name = prompt:GetAttribute("InteractionOrigin")
    if typeof(name) ~= "string" or name == "" then
        return nil, "InteractionOrigin must be a nonempty string"
    end
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        local marker = ancestor:FindFirstChild(name)
        if marker and marker:IsA("Attachment") then
            return marker
        end
        if marker then
            return nil, marker:GetFullName() .. " is " .. marker.ClassName .. "; expected Attachment"
        end
        if ancestor:IsA("Model") then
            local found: Attachment? = nil
            for _, descendant in ancestor:GetDescendants() do
                if descendant.Name == name and descendant:IsA("Attachment") then
                    if found then
                        return nil, "Ambiguous InteractionOrigin beneath " .. ancestor:GetFullName()
                    end
                    found = descendant
                end
            end
            if found then
                return found
            end
            return nil, "Attachment " .. name .. " not found beneath containing Model " .. ancestor:GetFullName()
        end
        ancestor = ancestor.Parent
    end
    return nil, "Attachment " .. name .. " not found beneath prompt's containing interactable"
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    -- ServerStorage's debug flag does not replicate. Use the same Studio-only
    -- convention on local PlayerGui, without introducing a server bridge.
    local function debugging(): boolean
        return RunService:IsStudio() and playerGui:GetAttribute("DebugFilmLoop") == true
    end
    local function log(prompt: ProximityPrompt, message: string)
        if debugging() then
            print("[InteractionPrompt] " .. prompt:GetFullName() .. " | " .. message)
        end
    end
    local shownCounts = setmetatable({} :: { [ProximityPrompt]: number }, { __mode = "k" })
    local function snapshot(prompt: ProximityPrompt)
        if not debugging() then
            return
        end
        local parent = prompt.Parent
        local placement = "Invalid: parent must be BasePart, Attachment, or Model with PrimaryPart"
        if parent then
            if parent:IsA("Model") then
                placement = if parent.PrimaryPart
                    then "Model PrimaryPart=" .. parent.PrimaryPart:GetFullName()
                    else "Invalid: Model.PrimaryPart is nil; engine cannot show this prompt"
            elseif parent:IsA("BasePart") then
                placement = "BasePart=" .. parent:GetFullName()
            elseif parent:IsA("Attachment") then
                placement = "Attachment=" .. parent:GetFullName() .. "; parent=" .. tostring(parent.Parent)
            end
        end
        local origin, reason = findOrigin(prompt)
        log(
            prompt,
            string.format(
                "snapshot | PromptShownCount=%d | InteractionOrigin=%s | InteractionActionText=%s | ResolvedOrigin=%s | OriginReason=%s | MaxActivationDistance=%s | RequiresLineOfSight=%s | HoldDuration=%s | Style=%s | Enabled=%s | ParentClass=%s | Placement=%s | InWorkspace=%s | Exclusivity=%s | ServiceEnabled=%s | MaxPromptsVisible=%s",
                shownCounts[prompt] or 0,
                tostring(prompt:GetAttribute("InteractionOrigin")),
                tostring(prompt:GetAttribute("InteractionActionText")),
                if origin then origin:GetFullName() else "nil",
                reason or "resolved",
                tostring(prompt.MaxActivationDistance),
                tostring(prompt.RequiresLineOfSight),
                tostring(prompt.HoldDuration),
                tostring(prompt.Style),
                tostring(prompt.Enabled),
                if parent then parent.ClassName else "nil",
                placement,
                tostring(prompt:IsDescendantOf(workspace)),
                tostring(prompt.Exclusivity),
                tostring(ProximityPromptService.Enabled),
                tostring(ProximityPromptService.MaxPromptsVisible)
            )
        )
    end
    local function dump()
        if not debugging() then
            return
        end
        for _, object in workspace:GetDescendants() do
            if object:IsA("ProximityPrompt") and object:GetAttribute("InteractionOrigin") ~= nil then
                snapshot(object)
            end
        end
    end
    playerGui:GetAttributeChangedSignal("DebugFilmLoop"):Connect(dump)
    type Visible = {
        InputType: Enum.ProximityPromptInputType,
        Origin: Attachment?,
        Cleanup: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Visible } = {}
    local function clearView(entry: Visible)
        local cleanup = entry.Cleanup
        entry.Cleanup = nil
        entry.Origin = nil
        if cleanup then
            cleanup()
        end
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if not entry then
            return
        end
        visible[prompt] = nil
        for _, connection in entry.Connections do
            connection:Disconnect()
        end
        clearView(entry)
    end
    local function refresh(prompt: ProximityPrompt, entry: Visible)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled then
            log(prompt, "Rejected: " .. (if not prompt.Enabled then "Enabled=false" else "prompt is outside Workspace"))
            hide(prompt)
            return
        end
        local origin, reason = findOrigin(prompt)
        if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
            origin = nil
            reason = "Style is not Custom"
        end
        local customerAction = prompt:GetAttribute("InteractionCustomerAction")
        if
            customerAction
            and (
                prompt:GetAttribute("PlotSessionId") == nil
                or prompt:GetAttribute("PlotSessionId") ~= Players.LocalPlayer:GetAttribute("PlotSessionId")
            )
        then
            origin = nil
            reason = "Customer prompt belongs to another player"
        end
        if not origin then
            log(prompt, "Rejected: " .. (reason or "origin unavailable"))
        end
        if origin == entry.Origin then
            return
        end
        clearView(entry)
        if origin then
            local action = prompt:GetAttribute("InteractionActionText")
            local key = prompt:GetAttribute("InteractionKeyText")
            local distance = prompt:GetAttribute("InteractionMaxDistance")
            entry.Origin = origin
            log(
                prompt,
                "Presentation.Create | origin="
                    .. origin:GetFullName()
                    .. " | InteractionActionText="
                    .. tostring(action)
            )
            local dispenser = origin.Name == "DispenserTextOrigin" and not customerAction
            local touch = dispenser and entry.InputType == Enum.ProximityPromptInputType.Touch
            local cleanup, gui = Presentation.Create(prompt, origin, playerGui, entry.InputType, {
                Height = if touch then 80 else nil,
                TouchWidth = if touch then 220 else nil,
                TouchHeight = if touch then 80 else nil,
                TouchCenterY = if touch then 40 else nil,
                CustomerAction = if typeof(customerAction) == "string" then customerAction else nil,
                ActionText = if typeof(action) == "string" then action else nil,
                KeyText = if typeof(key) == "string" then key else nil,
                MaxDistance = if typeof(distance) == "number" and distance > 0 then distance else nil,
            })
            if touch then
                local text = gui:FindFirstChild("Action") :: TextLabel
                text.Size = UDim2.new(1, 0, 0, 56)
                text.Position = UDim2.fromOffset(0, 12)
            end
            entry.Cleanup = cleanup
            log(prompt, "BillboardGui created=" .. gui:GetFullName() .. " | Adornee=" .. origin:GetFullName())
        end
    end
    Players.LocalPlayer:GetAttributeChangedSignal("PlotSessionId"):Connect(function()
        for prompt, entry in visible do
            refresh(prompt, entry)
        end
    end)
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        if prompt:GetAttribute("PlayerStashPrompt") == true then
            return
        end
        if
            inputType == Enum.ProximityPromptInputType.Touch
            and prompt:GetAttribute("InteractionOrigin") == "DispenserTextOrigin"
        then
            Debug.Log(prompt, "SHOWN", "client dispenser")
        end
        shownCounts[prompt] = (shownCounts[prompt] or 0) + 1
        log(prompt, "PromptShown received by controller | InputType=" .. tostring(inputType))
        snapshot(prompt)
        hide(prompt)
        local entry: Visible = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AttributeChanged:Connect(function(attribute)
                if string.sub(attribute, 1, 11) == "Interaction" or attribute == "PlotSessionId" then
                    clearView(entry)
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(function(prompt)
        log(prompt, "PromptHidden received by controller")
        hide(prompt)
    end)
    dump()
    -- Replication/streaming may deliver a marker after its already-visible prompt.
    workspace.DescendantAdded:Connect(function(object)
        if object:IsA("ProximityPrompt") then
            snapshot(object)
        end
        if object:IsA("Attachment") then
            for prompt, entry in visible do
                refresh(prompt, entry)
            end
        end
    end)
    workspace.DescendantRemoving:Connect(function(object: Instance)
        for prompt, entry in visible do
            if object == prompt then
                hide(prompt)
            elseif object == entry.Origin then
                clearView(entry)
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="613">
            <Properties>
              <string name="Name">JackedNoobResponseController</string>
              <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local TextStyle = require(ReplicatedStorage.Shared.Constants.DialogueTextStyle)
local Config = require(ReplicatedStorage.Shared.Constants.JackedNoob)
local Controller = {}

function Controller.Init()
    local remote = ReplicatedStorage:WaitForChild("JackedNoobResponse") :: RemoteEvent
    local current: BillboardGui? = nil
    local version = 0
    remote.OnClientEvent:Connect(function(head: Instance, line: string)
        if not head:IsA("BasePart") or not head:IsDescendantOf(workspace) or type(line) ~= "string" then
            return
        end
        version += 1
        local thisVersion = version
        if current then
            current:Destroy()
        end
        local gui = Instance.new("BillboardGui")
        gui.Name = "JackedNoobResponse"
        gui.Adornee = head
        gui.Size = UDim2.fromOffset(320, 58)
        gui.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y / 2 + 1.7, 0)
        gui.AlwaysOnTop = true
        gui.MaxDistance = 65
        local label = Instance.new("TextLabel")
        label.Name = "Text"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = line
        TextStyle.Apply(label, 23)
        label.TextWrapped = true
        label.TextTransparency = 1
        local outline = label:FindFirstChild("DialogueOutline") :: UIStroke
        outline.Transparency = 1
        label.Parent = gui
        gui.Parent = head
        current = gui
        TweenService:Create(label, TweenInfo.new(0.15), { TextTransparency = 0 }):Play()
        TweenService:Create(outline, TweenInfo.new(0.15), { Transparency = 0 }):Play()
        task.delay(Config.DialogueSeconds - 0.3, function()
            if thisVersion ~= version or current ~= gui then
                return
            end
            TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
            TweenService:Create(outline, TweenInfo.new(0.3), { Transparency = 1 }):Play()
            task.delay(0.3, function()
                if current == gui then
                    current = nil
                end
                gui:Destroy()
            end)
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="614">
            <Properties>
              <string name="Name">MuncherPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.Muncher)
local Style = require(Shared.Constants.DialogueTextStyle)
local BillboardStyle = require(script.Parent.Parent.UI.WorldBillboardStyle)
local Tooltip = require(script.Parent.Parent.UI.TutorialTooltip)
type View = { Gui: BillboardGui, Name: TextLabel, Timer: TextLabel }
local Controller = {}
local started = false

-- Same origin, canvas and text-row convention as FarmPresentationController's
-- purchase billboards: pad Adornee, PlayerGui parent, two-stud world-space lift.
local function purchaseDisplay(pad: BasePart, playerGui: PlayerGui): BillboardGui
    local gui = Instance.new("BillboardGui")
    gui.Name = "MuncherPurchase"
    gui.Adornee = pad
    BillboardStyle.ApplyBillboard(gui, { Width = 340, Height = 64, MaxDistance = 28 })
    gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
    for index, text in { "MUNCHER", "$100K" } do
        local label = Instance.new("TextLabel")
        label.Name = if index == 1 then "Title" else "Detail"
        BillboardStyle.ApplyText(label, {})
        Style.Apply(label, 24)
        label.Size = UDim2.new(1, 0, 0, 32)
        label.Position = UDim2.fromOffset(0, (index - 1) * 32)
        label.Text = text
        if index == 2 then
            label.TextColor3 = Style.Gold
        end
        label.Parent = gui
    end
    gui.Parent = playerGui
    return gui
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
    local shown = false
    local views: { [Instance]: View } = {}
    local purchaseViews: { [BasePart]: BillboardGui } = {}
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        local seen: { [Instance]: boolean } = {}
        local seenPads: { [BasePart]: boolean } = {}
        for _, plot in CollectionService:GetTagged("PlayerPlot") do
            local model = plot:FindFirstChild("Muncher")
            if not model or not plot:IsDescendantOf(workspace) then
                continue
            end
            seen[model] = true
            local pad = model:FindFirstChild("PurchasePoint1")
            if pad and pad:IsA("BasePart") then
                seenPads[pad] = true
                local purchaseGui = purchaseViews[pad]
                if not purchaseGui then
                    purchaseGui = purchaseDisplay(pad, playerGui)
                    purchaseViews[pad] = purchaseGui
                end
                -- Match Farm pad visibility; the server continues to own pad state.
                purchaseGui.Enabled = pad:IsDescendantOf(workspace) and pad.CanTouch and pad.Transparency < 1
            end
            local origin = model:FindFirstChild("DisplayOrigin")
            local active = model:GetAttribute("Active") == true
            local id = model:GetAttribute("ActiveBuff")
            local expires = model:GetAttribute("BuffExpiresAt")
            local remaining = if type(expires) == "number"
                then math.max(0, math.ceil(expires - workspace:GetServerTimeNow()))
                else 0
            local buff = nil
            for _, candidate in Config.Buffs do
                if candidate.Id == id then
                    buff = candidate
                    break
                end
            end
            local view: View? = views[model]
            if
                active
                and buff
                and remaining > 0
                and origin
                and (origin:IsA("BasePart") or origin:IsA("Attachment"))
            then
                if view and view.Gui.Adornee ~= origin then
                    view.Gui:Destroy()
                    views[model] = nil
                    view = nil
                end
                if not view then
                    local gui = Instance.new("BillboardGui")
                    gui.Name = "MuncherBuff"
                    gui.Adornee = origin
                    gui.Size = UDim2.fromOffset(190, 52)
                    gui.StudsOffsetWorldSpace = Vector3.new(0, 2.35, 0)
                    gui.MaxDistance = Config.MaxDistance
                    gui.AlwaysOnTop = false
                    local title = Instance.new("TextLabel")
                    title.BackgroundTransparency = 1
                    title.Size = UDim2.fromOffset(190, 26)
                    Style.Apply(title, 19)
                    title.TextColor3 = Style.Gold
                    title.Parent = gui
                    local timer = Instance.new("TextLabel")
                    timer.BackgroundTransparency = 1
                    timer.Position = UDim2.fromOffset(0, 26)
                    timer.Size = UDim2.fromOffset(190, 24)
                    Style.Apply(timer, 20)
                    timer.Parent = gui
                    gui.Parent = playerGui
                    view = { Gui = gui, Name = title, Timer = timer }
                    views[model] = view
                end
                assert(view)
                view.Name.Text = buff.Name
                view.Timer.Text = string.format("%d:%02d", math.floor(remaining / 60), remaining % 60)
            elseif view then
                view.Gui:Destroy()
                views[model] = nil
            end
            if
                active
                and not shown
                and type(player:GetAttribute("PlotSessionId")) == "string"
                and plot:GetAttribute("PlotSessionId") == player:GetAttribute("PlotSessionId")
            then
                shown = true
                Tooltip.Show(playerGui, "MuncherTutorial", "FEED MUNCHER to receive a temporary buff!")
            end
        end
        for pad, gui in purchaseViews do
            if not seenPads[pad] then
                gui:Destroy()
                purchaseViews[pad] = nil
            end
        end
        for model, view in views do
            if not seen[model] then
                view.Gui:Destroy()
                views[model] = nil
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="615">
            <Properties>
              <string name="Name">PlotIdentityController</string>
              <string name="Source"><![CDATA[--!strict
-- Replicated identity is presentation only. Every action is revalidated by the server.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local TextStyle = require(ReplicatedStorage.Shared.Constants.DialogueTextStyle)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)
local Controller = {}
local player = Players.LocalPlayer
local portraits: { [number]: string } = {}
local pending: { [number]: boolean } = {}
local displays: { [Instance]: BillboardGui } = {}
local padLabels: { [Instance]: BillboardGui } = {}
local initialized = false
local function portrait(id: number): string
    if not portraits[id] and not pending[id] then
        pending[id] = true
        task.spawn(function()
            local ok, url = pcall(function()
                return Players:GetUserThumbnailAsync(id, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            end)
            portraits[id] = if ok then url else ""
            pending[id] = nil
        end)
    end
    return portraits[id] or ""
end
local function label(parent: Instance, text: string, y: number): TextLabel
    local result = Instance.new("TextLabel")
    result.BackgroundTransparency = 1
    result.Size = UDim2.new(1, 0, 0, 28)
    result.Position = UDim2.fromOffset(0, y)
    TextStyle.Apply(result, 17)
    result.Text = text
    result.Parent = parent
    return result
end
local function button(parent: Instance, text: string, y: number, callback: () -> ()): TextButton
    local result = Instance.new("TextButton")
    result.Size = UDim2.new(1, -24, 0, 30)
    result.AnchorPoint = Vector2.new(0.5, 0.5)
    result.Position = UDim2.new(0.5, 0, 0, y + 15)
    result.BackgroundColor3 = Color3.fromRGB(35, 92, 108)
    result.BorderSizePixel = 0
    TextStyle.Apply(result, 17)
    result.Text = text
    result.Parent = parent
    Instance.new("UICorner", result).CornerRadius = UDim.new(0, 12)
    local border = Instance.new("UIStroke")
    border.Name = "ButtonOutline"
    border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    border.Color, border.Thickness = TextStyle.Dark, 3
    border.Parent = result
    result.Activated:Connect(callback)
    return result
end
function Controller.Init()
    if initialized then
        return
    end
    initialized = true
    local remote = ReplicatedStorage.Shared.Events:WaitForChild("GameplayRequest") :: RemoteEvent
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn = "PlotManagement", false
    gui.Parent = player:WaitForChild("PlayerGui")
    local status = label(gui, "", 70)
    local panel = Instance.new("Frame")
    panel.Size = UDim2.fromOffset(280, 300)
    panel.Position = UDim2.new(0.5, -140, 0.5, -150)
    panel.BackgroundColor3 = Color3.fromRGB(23, 30, 40)
    panel.Visible = false
    panel.Parent = gui
    Instance.new("UICorner", panel)
    local managed: Instance? = nil
    local managedRevision: any = nil
    local menu = PanelManager.Register("PlotManagement", {
        Open = function()
            panel.Visible = true
        end,
        Close = function()
            panel.Visible = false
            managed = nil
        end,
    })
    gui.Destroying:Connect(menu.Destroy)
    local modeRows: { [string]: TextButton } = {}
    local selectionTweens: { Tween } = {}
    local selectedMode: any = nil
    local modeTitles = { Open = "PUBLIC", FriendsOnly = "FRIENDS", Closed = "PRIVATE" }
    local function updateSelection(mode: any, animate: boolean)
        for _, tween in selectionTweens do
            tween:Cancel()
        end
        table.clear(selectionTweens)
        selectedMode = mode
        for value, row in modeRows do
            local selected = value == mode
            row.Text = (if selected then "SELECTED: " else "") .. modeTitles[value]
            row.TextColor3 = if selected then TextStyle.White else Color3.fromRGB(205, 215, 226)
            local fill = if selected then Color3.fromRGB(45, 159, 123) else Color3.fromRGB(43, 56, 70)
            local scale = row:FindFirstChild("SelectionScale") :: UIScale
            local border = row:FindFirstChild("ButtonOutline") :: UIStroke
            border.Color = if selected then TextStyle.Gold else TextStyle.Dark
            border.Thickness = if selected then 3.5 else 2
            local size = if selected then 1.1 else 1
            if animate then
                for _, tween in
                    {
                        TweenService:Create(
                            scale,
                            TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                            { Scale = size }
                        ),
                        TweenService:Create(row, TweenInfo.new(0.16), { BackgroundColor3 = fill }),
                    }
                do
                    table.insert(selectionTweens, tween)
                    tween:Play()
                end
            else
                scale.Scale = size
                row.BackgroundColor3 = fill
            end
        end
    end
    local function context(plot: Instance): any
        return {
            PlotSessionId = plot:GetAttribute("PlotSessionId"),
            MembershipRevision = plot:GetAttribute("PlotMembershipRevision"),
            ClaimRevision = plot:GetAttribute("PlotClaimRevision") or 0,
        }
    end
    local function send(plot: Instance, action: string, value: any, captured: any)
        remote:FireServer(action, plot, value, captured)
    end
    local function openManage(plot: Instance)
        local previousMode = if managed == plot and panel.Visible then selectedMode else nil
        for _, tween in selectionTweens do
            tween:Cancel()
        end
        table.clear(selectionTweens)
        table.clear(modeRows)
        panel:ClearAllChildren()
        Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 16)
        managed = plot
        local captured = context(plot)
        managedRevision = captured.MembershipRevision
        label(panel, "MANAGE PLOT", 8)
        label(panel, tostring(plot:GetAttribute("PlotTeammateName") or "Empty Slot"), 38)
        local teammate = plot:GetAttribute("TeammateUserId")
        if type(teammate) == "number" then
            local head = Instance.new("ImageLabel")
            head.Size, head.Position = UDim2.fromOffset(36, 36), UDim2.fromOffset(8, 32)
            head.Image, head.BackgroundTransparency, head.Parent = portrait(teammate), 1, panel
            Instance.new("UICorner", head).CornerRadius = UDim.new(1, 0)
        end
        for index, mode in { "Open", "FriendsOnly", "Closed" } do
            local row = button(panel, modeTitles[mode], 74 + (index - 1) * 36, function()
                send(plot, "SetJoinMode", mode, captured)
            end)
            row.Size = UDim2.new(1, -32, 0, 28) -- Leave space for the selected scale and outline.
            row.AutoButtonColor = false
            local scale = Instance.new("UIScale")
            scale.Name, scale.Scale, scale.Parent = "SelectionScale", 1, row
            modeRows[mode] = row
        end
        local mode = plot:GetAttribute("JoinMode")
        updateSelection(if previousMode ~= nil then previousMode else mode, false)
        if previousMode ~= nil and previousMode ~= mode then
            updateSelection(mode, true)
        end
        if teammate then
            button(panel, "KICK TEAMMATE", 186, function()
                send(plot, "KickTeammate", teammate, captured)
            end)
        end
        button(panel, "CLOSE", 252, function()
            menu.Close()
        end)
        menu.Open()
    end
    local failureUntil = 0
    remote.OnClientEvent:Connect(function(action, result)
        if action == "PlotRequestResult" and not result.success then
            failureUntil = os.clock() + 4
        end
    end)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.25 then
            return
        end
        elapsed = 0
        local assigned = player:GetAttribute("PlotSessionId") ~= nil
        status.Text = if os.clock() < failureUntil
            then "Plot action unavailable. Move closer or try again."
            elseif not assigned then "Claim an available PLOT!"
            else ""
        status.TextSize = if not assigned and os.clock() >= failureUntil then 20 else 17
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local live: { [Instance]: boolean } = {}
        local liveLabels: { [Instance]: boolean } = {}
        for _, plot in CollectionService:GetTagged("PlayerPlot") do
            local identity = plot:FindFirstChild("PlotIdentity")
            if identity and plot:IsDescendantOf(workspace) then
                for _, role in { "Claim", "Teammate" } do
                    local labelOrigin = identity:FindFirstChild(role .. "LabelOrigin")
                    if labelOrigin and (labelOrigin:IsA("BasePart") or labelOrigin:IsA("Attachment")) then
                        liveLabels[labelOrigin] = true
                        local display = padLabels[labelOrigin]
                        if not display then
                            local created = Instance.new("BillboardGui")
                            created.Name = role .. "ZoneLabel"
                            created.Size = UDim2.fromOffset(180, 32)
                            created.AlwaysOnTop, created.MaxDistance, created.Active = true, 22, false
                            created.Adornee, created.Parent = labelOrigin, gui
                            label(created, if role == "Claim" then "CLAIM PLOT" else "JOIN STAND", 0)
                            padLabels[labelOrigin] = created
                            display = created
                        end
                        local occupancy = plot:GetAttribute("PlotOccupancy") or 0
                        display.Enabled = if role == "Claim" then occupancy == 0 else occupancy == 1
                    end
                end
            end
            local origin = plot:FindFirstChild("PlotIdentityOrigin", true)
            if
                not plot:IsDescendantOf(workspace)
                or not origin
                or not (origin:IsA("BasePart") or origin:IsA("Attachment"))
            then
                continue
            end
            live[plot] = true
            if not displays[plot] then
                local display = Instance.new("BillboardGui")
                display.Name = "PlotIdentity"
                display.Size = UDim2.fromOffset(280, 200)
                display.ClipsDescendants = false -- Allow fixed-width member columns around the existing action footprint.
                display.AlwaysOnTop, display.MaxDistance, display.Active = true, 160, true
                display.Parent = gui
                displays[plot] = display
            end
            local display = displays[plot]
            display.Adornee = origin
            local owner = plot:GetAttribute("OwnerUserId")
            local teammate = plot:GetAttribute("TeammateUserId")
            display.MaxDistance = if type(owner) == "number" then 160 else 80
            local position = if origin:IsA("Attachment") then origin.WorldPosition else (origin :: BasePart).Position
            local nearby = root and root:IsA("BasePart") and (root.Position - position).Magnitude <= 32
            local action = if not nearby
                then nil
                elseif owner == player.UserId then "MANAGE PLOT"
                elseif teammate == player.UserId then "LEAVE TEAM"
                else nil
            local signature = tostring(owner)
                .. tostring(teammate)
                .. tostring(plot:GetAttribute("PlotMembershipRevision"))
                .. tostring(plot:GetAttribute("PlotClaimRevision"))
                .. tostring(action)
                .. (if type(owner) == "number" then portrait(owner) else "")
                .. (if type(teammate) == "number" then portrait(teammate) else "")
            if display:GetAttribute("Signature") ~= signature then
                display:SetAttribute("Signature", signature)
                display:ClearAllChildren()
                if type(owner) == "number" then
                    local function member(id: number, name: string, x: number, role: string)
                        local head = Instance.new("ImageLabel")
                        head.Size, head.Position = UDim2.fromOffset(64, 64), UDim2.fromOffset(x, 0)
                        head.Image, head.BackgroundTransparency, head.Parent = portrait(id), 1, display
                        Instance.new("UICorner", head).CornerRadius = UDim.new(1, 0)
                        local nameLabel = label(display, name, 72)
                        nameLabel.TextSize = 24
                        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
                        local width = if teammate then 260 else 420
                        nameLabel.Size = UDim2.fromOffset(width, 32)
                        nameLabel.Position = UDim2.fromOffset(x + 32 - width / 2, 72)
                        if role ~= "" then
                            local roleLabel = label(display, role, 106)
                            roleLabel.Size, roleLabel.Position =
                                UDim2.fromOffset(width, 24), UDim2.fromOffset(x + 32 - width / 2, 106)
                            roleLabel.TextSize = 14
                        end
                    end
                    member(owner, tostring(plot:GetAttribute("PlotOwnerName") or ""), if teammate then -32 else 108, "")
                    if type(teammate) == "number" then
                        member(teammate, tostring(plot:GetAttribute("PlotTeammateName") or ""), 248, "TEAMMATE")
                    end
                else
                    label(display, "AVAILABLE PLOT", 68)
                end
                if action then
                    local captured = context(plot)
                    button(display, action, 132, function()
                        if action == "MANAGE PLOT" then
                            openManage(plot)
                        else
                            send(plot, "LeaveTeam", nil, captured)
                        end
                    end)
                end
            end
        end
        for plot, display in displays do
            if not live[plot] then
                display:Destroy()
                displays[plot] = nil
            end
        end
        for origin, display in padLabels do
            if not liveLabels[origin] then
                display:Destroy()
                padLabels[origin] = nil
            end
        end
        if managed then
            if not live[managed] or managed:GetAttribute("OwnerUserId") ~= player.UserId then
                menu.Close()
            elseif managed:GetAttribute("PlotMembershipRevision") ~= managedRevision then
                openManage(managed)
            elseif managed:GetAttribute("JoinMode") ~= selectedMode then
                updateSelection(managed:GetAttribute("JoinMode"), true)
            end
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="616">
            <Properties>
              <string name="Name">RareIngredientPresentationController</string>
              <string name="Source"><![CDATA[--!strict
-- One presentation path for spawn, acquisition, serving and future server events.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Style = require(Shared.Constants.DialogueTextStyle)
local Format = require(Shared.AnnouncementFormat)
local Controller = {}
local started = false
local sounds = { Mystery = "rbxassetid://110253665387820" } -- Existing blender-ready ding.

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
        local remote = Shared:WaitForChild("Events"):WaitForChild("RareIngredientSpawned")
        assert(remote:IsA("RemoteEvent"), "RareIngredientSpawned must be a RemoteEvent")
        local gui = Instance.new("ScreenGui")
        gui.Name = "RareIngredientAnnouncement"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = false
        gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
        gui.DisplayOrder = 20
        gui.Parent = playerGui
        local banner = Instance.new("TextLabel")
        banner.Name = "Announcement"
        banner.AnchorPoint = Vector2.new(0.5, 0)
        local resting = UDim2.fromScale(0.5, 0.065)
        banner.Position = resting
        banner.Size = UDim2.new(0.92, 0, 0, 104)
        banner.BackgroundTransparency = 1
        Style.Apply(banner, 32)
        banner.TextWrapped = true
        banner.TextScaled = true
        banner.RichText = true
        banner.Visible = false
        banner.Parent = gui
        local width = Instance.new("UISizeConstraint")
        width.MaxSize = Vector2.new(780, 104)
        width.Parent = banner
        local textSize = Instance.new("UITextSizeConstraint")
        textSize.MinTextSize = 18
        textSize.MaxTextSize = 32
        textSize.Parent = banner
        local stroke = Style.Outline(banner)
        local scale = Instance.new("UIScale")
        scale.Parent = banner
        local cue = Instance.new("Sound")
        cue.Name = "AnnouncementCue"
        cue.Volume = 0.35
        cue.Parent = SoundService
        local queue: { Format.Message } = {}
        local showing = false
        local function drain()
            while #queue > 0 do
                local message = assert(table.remove(queue, 1))
                local text = Format.VisibleText(message, workspace:GetServerTimeNow())
                if not text then
                    continue -- Expired countdowns must not replay after a backlog.
                end
                banner.Text = text
                banner.Position = resting - UDim2.fromOffset(0, 14)
                banner.TextTransparency = 1
                stroke.Transparency = 1
                scale.Scale = 0.93
                banner.Visible = true
                local enter = TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                TweenService:Create(banner, enter, { Position = resting, TextTransparency = 0 }):Play()
                TweenService:Create(scale, enter, { Scale = 1 }):Play()
                TweenService:Create(stroke, TweenInfo.new(0.16), { Transparency = 0 }):Play()
                local soundId = if message.SoundType then sounds[message.SoundType] else nil
                if soundId then
                    cue.SoundId = soundId
                    cue:Play()
                    task.delay(1.5, function()
                        cue:Stop()
                    end)
                end
                local holdUntil = os.clock() + 0.24 + message.Duration
                repeat
                    task.wait(0.1)
                    text = Format.VisibleText(message, workspace:GetServerTimeNow())
                    if text then
                        banner.Text = text
                    end
                until not text
                    or (message.CountdownEndsAt == nil and os.clock() >= holdUntil)
                    or Format.ShouldInterrupt(queue)
                local exit = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                TweenService
                    :Create(banner, exit, { Position = resting - UDim2.fromOffset(0, 10), TextTransparency = 1 })
                    :Play()
                TweenService:Create(stroke, exit, { Transparency = 1 }):Play()
                task.wait(0.18)
                banner.Visible = false
            end
            showing = false
        end
        remote.OnClientEvent:Connect(function(payload: any)
            local message = Format.Build(payload)
            if not message then
                return
            end
            Format.Enqueue(queue, message)
            if not showing then
                showing = true
                task.spawn(drain)
            end
        end)
    end)
end

return Controller
]]></string>
