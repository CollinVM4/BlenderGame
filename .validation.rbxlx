        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">Stash</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Presentation = require(script.Parent.StashPresentation)
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy).NormalStash
local Slots = require(script.Parent.Parent.Services.StashSlots)
local CollectionService = game:GetService("CollectionService")
local Ripeness = require(game:GetService("ReplicatedStorage").Shared.Constants.Ripeness)
local Stash = {}
function Stash.Init(services: any)
    WorldUtil.BindTag("PlayerStash", function(object)
        local plot = object.Parent
        while plot and not CollectionService:HasTag(plot, "PlayerPlot") do
            plot = plot.Parent
        end
        local expansion = plot and Slots.Expansion(plot)
        local slots = Slots.Resolve(object, expansion)
        local prompts = {}
        local connections = {}
        for index, slot in slots do
            slot:SetAttribute("StashLogicalSlotIndex", index)
            local prompt = WorldUtil.Prompt(slot, "StashPrompt", "STASH")
            prompt.Style = Enum.ProximityPromptStyle.Custom
            prompt:SetAttribute("PlayerStashPrompt", true)
            prompts[index] = prompt
            prompt.KeyboardKeyCode = Enum.KeyCode.E
            prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
            prompt.Exclusivity = Enum.ProximityPromptExclusivity.OneGlobally
        end
        local function refresh()
            local owner = services.TycoonService.GetOwner(object)
            local snapshot = owner and services.InventoryService.GetSnapshot(owner)
            local raid = owner and services.InventoryService.GetStashRaidState(owner)
            for index, slot in slots do
                slot:SetAttribute("StashSessionId", raid and raid.SessionId)
                slot:SetAttribute("StashRaidEndsAt", raid and raid.RaidEndsAt or 0)
                slot:SetAttribute("StashProtectionEndsAt", raid and raid.ProtectionEndsAt or 0)
                local enabled = index <= Config.Slots
                    or (expansion ~= nil and expansion:GetAttribute("StashExpansionReady") == true)
                prompts[index].Enabled = enabled
                local state = enabled and snapshot and snapshot.Stash[index]
                slot:SetAttribute("StashOwnerUserId", owner and owner.UserId or 0)
                slot:SetAttribute("RipenessSeconds", Ripeness.RipenessSeconds)
                for i = 1, Config.IngredientCapacity do
                    local unit = state and state.Ingredients[i]
                    local prefix = "StashItem" .. i
                    slot:SetAttribute(prefix .. "Id", unit and unit.ItemId)
                    slot:SetAttribute(prefix .. "IngredientId", unit and unit.IngredientId)
                    slot:SetAttribute(prefix .. "IsRipe", unit and unit.IsRipe)
                    slot:SetAttribute(prefix .. "StoredSeconds", unit and unit.RipenessStoredSeconds)
                    slot:SetAttribute(prefix .. "StoredAt", unit and unit.RipenessStoredAt)
                end
                Presentation.Refresh(slot, state, services.IngredientService)
                prompts[index].ObjectText = (if state and state.Protected then "Protected slot " else "Slot ") .. index
                prompts[index].ActionText = "STASH"
            end
        end
        table.insert(
            connections,
            services.InventoryService.StashChanged:Connect(function()
                refresh()
            end)
        )
        -- Plot assignment and release also refresh empty fixtures for their new owner.
        local ancestor = object.Parent
        while ancestor and ancestor ~= workspace do
            table.insert(connections, ancestor:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh))
            ancestor = ancestor.Parent
        end
        if expansion then
            table.insert(connections, expansion:GetAttributeChangedSignal("StashExpansionReady"):Connect(refresh))
        end
        refresh()
        return function()
            for _, connection in connections do
                connection:Disconnect()
            end
            for _, prompt in prompts do
                prompt:Destroy()
            end
            for _, slot in slots do
                Presentation.Clear(slot)
                slot:SetAttribute("RipenessSeconds", nil)
                for i = 1, Config.IngredientCapacity do
                    for _, suffix in { "Id", "IngredientId", "IsRipe", "StoredSeconds", "StoredAt" } do
                        slot:SetAttribute("StashItem" .. i .. suffix, nil)
                    end
                end
                for _, name in
                    {
                        "StashLogicalSlotIndex",
                        "StashOwnerUserId",
                        "StashSessionId",
                        "StashRaidEndsAt",
                        "StashProtectionEndsAt",
                        "StashIngredientId",
                        "StashItemType",
                        "StashCapacity",
                        "StashCount",
                        "StashProtected",
                    }
                do
                    slot:SetAttribute(name, nil)
                end
            end
        end
    end)
end
return Stash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">StashPresentation</string>
            <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
-- Cosmetic Instances only: never register, spawn, or consume world inventory here.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local SmoothieGeometry = require(script.Parent.Parent.Services.SmoothieGeometry)
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.Economy).NormalStash
local MoneyFormat = require(Shared.MoneyFormat)
local IngredientName = require(Shared.IngredientName)
local Item = require(Shared.IngredientItem)
local RipenessStyle = require(Shared.Constants.RipenessPresentation)
local Presentation = {}
local FilledIndicatorColor = Color3.fromRGB(0, 255, 0)
local EmptyIndicatorColor = Color3.fromRGB(117, 0, 0)

local function refreshIndicators(slot: BasePart, state: any)
    -- The resolver supplies the interaction base; authored indicators may be its
    -- siblings inside the slot model, or descendants of a standalone slot part.
    local parent = slot.Parent
    local root: Instance = if parent
            and parent:IsA("Model")
            and (
                parent.PrimaryPart == slot
                or parent:FindFirstChild("SlotIndicator") ~= nil
                or string.match(parent.Name, "^LockedSlot%d+$")
                or string.match(parent.Name, "^Slot%d+$")
            )
        then parent
        else slot
    local indicators: { { Part: BasePart, X: number, Y: number, Z: number, Order: number } } = {}
    for order, child in root:GetDescendants() do
        if child:IsA("BasePart") and child.Name == "SlotIndicator" then
            local offset = child.Position - slot.Position
            table.insert(indicators, {
                Part = child,
                X = offset:Dot(slot.CFrame.RightVector),
                Y = offset:Dot(slot.CFrame.UpVector),
                Z = offset:Dot(slot.CFrame.LookVector * -1),
                Order = order,
            })
        end
    end
    table.sort(indicators, function(a, b)
        if a.X ~= b.X then
            return a.X < b.X
        elseif a.Y ~= b.Y then
            return a.Y < b.Y
        elseif a.Z ~= b.Z then
            return a.Z < b.Z
        end
        return a.Order < b.Order
    end)
    local capacity = if state then state.Capacity else nil
    if type(capacity) ~= "number" or capacity ~= capacity then
        capacity = Config.IngredientCapacity
    end
    local occupied = if state and state.ItemType == "Smoothie"
        then state.Count
        elseif state and type(state.Ingredients) == "table" then #state.Ingredients
        else 0
    local filled = math.clamp(math.floor(occupied), 0, math.min(#indicators, math.max(0, math.floor(capacity))))
    for index, indicator in indicators do
        indicator.Part.Color = if index <= filled then FilledIndicatorColor else EmptyIndicatorColor
    end
end

local function showValue(slot: BasePart, folder: Folder, surface: CFrame, value: number)
    local gui = Instance.new("BillboardGui")
    gui.Name = "SlotValue"
    gui.Adornee = slot
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    BillboardStyle.ApplyBillboard(
        gui,
        { WidthStuds = 5.76, HeightStuds = 1.44, MaxDistance = RipenessStyle.StashMaxDistance }
    )
    gui.StudsOffsetWorldSpace = surface.Position - slot.Position + Vector3.new(0, 5, 0)
    gui.AlwaysOnTop = true
    gui.ResetOnSpawn = false
    gui.MaxDistance = RipenessStyle.StashMaxDistance

    local label = Instance.new("TextLabel")
    label.Name = "Value"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 28
    label.TextScaled = true
    label.TextColor3 = Color3.fromRGB(100, 235, 120)
    label.Text = MoneyFormat.Compact(value)
    BillboardStyle.ApplyWorldStroke(label, gui, { Color = Color3.new(0, 0, 0) })
    label.Parent = gui
    gui.Parent = folder
end

-- Footprint and height are relative to the display plane's smaller dimension.
-- Size limits are in studs: clamp the target footprint, not the source scale,
-- so both tiny and huge templates can reach the same visible size.
local DisplayFootprintScale = 0.30
local DisplayMaxHeightScale = 0.90 -- Safety cap for unusually tall/thin meshes.
local DisplayMinSize = 0.25
local DisplayMaxSize = 4.0 -- Also caps height; height safety takes precedence.
local DisplayHeightOffset = 0.12
local DisplaySpacing = 1.08 -- Center-to-center spacing in item-size units.
local DisplayFifthLift = 0.65 -- Fifth item's extra height in item-size units.

-- Temporary: print geometry once for the first occupied Slot3 in Studio.
local DisplayDiagnostics = true
local DiagnosticSlotIndex = 3
local diagnosticPrinted = false

local function displaySurface(slot: BasePart)
    local axes = { slot.CFrame.RightVector, slot.CFrame.UpVector, slot.CFrame.LookVector * -1 }
    local sizes = { slot.Size.X, slot.Size.Y, slot.Size.Z }
    local names = { "X", "Y", "Z" }
    local normalIndex = 1
    for index = 2, 3 do
        if math.abs(axes[index]:Dot(Vector3.yAxis)) > math.abs(axes[normalIndex]:Dot(Vector3.yAxis)) then
            normalIndex = index
        end
    end
    local normal = axes[normalIndex]
    if normal:Dot(Vector3.yAxis) < 0 then
        normal *= -1
    end
    local widthIndex = if normalIndex == 1 then 2 else 1
    local depthIndex = 6 - normalIndex - widthIndex
    local tangent = axes[widthIndex]
    -- Complete a right-handed frame with local Y pointing out of the top face.
    -- The second tangent is the remaining slot axis, with the appropriate sign.
    local depthTangent = tangent:Cross(normal)
    local thickness = sizes[normalIndex]
    local topCenter = slot.Position + normal * (thickness / 2)
    return CFrame.fromMatrix(topCenter, tangent, normal, depthTangent),
        sizes[widthIndex],
        sizes[depthIndex],
        thickness,
        names[normalIndex]
end

-- Display-plane X/Z layouts, centered around their horizontal centroid.
local Layouts = {
    { Vector3.new(0, 0, 0) },
    { Vector3.new(-0.5, 0, 0), Vector3.new(0.5, 0, 0) },
    { Vector3.new(-0.5, 0, 1 / 3), Vector3.new(0.5, 0, 1 / 3), Vector3.new(0, 0, -2 / 3) },
    { Vector3.new(-0.5, 0, -0.5), Vector3.new(0.5, 0, -0.5), Vector3.new(-0.5, 0, 0.5), Vector3.new(0.5, 0, 0.5) },
    -- Move the four lower items forward slightly to balance the raised back item.
    {
        Vector3.new(-0.5, 0, -0.4),
        Vector3.new(0.5, 0, -0.4),
        Vector3.new(-0.5, 0, 0.6),
        Vector3.new(0.5, 0, 0.6),
        Vector3.new(0, 0, -0.4),
    },
}
function Presentation.Clear(slot: BasePart)
    local old = slot:FindFirstChild("StashDisplay")
    if old then
        old:Destroy()
    end
end
function Presentation.Refresh(slot: BasePart?, state: any, ingredients: any)
    if not slot then
        return
    end
    if
        type(state) ~= "table"
        or type(state.Count) ~= "number"
        or state.Count ~= state.Count
        or state.Count < 0
        or state.Count % 1 ~= 0
        or (state.IngredientId and type(state.Ingredients) ~= "table")
    then
        state = nil
    end
    if state and state.IngredientId then
        for index = 1, state.Count do
            local unit = state.Ingredients[index]
            if type(unit) ~= "table" or type(unit.IngredientId) ~= "string" then
                state = nil
                break
            end
        end
    end
    Presentation.Clear(slot)
    refreshIndicators(slot, state)
    slot:SetAttribute("StashIngredientId", state and state.IngredientId)
    slot:SetAttribute("StashItemType", state and state.ItemType)
    slot:SetAttribute("StashCapacity", state and state.Capacity or Config.IngredientCapacity)
    slot:SetAttribute("StashCount", state and state.Count or 0)
    slot:SetAttribute("StashProtected", state ~= nil and state.Protected == true)
    if not state or state.Count == 0 or (not state.IngredientId and not state.Smoothie) then
        return
    end
    local folder = Instance.new("Folder")
    folder.Name = "StashDisplay"
    folder.Parent = slot
    local surface, width, depth, thickness, normalAxis = displaySurface(slot)
    showValue(slot, folder, surface, state.Value)
    local slotSize = math.min(width, depth)
    local itemSize = math.clamp(slotSize * DisplayFootprintScale, DisplayMinSize, DisplayMaxSize)
    local maxHeight = math.min(slotSize * DisplayMaxHeightScale, DisplayMaxSize)
    local shouldPrintDiagnostic = DisplayDiagnostics
        and not diagnosticPrinted
        and RunService:IsStudio()
        and slot:GetAttribute("SlotIndex") == DiagnosticSlotIndex
    local spacing = itemSize * DisplaySpacing
    local layout = Layouts[state.Count]
    for i = 1, state.Count do
        local proxy = if state.ItemType == "Smoothie"
            then SmoothieGeometry.CreateVisual(state.Smoothie)
            else ingredients.CreateVisual(state.Ingredients[i].IngredientId, state.Ingredients[i])
        if not proxy then
            continue
        end
        if state.ItemType ~= "Smoothie" then
            local unit = state.Ingredients[i]
            Item.ApplySourceMetadata(proxy, unit)
            if unit.IngredientId == "PlayerHead" then
                proxy.Name =
                    IngredientName.Resolve("PlayerHead", "Player Head", unit.SourceUserId, unit.SourceDisplayName)
            end
        end
        local descendants = proxy:GetDescendants()
        table.insert(descendants, proxy)
        for _, child in descendants do
            for _, tag in CollectionService:GetTags(child) do
                CollectionService:RemoveTag(child, tag)
            end
            child:SetAttribute("SlotIndex", nil)
            child:SetAttribute("WorldItemId", nil)
            child:SetAttribute("IngredientId", nil)
            child:SetAttribute("OwnerUserId", nil)
            if child:IsA("ProximityPrompt") or child:IsA("ClickDetector") or child:IsA("LuaSourceContainer") then
                child:Destroy()
            elseif child:IsA("BasePart") then
                child.PivotOffset = CFrame.new()
                child.Anchored = true
                child.CanCollide = false
                child.CanQuery = false
                child.CanTouch = false
            end
        end
        -- Remove the source pivot's translation/orientation before measuring.
        -- A fresh wrapper with no PrimaryPart gives all templates the same axes.
        local physical = proxy :: any
        physical:PivotTo(CFrame.new())
        local model = Instance.new("Model")
        model.Name = "DisplayIngredient"
        model.WorldPivot = CFrame.new()
        proxy.Parent = model
        local bounds, size = model:GetBoundingBox()
        -- Center the wrapper pivot on actual geometry, independent of authored
        -- pivots. Uniform scaling can enlarge small templates as well as shrink.
        model.WorldPivot = bounds
        -- The identity-oriented wrapper's X/Z axes become the display plane's
        -- X/Z axes at placement, so these bounds already reflect display orientation.
        local footprint = math.max(size.X, size.Z)
        local scaleFactor = math.min(itemSize / math.max(footprint, 0.000001), maxHeight / math.max(size.Y, 0.000001))
        model:ScaleTo(scaleFactor)
        local _, scaled = model:GetBoundingBox()
        if shouldPrintDiagnostic and not diagnosticPrinted then
            diagnosticPrinted = true
            print(
                string.format(
                    "[StashPresentation] %s Size=%s normalAxis=%s thickness=%.3f usableWidth=%.3f usableDepth=%.3f originalBounds=%s horizontalFootprint=%.6f targetFootprint=%.3f scaleFactor=%.6g scaledBounds=%s topSurfaceCenter=%s",
                    slot:GetFullName(),
                    tostring(slot.Size),
                    normalAxis,
                    thickness,
                    width,
                    depth,
                    tostring(size),
                    footprint,
                    itemSize,
                    scaleFactor,
                    tostring(scaled),
                    tostring(surface.Position)
                )
            )
        end
        local offset = layout[i] * spacing
        local lift = if i == 5 then itemSize * DisplayFifthLift else 0
        local target = surface * CFrame.new(offset.X, DisplayHeightOffset + scaled.Y / 2 + lift, offset.Z)
        model:PivotTo(target)
        model.Parent = folder
    end
end
return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">TurbineWheel</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local AudioService = require(script.Parent.Parent.Services.AudioService)
local PhysicsService = require(script.Parent.Parent.Services.PhysicsService)
local TurbineWheel = {}
function TurbineWheel.Init(services: any)
    WorldUtil.BindTag("TurbineWheel", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[TurbineWheel] Requires a blade/stem BasePart")
            return nil
        end
        -- if part:CanSetNetworkOwnership() then
        --     part:SetNetworkOwner(nil)
        -- end
        local audio = AudioService.CreateBlendGroup(part)
        audio.blendSound:Play()
        local particles = Instance.new("ParticleEmitter")
        particles.Rate = 0
        particles.Speed = NumberRange.new(5, 10)
        particles.Parent = part
        local wasComplete = false
        local heartbeat = RunService.Heartbeat:Connect(function(dt)
            local owner = services.TycoonService.GetOwner(part)
            if owner then
                services.BlendService.AddProgress(owner, part, PhysicsService.GetBlendDelta(part, dt))
            end
            local snapshot = owner and services.BlendService.GetSnapshot(owner)
            local state = snapshot and snapshot.State or "EMPTY"
            local strength = if state == "BLENDING" then PhysicsService.GetSpinStrength(part) else 0
            AudioService.UpdateBlendGroup(audio, strength)
            particles.Rate = strength * 2
            if snapshot and snapshot.Result then
                particles.Color = ColorSequence.new(snapshot.Result.Color)
            end
            if state == "COMPLETE" and not wasComplete then
                audio.dingSound:Play()
            end
            wasComplete = state == "COMPLETE"
        end)
        return function()
            heartbeat:Disconnect()
            particles:Destroy()
            for _, sound in audio do
                sound:Destroy()
            end
        end
    end)
end
return TurbineWheel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="85">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">AnnouncementService</string>
            <string name="Source"><![CDATA[--!strict
-- Output-only announcements. Acquisition tokens follow units, never equipped Tools.
local Events = game:GetService("ReplicatedStorage").Shared.Events
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local Service = {}
local deps: any
local remote: RemoteEvent?
local world: { [Instance]: Types.AnnouncementOwnership? } = {}
setmetatable(world, { __mode = "k" })

function Service.Init(services: any)
    deps = services
    local existing = Events:FindFirstChild("RareIngredientSpawned")
    if existing then
        assert(existing:IsA("RemoteEvent"), "RareIngredientSpawned must be a RemoteEvent")
        remote = existing
    else
        local event = Instance.new("RemoteEvent")
        event.Name = "RareIngredientSpawned" -- Keep the existing transport and client bootstrap.
        event.Parent = Events
        remote = event
    end
end

function Service.Publish(payload: any)
    if remote then
        remote:FireAllClients(payload)
    end
end

local function isMystery(id: string): boolean
    local definition = deps.IngredientService.GetDefinition(id)
    return definition ~= nil and definition.Rarity == "Mystery"
end

function Service.TrackSpawn(object: Instance, id: string)
    if isMystery(id) then
        world[object] = {}
    end
end

function Service.GetOwnership(object: Instance): Types.AnnouncementOwnership?
    return world[object]
end

function Service.TrackWorld(object: Instance, ownership: Types.AnnouncementOwnership?)
    world[object] = ownership
end

function Service.Acquired(player: Player, ownership: Types.AnnouncementOwnership?)
    if not ownership or ownership.LastOwnerUserId == player.UserId then
        return
    end
    ownership.LastOwnerUserId = player.UserId
    Service.Publish({ Type = "MysteryAcquired", DisplayName = player.DisplayName, SoundType = "Mystery", Priority = 10 })
end

function Service.Spawned(station: Instance, id: string)
    local location = station:GetAttribute("LocationName")
    Service.Publish({
        Type = "RareIngredientSpawned",
        IngredientId = id,
        DisplayName = deps.IngredientService.GetDefinition(id).DisplayName,
        Mystery = isMystery(id),
        LocationName = if typeof(location) == "string" and location ~= "" then location else station.Name,
        SoundType = "Mystery",
        Priority = if isMystery(id) then 10 else 0,
    })
end

function Service.Served(player: Player, ingredientIds: { string }, payout: number)
    for _, id in ingredientIds do
        if isMystery(id) then
            Service.Publish({
                Type = "MysteryServed",
                DisplayName = player.DisplayName,
                Payout = payout,
                SoundType = "Mystery",
                Priority = 10,
            })
            return
        end
    end
end

return Service
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">AudioService</string>
            <string name="Source"><![CDATA[--!strict
local AudioService = {}
local BadCustomers = require(game:GetService("ReplicatedStorage").Shared.Constants.BadCustomers)

function AudioService.PlayBadCustomerCue(parent: Instance, cue: string)
    local config = (BadCustomers.Audio :: any)[cue]
    if not config then
        return
    end
    local sound = AudioService.ConstructAudioCue(parent, config.SoundId, config.Volume, false)
    sound.PlaybackSpeed = config.PlaybackSpeed
    sound:Play()
    game:GetService("Debris"):AddItem(sound, 8)
end

local CUSTOMER_DIALOGUE_SOUND_ID = "rbxassetid://130763160561998"

function AudioService.ConstructAudioCue(parent: Instance, soundId: string, volume: number, looped: boolean?): Sound
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = volume
    sound.Looped = looped or false
    sound.RollOffMaxDistance = 50
    sound.RollOffMinDistance = 10
    sound.Parent = parent
    return sound
end

function AudioService.PlayCustomerDialogue(sound: Sound?)
    if sound and sound.Parent and not sound.IsPlaying then
        sound:Play()
    end
end

function AudioService.CreateBlendGroup(parent: Instance): { [string]: Sound }
    local blendSound = AudioService.ConstructAudioCue(parent, "rbxassetid://365965609", 0, true)
    local dingSound = AudioService.ConstructAudioCue(parent, "rbxassetid://110253665387820", 1, false)
    local pourSound = AudioService.ConstructAudioCue(parent, "rbxassetid://9114612188", 1, false)
    local notReadySound = AudioService.ConstructAudioCue(parent, "rbxassetid://90524619811521", 1, false)
    local customerServeSound = AudioService.ConstructAudioCue(parent, "rbxassetid://135165335432475", 1, false)
    local dialogueSound = AudioService.ConstructAudioCue(parent, CUSTOMER_DIALOGUE_SOUND_ID, 1, false)
    dialogueSound.PlaybackSpeed = 1

    return {
        blendSound = blendSound,
        dingSound = dingSound,
        pourSound = pourSound,
        notReadySound = notReadySound,
        customerServeSound = customerServeSound,
        dialogueSound = dialogueSound,
    }
end

-- Dynamically adjust volume based on the blades RPM / blend strength.
function AudioService.UpdateBlendGroup(group: { blendSound: Sound }, blendStrength: number)
    local targetVolume = math.clamp(blendStrength / 20, 0, 1)
    group.blendSound.Volume = targetVolume
    group.blendSound.PlaybackSpeed = 0.5 + (blendStrength / 25)
end

return AudioService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">BadCustomerBehavior</string>
            <string name="Source"><![CDATA[--!strict
-- CustomerService owns claims/queue/economy. This helper only runs cancellable routes/physics.
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BadCustomers)
local Walk = require(script.Parent.CustomerWalk)
local Placement = require(script.Parent.CustomerPlacement)
local RunService = game:GetService("RunService")
local Behavior = {}

local function route(record: any, context: any, name: string, finished: () -> ())
    if not context.Valid() then
        return
    end
    local marker = context.Marker(name)
    if not marker then
        finished()
        return
    end
    Walk.Move(record, Placement.AtMarker(marker, record.BottomOffset), function(reached)
        if not context.Valid() then
            return
        end
        if reached then
            finished()
        else
            context.Destroy()
        end
    end)
end

function Behavior.Thief(record: any, context: any)
    task.delay(Config.BehaviorTimeout, function()
        if context.Valid() then
            context.Destroy()
        end
    end)
    local function escape()
        if not context.Valid() then
            return
        end
        record.State = "Escaping"
        route(record, context, "CustomerWait2", context.Exit)
    end
    if record.State == "Escaping" then
        escape()
        return
    end
    if not context.Marker("CustomerThiefPoint") then
        if RunService:IsStudio() then
            warn("[Customer] Missing CustomerThiefPoint; skipping theft")
        end
        escape()
        return
    end
    route(record, context, "CustomerThiefPoint", function()
        task.delay(Config.TheftWindup, function()
            if context.Valid() and record.State == "Stealing" then
                context.Theft()
                escape()
            end
        end)
    end)
end

function Behavior.Reject(record: any, context: any, ragdoll: any)
    local model, root = record.Model, record.Root
    local tuning = Config.Reject
    local ok, enabled = pcall(function()
        return ragdoll.SetRagdolled(model, true)
    end)
    if not ok or enabled ~= true then
        context.Destroy()
        return
    end
    local started = os.clock()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { model }
    params.RespectCanCollide = true
    local function poll()
        if not context.Valid() then
            return
        end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if
            not root.Parent
            or not humanoid
            or humanoid.Health <= 0
            or root.Position.Y <= workspace.FallenPartsDestroyHeight + 10
            or os.clock() - started >= tuning.LandingTimeout
        then
            context.Destroy()
            return
        end
        local floor = workspace:Raycast(
            root.Position,
            Vector3.new(0, -(record.BottomOffset + tuning.LandingClearance), 0),
            params
        )
        if os.clock() - started >= tuning.MinimumFlight and root.AssemblyLinearVelocity.Y <= 3 and floor then
            task.delay(tuning.RecoveryDelay, function()
                if not context.Valid() then
                    return
                end
                local restored, result = pcall(function()
                    return ragdoll.SetRagdolled(model, false)
                end)
                if not restored or result ~= true then
                    context.Destroy()
                    return
                end
                RunService.Heartbeat:Once(function()
                    if context.Valid() then
                        record.Recovering = false
                        context.Exit()
                    end
                end)
            end)
        else
            task.delay(tuning.LandingPoll, poll)
        end
    end
    RunService.Heartbeat:Once(function()
        if not context.Valid() then
            return
        end
        local launched = pcall(function()
            root:SetNetworkOwner(nil)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.new(tuning.TumbleSpeed, 0, tuning.TumbleSpeed / 2)
            local look = root.CFrame.LookVector
            local away = Vector3.new(look.X, 0, look.Z)
            local direction = if away.Magnitude > 0.001 then away.Unit else Vector3.new(0, 0, -1)
            -- Dedicated rejection tuning must not inherit ordinary combat's speed cap.
            local mass = root.AssemblyMass
            if not root.Anchored and mass > 0 and mass < math.huge then
                root:ApplyImpulse(
                    (direction * tuning.LaunchHorizontal + Vector3.new(0, tuning.LaunchVertical, 0)) * mass
                )
            end
        end)
        if not launched then
            context.Destroy()
            return
        end
        poll()
    end)
    task.delay(tuning.LandingTimeout, function()
        if context.Valid() and record.Recovering then
            context.Destroy()
        end
    end)
end

return Behavior
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">BatKnockback</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BatConfig)
local BatKnockback = {}

-- Player launches borrow server simulation only around the initial impulse.
-- The returned release is also called by combat death/reset/recovery cleanup.
function BatKnockback.TakeOwnership(root: BasePart): (() -> ())?
    if root.Anchored or not root:CanSetNetworkOwnership() then
        return nil
    end
    local automatic, owner = root:GetNetworkOwnershipAuto(), root:GetNetworkOwner()
    root:SetNetworkOwner(nil)
    local released = false
    return function()
        if released then
            return
        end
        released = true
        local ok, problem = pcall(function(): string?
            if not root:IsDescendantOf(workspace) or not root:CanSetNetworkOwnership() then
                return nil
            end
            -- Do not overwrite a later explicit handoff by another system.
            if root:GetNetworkOwnershipAuto() or root:GetNetworkOwner() ~= nil then
                return nil
            end
            if automatic or (owner and owner.Parent ~= game:GetService("Players")) then
                root:SetNetworkOwnershipAuto()
            else
                root:SetNetworkOwner(owner)
            end
            return nil
        end)
        if not ok then
            warn("[Bat] Ownership restoration failed: " .. tostring(problem))
        end
    end
end

function BatKnockback.Direction(attackerRoot: BasePart, root: BasePart): Vector3
    local delta = root.Position - attackerRoot.Position
    local away = Vector3.new(delta.X, 0, delta.Z)
    if away.Magnitude < 0.001 then
        local forward = attackerRoot.CFrame.LookVector
        away = Vector3.new(forward.X, 0, forward.Z)
    end
    return if away.Magnitude > 0.001 then away.Unit else Vector3.new(0, 0, -1)
end

function BatKnockback.Apply(
    root: BasePart,
    away: Vector3,
    tuning: { HorizontalKnockback: number, VerticalKnockback: number }?,
    scale: number?
)
    local mass = root.AssemblyMass
    if not root.Anchored and mass > 0 and mass < math.huge then
        local horizontal = if tuning then tuning.HorizontalKnockback else Config.Knockback.HorizontalSpeed
        local vertical = if tuning then tuning.VerticalKnockback else Config.Knockback.UpwardSpeed
        horizontal *= scale or 1
        vertical *= scale or 1
        -- Direction is already a horizontal unit vector; do not normalize the combined launch.
        local velocity = away * horizontal + Vector3.new(0, vertical, 0)
        if tuning then
            local current = root.AssemblyLinearVelocity
            local planar = Vector3.new(current.X, 0, current.Z)
            local launched = planar + away * horizontal
            if launched.Magnitude > (Config.Knockback.MaxHorizontalSpeed * (scale or 1)) then
                launched = launched.Unit * (Config.Knockback.MaxHorizontalSpeed * (scale or 1))
            end
            -- Bound only upward accumulation. Real falling speed still reaches FallDamageService.
            local upward = math.min(current.Y + vertical, (Config.Knockback.MaxUpwardSpeed * (scale or 1)))
            velocity = launched - planar + Vector3.new(0, upward - current.Y, 0)
        end
        root:ApplyImpulse(velocity * mass)
    end
end

return BatKnockback
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">BlendService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local HttpService = game:GetService("HttpService")
local Economy = require(Shared.Constants.Economy)
local Types = require(Shared.Types)
local Item = require(Shared.IngredientItem)
local WorldUtil = require(script.Parent.WorldUtil)
local Film = require(script.Parent.FilmingUtil)
local SmoothieItem = require(script.Parent.SmoothieItem)
local BlendService = {}
local MovementService = require(script.Parent.MovementService)
local deps: any
local ingredientAccepted = Instance.new("BindableEvent")
local RunService = game:GetService("RunService")
local observers: { RBXScriptConnection } = {}
local nextNotificationToken = 0
local function observerCount(): number
    for index = #observers, 1, -1 do
        if not observers[index].Connected then
            table.remove(observers, index)
        end
    end
    return #observers
end
local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[BlendService] " .. message)
    end
end

-- One canonical color calculation for both the developing liquid and final cup.
local function batchColor(ids: { string }): Color3?
    if #ids == 0 then
        return nil
    end
    local sum = Vector3.zero
    for _, id in ids do
        local color = deps.IngredientService.GetDefinition(id).BlendColor
        sum += Vector3.new(color.R, color.G, color.B)
    end
    sum /= #ids
    return Color3.new(sum.X, sum.Y, sum.Z)
end

type Batch = {
    IngredientItems: { Types.IngredientItem },
    NotificationToken: number,
    State: Types.BlendState,
    Ingredients: { string },
    Progress: number,
    Result: Types.Smoothie?,
    NextProgressPresentationAt: number,
    NextRejectionAt: number,
    NeedsItemsUntil: number,
    Dispensing: boolean,
}
local batches: { [string]: Batch } = {}
local function key(player: Player): string
    return deps.TycoonService.GetSessionId(player) or ""
end
local function authorized(player: Player, context: any): boolean
    return MovementService.CanPerformGameplayAction(player)
        and deps.TycoonService.ValidateActor(player, context or deps.TycoonService.GetRequestContext(player))
end

function BlendService.ObserveIngredientAccepted(callback: (Player, string, CFrame, number) -> ()): RBXScriptConnection
    local connection = ingredientAccepted.Event:Connect(function(sessionId, id, at, index, token)
        -- BindableEvents COPY tables. Compare a scalar token, never table identity.
        local batch = batches[sessionId]
        local owner = deps.TycoonService.GetSessionOwner(sessionId)
        if owner and batch and batch.NotificationToken == token then
            callback(owner, id, at, index)
        else
            diagnostic("accepted notify skipped stale batch ingredient=" .. id)
        end
    end)
    table.insert(observers, connection)
    diagnostic("ingredient observer connected observers=" .. tostring(observerCount()))
    return connection
end

local function publish(player: Player)
    local id = key(player)
    local batch = batches[id]
    if not batch then
        return
    end
    for _, member in deps.TycoonService.GetMembers(id) do
        member:SetAttribute("BlendColor", if batch.Result then batch.Result.Color else batchColor(batch.Ingredients))
        member:SetAttribute("BlendState", batch.State)
        member:SetAttribute("BlendProgress", batch.Progress)
        member:SetAttribute("BlendIngredientCount", #batch.Ingredients)
        member:SetAttribute(
            "BlendNeedsItems",
            #batch.Ingredients < Economy.MaxIngredients and os.clock() < batch.NeedsItemsUntil
        )
    end
end
function BlendService.BindPlayer(player: Player)
    publish(player)
end
local function copyResult(result: Types.Smoothie): Types.Smoothie
    return {
        BlendId = result.BlendId,
        Ingredients = table.clone(result.Ingredients),
        IngredientItems = Item.CopyAll(result.IngredientItems),
        Tags = table.clone(result.Tags),
        Color = result.Color,
        Discovery = result.Discovery,
    }
end
function BlendService.Init(services)
    deps = services
end
function BlendService.Reset(player: Player)
    if key(player) == "" then
        return
    end
    nextNotificationToken += 1
    batches[key(player)] = {
        NotificationToken = nextNotificationToken,
        State = "EMPTY",
        Ingredients = {},
        IngredientItems = {},
        Progress = 0,
        Result = nil,
        NextProgressPresentationAt = 0,
        NextRejectionAt = 0,
        NeedsItemsUntil = 0,
        Dispensing = false,
    }
    publish(player)
    Film.Log("Blend", "reset")
end
function BlendService.GetSnapshot(player: Player): {
    BatchId: number,
    AcceptedIngredientCount: number,
    ReadyToDispense: boolean,
    ProgressPercent: number,
    State: Types.BlendState,
    Ingredients: { string },
    IngredientItems: { Types.IngredientItem }?,
    Progress: number,
    Result: Types.Smoothie?,
}?
    local batch = batches[key(player)]
    if not batch then
        return nil
    end
    return {
        BatchId = batch.NotificationToken,
        ProgressPercent = math.clamp(batch.Progress / Economy.RequiredProgress * 100, 0, 100),
        AcceptedIngredientCount = #batch.Ingredients,
        ReadyToDispense = batch.State == "COMPLETE"
            and batch.Progress >= Economy.RequiredProgress
            and batch.Result ~= nil,
        State = batch.State,
        Ingredients = table.clone(batch.Ingredients),
        IngredientItems = Item.CopyAll(batch.IngredientItems),
        Progress = batch.Progress,
        Result = if batch.Result then copyResult(batch.Result) else nil,
    }
end
function BlendService.TryInput(player: Player, object: Instance, input: BasePart, context: any): boolean
    local batch = batches[key(player)]
    local record = deps.IngredientService.GetRecord(object)
    local part = WorldUtil.Part(object)
    if
        not batch
        or not authorized(player, nil)
        or (batch.State ~= "EMPTY" and batch.State ~= "LOADING" and batch.State ~= "READY")
        or #batch.Ingredients >= Economy.MaxIngredients
        or not record
        or object:GetAttribute("FrozenUntilPickup") == true
        or (record.Owner ~= nil and record.Owner ~= player)
        or (record.Owner == nil and not record.Claimable)
        or not part
        or not deps.TycoonService.IsMember(player, input)
        or not authorized(player, context)
        or deps.TycoonService.GetReference(player, "BlenderInput") ~= input
    then
        return false
    end
    -- Check actual overlap on the server, not only a client-influenced Touched signal.
    local overlaps = false
    for _, touching in workspace:GetPartsInPart(input) do
        if deps.IngredientService.Resolve(touching) == object then
            overlaps = true
            break
        end
    end
    if not overlaps then
        return false
    end
    local acceptedAt = part.CFrame
    local token = deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not token then
        return false
    end
    local id = deps.IngredientService.Consume(object)
    if not id then
        deps.TycoonService.EndTransaction(token)
        return false
    end
    table.insert(batch.Ingredients, id)
    table.insert(batch.IngredientItems, record.Item)
    Film.Log("Blend", string.format("%s accepted (%d/3)", id, #batch.Ingredients))
    batch.State = if #batch.Ingredients == Economy.MaxIngredients then "READY" else "LOADING"
    publish(player)
    Film.Log("Blend", batch.State)
    diagnostic("accepted notify ingredient=" .. id .. " observers=" .. tostring(observerCount()))
    if deps.TutorialService then
        deps.TutorialService.Mark(player, "LoadedBlender")
    end
    ingredientAccepted:Fire(token, id, acceptedAt, #batch.Ingredients, batch.NotificationToken)
    deps.TycoonService.EndTransaction(token)
    return true
end
function BlendService.Ready(player: Player): boolean
    local batch = batches[key(player)]
    if
        not batch
        or not authorized(player, nil)
        or #batch.Ingredients < Economy.MaxIngredients
        or (batch.State ~= "LOADING" and batch.State ~= "READY")
    then
        return false
    end
    batch.State = "READY"
    publish(player)
    Film.Log("Blend", "READY")
    return true
end
local function makeResult(ids: { string }, items: { Types.IngredientItem }): Types.Smoothie
    local tags = {}
    for _, id in ids do
        local definition = deps.IngredientService.GetDefinition(id)
        for _, tag in definition.Tags do
            if not table.find(tags, tag) then
                table.insert(tags, tag)
            end
        end
    end
    return {
        BlendId = HttpService:GenerateGUID(false),
        Ingredients = table.clone(ids),
        IngredientItems = Item.CopyAll(items),
        Tags = tags,
        Color = batchColor(ids) :: Color3,
        -- Retained for compatibility with existing smoothie consumers.
        Discovery = nil,
    }
end
-- Server Heartbeat reports measured physical spin. No progress remote exists.
local function addProgress(player: Player, wheel: BasePart, delta: number, context: any): boolean
    local batch = batches[key(player)]
    if
        not batch
        or not authorized(player, nil)
        or not deps.TycoonService.IsMember(player, wheel)
        or not authorized(player, context)
        or delta ~= delta
        or delta <= 0
        or delta == math.huge
    then
        return false
    end
    -- This private count is the source of BlendIngredientCount. Never authorize
    -- a start from replicated attributes or mutate an underfilled batch.
    if #batch.Ingredients < Economy.MaxIngredients then
        if
            (batch.State == "EMPTY" or batch.State == "LOADING" or batch.State == "READY")
            and os.clock() >= batch.NextRejectionAt
        then
            -- Heartbeat must not continually extend the transient feedback.
            batch.NextRejectionAt = os.clock() + 2.5
            batch.NeedsItemsUntil = os.clock() + 1.75
            local rejectionAt = batch.NextRejectionAt
            local sessionId = key(player)
            for _, member in deps.TycoonService.GetMembers(sessionId) do
                member:SetAttribute("BlendNeedsItems", true)
            end
            task.delay(1.75, function()
                if batches[sessionId] == batch and batch.NextRejectionAt == rejectionAt then
                    batch.NeedsItemsUntil = 0
                    for _, member in deps.TycoonService.GetMembers(sessionId) do
                        member:SetAttribute("BlendNeedsItems", false)
                    end
                end
            end)
        end
        return false
    end
    if batch.State == "LOADING" then
        BlendService.Ready(player)
    end
    if batch.State ~= "READY" and batch.State ~= "BLENDING" then
        return false
    end
    if batch.State == "READY" then
        batch.State = "BLENDING"
        publish(player)
        Film.Emit(player, "BlendStarted", { IngredientIds = table.clone(batch.Ingredients) })
        Film.Log("Blend", "BLENDING")
    end
    -- Physical spin is measured for the shared batch, with no individual input actor.
    -- Credit only living nearby members, including the teammate, after accepted progress.
    if deps.TutorialService then
        for _, member in deps.TycoonService.GetMembers(key(player)) do
            if WorldUtil.Near(member, wheel, 12) then
                deps.TutorialService.Mark(member, "UsedTurbine")
            end
        end
    end
    local oldProgress = batch.Progress
    batch.Progress = math.min(Economy.RequiredProgress, batch.Progress + delta)
    local now = os.clock()
    if
        batch.Progress > oldProgress
        and (now >= batch.NextProgressPresentationAt or batch.Progress >= Economy.RequiredProgress)
    then
        batch.NextProgressPresentationAt = now + 0.1
        Film.Emit(player, "BlendProgressChanged", { Progress = batch.Progress })
    end
    if math.floor(oldProgress / 10) ~= math.floor(batch.Progress / 10) then
        Film.Log("Blend", string.format("progress %.0f", batch.Progress))
    end
    if batch.Progress >= Economy.RequiredProgress then
        batch.State = "COMPLETE"
        local result = makeResult(batch.Ingredients, batch.IngredientItems)
        batch.Result = result
        Film.Emit(player, "BlendCompleted", {
            BlendId = result.BlendId,
            Color = result.Color,
            IngredientIds = table.clone(result.Ingredients),
            RecipeId = result.Discovery,
        })
        Film.Log(
            "Blend",
            string.format("COMPLETE color=(%.3f,%.3f,%.3f)", result.Color.R, result.Color.G, result.Color.B)
        )
        deps.PlayerDataService.IncrementStat(player, "SmoothiesMade")
    end
    publish(player)
    return true
end
function BlendService.AddProgress(player: Player, wheel: BasePart, delta: number, context: any): boolean
    local token = deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not token then
        return false
    end
    local result = addProgress(player, wheel, delta, context)
    deps.TycoonService.EndTransaction(token)
    return result
end
function BlendService.GetCup(player: Player, requested: Instance?): Types.Smoothie?
    local data = deps.InventoryService.GetHeldSmoothie(player, requested)
    return if data then SmoothieItem.Result(data) else nil
end
function BlendService.ConsumeCup(player: Player): Types.Smoothie?
    local data = deps.InventoryService.ConsumeHeldSmoothie(player)
    return if data then SmoothieItem.Result(data) else nil
end
function BlendService.Dispense(player: Player, button: BasePart, context: any): (boolean, string?)
    local batch = batches[key(player)]
    if not batch or batch.State ~= "COMPLETE" or not batch.Result or batch.Dispensing then
        return false, "Not ready"
    end
    if
        not deps.TycoonService.IsMember(player, button)
        or not authorized(player, context)
        or not WorldUtil.Near(player, button, Economy.InteractionDistance)
    then
        return false, "Not your blender or too far"
    end
    if deps.InventoryService.GetCarryCount(player) >= deps.InventoryService.GetCarryCapacity(player) then
        return false, "Inventory full"
    end
    local data: Types.SmoothieData = {
        BlendId = batch.Result.BlendId :: string,
        Ingredients = table.clone(batch.Result.Ingredients),
        IngredientItems = Item.CopyAll(batch.Result.IngredientItems),
    }
    -- Grant is synchronous. Guard signals from equip/presentation against a
    -- reentrant dispense of this same batch, including while it is still COMPLETE.
    local sessionId =
        deps.TycoonService.BeginTransaction(player, context or deps.TycoonService.GetRequestContext(player))
    if not sessionId then
        return false, "StaleSession"
    end
    batch.Dispensing = true
    local granted = deps.InventoryService.GrantSmoothie(player, data)
    batch.Dispensing = false
    if not granted then
        deps.TycoonService.EndTransaction(sessionId)
        return false, "Cannot carry smoothie"
    end
    if deps.TutorialService then
        deps.TutorialService.Mark(player, "DispensedSmoothie")
    end
    batch.State = "DISPENSED"
    publish(player)
    task.defer(function()
        local owner = deps.TycoonService.GetSessionOwner(sessionId)
        if owner and batches[sessionId] == batch then
            BlendService.Reset(owner)
        end
    end)
    Film.Emit(player, "SmoothieDispensed", { BlendId = data.BlendId, Color = batch.Result.Color })
    Film.Log("Blend", "DISPENSED blend=" .. data.BlendId)
    deps.TycoonService.EndTransaction(sessionId)
    return true
end
function BlendService.CleanupSession(sessionId: string)
    batches[sessionId] = nil
end
function BlendService.RemovePlayer(player: Player)
    player:SetAttribute("BlendState", "EMPTY")
    player:SetAttribute("BlendProgress", 0)
    player:SetAttribute("BlendIngredientCount", 0)
    player:SetAttribute("BlendColor", nil)
    player:SetAttribute("BlendNeedsItems", false)
end
return require(script.Parent.StudioServices).Wrap("BlendService", BlendService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">BlenderVacuumPhysics</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BlenderVacuum)
local Physics = {}

local function clampMagnitude(value: Vector3, limit: number): Vector3
    return if value.Magnitude > limit then value.Unit * limit else value
end

function Physics.Steer(velocity: Vector3, position: Vector3, target: Vector3, radius: number, dt: number): Vector3
    local offset = target - position
    local horizontal = Vector3.new(offset.X, 0, offset.Z)
    local proximity = 1 - math.clamp(horizontal.Magnitude / math.max(radius, 0.01), 0, 1)
    local strength = Config.EdgeStrength + (1 - Config.EdgeStrength) * proximity
    local desired =
        clampMagnitude(horizontal * Config.CenteringStrength + Vector3.new(0, -Config.DownwardBias, 0), Config.MaxSpeed)
    local step = math.clamp(dt, 0, Config.MaxStep)
    local delta = (desired - velocity) * (1 - math.exp(-Config.PullStrength * strength * step))
    return velocity + clampMagnitude(delta, Config.MaxAcceleration * step)
end

-- Side-facing openings reuse bounded velocity steering without blender's downward bias.
function Physics.SteerToward(
    velocity: Vector3,
    position: Vector3,
    target: Vector3,
    radius: number,
    dt: number,
    tuning: any
): Vector3
    local offset = target - position
    local proximity = 1 - math.clamp(offset.Magnitude / math.max(radius, 0.01), 0, 1)
    local strength = tuning.EdgeStrength + (1 - tuning.EdgeStrength) * proximity
    local desired = clampMagnitude(offset * tuning.CenteringStrength, tuning.MaxSpeed)
    local step = math.clamp(dt, 0, tuning.MaxStep)
    local delta = (desired - velocity) * (1 - math.exp(-tuning.PullStrength * strength * step))
        + Vector3.new(0, workspace.Gravity * step, 0)
    return velocity + clampMagnitude(delta, tuning.MaxAcceleration * step)
end

return Physics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">CharacterPhysicsService</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local PlayerOnlyCollisionService = require(script.Parent.PlayerOnlyCollisionService)
local CharacterPhysicsService = {}

-- Enable before spawning in Studio; never prints in live servers.
local DEBUG = true
local ROOT_SIZE = Vector3.new(2, 2, 1)
-- 4 cubic studs * density 4 = 16 mass units, independent of avatar mesh volume.
local ROOT_PHYSICS = PhysicalProperties.new(4, 0.3, 0, 1, 1)
local BODY_PHYSICS = PhysicalProperties.new(0.7, 0.3, 0, 1, 1)
local BODY_NAMES: { [string]: boolean } = {}
for _, name in
    {
        "Head",
        "UpperTorso",
        "LowerTorso",
        "LeftUpperArm",
        "LeftLowerArm",
        "LeftHand",
        "RightUpperArm",
        "RightLowerArm",
        "RightHand",
        "LeftUpperLeg",
        "LeftLowerLeg",
        "LeftFoot",
        "RightUpperLeg",
        "RightLowerLeg",
        "RightFoot",
        "Torso",
        "Left Arm",
        "Right Arm",
        "Left Leg",
        "Right Leg",
    }
do
    BODY_NAMES[name] = true
end
type State = { Character: Model, Connections: { RBXScriptConnection }, Started: boolean }
local states: { [Player]: State } = {}

function CharacterPhysicsService.RemovePlayer(player: Player)
    local state = states[player]
    if state then
        for _, connection in state.Connections do
            connection:Disconnect()
        end
        states[player] = nil
    end
end

-- Called by bootstrap's existing CharacterAdded path; appearance loading must finish
-- before reading its description, otherwise Roblox can overwrite the scales later.
function CharacterPhysicsService.ApplyCharacter(player: Player, character: Model, onReady: ((Model) -> ())?)
    if states[player] and states[player].Character == character then
        return
    end
    CharacterPhysicsService.RemovePlayer(player)
    local state: State = { Character = character, Connections = {}, Started = false }
    states[player] = state
    local function current(): boolean
        return states[player] == state and player.Character == character
    end
    local function normalizePart(instance: Instance)
        if not current() or not instance:IsA("BasePart") or not instance:IsDescendantOf(character) then
            return
        end
        -- Only avatar body parts and cosmetics are ours. Tools and server-authored
        -- gameplay parts retain their own physics, including nested Tool parts.
        if instance:FindFirstAncestorWhichIsA("Tool") then
            return
        end
        local accessory = instance:FindFirstAncestorWhichIsA("Accessory")
        if accessory and accessory.Parent == character then
            if accessory:GetAttribute("PreserveGameplayPhysics") == true then
                return
            end
            instance.CollisionGroup = PlayerOnlyCollisionService.PlayerGroup
            instance.Massless = true
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = false
            instance.RootPriority = -127
        elseif instance.Parent == character and instance.Name == "HumanoidRootPart" then
            instance.CollisionGroup = PlayerOnlyCollisionService.PlayerGroup
            instance.Size = ROOT_SIZE
            instance.Massless = false
            instance.RootPriority = 127
            instance.CustomPhysicalProperties = ROOT_PHYSICS
            instance.CanCollide = false
            instance.CanTouch = false
            instance.CanQuery = true
        elseif instance.Parent == character and BODY_NAMES[instance.Name] then
            instance.CollisionGroup = PlayerOnlyCollisionService.PlayerGroup
            instance.Massless = true
            instance.RootPriority = 0
            instance.CustomPhysicalProperties = BODY_PHYSICS
            -- Retain Roblox's body collision/state-machine behavior. In particular,
            -- collidable torso/head parts must keep physically driving the turbine.
            -- Forcing limb collisions adds snagging; disabling torso collisions removes pushing.
        end
    end
    local function scan()
        for _, instance in character:GetDescendants() do
            normalizePart(instance)
        end
    end
    table.insert(
        state.Connections,
        character.DescendantAdded:Connect(function(instance)
            -- Defer until a newly inserted accessory's hierarchy is fully parented.
            task.defer(normalizePart, instance)
        end)
    )
    table.insert(
        state.Connections,
        player.CharacterRemoving:Connect(function(removing)
            if removing == character and states[player] == state then
                CharacterPhysicsService.RemovePlayer(player)
            end
        end)
    )
    scan()

    local function finish(appearanceSource: string)
        if not current() or state.Started then
            return
        end
        state.Started = true
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 10)
            local root = character:WaitForChild("HumanoidRootPart", 10)
            if not current() then
                return
            end
            if not humanoid or not humanoid:IsA("Humanoid") or not root or not root:IsA("BasePart") then
                warn("[CharacterPhysics] Missing Humanoid/root for " .. player.Name)
                return
            end
            if humanoid.RigType == Enum.HumanoidRigType.R15 then
                local ok, problem = pcall(function()
                    local description = humanoid:GetAppliedDescription()
                    -- Keep the loaded avatar's assets/cosmetics, but remove the
                    -- taller/slender body morph independently of dimensional scale.
                    -- Head is a collidable body part: its scale affects clearance too.
                    local changed = description.HeightScale ~= 1
                        or description.WidthScale ~= 1
                        or description.DepthScale ~= 1
                        or description.HeadScale ~= 1
                        or description.BodyTypeScale ~= 0
                        or description.ProportionScale ~= 0
                    description.HeightScale = 1
                    description.WidthScale = 1
                    description.DepthScale = 1
                    description.HeadScale = 1
                    description.BodyTypeScale = 0
                    description.ProportionScale = 0
                    humanoid.AutomaticScalingEnabled = true
                    if changed then
                        -- At most one application per spawn. No heartbeat reapplication.
                        local applied, reason = pcall(function()
                            humanoid:ApplyDescriptionAsync(description)
                        end)
                        description:Destroy()
                        if not applied then
                            error(tostring(reason))
                        end
                    else
                        description:Destroy()
                    end
                end)
                if not ok and current() then
                    warn(
                        "[CharacterPhysics] Scale normalization failed for " .. player.Name .. ": " .. tostring(problem)
                    )
                end
            end
            -- R6 receives mass/accessory handling but no R15 scaling or rig conversion.
            if not current() then
                return
            end
            scan() -- Description application can resize the root and replace body parts.
            if onReady then
                onReady(character)
            end
            -- Read back after the yielding application and a simulation step, not
            -- from the requested description. Never reapply in response to this check.
            RunService.Heartbeat:Wait()
            if not current() then
                return
            end
            if DEBUG and RunService:IsStudio() then
                local count = 0
                for _, instance in character:GetDescendants() do
                    if instance:IsA("BasePart") then
                        local accessory = instance:FindFirstAncestorWhichIsA("Accessory")
                        if
                            accessory
                            and accessory.Parent == character
                            and not instance:FindFirstAncestorWhichIsA("Tool")
                            and accessory:GetAttribute("PreserveGameplayPhysics") ~= true
                        then
                            count += 1
                        end
                    end
                end
                local function scale(name: string): string
                    local value = humanoid:FindFirstChild(name)
                    return if value and value:IsA("NumberValue") then tostring(value.Value) else "n/a"
                end
                local appliedRoot = character:FindFirstChild("HumanoidRootPart")
                if appliedRoot and appliedRoot:IsA("BasePart") then
                    local _, boundingSize = character:GetBoundingBox()
                    local final = humanoid:GetAppliedDescription()
                    local finalScales = if humanoid.RigType == Enum.HumanoidRigType.R15
                        then string.format(
                            "HeightScale=%.3f WidthScale=%.3f DepthScale=%.3f HeadScale=%.3f BodyTypeScale=%.3f ProportionScale=%.3f",
                            final.HeightScale,
                            final.WidthScale,
                            final.DepthScale,
                            final.HeadScale,
                            final.BodyTypeScale,
                            final.ProportionScale
                        )
                        else "R6 scales=n/a"
                    final:Destroy()
                    print(
                        string.format(
                            "[CharacterPhysics] FINAL player=%s rig=%s appearance=%s description={%s} liveScales(H/W/D/Head/Type/Proportion)=%s/%s/%s/%s/%s/%s boundingSize=%s rootMass=%.3f assemblyMass=%.3f cosmeticParts=%d",
                            player.Name,
                            humanoid.RigType.Name,
                            appearanceSource,
                            finalScales,
                            scale("BodyHeightScale"),
                            scale("BodyWidthScale"),
                            scale("BodyDepthScale"),
                            scale("HeadScale"),
                            scale("BodyTypeScale"),
                            scale("BodyProportionScale"),
                            tostring(boundingSize),
                            appliedRoot:GetMass(),
                            appliedRoot.AssemblyMass,
                            count
                        )
                    )
                end
            end
        end)
    end
    table.insert(
        state.Connections,
        player.CharacterAppearanceLoaded:Connect(function(loaded)
            if loaded == character then
                finish("CharacterAppearanceLoaded")
            end
        end)
    )
    -- Connect first, then check: covers appearances loaded before bootstrap as well
    -- as the event/check race. Started is set before yielding to prevent duplicates.
    if player:HasAppearanceLoaded() then
        finish("HasAppearanceLoaded")
    elseif not player.LoadCharacterAppearance then
        finish("LoadCharacterAppearance=false")
    end
end

return CharacterPhysicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.BatConfig)
local GameplaySfx = require(script.Parent.GameplaySfxService)
local Knockback = require(script.Parent.BatKnockback)
local CombatService = {}
local deps: any
type Weapon = { Tool: Tool, Scale: number }
type EquippedBat = {
    Character: Model?,
    Weapon: Weapon?,
    RuntimeTool: Instance?,
    Tool: Tool?,
    Handle: Instance?,
    Hitbox: Instance?,
    IsUnderCharacter: boolean,
    IssuedValidation: boolean,
}
type Stun = { Character: Model, Until: number, ImmuneUntil: number, ReleaseOwnership: (() -> ())? }
local weapons: { [Player]: Weapon? } = {}
local attackAt: { [Player]: number } = {}
local swings: { [Player]: {} } = {}
local stuns: { [Player]: Stun } = {}
local characters: { [Player]: {} } = {}
local removals: { [Player]: RBXScriptConnection } = {}
local deaths: { [Player]: RBXScriptConnection } = {}
local backpackWatches: { [Player]: RBXScriptConnection } = {}

-- Arm on the server for one request; silent by default and always disabled outside Studio.
local function swingTrace(player: Player): (string) -> ()
    local enabled = RunService:IsStudio() and player:GetAttribute("BatDebugNextSwing") == true
    if enabled then
        player:SetAttribute("BatDebugNextSwing", nil)
    end
    return function(message: string)
        if enabled then
            print("[Bat] " .. player.Name .. " " .. message)
        end
    end
end

function CombatService.TraceRejectedSwing(player: Player, reason: string)
    swingTrace(player)("SwingBat rejected: " .. reason)
end

local function alive(player: Player): (Model?, BasePart?)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if player.Parent ~= Players or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        return nil, nil
    end
    return character, root
end
local function levelFor(player: Player): number
    return deps.TycoonService.GetUpgrade(player, "Bat") - 1
end
-- Physical failures must never strand authoritative gameplay stun.
local function setRagdolled(character: Model, enabled: boolean): boolean
    local ok, result = pcall(function()
        return deps.RagdollService.SetRagdolled(character, enabled)
    end)
    if not ok or result ~= true then
        warn("[Bat] Ragdoll " .. (if enabled then "ON" else "OFF") .. " failed: " .. tostring(result))
        return false
    end
    return true
end
local function clearStun(player: Player)
    local state = stuns[player]
    stuns[player] = nil
    if state then
        state.Character:SetAttribute("BatStunned", nil)
        state.Character:SetAttribute("BatImmuneUntil", nil)
        setRagdolled(state.Character, false)
        if state.ReleaseOwnership then
            state.ReleaseOwnership()
        end
    end
    deps.MovementService.SetStunned(player, false)
    player:SetAttribute("StunnedUntil", 0)
end
local function intact(tool: Tool): boolean
    local handle = tool:FindFirstChild("Handle")
    local hitbox = tool:FindFirstChild("Hitbox")
    return handle ~= nil and handle:IsA("BasePart") and hitbox ~= nil and hitbox:IsA("BasePart")
end
local function resolveEquippedBat(player: Player): EquippedBat
    local character = player.Character
    local runtimeTool = if character then character:FindFirstChild("Bat") else nil
    local tool: Tool? = if runtimeTool and runtimeTool:IsA("Tool") then runtimeTool :: Tool else nil
    local weapon = weapons[player]
    local isUnderCharacter = character ~= nil and runtimeTool ~= nil and runtimeTool.Parent == character
    return {
        Character = character,
        Weapon = weapon,
        RuntimeTool = runtimeTool,
        Tool = tool,
        Handle = if tool then tool:FindFirstChild("Handle") else nil,
        Hitbox = if tool then tool:FindFirstChild("Hitbox") else nil,
        IsUnderCharacter = isUnderCharacter,
        IssuedValidation = weapon ~= nil and tool ~= nil and weapon.Tool == tool and isUnderCharacter,
    }
end
local function removeWeapon(player: Player)
    local weapon: Weapon? = weapons[player]
    weapons[player] = nil
    if weapon then
        weapon.Tool:Destroy()
    end
end
-- Tool.Grip is inherited unchanged from the authored template; never rotate mesh/hitbox to fix grip.
-- Scale only the clone. Temporarily release constraints so resizing cannot move the character.
local function configure(weapon: Weapon, level: number)
    local tool = weapon.Tool
    local scale = Config.Levels[level].Scale
    local ratio = scale / weapon.Scale
    local handle = tool:FindFirstChild("Handle") :: BasePart
    local parts: { [BasePart]: CFrame } = {}
    local constraints: { WeldConstraint } = {}
    for _, object in tool:GetDescendants() do
        if object:IsA("BasePart") then
            parts[object] = handle.CFrame:ToObjectSpace(object.CFrame)
        elseif object:IsA("WeldConstraint") and object.Enabled then
            object.Enabled = false
            table.insert(constraints, object)
        end
    end
    for part, offset in parts do
        part.Size *= ratio
        part.CFrame = handle.CFrame * (CFrame.new(offset.Position * (ratio - 1)) * offset)
        part.Anchored = false
        part.CanCollide = false
        part.CanTouch = false
        part.Massless = true
    end
    for _, object in tool:GetDescendants() do
        if object:IsA("SpecialMesh") then
            object.Scale *= ratio
            object.Offset *= ratio
        elseif object:IsA("Attachment") then
            object.Position *= ratio
        elseif object:IsA("JointInstance") then
            object.C0 = CFrame.new(object.C0.Position * ratio) * object.C0.Rotation
            object.C1 = CFrame.new(object.C1.Position * ratio) * object.C1.Rotation
        end
    end
    for _, constraint in constraints do
        constraint.Enabled = true
    end
    weapon.Scale = scale
    tool:SetAttribute("BatLevel", level)
    tool.CanBeDropped = false
    local hitbox = tool:FindFirstChild("Hitbox") :: BasePart
    hitbox.Transparency = 1
    hitbox.CanQuery = false
end
function CombatService.Init(services)
    deps = services
end
function CombatService.RefreshPlayer(player: Player)
    local level = levelFor(player)
    player:SetAttribute("BatLevel", level)
    local character = alive(player)
    if not character or not Config.Levels[level] or not deps.TycoonService.GetSessionId(player) then
        removeWeapon(player)
        swings[player] = nil
        return
    end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then
        return
    end
    local weapon: Weapon? = weapons[player]
    if weapon and (not intact(weapon.Tool) or (weapon.Tool.Parent ~= backpack and weapon.Tool.Parent ~= character)) then
        removeWeapon(player)
        weapon = nil
    end
    if not weapon then
        local template = ServerStorage:FindFirstChild("Bat")
        local handle = template and template:FindFirstChild("Handle")
        local hitbox = template and template:FindFirstChild("Hitbox")
        if
            not template
            or not template:IsA("Tool")
            or not template.Archivable
            or not handle
            or not handle:IsA("BasePart")
            or not hitbox
            or not hitbox:IsA("BasePart")
        then
            warn("[Bat] Expected archivable ServerStorage.Bat Tool with Handle and Hitbox BaseParts")
            return
        end
        local clone = template:Clone()
        if not intact(clone) then
            clone:Destroy()
            warn("[Bat] Handle and Hitbox must be archivable BaseParts")
            return
        end
        local created: Weapon = {
            Tool = clone,
            Scale = 1,
        }
        local ok, problem = pcall(function(): string?
            configure(created, level)
            return nil
        end)
        if not ok then
            clone:Destroy()
            warn("[Bat] Could not configure ServerStorage.Bat: " .. tostring(problem))
            return
        end
        weapons[player] = created
        clone.Unequipped:Connect(function()
            if weapons[player] == created then
                swings[player] = nil
            end
        end)
        local characterToken = characters[player]
        clone.Destroying:Connect(function()
            local current = weapons[player]
            if current and current.Tool == clone then
                weapons[player] = nil
                swings[player] = nil
                task.defer(function()
                    if characterToken and characters[player] == characterToken and player.Character == character then
                        CombatService.RefreshPlayer(player)
                    end
                end)
            end
        end)
        clone.Parent = backpack
    elseif weapon.Tool:GetAttribute("BatLevel") ~= level then
        local ok, problem = pcall(function(): string?
            configure(weapon, level)
            return nil
        end)
        if not ok then
            removeWeapon(player)
            warn("[Bat] Could not update Bat: " .. tostring(problem))
        end
    end
end
function CombatService.IsBatEquipped(player: Player): boolean
    return resolveEquippedBat(player).IssuedValidation
end

local function swingRejection(player: Player, equipped: EquippedBat?): string?
    local character = alive(player)
    if not character then
        return "attacker not alive"
    end
    equipped = equipped or resolveEquippedBat(player)
    if not equipped.Weapon then
        return "no issued Bat"
    end
    if equipped.Character ~= character or not equipped.IssuedValidation then
        return "issued Bat not equipped"
    end
    if
        not equipped.Handle
        or not equipped.Handle:IsA("BasePart")
        or not equipped.Hitbox
        or not equipped.Hitbox:IsA("BasePart")
    then
        return "missing Handle/Hitbox"
    end
    if not Config.Levels[levelFor(player)] then
        return "Bat level locked"
    end
    if not deps.TycoonService.GetSessionId(player) then
        return "no plot session"
    end
    if not deps.MovementService.CanPerformGameplayAction(player) then
        return "attacker stunned"
    end
    return nil
end
-- Both weapons share current plot/team eligibility; their status immunity stays separate.
local function luckyBuff(player: Player, id: string): boolean
    return deps.LuckyBlockService ~= nil and deps.LuckyBlockService.IsBuffActive(player, id)
end
local function luckyImmune(player: Player): boolean
    return luckyBuff(player, "StarPower") or luckyBuff(player, "Invincibility")
end
local function playerDamageRejection(attacker: Player, victim: Player, allowTeamDamage: boolean?): string?
    if luckyImmune(victim) then
        return "target immune"
    end
    local session = deps.TycoonService.GetSessionId(victim)
    if attacker == victim then
        return "self"
    end
    if not alive(victim) then
        return "target not alive"
    end
    if not session then
        return "target has no plot session"
    end
    if not alive(attacker) or not deps.TycoonService.GetSessionId(attacker) then
        return "attacker has no living plot session"
    end
    if not allowTeamDamage and session == deps.TycoonService.GetSessionId(attacker) then
        return "shared plot session"
    end
    if not allowTeamDamage and not attacker.Neutral and not victim.Neutral and attacker.Team == victim.Team then
        return "non-neutral Roblox teammates"
    end
    return nil
end

function CombatService.CanDamagePlayer(attacker: Player, victim: Player, allowTeamDamage: boolean?): boolean
    return playerDamageRejection(attacker, victim, allowTeamDamage) == nil
end

function CombatService.DamagePlayer(
    attacker: Player,
    victim: Player,
    character: Model,
    damage: number,
    allowTeamDamage: boolean?
): boolean
    if victim.Character ~= character or not CombatService.CanDamagePlayer(attacker, victim, allowTeamDamage) then
        return false
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or character:FindFirstChildOfClass("ForceField") then
        return false
    end
    humanoid:TakeDamage(damage)
    return true
end

local function enemyRejection(attacker: Player, victim: Player): string?
    local reason = playerDamageRejection(attacker, victim)
    if reason then
        return reason
    end
    if (victim.Character :: Model):FindFirstChildOfClass("ForceField") then
        return "target spawn protected"
    end
    local stun = stuns[victim]
    if deps.MovementService.IsStunned(victim) then
        return "target stunned"
    end
    if stun and os.clock() < stun.ImmuneUntil then
        return "target immune"
    end
    return nil
end
local function hit(attacker: Player, victim: Player, level: typeof(Config.Levels[1]))
    if enemyRejection(attacker, victim) then
        return
    end
    local duration = level.StunDuration
    local character = victim.Character :: Model
    local untilTime = os.clock() + duration
    local state: Stun = { Character = character, Until = untilTime, ImmuneUntil = untilTime + Config.ImmunitySeconds }
    stuns[victim] = state
    -- Replicated cosmetic status; existing os.clock deadlines remain authoritative.
    character:SetAttribute("BatImmuneUntil", workspace:GetServerTimeNow() + duration + Config.ImmunitySeconds)
    character:SetAttribute("BatStunned", true)
    victim:SetAttribute("StunnedUntil", untilTime)
    deps.MovementService.SetStunned(victim, true)
    local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
    local attackerRoot = (attacker.Character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
    local away = Knockback.Direction(attackerRoot, root)
    deps.InventoryService.DropCarriedIngredients(victim, "BatStun", away)
    -- Own simulation before requesting Physics; release after a short launch interval.
    local owned, release = pcall(Knockback.TakeOwnership, root)
    if owned then
        state.ReleaseOwnership = release
    else
        warn("[Bat] Ownership acquisition failed: " .. tostring(release))
    end
    local ragdolled = setRagdolled(character, true)
    if ragdolled and state.ReleaseOwnership then
        RunService.Heartbeat:Once(function()
            local releaseOwnership = state.ReleaseOwnership :: () -> ()
            local currentCharacter, currentRoot = alive(victim)
            if
                stuns[victim] ~= state
                or currentCharacter ~= character
                or currentRoot ~= root
                or not character:IsDescendantOf(workspace)
                or os.clock() >= state.Until
                or not deps.MovementService.IsStunned(victim)
                or luckyImmune(victim)
            then
                releaseOwnership()
                return
            end
            local ok, problem = pcall(function(): boolean
                if not deps.RagdollService.IsRagdolled(character) or root.Anchored then
                    return false
                end
                Knockback.Apply(root, away, level, if luckyBuff(attacker, "MegaBat") then 2 else 1)
                return true
            end)
            if not ok then
                warn("[Bat] Knockback failed: " .. tostring(problem))
            end
            if ok and problem then
                task.delay(Config.Knockback.ServerOwnershipSeconds, releaseOwnership)
            else
                releaseOwnership()
            end
        end)
    elseif state.ReleaseOwnership then
        state.ReleaseOwnership()
    end
    task.delay(duration, function()
        if stuns[victim] == state and victim.Character == character then
            setRagdolled(character, false)
            if state.ReleaseOwnership then
                state.ReleaseOwnership()
            end
            deps.MovementService.SetStunned(victim, false)
            character:SetAttribute("BatStunned", nil)
            victim:SetAttribute("StunnedUntil", 0)
        end
    end)
    -- Use the authoritative level resolved at impact. Apply last so lethal damage
    -- follows normal Humanoid death cleanup without recreating stun after Died.
    local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid
    CombatService.DamagePlayer(attacker, victim, character, humanoid.MaxHealth * level.DamageFraction)
end
-- No target, level, duration or geometry is accepted from the requester.
function CombatService.SwingBat(player: Player): boolean
    local trace = swingTrace(player)
    local equipped = resolveEquippedBat(player)
    local function fullName(object: Instance?): string
        return if object then object:GetFullName() else "nil"
    end
    trace(
        string.format(
            "BatLevel=%s runtimeTool=%s runtimeToolParent=%s isUnderCharacter=%s handle=%s hitbox=%s issuedValidation=%s",
            tostring(levelFor(player)),
            fullName(equipped.RuntimeTool),
            fullName(if equipped.RuntimeTool then equipped.RuntimeTool.Parent else nil),
            tostring(equipped.IsUnderCharacter),
            fullName(equipped.Handle),
            fullName(equipped.Hitbox),
            tostring(equipped.IssuedValidation)
        )
    )
    local rejection = swingRejection(player, equipped)
    if rejection or os.clock() < (attackAt[player] or 0) then
        trace("SwingBat rejected: " .. (rejection or "cooldown"))
        return false
    end
    trace("SwingBat accepted")
    attackAt[player] = os.clock() + Config.SwingCooldown * (if luckyBuff(player, "MegaBat") then 0.5 else 1)
    local token = {}
    swings[player] = token
    local character = player.Character :: Model
    local weapon = equipped.Weapon :: Weapon
    local tool = equipped.Tool :: Tool
    local hitbox = equipped.Hitbox :: BasePart
    local _, root = alive(player)
    local position = hitbox.Position
    GameplaySfx.Emit("BatSwing", position)
    local context = deps.TycoonService.GetRequestContext(player)
    local function sampleImpact(sample: number)
        if swings[player] ~= token then
            return
        end
        local currentEquipped = resolveEquippedBat(player)
        trace("impact callback reached sample=" .. tostring(sample))
        if
            swings[player] ~= token
            or player.Character ~= character
            or currentEquipped.Weapon ~= weapon
            or currentEquipped.Tool ~= tool
            or swingRejection(player, currentEquipped) ~= nil
            or not deps.TycoonService.ValidateActor(player, context)
        then
            trace(
                "impact rejected: "
                    .. (swingRejection(player, currentEquipped) or "character/weapon/swing or membership changed")
            )
            swings[player] = nil
            return
        end
        local _, root = alive(player)
        if not root then
            swings[player] = nil
            return
        end
        local level = Config.Levels[levelFor(player)]
        -- Sample the exact issued clone at impact, including authored joints/animation.
        -- configure() owns its size; clients never supply query geometry in the request.
        local hitbox = currentEquipped.Hitbox :: BasePart
        local size, at = hitbox.Size, hitbox.CFrame
        local maxRootDistance = Config.MaxRootDistance * level.Scale
        -- Replicated Tool poses are observations, not authority to hit across the map.
        if not ((at.Position - root.Position).Magnitude <= maxRootDistance) then
            trace("impact rejected: Hitbox pose exceeds sanity distance")
            swings[player] = nil
            return
        end
        trace("Hitbox=" .. hitbox:GetFullName() .. " CFrame=" .. tostring(at) .. " Size=" .. tostring(size))
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { character :: Model }
        params.RespectCanCollide = false
        params.MaxParts = 0
        local overlaps = workspace:GetPartBoundsInBox(at, size, params)
        trace("overlap parts=" .. tostring(#overlaps))
        local closest: Model? = nil
        local distance = math.huge
        local candidates: { [Model]: { Player: Player? } } = {}
        for _, part in overlaps do
            local ancestor: Instance? = part
            while ancestor and ancestor ~= workspace do
                if ancestor:IsA("Model") then
                    local victim = Players:GetPlayerFromCharacter(ancestor)
                    if victim then
                        candidates[ancestor] = { Player = victim }
                        trace(
                            "candidate part="
                                .. part.Name
                                .. " character="
                                .. ancestor.Name
                                .. " player="
                                .. victim.Name
                        )
                        break
                    elseif
                        deps.CustomerService.CanHitCustomer(player, ancestor)
                        or (deps.JackedNoobService and deps.JackedNoobService.CanHit(player, ancestor))
                    then
                        candidates[ancestor] = {}
                        break
                    end
                end
                ancestor = ancestor.Parent
            end
        end
        for target, candidate in candidates do
            local victim = candidate.Player
            local targetRoot: BasePart? = nil
            local enemyReason: string? = nil
            if victim then
                local _, playerRoot = alive(victim)
                targetRoot = playerRoot
                enemyReason = enemyRejection(player, victim)
                trace(
                    "candidate="
                        .. victim.Name
                        .. " plot/team/stun/immunity="
                        .. (enemyReason or "pass")
                        .. " sessions="
                        .. tostring(deps.TycoonService.GetSessionId(player))
                        .. "/"
                        .. tostring(deps.TycoonService.GetSessionId(victim))
                )
            elseif
                deps.CustomerService.CanHitCustomer(player, target)
                or (deps.JackedNoobService and deps.JackedNoobService.CanHit(player, target))
            then
                targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
            else
                enemyReason = "NPC ineligible"
            end
            if target and targetRoot then
                local direction = targetRoot.Position - root.Position
                local separation = direction.Magnitude
                local forward = root.CFrame.LookVector:Dot(direction)
                local ray = RaycastParams.new()
                ray.FilterType = Enum.RaycastFilterType.Exclude
                ray.FilterDescendantsInstances = { character :: Model }
                local obstruction = workspace:Raycast(root.Position, direction, ray)
                local visible = not obstruction or obstruction.Instance:IsDescendantOf(target)
                trace(
                    string.format(
                        "candidate=%s rootDistance=%.3f sanityDistance=%s forwardDot=%.3f forward=%s LOS=%s obstruction=%s",
                        target.Name,
                        separation,
                        tostring(separation <= maxRootDistance),
                        forward,
                        tostring(forward >= 0),
                        tostring(visible),
                        if obstruction then obstruction.Instance:GetFullName() else "none"
                    )
                )
                if
                    not enemyReason
                    and separation <= maxRootDistance
                    and separation < distance
                    and forward >= 0
                    and visible
                then
                    closest, distance = target, separation
                end
            end
        end
        trace("selected=" .. (if closest then closest.Name else "no valid target"))
        if closest then
            swings[player] = nil
            local victim = Players:GetPlayerFromCharacter(closest)
            if victim then
                hit(player, victim, level)
                trace(
                    "SetStunned result="
                        .. tostring(deps.MovementService.IsStunned(victim))
                        .. " Stunned="
                        .. tostring(victim:GetAttribute("Stunned"))
                        .. " StunnedUntil="
                        .. tostring(victim:GetAttribute("StunnedUntil"))
                )
            else
                local targetRoot = closest:FindFirstChild("HumanoidRootPart") :: BasePart
                local context = {
                    Direction = Knockback.Direction(root, targetRoot),
                    Duration = level.StunDuration,
                }
                if deps.JackedNoobService and deps.JackedNoobService.CanHit(player, closest) then
                    deps.JackedNoobService.Hit(player, closest, context)
                else
                    deps.CustomerService.HitCustomer(player, closest, context)
                end
            end
        end
    end
    -- Keep only one pending sample. Late callbacks expire instead of replaying
    -- missed contacts, and each live sample reads the current Tool geometry.
    local deadline = os.clock() + Config.HitActiveEnd
    local sample = 0
    local function sampleNext()
        if swings[player] ~= token then
            return
        end
        if os.clock() >= deadline then
            swings[player] = nil
            return
        end
        sample += 1
        sampleImpact(sample)
        if swings[player] == token then
            task.delay(math.min(Config.HitSampleInterval, math.max(0, deadline - os.clock())), sampleNext)
        end
    end
    task.delay(Config.HitActiveStart, sampleNext)
    return true
end
function CombatService.ApplyCharacter(player: Player, character: Model)
    local characterToken = {}
    characters[player] = characterToken
    swings[player] = nil
    attackAt[player] = nil
    clearStun(player)
    removeWeapon(player)
    if deaths[player] then
        deaths[player]:Disconnect()
        deaths[player] = nil
    end
    if backpackWatches[player] then
        backpackWatches[player]:Disconnect()
    end
    backpackWatches[player] = player.ChildAdded:Connect(function(child)
        if child:IsA("Backpack") then
            CombatService.RefreshPlayer(player)
        end
    end)
    if removals[player] then
        removals[player]:Disconnect()
    end
    removals[player] = player.CharacterRemoving:Connect(function(removing)
        if removing == character and characters[player] == characterToken then
            characters[player] = nil
            swings[player] = nil
            clearStun(player)
        end
    end)
    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
        if
            characters[player] ~= characterToken
            or not root
            or player.Character ~= character
            or player.Parent ~= Players
            or not humanoid
            or not humanoid:IsA("Humanoid")
        then
            return
        end
        deaths[player] = humanoid.Died:Connect(function()
            swings[player] = nil
            clearStun(player)
            removeWeapon(player)
        end)
        CombatService.RefreshPlayer(player)
    end)
end
function CombatService.RemovePlayer(player: Player)
    if removals[player] then
        removals[player]:Disconnect()
        removals[player] = nil
    end
    characters[player] = nil
    if deaths[player] then
        deaths[player]:Disconnect()
    end
    if backpackWatches[player] then
        backpackWatches[player]:Disconnect()
    end
    deaths[player], backpackWatches[player] = nil, nil
    swings[player], attackAt[player] = nil, nil
    clearStun(player)
    removeWeapon(player)
end
return require(script.Parent.StudioServices).Wrap("CombatService", CombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">CustomerOrderEvaluation</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local CustomerRequests = require(Shared.Constants.CustomerRequests)
local Economy = require(Shared.Constants.Economy)
local Ingredients = require(Shared.Constants.Ingredients)
local Types = require(Shared.Types)

export type Evaluation = {
    Grade: Types.Grade?,
    Relevant: { boolean },
    IsWildcard: boolean,
    MatchCount: number,
    TotalSlots: number,
    RequirementsCovered: boolean,
    RestrictionViolated: boolean,
    IsValid: boolean,
    IsFulfilled: boolean,
    Reason: string,
}

local CustomerOrderEvaluation = {}

local function emptyResult(request: CustomerRequests.Request, reason: string, ingredientCount: number): Evaluation
    local isWildcard = request.Wildcard == true
    return {
        Grade = if isWildcard then nil else "D",
        Relevant = table.create(ingredientCount, false),
        IsWildcard = isWildcard,
        MatchCount = 0,
        TotalSlots = 0,
        RequirementsCovered = false,
        RestrictionViolated = false,
        IsValid = false,
        IsFulfilled = false,
        Reason = reason,
    }
end

local function matchesTag(tags: { [string]: boolean }, requestedTag: string): boolean
    local normalized = string.lower(requestedTag)
    if tags[normalized] then
        return true
    end
    local group = CustomerRequests.TagGroups[normalized]
    if group then
        for member in group do
            if tags[member] then
                return true
            end
        end
    end
    return false
end

CustomerOrderEvaluation.MatchesTag = matchesTag

local function matchesRequirement(id: string, requirement: CustomerRequests.IngredientRequirement): boolean
    return if type(requirement) == "string" then requirement == id else table.find(requirement, id) ~= nil
end

function CustomerOrderEvaluation.Evaluate(result: Types.Smoothie, request: CustomerRequests.Request): Evaluation
    local ids = result.Ingredients
    local requirements: { CustomerRequests.IngredientRequirement } = request.RequiredIngredients or {}
    local isWildcard = request.Wildcard == true
    if #ids == 0 then
        return emptyResult(request, "Empty smoothie", #ids)
    end
    if #ids < Economy.MaxIngredients then
        return emptyResult(request, "Not enough ingredients", #ids)
    end
    if #ids > Economy.MaxIngredients then
        return emptyResult(request, "Too many ingredients", #ids)
    end

    local ingredientTags: { [number]: { [string]: boolean } } = {}
    for index, id in ids do
        local definition = Ingredients[id]
        if not definition then
            return emptyResult(request, "Unknown ingredient: " .. id, #ids)
        end
        local tags: { [string]: boolean } = {}
        for _, tag in definition.Tags do
            tags[string.lower(tag)] = true
        end
        ingredientTags[index] = tags
    end

    if isWildcard then
        return {
            Grade = nil,
            Relevant = table.create(#ids, false),
            IsWildcard = true,
            MatchCount = #ids,
            TotalSlots = #ids,
            RequirementsCovered = true,
            RestrictionViolated = false,
            IsValid = true,
            IsFulfilled = true,
            Reason = "Wildcard fulfilled",
        }
    end
    local requiredTags: { string } = request.RequiredTags or {}
    if #requiredTags == 0 and #requirements == 0 then
        return emptyResult(request, "Empty request", #ids)
    end
    if request.ExactIngredients and #requirements == 0 then
        return emptyResult(request, "ExactIngredients requires at least one RequiredIngredient", #ids)
    end

    local restrictionReason: string? = nil
    local forbiddenTags: { string } = request.ForbiddenTags or {}
    for _, forbiddenTag in forbiddenTags do
        for _, tags in ingredientTags do
            if tags[string.lower(forbiddenTag)] then
                restrictionReason = "Contains forbidden tag: " .. forbiddenTag
                break
            end
        end
        if restrictionReason then
            break
        end
    end
    local forbiddenIngredients: { string } = request.ForbiddenIngredients or {}
    if not restrictionReason then
        for _, id in ids do
            if table.find(forbiddenIngredients, id) then
                restrictionReason = "Contains forbidden ingredient: " .. id
                break
            end
        end
    end
    local allTagsCovered = true
    local missingTag: string? = nil
    for _, requiredTag in requiredTags do
        local covered = false
        for _, tags in ingredientTags do
            if matchesTag(tags, requiredTag) then
                covered = true
                break
            end
        end
        if not covered then
            allTagsCovered = false
            missingTag = missingTag or requiredTag
        end
    end

    -- Find the maximum one-to-one assignment between physical ingredients and request slots.
    local assignedSlots: { [number]: number } = {}
    local function assignSlot(slot: number, visited: { [number]: boolean }): boolean
        local requirement = requirements[slot]
        for index, id in ids do
            if matchesRequirement(id, requirement) and not visited[index] then
                visited[index] = true
                local previousSlot = assignedSlots[index]
                if not previousSlot or assignSlot(previousSlot, visited) then
                    assignedSlots[index] = slot
                    return true
                end
            end
        end
        return false
    end
    local matchedSlots = 0
    for slot in requirements do
        if assignSlot(slot, {}) then
            matchedSlots += 1
        end
    end
    local allIngredientSlotsCovered = matchedSlots == #requirements

    local relevance: { boolean } = {}
    local relevantCount = 0
    for index, id in ids do
        local relevant = false
        for _, requiredTag in requiredTags do
            if matchesTag(ingredientTags[index], requiredTag) then
                relevant = true
                break
            end
        end
        if not relevant then
            for _, requirement in requirements do
                if matchesRequirement(id, requirement) then
                    relevant = true
                    break
                end
            end
        end
        relevance[index] = relevant
        if relevant then
            relevantCount += 1
        end
    end
    local matchCount = if request.ExactIngredients then matchedSlots else relevantCount
    local exactCountMatches = not request.ExactIngredients or #ids == #requirements
    local requirementsCovered = allTagsCovered and allIngredientSlotsCovered and exactCountMatches
    local reason = "Request requirements matched"
    if not allTagsCovered then
        reason = "Missing required tag: " .. (missingTag :: string)
    elseif not allIngredientSlotsCovered then
        for slot, requirement in requirements do
            if not assignSlot(slot, {}) then
                local description = if type(requirement) == "string"
                    then requirement
                    else table.concat(requirement, " or ")
                reason = "Missing required ingredient: " .. description
                break
            end
        end
    elseif not exactCountMatches then
        reason = "Exact ingredient mismatch"
    end
    if restrictionReason then
        return {
            Grade = "D",
            Relevant = relevance,
            IsWildcard = false,
            MatchCount = matchCount,
            TotalSlots = if request.ExactIngredients then #requirements else #ids,
            RequirementsCovered = requirementsCovered,
            RestrictionViolated = true,
            IsValid = true,
            IsFulfilled = false,
            Reason = restrictionReason,
        }
    end

    local grade: Types.Grade
    if request.ExactIngredients then
        if matchCount == 0 then
            grade = "D"
        elseif matchCount == 1 then
            grade = "C"
        elseif matchCount < #requirements then
            grade = "B"
        elseif requirementsCovered then
            grade = "A"
        else
            grade = "C"
        end
    elseif matchCount == 0 then
        grade = "D"
    elseif matchCount >= 3 and requirementsCovered then
        grade = "A"
    elseif matchCount >= 2 and requirementsCovered then
        grade = "B"
    else
        grade = "C"
    end
    return {
        Grade = grade,
        Relevant = relevance,
        IsWildcard = false,
        MatchCount = matchCount,
        TotalSlots = if request.ExactIngredients then #requirements else #ids,
        RequirementsCovered = requirementsCovered,
        RestrictionViolated = false,
        IsValid = true,
        IsFulfilled = grade == "A" or grade == "B",
        Reason = reason,
    }
end

return CustomerOrderEvaluation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">CustomerPlacement</string>
            <string name="Source"><![CDATA[--!strict
-- Markers describe ground surfaces, not avatar pivot heights.
local CustomerPlacement = {}

function CustomerPlacement.BottomOffset(model: Model): number
    local bounds, size = model:GetBoundingBox()
    local halfHeight = (
        math.abs(bounds.RightVector.Y) * size.X
        + math.abs(bounds.UpVector.Y) * size.Y
        + math.abs(bounds.LookVector.Y) * size.Z
    ) / 2
    local offset = model:GetAttribute("CustomerVerticalOffset")
    local extra = if type(offset) == "number" and offset == offset and math.abs(offset) < math.huge then offset else 0
    return model:GetPivot().Position.Y - (bounds.Position.Y - halfHeight) + extra
end

function CustomerPlacement.AtMarker(marker: BasePart, bottomOffset: number): CFrame
    -- Top surface at the marker's center X/Z. Author upright, horizontal route markers.
    local position = marker.CFrame.Position
    local grounded = Vector3.new(position.X, position.Y + marker.Size.Y / 2 + bottomOffset, position.Z)
    return CustomerPlacement.Face(grounded, grounded + marker.CFrame.LookVector, marker.CFrame)
end

function CustomerPlacement.Face(position: Vector3, target: Vector3, fallback: CFrame): CFrame
    local direction = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
    if direction.Magnitude < 0.0001 then
        direction = Vector3.new(fallback.LookVector.X, 0, fallback.LookVector.Z)
        if direction.Magnitude < 0.0001 then
            direction = Vector3.new(0, 0, -1)
        end
    end
    return CFrame.lookAt(position, position + direction)
end

return CustomerPlacement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">CustomerPresentation</string>
            <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local CustomerPresentation = {}

local RESULT_DURATION = 4
local RESULT_DROP = 32
local GRADE_COLORS: { [string]: string } = {
    A = "rgb(100,225,120)",
    B = "rgb(100,170,255)",
    C = "rgb(195,135,255)",
    D = "rgb(255,95,95)",
    F = "rgb(255,95,95)",
}

-- Measure once in the resting pose; never follow the animated Head or camera axes.
function CustomerPresentation.CreateAnchor(root: BasePart, head: BasePart?): Attachment
    local height = if head then head.Position.Y - root.Position.Y + head.Size.Y / 2 else root.Size.Y / 2
    local anchor = Instance.new("Attachment")
    anchor.Name = "ServePromptOrigin"
    anchor.Position = Vector3.new(0, math.max(0, height) + 0.35, 0)
    anchor.Parent = root
    local reward = Instance.new("Attachment")
    reward.Name = "CustomerRewardOrigin"
    -- Measure in the resting pose, independent of head animation/card height.
    reward.Position = Vector3.new(0, if head then head.Position.Y - root.Position.Y - 0.35 else 0.65, 0)
    reward.Parent = root
    return anchor
end

local function outline(text: TextLabel, billboard: BillboardGui)
    TextStyle.Outline(text, billboard)
end

-- Both customer types share lettering; specials retain their separate name row.
local function styleDialogueText(text: TextLabel, size: number, billboard: BillboardGui)
    text.Font = TextStyle.Font
    text.TextSize = size
    text.TextScaled = true
    text.TextWrapped = true
    text.TextColor3 = Color3.new(1, 1, 1)
    text.LineHeight = 1
    outline(text, billboard)
end

function CustomerPresentation.StyleDialogue(bubble: BillboardGui, text: TextLabel, special: boolean)
    if not special then
        -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
        BillboardStyle.ApplyBillboard(
            bubble,
            { WidthStuds = 8.4, HeightStuds = 3.12, MaxDistance = 45, ResetOnSpawn = true }
        )
        text.Size = UDim2.fromScale(1, 1)
    end
    styleDialogueText(text, 21, bubble)
    local name = bubble:FindFirstChild("CustomerName")
    if name and name:IsA("TextLabel") then
        name.Visible = special
        if special then
            styleDialogueText(name, 18, bubble)
        end
    end
end

function CustomerPresentation.ShowResult(
    order: BillboardGui,
    grade: string?,
    payout: number,
    _ingredientValue: number?
): BillboardGui
    -- Keep the existing reaction-card drop and special name row. Cash has its
    -- own body-relative anchor, so dialogue size cannot lift the payout.
    order.SizeOffset = Vector2.new(order.SizeOffset.X, 0.5 - RESULT_DROP / (order.Size.Y.Scale * 37.5))
    local cash = tostring(math.abs(payout)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    local reward = (if payout < 0 then "-$" else "+$") .. cash
    local rewardColor = if payout < 0 then "rgb(255,95,95)" else "rgb(255,222,115)"
    local gui = Instance.new("BillboardGui")
    gui.Name = "CustomerResult"
    local anchor = order.Adornee
    local root = if anchor and anchor:IsA("Attachment") then anchor.Parent else nil
    gui.Adornee = (if root then root:FindFirstChild("CustomerRewardOrigin") else nil) or anchor
    gui.StudsOffset = Vector3.zero
    local height = if grade == "D" then 54 else 32
    BillboardStyle.ApplyBillboard(gui, {
        WidthStuds = 9.6,
        HeightStuds = (math.round(height / 37.5 * 10) / 10) * 1.2,
        MaxDistance = 30,
        ResetOnSpawn = true,
    })
    -- Cash stays centered on the body-relative anchor; retry extends below it.
    gui.SizeOffset = Vector2.new(0, (16 - height / 2) / height)
    gui.AlwaysOnTop = true
    gui.MaxDistance = 30
    gui.Enabled = false
    local canvasHeight = height
    local function row(name: string, y: number, height: number, size: number, content: string): TextLabel
        local text = Instance.new("TextLabel")
        text.Name = name
        text.Size = UDim2.fromScale(1, height / canvasHeight)
        text.Position = UDim2.fromScale(0, y / canvasHeight)
        text.BackgroundTransparency = 1
        text.Font = TextStyle.Font
        text.TextSize = size
        text.TextScaled = true
        text.TextColor3 = Color3.new(1, 1, 1)
        text.RichText = true
        text.Text = content
        outline(text, gui)
        text.Parent = gui
        return text
    end
    local resultText = if grade
        then string.format(
            '<font color="%s">%s</font> \u{00B7} <font color="%s">%s</font>',
            GRADE_COLORS[grade] or "rgb(255,255,255)",
            grade,
            rewardColor,
            reward
        )
        else '<font color="' .. rewardColor .. '">' .. reward .. "</font>"
    row("Result", 0, 32, 24, resultText)
    if grade == "D" then
        local retry = row("Retry", 34, 20, 16, "TRY AGAIN \u{00B7} 15% PAYOUT")
        retry.TextColor3 = Color3.fromRGB(255, 95, 95)
    end
    gui.Parent = order.Parent
    gui:SetAttribute("ResultExpiresAt", os.clock() + RESULT_DURATION)
    game:GetService("Debris"):AddItem(gui, RESULT_DURATION)
    return gui
end

-- Cosmetic geometry only: never call IngredientService.Spawn or register an item.
function CustomerPresentation.AttachStolenIngredient(model: Model, visual: Instance): Instance?
    local root = model:FindFirstChild("HumanoidRootPart")
    local part = if visual:IsA("BasePart") then visual elseif visual:IsA("Model") then visual.PrimaryPart else nil
    if not root or not root:IsA("BasePart") or not part then
        visual:Destroy()
        return nil
    end
    local descendants = visual:GetDescendants()
    table.insert(descendants, visual)
    for _, child in descendants do
        for name in child:GetAttributes() do
            child:SetAttribute(name, nil)
        end
        if child:IsA("BasePart") then
            child.Anchored = false
            child.CanCollide, child.CanTouch, child.CanQuery = false, false, false
            child.Massless = true
        end
    end
    local at = root.CFrame * CFrame.new(1.4, 0, -0.8)
    if visual:IsA("Model") then
        visual:PivotTo(at)
    else
        part.CFrame = at
    end
    visual.Name = "StolenIngredientVisual"
    local weld = Instance.new("WeldConstraint")
    weld.Part0, weld.Part1 = root, part
    weld.Parent = part
    visual.Parent = model
    return visual
end

-- A short exit route must not truncate the readable hold or delay the next customer.
-- Snapshot only the presentation at the final root position before normal rig cleanup.
function CustomerPresentation.PreserveResult(gui: BillboardGui)
    local expires = gui:GetAttribute("ResultExpiresAt")
    local anchor = gui.Adornee
    if
        not gui.Parent
        or typeof(expires) ~= "number"
        or expires <= os.clock()
        or not anchor
        or not anchor:IsA("Attachment")
    then
        return
    end
    local root = anchor.Parent
    if not root or not root:IsA("BasePart") then
        return
    end
    local customer = root.Parent
    if not customer then
        return
    end
    local holder = Instance.new("Model")
    holder.Name = "CustomerResultHold"
    holder:SetAttribute("OwnerUserId", customer:GetAttribute("OwnerUserId"))
    holder:SetAttribute("PlotSessionId", customer:GetAttribute("PlotSessionId"))
    local origin = Instance.new("Part")
    origin.Name = "ResultOrigin"
    origin.Anchored = true
    origin.Transparency = 1
    origin.CanCollide, origin.CanTouch, origin.CanQuery = false, false, false
    origin.CFrame = root.CFrame
    origin.Parent = holder
    local fixedAnchor = Instance.new("Attachment")
    fixedAnchor.Position = anchor.Position
    fixedAnchor.Parent = origin
    local copy = gui:Clone()
    copy.Enabled = false
    copy.Adornee = fixedAnchor
    copy.Parent = origin
    holder.Parent = workspace
    game:GetService("Debris"):AddItem(holder, math.max(0, expires - os.clock()))
end

-- Presentation only: keys are normalized tags, never ingredient-derived colors.
-- Aliases describe wording in authored dialogue; they do not change tag validation.
CustomerPresentation.TagHighlights = {
    red = { Color = Color3.fromRGB(255, 95, 95) },
    yellow = { Color = Color3.fromRGB(255, 220, 65) },
    green = { Color = Color3.fromRGB(100, 225, 120) },
    purple = { Color = Color3.fromRGB(195, 135, 255) },
    blue = { Color = Color3.fromRGB(100, 170, 255) },
    cold = { Color = Color3.fromRGB(105, 225, 255) },
    sweet = { Color = Color3.fromRGB(255, 140, 200) },
    spicy = { Color = Color3.fromRGB(255, 140, 65), Aliases = { "spice", "heat" } },
    protein = { Color = Color3.fromRGB(235, 180, 120) },
    fruit = { Color = Color3.fromRGB(255, 175, 95), Aliases = { "fruity" } },
    seafood = { Color = Color3.fromRGB(95, 215, 200), Aliases = { "ocean", "fish" } },
    ["fast food"] = { Color = Color3.fromRGB(255, 190, 75) },
    milk = { Color = Color3.fromRGB(190, 205, 255) },
    weird = { Color = Color3.fromRGB(210, 145, 245) },
    sour = { Color = Color3.fromRGB(195, 235, 85) },
    veggie = { Color = Color3.fromRGB(135, 215, 105), Aliases = { "veggies" } },
    mushroom = { Color = Color3.fromRGB(220, 180, 145), Aliases = { "mushrooms" } },
    watermelon = { Color = Color3.fromRGB(255, 130, 155) },
    steak = { Color = Color3.fromRGB(225, 140, 120) },
} :: { [string]: { Color: Color3, Aliases: { string }? } }

function CustomerPresentation.HideDefaultDisplay(humanoid: Humanoid)
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
end

local function nonempty(value: any): string?
    return if type(value) == "string" and string.find(value, "%S") then value else nil
end

function CustomerPresentation.DisplayName(
    template: Model,
    special: boolean,
    configured: string?,
    identity: string?
): string
    if not special then
        return "CustomerNPC"
    end
    local humanoid = template:FindFirstChildOfClass("Humanoid")
    return (if humanoid then nonempty(humanoid.DisplayName) else nil)
        or nonempty(configured)
        or nonempty(identity)
        or template.Name
end

function CustomerPresentation.Response(
    request: { GoodResponse: string?, GoodResponses: { string }?, BadResponse: string? },
    grade: string
): string?
    if grade == "A" or grade == "B" then
        local responses = request.GoodResponses
        if responses and #responses > 0 then
            return nonempty(responses[math.random(1, #responses)]) or nonempty(request.GoodResponse)
        end
        return nonempty(request.GoodResponse)
    elseif grade == "C" or grade == "D" or grade == "F" then
        return nonempty(request.BadResponse)
    end
    return nil
end

return CustomerPresentation
]]></string>
          </Properties>
