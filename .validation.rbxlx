          <Item class="ModuleScript" referent="879">
            <Properties>
              <string name="Name">MenuNotifications</string>
              <string name="Source"><![CDATA[--!strict
-- Session state survives imported views. FramewispMenus owns instance bindings.
local Badge = require(script.Parent.NotificationBadge)
local Notifications = {}
type Channel = {
    Visible: boolean,
    Open: boolean,
    Views: { [GuiButton]: (boolean) -> () },
    Listeners: { [() -> ()]: boolean },
    ChangeListeners: { [() -> ()]: boolean },
}
local channels: { [string]: Channel } = {}
local function channel(id: string): Channel
    if not channels[id] then
        channels[id] = { Visible = false, Open = false, Views = {}, Listeners = {}, ChangeListeners = {} }
    end
    return channels[id]
end
local function render(state: Channel)
    for _, setVisible in state.Views do
        setVisible(state.Visible)
    end
end
function Notifications.Set(id: string, visible: boolean)
    local state = channel(id)
    state.Visible = visible
    render(state)
end
function Notifications.IsOpen(id: string): boolean
    return channel(id).Open
end
function Notifications.PanelChanged(id: string, open: boolean)
    local state = channel(id)
    state.Open = open
    -- Hide before callbacks or panel animations begin.
    render(state)
    if open then
        for listener in state.Listeners do
            listener()
        end
    end
    for listener in state.ChangeListeners do
        listener()
    end
end
function Notifications.OnChanged(id: string, callback: () -> ()): () -> ()
    local state = channel(id)
    state.ChangeListeners[callback] = true
    return function()
        state.ChangeListeners[callback] = nil
    end
end
function Notifications.OnOpened(id: string, callback: () -> ()): () -> ()
    local state = channel(id)
    state.Listeners[callback] = true
    return function()
        state.Listeners[callback] = nil
    end
end
function Notifications.Attach(id: string, button: GuiButton): () -> ()
    if id ~= "Upgrades" and id ~= "Index" then
        return function() end
    end
    local state = channel(id)
    local setVisible, detach = Badge.Attach(button)
    state.Views[button] = setVisible
    render(state)
    return function()
        if state.Views[button] == setVisible then
            state.Views[button] = nil
        end
        detach()
    end
end
return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="880">
            <Properties>
              <string name="Name">MobileControlLayout</string>
              <string name="Source"><![CDATA[--!strict
-- Presentation only: CAS still owns the buttons and all action input.
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Layout = {}
local OFFSETS =
    { SprintHeld = Vector2.new(-1.25, 0), ThrowHeld = Vector2.new(-0.95, -0.95), IceShotgunFire = Vector2.new(0, -1.8) }
local ACTIONS = { "SprintHeld", "ThrowHeld", "IceShotgunFire" }
local PADDING = 8
local GAP = 2
local registered: { [string]: boolean } = {}
local connections: { RBXScriptConnection } = {}
local guiConnections: { RBXScriptConnection } = {}
local observed: { [Instance]: { RBXScriptConnection } } = {}
local playerGui: PlayerGui? = nil
local started = false
local queued = false
local generation = 0

local function disconnect(list: { RBXScriptConnection })
    for _, connection in list do
        connection:Disconnect()
    end
    table.clear(list)
end

-- Clamp the entire square hit target, then choose the closest unoccupied position.
-- Obstacle edges provide candidates when clamping would overlap Jump or the other action.
local function place(preferred: Vector2, size: number, bounds: Rect, obstacles: { Rect }): Vector2?
    local half = size / 2
    local low = bounds.Min + Vector2.new(half + PADDING, half + PADDING)
    local high = bounds.Max - Vector2.new(half + PADDING, half + PADDING)
    if low.X > high.X or low.Y > high.Y then
        return nil
    end
    local xs = { math.clamp(preferred.X, low.X, high.X), low.X, high.X }
    local ys = { math.clamp(preferred.Y, low.Y, high.Y), low.Y, high.Y }
    for _, obstacle in obstacles do
        table.insert(xs, math.clamp(obstacle.Min.X - half - GAP, low.X, high.X))
        table.insert(xs, math.clamp(obstacle.Max.X + half + GAP, low.X, high.X))
        table.insert(ys, math.clamp(obstacle.Min.Y - half - GAP, low.Y, high.Y))
        table.insert(ys, math.clamp(obstacle.Max.Y + half + GAP, low.Y, high.Y))
    end
    local best: Vector2? = nil
    local distance = math.huge
    for _, x in xs do
        for _, y in ys do
            local clear = true
            for _, obstacle in obstacles do
                if
                    x + half + GAP > obstacle.Min.X
                    and x - half - GAP < obstacle.Max.X
                    and y + half + GAP > obstacle.Min.Y
                    and y - half - GAP < obstacle.Max.Y
                then
                    clear = false
                    break
                end
            end
            local delta = Vector2.new(x, y) - preferred
            local cost = delta:Dot(delta)
            if clear and cost < distance then
                best, distance = Vector2.new(x, y), cost
            end
        end
    end
    return best
end

local function visible(object: Instance, root: PlayerGui): boolean
    local ancestor: Instance? = object
    while ancestor and ancestor ~= root do
        if ancestor:IsA("GuiObject") and not ancestor.Visible then
            return false
        end
        if ancestor:IsA("ScreenGui") and not ancestor.Enabled then
            return false
        end
        ancestor = ancestor.Parent
    end
    return ancestor == root
end

local update: () -> ()
local function schedule()
    if queued or not started then
        return
    end
    queued = true
    local version = generation
    task.defer(function()
        if version ~= generation then
            return
        end
        queued = false
        update()
    end)
end

local function watch(wanted: { [Instance]: boolean }, object: Instance, properties: { string })
    wanted[object] = true
    if observed[object] then
        return
    end
    local list = { object.AncestryChanged:Connect(schedule) }
    for _, property in properties do
        table.insert(list, object:GetPropertyChangedSignal(property):Connect(schedule))
    end
    observed[object] = list
end

local function watchAncestors(wanted: { [Instance]: boolean }, object: Instance, root: PlayerGui)
    local ancestor = object.Parent
    while ancestor and ancestor ~= root do
        if ancestor:IsA("GuiObject") then
            watch(wanted, ancestor, { "AbsolutePosition", "AbsoluteSize", "Visible" })
        elseif ancestor:IsA("ScreenGui") then
            watch(wanted, ancestor, { "Enabled", "ScreenInsets", "IgnoreGuiInset" })
        end
        ancestor = ancestor.Parent
    end
end

local function clearUnused(wanted: { [Instance]: boolean })
    for object, list in observed do
        if not wanted[object] then
            disconnect(list)
            observed[object] = nil
        end
    end
end

local function relevant(object: Instance)
    -- Only a name hint for native discovery; no WaitForChild chain or CoreGui access.
    if object:IsA("GuiButton") or object:IsA("ScreenGui") or object.Name == "ContextButtonFrame" then
        schedule()
    end
end

update = function()
    local player = Players.LocalPlayer
    local root = if UserInputService.TouchEnabled then player:FindFirstChildOfClass("PlayerGui") else nil
    if root ~= playerGui then
        disconnect(guiConnections)
        clearUnused({})
        playerGui = root
        if root then
            table.insert(guiConnections, root.DescendantAdded:Connect(relevant))
            table.insert(guiConnections, root.DescendantRemoving:Connect(relevant))
        end
    end
    if not root then
        return
    end

    local wanted: { [Instance]: boolean } = {}
    local camera = workspace.CurrentCamera
    if camera then
        watch(wanted, camera, { "ViewportSize" })
    end
    local jump: GuiButton? = nil
    local touchGui = root:FindFirstChild("TouchGui")
    if touchGui then
        for _, object in touchGui:GetDescendants() do
            if object.Name == "JumpButton" and object:IsA("GuiButton") then
                watch(wanted, object, { "AbsolutePosition", "AbsoluteSize", "Visible" })
                watchAncestors(wanted, object, root)
                if visible(object, root) and object.AbsoluteSize.X > 0 and object.AbsoluteSize.Y > 0 then
                    jump = object
                    break
                end
            end
        end
    end

    -- AbsolutePosition and GetInsetArea both use CoreUISafeInsets coordinates.
    -- Subtracting the live CAS parent origin accounts for each ScreenGui's insets.
    local ok, area = pcall(function()
        return GuiService:GetInsetArea(Enum.ScreenInsets.CoreUISafeInsets)
    end)
    local bounds: Rect
    if ok then
        bounds = area
    elseif camera then
        local topLeft, bottomRight = GuiService:GetGuiInset()
        bounds = Rect.new(Vector2.zero, camera.ViewportSize - topLeft - bottomRight)
    else
        clearUnused(wanted)
        return
    end
    local available = bounds.Max - bounds.Min
    if available.X <= PADDING * 2 or available.Y <= PADDING * 2 then
        clearUnused(wanted)
        return
    end
    local diameter = math.clamp(math.min(available.X, available.Y) * 0.18, 70, 120)
    local jumpSize = Vector2.new(diameter, diameter)
    local center = bounds.Max - jumpSize / 2 - Vector2.new(PADDING, PADDING)
    if jump then
        jumpSize = jump.AbsoluteSize
        diameter = math.min(jumpSize.X, jumpSize.Y)
        center = jump.AbsolutePosition + jumpSize / 2
    end
    local size = math.max(44, diameter * 0.83)
    local obstacles = { Rect.new(center - jumpSize / 2, center + jumpSize / 2) }
    for _, action in ACTIONS do
        if not registered[action] then
            continue
        end
        local button = ContextActionService:GetButton(action)
        if not button or not button:IsDescendantOf(root) then
            continue
        end
        watch(wanted, button, { "AbsoluteSize", "AnchorPoint" })
        watchAncestors(wanted, button, root)
        local parent = button.Parent
        if not parent or not parent:IsA("GuiObject") then
            continue
        end
        local parentSize = parent.AbsoluteSize
        if parentSize.X <= 0 or parentSize.Y <= 0 then
            continue
        end
        local offset = OFFSETS[action]
        if action == "IceShotgunFire" and available.X > available.Y then
            -- Stack Fire above Throw in landscape, clear of the right-side menus.
            offset = Vector2.new(OFFSETS.ThrowHeld.X, -1.85)
        end
        local position = place(center + offset * diameter, size, bounds, obstacles)
        if position then
            local half = Vector2.new(size / 2, size / 2)
            table.insert(obstacles, Rect.new(position - half, position + half))
            -- Scale ratios also handle a UIScale on the CAS parent. Preserve AnchorPoint.
            local localPosition = position
                - parent.AbsolutePosition
                + (button.AnchorPoint - Vector2.new(0.5, 0.5)) * size
            local buttonSize = UDim2.fromScale(size / parentSize.X, size / parentSize.Y)
            local buttonPosition = UDim2.fromScale(localPosition.X / parentSize.X, localPosition.Y / parentSize.Y)
            if button.Size ~= buttonSize then
                button.Size = buttonSize
            end
            if button.Position ~= buttonPosition then
                ContextActionService:SetPosition(action, buttonPosition)
            end
        end
    end
    clearUnused(wanted)
end

function Layout.Destroy()
    started = false
    queued = false
    generation += 1
    disconnect(connections)
    disconnect(guiConnections)
    clearUnused({})
    playerGui = nil
    table.clear(registered)
end

function Layout.Unregister(action: string)
    registered[action] = nil
    schedule()
end

function Layout.Register(action: string)
    assert(OFFSETS[action], "Unknown mobile action")
    registered[action] = true
    if not started then
        started = true
        local player = Players.LocalPlayer
        table.insert(connections, UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(schedule))
        table.insert(connections, GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(schedule))
        table.insert(connections, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(schedule))
        table.insert(connections, player.ChildAdded:Connect(schedule))
        table.insert(connections, player.ChildRemoved:Connect(schedule))
        table.insert(connections, script.Destroying:Connect(Layout.Destroy))
    end
    schedule()
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="881">
            <Properties>
              <string name="Name">MobilePromptTouchTargets</string>
              <string name="Source"><![CDATA[--!strict
local ProximityPromptService = game:GetService("ProximityPromptService")
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local Targets = {}
local claimed = setmetatable({} :: { [InputObject]: boolean }, { __mode = "k" })

-- Roblox has already hit-tested this actual transparent button before InputBegan.
-- Do not compare its inset-aware InputObject.Position to a second viewport rectangle.
-- Native GUI stacking chooses the source; the finger claim prevents double dispatch.
function Targets.Register(
    prompt: ProximityPrompt,
    gui: BillboardGui,
    button: TextButton,
    begin: (InputObject) -> (),
    available: (() -> boolean)?
): () -> ()
    Debug.Log(
        prompt,
        "REGISTERED",
        "native input quad (studs) " .. tostring(gui.Size.X.Scale) .. "x" .. tostring(gui.Size.Y.Scale)
    )
    local registered = true
    local connection = button.InputBegan:Connect(function(input)
        Debug.Log(
            prompt,
            "TOUCH RECEIVED",
            tostring(input.UserInputType)
                .. " input="
                .. tostring(input.Position)
                .. " buttonPosition="
                .. tostring(button.AbsolutePosition)
                .. " buttonSize="
                .. tostring(button.AbsoluteSize)
        )
        local reason: string? = nil
        local touch = input.UserInputType == Enum.UserInputType.Touch
        local click = input.UserInputType == Enum.UserInputType.MouseButton1 and prompt.ClickablePrompt
        if not touch and not click then
            reason = "wrong input type"
        elseif claimed[input] then
            reason = "finger already claimed"
        -- The dedicated input billboard owns visibility and the native button gate.
        elseif not registered or not gui.Parent or not gui.Enabled then
            reason = "hidden view"
        elseif button.Parent ~= gui or not button.Visible or not button.Active then
            reason = "inactive touch button"
        elseif not prompt:IsDescendantOf(workspace) then
            reason = "invalid source: prompt outside Workspace"
        elseif not prompt.Enabled then
            reason = "disabled prompt"
        elseif not ProximityPromptService.Enabled then
            reason = "prompt service disabled"
        elseif available and not available() then
            reason = "invalid source: ingredient registration, identity or ownership changed"
        end
        if reason then
            Debug.Log(prompt, "REJECTED", reason)
            return
        end
        -- Claim before begin: a synchronous Triggered callback may retire the view.
        claimed[input] = true
        Debug.Log(prompt, "TARGET SELECTED", "native GUI hit; no coordinate re-test")
        begin(input)
    end)
    return function()
        registered = false
        connection:Disconnect()
    end
end
return Targets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="882">
            <Properties>
              <string name="Name">MuncherEffects</string>
              <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.Muncher)
local Style = require(Shared.Constants.DialogueTextStyle)
local Effects = {}
local RarityStyle = require(script.Parent.IngredientPickupPromptStyle)
local Artwork = require(Shared.Constants.ScrapbookArtwork)
local Viewport = require(script.Parent.IngredientViewport)

function Effects.Pop(object: Instance)
    local flash = Instance.new("Highlight")
    flash.Name = "MuncherSpitPop"
    flash.Adornee, flash.FillColor = object, Style.White
    flash.FillTransparency, flash.OutlineTransparency = 0.3, 1
    flash.DepthMode = Enum.HighlightDepthMode.Occluded
    flash.Parent = object
    TweenService:Create(flash, TweenInfo.new(0.18), { FillTransparency = 1 }):Play()
    Debris:AddItem(flash, 0.2)
end

-- Stops at 1.25 / 1.40 / 1.55 seconds with the default 1.65-second chew.
function Effects.ReelStop(index: number): number
    return Config.ChewSeconds * (0.76 + (index - 1) * 0.09)
end

function Effects.Bind(model: Instance, playerGui: PlayerGui): ((number) -> (), () -> ())
    local saved: { [BasePart]: CFrame } = {}
    local sequence = -1
    local insertedSequence = -1
    local carrier: BasePart? = nil
    local glow: PointLight? = nil
    local rollGui: SurfaceGui? = nil
    local reels: { any } = {}
    local stopSpin: (() -> ())? = nil
    local Audio = require(script.Parent.Parent.Controllers.GameplayAudioController)
    local function restore()
        for part, at in saved do
            if part.Parent then
                part.CFrame = at
            end
        end
        table.clear(saved)
        if stopSpin then
            stopSpin()
            stopSpin = nil
        end
        if rollGui then
            rollGui:Destroy()
        end
        if carrier then
            carrier:Destroy()
        end
        table.clear(reels)
        carrier, glow, rollGui = nil, nil, nil
    end
    local function saveVisual()
        if next(saved) then
            return
        end
        local visual = model:FindFirstChild("Visual")
        if visual then
            local parts = visual:GetDescendants()
            table.insert(parts, visual)
            for _, part in parts do
                if part:IsA("BasePart") then
                    saved[part] = part.CFrame
                end
            end
        end
    end
    local function origin(): CFrame?
        local mouth = model:FindFirstChild("MouthOrigin", true)
        if mouth and mouth:IsA("Attachment") then
            return mouth.WorldCFrame
        end
        if mouth and mouth:IsA("BasePart") then
            return mouth.CFrame
        end
        return nil
    end
    return function(now: number)
        local current = model:GetAttribute("Sequence")
        local processing = model:GetAttribute("Phase") == "Processing"
        local start = model:GetAttribute("StartedAt")
        local age: number = Config.ChewSeconds
        if type(start) == "number" then
            age = math.max(0, now - start)
        end
        local busyAttribute = model:GetAttribute("BusyUntil")
        local busyUntil: number = if type(busyAttribute) == "number" then busyAttribute else 0
        local busy = now < busyUntil and model:GetAttribute("Purchased") == true
        local palette = (RarityStyle.RarityStyles :: any)[tostring(model:GetAttribute("OutputRarity"))]
            or RarityStyle.RarityStyles.Common
        if current ~= sequence or (processing and not carrier and age < Config.ChewSeconds) then
            restore()
            sequence = if type(current) == "number" then current else 0
            local at = origin()
            if processing and at and age < Config.ChewSeconds then
                local display = model:FindFirstChild("DisplayScreen", true)
                assert(
                    display and display:IsA("BasePart"),
                    "Muncher roll requires an authored BasePart named DisplayScreen (Front face) in "
                        .. model:GetFullName()
                )
                saveVisual()
                local tierAttribute = model:GetAttribute("InputTier")
                local tier: number = if type(tierAttribute) == "number" then tierAttribute else 1
                local pool = Config.RewardPools[tier] or Config.RewardPools[1]
                local anchor = Instance.new("Part")
                anchor.Name = "MuncherLocalGlow"
                anchor.Size = Vector3.one * 0.1
                anchor.Anchored, anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = true, false, false, false
                anchor.Transparency, anchor.CFrame, anchor.Parent = 1, at, workspace
                carrier = anchor
                local light = Instance.new("PointLight")
                light.Color = palette.TextColor
                light.Range, light.Brightness, light.Parent = 7, 0, anchor
                glow = light
                local gui = Instance.new("SurfaceGui")
                gui.Name, gui.Adornee = "MuncherReels", display
                -- Decorative roll view: never consume world or Throw taps.
                gui.Active = false
                gui.Face = Enum.NormalId.Front
                gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
                gui.PixelsPerStud = 100
                gui.AlwaysOnTop = false
                gui.ResetOnSpawn = true
                gui.Parent = playerGui
                rollGui = gui
                for index = 1, 3 do
                    local window = Instance.new("Frame")
                    window.Active = false
                    window.Name = "Reel" .. index
                    window.BackgroundColor3 = Color3.fromRGB(35, 20, 45)
                    window.BackgroundTransparency = 0.15
                    window.BorderSizePixel = 0
                    window.ClipsDescendants = true
                    window.Size = UDim2.fromScale(0.29, 0.8)
                    window.Position = UDim2.fromScale(0.025 + (index - 1) * 0.33, 0.1)
                    window.Parent = gui
                    local outline = Instance.new("UIStroke")
                    outline.Thickness = 3
                    outline.Color = palette.TextColor
                    outline.Parent = window
                    local symbols = {}
                    -- Build each candidate once per reel; spinning only moves cached visuals.
                    for _, entry in pool do
                        local symbol = Instance.new("Frame")
                        symbol.Active = false
                        symbol.Name = entry.Id
                        symbol.BackgroundTransparency = 1
                        symbol.Size = UDim2.fromScale(1, 1)
                        symbol.Parent = window
                        local image = Instance.new("ImageLabel")
                        image.Active = false
                        image.Name = "IngredientIcon"
                        image.BackgroundTransparency = 1
                        image.Size = UDim2.fromScale(0.88, 0.88)
                        image.Position = UDim2.fromScale(0.06, 0.06)
                        image.ScaleType = Enum.ScaleType.Fit
                        image.Image = Artwork.GetIngredient(entry.Id)
                        image.Parent = symbol
                        if image.Image == "" then
                            Viewport.Create(image, entry.Id)
                        end
                        table.insert(symbols, symbol)
                    end
                    table.insert(
                        reels,
                        { Symbols = symbols, Outline = outline, Stopped = age >= Effects.ReelStop(index) }
                    )
                end
                if age < Effects.ReelStop(3) then
                    if insertedSequence ~= sequence then
                        insertedSequence = sequence
                        Audio.PlayMuncher("Insert", anchor)
                    end
                    stopSpin = Audio.PlayMuncher("Roll", anchor)
                end
            end
        end
        if not processing then
            if rollGui or carrier or not busy then
                restore()
            end
            if not busy then
                return
            end
        end
        if busy then
            saveVisual()
        end
        local offset = if processing then math.sin(age * 25) * 0.1 else 0
        local jitter = if busy then math.sin((busyUntil - now) * 100) * 0.08 else 0
        for part, at in saved do
            if part.Parent then
                part.CFrame = CFrame.new(jitter, offset, 0) * at
            end
        end
        for index, reel in reels do
            local stopAt = Effects.ReelStop(index)
            local fastUntil = Config.ChewSeconds * 0.58
            local duration = stopAt - fastUntil
            local decel = math.clamp(age - fastUntil, 0, duration)
            local travel = math.min(age, fastUntil) + decel - decel * decel / (2 * duration)
            local distance = travel * (12 + index * 2) / (fastUntil + duration / 2)
            local stopped = age >= stopAt
            if stopped and not reel.Stopped and carrier then
                reel.Stopped = true
                Audio.PlayMuncher("ReelStop", carrier)
                if index == 3 then
                    if stopSpin then
                        stopSpin()
                        stopSpin = nil
                    end
                    local result = model:GetAttribute("ResultKind")
                    if result == "Win" or result == "Lose" then
                        Audio.PlayMuncher(result, carrier)
                        for _, lockedReel in reels do
                            for _, symbol in lockedReel.Symbols do
                                for _, icon in symbol:GetChildren() do
                                    if icon:IsA("ImageLabel") or icon:IsA("ViewportFrame") then
                                        icon.ImageColor3 = if result == "Win"
                                            then Style.Gold
                                            else Color3.fromRGB(165, 165, 165)
                                        TweenService
                                            :Create(icon, TweenInfo.new(0.12), { ImageColor3 = Color3.new(1, 1, 1) })
                                            :Play()
                                    end
                                end
                            end
                        end
                    end
                end
            end
            local output = model:GetAttribute("OutputId")
            reel.Outline.Color = palette.TextColor
            for row, symbol in reel.Symbols do
                symbol.Visible = not stopped or symbol.Name == output
                symbol.Position = UDim2.fromScale(0, if stopped then 0 else (row - 1 + distance) % #reel.Symbols - 1)
            end
        end
        if glow then
            glow.Color = palette.TextColor
            local lockAt = Effects.ReelStop(3)
            glow.Brightness = math.clamp((age - lockAt + 0.3) / 0.3, 0, 1) * 3
        end
    end,
        restore
end
return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="883">
            <Properties>
              <string name="Name">NotificationBadge</string>
              <string name="Source"><![CDATA[--!strict
local Registry = require(script.Parent.UIRegistry)
local Badge = {}
function Badge.Attach(button: GuiButton): ((boolean) -> (), () -> ())
    local host = Registry.Child(button, "Badge", { "Badge" }, "GuiObject") :: GuiObject?
    if host then
        host.Visible = false
    elseif game:GetService("RunService"):IsStudio() then
        warn("[MenuNotifications] Missing authored Badge on " .. button:GetFullName())
    end
    local detached = false
    return function(visible: boolean)
        if host and not detached then
            host.Visible = visible
        end
    end, function()
        detached = true
        if host then
            host.Visible = false
        end
    end
end
return Badge
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="884">
            <Properties>
              <string name="Name">PanelManager</string>
              <string name="Source"><![CDATA[--!strict
-- One visibility owner for major menus, independent of GUI/import identities.
-- Open/Close callbacks may yield for animations, but must finish their transition
-- before returning. Requests during a transition coalesce to the latest intent.
local PanelManager = {}

export type Callbacks = {
    Open: () -> (),
    Close: () -> (),
}
export type Handle = {
    Open: () -> (),
    Close: () -> (),
    Toggle: () -> (),
    Destroy: () -> (),
}
type Entry = { Id: string, Callbacks: Callbacks }
local registered: { [string]: Entry } = {}
local active: Entry? = nil
local requested: Entry? = nil
local transitioning = false

local function reconcile()
    if transitioning then
        return
    end
    transitioning = true
    local ok, message = xpcall(function()
        while active ~= requested do
            local previous = active
            if previous then
                previous.Callbacks.Close()
                active = nil
            end
            -- Read again after Close: it may yield while newer requests arrive.
            local nextPanel = requested
            if nextPanel then
                active = nextPanel
                nextPanel.Callbacks.Open()
            end
        end
    end, debug.traceback)
    transitioning = false
    if not ok then
        -- A failed close must never let another panel overlap the current one.
        requested = active
        warn("[PanelManager] " .. tostring(message))
    end
end

function PanelManager.Register(id: string, callbacks: Callbacks): Handle
    callbacks.Close() -- Registered views always start hidden, including replacements.
    local previous = registered[id]
    if previous and requested == previous then
        requested = nil
    end
    local entry: Entry = { Id = id, Callbacks = callbacks }
    registered[id] = entry
    reconcile()

    local function isRegistered(): boolean
        return registered[id] == entry
    end
    local function open()
        if isRegistered() then
            requested = entry
            reconcile()
        end
    end
    local function close()
        if requested == entry then
            requested = nil
            reconcile()
        end
    end
    return {
        Open = open,
        Close = close,
        Toggle = function()
            if requested == entry then
                close()
            else
                open()
            end
        end,
        Destroy = function()
            if isRegistered() then
                registered[id] = nil
            end
            close()
        end,
    }
end

function PanelManager.CloseAll()
    requested = nil
    reconcile()
end

function PanelManager.GetActive(): string?
    return if active then active.Id else nil
end

return PanelManager
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="885">
            <Properties>
              <string name="Name">RadialProgress</string>
              <string name="Source"><![CDATA[--!strict
-- A circular fill built from two clipped halves of one gradient-masked disc.
local RadialProgress = {}

export type View = { Root: Frame, Right: UIGradient, Left: UIGradient }

local diameter = 22
local half = diameter / 2
local mask = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0),
    NumberSequenceKeypoint.new(0.499, 0),
    NumberSequenceKeypoint.new(0.5, 1),
    NumberSequenceKeypoint.new(1, 1),
})

local function circle(parent: Instance, name: string, size: number, color: Color3): Frame
    local frame = Instance.new("Frame")
    frame.Name = name
    frame.Size = UDim2.fromScale(size / diameter, size / diameter)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.fromScale(0.5, 0.5)
    frame.BackgroundColor3 = color
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = frame
    frame.Parent = parent
    return frame
end

local function fillHalf(parent: Frame, name: string, x: number, gold: Color3): UIGradient
    local clip = Instance.new("Frame")
    clip.Name = name
    clip.BackgroundTransparency = 1
    clip.ClipsDescendants = true
    clip.Position = UDim2.fromScale(x / diameter, 0)
    clip.Size = UDim2.fromScale(0.5, 1)
    clip.Parent = parent

    local disc = circle(clip, "Fill", diameter, gold)
    disc.Size = UDim2.fromScale(2, 1)
    disc.Position = UDim2.fromScale((half - x) / half, 0.5)
    local gradient = Instance.new("UIGradient")
    gradient.Transparency = mask
    gradient.Parent = disc
    return gradient
end

function RadialProgress.Create(parent: Frame, gold: Color3, track: Color3): View
    local root = Instance.new("Frame")
    root.Name = "RadialProgress"
    root.BackgroundTransparency = 1
    root.Size = UDim2.fromScale(1, 1)
    root.Parent = parent
    circle(root, "Track", diameter, track)
    local right = fillHalf(root, "RightHalf", half, gold)
    local left = fillHalf(root, "LeftHalf", 0, gold)
    circle(root, "InnerCutout", 16, track)
    local view = { Root = root, Right = right, Left = left }
    RadialProgress.SetProgress(view, 0)
    return view
end

function RadialProgress.SetProgress(view: View, progress: number)
    local angle = math.clamp(progress, 0, 1) * 360
    view.Right.Rotation = math.min(angle, 180)
    view.Left.Rotation = math.max(angle, 180)
end

return RadialProgress
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="886">
            <Properties>
              <string name="Name">RipenessDisplayState</string>
              <string name="Source"><![CDATA[--!strict
local Ripeness = require(game:GetService("ReplicatedStorage").Shared.Constants.Ripeness)
local State = {}

export type ItemView = { Id: string, Index: number, Ripe: boolean, Progress: number }

function State.Progress(pad: BasePart, index: number, now: number): number
    local prefix = "StashItem" .. index
    if pad:GetAttribute(prefix .. "IsRipe") == true then
        return 1
    end
    local storedSeconds = pad:GetAttribute(prefix .. "StoredSeconds")
    local accumulated = if typeof(storedSeconds) == "number" then storedSeconds else 0
    local storedAt = pad:GetAttribute(prefix .. "StoredAt")
    local elapsed = if typeof(storedAt) == "number" then math.max(0, now - storedAt) else 0
    local duration = pad:GetAttribute("RipenessSeconds")
    return math.clamp((accumulated + elapsed) / (if typeof(duration) == "number" then duration else Ripeness.RipenessSeconds), 0, 1)
end

function State.Read(pad: BasePart, now: number): ({ ItemView }, string)
    local slotCount = pad:GetAttribute("StashCount")
    local count = if typeof(slotCount) == "number" then slotCount else 0
    local items: { ItemView } = {}
    local signature: { string } = {}
    for index = 1, count do
        local prefix = "StashItem" .. index
        local id = pad:GetAttribute(prefix .. "Id")
        if typeof(id) == "string" then
            local ripe = pad:GetAttribute(prefix .. "IsRipe") == true
            table.insert(items, { Id = id, Index = index, Ripe = ripe, Progress = State.Progress(pad, index, now) })
            table.insert(signature, id .. ":" .. tostring(ripe))
        end
    end
    table.sort(items, function(a, b)
        if a.Ripe ~= b.Ripe then
            return a.Ripe
        end
        if a.Progress ~= b.Progress then
            return a.Progress > b.Progress
        end
        return a.Id < b.Id
    end)
    return items, table.concat(signature, "|")
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="887">
            <Properties>
              <string name="Name">RipenessTutorialText</string>
              <string name="Source"><![CDATA[--!strict
local Text = {}
Text.Copy = "Ingredients can RIPEN while stored.\nRIPE Ingredients are worth +25%"

function Text.Rich(): string
    local message = Text.Copy:gsub("RIPEN", '<font color="#FFDE73">RIPEN</font>')
    message = message:gsub("RIPE Ingredients", '<font color="#FFDE73">RIPE</font> Ingredients')
    message = message:gsub("%+25%%", '<font color="#FFDE73">+25%%</font>')
    return message
end

return Text
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="888">
            <Properties>
              <string name="Name">ScrapbookPresentation</string>
              <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Catalog = require(Shared.Constants.DiscoveryCatalog)
local Artwork = require(Shared.Constants.ScrapbookArtwork)
local MoneyFormat = require(Shared.MoneyFormat)
local Types = require(Shared.Types)
local Registry = require(script.Parent.UIRegistry)
local RarityStyle = require(script.Parent.IngredientPickupPromptStyle)
local Viewport = require(script.Parent.IngredientViewport)
local PreviewIds = require(Shared.Constants.ScrapbookPreviews)
local Presentation = {}
export type Binding = {
    Root: ScreenGui,
    Panel: GuiObject,
    Scroll: ScrollingFrame,
    Template: Frame,
    Title: TextLabel,
    Fields: { Instance },
}
export type View = {
    RenderState: (Types.DiscoveryState) -> (),
    UpdateDiscovery: (Types.DiscoveryEvent) -> (),
    Destroy: () -> (),
}

function Presentation.FormatValue(value: number): string
    return MoneyFormat.Announcement(value)
end

local function child(parent: Instance?, name: string, class: string): Instance?
    return Registry.Child(parent, name, { name, name .. "_txt" }, class)
end

function Presentation.Resolve(playerGui: PlayerGui): Binding?
    local selected: Instance? = nil
    local root: ScreenGui? = nil
    for _, desktop in Registry.Desktops(playerGui) do
        local active = Registry.ActiveRoot(desktop, playerGui)
        if active then
            if selected then
                return nil
            end
            selected, root = desktop, active
        end
    end
    if not selected or not root then
        return nil
    end
    local panel = Registry.Child(Registry.Content(selected), "Panel:Index", { "Index", "Index_panel" }, "GuiObject")
    local scroll =
        Registry.Child(panel, "CardsViewport", { "CardsViewport", "CardsViewport_scroll_grid" }, "ScrollingFrame")
    local template = child(scroll, "IndexCardTemplate", "Frame")
    local title = child(child(panel, "Header", "GuiObject"), "INDEX", "TextLabel")
    if not panel or not scroll or not template or not title then
        return nil
    end
    local fields: { [string]: string } = {
        FruitImage = "ImageLabel",
        IngredientLabel = "TextLabel",
        IngredientValue = "TextLabel",
        RarityLabel = "TextLabel",
    }
    local controls: { Instance } = {}
    for name, class in fields do
        local control = child(template, name, class)
        if not control then
            return nil
        end
        table.insert(controls, control)
    end
    table.sort(controls, function(a, b)
        return a.Name < b.Name
    end)
    return {
        Root = root,
        Panel = panel :: GuiObject,
        Scroll = scroll :: ScrollingFrame,
        Template = template :: Frame,
        Title = title :: TextLabel,
        Fields = controls,
    }
end

-- Pixel cell heights preserve the authored card aspect ratio without a canvas
-- feedback loop. Four cells plus three gaps fit the padded viewport exactly.
function Presentation.CellSize(width: number, aspect: number): UDim2
    local cell = math.max(1, (width - 16 - 3 * 8) / 4)
    return UDim2.fromOffset(cell, math.max(1, cell * aspect))
end

-- Both registries can use the authored card fields; category controls are
-- intentionally absent until Figma supplies them.
function Presentation.RenderCard(
    card: Frame,
    discovered: boolean,
    metadata: { DisplayName: string, Rarity: string?, Value: number?, Image: string }
)
    local image = child(card, "FruitImage", "ImageLabel") :: ImageLabel
    local name = child(card, "IngredientLabel", "TextLabel") :: TextLabel
    local rarity = child(card, "RarityLabel", "TextLabel") :: TextLabel
    local value = child(card, "IngredientValue", "TextLabel") :: TextLabel
    local asset = if discovered then metadata.Image else ""
    image.Image = asset
    image.Visible = asset ~= ""
    name.Text = if discovered then metadata.DisplayName else "???"
    local tier = metadata.Rarity or "Common"
    rarity.Text = string.upper(tier)
    local palette = (RarityStyle.RarityStyles :: any)[tier] or RarityStyle.RarityStyles.Common
    rarity.TextColor3 = palette.TextColor
    value.Text = if discovered and metadata.Value ~= nil then Presentation.FormatValue(metadata.Value) else ""
    value.Visible = discovered and metadata.Value ~= nil
end

function Presentation.Create(binding: Binding, state: Types.DiscoveryState): View
    local scroll, template = binding.Scroll, binding.Template
    local grid = scroll:FindFirstChildOfClass("UIGridLayout") :: UIGridLayout?
    local ownsGrid = grid == nil
    if not grid then
        local created = Instance.new("UIGridLayout")
        created.Parent = scroll
        grid = created
    end
    local layout = grid :: UIGridLayout
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.FillDirectionMaxCells = 4
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.CellPadding = UDim2.fromOffset(8, 8)
    local padding = scroll:FindFirstChildOfClass("UIPadding") :: UIPadding?
    local ownsPadding = padding == nil
    if not padding then
        local created = Instance.new("UIPadding")
        created.Parent = scroll
        padding = created
    end
    local inset = padding :: UIPadding
    inset.PaddingLeft, inset.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
    inset.PaddingTop, inset.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8)
    scroll.ClipsDescendants = true
    scroll.ScrollingDirection = Enum.ScrollingDirection.Y
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.fromOffset(0, 0)
    local originalTitle = binding.Title.Text
    local examples: { GuiObject } = {}
    local wasVisible = template.Visible
    template.Visible = false
    for _, instance in scroll:GetChildren() do
        if instance:GetAttribute("ScrapbookGenerated") == true then
            instance:Destroy()
            continue
        end
        if instance.Name == "IndexCard" and instance:IsA("GuiObject") and instance.Visible then
            instance.Visible = false
            table.insert(examples, instance)
        end
    end
    local aspect = 208 / 234 -- exported design: 234 x 208
    local function resize()
        layout.CellSize = Presentation.CellSize(scroll.AbsoluteWindowSize.X, aspect)
    end
    resize()
    local resized = scroll:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(resize)
    local cards: { Frame } = {}
    local stopped = false
    local previews: { [Frame]: () -> () } = {}
    local previewDiscovered: { [Frame]: boolean } = {}
    local previewCards: { { Card: Frame, Image: ImageLabel, Id: string } } = {}
    local previewConnections: { RBXScriptConnection } = {}
    local pending = false
    local function refreshPreviews()
        pending = false
        if stopped then
            return
        end
        local open = binding.Root.Enabled
        local ancestor: Instance? = scroll
        while ancestor and ancestor ~= binding.Root do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then
                open = false
            end
            ancestor = ancestor.Parent
        end
        for _, item in previewCards do
            local card, image = item.Card, item.Image
            local top, bottom = scroll.AbsolutePosition.Y, scroll.AbsolutePosition.Y + scroll.AbsoluteWindowSize.Y
            local visible = open
                and card.Visible
                and card.Parent == scroll
                and card.AbsolutePosition.Y < bottom
                and card.AbsolutePosition.Y + card.AbsoluteSize.Y > top
            local discovered = state.Ingredients[item.Id] == true
            if previews[card] and (not visible or previewDiscovered[card] ~= discovered) then
                previews[card]()
                previews[card] = nil
                previewDiscovered[card] = nil
            end
            if visible and not previews[card] then
                local cleanup = Viewport.Create(image, item.Id, not discovered)
                if cleanup then
                    previews[card] = cleanup
                    previewDiscovered[card] = discovered
                end
            end
            image.Visible = state.Ingredients[item.Id] == true and image.Image ~= "" and previews[card] == nil
        end
    end
    local function schedulePreviews()
        if stopped or pending then
            return
        end
        pending = true
        task.defer(refreshPreviews)
    end
    local function watch(instance: Instance, property: string)
        table.insert(previewConnections, instance:GetPropertyChangedSignal(property):Connect(schedulePreviews))
    end
    watch(scroll, "CanvasPosition")
    watch(scroll, "AbsoluteWindowSize")
    watch(scroll, "AbsolutePosition")
    local ancestor: Instance? = scroll
    while ancestor do
        if ancestor:IsA("GuiObject") then
            watch(ancestor, "Visible")
        elseif ancestor:IsA("ScreenGui") then
            watch(ancestor, "Enabled")
        end
        ancestor = ancestor.Parent
    end
    table.insert(previewConnections, Shared.DescendantAdded:Connect(schedulePreviews))
    local updates: { [string]: (boolean) -> () } = {}
    local entries = Catalog.GetIngredients()
    local function counter()
        local count = 0
        for _, entry in entries do
            if state.Ingredients[entry.Id] then
                count += 1
            end
        end
        binding.Title.Text = string.format("INDEX %d/%d", count, #entries)
    end
    for index, entry in entries do
        local card = template:Clone()
        card.Name = "CollectionCard_" .. index -- locked instance names never identify an ingredient
        card:SetAttribute("ScrapbookGenerated", true)
        card.LayoutOrder = index
        local function render(discovered: boolean)
            if previews[card] and previewDiscovered[card] ~= discovered then
                previews[card]()
                previews[card] = nil
                previewDiscovered[card] = nil
            end
            Presentation.RenderCard(card, discovered, {
                DisplayName = entry.DisplayName,
                Rarity = entry.Rarity,
                Value = entry.Value,
                Image = if discovered then Artwork.GetIngredient(entry.Id) else "",
            })
            if previews[card] then
                (child(card, "FruitImage", "ImageLabel") :: ImageLabel).Visible = false
            end
            schedulePreviews()
        end
        updates[entry.Id] = render
        render(state.Ingredients[entry.Id] == true)
        card.Visible = true
        card.Parent = scroll
        table.insert(cards, card)
        if not (PreviewIds :: { [string]: boolean })[entry.Id] then
            continue
        end
        table.insert(previewCards, {
            Card = card,
            Image = child(card, "FruitImage", "ImageLabel") :: ImageLabel,
            Id = entry.Id,
        })
        watch(card, "Visible")
        watch(card, "AbsolutePosition")
        watch(card, "AbsoluteSize")
        table.insert(previewConnections, card.AncestryChanged:Connect(schedulePreviews))
    end
    counter()
    return {
        RenderState = function(nextState: Types.DiscoveryState)
            if stopped then
                return
            end
            state = nextState
            for id, render in updates do
                render(state.Ingredients[id] == true)
            end
            counter()
        end,
        UpdateDiscovery = function(event: Types.DiscoveryEvent)
            if stopped then
                return
            end
            if event.Kind == "Ingredient" and updates[event.Id] then
                updates[event.Id](true)
                counter()
            end
        end,
        Destroy = function()
            if stopped then
                return
            end
            stopped = true
            resized:Disconnect()
            for _, connection in previewConnections do
                connection:Disconnect()
            end
            for _, cleanup in previews do
                cleanup()
            end
            table.clear(previews)
            table.clear(previewDiscovered)
            for _, card in cards do
                card:Destroy()
            end
            if ownsGrid then
                layout:Destroy()
            end
            if ownsPadding then
                inset:Destroy()
            end
            template.Visible = wasVisible
            for _, example in examples do
                example.Visible = true
            end
            binding.Title.Text = originalTitle
        end,
    }
end

-- Coalesce imported subtrees, and ignore changes from our own cloned cards.
function Presentation.Observe(
    playerGui: PlayerGui,
    state: Types.DiscoveryState,
    changed: (View?, ScreenGui?) -> ()
): () -> ()
    local binding: Binding? = nil
    local view: View? = nil
    local stopped, queued = false, false
    local watched: { RBXScriptConnection } = {}
    local schedule: () -> ()
    local function scan()
        queued = false
        if stopped then
            return
        end
        for _, connection in watched do
            connection:Disconnect()
        end
        table.clear(watched)
        for _, desktop in Registry.Desktops(playerGui) do
            local ancestor: Instance? = desktop
            while ancestor and ancestor ~= playerGui do
                if ancestor:IsA("ScreenGui") or ancestor:IsA("GuiObject") then
                    table.insert(
                        watched,
                        ancestor
                            :GetPropertyChangedSignal(if ancestor:IsA("ScreenGui") then "Enabled" else "Visible")
                            :Connect(schedule)
                    )
                end
                ancestor = ancestor.Parent
            end
        end
        local nextBinding = Presentation.Resolve(playerGui)
        if nextBinding then
            local identifiers: { Instance } =
                { nextBinding.Panel, nextBinding.Scroll, nextBinding.Template, nextBinding.Title }
            for _, field in nextBinding.Fields do
                table.insert(identifiers, field)
            end
            for _, identifier in identifiers do
                table.insert(watched, identifier:GetPropertyChangedSignal("Name"):Connect(schedule))
                table.insert(watched, identifier:GetAttributeChangedSignal("BlenderUI"):Connect(schedule))
            end
        end
        local sameFields = binding ~= nil and nextBinding ~= nil
        if binding and nextBinding then
            for index, field in binding.Fields do
                if field ~= nextBinding.Fields[index] then
                    sameFields = false
                    break
                end
            end
        end
        if
            binding
            and nextBinding
            and binding.Root == nextBinding.Root
            and binding.Panel == nextBinding.Panel
            and binding.Scroll == nextBinding.Scroll
            and binding.Template == nextBinding.Template
            and binding.Title == nextBinding.Title
            and sameFields
        then
            return
        end
        if not binding and not nextBinding then
            return
        end
        if view then
            view.Destroy()
        end
        view, binding = nil, nextBinding
        if nextBinding then
            view = Presentation.Create(nextBinding, state)
        end
        changed(view, if nextBinding then nextBinding.Root else nil)
    end
    schedule = function()
        if stopped or queued then
            return
        end
        queued = true
        task.defer(scan)
    end
    local added = playerGui.DescendantAdded:Connect(schedule)
    local removing = playerGui.DescendantRemoving:Connect(schedule)
    scan()
    return function()
        if stopped then
            return
        end
        stopped = true
        added:Disconnect()
        removing:Disconnect()
        for _, connection in watched do
            connection:Disconnect()
        end
        if view then
            view.Destroy()
        end
        view, binding = nil, nil
        changed(nil, nil)
    end
end
return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="889">
            <Properties>
              <string name="Name">ScreenGuis</string>
              <string name="Source"><![CDATA[-- Main HUD

-- TODO: stamina bar synced to Player:GetAttribute("StaminaCurrent"/"StaminaMax").
-- SprintController owns the mobile hold-to-sprint button.
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="890">
            <Properties>
              <string name="Name">SettingsGui</string>
              <string name="Source"><![CDATA[--!strict
-- Imported artwork only. Panel visibility remains owned by FramewispMenus.
local Registry = require(script.Parent.UIRegistry)
local Input = game:GetService("UserInputService")
local Gui = {}
export type View = {
    Root: ScreenGui,
    Panel: GuiObject,
    Modes: { [string]: GuiButton },
    MusicOn: GuiButton?,
    MusicOff: GuiButton?,
    Status: TextLabel?,
    Rename: GuiButton?,
    Kick: GuiButton?,
    Track: GuiObject?,
    Thumb: GuiObject?,
    Fill: GuiObject?,
    Outer: GuiObject?,
    Dragging: boolean,
    Issues: { string },
}

function Gui.Resolve(playerGui: PlayerGui): View?
    local selected: Instance? = nil
    local root: ScreenGui? = nil
    for _, desktop in Registry.Desktops(playerGui) do
        local candidate = Registry.ActiveRoot(desktop, playerGui)
        if candidate then
            if selected then
                return nil
            end
            selected, root = desktop, candidate
        end
    end
    if not selected or not root then
        return nil
    end
    local panel =
        Registry.Child(Registry.Content(selected), "Panel:Settings", { "Settings", "Settings_panel" }, "GuiObject")
    if not panel then
        return nil
    end
    local issues: { string } = {}
    local function child(parent: Instance?, role: string, names: { string }, class: string): Instance?
        local result = Registry.Child(parent, role, names, class)
        if not result then
            table.insert(issues, role)
        end
        return result
    end
    local plot = child(panel, "PLOT", { "PLOT" }, "GuiObject")
    local music = child(panel, "MUSIC", { "MUSIC" }, "GuiObject")
    local modes: { [string]: GuiButton } = {}
    local names: { [string]: { string } } = {
        FriendsOnly = { "Friends", "Friends_button_smooth" },
        Open = { "Open", "Open_button_smooth", "All", "All_button_smooth" },
        Closed = { "Closed", "Closed_button_smooth" },
    }
    for mode, fallbacks in names do
        local row = child(plot, mode, fallbacks, "GuiButton")
        if row then
            modes[mode] = row :: GuiButton
        end
    end
    local track = child(music, "Slider", { "Slider" }, "GuiObject")
    local thumb = child(track, "Knob", { "Knob" }, "GuiObject")
    local fill = child(track, "ProgressBar", { "ProgressBar" }, "GuiObject")
    return {
        Root = root,
        Panel = panel :: GuiObject,
        Modes = modes,
        MusicOn = child(music, "MusicOn", { "MusicOn", "MusicOn_button_smooth" }, "GuiButton") :: GuiButton?,
        MusicOff = child(music, "MusicOff", { "MusicOff", "MusicOff_button_smooth" }, "GuiButton") :: GuiButton?,
        Status = child(plot, "Title", { "Title" }, "TextLabel") :: TextLabel?,
        Rename = child(plot, "Rename", { "Rename", "Rename_button_smooth" }, "GuiButton") :: GuiButton?,
        Kick = child(plot, "Kick", { "Kick", "Kick_button_smooth" }, "GuiButton") :: GuiButton?,
        Track = track :: GuiObject?,
        Thumb = thumb :: GuiObject?,
        Fill = fill :: GuiObject?,
        Outer = Registry.Child(track, "OuterSlider", { "OuterSlider" }, "GuiObject") :: GuiObject?,
        Dragging = false,
        Issues = issues,
    }
end

local function bounds(view: View): GuiObject?
    local track = view.Track
    if track and track.AbsoluteSize.X > 0 then
        return track
    end
    local outer = view.Outer
    return if outer and outer.AbsoluteSize.X > 0 then outer else nil
end

local function renderVolume(view: View, value: number)
    local track, thumb, fill = view.Track, view.Thumb, view.Fill
    if not track or not thumb or not fill then
        return
    end
    local range = bounds(view)
    local offset = if range and range ~= track then range.AbsolutePosition.X - track.AbsolutePosition.X else 0
    local widthOffset = if range and range ~= track then value * range.AbsoluteSize.X else 0
    local position, size, fillPosition = thumb.Position, fill.Size, fill.Position
    thumb.Position = UDim2.new(value, offset + widthOffset, position.Y.Scale, position.Y.Offset)
    fill.Size = UDim2.new(value, widthOffset, size.Y.Scale, size.Y.Offset)
    -- The export centers ProgressBar's anchor. Keep its left edge at the
    -- track's left while changing width, without altering its anchor or Y.
    fill.Position = UDim2.new(
        value * fill.AnchorPoint.X,
        offset + widthOffset * fill.AnchorPoint.X,
        fillPosition.Y.Scale,
        fillPosition.Y.Offset
    )
end

function Gui.RefreshVolume(view: View, value: number)
    if not view.Dragging then
        renderVolume(view, value)
    end
end

function Gui.Select(button: GuiButton, selected: boolean)
    local scale = Registry.Child(button, "SelectionScale", { "SelectionScale" }, "UIScale") :: UIScale?
    if scale then
        scale.Scale = if selected then 1.1 else 1
    end
    local background = Registry.Child(button, "BuyBackground", { "BuyBackground" }, "GuiObject") :: GuiObject?
    if background then
        background.BackgroundColor3 = if selected then Color3.fromRGB(45, 159, 123) else Color3.fromRGB(43, 56, 70)
        local stroke = Registry.Child(background, "UIStroke", { "UIStroke" }, "UIStroke") :: UIStroke?
        if stroke then
            stroke.Color = if selected then Color3.fromRGB(255, 222, 115) else Color3.fromRGB(18, 22, 30)
            stroke.Thickness = if selected then 3.5 else 2
        end
    end
end

function Gui.Observe(
    playerGui: PlayerGui,
    changed: (View?) -> (),
    mode: (string) -> (),
    enabled: (boolean) -> (),
    volume: (number) -> number,
    rename: (() -> ())?,
    kick: (() -> ())?
): () -> ()
    local connections: { RBXScriptConnection } = {}
    local lifetime: { RBXScriptConnection } = {}
    local restoreInput: (() -> ())? = nil
    local stopped, queued = false, false
    local lastIssue = ""
    local view: View? = nil
    local schedule: () -> ()
    local function clear()
        if restoreInput then
            restoreInput()
            restoreInput = nil
        end
        for _, connection in connections do
            connection:Disconnect()
        end
        table.clear(connections)
    end
    local function scan()
        queued = false
        if stopped then
            return
        end
        local current = Gui.Resolve(playerGui)
        local issue = if current
            then table.concat(current.Issues, ", ")
            else "Settings panel missing or desktop ambiguous"
        if issue ~= "" and issue ~= lastIssue then
            warn("SettingsGui: missing, wrong-class or ambiguous binding: " .. issue)
        end
        lastIssue = issue
        local previous = view
        if
            current
            and previous
            and current.Root == previous.Root
            and current.Panel == previous.Panel
            and current.MusicOn == previous.MusicOn
            and current.MusicOff == previous.MusicOff
            and current.Status == previous.Status
            and current.Rename == previous.Rename
            and current.Kick == previous.Kick
            and current.Track == previous.Track
            and current.Thumb == previous.Thumb
            and current.Fill == previous.Fill
            and current.Outer == previous.Outer
        then
            local same = true
            for _, modeName in { "Open", "FriendsOnly", "Closed" } do
                if current.Modes[modeName] ~= previous.Modes[modeName] then
                    same = false
                end
            end
            if same then
                return
            end
        end
        clear()
        view = current
        -- Root visibility changes can select a different imported desktop.
        for _, desktop in Registry.Desktops(playerGui) do
            local ancestor: Instance? = desktop
            while ancestor and ancestor ~= playerGui do
                if ancestor:IsA("GuiObject") or ancestor:IsA("ScreenGui") then
                    table.insert(
                        connections,
                        ancestor
                            :GetPropertyChangedSignal(if ancestor:IsA("ScreenGui") then "Enabled" else "Visible")
                            :Connect(schedule)
                    )
                end
                ancestor = ancestor.Parent
            end
        end
        if current then
            for value, button in current.Modes do
                table.insert(
                    connections,
                    button.Activated:Connect(function()
                        if current.Panel.Visible and button.Active then
                            mode(value)
                        end
                    end)
                )
            end
            local function bindAction(button: GuiButton?, callback: (() -> ())?)
                if button and callback then
                    table.insert(
                        connections,
                        button.Activated:Connect(function()
                            if current.Panel.Visible and button.Visible and button.Active then
                                callback()
                            end
                        end)
                    )
                end
            end
            bindAction(current.Rename, rename)
            bindAction(current.Kick, kick)
            local function bindMusic(button: GuiButton?, value: boolean)
                if button then
                    table.insert(
                        connections,
                        button.Activated:Connect(function()
                            enabled(value)
                        end)
                    )
                end
            end
            bindMusic(current.MusicOn, true)
            bindMusic(current.MusicOff, false)
            local track = current.Track
            if track and current.Thumb and current.Fill then
                local drag: InputObject? = nil
                local oldActive = track.Active
                track.Active = current.Panel.Visible or oldActive
                restoreInput = function()
                    current.Dragging = false
                    track.Active = oldActive
                end
                local function update(input: InputObject)
                    local range = bounds(current)
                    if range then
                        local value = volume(
                            math.clamp((input.Position.X - range.AbsolutePosition.X) / range.AbsoluteSize.X, 0, 1)
                        )
                        renderVolume(current, value)
                    end
                end
                local function begin(input: InputObject)
                    if
                        current.Panel.Visible
                        and bounds(current) ~= nil
                        and drag ~= input
                        and (
                            input.UserInputType == Enum.UserInputType.Touch
                            or input.UserInputType == Enum.UserInputType.MouseButton1
                        )
                    then
                        drag = input
                        current.Dragging = true
                        update(input)
                    end
                end
                table.insert(connections, track.InputBegan:Connect(begin))
                for _, surface in track:GetChildren() do
                    if surface:IsA("GuiObject") then
                        table.insert(connections, surface.InputBegan:Connect(begin))
                    end
                end
                table.insert(
                    connections,
                    Input.InputChanged:Connect(function(input: InputObject)
                        local held = drag
                        if
                            held
                            and current.Panel.Visible
                            and (
                                input == held
                                or (
                                    held.UserInputType == Enum.UserInputType.MouseButton1
                                    and input.UserInputType == Enum.UserInputType.MouseMovement
                                )
                            )
                        then
                            update(input)
                        end
                    end)
                )
                table.insert(
                    connections,
                    Input.InputEnded:Connect(function(input: InputObject)
                        local held = drag
                        if
                            input == held
                            or (
                                held
                                and held.UserInputType == Enum.UserInputType.MouseButton1
                                and input.UserInputType == Enum.UserInputType.MouseButton1
                            )
                        then
                            drag = nil
                            current.Dragging = false
                            changed(current)
                        end
                    end)
                )
                -- A layout pass can replace the fallback bounds after opening.
                local layoutSurfaces: { GuiObject } = { track }
                if current.Outer then
                    table.insert(layoutSurfaces, current.Outer)
                end
                for _, surface in layoutSurfaces do
                    for _, property in { "AbsolutePosition", "AbsoluteSize" } do
                        table.insert(
                            connections,
                            surface:GetPropertyChangedSignal(property):Connect(function()
                                changed(current)
                            end)
                        )
                    end
                end
                -- Active is input presentation only; no instances are created.
                table.insert(
                    connections,
                    current.Panel:GetPropertyChangedSignal("Visible"):Connect(function()
                        drag = nil
                        current.Dragging = false
                        track.Active = if current.Panel.Visible then true else oldActive
                    end)
                )
            end
            table.insert(
                connections,
                current.Panel:GetPropertyChangedSignal("Visible"):Connect(function()
                    changed(current)
                end)
            )
        end
        changed(current)
    end
    schedule = function()
        if stopped or queued then
            return
        end
        queued = true
        task.defer(scan)
    end
    table.insert(lifetime, playerGui.DescendantAdded:Connect(schedule))
    table.insert(
        lifetime,
        playerGui.DescendantRemoving:Connect(function(instance)
            local current = view
            if current then
                local affected = instance == current.Root
                    or instance == current.Panel
                    or current.Panel:IsDescendantOf(instance)
                local bindings: { Instance } = {}
                for _, button in current.Modes do
                    table.insert(bindings, button)
                end
                local optionalBindings: { Instance? } = {
                    current.MusicOn,
                    current.MusicOff,
                    current.Status,
                    current.Track,
                    current.Thumb,
                    current.Fill,
                    current.Outer,
                    current.Rename,
                    current.Kick,
                }
                for _, bound in optionalBindings do
                    if bound then
                        table.insert(bindings, bound)
                    end
                end
                for _, bound in bindings do
                    if bound == instance or bound:IsDescendantOf(instance) then
                        affected = true
                    end
                end
                if affected then
                    clear()
                    view = nil
                    changed(nil)
                end
            end
            schedule()
        end)
    )
    scan()
    return function()
        stopped = true
        clear()
        for _, connection in lifetime do
            connection:Disconnect()
        end
        changed(nil)
    end
end

return Gui
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="891">
            <Properties>
              <string name="Name">SmoothiePickupPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local Definitions = require(game:GetService("ReplicatedStorage").Shared.Constants.Ingredients)
local MoneyFormat = require(game:GetService("ReplicatedStorage").Shared.MoneyFormat)
local Input = require(script.Parent.InteractionPromptPresentation)
local IngredientPresentation = require(script.Parent.IngredientPickupPromptPresentation)
local Style = require(script.Parent.IngredientPickupPromptStyle)
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local Presentation = { Width = 460, Height = 160 + Style.ValueHeight + Style.InputSpacing }
type Row = { Id: string, Name: string, Rarity: string }

-- Display-only ordered metadata. Never aggregate duplicate ingredients.
function Presentation.Rows(object: Instance): { Row }?
    local rows: { Row } = {}
    for index = 1, 3 do
        local id = object:GetAttribute("IngredientId" .. index)
        local definition = if typeof(id) == "string" then Definitions[id] else nil
        if not definition then
            return nil
        end
        local rarity = Style.Resolve(definition)
        table.insert(rows, { Id = definition.Id, Name = definition.DisplayName or definition.Id, Rarity = rarity })
    end
    return rows
end

function Presentation.Create(
    prompt: ProximityPrompt,
    object: BasePart | Model,
    rows: { Row },
    parent: Instance,
    inputType: Enum.ProximityPromptInputType
): (() -> (), () -> ())
    local anchor = if object:IsA("BasePart")
        then object
        else object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    assert(anchor and anchor:IsA("BasePart"))
    local cleanup, gui = Input.Create(prompt, anchor, parent, inputType, {
        InputOnly = true,
        WidthStuds = 14.8,
        HeightStuds = 6.2,
        CanvasWidth = Presentation.Width,
        CanvasHeight = Presentation.Height,
        TouchWidth = if inputType == Enum.ProximityPromptInputType.Touch then Style.MobileTouchSize else nil,
        TouchHeight = Style.MobileTouchSize,
        TouchCenterY = (114 + Style.ValueHeight + Style.InputSpacing + Style.InputHeight / 2) / Presentation.Height,
        TextSize = Style.InputTextSize,
        MaxDistance = Style.MaxDistance,
    })
    local strokeCleanups: { () -> () } = {}
    gui.Name = "SmoothiePickupPromptDisplay"
    gui.SizeOffset = Vector2.new(0, 0.5)
    for index = 1, 3 do
        local row = rows[index]
        local palette = (Style.RarityStyles :: any)[row.Rarity]
        local container = Instance.new("Frame")
        container.Active = false
        container.Name = "IngredientRow" .. index
        container.Position = UDim2.fromScale(0, (index - 1) * 38 / Presentation.Height)
        container.Size = UDim2.fromScale(1, 36 / Presentation.Height)
        container.BackgroundTransparency = 1
        container.Parent = gui
        for _, column in
            {
                {
                    Name = "Rarity",
                    Text = row.Rarity,
                    X = 0,
                    Width = 170,
                    Color = palette.TextColor,
                    Stroke = palette.StrokeColor,
                    Align = Enum.TextXAlignment.Right,
                },
                {
                    Name = "IngredientName",
                    Text = row.Name,
                    X = 186,
                    Width = Presentation.Width - 186,
                    Color = Style.NameColor,
                    Stroke = Style.StrokeColor,
                    Align = Enum.TextXAlignment.Left,
                },
            }
        do
            local label = Instance.new("TextLabel")
            label.Active = false
            label.Name, label.Text = column.Name, column.Text
            label.Position = UDim2.fromScale(column.X / Presentation.Width, 0)
            label.Size = UDim2.fromScale(column.Width / Presentation.Width, 1)
            label.BackgroundTransparency = 1
            label.Font, label.TextSize, label.TextScaled = Style.Font, 25, true
            label.TextColor3, label.TextXAlignment = column.Color, column.Align
            local limit = Instance.new("UITextSizeConstraint")
            limit.MinTextSize, limit.MaxTextSize, limit.Parent = 1, 1000, label
            table.insert(
                strokeCleanups,
                BillboardStyle.ApplyWorldStroke(label, gui, {
                    Color = column.Stroke,
                    ThicknessStuds = Style.StrokeThicknessStuds,
                    Transparency = Style.TextStrokeTransparency,
                })
            )
            label.Parent = container
        end
    end
    local total = 0
    for _, row in rows do
        total += Definitions[row.Id].Value
    end
    local value = Instance.new("TextLabel")
    value.Active = false
    value.Name, value.Text = "SmoothieValue", MoneyFormat.Compact(total)
    value.Position = UDim2.fromScale(0, 114 / Presentation.Height)
    value.Size = UDim2.fromScale(1, Style.ValueHeight / Presentation.Height)
    value.BackgroundTransparency = 1
    value.Font, value.TextSize = Style.Font, Style.ValueTextSize
    value.TextColor3 = Style.ValueColor
    value.TextStrokeTransparency = 1
    value.TextScaled = true
    local limit = Instance.new("UITextSizeConstraint")
    limit.MinTextSize, limit.MaxTextSize, limit.Parent = 1, 1000, value
    table.insert(
        strokeCleanups,
        BillboardStyle.ApplyWorldStroke(value, gui, {
            Color = Style.StrokeColor,
            ThicknessStuds = Style.StrokeThicknessStuds,
            Transparency = Style.TextStrokeTransparency,
        })
    )
    value.Parent = gui
    local action = gui:FindFirstChild("Action") :: TextButton
    action.Position = UDim2.fromScale(0, (114 + Style.ValueHeight + Style.InputSpacing) / Presentation.Height)
    action.Size = UDim2.fromScale(1, Style.InputHeight / Presentation.Height)
    local function update()
        gui.StudsOffsetWorldSpace = IngredientPresentation.Top(object) - anchor.Position + Style.PromptStudsOffset
    end
    update()
    return function()
        for _, stop in strokeCleanups do
            stop()
        end
        cleanup()
    end,
        update
end
return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="892">
            <Properties>
              <string name="Name">StandNameEditor</string>
              <string name="Source"><![CDATA[--!strict
local Style = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.StandIdentity)
local Input = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")
local UI = {}

export type View = {
    Gui: ScreenGui,
    Box: TextBox,
    Status: TextLabel,
    Save: TextButton,
    Show: () -> (),
    Hide: (string?) -> (),
    TraceSelection: (string) -> (),
}

function UI.Create(parent: Instance, save: () -> (), close: () -> ()): View
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn, gui.Enabled = "StandNameEditor", false, false
    gui.DisplayOrder = 30
    gui.Parent = parent
    local area = Instance.new("Frame")
    area.Name, area.BackgroundTransparency = "UsableArea", 1
    area.Size, area.Parent = UDim2.fromScale(1, 1), gui
    local panel = Instance.new("Frame")
    panel.Name = "RenameCard"
    panel.AnchorPoint = Vector2.new(0.5, 1)
    panel.Position = UDim2.new(0.5, 0, 1, -20)
    panel.Size = UDim2.new(0.9, 0, 0, 154)
    panel.BackgroundColor3 = Color3.fromRGB(25, 29, 38)
    panel.BackgroundTransparency = 0.28
    panel.BorderSizePixel = 0
    panel.Parent = area
    local scale = Instance.new("UIScale")
    scale.Parent = panel
    local size = Instance.new("UISizeConstraint")
    size.MaxSize = Vector2.new(320, 154)
    size.Parent = panel
    Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
    local border = Instance.new("UIStroke")
    border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    border.Color, border.Thickness, border.Transparency = Color3.fromRGB(170, 180, 198), 1, 0.7
    border.Parent = panel
    local function label(text: string, y: number): TextLabel
        local result = Instance.new("TextLabel")
        result.Size, result.Position = UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, y)
        result.BackgroundTransparency = 1
        Style.Apply(result, 18)
        Style.Outline(result).Thickness = 1
        result.Text, result.Parent = text, panel
        return result
    end
    local title = label("NAME YOUR STAND", 10)
    title.Size = UDim2.new(1, -60, 0, 24)
    local box = Instance.new("TextBox")
    box.Name = "StandName"
    box.Size, box.Position = UDim2.new(1, -24, 0, 36), UDim2.fromOffset(12, 38)
    box.BackgroundColor3 = Color3.fromRGB(244, 243, 248)
    box.BackgroundTransparency = 0.06
    box.BorderSizePixel = 0
    box.TextColor3, box.Font, box.TextSize = Style.Dark, Style.Font, 18
    box.ClearTextOnFocus, box.MultiLine = false, false
    box.Selectable = true
    box.Text, box.Parent = "", panel
    local selection = Instance.new("Frame")
    selection.Name = "InputSelection"
    selection.BackgroundTransparency, selection.BorderSizePixel = 1, 0
    selection.Size, selection.Parent = UDim2.fromScale(1, 1), box
    box.SelectionImageObject = selection
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    -- Opt in on this ScreenGui in a Studio client; silent in normal play.
    local function debugEnabled(): boolean
        return RunService:IsStudio() and gui:GetAttribute("DebugSelection") == true
    end
    local function traceSelection(reason: string)
        if not debugEnabled() then
            return
        end
        local selected = GuiService.SelectedObject
        print(
            "[StandNameSelection]",
            reason,
            "SelectedObject=",
            selected,
            "FullName=",
            if selected then selected:GetFullName() else "nil",
            "LastInputType=",
            Input:GetLastInputType(),
            "PreferredInput=",
            Input.PreferredInput,
            "Focused=",
            box:IsFocused()
        )
    end
    local function button(text: string, callback: () -> ()): TextButton
        local result = Instance.new("TextButton")
        -- Slim visual face inside a larger transparent tap/controller target.
        result.BackgroundTransparency, result.BorderSizePixel = 1, 0
        result.Size, result.ZIndex = UDim2.fromOffset(40, 40), 2
        Style.Apply(result, 16)
        Style.Outline(result).Thickness = 1
        result.Text, result.Parent = text, panel
        result.Activated:Connect(function()
            traceSelection(text)
            callback()
        end)
        return result
    end
    local function face(buttonObject: TextButton, color: Color3, transparency: number)
        local fill = Instance.new("Frame")
        fill.Name = "ButtonFace"
        fill.Size = UDim2.new(buttonObject.Size.X.Scale, buttonObject.Size.X.Offset, 0, 28)
        fill.Position = UDim2.new(
            buttonObject.Position.X.Scale,
            buttonObject.Position.X.Offset,
            buttonObject.Position.Y.Scale,
            buttonObject.Position.Y.Offset + 6
        )
        fill.BackgroundColor3, fill.BackgroundTransparency = color, transparency
        fill.BorderSizePixel, fill.ZIndex, fill.Parent = 0, 1, panel
        Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 8)
    end
    local saveButton = button("SAVE", save)
    saveButton.Size, saveButton.Position = UDim2.new(0.6, -16, 0, 40), UDim2.fromOffset(12, 90)
    face(saveButton, Color3.fromRGB(92, 116, 102), 0.12)
    -- Both dismissal controls call the same callback: keep name, close, return camera.
    local skip = button("SKIP", close)
    skip.Size, skip.Position = UDim2.new(0.4, -16, 0, 40), UDim2.new(0.6, 4, 0, 90)
    skip.TextColor3 = Color3.fromRGB(211, 215, 223)
    face(skip, Color3.fromRGB(135, 144, 159), 0.85)
    local x = button("X", close)
    x.Size, x.Position = UDim2.fromOffset(36, 36), UDim2.new(1, -40, 0, 4)
    x.TextColor3 = Color3.fromRGB(211, 215, 223)
    local status = label("", 132)
    status.Size = UDim2.new(1, -24, 0, 20)
    status.TextSize, status.TextWrapped = 12, true
    local counter = label("", 74)
    counter.Name, counter.TextSize = "CharacterCounter", 11
    counter.Size = UDim2.new(1, -24, 0, 16)
    counter.TextXAlignment = Enum.TextXAlignment.Right
    local editing = false
    local function updateText()
        if editing then
            return
        end
        editing = true
        local limited = Config.Truncate(box.Text)
        if limited ~= box.Text then
            local cursor, selection = box.CursorPosition, box.SelectionStart
            box.Text = limited
            -- TextBox caret/selection offsets are bytes, even for Unicode text.
            box.CursorPosition = math.min(cursor, #limited + 1)
            box.SelectionStart = math.min(selection, #limited + 1)
        end
        local count = Config.Count(limited) or 0
        counter.Text = string.format("%d/%d", count, Config.MaxCharacters)
        counter.TextTransparency = if count == Config.MaxCharacters then 0.05 else 0.35
        editing = false
    end
    box:GetPropertyChangedSignal("Text"):Connect(updateText)
    updateText()

    local controls: { GuiObject } = { box, saveButton, skip, x }
    for _, control in controls do
        control.Selectable = true
    end
    box.NextSelectionDown, box.NextSelectionUp = saveButton, x
    saveButton.NextSelectionUp, saveButton.NextSelectionRight = box, skip
    saveButton.NextSelectionDown, saveButton.NextSelectionLeft = x, skip
    skip.NextSelectionUp, skip.NextSelectionLeft = box, saveButton
    skip.NextSelectionDown, skip.NextSelectionRight = x, saveButton
    x.NextSelectionDown, x.NextSelectionUp = box, skip
    x.NextSelectionLeft, x.NextSelectionRight = box, box
    local previousSelection: GuiObject? = nil
    local editorOwnsSelection = false
    local selectionResolved = true
    local closing = true
    local function controllerNavigation(): boolean
        return Input.PreferredInput == Enum.PreferredInput.Gamepad
    end
    local function validDestination(target: GuiObject?): boolean
        if
            not target
            or not target:IsA("GuiObject")
            or not target:IsDescendantOf(parent)
            or target:IsDescendantOf(gui)
            or not target.Selectable
        then
            return false
        end
        local ancestor: Instance? = target
        while ancestor and ancestor ~= parent do
            if ancestor:IsA("GuiObject") and not ancestor.Visible then
                return false
            end
            if
                (ancestor:IsA("ScreenGui") or ancestor:IsA("BillboardGui") or ancestor:IsA("SurfaceGui"))
                and not ancestor.Enabled
            then
                return false
            end
            ancestor = ancestor.Parent
        end
        return true
    end
    local function resolveEditorSelection()
        if selectionResolved then
            return
        end
        selectionResolved = true
        local selected = GuiService.SelectedObject
        local inside = selected ~= nil and selected:IsDescendantOf(gui)
        -- An unchanged pre-editor HUD selection is stale for pointer input.
        -- A different outside selection belongs to another UI and must survive.
        if selected and not inside and selected ~= previousSelection then
            previousSelection = nil
            editorOwnsSelection = false
            return
        end
        if inside then
            editorOwnsSelection = true
        end
        if controllerNavigation() then
            if editorOwnsSelection and (inside or selected == nil) then
                GuiService.SelectedObject = if validDestination(previousSelection) then previousSelection else nil
            end
        elseif inside or (selected ~= nil and selected == previousSelection) then
            GuiService.SelectedObject = nil
        end
        previousSelection = nil
        editorOwnsSelection = false
    end
    local function hide(reason: string?)
        if selectionResolved or closing then
            return
        end
        closing = true
        traceSelection(reason or "Close")
        traceSelection("before ReleaseFocus")
        if box:IsFocused() then
            box:ReleaseFocus()
        end
        traceSelection("after ReleaseFocus")
        resolveEditorSelection()
        traceSelection("before Gui.Enabled=false")
        gui.Enabled = false
        traceSelection("after Gui.Enabled=false")
        if debugEnabled() then
            task.spawn(function()
                RunService.Heartbeat:Wait()
                traceSelection("next Heartbeat")
            end)
        end
    end
    local function enterControllerNavigation()
        if not gui.Enabled or closing or not controllerNavigation() then
            return
        end
        local selected = GuiService.SelectedObject
        if selected == nil or selected == previousSelection or selected:IsDescendantOf(gui) then
            editorOwnsSelection = true
            GuiService.SelectedObject = box
        end
    end
    Input:GetPropertyChangedSignal("PreferredInput"):Connect(enterControllerNavigation)
    local function beginEditorSelection()
        if not selectionResolved then
            return
        end
        previousSelection = GuiService.SelectedObject
        editorOwnsSelection, selectionResolved, closing = false, false, false
        traceSelection("editor opening")
    end
    local function show()
        -- Capture synchronously; correctness must not depend on Enabled signal timing.
        beginEditorSelection()
        gui.Enabled = true
        enterControllerNavigation()
    end
    local function placePanel()
        local height = area.AbsoluteSize.Y
        local bottom = height - 20
        if gui.Enabled and Input.OnScreenKeyboardVisible then
            local keyboard = Input.OnScreenKeyboardPosition
            local keyboardSize = Input.OnScreenKeyboardSize
            if keyboardSize.Y > 0 then
                local keyboardTop = if keyboard.Y > 0
                    then keyboard.Y
                    else area.AbsolutePosition.Y + height - keyboardSize.Y
                bottom = math.min(bottom, keyboardTop - area.AbsolutePosition.Y - 8)
            end
        end
        if gui.Enabled and Input.OnScreenKeyboardVisible then
            scale.Scale = math.clamp((bottom - 8) / 154, 0.1, 1)
            panel.Position = UDim2.new(0.5, 0, 0, math.max(8, bottom))
        else
            scale.Scale = 1
            panel.Position = UDim2.new(0.5, 0, 1, -20)
        end
    end
    for _, property in { "OnScreenKeyboardVisible", "OnScreenKeyboardPosition", "OnScreenKeyboardSize" } do
        Input:GetPropertyChangedSignal(property):Connect(placePanel)
    end
    area:GetPropertyChangedSignal("AbsoluteSize"):Connect(placePanel)
    area:GetPropertyChangedSignal("AbsolutePosition"):Connect(placePanel)
    gui:GetPropertyChangedSignal("Enabled"):Connect(function()
        if gui.Enabled then
            if selectionResolved then
                beginEditorSelection()
                enterControllerNavigation()
            end
        else
            hide("externally hidden")
        end
        placePanel()
    end)
    box.Focused:Connect(function()
        traceSelection("TextBox Focused")
    end)
    box.FocusLost:Connect(function(enter)
        traceSelection("TextBox FocusLost")
        if enter and not closing then
            save()
        end
    end)
    box.ReturnPressedFromOnScreenKeyboard:Connect(function()
        traceSelection("keyboard Save")
        if not closing then
            save()
        end
    end)
    return {
        Gui = gui,
        Box = box,
        Status = status,
        Save = saveButton,
        Show = show,
        Hide = hide,
        TraceSelection = traceSelection,
    }
end

return UI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="893">
            <Properties>
              <string name="Name">TutorialBeamFlow</string>
              <string name="Source"><![CDATA[--!strict
-- The origin is Attachment0 (player), the destination Attachment1 (objective).
-- Move a soft bright segment from normalized distance 0 to 1, then fade/repeat.
local Flow = {}
local function transparency(elapsed: number): NumberSequence
    local phase = (elapsed % 2.4) / 2.4
    local fade = math.min(1, phase / 0.12, (1 - phase) / 0.12)
    local points: { NumberSequenceKeypoint } = {}
    for index = 0, 16 do
        local position = index / 16
        local strength = math.max(0, 1 - math.abs(position - phase) / 0.14)
        strength = strength * strength * (3 - 2 * strength)
        table.insert(points, NumberSequenceKeypoint.new(position, 1 - 0.85 * strength * fade))
    end
    return NumberSequence.new(points)
end
-- Cache one 30 Hz cycle; Heartbeat only selects a sequence, with no per-frame allocations.
local frames: { NumberSequence } = {}
function Flow.Transparency(elapsed: number): NumberSequence
    if #frames == 0 then
        for index = 0, 71 do
            table.insert(frames, transparency(index / 30))
        end
    end
    return frames[math.floor((elapsed % 2.4) * 30) + 1]
end
return Flow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="894">
            <Properties>
              <string name="Name">TutorialHintText</string>
              <string name="Source"><![CDATA[--!strict
local Text = {}
local hints: { [string]: string } = {
    NextCustomer = "See what the next customer wants!",
    MarketJump = "Jump higher for $ valuable ingredients!",
    Harvest = "Harvest your ingredients!",
    Market = "Collect more from the Central Market!",
    BuyRow = "Buy a farm row to grow ingredients!",
    Plant = "Plant an ingredient!",
    ClaimPlot = "Claim your smoothie stand!",
    Counter = "Head to your customer counter!",
    Order = "Take the customer's order!",
    Stash = "Grab ingredients from the stash!",
    Ladder = "Climb the ladder to your blender!",
    Turbine = "Drop down and Spin to blend smoothie!",
    Dispenser = "Dispense your smoothie!",
    FinishBatch = "Spin to finish the previous batch!",
    DrainBatch = "Dispense the previous batch to clear your blender!",
    Serve = "Serve customer and get MONEY!",
}
function Text.Get(stage: string, preferred: Enum.PreferredInput, button: string): string?
    if stage == "BuyJump" or stage == "BuyBat" then
        local action = if preferred == Enum.PreferredInput.Touch then "Tap" else "Click"
        return action .. " Upgrades and buy " .. (if stage == "BuyJump" then "JUMP 1!" else "a Bat Weapon!")
    end
    if stage == "Blender" then
        if preferred == Enum.PreferredInput.Touch then
            return "Tap Throw to toss it in!"
        elseif preferred == Enum.PreferredInput.Gamepad then
            return "Press " .. button .. " to throw into the blender!"
        end
        return "Click to throw into the blender!"
    end
    return hints[stage]
end
return Text
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="895">
            <Properties>
              <string name="Name">TutorialTooltip</string>
              <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Style = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local Tooltip = {}

function Tooltip.Show(playerGui: PlayerGui, name: string, text: string)
    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 15
    local card = Instance.new("CanvasGroup")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.fromScale(0.5, 0.72)
    card.Size = UDim2.fromOffset(320, 78)
    card.BackgroundColor3 = Style.Dark
    card.BackgroundTransparency = 0.18
    card.GroupTransparency = 1
    card.BorderSizePixel = 0
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
    card.Parent = gui
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.fromOffset(10, 0)
    label.RichText = true
    label.Text = text
    Style.Apply(label, 20)
    label.TextWrapped = true
    label.Parent = card
    gui.Parent = playerGui
    -- One composited fade includes the background, lettering AND UIStroke.
    -- Fading TextTransparency alone leaves the shared opaque outline behind.
    local entrance = TweenService:Create(card, TweenInfo.new(0.18), { GroupTransparency = 0 })
    local exit: Tween? = nil
    gui.Destroying:Connect(function()
        entrance:Cancel()
        if exit then
            exit:Cancel()
        end
    end)
    entrance:Play()
    task.delay(4.3, function()
        if not gui.Parent then
            return
        end
        local tween = TweenService:Create(card, TweenInfo.new(0.45), { GroupTransparency = 1 })
        exit = tween
        tween.Completed:Once(function()
            gui:Destroy()
        end)
        tween:Play()
    end)
end

return Tooltip
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="896">
            <Properties>
              <string name="Name">UIRegistry</string>
              <string name="Source"><![CDATA[--!strict
-- Shared semantic contract. Generated root names and XML referents are irrelevant.
local Registry = {}
local panelNames: { [string]: boolean } =
    { Index = true, Settings = true, Shop = true, Upgrades = true, Cosmetics = true }
Registry.Panels = panelNames

function Registry.Matches(instance: Instance, role: string, names: { string }): boolean
    local semantic = instance:GetAttribute("BlenderUI")
    if type(semantic) == "string" then
        return semantic == role
    end
    return table.find(names, instance.Name) ~= nil
end

-- Search only the specified parent's children; ambiguous contracts never pick a copy.
function Registry.Child(parent: Instance?, role: string, names: { string }, class: string): Instance?
    if not parent then
        return nil
    end
    local found: Instance? = nil
    for _, candidate in parent:GetChildren() do
        if Registry.Matches(candidate, role, names) then
            if found or not candidate:IsA(class) then
                return nil
            end
            found = candidate
        end
    end
    return found
end

function Registry.Desktops(container: Instance): { Instance }
    local result: { Instance } = {}
    for _, instance in container:GetDescendants() do
        if
            Registry.Matches(instance, "Desktop", { "Be a Blender! Desktop" })
            and (instance:IsA("GuiObject") or instance:IsA("ScreenGui"))
        then
            table.insert(result, instance)
        end
    end
    return result
end

function Registry.ActiveRoot(desktop: Instance, playerGui: Instance): ScreenGui?
    local ancestor: Instance? = desktop
    local root: ScreenGui? = nil
    while ancestor and ancestor ~= playerGui do
        if ancestor:IsA("ScreenGui") then
            if not ancestor.Enabled then
                return nil
            end
            root = ancestor
        elseif ancestor:IsA("GuiObject") and not ancestor.Visible then
            return nil
        end
        ancestor = ancestor.Parent
    end
    return if ancestor == playerGui then root else nil
end

function Registry.Content(desktop: Instance): Instance?
    local names = { "Be a Blender! DesktopContent", "DesktopContent" }
    local content = Registry.Child(desktop, "Content", names, "GuiObject")
    if content then
        return content
    end
    for _, candidate in desktop:GetChildren() do
        if Registry.Matches(candidate, "Content", names) then
            return nil
        end
    end
    return desktop
end

function Registry.ContentOf(instance: Instance): Instance?
    local ancestor: Instance? = instance
    while ancestor do
        if Registry.Matches(ancestor, "Desktop", { "Be a Blender! Desktop" }) then
            return Registry.Content(ancestor)
        end
        ancestor = ancestor.Parent
    end
    return nil
end

function Registry.PanelId(instance: Instance): string?
    if
        not (instance:IsA("Frame") or instance:IsA("CanvasGroup"))
        or instance.Parent ~= Registry.ContentOf(instance)
    then
        return nil
    end
    for id in panelNames do
        if Registry.Matches(instance, "Panel:" .. id, { id, id .. "_panel" }) then
            return id
        end
    end
    return nil
end

return Registry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="897">
            <Properties>
              <string name="Name">UpgradeBadgeState</string>
              <string name="Source"><![CDATA[--!strict
-- Eligibility uses the same UpgradeDisplay.Row prices as the panel.
local State = {}
function State.new()
    return {
        Refresh = function(eligible: { [string]: number }, _open: boolean, blocked: boolean): boolean
            return next(eligible) ~= nil and not blocked
        end,
        Reset = function() end,
    }
end
return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="898">
            <Properties>
              <string name="Name">UpgradeDisplay</string>
              <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Upgrades = require(Shared.Constants.Upgrades)

local Display = {}
Display.Tracks = {
    { Id = "CarryCapacity", Name = "CARRY CAPACITY", Attribute = "CarryCapacity" },
    { Id = "MovementSpeed", Name = "MOVEMENT SPEED", Attribute = "BaseWalkSpeed" },
    { Id = "SprintStamina", Name = "SPRINT STAMINA", Attribute = "StaminaMax" },
    { Id = "Jump", Name = "JUMP LEVEL", Attribute = "JumpLevel" },
    { Id = "Bat", Name = "STUN-BAT", Attribute = "BatLevel" },
}
local tiers: { [string]: { { Cost: number, Value: number } } } = {
    Bat = Upgrades.Bat,
    CarryCapacity = Upgrades.CarryCapacity,
    MovementSpeed = Upgrades.MovementSpeed,
    SprintStamina = Upgrades.SprintStamina,
    Jump = Upgrades.Jump,
}

local batNames = { "NONE", "BAT", "BIG BAT", "GIANT" }
local prefixes: { [string]: string } = { Jump = "JUMP", MovementSpeed = "SPD", SprintStamina = "STM" }

local function displayValue(id: string, value: number): number
    if id == "MovementSpeed" then
        return value * 2
    elseif id == "SprintStamina" then
        return value * 2 // 5
    else
        return value
    end
end

function Display.IsStatTrack(id: string): boolean
    return id == "MovementSpeed" or id == "SprintStamina"
end

local function valueText(id: string, level: number, value: number): string
    if id == "Bat" then
        return batNames[level + 1]
    elseif id == "CarryCapacity" then
        return tostring(value) .. " ITEMS"
    end
    return prefixes[id] .. " " .. tostring(if Display.IsStatTrack(id) then displayValue(id, value) else level)
end

-- Progression and prices come from purchased tiers, never temporary effective stats.
-- Keep the optional third argument for existing consumers.
function Display.Row(
    id: string,
    level: number?,
    _current: number?
): { Level: number, Stat: string, Current: string, Next: string, Price: number?, Max: boolean }?
    local track = tiers[id]
    if not track or level == nil or level % 1 ~= 0 or not track[level + 1] then
        return nil
    end
    local nextTier = track[level + 2]
    local currentValue = track[level + 1].Value
    local currentText = valueText(id, level, currentValue)
    local nextText = if not nextTier
        then "MAX"
        elseif Display.IsStatTrack(id) then "+" .. tostring(
            displayValue(id, nextTier.Value) - displayValue(id, currentValue)
        )
        else valueText(id, level + 1, nextTier.Value)
    return {
        Level = level,
        Stat = currentText .. " \u{2192} " .. nextText,
        Current = currentText,
        Next = nextText,
        Price = if nextTier then nextTier.Cost else nil,
        Max = nextTier == nil,
    }
end

function Display.Feedback(success: boolean, reason: string?): string
    if success then
        return "PURCHASED!"
    elseif reason == "InsufficientCash" then
        return "NOT ENOUGH"
    elseif reason == "MaxLevel" then
        return "MAX"
    end
    return "TRY AGAIN"
end

return Display
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="899">
            <Properties>
              <string name="Name">UpgradesGui</string>
              <string name="Source"><![CDATA[--!strict
-- Presentation adapter for the inspected Framewisp export. Never creates UI or
-- changes generated action/FX/layout behavior.
local Registry = require(script.Parent.UIRegistry)
local Gui = {}
export type Row = {
    Current: TextLabel,
    Next: TextLabel,
    Price: TextLabel,
    Purchase: GuiButton,
    BuyLabel: TextLabel,
    Title: TextLabel,
    PriceTransparency: number,
    BuyTransparency: number,
}
export type View = {
    Root: ScreenGui,
    Cash: TextLabel?,
    Rows: { [string]: Row },
    Panel: GuiObject?,
    MenuArrow: GuiObject?,
    PanelArrows: { [string]: GuiObject },
}
local transparency: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any
local function originalTransparency(label: TextLabel): number
    if transparency[label] == nil then
        transparency[label] = label.TextTransparency
    end
    return transparency[label]
end
local cards: { [string]: string } = {
    Jump = "JumpCard",
    Bat = "BatCard",
    MovementSpeed = "MovementSpeedCard",
    CarryCapacity = "CarryCapacityCard",
    SprintStamina = "SprintStaminaCard",
}

local function child(parent: Instance?, name: string, class: string): Instance?
    return Registry.Child(parent, name, { name }, class)
end
local function importedChild(parent: Instance?, tagged: string, exported: string, class: string): Instance?
    return Registry.Child(parent, exported, { tagged, exported }, class)
end
local desktops = Registry.Desktops
local activeRoot = Registry.ActiveRoot

local function resolveDesktop(root: ScreenGui, desktop: Instance): View?
    local content = Registry.Content(desktop)
    local panel = Registry.Child(content, "Panel:Upgrades", { "Upgrades_panel", "Upgrades" }, "GuiObject")
    local scroll = importedChild(panel, "UpgradeScroll_scroll", "UpgradeScroll", "ScrollingFrame")
    local list = importedChild(scroll, "UpgradeList_list", "UpgradeList", "GuiObject")
    local top = child(content, "TOP", "GuiObject")
    local cashDisplay = child(top, "CashDisplay", "GuiObject")
    local cash = Registry.Child(cashDisplay, "Cash", { "{Coins}", "Cash" }, "TextLabel")
    if not content then
        return nil
    end
    local rows: { [string]: Row } = {}
    local cardById: { [string]: GuiObject? } = {}
    for id, name in cards do
        local card = Registry.Child(list, "Upgrade:" .. id, { name }, "GuiObject")
        cardById[id] = card :: GuiObject?
        local level = child(card, "LevelContainer", "GuiObject")
        local current = child(level, "CurrentValue", "TextLabel")
        local nextValue = child(level, "NextValue", "TextLabel")
        local price = child(card, "PurchasePrice", "TextLabel")
        local purchase = importedChild(card, "Buy_button_smooth", "Buy", "GuiButton")
        local label = child(purchase, "BuyLabel", "TextLabel")
        local title = child(card, "UpgradeTitle", "TextLabel")
        if not current or not nextValue or not price or not purchase or not label or not title then
            continue
        end
        rows[id] = {
            Current = current :: TextLabel,
            Next = nextValue :: TextLabel,
            Price = price :: TextLabel,
            Purchase = purchase :: GuiButton,
            BuyLabel = label :: TextLabel,
            Title = title :: TextLabel,
            PriceTransparency = originalTransparency(price :: TextLabel),
            BuyTransparency = originalTransparency(label :: TextLabel),
        }
    end
    local leftMenu = child(content, "LeftMenu", "GuiObject")
    local arrowCards: { [string]: GuiObject? } = {
        Jump1Alert = cardById.Jump,
        BatAlert = cardById.Bat,
    }
    local panelArrows: { [string]: GuiObject } = {}
    for name, card in arrowCards do
        local arrow = importedChild(card, name .. "_pulse", name, "GuiObject")
        if arrow then
            panelArrows[name] = arrow :: GuiObject
        end
    end
    return {
        Root = root :: ScreenGui,
        Cash = cash :: TextLabel?,
        Rows = rows,
        Panel = panel :: GuiObject?,
        MenuArrow = importedChild(leftMenu, "Alert_pulse", "Alert", "GuiObject") :: GuiObject?,
        PanelArrows = panelArrows,
    }
end

function Gui.Resolve(playerGui: PlayerGui): View?
    local selected: Instance? = nil
    local selectedRoot: ScreenGui? = nil
    for _, desktop in desktops(playerGui) do
        local root = activeRoot(desktop, playerGui)
        if root then
            if selected then
                return nil -- Two visible desktops have no verified ownership/recency contract.
            end
            selected, selectedRoot = desktop, root
        end
    end
    return if selected and selectedRoot then resolveDesktop(selectedRoot, selected) else nil
end

-- Player subscriptions belong to the controller. Only instance-specific purchase
-- connections are replaced here, including when live sync replaces a card.
function Gui.Observe(playerGui: PlayerGui, changed: (View?) -> (), purchase: (string) -> ()): () -> ()
    local view: View? = nil
    local connections: { RBXScriptConnection } = {}
    local rootConnections: { RBXScriptConnection } = {}
    local stopped, queued = false, false
    local ambiguous = false
    local lastIssue = ""
    local schedule: () -> ()
    local function clear()
        for _, connection in connections do
            connection:Disconnect()
        end
        table.clear(connections)
    end
    local function same(nextView: View?): boolean
        if not view or not nextView then
            return view == nextView
        end
        if
            view.Root ~= nextView.Root
            or view.Cash ~= nextView.Cash
            or view.Panel ~= nextView.Panel
            or view.MenuArrow ~= nextView.MenuArrow
        then
            return false
        end
        for _, name in { "Jump1Alert", "BatAlert" } do
            if view.PanelArrows[name] ~= nextView.PanelArrows[name] then
                return false
            end
        end
        for id, row in view.Rows do
            local nextRow = nextView.Rows[id]
            if not nextRow then
                return false
            end
            if
                row.Current ~= nextRow.Current
                or row.Next ~= nextRow.Next
                or row.Price ~= nextRow.Price
                or row.Purchase ~= nextRow.Purchase
                or row.BuyLabel ~= nextRow.BuyLabel
                or row.Title ~= nextRow.Title
            then
                return false
            end
        end
        for id in nextView.Rows do
            if not view.Rows[id] then
                return false
            end
        end
        return true
    end
    local function scan()
        queued = false
        if stopped then
            return
        end
        for _, connection in rootConnections do
            connection:Disconnect()
        end
        table.clear(rootConnections)
        local watched: { [Instance]: boolean } = {}
        local active = 0
        for _, desktop in desktops(playerGui) do
            if activeRoot(desktop, playerGui) then
                active += 1
            end
            local ancestor: Instance? = desktop
            while ancestor and ancestor ~= playerGui do
                if not watched[ancestor] then
                    watched[ancestor] = true
                    if ancestor:IsA("ScreenGui") or ancestor:IsA("GuiObject") then
                        local property = if ancestor:IsA("ScreenGui") then "Enabled" else "Visible"
                        table.insert(rootConnections, ancestor:GetPropertyChangedSignal(property):Connect(schedule))
                    end
                end
                ancestor = ancestor.Parent
            end
        end
        if active > 1 and not ambiguous then
            warn(
                "UpgradesGui: multiple active Be a Blender! Desktop roots in PlayerGui; binding paused until only one is active"
            )
        end
        ambiguous = active > 1
        local nextView = Gui.Resolve(playerGui)
        local issues: { string } = {}
        if nextView then
            if not nextView.Cash then
                table.insert(issues, "TOP.CashDisplay.Cash/{Coins}")
            end
            for _, id in { "Jump", "Bat", "MovementSpeed", "CarryCapacity", "SprintStamina" } do
                if not nextView.Rows[id] then
                    table.insert(issues, cards[id] .. " (card or required control)")
                end
            end
        elseif active == 1 then
            table.insert(issues, "DesktopContent (missing, wrong class or ambiguous)")
        end
        local issue = table.concat(issues, ", ")
        if issue ~= "" and issue ~= lastIssue then
            warn("UpgradesGui: missing, wrong-class or ambiguous binding in active desktop: " .. issue)
        end
        lastIssue = issue
        if same(nextView) then
            return
        end
        clear()
        view = nextView
        if nextView then
            for id, row in nextView.Rows do
                table.insert(
                    connections,
                    row.Purchase.Activated:Connect(function()
                        purchase(id)
                    end)
                )
            end
        end
        changed(nextView)
    end
    schedule = function()
        if queued or stopped then
            return
        end
        queued = true
        task.defer(scan)
    end
    local added = playerGui.DescendantAdded:Connect(schedule)
    -- Only removal of a binding or its ancestor invalidates the view. Decorative
    -- Framewisp FX instances may be added/removed without rebinding purchases.
    local removing = playerGui.DescendantRemoving:Connect(function(instance)
        local current = view
        if not current then
            schedule()
            return
        end
        local affected = instance == current.Root
            or instance == current.Cash
            or (current.Cash ~= nil and current.Cash:IsDescendantOf(instance))
            or instance == current.Panel
            or (current.Panel ~= nil and current.Panel:IsDescendantOf(instance))
            or instance == current.MenuArrow
            or (current.MenuArrow ~= nil and current.MenuArrow:IsDescendantOf(instance))
        for _, arrow in current.PanelArrows do
            if instance == arrow or arrow:IsDescendantOf(instance) then
                affected = true
                break
            end
        end
        for _, row in current.Rows do
            local bindings: { Instance } = { row.Current, row.Next, row.Price, row.Purchase, row.BuyLabel, row.Title }
            for _, bound in bindings do
                if instance == bound or bound:IsDescendantOf(instance) then
                    affected = true
                    break
                end
            end
            if affected then
                break
            end
        end
        if affected then
            clear()
            view = nil
            changed(nil)
            schedule()
        end
    end)
    scan()
    return function()
        stopped = true
        clear()
        for _, connection in rootConnections do
            connection:Disconnect()
        end
        table.clear(rootConnections)
        added:Disconnect()
        removing:Disconnect()
        view = nil
        changed(nil)
    end
end

return Gui
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="900">
            <Properties>
              <string name="Name">WorldBillboardStyle</string>
              <string name="Source"><![CDATA[--!strict
-- Compatibility entry point. Server and client share the same convention.
local Style = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
export type Settings = Style.Settings
export type TextSettings = Style.TextSettings
return Style
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="901">
            <Properties>
              <string name="Name">WorldTextPresentation</string>
              <string name="Source"><![CDATA[--!strict
local Style = require(script.Parent.WorldBillboardStyle)
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local Presentation = {}

export type Settings = Style.TextSettings & {
    WidthStuds: number?,
    HeightStuds: number?,
    MaxDistance: number?,
    Origin: Instance?,
    Text: string?,
    StudsOffset: Vector3?,
}

export type Handle = {
    SetText: (self: Handle, text: string) -> (),
    SetVisible: (self: Handle, visible: boolean) -> (),
    Destroy: (self: Handle) -> (),
}

-- Call from client code. One handle owns one GUI; updates never allocate views.
-- Invalid/missing origins return nil and a reason without creating any instances.
function Presentation.Create(settings: Settings?): (Handle?, string?)
    local origin = if settings then settings.Origin else nil
    if typeof(origin) ~= "Instance" or not origin:IsA("Attachment") then
        return nil, "WorldTextPresentation requires an Attachment Origin"
    end
    if not origin:IsDescendantOf(workspace) then
        return nil, "WorldTextPresentation Origin must be in Workspace"
    end
    local config = settings :: Settings
    local gui = Instance.new("BillboardGui")
    gui.Name = "WorldTextDisplay"
    gui.Adornee = origin
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    Style.ApplyBillboard(gui, {
        WidthStuds = config.WidthStuds or 9.6,
        HeightStuds = config.HeightStuds or 2.4,
        MaxDistance = config.MaxDistance or 60,
    })
    gui.StudsOffset = config.StudsOffset or Vector3.zero
    gui.Active = false
    gui.Enabled = true

    local text = Instance.new("TextLabel")
    text.Name = "Text"
    Style.ApplyText(text, config)
    text.Active = false
    text.Selectable = false
    local function setText(value: string)
        local tier = string.match(value, "^JUMP ([123]) ZONE$")
            or ({ I = "1", II = "2", III = "3" })[string.match(value, "^JUMP (I+) ZONE$") or ""]
        Style.ApplyText(text, config)
        text.RichText = tier ~= nil
        if tier then
            TextStyle.Apply(text, config.TextSize or 24, gui)
            if tier == "3" then
                -- Per-letter pastels keep the rainbow confined to JUMP 3; ZONE stays white.
                text.Text = '<font color="rgb(255,188,202)">J</font><font color="rgb(255,213,177)">U</font>'
                    .. '<font color="rgb(255,237,177)">M</font><font color="rgb(184,231,206)">P</font> '
                    .. '<font color="rgb(187,208,247)">'
                    .. (string.match(value, "^JUMP (.+) ZONE$") or "3")
                    .. "</font> ZONE"
            else
                local color = if tier == "1" then "rgb(226,193,139)" else "rgb(133,208,235)"
                local jump = string.match(value, "^(JUMP .+) ZONE$") or ""
                text.Text = '<font color="' .. color .. '">' .. jump .. "</font> ZONE"
            end
        else
            local outline = text:FindFirstChild("DialogueOutline")
            if outline then
                outline:Destroy()
            end
            text.Text = value
        end
        text.TextScaled = config.TextScaled ~= false
    end
    setText(config.Text or "")
    text.Parent = gui
    -- Client-created child: no server replication; origin destruction owns cleanup.
    gui.Parent = origin

    local destroyed = false
    local destroying: RBXScriptConnection? = nil
    local function disconnect()
        if destroying then
            destroying:Disconnect()
            destroying = nil
        end
    end
    destroying = gui.Destroying:Connect(function()
        destroyed = true
        disconnect()
    end)
    local handle: Handle = {
        SetText = function(_self: Handle, value: string)
            if not destroyed then
                setText(value)
            end
        end,
        SetVisible = function(_self: Handle, visible: boolean)
            if not destroyed then
                gui.Enabled = visible
            end
        end,
        Destroy = function(_self: Handle)
            if destroyed then
                return
            end
            destroyed = true
            disconnect()
            gui:Destroy()
        end,
    }
    return handle, nil
end

return Presentation
]]></string>
            </Properties>
          </Item>
