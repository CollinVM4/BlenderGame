          <Item class="ModuleScript" referent="866">
            <Properties>
              <string name="Name">FilmCamTakes</string>
              <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Path = require(ReplicatedStorage.Shared.FilmCamPath)
local Takes = {}

function Takes.Capture(time: number, cf: CFrame, fov: number): Path.Key
    local axis, angle = cf.Rotation:ToAxisAngle()
    local s = math.sin(angle / 2)
    return {
        Time = time,
        Position = { cf.X, cf.Y, cf.Z },
        Rotation = { axis.X * s, axis.Y * s, axis.Z * s, math.cos(angle / 2) },
        Fov = fov,
    }
end

function Takes.Encode(take: Path.Take): string
    local valid, message = Path.Validate(take)
    assert(valid, message)
    return HttpService:JSONEncode(take)
end

function Takes.Decode(json: string): (Path.Take?, string)
    local ok, value = pcall(function()
        return HttpService:JSONDecode(json)
    end)
    if not ok then
        return nil, "Invalid JSON"
    end
    local valid, message = Path.Validate(value)
    return if valid then value else nil, message
end

function Takes.Preset(kind: string, cf: CFrame, fov: number, target: Vector3?): Path.Take
    local duration = if kind == "Orbit" then 8 else 5
    local take: Path.Take = { Version = 1, Name = kind, Duration = duration, Keys = {} }
    local center = target or (cf.Position + cf.LookVector * 20)
    -- Avoid degenerate look-at frames when the center ray hits the camera itself.
    if (center - cf.Position).Magnitude < 0.1 then
        center = cf.Position + cf.LookVector * 20
    end
    local offset = cf.Position - center
    for i = 0, duration * 10 do
        local t = i / (duration * 10)
        local frame = cf + cf.LookVector * (10 * t * (if kind == "Pull-out" then -1 else 1))
        if kind == "Orbit" then
            local position = center + CFrame.Angles(0, t * math.pi * 2, 0):VectorToWorldSpace(offset)
            local up = if math.abs((center - position).Unit:Dot(Vector3.yAxis)) > 0.999
                then Vector3.zAxis
                else Vector3.yAxis
            frame = CFrame.lookAt(position, center, up)
        end
        table.insert(take.Keys, Takes.Capture(i / 10, frame, fov))
    end
    return take
end

return Takes
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="867">
            <Properties>
              <string name="Name">FramewispMenus</string>
              <string name="Source"><![CDATA[--!strict
-- Called by FramewispActions through tools/prepare_framewisp_ui.py. Its existing
-- wiring path delegates major menus here; generated action tweens do not compete.
local PanelManager = require(script.Parent.PanelManager)
local Menus = {}
local Registry = require(script.Parent.UIRegistry)
local Notifications = require(script.Parent.MenuNotifications)
local names = Registry.Panels
local contentOf = Registry.ContentOf
local panelId = Registry.PanelId
local attached: { [Instance]: { Wire: (Instance) -> boolean } } = setmetatable({}, { __mode = "k" }) :: any

function Menus.Attach(gui: Instance, player: Player)
    if attached[gui] then
        return attached[gui]
    end
    local panels: { [Instance]: PanelManager.Handle } = {}
    local wired: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
    local connections: { RBXScriptConnection } = {}
    local buttons: { [Instance]: RBXScriptConnection } = {}
    local badges: { [Instance]: () -> () } = {}
    local stopped = false
    local playerGui = player:FindFirstChild("PlayerGui")

    local function initialize(instance: Instance)
        if stopped then
            return
        end
        local id = panelId(instance)
        if id and not panels[instance] then
            local panel = instance :: GuiObject
            panel.Visible = false
            panels[instance] = PanelManager.Register(id, {
                Open = function()
                    Notifications.PanelChanged(id, true)
                    panel.Visible = true
                end,
                Close = function()
                    panel.Visible = false
                    Notifications.PanelChanged(id, false)
                end,
            })
        end
    end
    local function wire(button: Instance): boolean
        if stopped then
            -- A retained FramewispActions hook may outlive a detached root.
            -- Explicit reattachment must delegate into the new binding.
            local current = attached[gui]
            return if current then current.Wire(button) else true
        end
        if not button:IsA("GuiButton") then
            return false
        end
        local content = contentOf(button)
        if not content then
            return false
        end
        local close: GuiObject? = nil
        local ancestor = button.Parent
        while ancestor and ancestor ~= content do
            if panelId(ancestor) then
                close = ancestor :: GuiObject
                break
            end
            ancestor = ancestor.Parent
        end
        local action = button:GetAttribute("FigmaAction")
        local param = button:GetAttribute("FigmaActionParam")
        local semantic = button:GetAttribute("BlenderUI")
        local id = if type(semantic) == "string"
            then semantic:match("^Toggle:(%w+)$")
            elseif type(param) == "string" then param:gsub("_panel$", "")
            else button.Name:match("^(%w+)")
        local isClose = close ~= nil
            and (semantic == "Close" or action == "close" or button.Name:match("^Close") ~= nil)
        local navigation = false
        local container = button.Parent
        while container and container ~= content do
            if
                Registry.Matches(container, "LeftMenu", { "LeftMenu" })
                or Registry.Matches(container, "RightMenu", { "RightMenu" })
            then
                navigation = true
                break
            end
            container = container.Parent
        end
        local isMenu = close == nil
            and id ~= nil
            and names[id] == true
            and (navigation or (type(semantic) == "string" and semantic:match("^Toggle:") ~= nil))
        if not isClose and not isMenu then
            return false
        end
        if wired[button] then
            return true
        end
        wired[button] = true
        if isMenu and id then
            badges[button] = Notifications.Attach(id, button)
        end
        buttons[button] = button.Activated:Connect(function()
            if not button:IsDescendantOf(gui) then
                return
            end
            if isClose and close then
                local handle = panels[close]
                if handle then
                    handle.Close()
                end
                return
            end
            local selected: GuiObject? = nil
            for _, child in content:GetChildren() do
                if panelId(child) == id then
                    if selected then
                        warn("FramewispMenus: ambiguous panel target " .. tostring(id))
                        return -- Do not guess between duplicate imported panels.
                    end
                    selected = child :: GuiObject
                end
            end
            if not selected then
                warn("FramewispMenus: missing panel target " .. tostring(id))
            end
            if selected then
                local handle = panels[selected]
                if handle then
                    handle.Toggle()
                end
            end
        end)
        return true
    end
    local function added(instance: Instance)
        if stopped then
            return
        end
        initialize(instance)
        wire(instance)
        -- Also handles a complete subtree inserted in one operation.
        for _, descendant in instance:GetDescendants() do
            initialize(descendant)
            wire(descendant)
        end
    end
    table.insert(connections, gui.DescendantAdded:Connect(added))
    table.insert(
        connections,
        gui.DescendantRemoving:Connect(function(instance)
            for panel, handle in panels do
                if panel == instance or panel:IsDescendantOf(instance) then
                    handle.Destroy()
                    panels[panel] = nil
                end
            end
            for button, connection in buttons do
                if button == instance or button:IsDescendantOf(instance) then
                    connection:Disconnect()
                    buttons[button] = nil
                    wired[button] = nil
                    local detach = badges[button]
                    if detach then
                        badges[button] = nil
                        detach()
                    end
                end
            end
        end)
    )
    for _, descendant in gui:GetDescendants() do
        initialize(descendant)
    end
    for _, descendant in gui:GetDescendants() do
        wire(descendant)
    end
    table.insert(
        connections,
        player.CharacterAdded:Connect(function()
            for _, handle in panels do
                handle.Close()
            end
        end)
    )
    local function stop()
        if stopped then
            return
        end
        stopped = true
        for _, handle in panels do
            handle.Destroy()
        end
        table.clear(panels)
        for _, connection in buttons do
            connection:Disconnect()
        end
        table.clear(buttons)
        for _, detach in badges do
            detach()
        end
        table.clear(badges)
        table.clear(wired)
        for _, connection in connections do
            connection:Disconnect()
        end
        table.clear(connections)
        attached[gui] = nil
    end
    table.insert(connections, gui.Destroying:Connect(stop))
    table.insert(
        connections,
        gui.AncestryChanged:Connect(function(_, parent)
            if parent == nil or (playerGui and not gui:IsDescendantOf(playerGui)) then
                stop()
            end
        end)
    )
    local binding = { Wire = wire }
    attached[gui] = binding
    return binding
end

return Menus
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="868">
            <Properties>
              <string name="Name">IceShotgunFireView</string>
              <string name="Source"><![CDATA[--!strict
-- Presentation only: shown exclusively for a server-confirmed cooldown rejection.
local RunService = game:GetService("RunService")
local View = {}
export type Handle = { Root: TextLabel, Scale: UIScale, Connection: RBXScriptConnection? }

function View.Create(parent: Instance): Handle
    local label = Instance.new("TextLabel")
    label.Name = "IceShotgunCooldownFeedback"
    label.AnchorPoint = Vector2.new(0.5, 0)
    label.Position = UDim2.new(0.5, 0, 0.5, 28)
    label.Size = UDim2.fromOffset(230, 28)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.FredokaOne
    label.TextSize = 18
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Active = false
    label.Selectable = false
    label.Visible = false
    label.Parent = parent
    local outline = Instance.new("UIStroke")
    outline.Color = Color3.new(0, 0, 0)
    outline.Thickness = 2
    outline.Parent = label
    local scale = Instance.new("UIScale")
    scale.Parent = label
    return { Root = label, Scale = scale, Connection = nil }
end

function View.Hide(view: Handle)
    if view.Connection then
        view.Connection:Disconnect()
        view.Connection = nil
    end
    view.Root.Visible = false
end

function View.Show(view: Handle, remaining: number)
    View.Hide(view)
    local label = view.Root
    local outline = label:FindFirstChildOfClass("UIStroke") :: UIStroke
    label.Text = string.format("Cooldown... %.1fs left", remaining)
    label.Position = UDim2.new(0.5, 0, 0.5, 28)
    label.TextTransparency = 0
    outline.Transparency = 0
    view.Scale.Scale = 0.85
    label.Visible = true
    local startedAt = os.clock()
    view.Connection = RunService.Heartbeat:Connect(function()
        local elapsed = os.clock() - startedAt
        if elapsed >= 0.8 then
            View.Hide(view)
            return
        end
        -- A short overshoot settles into the upward drift and fade.
        view.Scale.Scale = if elapsed < 0.1
            then 0.85 + 0.23 * elapsed / 0.1
            elseif elapsed < 0.18 then 1.08 - 0.08 * (elapsed - 0.1) / 0.08
            else 1
        label.Position = UDim2.new(0.5, 0, 0.5, 28 - 10 * elapsed / 0.8)
        local fade = math.clamp((elapsed - 0.18) / 0.62, 0, 1)
        label.TextTransparency = fade
        outline.Transparency = fade
    end)
end

function View.Destroy(view: Handle)
    View.Hide(view)
    view.Root:Destroy()
end

return View
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="869">
            <Properties>
              <string name="Name">IngredientPickupPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local InputPresentation = require(script.Parent.InteractionPromptPresentation)
local Style = require(script.Parent.IngredientPickupPromptStyle)
local Shared = game:GetService("ReplicatedStorage").Shared
local Ingredients = require(Shared.Constants.Ingredients)
local MoneyFormat = require(Shared.MoneyFormat)
local IngredientName = require(Shared.IngredientName)
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local Presentation = {}

-- Rotated-part extents keep the label above the actual visible geometry,
-- excluding the invisible pivot root created for multipart ingredients.
function Presentation.Bounds(object: BasePart | Model): (Vector3, Vector3)
    local minimum = Vector3.new(math.huge, math.huge, math.huge)
    local maximum = Vector3.new(-math.huge, -math.huge, -math.huge)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    local found = false
    for _, part in parts do
        if part:IsA("BasePart") and part.Transparency < 1 then
            local cf, half = part.CFrame, part.Size / 2
            local extent = cf.RightVector:Abs() * half.X + cf.UpVector:Abs() * half.Y + cf.LookVector:Abs() * half.Z
            minimum = minimum:Min(part.Position - extent)
            maximum = maximum:Max(part.Position + extent)
            found = true
        end
    end
    if not found then
        minimum = object:GetPivot().Position
        maximum = minimum
    end
    return minimum, maximum
end

function Presentation.Top(object: BasePart | Model): Vector3
    local minimum, maximum = Presentation.Bounds(object)
    return Vector3.new((minimum.X + maximum.X) / 2, maximum.Y, (minimum.Z + maximum.Z) / 2)
end

function Presentation.MobilePosition(minimum: Vector3, maximum: Vector3): Vector3
    local center = (minimum + maximum) / 2
    local height = maximum.Y - minimum.Y
    local clearance = math.min(Style.MobileGroundClearance, height / 2)
    return Vector3.new(
        center.X,
        math.max(
            minimum.Y + clearance,
            center.Y - math.min(height * Style.MobileLowerFraction, Style.MobileMaxLowerStuds)
        ),
        center.Z
    )
end

function Presentation.Create(
    prompt: ProximityPrompt,
    object: BasePart | Model,
    definition: Ingredients.IngredientDefinition,
    parent: Instance,
    inputType: Enum.ProximityPromptInputType
): (() -> (), () -> ())
    local mobile = inputType == Enum.ProximityPromptInputType.Touch
    local inputY = Style.TitleHeight + Style.NameHeight + Style.ValueHeight + 2 * Style.RowSpacing + Style.InputSpacing
    local inputCenter = inputY + Style.InputHeight / 2
    local canvasHeight = if mobile then Style.MobileCanvasHeight else Style.BillboardSize.Y
    local rarity, name = Style.Resolve(definition)
    local palette = (Style.RarityStyles :: any)[rarity]
    local anchor = if object:IsA("BasePart")
        then object
        else object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    assert(anchor and anchor:IsA("BasePart"), "Ingredient presentation requires a physical part")
    -- Reuse the existing keyboard/gamepad/touch and hold lifecycle implementation.
    local cleanup, gui = InputPresentation.Create(prompt, anchor, parent, inputType, {
        InputOnly = true,
        WidthStuds = 10.2,
        HeightStuds = if mobile then 5.9 else 4.6,
        Available = function()
            local owner = object:GetAttribute("OwnerUserId")
            return object:IsDescendantOf(workspace)
                and CollectionService:HasTag(object, "IngredientWorldItem")
                and object:GetAttribute("IngredientId") == definition.Id
                and (typeof(owner) ~= "number" or owner == 0 or owner == Players.LocalPlayer.UserId)
        end,
        CanvasWidth = Style.BillboardSize.X,
        CanvasHeight = canvasHeight,
        TouchWidth = if mobile then Style.MobileTouchSize else nil,
        TouchHeight = if mobile then Style.MobileTouchSize else nil,
        TouchCenterY = if mobile then inputCenter / canvasHeight else nil,
        TextSize = Style.InputTextSize,
        MaxDistance = Style.MaxDistance,
    })
    local strokeCleanups: { () -> () } = {}
    gui.Name = "IngredientPickupPromptDisplay"
    gui.SizeOffset = Vector2.new(0, if mobile then (inputCenter - canvasHeight / 2) / canvasHeight else 0.5)
    local function formatText(
        text: TextLabel | TextButton,
        y: number,
        height: number,
        size: number,
        color: Color3,
        strokeColor: Color3
    )
        local label = text :: TextLabel
        label.Active = not mobile and label:IsA("TextButton")
        label.Position = UDim2.fromScale(0, y / canvasHeight)
        label.Size = UDim2.fromScale(1, height / canvasHeight)
        label.BackgroundTransparency = 1
        label.Font = Style.Font
        label.TextSize = size
        label.TextColor3 = color
        label.TextStrokeTransparency = 1
        label.TextScaled = true
        local limit = Instance.new("UITextSizeConstraint")
        limit.MinTextSize = 1
        limit.MaxTextSize = 1000
        limit.Parent = label
        table.insert(
            strokeCleanups,
            BillboardStyle.ApplyWorldStroke(label, gui, {
                Color = strokeColor,
                ThicknessStuds = Style.StrokeThicknessStuds,
                Transparency = Style.TextStrokeTransparency,
            })
        )
    end
    local title = Instance.new("TextLabel")
    title.Name = "Rarity"
    title.RichText = true
    local function rarityText(): string
        local ripe = object:GetAttribute("IsRipe") == true
        local stateColor = if ripe then "#FFDE73" else "#D2D6D5"
        return string.upper(rarity)
            .. ' <font color="#D2D6D5">•</font> <font color="'
            .. stateColor
            .. '">'
            .. (if ripe then "Ripe" else "Unripe")
            .. "</font>"
    end
    title.Text = rarityText()
    formatText(title, 0, Style.TitleHeight, Style.TitleTextSize, palette.TextColor, palette.StrokeColor)
    title.Parent = gui
    local label = Instance.new("TextLabel")
    label.Name, label.Text = "IngredientName", name
    local nameY = Style.TitleHeight + Style.RowSpacing
    formatText(label, nameY, Style.NameHeight, Style.NameTextSize, Style.NameColor, Style.StrokeColor)
    label.Parent = gui
    local value = Instance.new("TextLabel")
    value.Name, value.Text =
        "IngredientValue",
        MoneyFormat.Compact((object:GetAttribute("EffectiveIngredientValue") :: number?) or definition.Value)
    local valueY = nameY + Style.NameHeight + Style.RowSpacing
    formatText(value, valueY, Style.ValueHeight, Style.ValueTextSize, Style.ValueColor, Style.StrokeColor)
    value.Parent = gui
    local input = gui:FindFirstChild("Action") :: TextLabel
    formatText(
        input,
        valueY + Style.ValueHeight + Style.InputSpacing,
        Style.InputHeight,
        Style.InputTextSize,
        palette.TextColor,
        palette.StrokeColor
    )
    local function update()
        if definition.Id == "PlayerHead" then
            label.Text = IngredientName.Resolve(
                definition.Id,
                name,
                object:GetAttribute("SourceUserId"),
                object:GetAttribute("SourceDisplayName")
            )
        end
        title.Text = rarityText()
        value.Text =
            MoneyFormat.Compact((object:GetAttribute("EffectiveIngredientValue") :: number?) or definition.Value)
        if mobile then
            local minimum, maximum = Presentation.Bounds(object)
            local position = Presentation.MobilePosition(minimum, maximum)
            gui.StudsOffsetWorldSpace = position - anchor.Position
            -- Keep the visible row above the ingredient's bottom/contact plane even
            -- when a tiny ingredient or a steep camera angle compresses its height.
            local lift = 0
            local renderedHeight = gui.AbsoluteSize.Y
            local camera = workspace.CurrentCamera
            if camera then
                local point, visible = camera:WorldToViewportPoint(position)
                local bottom = camera:WorldToViewportPoint(Vector3.new(position.X, minimum.Y, position.Z))
                if visible and bottom.Z > 0 then
                    lift = math.max(0, point.Y + renderedHeight * Style.InputHeight / canvasHeight / 2 + 2 - bottom.Y)
                end
            end
            gui.SizeOffset =
                Vector2.new(0, (inputCenter - canvasHeight / 2) / canvasHeight + lift / math.max(1, renderedHeight))
        else
            gui.StudsOffsetWorldSpace = Presentation.Top(object) - anchor.Position + Style.PromptStudsOffset
        end
    end
    update()
    return function()
        for _, stop in strokeCleanups do
            stop()
        end
        cleanup()
    end,
        update
end

return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="870">
            <Properties>
              <string name="Name">IngredientPickupPromptStyle</string>
              <string name="Source"><![CDATA[--!strict
-- All ingredient pickup appearance tuning lives here; no gameplay effects.
local Style = {
    RarityStyles = {
        Common = { TextColor = Color3.fromRGB(240, 240, 235), StrokeColor = Color3.fromRGB(20, 20, 24) },
        Uncommon = { TextColor = Color3.fromRGB(135, 245, 145), StrokeColor = Color3.fromRGB(15, 35, 22) },
        Rare = { TextColor = Color3.fromRGB(255, 212, 85), StrokeColor = Color3.fromRGB(45, 28, 12) },
        Mystery = { TextColor = Color3.fromRGB(225, 155, 255), StrokeColor = Color3.fromRGB(37, 13, 55) },
    },
    TitleTextSize = 23,
    NameTextSize = 29,
    ValueTextSize = 23,
    InputTextSize = 21,
    TitleHeight = 28,
    NameHeight = 38,
    ValueHeight = 28,
    InputHeight = 34,
    RowSpacing = 2,
    InputSpacing = 6,
    BillboardSize = Vector2.new(320, 142),
    PromptStudsOffset = Vector3.new(0, 0.35, 0),
    MobileTouchSize = 112,
    MobileCanvasHeight = 184,
    MobileLowerFraction = 0.30,
    MobileMaxLowerStuds = 2.5,
    MobileGroundClearance = 0.15,
    -- Camera-distance cull only; Roblox still owns prompt activation range.
    MaxDistance = 60,
    HideMysteryNames = true,
    Font = Enum.Font.GothamBold,
    NameColor = Color3.fromRGB(255, 250, 235),
    ValueColor = Color3.fromRGB(100, 235, 120),
    StrokeColor = Color3.fromRGB(16, 16, 20),
    TextStrokeTransparency = 0.05,
    StrokeThicknessStuds = 0.05,
}

function Style.Resolve(definition: { Id: string, DisplayName: string?, Rarity: string? }): (string, string)
    local rarity = definition.Rarity or "Common"
    if not (Style.RarityStyles :: any)[rarity] then
        rarity = "Common"
    end
    local name = definition.DisplayName or definition.Id
    if rarity == "Mystery" and Style.HideMysteryNames then
        name = "???"
    end
    return rarity, name
end

return Style
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="871">
            <Properties>
              <string name="Name">IngredientViewport</string>
              <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Geometry = require(Shared.IngredientPreviewGeometry)
local Allowed = require(Shared.Constants.ScrapbookPreviews)
local Renderer = {}

function Renderer.Create(image: ImageLabel, id: string, silhouette: boolean?): (() -> ())?
    if not (Allowed :: { [string]: boolean })[id] then
        return nil
    end
    local assets = Shared:FindFirstChild("ScrapbookPreviewAssets")
    local model = Geometry.Clone(if assets then assets:FindFirstChild(id) else nil)
    if not model then
        return nil
    end
    if silhouette then
        -- Change only the private visual copy. Keep meshes, sizes, pivots and
        -- invisible helper parts, but remove every original surface/color cue.
        for _, object in model:GetDescendants() do
            if object:IsA("Decal") or object:IsA("Texture") or object:IsA("SurfaceAppearance") then
                object:Destroy()
            elseif object:IsA("BasePart") then
                object.Color = Color3.fromRGB(8, 8, 10)
                object.Material = Enum.Material.SmoothPlastic
                object.MaterialVariant = ""
                object.Reflectance = 0
                if object.Transparency < 1 then
                    object.Transparency = 0
                end
                if object:IsA("MeshPart") then
                    object.TextureID = ""
                elseif object:IsA("UnionOperation") then
                    object.UsePartColor = true
                end
            elseif object:IsA("DataModelMesh") then
                object.VertexColor = Vector3.new(1, 1, 1)
                if object:IsA("SpecialMesh") then
                    object.TextureId = ""
                end
            end
        end
    end
    local viewport = Instance.new("ViewportFrame")
    viewport.Name = "IngredientPreview"
    viewport.BackgroundTransparency = 1
    viewport.Size = image.Size
    viewport.Position = image.Position
    viewport.AnchorPoint = image.AnchorPoint
    viewport.Rotation = image.Rotation
    viewport.ZIndex = image.ZIndex
    -- Ambient-only lighting keeps silhouettes flat; full-color lighting is unchanged.
    viewport.Ambient = if silhouette then Color3.new(1, 1, 1) else Color3.fromRGB(190, 190, 190)
    viewport.LightColor = if silhouette then Color3.new(0, 0, 0) else Color3.fromRGB(255, 255, 255)
    viewport.LightDirection = Vector3.new(-1, -1, -1)
    local world = Instance.new("WorldModel")
    world.Parent = viewport
    model.Parent = world
    local _, originalSize = model:GetBoundingBox()
    -- Normalize only the private copy, uniformly, to avoid camera near/far-plane
    -- problems with prefabs authored at very small or very large world scales.
    model:ScaleTo(model:GetScale() * 4 / math.max(originalSize.X, originalSize.Y, originalSize.Z, 0.001))
    local box, size = model:GetBoundingBox()
    model:PivotTo(model:GetPivot() - box.Position)
    local camera = Instance.new("Camera")
    camera.FieldOfView = 35
    camera.FieldOfViewMode = Enum.FieldOfViewMode.Vertical
    camera.Parent = viewport
    viewport.CurrentCamera = camera
    local function frame()
        local pixels = viewport.AbsoluteSize
        local aspect = if pixels.Y > 0 then pixels.X / pixels.Y else 1
        local distance = Geometry.Distance(size, aspect, camera.FieldOfView)
        camera.CFrame = CFrame.lookAt(Vector3.new(1, 0.65, 1).Unit * distance, Vector3.zero)
    end
    viewport.Parent = image.Parent
    frame()
    local resized = viewport:GetPropertyChangedSignal("AbsoluteSize"):Connect(frame)
    local disposed = false
    local destroying: RBXScriptConnection? = nil
    local function cleanup()
        if disposed then
            return
        end
        disposed = true
        resized:Disconnect()
        if destroying then
            destroying:Disconnect()
        end
        viewport:Destroy()
    end
    destroying = viewport.Destroying:Connect(cleanup)
    return cleanup
end

return Renderer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="872">
            <Properties>
              <string name="Name">InteractionPromptPresentation</string>
              <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")
local Style = require(script.Parent.WorldBillboardStyle)
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local TouchTargets = require(script.Parent.MobilePromptTouchTargets)
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local Presentation = {}

export type Settings = {
    ActionText: string?,
    FormatText: ((string, boolean) -> string)?,
    KeyText: string?,
    MaxDistance: number?,
    WidthStuds: number?,
    HeightStuds: number?,
    TextSize: number?,
    InputOnly: boolean?,
    CustomerAction: string?,
    TouchWidth: number?,
    TouchHeight: number?,
    TouchCenterY: number?, -- Fraction of the stud-sized visual canvas height.
    CanvasWidth: number?, -- Reference pixel canvas used to convert touch padding to studs.
    CanvasHeight: number?,
    Available: (() -> boolean)?,
}

-- One visible view; the caller owns PromptShown/PromptHidden and calls cleanup.
function Presentation.Create(
    prompt: ProximityPrompt,
    origin: Attachment | BasePart | Model,
    parent: Instance,
    inputType: Enum.ProximityPromptInputType,
    settings: Settings?
): (() -> (), BillboardGui)
    local config: Settings = settings or {}
    local paddedTouch = inputType == Enum.ProximityPromptInputType.Touch and config.TouchWidth ~= nil
    local stashPrompt = prompt:GetAttribute("PlayerStashPrompt") == true
    local gui = Instance.new("BillboardGui")
    gui.Name = "InteractionPromptDisplay"
    gui.Adornee = origin
    local customer = config.CustomerAction ~= nil and not stashPrompt
    -- Preserve the existing overlay so an available interaction stays readable.
    Style.ApplyBillboard(gui, {
        WidthStuds = if customer then 7.1 else config.WidthStuds or 8.4,
        HeightStuds = if customer then 1.45 else config.HeightStuds or 1.7,
        MaxDistance = config.MaxDistance or (if stashPrompt then 30 else 25),
    })
    -- Inactive GuiBase3d disables its whole subtree. Touch input gets its own
    -- small active billboard; the decorative quad must never sink throw taps.
    gui.Active = not paddedTouch

    -- A transparent button preserves touch/click input through the prompt's API.
    local inputButton = if paddedTouch then nil else Instance.new("TextButton")
    local text = (inputButton or Instance.new("TextLabel")) :: TextLabel
    text.Name = "Action"
    if paddedTouch then
        text.Active = false
    end
    Style.ApplyText(text, { TextSize = config.TextSize, TextScaled = true })
    if origin.Name == "DispenserTextOrigin" or stashPrompt or prompt:GetAttribute("JackedNoobPrompt") == true then
        TextStyle.Apply(text, config.TextSize or 24, gui)
    end
    if config.CustomerAction and not stashPrompt then
        -- Shared input behavior, with a compact customer-only visual treatment.
        local billboard = gui :: BillboardGui
        billboard.StudsOffset = Vector3.zero
        billboard.SizeOffset = Vector2.new(0, -(22 + 12) / 44) -- Top edge 12px below the shared rig anchor.
        if config.CustomerAction == "Serve" and origin:IsA("Attachment") then
            local root = origin.Parent
            if root and root:IsA("BasePart") then
                -- Center at the waist, scaled with the rig, without moving the shared anchor.
                billboard.StudsOffsetWorldSpace = Vector3.new(0, root.Size.Y * 0.25 - origin.Position.Y, 0)
                billboard.SizeOffset = Vector2.new(0, 0)
            end
        end
        text.Font = TextStyle.Font
        text.TextSize = 21
        text.TextColor3 = if config.CustomerAction == "TakeOrder" then TextStyle.Gold else Color3.fromRGB(120, 235, 255)
        TextStyle.Outline(text, gui)
    end
    if inputButton then
        inputButton.AutoButtonColor = false
    end
    text.TextScaled = true
    text.Parent = gui
    gui.Parent = parent

    local connections: { RBXScriptConnection } = {}
    local holding = false
    local function refresh()
        local key = config.KeyText
        if not key then
            if inputType == Enum.ProximityPromptInputType.Touch then
                key = "TAP"
            elseif inputType == Enum.ProximityPromptInputType.Gamepad then
                key = prompt.GamepadKeyCode.Name
            else
                key = UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
                if key == "" then
                    key = prompt.KeyboardKeyCode.Name
                end
            end
        end
        text.Text = string.format(
            "[%s] %s%s",
            key or "",
            if holding then "HOLD " else "",
            config.ActionText or prompt.ActionText
        )
        if config.FormatText then
            text.Text = config.FormatText(key or "", holding)
        end
        if config.InputOnly then
            text.Text = string.format("%s[%s]", if holding then "HOLD " else "", key or "")
        end
    end
    for _, property in { "ActionText", "KeyboardKeyCode", "GamepadKeyCode" } do
        table.insert(connections, prompt:GetPropertyChangedSignal(property):Connect(refresh))
    end
    table.insert(
        connections,
        prompt.PromptButtonHoldBegan:Connect(function()
            holding = true
            refresh()
        end)
    )
    table.insert(
        connections,
        prompt.PromptButtonHoldEnded:Connect(function()
            holding = false
            refresh()
        end)
    )
    local activeInput: InputObject? = nil
    local alive = true
    local function release()
        if activeInput then
            activeInput = nil
            if paddedTouch then
                text.TextTransparency = 0
            end
            if prompt.Parent then
                prompt:InputHoldEnd()
            end
        end
    end
    local function begin(input: InputObject)
        local reason: string? = nil
        if not alive then
            reason = "hidden view"
        elseif activeInput then
            reason = "prompt already held by another finger"
        elseif not prompt.Enabled then
            reason = "disabled prompt"
        elseif not prompt:IsDescendantOf(workspace) then
            reason = "invalid source: prompt outside Workspace"
        elseif config.Available and not config.Available() then
            reason = "invalid source: ingredient registration, identity or ownership changed"
        end
        if reason then
            if paddedTouch then
                Debug.Log(prompt, "REJECTED", reason)
            end
            return
        end
        activeInput = input
        -- Immediate, display-only feedback. Inventory still waits for the server.
        if paddedTouch then
            text.TextTransparency = 0.25
        end
        if paddedTouch then
            Debug.Log(prompt, "HOLD BEGIN", "client HoldDuration=" .. tostring(prompt.HoldDuration))
        end
        prompt:InputHoldBegin()
    end
    local unregister: (() -> ())? = nil
    local inputGui: BillboardGui? = nil
    if paddedTouch then
        local touchGui = Instance.new("BillboardGui")
        inputGui = touchGui
        touchGui.Name = "InteractionPromptTouchInput"
        touchGui.Active = true
        local widthRatio = assert(config.TouchWidth) / (config.CanvasWidth or 300)
        local heightRatio = (config.TouchHeight or 96) / (config.CanvasHeight or 56)
        local function alignInput()
            Style.ApplyBillboard(touchGui, {
                WidthStuds = gui.Size.X.Scale * widthRatio,
                HeightStuds = gui.Size.Y.Scale * heightRatio,
                MaxDistance = gui.MaxDistance,
                AlwaysOnTop = gui.AlwaysOnTop,
                ResetOnSpawn = gui.ResetOnSpawn,
            })
            touchGui.Adornee = gui.Adornee
            touchGui.StudsOffset = gui.StudsOffset
            touchGui.StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace
            -- SizeOffset is measured in each billboard's own dimensions. Positive
            -- Y moves upward; the row's fraction is measured downward from top.
            touchGui.SizeOffset = Vector2.new(
                gui.SizeOffset.X / widthRatio,
                (gui.SizeOffset.Y + 0.5 - (config.TouchCenterY or 0.5)) / heightRatio
            )
            touchGui.Enabled = gui.Enabled
            touchGui.Parent = gui.Parent
        end
        for _, property in
            {
                "Size",
                "Adornee",
                "StudsOffset",
                "StudsOffsetWorldSpace",
                "SizeOffset",
                "MaxDistance",
                "AlwaysOnTop",
                "ResetOnSpawn",
                "Enabled",
                "Parent",
            }
        do
            table.insert(connections, gui:GetPropertyChangedSignal(property):Connect(alignInput))
        end
        alignInput()
        local target = Instance.new("TextButton")
        target.Name = "TouchTarget"
        target.Text = ""
        target.BackgroundTransparency = 1
        target.AutoButtonColor = false
        target.Active = true
        target.Selectable = false
        target.ZIndex = text.ZIndex + 1
        target.AnchorPoint = Vector2.new(0.5, 0.5)
        target.Position = UDim2.fromScale(0.5, 0.5)
        target.Size = UDim2.fromScale(1, 1)
        target.Parent = touchGui
        unregister = TouchTargets.Register(prompt, touchGui, target, begin, config.Available)
    else
        table.insert(
            connections,
            text.InputBegan:Connect(function(input)
                local touch = input.UserInputType == Enum.UserInputType.Touch
                local click = input.UserInputType == Enum.UserInputType.MouseButton1 and prompt.ClickablePrompt
                if touch or click then
                    begin(input)
                end
            end)
        )
    end
    table.insert(
        connections,
        UserInputService.InputEnded:Connect(function(input)
            if input == activeInput then
                release()
            end
        end)
    )
    if paddedTouch then
        table.insert(
            connections,
            UserInputService.InputChanged:Connect(function(input)
                if input == activeInput and input.UserInputState == Enum.UserInputState.Cancel then
                    release()
                end
            end)
        )
        table.insert(
            connections,
            prompt.Triggered:Connect(function()
                Debug.Log(prompt, "TRIGGERED", "client native event; server dispatch is logged separately")
            end)
        )
    end
    table.insert(connections, UserInputService.WindowFocusReleased:Connect(release))
    refresh()
    return function()
        alive = false
        if unregister then
            unregister()
        end
        for _, connection in connections do
            connection:Disconnect()
        end
        release()
        if inputGui then
            inputGui:Destroy()
        end
        gui:Destroy()
    end,
        gui
end

return Presentation
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="873">
            <Properties>
              <string name="Name">LuckyBlockHud</string>
              <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local Style = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local Messages = require(script.Parent.LuckyBlockMessages)
local Hud = {}
function Hud.Create(playerGui: PlayerGui)
    local gui = Instance.new("ScreenGui")
    gui.Name = "LuckyPowerups"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = false
    gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
    gui.DisplayOrder = 15
    local canvas = Instance.new("Frame")
    canvas.Size = UDim2.fromScale(1, 1)
    canvas.BackgroundTransparency = 1
    canvas.Parent = gui
    type Row = { Group: CanvasGroup, Label: TextLabel, Tween: Tween }
    local rows: { [string]: Row } = {}
    local function remove(id: string)
        local row = rows[id]
        row.Tween:Cancel()
        row.Group:Destroy()
        rows[id] = nil
    end
    gui.Parent = playerGui
    return {
        Gui = gui,
        Render = function(entries: { Messages.Entry })
            local wanted: { [string]: boolean } = {}
            local x, y, width, height = Messages.Layout(canvas.AbsoluteSize.X, canvas.AbsoluteSize.Y, #entries)
            for index, entry in entries do
                wanted[entry.Id] = true
                local row = rows[entry.Id]
                if not row then
                    local group = Instance.new("CanvasGroup")
                    group.Name = entry.Id
                    group.BackgroundTransparency = 1
                    group.GroupTransparency = 1
                    group.AnchorPoint = Vector2.new(0.5, 0)
                    group.Parent = canvas
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(1, -8, 1, -2)
                    label.Position = UDim2.fromOffset(4, 1)
                    label.BackgroundTransparency = 1
                    Style.Apply(label, 20)
                    label.TextScaled = true
                    label.Parent = group
                    -- Fade the composited row, including its thick dark outline,
                    -- using the same CanvasGroup approach as TutorialTooltip.
                    local tween = TweenService:Create(group, TweenInfo.new(0.15), { GroupTransparency = 0 })
                    row = { Group = group, Label = label, Tween = tween }
                    rows[entry.Id] = row
                    tween:Play()
                end
                row.Label.Text = entry.Text
                row.Group.Position = UDim2.fromOffset(x, y + (index - 1) * height)
                row.Group.Size = UDim2.fromOffset(width, height)
            end
            for id in rows do
                if not wanted[id] then
                    remove(id)
                end
            end
        end,
        Destroy = function()
            for id in rows do
                remove(id)
            end
            gui:Destroy()
        end,
    }
end
return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="874">
            <Properties>
              <string name="Name">LuckyBlockMessages</string>
              <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.LuckyBlockConfig)
local Presentation = require(game:GetService("ReplicatedStorage").Shared.Constants.LuckyBlockPresentation)
local Messages = {}
export type Entry = { Id: string, Text: string }
function Messages.Read(read: (string) -> any, now: number): { Entry }
    local entries: { Entry } = {}
    for _, reward in Config.Rewards do
        local timed = reward.DurationSeconds ~= nil
        local attribute = if timed
            then "LuckyBuff" .. reward.Id .. "ExpiresAt"
            else "LuckyInstant" .. reward.Id .. "Until"
        local expiry = read(attribute)
        if typeof(expiry) == "number" and expiry == expiry and expiry < math.huge then
            local seconds = math.ceil(math.max(0, expiry - now))
            if seconds > 0 then
                local name = string.upper(Presentation.Rewards[reward.Id].Name)
                table.insert(
                    entries,
                    { Id = reward.Id, Text = if timed then name .. " ? " .. seconds .. "s" else name .. " COLLECTED" }
                )
            end
        end
    end
    return entries
end
-- CoreUISafeInsets coordinates. Below the 104px tutorial/announcement banner,
-- central 36% away from thumbstick/CAS edges, above the hotbar/control region.
function Messages.Layout(width: number, height: number, count: number): (number, number, number, number)
    local top = math.ceil(height * 0.065 + 116)
    local bottom = height * (if height > width then 0.55 else 0.72)
    local row = math.min(26, math.max(1, (bottom - top) / math.max(1, count)))
    return width / 2, top, math.min(280, width * 0.36), row
end
return Messages
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="875">
            <Properties>
              <string name="Name">LuckyBlockPickupHandoff</string>
              <string name="Source"><![CDATA[--!strict
-- One rendered owner per PickupId. Replication may deliver identity, art and the
-- terminal state on different frames; none of these authorize server claims.
local Handoff = {}
type Pending = { Release: () -> (), Until: number }
type Public = { Model: Model, Connection: RBXScriptConnection, Ready: boolean, Enabled: { [Instance]: boolean } }
local pending: { [number]: Pending } = {}
local public: { [number]: Public } = {}

local function release(id: number)
    local entry = pending[id]
    pending[id] = nil
    if entry then
        entry.Release()
    end
end
local function visibility(entry: Public, object: Instance, visible: boolean)
    if object:IsA("BasePart") then
        object.LocalTransparencyModifier = if visible then 0 else 1
    elseif object:IsA("ParticleEmitter") or object:IsA("Beam") or object:IsA("Trail") or object:IsA("Light") then
        local effect = object :: any
        if entry.Enabled[object] == nil then
            entry.Enabled[object] = effect.Enabled
        end
        effect.Enabled = visible and entry.Enabled[object]
        if not visible and object:IsA("ParticleEmitter") then
            object:Clear()
        end
    end
end
function Handoff.Track(model: Model)
    local id = model:GetAttribute("PickupId")
    if typeof(id) ~= "number" or public[id] then
        return
    end
    local entry: Public
    entry = {
        Model = model,
        Ready = false,
        Enabled = {},
        Connection = model.DescendantAdded:Connect(function(object)
            visibility(entry, object, entry.Ready)
        end),
    }
    public[id] = entry
    for _, object in model:GetDescendants() do
        visibility(entry, object, false)
    end
end
function Handoff.Untrack(model: Model)
    local id = model:GetAttribute("PickupId")
    if typeof(id) ~= "number" then
        return
    end
    local entry = public[id]
    if entry and entry.Model == model then
        entry.Connection:Disconnect()
        public[id] = nil
        release(id)
    end
end
function Handoff.Ready(id: number): boolean
    local entry = public[id]
    return entry ~= nil and entry.Ready
end
function Handoff.Keep(id: number, callback: () -> (), expiresAt: number)
    release(id)
    pending[id] = { Release = callback, Until = expiresAt }
    local entry = public[id]
    local state = entry and entry.Model:GetAttribute("PickupState")
    if (entry and entry.Ready) or state == "Claimed" or state == "Expired" then
        release(id)
    end
end
function Handoff.Step(now: number)
    for id, entry in public do
        local state = entry.Model:GetAttribute("PickupState")
        if state == "Claimed" or state == "Expired" then
            release(id)
            entry.Ready = false
        elseif state == "Available" then
            local expected = entry.Model:GetAttribute("VisualPartCount")
            local visual = entry.Model:FindFirstChild("RewardVisual")
            local count = 0
            if visual then
                for _, object in visual:GetDescendants() do
                    if object:IsA("BasePart") then
                        count += 1
                    end
                end
            end
            if typeof(expected) == "number" and count >= expected and (expected == 0 or visual ~= nil) then
                -- Remove the local prize before exposing any public geometry/effects.
                release(id)
                entry.Ready = true
                for _, object in entry.Model:GetDescendants() do
                    visibility(entry, object, true)
                end
            end
        end
    end
    for id, entry in pending do
        if now >= entry.Until then
            release(id)
        end
    end
end
return Handoff
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="876">
            <Properties>
              <string name="Name">LuckyBlockSequence</string>
              <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.LuckyBlockPresentation)
local Sequence = {}
export type View = { Show: (string, boolean) -> (), Fade: () -> (), Destroy: () -> () }
export type Schedule = (number, () -> ()) -> () -> ()

-- Explicitly cancellable timeline; no frame listener, input or reward request.
function Sequence.new(schedule: Schedule)
    local active: { [any]: () -> () } = {}
    local manager = {}
    function manager.Cancel(key: any)
        local cleanup = active[key]
        if cleanup then
            cleanup()
        end
    end
    function manager.Start(key: any, rewardId: string, full: boolean, view: View, elapsed: number?): boolean
        manager.Cancel(key)
        local age = math.max(0, elapsed or 0)
        local endAt = Config.RevealSeconds + Config.HoldSeconds + Config.FadeSeconds
        if not (Config.Rewards :: any)[rewardId] or age >= endAt then
            view.Destroy()
            return false
        end
        local cancelled = false
        local timers: { () -> () } = {}
        local function cleanup()
            if cancelled then
                return
            end
            cancelled = true
            active[key] = nil
            for _, cancel in timers do
                cancel()
            end
            view.Destroy()
        end
        active[key] = cleanup
        local function at(seconds: number, callback: () -> ())
            table.insert(
                timers,
                schedule(math.max(0, seconds - age), function()
                    if not cancelled then
                        callback()
                    end
                end)
            )
        end
        if full and age < Config.RevealSeconds then
            local ids: { string } = {}
            for id in Config.Rewards do
                table.insert(ids, id)
            end
            for index = #ids, 2, -1 do
                local other = math.random(index)
                ids[index], ids[other] = ids[other], ids[index]
            end
            local current = 1
            for index, seconds in Config.TickTimes do
                if seconds <= age then
                    current = index
                end
            end
            view.Show(ids[current], true)
            for index = current + 1, #Config.TickTimes do
                local id = ids[index]
                at(Config.TickTimes[index], function()
                    view.Show(id, true)
                end)
            end
        end
        at(Config.RevealSeconds, function()
            view.Show(rewardId, false)
        end)
        at(Config.RevealSeconds + Config.HoldSeconds, view.Fade)
        at(endAt, cleanup)
        return true
    end
    function manager.Destroy()
        local keys = {}
        for key in active do
            table.insert(keys, key)
        end
        for _, key in keys do
            manager.Cancel(key)
        end
    end
    return manager
end

return Sequence
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="877">
            <Properties>
              <string name="Name">LuckyBlockView</string>
              <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage.Shared.Constants.LuckyBlockPresentation)
local Visual = require(script.Parent.LuckyBlockVisual)
local Handoff = require(script.Parent.LuckyBlockPickupHandoff)
local View = {}
type Handle = { Show: (string, boolean) -> (), Fade: () -> (), Destroy: () -> () }
local warned: { [string]: boolean } = {}

function View.Create(position: Vector3, finalOnly: string?, pickupId: number?, pickedUpAt: number?): Handle
    local root = Instance.new("Folder")
    root.Name = "LuckyBlockRoulette"
    local anchor = Instance.new("Part")
    anchor.Name = "PresentationAnchor"
    anchor.Size = Vector3.new(0.01, 0.01, 0.01)
    anchor.Anchored, anchor.Transparency = true, 1
    anchor.CanCollide, anchor.CanTouch, anchor.CanQuery = false, false, false
    anchor.CFrame = CFrame.new(position + Vector3.new(0, Config.HeightOffset, 0))
    anchor.Parent = root
    local labelGui = Instance.new("BillboardGui")
    labelGui.Name = "RewardName"
    labelGui.Adornee = anchor
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    BillboardStyle.ApplyBillboard(
        labelGui,
        { WidthStuds = 4.8, HeightStuds = 0.96, MaxDistance = 45, AlwaysOnTop = false, ResetOnSpawn = true }
    )
    labelGui.StudsOffsetWorldSpace = Vector3.new(0, -Config.ModelSize / 2 - 0.35, 0)
    labelGui.AlwaysOnTop = false
    labelGui.Enabled = false
    labelGui.Active = false
    labelGui.Parent = anchor
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0.25
    label.Parent = labelGui
    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(255, 226, 140)
    light.Range, light.Brightness = 8, 0
    light.Parent = anchor
    local cache = Instance.new("Folder") -- Unparented: unused silhouettes are never visible in Workspace.
    local shadows: { [string]: Model } = {}
    local sources = ReplicatedStorage:FindFirstChild(Config.VisualFolderName)
    local function clone(id: string, silhouette: boolean): Model?
        local definition = Config.Rewards[id]
        local model = Visual.Clone(sources and sources:FindFirstChild(definition.Visual), silhouette)
        if not model then
            if not warned[id] then
                warned[id] = true
                warn(
                    "[LuckyBlockRoulette] Missing usable ReplicatedStorage."
                        .. Config.VisualFolderName
                        .. "."
                        .. definition.Visual
                        .. "; using temporary text only"
                )
            end
        else
            warned[id] = nil
        end
        return model
    end
    if not finalOnly then
        for id in Config.Rewards do
            local model = clone(id, true)
            if model then
                model.Parent = cache
                shadows[id] = model
            end
        end
    end
    local tickSound, popSound = Instance.new("Sound"), Instance.new("Sound")
    tickSound.SoundId, tickSound.Volume = Config.TickSoundId, Config.TickVolume
    popSound.SoundId, popSound.Volume = Config.PopSoundId, Config.PopVolume
    for _, sound in { tickSound, popSound } do
        sound.RollOffMinDistance, sound.RollOffMaxDistance = 8, Config.NearbyDistance
        sound.Parent = anchor
    end
    local scale = Instance.new("NumberValue")
    scale.Value = 1
    scale.Parent = root
    local current: Model? = nil
    local baseScale = 1
    local beat = 0
    local disposed = false
    local fading = false
    local revealed = false
    local handedOff = false
    local awaitingHandoff = false
    local tweens: { Tween } = {}
    local connections: { RBXScriptConnection } = {}
    local function tween(object: Instance, seconds: number, properties: any): Tween
        local animation = TweenService:Create(
            object,
            TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            properties
        )
        table.insert(tweens, animation)
        animation:Play()
        return animation
    end
    table.insert(
        connections,
        scale.Changed:Connect(function()
            if current and not disposed then
                current:ScaleTo(baseScale * math.max(0.01, scale.Value))
            end
        end)
    )
    local view = {}
    local destroyNow: () -> ()
    function view.Show(id: string, silhouette: boolean)
        if disposed or not Config.Rewards[id] then
            return
        end
        if current then
            current.Parent = cache
        end
        beat += 1
        current = if silhouette
            then shadows[id]
            elseif pickupId and Handoff.Ready(pickupId) then nil
            else clone(id, false)
        if current then
            current.Parent = root
            local yaw = if silhouette then (beat - 1) * Config.BeatYawDegrees else Config.RevealYawDegrees
            current:PivotTo(
                if silhouette
                    then anchor.CFrame * CFrame.Angles(math.rad(Config.TiltDegrees), math.rad(yaw), 0)
                    else Visual.Pose(position)
            )
            baseScale = current:GetScale()
        end
        labelGui.Enabled = not silhouette or current == nil
        label.Text = if current
            then Config.Rewards[id].Name
            else (if silhouette then "Missing visual" else Config.Rewards[id].Name .. " (missing model)")
        if not silhouette and pickupId then
            revealed = true
            Handoff.Keep(
                pickupId,
                function()
                    handedOff = true
                    if current then
                        current:Destroy()
                        current = nil
                    end
                    labelGui.Enabled = false
                    if awaitingHandoff then
                        destroyNow()
                    end
                end,
                (pickedUpAt or workspace:GetServerTimeNow())
                    + Config.RevealSeconds
                    + Config.HoldSeconds
                    + Config.FadeSeconds
                    + 60
            )
        end
        if silhouette then
            scale.Value = 1
            tickSound:Stop()
            tickSound.TimePosition = 0
            tickSound:Play()
        else
            tickSound:Stop()
            popSound:Play()
            scale.Value = 0.85
            local pop = tween(scale, Config.PopSeconds, { Value = Config.PopScale })
            table.insert(
                connections,
                pop.Completed:Connect(function(playback)
                    if not disposed and not fading and playback == Enum.PlaybackState.Completed then
                        tween(scale, Config.SettleSeconds, { Value = 1 })
                    end
                end)
            )
            light.Brightness = 2
            tween(light, 0.25, { Brightness = 0 })
        end
    end
    function view.Fade()
        if disposed then
            return
        end
        fading = true
        for _, animation in tweens do
            animation:Cancel()
        end
        if pickupId and revealed then
            scale.Value = 1 -- The prize remains at its settled reveal scale.
        else
            tween(scale, Config.FadeSeconds, { Value = 0.01 })
        end
        tween(label, Config.FadeSeconds, { TextTransparency = 1, TextStrokeTransparency = 1 })
        light.Brightness = 0
    end
    destroyNow = function()
        if disposed then
            return
        end
        disposed = true
        for _, connection in connections do
            connection:Disconnect()
        end
        for _, animation in tweens do
            animation:Cancel()
        end
        tickSound:Stop()
        popSound:Stop()
        root:Destroy()
        cache:Destroy()
    end
    function view.Destroy()
        if pickupId and revealed and not handedOff and not disposed then
            awaitingHandoff = true
            view.Fade()
            tickSound:Stop()
            popSound:Stop()
            return -- Keep the prize across cancellation/death or delayed replication.
        end
        destroyNow()
    end
    root.Parent = workspace
    return view
end

return View
]]></string>
            </Properties>
          </Item>
