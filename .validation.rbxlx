          <Item class="ModuleScript" referent="847">
            <Properties>
              <string name="Name">TutorialAlertController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Gui = require(script.Parent.Parent.UI.UpgradesGui)
local Notifications = require(script.Parent.Parent.UI.MenuNotifications)
local State = require(script.Parent.TutorialAlertState)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
        local state = State.new()
        type Pulse = { Scale: UIScale, Tween: Tween? }
        local arrows: { [GuiObject]: Pulse } = {}
        local view: Gui.View? = nil

        local function show(arrow: GuiObject?, visible: boolean)
            local pulse = if arrow then arrows[arrow] else nil
            if not arrow or not pulse then
                return
            end
            arrow.Visible = visible
            if visible and not pulse.Tween then
                pulse.Scale.Scale = 1
                local tween = TweenService:Create(
                    pulse.Scale,
                    TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
                    { Scale = 1.15 }
                )
                pulse.Tween = tween
                tween:Play()
            elseif not visible then
                if pulse.Tween then
                    pulse.Tween:Cancel()
                    pulse.Tween = nil
                end
                pulse.Scale.Scale = 1
            end
        end
        local function numberAttribute(name: string): number
            local value = player:GetAttribute(name)
            return if type(value) == "number" then value else 0
        end
        local function refresh()
            local stage = player:GetAttribute("TutorialStage")
            local output = state.Evaluate({
                TutorialActive = player:GetAttribute("TutorialActive") == true,
                Stage = if type(stage) == "string" then stage else nil,
                Cash = numberAttribute("playerCash"),
                Levels = {
                    Jump = numberAttribute("JumpPurchasedLevel"),
                    Bat = numberAttribute("BatPurchasedLevel"),
                },
                PanelOpen = Notifications.IsOpen("Upgrades"),
            })
            if view then
                show(view.MenuArrow, output.MenuVisible)
                for name, arrow in view.PanelArrows do
                    show(arrow, name == output.PanelArrow)
                end
            end
        end
        local function bind(arrow: GuiObject?)
            if not arrow or arrows[arrow] then
                return
            end
            arrow.Visible = false
            local scale = arrow:FindFirstChildOfClass("UIScale") :: UIScale?
            if not scale then
                local created = Instance.new("UIScale")
                created.Name = "TutorialAlertScale"
                created.Parent = arrow
                scale = created
            end
            local boundScale = scale :: UIScale
            boundScale.Scale = 1
            arrows[arrow] = { Scale = boundScale, Tween = nil }
        end
        for _, attribute in
            {
                "playerCash",
                "JumpPurchasedLevel",
                "BatPurchasedLevel",
                "TutorialActive",
                "TutorialStage",
            }
        do
            player:GetAttributeChangedSignal(attribute):Connect(refresh)
        end
        Notifications.OnChanged("Upgrades", refresh)
        Gui.Observe(playerGui, function(nextView)
            for arrow in arrows do
                show(arrow, false)
            end
            table.clear(arrows)
            view = nextView
            if nextView then
                bind(nextView.MenuArrow)
                for _, arrow in nextView.PanelArrows do
                    bind(arrow)
                end
            end
            refresh()
        end, function() end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="848">
            <Properties>
              <string name="Name">TutorialAlertState</string>
              <string name="Source"><![CDATA[--!strict
-- Session-only presentation state; replicated attributes remain authoritative.
local Upgrades: { [string]: { { Cost: number, Value: number } } } =
    require(game:GetService("ReplicatedStorage").Shared.Constants.Upgrades)
local State = {}
State.Beats = {
    { Id = "Jump1", TrackId = "Jump", ArrowName = "Jump1Alert" },
    { Id = "Bat1", TrackId = "Bat", ArrowName = "BatAlert" },
}
export type Inputs = {
    TutorialActive: boolean,
    Stage: string?,
    Cash: number,
    Levels: { [string]: number },
    PanelOpen: boolean,
}
export type Output = { MenuVisible: boolean, PanelArrow: string? }

function State.new()
    local latched: { [string]: boolean } = {}
    local cleared: { [string]: boolean } = {}
    local finished = false
    return {
        Evaluate = function(inputs: Inputs): Output
            if inputs.Stage == "Complete" then
                finished = true
            end
            for _, beat in State.Beats do
                if (inputs.Levels[beat.TrackId] or 0) >= 1 then
                    cleared[beat.Id] = true
                end
                if inputs.Cash >= Upgrades[beat.TrackId][2].Cost then
                    latched[beat.Id] = true
                end
            end
            if inputs.TutorialActive == true and not finished then
                for _, beat in State.Beats do
                    if latched[beat.Id] and not cleared[beat.Id] then
                        return {
                            MenuVisible = not inputs.PanelOpen,
                            PanelArrow = if inputs.PanelOpen then beat.ArrowName else nil,
                        }
                    end
                end
            end
            return { MenuVisible = false, PanelArrow = nil }
        end,
    }
end

return State
]]></string>
            </Properties>
