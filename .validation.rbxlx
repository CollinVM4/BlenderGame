        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local Config = require(script.Parent.AdminConfig)

local AdminService = {}
local deps: any
local initialized = false
local adminUserIds: { [number]: boolean } = {}
local lastExecution: { [Player]: number? } = {}
local chatConnections: { [Player]: RBXScriptConnection } = {}

local commands: { [string]: (Player, { string }) -> boolean } = {}
commands.giveicegun = function(player: Player, args: { string }): boolean
    if #args ~= 1 then
        warn("[Admin] Usage: ;giveicegun username")
        return false
    end
    local username = string.lower(args[1])
    local target: Player? = nil
    for _, candidate in Players:GetPlayers() do
        if string.lower(candidate.Name) == username then
            target = candidate
            break
        end
    end
    if not target or not deps.IceGunService.GrantOnce(target) then
        warn("[Admin] giveicegun requires an online player with a living character and Backpack")
        return false
    end
    print(
        string.format(
            "[Admin] %s (%d) gave a one-life Ice Gun to %s (%d)",
            player.Name,
            player.UserId,
            target.Name,
            target.UserId
        )
    )
    return true
end
commands.addcash = function(player: Player, args: { string }): boolean
    local amount = if #args == 1 then tonumber(args[1]) else nil
    if not amount or amount ~= amount or amount <= 0 or amount > Config.MaxAddCash then
        warn("[Admin] Rejected addCash amount " .. table.concat(args, " "))
        return false
    end
    amount = math.floor(amount)
    if amount == 0 then
        warn("[Admin] addCash amount must floor to a positive integer")
        return false
    end
    if not deps.TycoonService.GetSessionId(player) then
        warn("[Admin] addCash requires an active plot/session for " .. player.Name)
        return false
    end
    local before = deps.TycoonService.GetCash(player)
    local balance = deps.TycoonService.AddCash(player, amount)
    if balance ~= before + amount then
        warn("[Admin] addCash could not commit for " .. player.Name)
        return false
    end
    print(string.format("[Admin] %s (%d) executed addCash %d -> %.0f", player.Name, player.UserId, amount, balance))
    return true
end

-- Only server chat callbacks call this dispatcher; there is no admin remote.
function AdminService.HandleCommand(player: Player, message: string): boolean
    if player.Parent ~= Players or not adminUserIds[player.UserId] then
        return false
    end
    local name, remainder = string.match(message, "^%s*;(%S+)%s*(.*)$")
    if not name then
        return false
    end
    local now = os.clock()
    local previous = lastExecution[player]
    if previous and now - previous < Config.CommandCooldownSeconds then
        return false
    end
    local command = commands[string.lower(name)]
    if not command then
        warn("[Admin] Unknown command " .. name)
        return false
    end
    local args = {}
    for argument in string.gmatch(remainder or "", "%S+") do
        table.insert(args, argument)
    end
    -- Reserve before executing, which can invoke immediate server signals.
    lastExecution[player] = now
    local ok, accepted = pcall(command, player, args)
    if not ok or not accepted then
        lastExecution[player] = previous
        if not ok then
            warn("[Admin] Command failed for " .. player.Name .. ": " .. tostring(accepted))
        end
        return false
    end
    return true
end

function AdminService.RemovePlayer(player: Player)
    lastExecution[player] = nil
    local connection = chatConnections[player]
    if connection then
        connection:Disconnect()
        chatConnections[player] = nil
    end
end

function AdminService.Init(services: any)
    if initialized then
        return
    end
    initialized = true
    deps = services
    for _, userId in Config.AdminUserIds do
        adminUserIds[userId] = true
    end
    -- Each name is attempted once. Failed lookups fail closed without delaying bootstrap.
    for _, username in Config.BootstrapUsernames do
        task.spawn(function()
            local ok, userId = pcall(function()
                return Players:GetUserIdFromNameAsync(username)
            end)
            if ok and type(userId) == "number" and userId > 0 and userId < math.huge and userId % 1 == 0 then
                adminUserIds[userId] = true
                print(string.format("[Admin] %s -> %d", username, userId))
            else
                warn("[Admin] Could not resolve " .. username .. "; no bootstrap permission granted")
            end
        end)
    end

    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        for name in commands do
            local command = Instance.new("TextChatCommand")
            command.Name = "Admin_" .. name
            command.PrimaryAlias = ";" .. name
            command.AutocompleteVisible = false
            command.Triggered:Connect(function(source: TextSource, message: string)
                local player = Players:GetPlayerByUserId(source.UserId)
                if player then
                    AdminService.HandleCommand(player, message)
                end
            end)
            command.Parent = TextChatService
        end
    else
        local function bindPlayer(player: Player)
            if not chatConnections[player] then
                chatConnections[player] = player.Chatted:Connect(function(message)
                    AdminService.HandleCommand(player, message)
                end)
            end
        end
        Players.PlayerAdded:Connect(bindPlayer)
        for _, player in Players:GetPlayers() do
            bindPlayer(player)
        end
    end
    Players.PlayerRemoving:Connect(AdminService.RemovePlayer)
end

return AdminService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="62">
        <Properties>
          <string name="Name">Components</string>
        </Properties>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">AnnouncedIngredientSpawn</string>
            <string name="Source"><![CDATA[--!strict
--! Server script for announcing rare ingredient spawns to clients.
local IngredientSpawn = require(script.Parent.IngredientSpawn)
local AnnouncedIngredientSpawn = {}
local started = false

function AnnouncedIngredientSpawn.Init(services: any)
    if started then
        return
    end
    started = true
    IngredientSpawn.Bind(services, "AnnouncedIngredientSpawn", function(station, id)
        services.AnnouncementService.Spawned(station, id)
    end)
end

return AnnouncedIngredientSpawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">BlendProgressLights</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderReadyIndicator = require(script.Parent.BlenderReadyIndicator)
local BlendProgressLights = {}

type Light = {
    Bulb: BasePart,
    Point: PointLight,
    Insert: BasePart?,
    OffMaterial: Enum.Material,
    Brightness: number,
    Mode: string,
}

local function playClick(light: Light)
    local sound = Instance.new("Sound")
    sound.Name = "BlendThresholdClick"
    sound.SoundId = "rbxassetid://113416294133952"
    sound.Volume = 0.5
    sound.RollOffMaxDistance = 60
    sound.Parent = light.Bulb
    sound.Ended:Once(function()
        sound:Destroy()
    end)
    Debris:AddItem(sound, 10)
    sound:Play()
end

local function setMode(light: Light, mode: string)
    if light.Mode == mode then
        return
    end
    light.Mode = mode
    light.Bulb.Material = if mode == "solid" then Enum.Material.Neon else light.OffMaterial
    if light.Insert then
        light.Insert.Transparency = if mode == "off" then 1 else 0
    end
    light.Point.Enabled = mode ~= "off"
    light.Point.Brightness = if mode == "off" then 0 else light.Brightness
end

function BlendProgressLights.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        local folder = blender and blender:FindFirstChild("BlendProgressLights")
        if not folder then
            return nil
        end
        -- Group physical bulbs by milestone; banks never own progress or clicks.
        local lights: { { Light } } = { {}, {}, {}, {}, {} }
        local clicked: { [number]: boolean } = {}
        local banks: { Instance } = {}
        if folder:FindFirstChild("Light1") then
            -- Preserve the original single-bank hierarchy during Studio migration.
            table.insert(banks, folder)
        else
            for _, bank in folder:GetChildren() do
                if bank:IsA("Folder") or bank:IsA("Model") then
                    table.insert(banks, bank)
                end
            end
        end
        table.sort(banks, function(a, b)
            return a.Name < b.Name
        end)
        for _, bank in banks do
            local bankContext = bank:GetFullName()
            for index = 1, 5 do
                local model = bank:FindFirstChild("Light" .. index)
                local bulb = if model and model:IsA("Model") then model:FindFirstChild("Bulb") else nil
                local point = bulb and bulb:FindFirstChild("PointLight")
                local insert = if model then model:FindFirstChild("Light") else nil
                if bulb and bulb:IsA("BasePart") and point and point:IsA("PointLight") then
                    if not insert or not insert:IsA("BasePart") then
                        warn("[BlendProgressLights] Expected " .. bankContext .. ".Light" .. index .. ".Light BasePart")
                    end
                    table.insert(lights[index], {
                        Bulb = bulb,
                        Point = point,
                        Insert = if insert and insert:IsA("BasePart") then insert else nil,
                        OffMaterial = if bulb.Material == Enum.Material.Neon
                            then Enum.Material.SmoothPlastic
                            else bulb.Material,
                        -- An authored zero is an off setting; use a visible solid fallback.
                        Brightness = if point.Brightness > 0 then point.Brightness else 1.5,
                        Mode = "",
                    })
                else
                    warn("[BlendProgressLights] Expected " .. bankContext .. ".Light" .. index .. ".Bulb.PointLight")
                end
            end
        end

        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local function refresh(playThresholdClicks: boolean?)
            local player = owner
            local state = player and player:GetAttribute("BlendState") or "EMPTY"
            local progress = player and player:GetAttribute("BlendProgress") or 0
            -- BlendService publishes DISPENSED after a successful dispense, then
            -- Reset publishes EMPTY. Stopping progress production is not a reset.
            local reset = state == "EMPTY" or state == "DISPENSED"
            local completed = if reset
                then 0
                else math.clamp(math.floor((progress :: number) / Economy.RequiredProgress * 5), 0, 5)
            if completed == 5 and not BlenderReadyIndicator.IsReady(state, progress) then
                completed = 4
            end
            for index, milestoneLights in lights do
                for _, light in milestoneLights do
                    setMode(light, if index <= completed then "solid" else "off")
                end
                if reset then
                    clicked[index] = nil
                elseif index <= completed and index <= 4 and not clicked[index] then
                    clicked[index] = true
                    local soundSource = milestoneLights[1]
                    if playThresholdClicks ~= false and soundSource then
                        playClick(soundSource)
                    end
                end
            end
        end
        local function bindOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
            table.clear(clicked)
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            local player = owner
            if player then
                for _, attribute in { "BlendProgress", "BlendState" } do
                    table.insert(ownerConnections, player:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
            end
            -- Binding an already-progressed batch restores visuals silently;
            -- only subsequent authoritative threshold crossings play clicks.
            refresh(false)
        end
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                owner = nil
                refresh()
            end
        end)
        bindOwner()
        return function()
            ownership:Disconnect()
            leaving:Disconnect()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            for _, milestoneLights in lights do
                for _, light in milestoneLights do
                    setMode(light, "off")
                end
            end
        end
    end)
end

return BlendProgressLights
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">BlendVFX</string>
            <string name="Source"><![CDATA[--!strict
-- Presentation only. BlendService owns acceptance, progress, color and reset.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local BlendVFX = {}
-- Legacy fallback in BlendVisualOrigin's local axes; never scales templates.
local IngredientSlotNames = { "IngredientSlot1", "IngredientSlot2", "IngredientSlot3" }
local IngredientOffsetRadius = 1.8 -- studs; fit to the jar's interior clearance
local IngredientVerticalSpread = 0.4 -- studs per local Y offset below
local IngredientArrivalDuration = 0.35 -- seconds; existing arrival timing
local IngredientOffsets = {
    Vector3.new(1, -0.4, 0.05),
    Vector3.new(-0.65, 0.15, 0.75),
    Vector3.new(-0.5, -0.2, -0.8),
    Vector3.new(0.55, -0.6, 0.7),
    Vector3.new(-0.95, 0.4, -0.1),
    Vector3.new(0.4, 0, -0.75),
}
-- Keep authored values across tag removal/re-entry; detached liquid is hidden.
-- Weak keys release the cache when a plot's liquid is destroyed and collected.
local liquidDefaults = setmetatable({} :: { [BasePart]: { Color: Color3, Transparency: number } }, { __mode = "k" })

-- Temporary lifecycle diagnostics; never print progress updates every frame.
local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[BlendVFX] " .. message)
    end
end

local function findLiquid(blender: Instance, visuals: Instance?): BasePart?
    local container = blender:FindFirstChild("Liquid")
    local nested = container and container:FindFirstChild("Liquid")
    if nested and nested:IsA("BasePart") then
        return nested
    end
    if container and container:IsA("BasePart") then
        return container
    end
    -- Imported models may nest the named liquid under Body/Glass/etc. Never
    -- select arbitrary geometry or an ingredient proxy as the smoothie surface.
    local found: BasePart? = nil
    for _, candidate in blender:GetDescendants() do
        if
            candidate:IsA("BasePart")
            and string.lower(candidate.Name) == "liquid"
            and not (visuals and candidate:IsDescendantOf(visuals))
        then
            if found then
                diagnostic("liquid ambiguous=true; multiple named Liquid parts")
                return nil
            end
            found = candidate
        end
    end
    return found
end

local function sanitize(proxy: Instance, playerHead: boolean?)
    local descendants = proxy:GetDescendants()
    table.insert(descendants, proxy)
    for _, child in descendants do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        for attribute in child:GetAttributes() do
            child:SetAttribute(attribute, nil)
        end
        -- Keep geometry and appearance only, before anything enters Workspace.
        if child:IsA("BasePart") then
            child.Anchored = true
            child.CanCollide = false
            child.CanTouch = false
            child.CanQuery = false
        elseif
            not (
                child:IsA("Model")
                or child:IsA("Folder")
                or child:IsA("DataModelMesh")
                or child:IsA("Decal")
                or child:IsA("Texture")
                or child:IsA("SurfaceAppearance")
                or child:IsA("Attachment")
                or (playerHead and (child:IsA("FaceControls") or child:IsA("BaseWrap")))
            )
        then
            child:Destroy()
        end
    end
end

function BlendVFX.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        if not blender then
            return nil
        end
        diagnostic("bound plot=" .. plot.Name)
        diagnostic("bound blender path=" .. blender:GetFullName())
        for _, child in blender:GetChildren() do
            diagnostic("child name=" .. child.Name .. " class=" .. child.ClassName)
        end
        local folder = blender:FindFirstChild("IngredientVisuals")
        diagnostic("IngredientVisuals found=" .. tostring(folder ~= nil and folder:IsA("Folder")))
        local createdFolder = false
        if not folder then
            local fallback = Instance.new("Folder")
            fallback.Name = "IngredientVisuals"
            fallback.Parent = blender
            folder = fallback
            createdFolder = true
        elseif not folder:IsA("Folder") then
            warn("[BlendVFX] Expected Blender.IngredientVisuals Folder; ingredient visuals skipped")
            folder = nil
        end
        local visuals = folder
        local origin = blender:FindFirstChild("BlendVisualOrigin")
        diagnostic("BlendVisualOrigin found=" .. tostring(origin ~= nil))
        local liquid: BasePart? = nil
        local originalColor = Color3.new(1, 1, 1)
        local finishedTransparency = 0
        local function discoverLiquid()
            local container = blender:FindFirstChild("Liquid")
            local nested = container and container:FindFirstChild("Liquid")
            local count = 0
            for _, candidate in blender:GetDescendants() do
                if candidate:IsA("BasePart") and string.find(string.lower(candidate.Name), "liquid", 1, true) then
                    count += 1
                end
            end
            diagnostic("liquid container direct=" .. tostring(container ~= nil))
            diagnostic("liquid nested part=" .. tostring(nested ~= nil and nested:IsA("BasePart")))
            diagnostic("liquid descendant candidates=" .. tostring(count))
            liquid = findLiquid(blender, blender:FindFirstChild("IngredientVisuals"))
            diagnostic(
                "liquid found="
                    .. tostring(liquid ~= nil)
                    .. " path="
                    .. (if liquid then liquid:GetFullName() else "<none>")
            )
            if liquid then
                diagnostic(
                    "liquid anchored=" .. tostring(liquid.Anchored) .. " archivable=" .. tostring(liquid.Archivable)
                )
                if not liquidDefaults[liquid] then
                    liquidDefaults[liquid] = { Color = liquid.Color, Transparency = liquid.Transparency }
                end
                local defaults = liquidDefaults[liquid]
                originalColor = defaults.Color
                finishedTransparency = defaults.Transparency
            end
        end
        discoverLiquid()
        if not origin or not (origin:IsA("BasePart") or origin:IsA("Attachment")) then
            warn("[BlendVFX] Expected Blender.BlendVisualOrigin BasePart or Attachment; ingredient visuals skipped")
        end
        local emitters: { ParticleEmitter } = {}
        local seen: { [Instance]: boolean } = {}
        local function isPuffEmitter(emitter: ParticleEmitter): boolean
            return string.sub(string.lower(emitter.Name), 1, 4) == "puff"
        end
        local function collectEmitters(root: Instance?)
            if not root then
                return
            end
            local candidates = root:GetDescendants()
            table.insert(candidates, root)
            for _, candidate in candidates do
                if candidate:IsA("ParticleEmitter") and isPuffEmitter(candidate) and not seen[candidate] then
                    seen[candidate] = true
                    table.insert(emitters, candidate)
                end
            end
        end
        collectEmitters(origin)
        diagnostic("emitters found=" .. tostring(#emitters))
        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local tweens: { Tween } = {}
        local displayed: { [number]: boolean } = {}
        local ownedVisuals: { Instance } = {}
        local cloudActive = false
        local phase = ""
        local lastProgress = 0
        local lastIncreaseAt = 0
        local activityTimer: thread? = nil
        local activityGrace = 0.35
        local function cloud(enabled: boolean)
            cloudActive = enabled
            for _, emitter in emitters do
                emitter.Enabled = enabled
                if not enabled then
                    emitter:Clear() -- Immediate completion reveal, including long-lived particles.
                end
            end
        end
        local function stopActivity()
            if activityTimer then
                task.cancel(activityTimer)
                activityTimer = nil
            end
            cloud(false)
        end
        local function expireActivity()
            activityTimer = nil
            local remaining = activityGrace - (os.clock() - lastIncreaseAt)
            if remaining > 0 then
                activityTimer = task.delay(remaining, expireActivity)
            else
                if cloudActive then
                    diagnostic("blend visual idle")
                end
                cloud(false)
            end
        end
        local function clearIngredients()
            for _, tween in tweens do
                tween:Cancel()
            end
            table.clear(tweens)
            table.clear(displayed)
            for _, child in ownedVisuals do
                child:Destroy()
            end
            table.clear(ownedVisuals)
        end
        local function reset()
            if phase ~= "reset" then
                diagnostic("reset")
            end
            phase = "reset"
            clearIngredients()
            stopActivity()
            lastProgress = 0
            if liquid then
                liquid.Color = originalColor
                liquid.Transparency = 1
            end
        end
        local function addIngredient(id: string, index: number, from: CFrame?, item: Types.IngredientItem?)
            if displayed[index] or not origin or not visuals then
                return
            end
            local at: CFrame
            if origin:IsA("BasePart") then
                at = origin.CFrame
            elseif origin:IsA("Attachment") then
                at = origin.WorldCFrame
            else
                return
            end
            local proxy = services.IngredientService.CreateVisual(id, item)
            diagnostic("visual source found=" .. tostring(proxy ~= nil))
            if not proxy then
                return
            end
            sanitize(proxy, id == "PlayerHead")
            local physical = proxy :: any
            -- Resolve the complete authored set at placement time. Exact direct
            -- Blender children take precedence; origin children are also supported.
            local slots: { Attachment } = {}
            for _, name in IngredientSlotNames do
                local candidate = blender:FindFirstChild(name) or origin:FindFirstChild(name)
                if candidate and candidate:IsA("Attachment") then
                    table.insert(slots, candidate)
                end
            end
            local target: CFrame
            if index >= 1 and index <= #IngredientSlotNames and #slots == #IngredientSlotNames then
                target = slots[index].WorldCFrame
            else
                if index > #IngredientSlotNames and RunService:IsStudio() then
                    warn(
                        string.format(
                            "[BlendVFX] Unexpected ingredient index=%d plot=%s; expected exactly 3, using presentation offset fallback",
                            index,
                            plot:GetFullName()
                        )
                    )
                end
                -- An incomplete set falls back as a whole, preserving legacy layout.
                local offset = IngredientOffsets[(index - 1) % #IngredientOffsets + 1]
                local localOffset = Vector3.new(
                    offset.X * IngredientOffsetRadius,
                    offset.Y * IngredientVerticalSpread,
                    offset.Z * IngredientOffsetRadius
                )
                target = at * CFrame.new(localOffset.X, localOffset.Y, localOffset.Z)
            end
            local start = from or target
            physical:PivotTo(start)
            proxy.Name = "BlendIngredientVisual"
            proxy.Parent = visuals
            table.insert(ownedVisuals, proxy)
            diagnostic("visual created=" .. proxy:GetFullName())
            displayed[index] = true
            local parts = proxy:GetDescendants()
            table.insert(parts, proxy)
            for _, part in parts do
                if part:IsA("BasePart") and from then
                    local tween = TweenService:Create(
                        part,
                        TweenInfo.new(IngredientArrivalDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                        {
                            CFrame = target * start:ToObjectSpace(part.CFrame),
                        }
                    )
                    table.insert(tweens, tween)
                    tween:Play()
                end
            end
        end
        local function refresh()
            local player = owner
            -- Snapshot avoids observing a half-published state/progress attribute pair.
            local batch = player and services.BlendService.GetSnapshot(player)
            if not batch or batch.State == "EMPTY" or batch.State == "DISPENSED" then
                reset()
                return
            end
            local complete = batch.State == "COMPLETE"
            local active = batch.Progress > 0
            if not active and not complete then
                phase = "loaded"
                if liquid then
                    liquid.Color = originalColor
                    liquid.Transparency = 1
                end
                return
            end
            if complete then
                if phase ~= "complete" then
                    diagnostic("complete")
                end
                phase = "complete"
            else
                phase = "blending"
            end
            clearIngredients()
            if complete then
                stopActivity()
            elseif batch.Progress > lastProgress then
                lastIncreaseAt = os.clock()
                if not cloudActive then
                    diagnostic("blend active progress=" .. tostring(batch.Progress))
                end
                cloud(true)
                if not activityTimer then
                    activityTimer = task.delay(activityGrace, expireActivity)
                end
            end
            lastProgress = batch.Progress
            if liquid and player then
                local color = if batch.Result then batch.Result.Color else player:GetAttribute("BlendColor")
                if typeof(color) == "Color3" then
                    liquid.Color = color
                end
                local progress = if complete then 1 else math.clamp(batch.Progress / Economy.RequiredProgress, 0, 1)
                -- Preserve the authored endpoint; zero progress is fully hidden.
                liquid.Transparency = if progress == 1
                    then finishedTransparency
                    else 1 + (finishedTransparency - 1) * progress
            end
        end
        local function disconnectOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
        end
        local function bindOwner()
            disconnectOwner()
            reset()
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            local player = owner
            if player then
                for _, attribute in { "BlendProgress", "BlendState", "BlendColor" } do
                    table.insert(ownerConnections, player:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
                local batch = services.BlendService.GetSnapshot(player)
                if batch and (batch.State == "LOADING" or batch.State == "READY") and batch.Progress == 0 then
                    for index, id in batch.Ingredients do
                        addIngredient(id, index, nil, batch.IngredientItems and batch.IngredientItems[index])
                    end
                end
            end
            refresh()
        end
        local accepted = services.BlendService.ObserveIngredientAccepted(function(player, id, at, index)
            diagnostic("accepted ingredient=" .. id)
            if player ~= owner then
                diagnostic("accepted visual skipped owner mismatch plot=" .. plot.Name)
                return
            end
            local batch = services.BlendService.GetSnapshot(player)
            if
                batch
                and (batch.State == "LOADING" or batch.State == "READY")
                and batch.Progress == 0
                and batch.Ingredients[index] == id
            then
                addIngredient(id, index, at, batch.IngredientItems and batch.IngredientItems[index])
            else
                diagnostic(
                    "accepted visual skipped state="
                        .. tostring(batch and batch.State)
                        .. " progress="
                        .. tostring(batch and batch.Progress)
                )
            end
        end)
        diagnostic("ObserveIngredientAccepted connected=true")
        local alive = true
        local function liquidHierarchyChanged(object: Instance)
            if string.lower(object.Name) ~= "liquid" then
                return
            end
            diagnostic("liquid hierarchy changed path=" .. object:GetFullName())
            task.defer(function()
                if alive then
                    discoverLiquid()
                    refresh()
                end
            end)
        end
        local liquidAdded = blender.DescendantAdded:Connect(liquidHierarchyChanged)
        local liquidRemoving = blender.DescendantRemoving:Connect(liquidHierarchyChanged)
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                disconnectOwner()
                owner = nil
                reset()
            end
        end)
        bindOwner()
        return function()
            alive = false
            liquidAdded:Disconnect()
            liquidRemoving:Disconnect()
            accepted:Disconnect()
            ownership:Disconnect()
            leaving:Disconnect()
            disconnectOwner()
            owner = nil
            reset()
            if createdFolder and visuals and #visuals:GetChildren() == 0 then
                visuals:Destroy()
            end
        end
    end)
end

return BlendVFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">BlenderInput</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderInput = {}
function BlenderInput.Init(services: any)
    WorldUtil.BindTag("BlenderInput", function(object)
        if not object:IsA("BasePart") then
            warn("[BlenderInput] Tag a BasePart")
            return nil
        end
        local elapsed = 0
        local connection = RunService.Heartbeat:Connect(function(dt)
            elapsed += dt
            if elapsed < 0.1 then
                return
            end
            elapsed = 0
            local owner = services.TycoonService.GetOwner(object)
            if not owner then
                return
            end
            local seen: { [Instance]: boolean } = {}
            for _, part in workspace:GetPartsInPart(object) do
                local item = services.IngredientService.Resolve(part)
                if item and not seen[item] then
                    seen[item] = true
                    local record = services.IngredientService.GetRecord(item)
                    local actor = if record and record.Owner then record.Owner else owner
                    services.BlendService.TryInput(actor, item, object)
                end
            end
        end)
        return function()
            connection:Disconnect()
        end
    end)
end
return BlenderInput
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">BlenderKillScript</string>
            <string name="Source">local CollectionService = game:GetService("CollectionService")

local BlenderKill = {}

local TAG = "KillZone"

local function connectKillPart(part: Instance)
    if not part:IsA("BasePart") then
        return
    end

    if part:GetAttribute("KillZoneConnected") then
        return
    end

    part:SetAttribute("KillZoneConnected", true)

    part.Touched:Connect(function(hit)
        local character = hit:FindFirstAncestorOfClass("Model")
        if not character then
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health &gt; 0 then
            humanoid.Health = 0
        end
    end)
end

function BlenderKill.Init()
    for _, instance in CollectionService:GetTagged(TAG) do
        connectKillPart(instance)
    end

    CollectionService:GetInstanceAddedSignal(TAG):Connect(connectKillPart)
end

return BlenderKill</string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">BlenderReadyIndicator</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderReadyIndicator = {}

-- Presentation of BlendService's published state only; never authorizes dispensing.
-- READY means loaded, whereas COMPLETE means blended and dispensable.
function BlenderReadyIndicator.IsReady(state: any, progress: any): boolean
    return state == "COMPLETE" and typeof(progress) == "number" and progress >= Economy.RequiredProgress
end

function BlenderReadyIndicator.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        local marker = blender and blender:FindFirstChild("ReadyIndicatorOrigin", true)
        if not marker or not (marker:IsA("BasePart") or marker:IsA("Attachment")) then
            warn("[BlenderReadyIndicator] Missing BasePart/Attachment ReadyIndicatorOrigin in " .. plot:GetFullName())
            return nil
        end
        local disk = Instance.new("Part")
        disk.Name = "BlenderReadyFloorIndicator"
        disk.Shape = Enum.PartType.Cylinder
        disk.Size = Vector3.new(0.15, 8, 8
)
        disk.Anchored = true
        disk.CanCollide = false
        disk.CanTouch = false
        disk.CanQuery = false
        disk.CastShadow = false
        disk.Material = Enum.Material.Neon
        disk.Color = Color3.fromRGB(1, 189, 29)
        disk.Transparency = 1
        -- Cylinder length is local X. Ignore marker rotation to remain floor-flat.
        local function place()
            local position = if marker:IsA("Attachment") then marker.WorldPosition else (marker :: BasePart).Position
            disk.CFrame = CFrame.new(position + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2)
        end
        place()
        disk.Parent = marker
        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local function refresh()
            local ready = owner ~= nil
                and BlenderReadyIndicator.IsReady(owner:GetAttribute("BlendState"), owner:GetAttribute("BlendProgress"))
            if ready then
                place()
            end
            disk.Transparency = if ready then 0.1 else 1
        end
        local function disconnectOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
        end
        local function bindOwner()
            disconnectOwner()
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            if owner then
                for _, attribute in { "BlendState", "BlendProgress" } do
                    table.insert(ownerConnections, owner:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
            end
            refresh()
        end
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                disconnectOwner()
                owner = nil
                refresh()
            end
        end)
        bindOwner()
        return function()
            ownership:Disconnect()
            leaving:Disconnect()
            disconnectOwner()
            disk:Destroy()
        end
    end)
end

return BlenderReadyIndicator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">BlenderStatusPresentation</string>
            <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local Players = game:GetService("Players")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local TextStyle = require(game:GetService("ReplicatedStorage").Shared.Constants.DialogueTextStyle)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local BlenderStatusPresentation = {}

-- Cosmetic tuning only. Capacity comes from the same config as BlendService.
local TEXT_SIZE = 24
local MAX_DISTANCE = 40
local COUNT_SIZE = Vector2.new(7.68, 2.28)
local PROMPT_SIZE = Vector2.new(12.12, 2.52)
local COUNT_OFFSET = Vector3.new(0, 0, 0)
local PROMPT_OFFSET = Vector3.new(0, 0, 0)
local WHITE = TextStyle.White
local FULL_COLOR = TextStyle.Green

-- Presentation markers accept Attachments without changing gameplay references,
-- whose TycoonService.GetReference API intentionally returns BaseParts.
local function origin(root: Instance, name: string): Instance?
    local direct = root:FindFirstChild(name)
    if direct and (direct:IsA("Attachment") or direct:IsA("BasePart")) then
        return direct
    end
    local found: Instance? = nil
    for _, child in root:GetDescendants() do
        if child.Name == name and (child:IsA("Attachment") or child:IsA("BasePart")) then
            if found then
                warn("[BlenderStatusPresentation] Duplicate " .. name .. " in " .. root:GetFullName())
                return nil
            end
            found = child
        end
    end
    if not found then
        warn("[BlenderStatusPresentation] Missing " .. name .. " in " .. root:GetFullName())
    end
    return found
end

local function billboard(marker: Instance, name: string, size: Vector2, offset: Vector3): (BillboardGui, TextLabel)
    local gui = Instance.new("BillboardGui")
    gui.Name = name
    gui.Adornee = marker
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    BillboardStyle.ApplyBillboard(
        gui,
        { WidthStuds = size.X, HeightStuds = size.Y, MaxDistance = MAX_DISTANCE, ResetOnSpawn = true }
    )
    gui.ClipsDescendants = false -- Keep the completion line and brief count pop clear of the canvas edge.
    gui.StudsOffsetWorldSpace = offset
    gui.AlwaysOnTop = true
    gui.MaxDistance = MAX_DISTANCE
    local text = Instance.new("TextLabel")
    text.Name = "Status"
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.BorderSizePixel = 0
    TextStyle.Apply(text, TEXT_SIZE, gui)
    text.TextScaled = true
    text.Text = ""
    text.Parent = gui
    gui.Parent = marker
    return gui, text
end

function BlenderStatusPresentation.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local blender = if plot.Name == "Blender" then plot else plot:FindFirstChild("Blender")
        local countOrigin = blender and origin(blender, "IngredientCountOrigin")
        local promptOrigin = origin(plot, "TurbinePromptOrigin")
        local guis: { BillboardGui } = {}
        local countText: TextLabel? = nil
        local promptText: TextLabel? = nil
        local promptGui: BillboardGui? = nil
        if countOrigin then
            local gui, text = billboard(countOrigin, "IngredientCountDisplay", COUNT_SIZE, COUNT_OFFSET)
            table.insert(guis, gui)
            countText = text
        end
        if promptOrigin then
            local gui, text = billboard(promptOrigin, "TurbineStatusDisplay", PROMPT_SIZE, PROMPT_OFFSET)
            table.insert(guis, gui)
            promptText = text
            promptGui = gui
        end
        local owner: Player? = nil
        local ownerConnections: { RBXScriptConnection } = {}
        local function refresh()
            local state = if owner then owner:GetAttribute("BlendState") else "EMPTY"
            local accepted = if owner then owner:GetAttribute("BlendIngredientCount") else 0
            local loaded = if state == "EMPTY" or typeof(accepted) ~= "number" then 0 else accepted :: number
            local full = loaded >= Economy.MaxIngredients
            if countText then
                countText.Text = string.format("%d / %d", loaded, Economy.MaxIngredients)
                    .. (if full then "\nLOADING COMPLETE!" else "")
                countText.TextColor3 = if full then FULL_COLOR else WHITE
            end
            if promptText then
                promptText.TextColor3 = if state == "COMPLETE" then FULL_COLOR else WHITE
                promptText.Text = if state == "COMPLETE"
                    then "READY TO DISPENSE!"
                    elseif state == "BLENDING" then "BLENDING..."
                    elseif state == "READY" and full then "SPIN TO BLEND!"
                    elseif not full and owner and owner:GetAttribute("BlendNeedsItems") == true then string.format(
                        "NEEDS %d ITEMS!",
                        Economy.MaxIngredients
                    )
                    else "LOAD INGREDIENTS TO BLEND!"
                local guidance = promptText.Text == "LOAD INGREDIENTS TO BLEND!"
                promptText.TextSize = if guidance then TEXT_SIZE * 0.85 else TEXT_SIZE
                if promptGui then
                    BillboardStyle.ApplyBillboard(promptGui, {
                        WidthStuds = if guidance then 9.6 else PROMPT_SIZE.X,
                        HeightStuds = if guidance then 2.04 else PROMPT_SIZE.Y,
                        MaxDistance = MAX_DISTANCE,
                        ResetOnSpawn = true,
                    })
                    promptGui.MaxDistance = MAX_DISTANCE
                end
            end
        end
        local function disconnectOwner()
            for _, connection in ownerConnections do
                connection:Disconnect()
            end
            table.clear(ownerConnections)
        end
        local function bindOwner()
            disconnectOwner()
            owner = if plot:GetAttribute("OwnerUserId") ~= nil then services.TycoonService.GetOwner(plot) else nil
            if owner then
                for _, attribute in { "BlendIngredientCount", "BlendState", "BlendNeedsItems" } do
                    table.insert(ownerConnections, owner:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
            end
            refresh()
        end
        local ownership = plot:GetAttributeChangedSignal("OwnerUserId"):Connect(bindOwner)
        local leaving = Players.PlayerRemoving:Connect(function(player)
            if player == owner then
                disconnectOwner()
                owner = nil
                refresh()
            end
        end)
        bindOwner()
        return function()
            ownership:Disconnect()
            leaving:Disconnect()
            disconnectOwner()
            for _, gui in guis do
                gui:Destroy()
            end
        end
    end)
end

return BlenderStatusPresentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">BlenderVacuum</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.BlenderVacuum)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Physics = require(script.Parent.Parent.Services.BlenderVacuumPhysics)
local BlenderVacuum = {}

local function log(message: string)
    if RunService:IsStudio() and ServerStorage:GetAttribute("DebugBlenderVacuum") == true then
        print("[BlenderVacuum] " .. message)
    end
end

local function targetPosition(zone: BasePart, input: BasePart): Vector3
    -- Attachments belong to BaseParts. Prefer a direct child of InputZone,
    -- then VacuumZone, so unrelated blender attachments cannot win by scan order.
    for _, parent in { input, zone } do
        local target = parent:FindFirstChild("VacuumTarget")
        if target and target:IsA("Attachment") then
            return target.WorldPosition
        end
    end
    return input.Position + input.CFrame.UpVector * (input.Size.Y * 0.5 + Config.TargetHeight)
end

local function looseRoot(item: Instance): BasePart?
    local ancestor: Instance? = item
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA("Tool") or ancestor:IsA("Accessory") or ancestor:FindFirstChildOfClass("Humanoid") then
            return nil
        end
        ancestor = ancestor.Parent
    end
    local root = WorldUtil.Part(item)
    if not root or root.Anchored then
        return nil
    end
    -- Reject a registered object welded to a character/other external assembly.
    for _, part in root:GetConnectedParts(true) do
        if part.Anchored or (part ~= item and not part:IsDescendantOf(item)) then
            return nil
        end
    end
    return root
end

function BlenderVacuum.Init(services: any)
    local active: { [Instance]: BasePart } = {}
    -- One update for all authored zones; no workspace traversal or per-item connections.
    RunService.Heartbeat:Connect(function(dt: number)
        local candidates: { [Instance]: any } = {}
        for _, zone in CollectionService:GetTagged("BlenderVacuum") do
            if not zone:IsA("BasePart") or not zone:IsDescendantOf(workspace) then
                continue
            end
            local owner = services.TycoonService.GetOwner(zone)
            if not owner or services.TycoonService.GetReference(owner, "BlenderVacuum") ~= zone then
                continue
            end
            local input = services.TycoonService.GetReference(owner, "BlenderInput")
            if not input then
                continue
            end
            local target = targetPosition(zone, input)
            local insideInput: { [Instance]: boolean } = {}
            for _, part in workspace:GetPartsInPart(input) do
                local item = services.IngredientService.Resolve(part)
                if item then
                    insideInput[item] = true
                end
            end
            local seen: { [Instance]: boolean } = {}
            for _, part in workspace:GetPartsInPart(zone) do
                local item = services.IngredientService.Resolve(part)
                if not item or seen[item] or insideInput[item] then
                    continue
                end
                seen[item] = true
                local record = services.IngredientService.GetRecord(item)
                if
                    not record
                    or (record.Owner ~= nil and not services.TycoonService.IsMember(record.Owner, zone))
                    or (record.Owner == nil and not record.Claimable)
                then
                    continue
                end
                local root = looseRoot(item)
                if not root then
                    continue
                end
                -- Release at the opening; never hold ingredients below the target.
                if root.Position.Y < target.Y then
                    continue
                end
                local distance = (root.Position - target).Magnitude
                local previous = candidates[item]
                -- Public claimable items follow existing input ownership rules.
                -- Nearest valid opening wins, with UserId as a stable tie breaker.
                if
                    not previous
                    or distance < previous.Distance
                    or (distance == previous.Distance and owner.UserId < previous.Owner.UserId)
                then
                    candidates[item] = { Zone = zone, Root = root, Target = target, Owner = owner, Distance = distance }
                end
            end
        end
        local nextActive: { [Instance]: BasePart } = {}
        for item, candidate in candidates do
            local root = candidate.Root
            -- No yields between eligibility and velocity write/consumption boundary.
            if services.IngredientService.GetRecord(item) and root:IsDescendantOf(workspace) then
                if active[item] ~= candidate.Zone then
                    log("captured ingredient=" .. item.Name .. " owner=" .. candidate.Owner.Name)
                end
                nextActive[item] = candidate.Zone
                root.AssemblyLinearVelocity = Physics.Steer(
                    root.AssemblyLinearVelocity,
                    root.Position,
                    candidate.Target,
                    math.max(candidate.Zone.Size.X, candidate.Zone.Size.Z) * 0.5,
                    dt
                )
            end
        end
        for item, zone in active do
            if nextActive[item] ~= zone then
                log("released ingredient=" .. item.Name)
            end
        end
        active = nextActive
    end)
end

return BlenderVacuum
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">DayButton</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local DayButton = {}

local function existingPrompt(object: Instance, part: BasePart): ProximityPrompt?
    -- The authored prompt may be a sibling of the button, directly on its Model.
    local root: Instance? = object
    while root and root ~= workspace do
        local origin = root:FindFirstChild("StartDayTextOrigin")
        if origin and origin:IsA("Attachment") then
            local prompt = root:FindFirstChildOfClass("ProximityPrompt")
            if prompt then
                return prompt
            end
            break
        end
        root = root.Parent
    end
    return part:FindFirstChildOfClass("ProximityPrompt")
end

-- Keep authored fixtures, but retire the manual gameplay interaction.
function DayButton.Init(_services: any)
    WorldUtil.BindTag("StartDayButton", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            return nil
        end
        local prompt = existingPrompt(object, part)
        if prompt then
            prompt.Enabled = false
        end
        return nil
    end)
end
return DayButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">DispenseButton</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local AudioService = require(script.Parent.Parent.Services.AudioService)
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local DispenseButton = {}
function DispenseButton.Init(services: any)
    WorldUtil.BindTag("DispenseButton", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[DispenseButton] Requires a BasePart")
            return nil
        end
        local prompt = WorldUtil.Prompt(part, "DispensePrompt", "Dispense smoothie")
        prompt:SetAttribute("InteractionOrigin", "DispenserTextOrigin")
        prompt:SetAttribute("InteractionActionText", "DISPENSE")
        prompt.Style = Enum.ProximityPromptStyle.Custom
        local audio = AudioService.CreateBlendGroup(part)
        services.GameplayService.RegisterPlotInteraction(prompt, function(player, context)
            Debug.Log(prompt, "TRIGGERED", "server dispenser")
            if not services.TycoonService.IsMember(player, part) then
                Debug.Log(prompt, "REJECTED", "server: not a member of this blender")
                return
            end
            Debug.Log(prompt, "ACTION DISPATCHED", "server BlendService.Dispense")
            local success = services.BlendService.Dispense(player, part, context)
            if success then
                audio.pourSound:Play()
            else
                audio.notReadySound:Play()
            end
        end)
        return function()
            prompt:Destroy()
            for _, sound in audio do
                sound:Destroy()
            end
        end
    end)
end
return DispenseButton
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">Dispenser</string>
            <string name="Source"><![CDATA[--!strict
-- Inventory-to-physical-unit API only. IngredientPickup owns loose-item interaction.
local Dispenser = {}
local deps: any
function Dispenser.Init(services: any)
    deps = services
end
function Dispenser.DispenseIngredient(player: Player, id: string): Instance?
    return deps.InventoryService.ReleaseUnit(player, id)
end
return Dispenser
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">IceGunDisplay</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.IceGunConfig)
local Component = {}
local bindings: { [Instance]: { RBXScriptConnection } } = {}

function Component.Init(services: any)
    local unbind: (Instance) -> ()
    local function bind(pedestal: Instance)
        if bindings[pedestal] or not pedestal:IsA("BasePart") or not pedestal:IsDescendantOf(workspace) then
            return
        end
        local list: { RBXScriptConnection } = {}
        bindings[pedestal] = list
        table.insert(
            list,
            pedestal.AncestryChanged:Connect(function()
                if not pedestal:IsDescendantOf(workspace) then
                    unbind(pedestal)
                end
            end)
        )
        -- Defense for existing imports. Disable/remove these in Edit mode before any Play.
        for _, child in pedestal:GetDescendants() do
            if child:IsA("BaseScript") then
                child.Enabled = false
                child:Destroy()
            elseif child:IsA("ManualWeld") and not child.Part0 and pedestal.Anchored then
                child:Destroy()
            end
        end
        local previous = pedestal:FindFirstChild("IceGunDisplay")
        if previous then
            previous:Destroy()
        end
        local weapons = ServerStorage:FindFirstChild("Weapons")
        local template = weapons and weapons:FindFirstChild("IcicleGun")
        local handle = template and template:FindFirstChild("Handle")
        if not handle or not handle:IsA("BasePart") then
            warn("[IceGun] Missing authored Handle; cannot bind display")
            for _, connection in list do
                connection:Disconnect()
            end
            bindings[pedestal] = nil
            return
        end
        local display = handle:Clone()
        display.Name = "IceGunDisplay"
        for _, child in display:GetDescendants() do
            if
                child:IsA("BaseScript")
                or child:IsA("RemoteEvent")
                or child:IsA("RemoteFunction")
                or child:IsA("Sound")
            then
                child:Destroy()
            elseif child:IsA("ParticleEmitter") then
                child.Enabled = false
            end
        end
        services.IceGunEffects.Inert(display, true)
        display.CFrame = (pedestal.CFrame + Vector3.new(0, handle.Size.Z / 2 + 1, 0))
            * CFrame.Angles(-math.pi / 2, 0, 0)
        display.Parent = pedestal
        display:SetAttribute("IceGunDisplayBase", display.CFrame)
        CollectionService:AddTag(display, "IceGunCosmeticDisplay")
        local existingAttachment = pedestal:FindFirstChild("PurchaseAttachment")
        local marker: Attachment
        if existingAttachment then
            if not existingAttachment:IsA("Attachment") then
                warn("[IceGun] PurchaseAttachment must be an Attachment")
                return
            end
            marker = existingAttachment
        else
            marker = Instance.new("Attachment")
            marker.Name = "PurchaseAttachment"
            marker.Position = Vector3.new(0, 2.5, 0)
            marker.Parent = pedestal
        end
        local prompt = marker:FindFirstChildOfClass("ProximityPrompt") or Instance.new("ProximityPrompt")
        prompt.Name = "IceGunPurchase"
        prompt.Style = Enum.ProximityPromptStyle.Custom
        prompt.ActionText = "LOADING"
        prompt.ObjectText = "ICE GUN"
        prompt.KeyboardKeyCode = Enum.KeyCode.E
        prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = Config.PurchaseDistance
        prompt.RequiresLineOfSight = true
        prompt.ClickablePrompt = true
        prompt:SetAttribute("IceGunPurchase", true)
        prompt.Parent = marker
        local function eligible(player: Player): boolean
            local character = player.Character
            local h = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if
                not root
                or not root:IsA("BasePart")
                or not h
                or h.Health <= 0
                or not services.MovementService.CanPerformGameplayAction(player)
                or not pedestal:IsDescendantOf(workspace)
                or not prompt.Enabled
                or (root.Position - marker.WorldPosition).Magnitude > Config.PurchaseDistance
            then
                return false
            end
            local ray = RaycastParams.new()
            ray.FilterType = Enum.RaycastFilterType.Exclude
            ray.FilterDescendantsInstances = { character :: Model, pedestal }
            return workspace:Raycast(root.Position, marker.WorldPosition - root.Position, ray) == nil
        end
        table.insert(
            list,
            prompt.Triggered:Connect(function(player)
                if eligible(player) then
                    services.IceGunService.RequestPurchase(player, function()
                        return eligible(player)
                    end)
                end
            end)
        )
    end
    unbind = function(pedestal: Instance)
        for _, connection in (bindings[pedestal] or {}) :: { RBXScriptConnection } do
            connection:Disconnect()
        end
        bindings[pedestal] = nil
        local display = pedestal:FindFirstChild("IceGunDisplay")
        if display then
            display:Destroy()
        end
        local attachment = pedestal:FindFirstChild("PurchaseAttachment")
        if attachment then
            local prompt = attachment:FindFirstChild("IceGunPurchase")
            if prompt then
                prompt:Destroy()
            end
        end
    end
    local function authorizedTool(object: Instance): boolean
        local parent = object.Parent
        if not parent or not parent:IsA("Model") then
            return false
        end
        local player = game:GetService("Players"):GetPlayerFromCharacter(parent)
        return player ~= nil and services.IceGunService.GetEquipped(player) == object
    end
    local found = false
    for _, object in workspace:GetDescendants() do
        if object:IsA("BasePart") and object.Name == "EquipmentSpawner" then
            found = true
            CollectionService:AddTag(object, "IceGunPurchaseDisplay")
        elseif object:IsA("Tool") and object.Name == "IcicleGun" and not authorizedTool(object) then
            -- Never retain legacy free pickups from the imported display.
            object:Destroy()
        end
    end
    if not found and #CollectionService:GetTagged("IceGunPurchaseDisplay") == 0 then
        local template = ServerStorage:FindFirstChild("IceGunPedestalTemplate")
        if template and template:IsA("BasePart") then
            local pedestal = template:Clone()
            pedestal.Name = "EquipmentSpawner"
            pedestal.Parent = workspace
            CollectionService:AddTag(pedestal, "IceGunPurchaseDisplay")
        end
    end
    for _, pedestal in CollectionService:GetTagged("IceGunPurchaseDisplay") do
        bind(pedestal)
    end
    CollectionService:GetInstanceAddedSignal("IceGunPurchaseDisplay"):Connect(bind)
    CollectionService:GetInstanceRemovedSignal("IceGunPurchaseDisplay"):Connect(unbind)
    workspace.DescendantAdded:Connect(function(object: Instance)
        if object:IsA("Tool") and object.Name == "IcicleGun" and not authorizedTool(object) then
            object:Destroy()
        elseif object:IsA("BasePart") and object.Name == "EquipmentSpawner" then
            CollectionService:AddTag(object, "IceGunPurchaseDisplay")
        end
    end)
end

return Component
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">IngredientPickup</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local IngredientPickup = {}
function IngredientPickup.Init(services: any)
    WorldUtil.BindTag("IngredientWorldItem", function(object)
        local record = services.IngredientService.GetRecord(object)
        local part = WorldUtil.Part(object)
        -- Eligibility only; InventoryService authorizes the triggering player's loose pickup.
        -- Nonclaimable market stock keeps its existing pedestal transaction.
        if not record or not record.Claimable or not part then
            return nil
        end
        local prompt = WorldUtil.Prompt(part, "CarryPrompt", "Pickup")
        prompt.Style = Enum.ProximityPromptStyle.Custom
        prompt:SetAttribute("IngredientPickupPrompt", true)
        prompt.ObjectText = record.Id
        local connection = prompt.Triggered:Connect(function(player)
            Debug.Log(prompt, "TRIGGERED", "server ingredient")
            Debug.Log(prompt, "ACTION DISPATCHED", "server CarryWorldItem")
            services.InventoryService.CarryWorldItem(player, object)
        end)
        return function()
            connection:Disconnect()
            prompt:Destroy()
        end
    end)
end
return IngredientPickup
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">IngredientSpawn</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local IngredientSpawn = {}
local bound: { [Instance]: boolean } = {}

-- Also used by the Edit-mode authoring utility. Keep authored local orientation.
function IngredientSpawn.GetSpawnCFrame(marker: BasePart): CFrame
    return marker.CFrame * CFrame.new(0, marker.Size.Y / 2 + 3, 0)
end

-- Both marker types share the same one-item lifecycle. The callback is output only.
function IngredientSpawn.Bind(services: any, tag: string, onSpawn: ((Instance, string) -> ())?)
    WorldUtil.BindTag(tag, function(station)
        if bound[station] then
            warn("[IngredientSpawn] Use only one spawn tag: " .. station:GetFullName())
            return nil
        end
        if not station:IsA("BasePart") then
            warn("[IngredientSpawn] Tag a BasePart: " .. station:GetFullName())
            return nil
        end
        local id = station:GetAttribute("IngredientId")
        if typeof(id) ~= "string" or not services.IngredientService.GetDefinition(id) then
            warn("[IngredientSpawn] Set a valid IngredientId: " .. station:GetFullName())
            return nil
        end
        local minSeconds: number
        local maxSeconds: number
        if tag == "IngredientSpawn" then
            local definition = services.IngredientService.GetDefinition(id)
            local seconds = Economy.SpecialRefillSeconds[id] or Economy.RefillSeconds[definition.JumpLocation]
            minSeconds, maxSeconds = seconds, seconds
        else
            -- Announced spawns retain their separate authored lifecycle.
            local configuredSeconds = station:GetAttribute("RespawnSeconds")
            local seconds = 5
            if
                typeof(configuredSeconds) == "number"
                and configuredSeconds == configuredSeconds
                and configuredSeconds > 0
                and configuredSeconds < math.huge
            then
                seconds = configuredSeconds
            end
            minSeconds, maxSeconds = seconds, seconds
            if onSpawn then
                local low = station:GetAttribute("MinRespawnSeconds")
                local high = station:GetAttribute("MaxRespawnSeconds")
                if
                    typeof(low) == "number"
                    and typeof(high) == "number"
                    and low > 0
                    and high >= low
                    and high < math.huge
                then
                    minSeconds, maxSeconds = low, high
                end
            end
        end

        bound[station] = true
        local stopped = false
        local active: Instance? = nil
        local pending: thread? = nil
        local itemConnections: { RBXScriptConnection } = {}
        local function disconnectItem()
            for _, connection in itemConnections do
                connection:Disconnect()
            end
            table.clear(itemConnections)
        end
        local function spawnItem()
            pending = nil
            if stopped or active or not station:IsDescendantOf(workspace) then
                return
            end
            local item = services.IngredientService.Spawn(id, IngredientSpawn.GetSpawnCFrame(station), nil, true, {
                Origin = if tag == "IngredientSpawn"
                    then "Market"
                    elseif tag == "AnnouncedIngredientSpawn" then "Event"
                    else "Unknown",
                FreezeUntilPickup = station:GetAttribute("FreezeSpawnedItem") == true,
            })
            if not item then
                return
            end
            if services.AnnouncementService then
                services.AnnouncementService.TrackSpawn(item, id)
            end
            active = item
            local function removed(destroying: boolean)
                if stopped or active ~= item then
                    return
                end
                active = nil
                disconnectItem()
                -- Retire a reparented item so returning it cannot duplicate station stock.
                if not destroying then
                    item:Destroy()
                end
                pending = task.delay(minSeconds + math.random() * (maxSeconds - minSeconds), spawnItem)
            end
            table.insert(
                itemConnections,
                item.Destroying:Connect(function()
                    removed(true)
                end)
            )
            if onSpawn then
                onSpawn(station, id)
            end
            table.insert(
                itemConnections,
                item.AncestryChanged:Connect(function()
                    if not item:IsDescendantOf(workspace) then
                        removed(false)
                    end
                end)
            )
        end
        local stationConnection: RBXScriptConnection? = nil
        local function cleanup()
            if stopped then
                return
            end
            stopped = true
            bound[station] = nil
            if pending then
                task.cancel(pending)
                pending = nil
            end
            if stationConnection then
                stationConnection:Disconnect()
            end
            disconnectItem()
            local item = active
            active = nil
            if item then
                item:Destroy()
            end
        end
        stationConnection = station.Destroying:Connect(cleanup)
        spawnItem()
        return cleanup
    end)
end

function IngredientSpawn.Init(services: any)
    IngredientSpawn.Bind(services, "IngredientSpawn", nil)
end

return IngredientSpawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">MarketPedestal</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local MarketPedestal = {}
function MarketPedestal.Init(services: any)
    WorldUtil.BindTag("MarketPedestal", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[MarketPedestal] Requires a BasePart")
            return nil
        end
        services.MarketService.Register(part)
        return function()
            services.MarketService.Unregister(part)
        end
    end)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed >= 1 then
            elapsed = 0
            services.MarketService.Step()
        end
    end)
end
return MarketPedestal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">Muncher</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Reveal = require(script.Parent.MuncherReveal)
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Muncher)
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Vacuum = require(script.Parent.Parent.Services.MuncherVacuum)
local Component = {}

function Component.Init(services: any)
    WorldUtil.BindTag("PlayerPlot", function(plot)
        local warned: { [string]: boolean } = {}
        local input: BasePart? = nil
        local vacuumUpdate: ((number) -> ())? = nil
        local vacuumCleanup: (() -> ())? = nil
        local elapsed = 0
        local assembly: Instance? = nil
        local reveal: ((any) -> boolean)? = nil
        local restore: (() -> ())? = nil
        local pad: BasePart? = nil
        local padConnection: RBXScriptConnection? = nil
        local padAppearance: { [Instance]: any } = {}
        local function padVisibility(purchased: boolean)
            for object, saved in padAppearance do
                if object:IsA("BasePart") then
                    object.Transparency = if purchased then 1 else saved.Transparency
                    object.CanCollide = not purchased and saved.CanCollide
                    object.CanTouch = not purchased
                elseif object:IsA("Decal") then
                    object.Transparency = if purchased then 1 else saved.Transparency
                elseif object:IsA("Texture") then
                    object.Transparency = if purchased then 1 else saved.Transparency
                elseif object:IsA("LayerCollector") then
                    object.Enabled = not purchased and saved.Enabled
                elseif object:IsA("ProximityPrompt") then
                    object.Enabled = false -- Purchase uses the authored touch pad, like farm rows.
                end
            end
        end
        local function warning(name: string)
            if not warned[name] then
                warned[name] = true
                warn("[Muncher] " .. plot:GetFullName() .. " missing " .. name)
            end
        end
        local function refresh()
            local muncher = plot:FindFirstChild("Muncher")
            if not muncher then
                warning("Muncher")
            end
            local candidate = muncher and muncher:FindFirstChild("InputZone")
            local zone = if candidate and candidate:IsA("BasePart") then candidate else nil
            if not zone then
                warning("InputZone BasePart")
            end
            if zone ~= input then
                if vacuumCleanup then
                    vacuumCleanup()
                end
                vacuumUpdate, vacuumCleanup = nil, nil
                input = zone
                if zone then
                    zone.Anchored = true
                    zone.CanCollide = false
                    zone.CanTouch = false
                    zone.CanQuery = true
                    zone.Transparency = 1
                    for _, child in zone:GetDescendants() do
                        if child:IsA("ProximityPrompt") then
                            child:Destroy()
                        end
                    end
                    if muncher then
                        vacuumUpdate, vacuumCleanup = Vacuum.Bind(services, zone, muncher)
                    end
                end
            end
            local owner = services.TycoonService.GetOwner(plot)
            local snapshot = if owner then services.MuncherService.GetSnapshot(owner) else nil
            if muncher ~= assembly then
                if restore then
                    restore()
                end
                assembly, reveal, restore = muncher, nil, nil
                if muncher then
                    reveal, restore = Reveal.Bind(muncher)
                end
            end
            local candidatePad = muncher and muncher:FindFirstChild("PurchasePoint1")
            local nextPad = if candidatePad and candidatePad:IsA("BasePart") then candidatePad else nil
            if nextPad ~= pad then
                if padConnection then
                    padConnection:Disconnect()
                end
                pad, padConnection, padAppearance = nextPad, nil, {}
                if nextPad then
                    local objects = nextPad:GetDescendants()
                    table.insert(objects, nextPad)
                    for _, object in objects do
                        if object:IsA("BasePart") then
                            padAppearance[object] =
                                { Transparency = object.Transparency, CanCollide = object.CanCollide }
                        elseif object:IsA("Decal") or object:IsA("Texture") then
                            padAppearance[object] = { Transparency = object.Transparency }
                        elseif object:IsA("LayerCollector") then
                            padAppearance[object] = { Enabled = object.Enabled }
                        elseif object:IsA("ProximityPrompt") then
                            padAppearance[object] = {}
                        end
                    end
                    nextPad.Anchored = true
                    nextPad:SetAttribute("PurchaseCost", Config.PurchaseCost)
                    padConnection = nextPad.Touched:Connect(function(hit)
                        local ancestor: Instance? = hit.Parent
                        while ancestor and ancestor ~= workspace do
                            local actor = if ancestor:IsA("Model")
                                then Players:GetPlayerFromCharacter(ancestor)
                                else nil
                            if actor then
                                services.MuncherService.TryPurchase(
                                    actor,
                                    nextPad,
                                    services.TycoonService.GetRequestContext(actor)
                                )
                                local currentOwner = services.TycoonService.GetOwner(plot)
                                local current = if currentOwner
                                    then services.MuncherService.GetSnapshot(currentOwner)
                                    else nil
                                padVisibility(current ~= nil and current.Purchased == true)
                                return
                            end
                            ancestor = ancestor.Parent
                        end
                    end)
                else
                    warning("PurchasePoint1 BasePart")
                end
            end
            padVisibility(snapshot ~= nil and snapshot.Purchased == true)
            if reveal and reveal(snapshot) and owner and muncher then
                services.MuncherService.CompleteReveal(owner, muncher)
                snapshot = services.MuncherService.GetSnapshot(owner)
            end
            if
                snapshot
                and snapshot.Purchased
                and not snapshot.Active
                and workspace:GetServerTimeNow() > snapshot.ReadyAt + 3
                and not warned.RevealStalled
            then
                warned.RevealStalled = true
                warn(
                    "[Muncher] Reveal stalled at " .. plot:GetFullName() .. "; inspect authored assembly and InputZone"
                )
            end
            if muncher then
                local current = if owner then services.MuncherService.GetSnapshot(owner) else nil
                -- Publish the committed result before phase/sequence can start a client roll.
                for _, name in { "OutputRarity", "InputTier", "OutputId", "ResultKind" } do
                    muncher:SetAttribute(name, if current then current[name] else nil)
                end
                local attributes: { [string]: any } = {
                    Purchased = current ~= nil and current.Purchased == true,
                    Active = current ~= nil and current.Active == true,
                    Phase = if current then current.Phase else "Idle",
                    StartedAt = if current then current.StartedAt else 0,
                    AvailableAt = if current then current.AvailableAt else 0,
                }
                for name, value in attributes do
                    if muncher:GetAttribute(name) ~= value then
                        muncher:SetAttribute(name, value)
                    end
                end
                muncher:SetAttribute("Sequence", if current then current.Sequence else 0)
                -- Retire old buff projections on existing Studio models.
                muncher:SetAttribute("ActiveBuff", nil)
                muncher:SetAttribute("BuffExpiresAt", nil)
            end
        end
        refresh()
        local connection = RunService.Heartbeat:Connect(function(dt)
            -- Move the controlled assembly every frame; intake polling remains at 10 Hz.
            if reveal then
                local owner = services.TycoonService.GetOwner(plot)
                reveal(if owner then services.MuncherService.GetSnapshot(owner) else nil)
            end
            if vacuumUpdate then
                vacuumUpdate(dt)
            end
            elapsed += dt
            if elapsed >= Config.ScanInterval then
                elapsed = 0
                refresh()
            end
        end)
        return function()
            connection:Disconnect()
            if vacuumCleanup then
                vacuumCleanup()
            end
            if padConnection then
                padConnection:Disconnect()
            end
            padVisibility(false)
            if restore then
                restore()
            end
        end
    end)
end

return Component
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">MuncherPresentation</string>
            <string name="Source"><![CDATA[--!strict
local Presentation = {}

function Presentation.Marker(object: Instance?): (BasePart | Attachment)?
    if object and object:IsA("BasePart") then
        return object
    elseif object and object:IsA("Attachment") then
        return object
    end
    return nil
end

return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">MuncherReveal</string>
            <string name="Source"><![CDATA[--!strict
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.Muncher)
local Reveal = {}

-- Translate authored parts in world space without reparenting artwork/markers.
-- A single Quad-Out fraction moves all parts together, including nested Models.
function Reveal.Bind(model: Instance): ((any) -> boolean, () -> ())
    local parts: { [BasePart]: { Rest: CFrame, Collide: boolean, Anchored: boolean } } = {}
    local attachments: { [Attachment]: CFrame } = {}
    local function move(offset: number, resting: boolean)
        local pad = model:FindFirstChild("PurchasePoint1")
        for _, object in model:GetDescendants() do
            if object:IsA("BasePart") and object ~= pad and not (pad and object:IsDescendantOf(pad)) then
                local saved = parts[object]
                if not saved then
                    saved = { Rest = object.CFrame, Collide = object.CanCollide, Anchored = object.Anchored }
                    parts[object] = saved
                end
                object.Anchored = true
                object.CanCollide = resting and saved.Collide
                object.CFrame = CFrame.new(0, offset, 0) * saved.Rest
            elseif object:IsA("Attachment") and not (pad and object:IsDescendantOf(pad)) then
                -- Part-backed/nested attachments already follow their moving parent.
                local ancestor = object.Parent
                local follows = false
                while ancestor and ancestor ~= model do
                    if ancestor:IsA("BasePart") or ancestor:IsA("Attachment") then
                        follows = true
                        break
                    end
                    ancestor = ancestor.Parent
                end
                if not follows then
                    local rest = attachments[object] or object.WorldCFrame
                    attachments[object] = rest
                    object.WorldCFrame = CFrame.new(0, offset, 0) * rest
                end
            end
        end
    end
    move(-Config.RevealDepth, false)
    return function(snapshot)
        local fraction = if snapshot and snapshot.Purchased
            then math.clamp(1 - (snapshot.ReadyAt - workspace:GetServerTimeNow()) / Config.RevealSeconds, 0, 1)
            else 0
        local offset = -Config.RevealDepth * (1 - fraction) ^ 2
        move(offset, fraction == 1)
        return fraction == 1
    end, function()
        for attachment, rest in attachments do
            if attachment.Parent then
                attachment.WorldCFrame = rest
            end
        end
        for part, saved in parts do
            if part.Parent then
                part.CFrame, part.CanCollide, part.Anchored = saved.Rest, saved.Collide, saved.Anchored
            end
        end
    end
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">SmoothiePickup</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local SmoothiePickup = {}
function SmoothiePickup.Init(services: any)
    WorldUtil.BindTag("SmoothieWorldItem", function(object)
        local record = services.SmoothieWorldItemService.GetData(object)
        local part = WorldUtil.Part(object)
        if not record or not part then
            return nil
        end
        local prompt = WorldUtil.Prompt(part, "SmoothieCarryPrompt", "Pickup")
        prompt.Style = Enum.ProximityPromptStyle.Custom
        prompt:SetAttribute("SmoothiePickupPrompt", true)
        prompt.ObjectText = "Smoothie"
        local connection = prompt.Triggered:Connect(function(player)
            services.InventoryService.CarryWorldSmoothie(player, object)
        end)
        return function()
            connection:Disconnect()
            prompt:Destroy()
        end
    end)
end
return SmoothiePickup
