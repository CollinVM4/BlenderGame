          <BinaryString name="AttributesSerialize">AwAAAAgAAABGV19Pd25lZAMBBgAAAEZXX1NyYwYAAMCJCqrkQQMAAABGV3YGAAAAAAAAFEA=</BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
