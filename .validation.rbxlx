          <Item class="ModuleScript" referent="826">
            <Properties>
              <string name="Name">InteractionPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Presentation = require(script.Parent.Parent.UI.InteractionPromptPresentation)
local Debug = require(game:GetService("ReplicatedStorage").Shared.MobilePromptDebug)
local Controller = {}
local started = false

-- Never recursively search a plot/workspace and accidentally bind another interactable.
local function findOrigin(prompt: ProximityPrompt): (Attachment?, string?)
    local name = prompt:GetAttribute("InteractionOrigin")
    if typeof(name) ~= "string" or name == "" then
        return nil, "InteractionOrigin must be a nonempty string"
    end
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        local marker = ancestor:FindFirstChild(name)
        if marker and marker:IsA("Attachment") then
            return marker
        end
        if marker then
            return nil, marker:GetFullName() .. " is " .. marker.ClassName .. "; expected Attachment"
        end
        if ancestor:IsA("Model") then
            local found: Attachment? = nil
            for _, descendant in ancestor:GetDescendants() do
                if descendant.Name == name and descendant:IsA("Attachment") then
                    if found then
                        return nil, "Ambiguous InteractionOrigin beneath " .. ancestor:GetFullName()
                    end
                    found = descendant
                end
            end
            if found then
                return found
            end
            return nil, "Attachment " .. name .. " not found beneath containing Model " .. ancestor:GetFullName()
        end
        ancestor = ancestor.Parent
    end
    return nil, "Attachment " .. name .. " not found beneath prompt's containing interactable"
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    -- ServerStorage's debug flag does not replicate. Use the same Studio-only
    -- convention on local PlayerGui, without introducing a server bridge.
    local function debugging(): boolean
        return RunService:IsStudio() and playerGui:GetAttribute("DebugFilmLoop") == true
    end
    local function log(prompt: ProximityPrompt, message: string)
        if debugging() then
            print("[InteractionPrompt] " .. prompt:GetFullName() .. " | " .. message)
        end
    end
    local shownCounts = setmetatable({} :: { [ProximityPrompt]: number }, { __mode = "k" })
    local function snapshot(prompt: ProximityPrompt)
        if not debugging() then
            return
        end
        local parent = prompt.Parent
        local placement = "Invalid: parent must be BasePart, Attachment, or Model with PrimaryPart"
        if parent then
            if parent:IsA("Model") then
                placement = if parent.PrimaryPart
                    then "Model PrimaryPart=" .. parent.PrimaryPart:GetFullName()
                    else "Invalid: Model.PrimaryPart is nil; engine cannot show this prompt"
            elseif parent:IsA("BasePart") then
                placement = "BasePart=" .. parent:GetFullName()
            elseif parent:IsA("Attachment") then
                placement = "Attachment=" .. parent:GetFullName() .. "; parent=" .. tostring(parent.Parent)
            end
        end
        local origin, reason = findOrigin(prompt)
        log(
            prompt,
            string.format(
                "snapshot | PromptShownCount=%d | InteractionOrigin=%s | InteractionActionText=%s | ResolvedOrigin=%s | OriginReason=%s | MaxActivationDistance=%s | RequiresLineOfSight=%s | HoldDuration=%s | Style=%s | Enabled=%s | ParentClass=%s | Placement=%s | InWorkspace=%s | Exclusivity=%s | ServiceEnabled=%s | MaxPromptsVisible=%s",
                shownCounts[prompt] or 0,
                tostring(prompt:GetAttribute("InteractionOrigin")),
                tostring(prompt:GetAttribute("InteractionActionText")),
                if origin then origin:GetFullName() else "nil",
                reason or "resolved",
                tostring(prompt.MaxActivationDistance),
                tostring(prompt.RequiresLineOfSight),
                tostring(prompt.HoldDuration),
                tostring(prompt.Style),
                tostring(prompt.Enabled),
                if parent then parent.ClassName else "nil",
                placement,
                tostring(prompt:IsDescendantOf(workspace)),
                tostring(prompt.Exclusivity),
                tostring(ProximityPromptService.Enabled),
                tostring(ProximityPromptService.MaxPromptsVisible)
            )
        )
    end
    local function dump()
        if not debugging() then
            return
        end
        for _, object in workspace:GetDescendants() do
            if object:IsA("ProximityPrompt") and object:GetAttribute("InteractionOrigin") ~= nil then
                snapshot(object)
            end
        end
    end
    playerGui:GetAttributeChangedSignal("DebugFilmLoop"):Connect(dump)
    type Visible = {
        InputType: Enum.ProximityPromptInputType,
        Origin: Attachment?,
        Cleanup: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Visible } = {}
    local function clearView(entry: Visible)
        local cleanup = entry.Cleanup
        entry.Cleanup = nil
        entry.Origin = nil
        if cleanup then
            cleanup()
        end
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if not entry then
            return
        end
        visible[prompt] = nil
        for _, connection in entry.Connections do
            connection:Disconnect()
        end
        clearView(entry)
    end
    local function refresh(prompt: ProximityPrompt, entry: Visible)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled then
            log(prompt, "Rejected: " .. (if not prompt.Enabled then "Enabled=false" else "prompt is outside Workspace"))
            hide(prompt)
            return
        end
        local origin, reason = findOrigin(prompt)
        if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
            origin = nil
            reason = "Style is not Custom"
        end
        local customerAction = prompt:GetAttribute("InteractionCustomerAction")
        if
            customerAction
            and (
                prompt:GetAttribute("PlotSessionId") == nil
                or prompt:GetAttribute("PlotSessionId") ~= Players.LocalPlayer:GetAttribute("PlotSessionId")
            )
        then
            origin = nil
            reason = "Customer prompt belongs to another player"
        end
        if not origin then
            log(prompt, "Rejected: " .. (reason or "origin unavailable"))
        end
        if origin == entry.Origin then
            return
        end
        clearView(entry)
        if origin then
            local action = prompt:GetAttribute("InteractionActionText")
            local key = prompt:GetAttribute("InteractionKeyText")
            local distance = prompt:GetAttribute("InteractionMaxDistance")
            entry.Origin = origin
            log(
                prompt,
                "Presentation.Create | origin="
                    .. origin:GetFullName()
                    .. " | InteractionActionText="
                    .. tostring(action)
            )
            local dispenser = origin.Name == "DispenserTextOrigin" and not customerAction
            local touch = dispenser and entry.InputType == Enum.ProximityPromptInputType.Touch
            local cleanup, gui = Presentation.Create(prompt, origin, playerGui, entry.InputType, {
                HeightStuds = if touch then 2.52 else nil,
                CanvasWidth = 300,
                CanvasHeight = if touch then 80 else 56,
                TouchWidth = if touch then 260 else nil,
                TouchHeight = if touch then 96 else nil,
                TouchCenterY = if touch then 0.5 else nil,
                CustomerAction = if typeof(customerAction) == "string" then customerAction else nil,
                ActionText = if typeof(action) == "string" then action else nil,
                KeyText = if typeof(key) == "string" then key else nil,
                MaxDistance = if typeof(distance) == "number" and distance > 0 then distance else nil,
            })
            if touch then
                local text = gui:FindFirstChild("Action") :: TextLabel
                text.Size = UDim2.fromScale(1, 56 / 80)
                text.Position = UDim2.fromScale(0, 12 / 80)
            end
            entry.Cleanup = cleanup
            log(prompt, "BillboardGui created=" .. gui:GetFullName() .. " | Adornee=" .. origin:GetFullName())
        end
    end
    Players.LocalPlayer:GetAttributeChangedSignal("PlotSessionId"):Connect(function()
        for prompt, entry in visible do
            refresh(prompt, entry)
        end
    end)
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        if prompt:GetAttribute("IceGunPurchase") == true then
            if
                RunService:IsStudio()
                and playerGui:GetAttribute("DebugIceGunPrompt") == true
                and playerGui:GetAttribute("IceGunPromptRendererRegistered") ~= true
            then
                warn(
                    "[IceGunPrompt] Engine PromptShown received, but IceGunDisplayController renderer is not registered"
                )
            end
            return
        end
        if prompt:GetAttribute("PlayerStashPrompt") == true then
            return
        end
        if
            inputType == Enum.ProximityPromptInputType.Touch
            and prompt:GetAttribute("InteractionOrigin") == "DispenserTextOrigin"
        then
            Debug.Log(prompt, "SHOWN", "client dispenser")
        end
        shownCounts[prompt] = (shownCounts[prompt] or 0) + 1
        log(prompt, "PromptShown received by controller | InputType=" .. tostring(inputType))
        snapshot(prompt)
        hide(prompt)
        local entry: Visible = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AttributeChanged:Connect(function(attribute)
                if string.sub(attribute, 1, 11) == "Interaction" or attribute == "PlotSessionId" then
                    clearView(entry)
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(function(prompt)
        log(prompt, "PromptHidden received by controller")
        hide(prompt)
    end)
    dump()
    -- Replication/streaming may deliver a marker after its already-visible prompt.
    workspace.DescendantAdded:Connect(function(object)
        if object:IsA("ProximityPrompt") then
            snapshot(object)
        end
        if object:IsA("Attachment") then
            for prompt, entry in visible do
                refresh(prompt, entry)
            end
        end
    end)
    workspace.DescendantRemoving:Connect(function(object: Instance)
        for prompt, entry in visible do
            if object == prompt then
                hide(prompt)
            elseif object == entry.Origin then
                clearView(entry)
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="827">
            <Properties>
              <string name="Name">JackedNoobResponseController</string>
              <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local TextStyle = require(ReplicatedStorage.Shared.Constants.DialogueTextStyle)
local Config = require(ReplicatedStorage.Shared.Constants.JackedNoob)
local Controller = {}

function Controller.Init()
    local remote = ReplicatedStorage:WaitForChild("JackedNoobResponse") :: RemoteEvent
    local current: BillboardGui? = nil
    local version = 0
    remote.OnClientEvent:Connect(function(head: Instance, line: string)
        if not head:IsA("BasePart") or not head:IsDescendantOf(workspace) or type(line) ~= "string" then
            return
        end
        version += 1
        local thisVersion = version
        if current then
            current:Destroy()
        end
        local gui = Instance.new("BillboardGui")
        gui.Name = "JackedNoobResponse"
        gui.Adornee = head
        -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
        BillboardStyle.ApplyBillboard(gui, { WidthStuds = 6, HeightStuds = 1.8, MaxDistance = 30, ResetOnSpawn = true })
        gui.StudsOffsetWorldSpace = Vector3.new(0, head.Size.Y / 2 + 1.7, 0)
        gui.AlwaysOnTop = true
        local label = Instance.new("TextLabel")
        label.Name = "Text"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = line
        TextStyle.Apply(label, 23, gui)
        label.TextScaled = true
        label.TextWrapped = true
        label.TextTransparency = 1
        local outline = label:FindFirstChild("DialogueOutline") :: UIStroke
        outline.Transparency = 1
        label.Parent = gui
        gui.Parent = head
        current = gui
        TweenService:Create(label, TweenInfo.new(0.15), { TextTransparency = 0 }):Play()
        TweenService:Create(outline, TweenInfo.new(0.15), { Transparency = 0 }):Play()
        task.delay(Config.DialogueSeconds - 0.3, function()
            if thisVersion ~= version or current ~= gui then
                return
            end
            TweenService:Create(label, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
            TweenService:Create(outline, TweenInfo.new(0.3), { Transparency = 1 }):Play()
            task.delay(0.3, function()
                if current == gui then
                    current = nil
                end
                gui:Destroy()
            end)
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="828">
            <Properties>
              <string name="Name">LockBaseVisibilityController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Controller = {}
local started = false
local SHOW_DISTANCE = 6
local HIDE_DISTANCE = 7
local CHECK_INTERVAL = 0.2

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local displays: { [BillboardGui]: boolean } = {}
    local lastCharacter: Model? = nil
    local function hideAll()
        for gui in displays do
            displays[gui] = false
            gui.Enabled = false
        end
    end
    local function register(object: Instance)
        if object:IsA("BillboardGui") and object.Name == "LockBaseDisplay" then
            displays[object] = false
            object.Enabled = false
        end
    end
    workspace.DescendantAdded:Connect(register)
    workspace.DescendantRemoving:Connect(function(object)
        if object:IsA("BillboardGui") and displays[object] ~= nil then
            displays[object] = nil
            object.Enabled = false
        end
    end)
    player.CharacterRemoving:Connect(hideAll)
    for _, object in workspace:GetDescendants() do
        register(object)
    end
    task.spawn(function()
        while true do
            local character = player.Character
            if character ~= lastCharacter then
                hideAll()
                lastCharacter = character
            end
            local root = character and character:FindFirstChild("HumanoidRootPart")
            for gui, showing in displays do
                local attachment = gui.Adornee
                local visible = false
                if
                    root
                    and root:IsA("BasePart")
                    and root:IsDescendantOf(workspace)
                    and attachment
                    and attachment:IsA("Attachment")
                    and attachment:IsDescendantOf(workspace)
                    and gui:GetAttribute("LockBaseOccupied") == true
                then
                    local distance = (root.Position - attachment.WorldPosition).Magnitude
                    visible = distance <= (if showing then HIDE_DISTANCE else SHOW_DISTANCE)
                end
                displays[gui] = visible
                if gui.Enabled ~= visible then
                    gui.Enabled = visible
                end
            end
            task.wait(CHECK_INTERVAL)
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="829">
            <Properties>
              <string name="Name">LuckyBlockHudController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Hud = require(script.Parent.Parent.UI.LuckyBlockHud)
local Messages = require(script.Parent.Parent.UI.LuckyBlockMessages)
local Controller = {}
local connection: RBXScriptConnection? = nil
function Controller.Init()
    if connection then
        return
    end
    local player = Players.LocalPlayer
    local view: { Gui: ScreenGui, Render: ({ Messages.Entry }) -> (), Destroy: () -> () }? = nil
    local elapsed = 0
    local function refresh()
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if view and (not playerGui or not view.Gui:IsDescendantOf(playerGui)) then
            view.Destroy()
            view = nil
        end
        if not playerGui then
            return
        end
        if not view then
            view = Hud.Create(playerGui)
        end
        (view :: { Gui: ScreenGui, Render: ({ Messages.Entry }) -> (), Destroy: () -> () }).Render(
            Messages.Read(function(name)
                return player:GetAttribute(name)
            end, workspace:GetServerTimeNow())
        )
    end
    refresh()
    connection = RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed >= 0.1 then
            elapsed = 0
            refresh()
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="830">
            <Properties>
              <string name="Name">LuckyBlockPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.LuckyBlockConfig)
local Presentation = require(game:GetService("ReplicatedStorage").Shared.Constants.LuckyBlockPresentation)
local Handoff = require(script.Parent.Parent.UI.LuckyBlockPickupHandoff)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    CollectionService:GetInstanceAddedSignal(Presentation.PickupTag):Connect(function(object)
        if object:IsA("Model") then
            Handoff.Track(object)
        end
    end)
    CollectionService:GetInstanceRemovedSignal(Presentation.PickupTag):Connect(function(object)
        if object:IsA("Model") then
            Handoff.Untrack(object)
        end
    end)
    for _, object in CollectionService:GetTagged(Presentation.PickupTag) do
        if object:IsA("Model") then
            Handoff.Track(object)
        end
    end
    local models: { [Model]: boolean } = {}
    local function add(object: Instance)
        if object:IsA("Model") then
            models[object] = true
        end
    end
    CollectionService:GetInstanceAddedSignal(Config.WorldTag):Connect(add)
    CollectionService:GetInstanceRemovedSignal(Config.WorldTag):Connect(function(object)
        if object:IsA("Model") then
            models[object] = nil
        end
    end)
    for _, object in CollectionService:GetTagged(Config.WorldTag) do
        add(object)
    end
    RunService.RenderStepped:Connect(function()
        local now = workspace:GetServerTimeNow()
        Handoff.Step(now)
        for model in models do
            local origin = model:GetAttribute("LuckyBlockOrigin")
            local spawned = model:GetAttribute("LuckyBlockSpawnTime")
            if model:IsDescendantOf(workspace) and typeof(origin) == "CFrame" and typeof(spawned) == "number" then
                local elapsed = now - spawned
                local bob = math.sin(elapsed * 2 * math.pi / Config.Animation.BobPeriodSeconds)
                    * Config.Animation.BobAmplitude
                model:PivotTo(
                    origin
                        * CFrame.new(0, bob, 0)
                        * CFrame.Angles(0, math.rad(elapsed * Config.Animation.RotationDegreesPerSecond), 0)
                )
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="831">
            <Properties>
              <string name="Name">LuckyBlockRouletteController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")
local Config = require(ReplicatedStorage.Shared.Constants.LuckyBlockPresentation)
local PickupConfig = require(ReplicatedStorage.Shared.Constants.LuckyBlockConfig)
local Sequence = require(script.Parent.Parent.UI.LuckyBlockSequence)
local View = require(script.Parent.Parent.UI.LuckyBlockView)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    local localPlayer = Players.LocalPlayer
    local manager = Sequence.new(function(seconds, callback)
        local completed = false
        local timer = task.delay(seconds, function()
            completed = true
            callback()
        end)
        return function()
            if not completed then
                pcall(task.cancel, timer)
            end
        end
    end)
    local watches: { [Player]: { RBXScriptConnection } } = {}
    local lastId: { [Player]: number } = {}
    local function unwatch(player: Player)
        manager.Cancel(player)
        local connections: { RBXScriptConnection } = watches[player] or {}
        for _, connection in connections do
            connection:Disconnect()
        end
        watches[player] = nil
    end
    local function receive(player: Player, payload: any, full: boolean)
        if
            type(payload) ~= "table"
            or type(payload.RewardId) ~= "string"
            or not (Config.Rewards :: any)[payload.RewardId]
        then
            return
        end
        if type(payload.PickupId) ~= "number" or type(payload.PickedUpAt) ~= "number" then
            return
        end
        if typeof(payload.Position) ~= "Vector3" then
            return
        end
        if lastId[player] and payload.PickupId <= lastId[player] then
            return
        end
        lastId[player] = payload.PickupId
        unwatch(player)
        local character = player.Character
        if character ~= payload.Character or not character or not character:IsDescendantOf(workspace) then
            return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            return
        end
        local age = workspace:GetServerTimeNow() - payload.PickedUpAt
        if age >= Config.RevealSeconds + Config.HoldSeconds + Config.FadeSeconds then
            return
        end
        local view =
            View.Create(payload.Position, if full then nil else payload.RewardId, payload.PickupId, payload.PickedUpAt)
        if not view then
            return
        end
        watches[player] = {
            humanoid.Died:Connect(function()
                if player.Character == character then
                    unwatch(player)
                end
            end),
            player.CharacterRemoving:Connect(function(removing)
                if removing == character then
                    unwatch(player)
                end
            end),
            character.AncestryChanged:Connect(function()
                if player.Character == character and not character:IsDescendantOf(workspace) then
                    unwatch(player)
                end
            end),
        }
        local destroy = view.Destroy
        function view.Destroy()
            destroy()
            local connections: { RBXScriptConnection } = watches[player] or {}
            for _, connection in connections do
                connection:Disconnect()
            end
            watches[player] = nil
        end
        manager.Start(player, payload.RewardId, full, view, workspace:GetServerTimeNow() - payload.PickedUpAt)
    end
    Players.PlayerRemoving:Connect(function(player)
        unwatch(player)
        lastId[player] = nil
    end)
    -- Independent listeners: a missing observer remote cannot stall collector feedback.
    task.spawn(function()
        local remote = ReplicatedStorage.Shared.Events:WaitForChild(PickupConfig.RewardEventName) :: RemoteEvent
        remote.OnClientEvent:Connect(function(payload)
            receive(localPlayer, payload, true)
        end)
    end)
    task.spawn(function()
        local remote = ReplicatedStorage.Shared.Events:WaitForChild(Config.NearbyEventName) :: RemoteEvent
        remote.OnClientEvent:Connect(function(payload: any)
            if type(payload) ~= "table" or type(payload.UserId) ~= "number" then
                return
            end
            local player = Players:GetPlayerByUserId(payload.UserId)
            if player and player ~= localPlayer then
                receive(player, payload, false)
            end
        end)
    end)
    task.spawn(function()
        local tickSound, popSound = Instance.new("Sound"), Instance.new("Sound")
        tickSound.SoundId, popSound.SoundId = Config.TickSoundId, Config.PopSoundId
        local assets: { Instance } = { tickSound, popSound }
        local folder = ReplicatedStorage:FindFirstChild(Config.VisualFolderName)
        if folder then
            table.insert(assets, folder)
        end
        pcall(function()
            ContentProvider:PreloadAsync(assets)
        end)
        tickSound:Destroy()
        popSound:Destroy()
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="832">
            <Properties>
              <string name="Name">MuncherPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Config = require(Shared.Constants.Muncher)
local Style = require(Shared.Constants.DialogueTextStyle)
local BillboardStyle = require(script.Parent.Parent.UI.WorldBillboardStyle)
local Effects = require(script.Parent.Parent.UI.MuncherEffects)
local Controller = {}
local started = false

-- Pure presentation policy. Server independently validates every attempted feed.
function Controller.Feedback(model: Instance, plot: Instance, player: Player): string
    if
        plot:GetAttribute("PlotSessionId") == nil
        or plot:GetAttribute("PlotSessionId") ~= player:GetAttribute("PlotSessionId")
    then
        return "NOT YOUR MUNCHER"
    end
    if model:GetAttribute("Purchased") ~= true then
        return "LOCKED"
    end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not player.Character or (humanoid and humanoid.Health <= 0) then
        return ""
    end
    if
        model:GetAttribute("Active") ~= true
        or model:GetAttribute("Phase") ~= "Idle"
        or workspace:GetServerTimeNow() < (model:GetAttribute("AvailableAt") or 0)
    then
        return if workspace:GetServerTimeNow() < (model:GetAttribute("BusyUntil") or 0)
            then "BUSY" .. utf8.char(0x2026)
            else ""
    end
    return "FEED ME"
end

local function updateHint(view: any, model: Instance, player: Player, now: number)
    local feedback = Controller.Feedback(model, view.Plot, player)
    local phase = model:GetAttribute("Phase")
    local sequence = model:GetAttribute("Sequence")
    local availableAttribute = model:GetAttribute("AvailableAt")
    local availableAt = if type(availableAttribute) == "number" then availableAttribute else 0
    local eligible = view.Plot:IsDescendantOf(workspace)
        and model:IsDescendantOf(view.Plot)
        and view.Plot:GetAttribute("PlotSessionId") == player:GetAttribute("PlotSessionId")
        and view.Plot:GetAttribute("PlotSessionId") ~= nil
        and model:GetAttribute("Purchased") == true
        and model:GetAttribute("Active") == true
        and player.Character ~= nil
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    eligible = eligible and (not humanoid or humanoid.Health > 0)
    if not eligible or sequence ~= view.Sequence or phase ~= "Idle" then
        view.BannerUntil, view.BannerResult = nil, nil
    end
    if not eligible or sequence ~= view.Sequence then
        view.PendingResult = nil
    end
    if eligible and (phase == "Processing" or phase == "Spitting") then
        view.PendingResult = model:GetAttribute("ResultKind") or view.PendingResult
    elseif phase == "Idle" then
        -- Successful output publication advances AvailableAt; interruption does not.
        -- ResultKind is already cleared in the idle snapshot, so retain the roll's result.
        if eligible and view.PendingResult and availableAt > (view.AvailableAt or availableAt) then
            view.BannerResult = view.PendingResult
            view.BannerUntil = availableAt - Config.SpitSeconds + 2
        end
        view.PendingResult = nil
    end
    view.Sequence, view.AvailableAt = sequence, availableAt
    local result = if view.BannerUntil and now < view.BannerUntil then view.BannerResult else nil
    local banner = result == "Win" or result == "Lose"
    local visible = eligible and (banner or feedback == "FEED ME" or feedback == "BUSY" .. utf8.char(0x2026))
    if visible and not view.Gui.Enabled then
        view.ShownAt = now
    end
    view.Label.Text = if banner then (if result == "Win" then "YOU WIN!" else "YOU LOSE!") else feedback
    view.Label.TextColor3 = if banner
        then (if result == "Win" then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 120, 120))
        else Style.White
    view.Gui.Enabled = visible
end

local function purchaseDisplay(pad: BasePart, playerGui: PlayerGui): BillboardGui
    local gui = Instance.new("BillboardGui")
    gui.Name = "MuncherPurchase"
    -- Decorative purchase view: never consume world or Throw taps.
    gui.Active = false
    gui.Adornee = pad
    -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
    BillboardStyle.ApplyBillboard(gui, { WidthStuds = 10.9, HeightStuds = 2.0, MaxDistance = 40 })
    gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
    for index, text in { "MUNCHER", "$100K" } do
        local label = Instance.new("TextLabel")
        label.Name = if index == 1 then "Title" else "Detail"
        label.Active = false
        BillboardStyle.ApplyText(label, {})
        Style.Apply(label :: TextLabel, 24, gui)
        label.Size = UDim2.fromScale(1, 0.5)
        label.Position = UDim2.fromScale(0, (index - 1) / 2)
        label.TextScaled = true
        label.Text = text
        if index == 2 then
            label.TextColor3 = Style.Gold
        end
        label.Parent = gui
    end
    gui.Parent = playerGui
    return gui
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
    CollectionService:GetInstanceAddedSignal("IngredientWorldItem"):Connect(function(object)
        if object:GetAttribute("MuncherReward") == true then
            Effects.Pop(object)
        end
    end)
    local views: { [Instance]: any } = {}
    local elapsed = 0
    RunService.RenderStepped:Connect(function(dt)
        for model, view in views do
            local now = workspace:GetServerTimeNow()
            updateHint(view, model, player, now)
            view.Animate(now)
            if view.Gui.Enabled and view.ShownAt then
                local t = math.clamp((now - view.ShownAt) / 0.25, 0, 1)
                view.Label.Position = UDim2.fromScale(0, -math.sin(t * math.pi) * 0.12)
            end
        end
        elapsed += dt
        if elapsed < Config.ScanInterval then
            return
        end
        elapsed = 0
        local seen: { [Instance]: boolean } = {}
        for _, plot in CollectionService:GetTagged("PlayerPlot") do
            local model = plot:FindFirstChild("Muncher")
            if not model or not plot:IsDescendantOf(workspace) then
                continue
            end
            seen[model] = true
            local view = views[model]
            if not view then
                local gui = Instance.new("BillboardGui")
                gui.Name = "MuncherHint"
                gui.Active = false
                gui.Enabled = false
                BillboardStyle.ApplyBillboard(
                    gui,
                    { WidthStuds = 6.6, HeightStuds = 1.7, MaxDistance = 25, AlwaysOnTop = false, ResetOnSpawn = true }
                )
                local label = Instance.new("TextLabel")
                -- Decorative hint/result view: never consume world or Throw taps.
                -- UIStroke/UIPadding are UIComponents and have no Active property.
                label.Active = false
                label.BackgroundTransparency, label.Size = 1, UDim2.fromScale(1, 1)
                Style.Apply(label :: TextLabel, 24, gui)
                label.TextScaled = true
                label.Parent, gui.Parent = gui, playerGui
                gui.StudsOffsetWorldSpace = Vector3.new(0, 2.2, 0)
                local animate, cleanup = Effects.Bind(model, playerGui)
                view = { Gui = gui, Label = label, Animate = animate, Cleanup = cleanup, Plot = plot }
                views[model] = view
            end
            local input = model:FindFirstChild("InputZone")
            local pad = model:FindFirstChild("PurchasePoint1")
            if view.Pad ~= pad then
                if view.Purchase then
                    view.Purchase:Destroy()
                end
                view.Pad = pad
                view.Purchase = if pad and pad:IsA("BasePart") then purchaseDisplay(pad, playerGui) else nil
            end
            if view.Purchase then
                view.Purchase.Enabled = pad.CanTouch and pad.Transparency < 1
            end
            local mouth = model:FindFirstChild("MouthOrigin", true)
            view.Gui.Adornee = if mouth and (mouth:IsA("Attachment") or mouth:IsA("BasePart"))
                then mouth
                elseif input and input:IsA("BasePart") then input
                else nil
            updateHint(view, model, player, workspace:GetServerTimeNow())
        end
        for model, view in views do
            if not seen[model] then
                view.Cleanup()
                view.Gui:Destroy()
                if view.Purchase then
                    view.Purchase:Destroy()
                end
                views[model] = nil
            end
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="833">
            <Properties>
              <string name="Name">MusicController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local Config = require(game:GetService("ReplicatedStorage").Shared.Constants.MusicPresentation)
local Controller = {}
local enabled = Config.DefaultEnabled
local volume = Config.DefaultVolume
local started = false
local sound: Sound? = nil
local index = 1

function Controller.IsEnabled(): boolean
    return enabled
end

function Controller.GetVolume(): number
    return volume
end

function Controller.SetEnabled(value: boolean)
    if type(value) ~= "boolean" then
        return
    end
    enabled = value
    Players.LocalPlayer:SetAttribute("MusicEnabled", enabled)
    if sound then
        if enabled then
            sound:Resume()
        else
            sound:Pause()
        end
    end
end

function Controller.SetVolume(value: number)
    if type(value) ~= "number" or value ~= value then
        return
    end
    volume = math.clamp(value, 0, 1)
    Players.LocalPlayer:SetAttribute("MusicVolume", volume)
    if sound then
        sound.Volume = volume
    end
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local savedEnabled = player:GetAttribute("MusicEnabled")
    local savedVolume = player:GetAttribute("MusicVolume")
    Controller.SetEnabled(if type(savedEnabled) == "boolean" then savedEnabled else Config.DefaultEnabled)
    Controller.SetVolume(if type(savedVolume) == "number" then savedVolume else Config.DefaultVolume)
    if #Config.TrackIds == 0 then
        if RunService:IsStudio() then
            warn("MusicController: empty TrackIds; music playback is inert until assets are configured")
        end
        return
    end
    local playing = Instance.new("Sound")
    playing.Name = "BackgroundMusic"
    playing.Looped = true
    playing.Volume = volume
    playing.SoundId = Config.TrackIds[index]
    playing.Parent = SoundService
    sound = playing
    local function advance()
        index = index % #Config.TrackIds + 1
        playing.SoundId = Config.TrackIds[index]
        playing.TimePosition = 0
        playing:Play()
        if not enabled then
            playing:Pause()
        end
    end
    playing.Ended:Connect(advance)
    -- Looped sounds emit DidLoop rather than Ended in Roblox.
    playing.DidLoop:Connect(function()
        if #Config.TrackIds > 1 then
            advance()
        end
    end)
    playing:Play()
    if not enabled then
        playing:Pause()
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="834">
            <Properties>
              <string name="Name">PlotIdentityController</string>
              <string name="Source"><![CDATA[--!strict
local BillboardStyle = require(game:GetService("ReplicatedStorage").Shared.WorldBillboardStyle)
-- Replicated identity is presentation only. Every action is revalidated by the server.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextStyle = require(ReplicatedStorage.Shared.Constants.DialogueTextStyle)
local Controller = {}
local player = Players.LocalPlayer
local portraits: { [number]: string } = {}
local pending: { [number]: boolean } = {}
local displays: { [Instance]: BillboardGui } = {}
local padLabels: { [Instance]: BillboardGui } = {}
local initialized = false
local function portrait(id: number): string
    if not portraits[id] and not pending[id] then
        pending[id] = true
        task.spawn(function()
            local ok, url = pcall(function()
                return Players:GetUserThumbnailAsync(id, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            end)
            portraits[id] = if ok then url else ""
            pending[id] = nil
        end)
    end
    return portraits[id] or ""
end
local function label(parent: Instance, text: string, y: number): TextLabel
    local result = Instance.new("TextLabel")
    result.BackgroundTransparency = 1
    result.Size = UDim2.new(1, 0, 0, 28)
    result.Position = UDim2.fromOffset(0, y)
    TextStyle.Apply(result, 17, if parent:IsA("BillboardGui") then parent else nil)
    if parent:IsA("BillboardGui") then
        local canvasHeight = if parent.Name == "PlotIdentity" then 200 else 32
        result.Size = UDim2.fromScale(1, 28 / canvasHeight)
        result.Position = UDim2.fromScale(0, y / canvasHeight)
        result.TextScaled = true
    end
    result.Text = text
    result.Parent = parent
    return result
end
local function button(parent: Instance, text: string, y: number, callback: () -> ()): TextButton
    local result = Instance.new("TextButton")
    result.Size = UDim2.new(1, -24, 0, 30)
    result.AnchorPoint = Vector2.new(0.5, 0.5)
    result.Position = UDim2.new(0.5, 0, 0, y + 15)
    if parent:IsA("BillboardGui") then
        result.Size = UDim2.fromScale(256 / 280, 30 / 200)
        result.Position = UDim2.fromScale(0.5, (y + 15) / 200)
    end
    result.BackgroundColor3 = Color3.fromRGB(35, 92, 108)
    result.BorderSizePixel = 0
    TextStyle.Apply(result, 17, if parent:IsA("BillboardGui") then parent else nil)
    result.TextScaled = parent:IsA("BillboardGui")
    result.Text = text
    result.Parent = parent
    Instance.new("UICorner", result).CornerRadius = UDim.new(0, 12)
    local border = Instance.new("UIStroke")
    border.Name = "ButtonOutline"
    border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    border.Parent = result
    border.Color = TextStyle.Dark
    if parent:IsA("BillboardGui") then
        BillboardStyle.ApplyWorldStroke(result, parent, { Name = "ButtonOutline", Color = TextStyle.Dark })
    else
        border.Thickness = 3
    end
    result.Activated:Connect(callback)
    return result
end
function Controller.Init()
    if initialized then
        return
    end
    initialized = true
    local remote = ReplicatedStorage.Shared.Events:WaitForChild("GameplayRequest") :: RemoteEvent
    local gui = Instance.new("ScreenGui")
    gui.Name, gui.ResetOnSpawn = "PlotStatus", false
    gui.Parent = player:WaitForChild("PlayerGui")
    local status = label(gui, "", 70)
    local function context(plot: Instance): any
        return {
            PlotSessionId = plot:GetAttribute("PlotSessionId"),
            MembershipRevision = plot:GetAttribute("PlotMembershipRevision"),
            ClaimRevision = plot:GetAttribute("PlotClaimRevision") or 0,
        }
    end
    local function send(plot: Instance, action: string, value: any, captured: any)
        remote:FireServer(action, plot, value, captured)
    end
    local failureUntil = 0
    remote.OnClientEvent:Connect(function(action, result)
        if action == "PlotRequestResult" and not result.success then
            failureUntil = os.clock() + 4
        end
    end)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.25 then
            return
        end
        elapsed = 0
        status.Text = if os.clock() < failureUntil then "Plot action unavailable. Try again." else ""
        status.TextSize = 17
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local live: { [Instance]: boolean } = {}
        local liveLabels: { [Instance]: boolean } = {}
        for _, plot in CollectionService:GetTagged("PlayerPlot") do
            local identity = plot:FindFirstChild("PlotIdentity")
            if identity and plot:IsDescendantOf(workspace) then
                for _, role in { "Claim", "Teammate" } do
                    local labelOrigin = identity:FindFirstChild(role .. "LabelOrigin")
                    if labelOrigin and (labelOrigin:IsA("BasePart") or labelOrigin:IsA("Attachment")) then
                        liveLabels[labelOrigin] = true
                        local display = padLabels[labelOrigin]
                        if not display then
                            local created = Instance.new("BillboardGui")
                            created.Name = role .. "ZoneLabel"
                            -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
                            BillboardStyle.ApplyBillboard(
                                created,
                                { WidthStuds = 5.76, HeightStuds = 1.08, MaxDistance = 60, ResetOnSpawn = true }
                            )
                            created.Active = false
                            created.Adornee, created.Parent = labelOrigin, gui
                            label(created, if role == "Claim" then "CLAIM PLOT" else "JOIN STAND", 0)
                            padLabels[labelOrigin] = created
                            display = created
                        end
                        local occupancy = plot:GetAttribute("PlotOccupancy") or 0
                        display.Enabled = if role == "Claim" then occupancy == 0 else occupancy == 1
                    end
                end
            end
            local origin = plot:FindFirstChild("PlotIdentityOrigin", true)
            if
                not plot:IsDescendantOf(workspace)
                or not origin
                or not (origin:IsA("BasePart") or origin:IsA("Attachment"))
            then
                continue
            end
            live[plot] = true
            if not displays[plot] then
                local display = Instance.new("BillboardGui")
                display.Name = "PlotIdentity"
                BillboardStyle.ApplyBillboard(
                    display,
                    { WidthStuds = 9, HeightStuds = 6.36, MaxDistance = 60, ResetOnSpawn = true }
                )
                display.ClipsDescendants = false -- Allow proportional member columns around the existing action footprint.
                display.Active = true
                display.Parent = gui
                displays[plot] = display
            end
            local display = displays[plot]
            display.Adornee = origin
            local owner = plot:GetAttribute("OwnerUserId")
            local teammate = plot:GetAttribute("TeammateUserId")
            display.MaxDistance = 60
            local position = if origin:IsA("Attachment") then origin.WorldPosition else (origin :: BasePart).Position
            local nearby = root and root:IsA("BasePart") and (root.Position - position).Magnitude <= 32
            local action = if not nearby then nil elseif teammate == player.UserId then "LEAVE TEAM" else nil
            local signature = tostring(owner)
                .. tostring(teammate)
                .. tostring(plot:GetAttribute("PlotMembershipRevision"))
                .. tostring(plot:GetAttribute("PlotClaimRevision"))
                .. tostring(action)
                .. (if type(owner) == "number" then portrait(owner) else "")
                .. (if type(teammate) == "number" then portrait(teammate) else "")
            if display:GetAttribute("Signature") ~= signature then
                display:SetAttribute("Signature", signature)
                display:ClearAllChildren()
                if type(owner) == "number" then
                    local function member(id: number, name: string, x: number, role: string)
                        local head = Instance.new("ImageLabel")
                        head.Size, head.Position = UDim2.fromScale(64 / 280, 64 / 200), UDim2.fromScale(x / 280, 0)
                        head.Image, head.BackgroundTransparency, head.Parent = portrait(id), 1, display
                        Instance.new("UICorner", head).CornerRadius = UDim.new(1, 0)
                        local nameLabel = label(display, name, 72)
                        nameLabel.TextSize = 24
                        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
                        local width = if teammate then 260 else 420
                        nameLabel.Size = UDim2.fromScale(width / 280, 32 / 200)
                        nameLabel.Position = UDim2.fromScale((x + 32 - width / 2) / 280, 72 / 200)
                        if role ~= "" then
                            local roleLabel = label(display, role, 106)
                            roleLabel.Size, roleLabel.Position =
                                UDim2.fromScale(width / 280, 24 / 200),
                                UDim2.fromScale((x + 32 - width / 2) / 280, 106 / 200)
                            roleLabel.TextSize = 14
                        end
                    end
                    member(owner, tostring(plot:GetAttribute("PlotOwnerName") or ""), if teammate then -32 else 108, "")
                    if type(teammate) == "number" then
                        member(teammate, tostring(plot:GetAttribute("PlotTeammateName") or ""), 248, "TEAMMATE")
                    end
                else
                    label(display, "AVAILABLE PLOT", 68)
                end
                if action then
                    local captured = context(plot)
                    button(display, action, 132, function()
                        send(plot, "LeaveTeam", nil, captured)
                    end)
                end
            end
        end
        for plot, display in displays do
            if not live[plot] then
                display:Destroy()
                displays[plot] = nil
            end
        end
        for origin, display in padLabels do
            if not liveLabels[origin] then
                display:Destroy()
                padLabels[origin] = nil
            end
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="835">
            <Properties>
              <string name="Name">RareIngredientPresentationController</string>
              <string name="Source"><![CDATA[--!strict
-- One presentation path for spawn, acquisition, serving and future server events.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Banner = require(script.Parent.Parent.UI.AnnouncementBanner)
local SoundService = game:GetService("SoundService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.AnnouncementFormat)
local Controller = {}
local started = false
local sounds = { Mystery = "rbxassetid://110253665387820" } -- Existing blender-ready ding.

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
        local remote = Shared:WaitForChild("Events"):WaitForChild("RareIngredientSpawned")
        assert(remote:IsA("RemoteEvent"), "RareIngredientSpawned must be a RemoteEvent")
        local surface = Banner.Create(playerGui, "RareIngredientAnnouncement")
        local banner = surface.Label
        local cue = Instance.new("Sound")
        cue.Name = "AnnouncementCue"
        cue.Volume = 0.35
        cue.Parent = SoundService
        local queue: { Format.Message } = {}
        local showing = false
        local function drain()
            while #queue > 0 do
                local message = assert(table.remove(queue, 1))
                local text = Format.VisibleText(message, workspace:GetServerTimeNow())
                if not text then
                    continue -- Expired countdowns must not replay after a backlog.
                end
                Banner.SetGlobalActive(true)
                surface.Show(text)
                local soundId = if message.SoundType then sounds[message.SoundType] else nil
                if soundId then
                    cue.SoundId = soundId
                    cue:Play()
                    task.delay(1.5, function()
                        cue:Stop()
                    end)
                end
                local holdUntil = os.clock() + 0.24 + message.Duration
                repeat
                    task.wait(0.1)
                    text = Format.VisibleText(message, workspace:GetServerTimeNow())
                    if text then
                        banner.Text = text
                    end
                until not text
                    or (message.CountdownEndsAt == nil and os.clock() >= holdUntil)
                    or Format.ShouldInterrupt(queue)
                surface.Exit()
                task.wait(0.18)
                surface.Hide()
            end
            Banner.SetGlobalActive(false)
            showing = false
        end
        remote.OnClientEvent:Connect(function(payload: any)
            local message = Format.Build(payload)
            if not message then
                return
            end
            Format.Enqueue(queue, message)
            if not showing then
                showing = true
                task.spawn(drain)
            end
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="836">
            <Properties>
              <string name="Name">RespawnPresentationController</string>
              <string name="Source"><![CDATA[--!strict
-- Lightweight full-screen "RESPAWNING..." countdown. Purely cosmetic; the
-- server (Players.RespawnTime) is the sole authority on when respawn happens.
local Players = game:GetService("Players")
local RespawnConfig = require(game:GetService("ReplicatedStorage").Shared.Constants.RespawnConfig)
local Controller = {}
local started = false

local ink = Color3.fromRGB(245, 248, 255)
local backdrop = Color3.fromRGB(12, 14, 20)

local function build(): (ScreenGui, TextLabel, TextLabel)
    local screen = Instance.new("ScreenGui")
    screen.Name = "RespawnGui"
    screen.ResetOnSpawn = false
    screen.DisplayOrder = 100
    screen.IgnoreGuiInset = true
    screen.Enabled = false

    local backgroundFrame = Instance.new("Frame")
    backgroundFrame.Name = "Backdrop"
    backgroundFrame.Size = UDim2.fromScale(1, 1)
    backgroundFrame.BackgroundColor3 = backdrop
    backgroundFrame.BackgroundTransparency = 0.15
    backgroundFrame.BorderSizePixel = 0
    backgroundFrame.Parent = screen

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.AnchorPoint = Vector2.new(0.5, 0.5)
    title.Position = UDim2.fromScale(0.5, 0.42)
    title.Size = UDim2.fromScale(0.8, 0.12)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextScaled = true
    title.TextColor3 = ink
    title.Text = "RESPAWNING..."
    title.Parent = backgroundFrame

    local countdown = Instance.new("TextLabel")
    countdown.Name = "Countdown"
    countdown.AnchorPoint = Vector2.new(0.5, 0.5)
    countdown.Position = UDim2.fromScale(0.5, 0.56)
    countdown.Size = UDim2.fromScale(0.3, 0.16)
    countdown.BackgroundTransparency = 1
    countdown.Font = Enum.Font.GothamBold
    countdown.TextScaled = true
    countdown.TextColor3 = ink
    countdown.Text = tostring(math.ceil(RespawnConfig.RespawnDelaySeconds))
    countdown.Parent = backgroundFrame

    return screen, title, countdown
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local screen, _title, countdown = build()
    screen.Parent = playerGui
    local activeThread: thread? = nil

    local function stopCountdown()
        if activeThread then
            task.cancel(activeThread)
            activeThread = nil
        end
        screen.Enabled = false
    end

    local function startCountdown()
        stopCountdown()
        screen.Enabled = true
        activeThread = task.spawn(function()
            local remaining = math.ceil(RespawnConfig.RespawnDelaySeconds)
            while remaining > 0 do
                countdown.Text = tostring(remaining)
                task.wait(1)
                remaining -= 1
            end
        end)
    end

    local function onCharacterAdded(character: Model)
        stopCountdown()
        local humanoid = character:WaitForChild("Humanoid", 5)
        if humanoid and humanoid:IsA("Humanoid") then
            humanoid.Died:Connect(startCountdown)
        end
    end

    player.CharacterAdded:Connect(onCharacterAdded)
    if player.Character then
        onCharacterAdded(player.Character)
    end
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="837">
            <Properties>
              <string name="Name">RipenessPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Shared = game:GetService("ReplicatedStorage").Shared
local DisplayState = require(script.Parent.Parent.UI.RipenessDisplayState)
local RadialProgress = require(script.Parent.Parent.UI.RadialProgress)
local Tooltip = require(script.Parent.Parent.UI.TutorialTooltip)
local TutorialText = require(script.Parent.Parent.UI.RipenessTutorialText)
local RipenessStyle = require(Shared.Constants.RipenessPresentation)

local Controller = {}
local started = false
local gold = RipenessStyle.IndicatorGold
local fresh = Color3.fromRGB(185, 204, 185)
local track = Color3.fromRGB(58, 68, 62)

type Pip = { Root: Frame, RadialProgress: RadialProgress.View, Center: Frame, Ripe: boolean }
type Slot = { Gui: BillboardGui?, Pips: { [string]: Pip }, Signature: string }
local function pip(parent: BillboardGui, order: number): Pip
    local root = Instance.new("Frame")
    root.Name = "RipenessPip"
    root.BackgroundTransparency = 1
    root.Size = UDim2.fromScale(22 / 120, 22 / 24)
    root.Position = UDim2.fromScale((18 + (order - 1) * 28) / 120, 1 / 24)
    root.Parent = parent
    local radial = RadialProgress.Create(root, gold, track)
    local center = Instance.new("Frame")
    center.Name = "Center"
    center.AnchorPoint = Vector2.new(0.5, 0.5)
    center.Position = UDim2.fromScale(0.5, 0.5)
    center.Size = UDim2.fromScale(7 / 22, 7 / 22)
    center.BackgroundColor3 = fresh
    center.BorderSizePixel = 0
    Instance.new("UICorner", center).CornerRadius = UDim.new(1, 0)
    center.Parent = root
    return { Root = root, RadialProgress = radial, Center = center, Ripe = false }
end

local function renderPip(view: Pip, amount: number, ripe: boolean)
    view.RadialProgress.Root.Visible = not ripe
    if not ripe then
        RadialProgress.SetProgress(view.RadialProgress, amount)
    end
    view.Center.BackgroundColor3 = if ripe then gold else fresh
    view.Center.Size = if ripe then UDim2.fromScale(15 / 22, 15 / 22) else UDim2.fromScale(7 / 22, 7 / 22)
    if ripe and not view.Ripe then
        view.Center.Size = UDim2.fromScale(19 / 22, 19 / 22)
        TweenService:Create(view.Center, TweenInfo.new(0.22, Enum.EasingStyle.Back), {
            Size = UDim2.fromScale(15 / 22, 15 / 22),
        }):Play()
    end
    view.Ripe = ripe
end

local function showTutorial(playerGui: PlayerGui)
    Tooltip.Show(playerGui, "RipenessTutorial", TutorialText.Rich())
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
    local tutorialShown = false
    local function tutorial()
        if not tutorialShown and player:GetAttribute("RipenessTutorialShown") == true then
            tutorialShown = true
            showTutorial(playerGui)
        end
    end
    player:GetAttributeChangedSignal("RipenessTutorialShown"):Connect(tutorial)
    tutorial()

    local pads: { [BasePart]: Slot } = {}
    local boundFixtures: { [Instance]: boolean } = {}
    local function bind(pad: Instance)
        if pad:IsA("BasePart") and (pad:GetAttribute("SlotIndex") ~= nil or pad.Name:match("^Slot%d+$")) then
            pads[pad] = pads[pad] or { Pips = {}, Signature = "" }
        end
    end
    local function fixture(root: Instance)
        if boundFixtures[root] then
            return
        end
        boundFixtures[root] = true
        root.Destroying:Connect(function()
            boundFixtures[root] = nil
        end)
        for _, part in root:GetDescendants() do
            bind(part)
        end
        root.DescendantAdded:Connect(bind)
        local plot = root.Parent
        if plot then
            local expansion = plot:FindFirstChild("UpgradeStash")
            if expansion then
                for _, part in expansion:GetDescendants() do
                    bind(part)
                end
            end
            plot.DescendantAdded:Connect(function(part)
                if part.Name == "UpgradeStash" then
                    for _, child in part:GetDescendants() do
                        bind(child)
                    end
                elseif part:FindFirstAncestor("UpgradeStash") then
                    bind(part)
                end
            end)
        end
    end
    for _, root in CollectionService:GetTagged("PlayerStash") do
        fixture(root)
    end
    CollectionService:GetInstanceAddedSignal("PlayerStash"):Connect(fixture)

    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        local now = workspace:GetServerTimeNow()
        for pad, slot in pads do
            if not pad:IsDescendantOf(workspace) then
                if slot.Gui then
                    slot.Gui:Destroy()
                end
                pads[pad] = nil
                continue
            end
            local slotCount = pad:GetAttribute("StashCount")
            local count = if typeof(slotCount) == "number" then slotCount else 0
            if count == 0 or pad:GetAttribute("StashItemType") ~= "Ingredient" then
                if slot.Gui then
                    slot.Gui:Destroy()
                end
                slot.Gui, slot.Signature, slot.Pips = nil, "", {}
                continue
            end
            local items, key = DisplayState.Read(pad, now)
            if not slot.Gui or slot.Signature ~= key then
                local old = slot.Pips
                if slot.Gui then
                    slot.Gui:Destroy()
                end
                local gui = Instance.new("BillboardGui")
                gui.Name = "StashRipeness"
                RipenessStyle.ConfigureIndicator(gui, pad)
                gui.AlwaysOnTop = true
                gui.ResetOnSpawn = false
                gui.Parent = playerGui
                slot.Pips = {}
                for order, item in items do
                    local view = pip(gui, order)
                    view.Ripe = old[item.Id] and old[item.Id].Ripe or item.Ripe
                    slot.Pips[item.Id] = view
                end
                slot.Gui, slot.Signature = gui, key
            end
            local gui = slot.Gui
            if gui then
                local origin = RipenessStyle.ResolveOrigin(pad)
                if gui.Adornee ~= origin then
                    gui.Adornee = origin
                end
                for _, item in items do
                    local view = slot.Pips[item.Id]
                    if view then
                        renderPip(view, item.Progress, item.Ripe or item.Progress >= 1)
                    end
                end
            end
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="838">
            <Properties>
              <string name="Name">ScrapbookController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Presentation = require(script.Parent.Parent.UI.ScrapbookPresentation)
local Menus = require(script.Parent.Parent.UI.FramewispMenus)
local Notifications = require(script.Parent.Parent.UI.MenuNotifications)
local cleanup: (() -> ())? = nil
local Controller = {}
local started = false
local generation = 0

-- Snapshot and live events share the same monotonic merge path.
function Controller.MergeDelta(state: Types.DiscoveryState, event: Types.DiscoveryEvent): boolean
    local entries = if event.Kind == "Ingredient" then state.Ingredients else state.SpecialCustomers
    if entries[event.Id] then
        return false
    end
    entries[event.Id] = true
    return true
end

function Controller.MergeSnapshot(state: Types.DiscoveryState, snapshot: Types.DiscoveryState)
    for id, discovered in snapshot.Ingredients do
        if discovered then
            Controller.MergeDelta(state, { Kind = "Ingredient", Id = id })
        end
    end
    for id, discovered in snapshot.SpecialCustomers do
        if discovered then
            Controller.MergeDelta(state, { Kind = "SpecialCustomer", Id = id })
        end
    end
end

-- A single session owns replication; views can be replaced independently.
function Controller.Start(playerGui: PlayerGui, events: Instance, player: Player): () -> ()
    local state: Types.DiscoveryState = { Ingredients = {}, SpecialCustomers = {} }
    local view: Presentation.View? = nil
    local stopped = false
    local connections: { RBXScriptConnection } = {}
    local unseenCount = 0
    local stopOpened = Notifications.OnOpened("Index", function()
        unseenCount = 0
        Notifications.Set("Index", false)
    end)
    local stopView = Presentation.Observe(playerGui, state, function(nextView, root)
        view = nextView
        if root then
            Menus.Attach(root, player)
        end
    end)
    task.spawn(function()
        local added = events:WaitForChild("DiscoveryAdded", 10)
        if stopped then
            return
        end
        if not added or not added:IsA("RemoteEvent") then
            warn("[Scrapbook] DiscoveryAdded missing or not a RemoteEvent")
            return
        end
        table.insert(
            connections,
            added.OnClientEvent:Connect(function(event: Types.DiscoveryEvent)
                if stopped then
                    return
                end
                if not Notifications.IsOpen("Index") then
                    unseenCount += 1
                end
                Notifications.Set("Index", unseenCount > 0)
                if not stopped and Controller.MergeDelta(state, event) and view then
                    view.UpdateDiscovery(event)
                end
            end)
        )
        local snapshot = events:WaitForChild("DiscoverySnapshot", 10)
        if stopped then
            return
        end
        if not snapshot or not snapshot:IsA("RemoteFunction") then
            warn("[Scrapbook] DiscoverySnapshot missing or not a RemoteFunction")
            return
        end
        local ok, result = pcall(function()
            return snapshot:InvokeServer()
        end)
        if stopped then
            return
        end
        if ok then
            Controller.MergeSnapshot(state, result)
            if view then
                view.RenderState(state)
            end
        else
            warn("[Scrapbook] DiscoverySnapshot failed: " .. tostring(result))
        end
    end)
    return function()
        if stopped then
            return
        end
        stopped = true
        stopOpened()
        Notifications.Set("Index", false)
        for _, connection in connections do
            connection:Disconnect()
        end
        stopView()
    end
end

function Controller.Init()
    if started then
        return
    end
    started = true
    generation += 1
    local currentGeneration = generation
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
        local events = Shared:WaitForChild("Events")
        if currentGeneration == generation then
            cleanup = Controller.Start(playerGui, events, player)
        end
    end)
end

function Controller.Destroy()
    generation += 1
    if cleanup then
        cleanup()
        cleanup = nil
    end
    started = false
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="839">
            <Properties>
              <string name="Name">SessionInteractionController</string>
              <string name="Source"><![CDATA[--!strict
-- Preserve native/custom prompt presentation while carrying the actor's request revision.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Controller = {}
local started = false
function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local remote = events:WaitForChild("GameplayRequest") :: RemoteEvent
        ProximityPromptService.PromptTriggered:Connect(function(prompt)
            if prompt:GetAttribute("SessionInteraction") ~= true then
                return
            end
            local player = Players.LocalPlayer
            remote:FireServer("PlotInteraction", prompt, nil, {
                PlotSessionId = player:GetAttribute("PlotSessionId"),
                MembershipRevision = player:GetAttribute("PlotMembershipRevision"),
            })
        end)
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="840">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Gui = require(script.Parent.Parent.UI.SettingsGui)
local Music = require(script.Parent.MusicController)
local PanelManager = require(script.Parent.Parent.UI.PanelManager)
local StandIdentity = require(script.Parent.StandIdentityController)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    Music.Init()
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
        local view: Gui.View? = nil
        local remote: RemoteEvent? = nil
        local failure = false
        local feedbackVersion = 0
        local statusTitles: { [TextLabel]: string } = setmetatable({}, { __mode = "k" }) :: any
        local function sessionPlot(): Instance?
            local candidates = CollectionService:GetTagged("PlayerPlot")
            local folder = Workspace:FindFirstChild("Plots")
            if folder then
                for _, plot in folder:GetChildren() do
                    if not table.find(candidates, plot) then
                        table.insert(candidates, plot)
                    end
                end
            end
            local found: Instance? = nil
            local sessionId = player:GetAttribute("PlotSessionId")
            for _, plot in candidates do
                if plot:IsDescendantOf(Workspace) and sessionId and plot:GetAttribute("PlotSessionId") == sessionId then
                    if found then
                        return nil -- Ambiguous replicated session fails closed.
                    end
                    found = plot
                end
            end
            if found then
                return found
            end
            for _, plot in candidates do
                if
                    plot:IsDescendantOf(Workspace)
                    and (
                        plot:GetAttribute("OwnerUserId") == player.UserId
                        or plot:GetAttribute("TeammateUserId") == player.UserId
                    )
                then
                    if found then
                        return nil -- Ambiguous replicated membership fails closed.
                    end
                    found = plot
                end
            end
            return found
        end
        local function refresh()
            local current = view
            if not current or not current.Panel.Visible then
                return
            end
            local plot = sessionPlot()
            local owner = plot ~= nil and plot:GetAttribute("OwnerUserId") == player.UserId
            local teammate = if plot then plot:GetAttribute("TeammateUserId") else nil
            if current.Rename then
                current.Rename.Visible, current.Rename.Active = owner, owner
            end
            local hasTeammate = owner and type(teammate) == "number"
            if current.Kick then
                current.Kick.Visible, current.Kick.Active = hasTeammate, hasTeammate
            end
            local mode = if plot then plot:GetAttribute("JoinMode") else nil
            for value, button in current.Modes do
                button.Active = owner
                Gui.Select(button, value == mode)
            end
            if current.MusicOn then
                Gui.Select(current.MusicOn, Music.IsEnabled())
            end
            if current.MusicOff then
                Gui.Select(current.MusicOff, not Music.IsEnabled())
            end
            Gui.RefreshVolume(current, Music.GetVolume())
            if current.Status then
                if statusTitles[current.Status] == nil then
                    statusTitles[current.Status] = current.Status.Text
                end
                current.Status.Text = if failure
                    then "Plot action unavailable. Try again."
                    else statusTitles[current.Status]
            end
        end
        Gui.Observe(playerGui, function(nextView)
            view = nextView
            refresh()
        end, function(mode)
            if mode ~= "Open" and mode ~= "FriendsOnly" and mode ~= "Closed" then
                return
            end
            local plot = sessionPlot()
            if not plot or not remote or plot:GetAttribute("OwnerUserId") ~= player.UserId then
                return
            end
            local captured = {
                PlotSessionId = plot:GetAttribute("PlotSessionId"),
                MembershipRevision = plot:GetAttribute("PlotMembershipRevision"),
                ClaimRevision = plot:GetAttribute("PlotClaimRevision") or 0,
            }
            remote:FireServer("SetJoinMode", plot, mode, captured)
        end, function(enabled)
            Music.SetEnabled(enabled)
            refresh()
        end, function(volume)
            Music.SetVolume(volume)
            refresh()
            return Music.GetVolume()
        end, function()
            local plot = sessionPlot()
            if not plot or plot:GetAttribute("OwnerUserId") ~= player.UserId then
                return
            end
            PanelManager.CloseAll()
            StandIdentity.OpenNameEditor(plot)
        end, function()
            local plot = sessionPlot()
            if not plot or not remote or plot:GetAttribute("OwnerUserId") ~= player.UserId then
                return
            end
            local teammate = plot:GetAttribute("TeammateUserId")
            if type(teammate) ~= "number" then
                return
            end
            local captured = {
                PlotSessionId = plot:GetAttribute("PlotSessionId"),
                MembershipRevision = plot:GetAttribute("PlotMembershipRevision"),
                ClaimRevision = plot:GetAttribute("PlotClaimRevision") or 0,
            }
            remote:FireServer("KickTeammate", plot, teammate, captured)
        end)
        player:GetAttributeChangedSignal("PlotSessionId"):Connect(refresh)
        player:GetAttributeChangedSignal("MusicEnabled"):Connect(refresh)
        player:GetAttributeChangedSignal("MusicVolume"):Connect(refresh)
        local plotConnections: { RBXScriptConnection } = {}
        local queued = false
        local function observePlots()
            queued = false
            for _, connection in plotConnections do
                connection:Disconnect()
            end
            table.clear(plotConnections)
            -- Watch ownership even on unowned candidates: a claim may arrive
            -- after Settings has already opened.
            local candidates = CollectionService:GetTagged("PlayerPlot")
            local folder = Workspace:FindFirstChild("Plots")
            if folder then
                for _, plot in folder:GetChildren() do
                    if not table.find(candidates, plot) then
                        table.insert(candidates, plot)
                    end
                end
            end
            for _, plot in candidates do
                for _, attribute in
                    {
                        "OwnerUserId",
                        "TeammateUserId",
                        "PlotSessionId",
                        "JoinMode",
                        "PlotMembershipRevision",
                        "PlotClaimRevision",
                    }
                do
                    table.insert(plotConnections, plot:GetAttributeChangedSignal(attribute):Connect(refresh))
                end
            end
            refresh()
        end
        local function schedule()
            if not queued then
                queued = true
                task.defer(observePlots)
            end
        end
        CollectionService:GetInstanceAddedSignal("PlayerPlot"):Connect(schedule)
        CollectionService:GetInstanceRemovedSignal("PlayerPlot"):Connect(schedule)
        Workspace.DescendantAdded:Connect(function(instance)
            if
                instance.Name == "Plots"
                or (instance.Parent and instance.Parent.Name == "Plots")
                or CollectionService:HasTag(instance, "PlayerPlot")
            then
                schedule()
            end
        end)
        Workspace.DescendantRemoving:Connect(function(instance)
            if
                instance.Name == "Plots"
                or (instance.Parent and instance.Parent.Name == "Plots")
                or CollectionService:HasTag(instance, "PlayerPlot")
            then
                schedule()
            end
        end)
        observePlots()
        task.spawn(function()
            local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
            local request = events:WaitForChild("GameplayRequest") :: RemoteEvent
            remote = request
            request.OnClientEvent:Connect(function(action, result)
                if action ~= "PlotRequestResult" or type(result) ~= "table" or result.success ~= false then
                    return
                end
                feedbackVersion += 1
                local version = feedbackVersion
                failure = true
                refresh()
                task.delay(4, function()
                    if version == feedbackVersion then
                        failure = false
                        refresh()
                    end
                end)
            end)
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="841">
            <Properties>
              <string name="Name">SmoothiePickupPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Presentation = require(script.Parent.Parent.UI.SmoothiePickupPromptPresentation)
local Controller = {}
local started = false

-- Resolve display metadata only; the server validates its private smoothie record.
function Controller.Resolve(prompt: ProximityPrompt): (BasePart | Model)?
    local ancestor = prompt.Parent
    while ancestor and ancestor ~= workspace do
        if CollectionService:HasTag(ancestor, "SmoothieWorldItem") then
            if ancestor:IsA("BasePart") or ancestor:IsA("Model") then
                return ancestor
            end
            return nil
        end
        ancestor = ancestor.Parent
    end
    return nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    type Entry = {
        InputType: Enum.ProximityPromptInputType,
        Object: Instance?,
        Id: string?,
        Cleanup: (() -> ())?,
        Update: (() -> ())?,
        Connections: { RBXScriptConnection },
    }
    local visible: { [ProximityPrompt]: Entry } = {}
    local function clear(entry: Entry)
        if entry.Cleanup then
            entry.Cleanup()
        end
        entry.Cleanup, entry.Update, entry.Object, entry.Id = nil, nil, nil, nil
    end
    local function hide(prompt: ProximityPrompt)
        local entry = visible[prompt]
        if entry then
            visible[prompt] = nil
            for _, connection in entry.Connections do
                connection:Disconnect()
            end
            clear(entry)
        end
    end
    local function refresh(prompt: ProximityPrompt, entry: Entry)
        if not prompt:IsDescendantOf(workspace) or not prompt.Enabled or not ProximityPromptService.Enabled then
            hide(prompt)
            return
        end
        local object = Controller.Resolve(prompt)
        local rows = if object then Presentation.Rows(object) else nil
        local id = if rows then rows[1].Id .. "/" .. rows[2].Id .. "/" .. rows[3].Id else nil
        if object and object:IsA("Model") and not object:FindFirstChildWhichIsA("BasePart", true) then
            clear(entry)
            return
        end
        if
            prompt.Style ~= Enum.ProximityPromptStyle.Custom
            or prompt:GetAttribute("SmoothiePickupPrompt") ~= true
            or not rows
            or not object
        then
            clear(entry)
            return
        end
        if entry.Object ~= (object :: Instance) or entry.Id ~= id then
            clear(entry)
            entry.Object, entry.Id = object, id
            entry.Cleanup, entry.Update = Presentation.Create(prompt, object, rows, playerGui, entry.InputType)
        elseif entry.Update then
            entry.Update()
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
        hide(prompt)
        -- Track shown prompts only. No distance checks, pickup remotes, or scans.
        if prompt:GetAttribute("SmoothiePickupPrompt") ~= true and prompt.Name ~= "SmoothieCarryPrompt" then
            return
        end
        local entry: Entry = { InputType = inputType, Connections = {} }
        visible[prompt] = entry
        table.insert(
            entry.Connections,
            prompt.Destroying:Connect(function()
                hide(prompt)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.AncestryChanged:Connect(function()
                refresh(prompt, entry)
            end)
        )
        table.insert(
            entry.Connections,
            prompt.Changed:Connect(function(property)
                if property == "Enabled" or property == "Style" then
                    refresh(prompt, entry)
                end
            end)
        )
        refresh(prompt, entry)
    end)
    ProximityPromptService.PromptHidden:Connect(hide)
    -- Only engine-visible prompts: tracks rolling/dropped geometry and tolerates
    -- tags/ingredient rows arriving after PromptShown during replication/streaming.
    RunService.RenderStepped:Connect(function()
        for prompt, entry in visible do
            refresh(prompt, entry)
        end
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="842">
            <Properties>
              <string name="Name">SprintController</string>
              <string name="Source"><![CDATA[--!strict
-- Detects held sprint input (keyboard Shift or mobile button) and requests it from the server.
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MobileControlLayout = require(script.Parent.Parent.UI.MobileControlLayout)
local getSprintEvent = require(ReplicatedStorage.Shared.Events.SprintEvents)

local player = game:GetService("Players").LocalPlayer
local SprintController = {}
local started = false
local requested = false
local heldShift: { [Enum.KeyCode]: boolean } = {}
local heldTouch = false

local function requestSprint(sprintEvent: RemoteEvent, wantsToSprint: boolean)
    wantsToSprint = wantsToSprint and player:GetAttribute("Stunned") ~= true
    if requested == wantsToSprint then
        return
    end
    requested = wantsToSprint
    sprintEvent:FireServer(wantsToSprint)
end

function SprintController.Init()
    if started then
        return
    end
    started = true
    local sprintEvent = getSprintEvent()
    player:GetAttributeChangedSignal("Stunned"):Connect(function()
        if player:GetAttribute("Stunned") == true then
            table.clear(heldShift)
            heldTouch = false
            requestSprint(sprintEvent, false)
        end
    end)

    UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessedEvent: boolean)
        if gameProcessedEvent then
            return
        end
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = true
            requestSprint(sprintEvent, true)
        end
    end)

    UserInputService.InputEnded:Connect(function(input: InputObject)
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = nil
            requestSprint(sprintEvent, heldTouch or next(heldShift) ~= nil)
        end
    end)

    UserInputService.WindowFocusReleased:Connect(function()
        table.clear(heldShift)
        heldTouch = false
        requestSprint(sprintEvent, false)
    end)

    local function sprintTouch(_action: string, state: Enum.UserInputState): Enum.ContextActionResult
        if state == Enum.UserInputState.Begin then
            heldTouch = player:GetAttribute("Stunned") ~= true
        elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
            heldTouch = false
        else
            return Enum.ContextActionResult.Sink
        end
        requestSprint(sprintEvent, heldTouch or next(heldShift) ~= nil)
        return Enum.ContextActionResult.Sink
    end
    ContextActionService:BindAction("SprintHeld", sprintTouch, true)
    ContextActionService:SetTitle("SprintHeld", "Sprint")
    MobileControlLayout.Register("SprintHeld")

    -- Presentation reads the server-replicated StaminaCurrent/StaminaMax/IsSprinting attributes.
end

return SprintController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="843">
            <Properties>
              <string name="Name">StandIdentityController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Config = require(ReplicatedStorage.Shared.Constants.StandIdentity)
local Editor = require(script.Parent.Parent.UI.StandNameEditor)
local TurbineCamera = require(script.Parent.TurbineCameraController)
local Controller = {}
local player = Players.LocalPlayer
type Sequence = {
    Plot: Instance,
    Marker: BasePart,
    Character: Model,
    Camera: Camera,
    Context: any,
    CameraType: Enum.CameraType,
    Subject: (Humanoid | BasePart)?,
    From: CFrame,
    RootPosition: Vector3,
    Tween: Tween?,
    Closing: boolean,
    Saving: boolean,
    FocusUsed: boolean,
}
local current: Sequence? = nil
local ui: Editor.View
local remote: RemoteFunction
local initialized = false
local version = 0
local suspended = false

function Controller.SetSuspended(value: boolean): boolean
    local previous = suspended
    suspended = value
    return previous
end

local function humanoid(): Humanoid?
    return if player.Character then player.Character:FindFirstChildOfClass("Humanoid") else nil
end

local function restore(sequence: Sequence)
    if sequence.Tween then
        sequence.Tween:Cancel()
    end
    sequence.Camera:SetAttribute("StandNameEditorActive", nil)
    local subject = humanoid()
    sequence.Camera.CameraSubject = subject or sequence.Subject
    -- Never restore a borrowed Scriptable camera after this editor owns it.
    sequence.Camera.CameraType = if sequence.CameraType == Enum.CameraType.Scriptable
        then Enum.CameraType.Custom
        else sequence.CameraType
end

function Controller.Close(immediate: boolean?)
    version += 1
    local token = version
    local sequence = current
    if not sequence then
        return
    end
    local wasClosing = sequence.Closing
    sequence.Closing = true
    ui.Hide(if immediate then "immediate cancellation" else "Close")
    if sequence.Tween then
        sequence.Tween:Cancel()
    end
    if immediate or wasClosing then
        current = nil
        restore(sequence)
        return
    end
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local offset = if root and root:IsA("BasePart") then root.Position - sequence.RootPosition else Vector3.zero
    local tween = TweenService:Create(
        sequence.Camera,
        TweenInfo.new(Config.CameraOutSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = sequence.From + offset }
    )
    sequence.Tween = tween
    tween:Play()
    task.spawn(function()
        tween.Completed:Wait()
        if token ~= version or current ~= sequence then
            return
        end
        current = nil
        restore(sequence)
    end)
end

local function valid(sequence: Sequence): boolean
    local subject = humanoid()
    return type(sequence.Context.PlotSessionId) == "string"
        and type(sequence.Context.MembershipRevision) == "number"
        and type(sequence.Context.StandNameRevision) == "number"
        and player.Parent ~= nil
        and player.Character == sequence.Character
        and sequence.Character:IsDescendantOf(workspace)
        and subject ~= nil
        and subject.Health > 0
        and workspace.CurrentCamera == sequence.Camera
        and sequence.Plot:IsDescendantOf(workspace)
        and sequence.Marker.Parent == sequence.Plot
        and sequence.Plot:FindFirstChild("SignCamera") == sequence.Marker
        and sequence.Plot:GetAttribute("OwnerUserId") == player.UserId
        and sequence.Plot:GetAttribute("PlotSessionId") == sequence.Context.PlotSessionId
        and player:GetAttribute("PlotSessionId") == sequence.Context.PlotSessionId
        and sequence.Plot:GetAttribute("PlotMembershipRevision") == sequence.Context.MembershipRevision
end

function Controller.OpenNameEditor(plot: Instance)
    if suspended then
        return
    end
    Controller.Close(true)
    if not initialized then
        return
    end
    TurbineCamera.ReleaseCamera()
    local marker = plot:FindFirstChild("SignCamera")
    local camera, character = workspace.CurrentCamera, player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if
        not camera
        or not character
        or not root
        or not root:IsA("BasePart")
        or not marker
        or not marker:IsA("BasePart")
    then
        return
    end
    local sequence: Sequence = {
        Plot = plot,
        Marker = marker,
        Camera = camera,
        Character = character,
        Context = {
            PlotSessionId = plot:GetAttribute("PlotSessionId"),
            MembershipRevision = plot:GetAttribute("PlotMembershipRevision"),
            StandNameRevision = plot:GetAttribute("StandNameRevision"),
        },
        CameraType = camera.CameraType,
        Subject = camera.CameraSubject,
        From = camera.CFrame,
        RootPosition = root.Position,
        Closing = false,
        Saving = false,
        FocusUsed = false,
    }
    if not valid(sequence) then
        return
    end
    current = sequence
    local token = version
    camera:SetAttribute("StandNameEditorActive", true)
    camera.CameraType = Enum.CameraType.Scriptable
    local tween = TweenService:Create(
        camera,
        TweenInfo.new(Config.CameraInSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
        { CFrame = marker.CFrame }
    )
    sequence.Tween = tween
    tween:Play()
    task.spawn(function()
        tween.Completed:Wait()
        if token ~= version or current ~= sequence then
            return
        end
        if not valid(sequence) then
            Controller.Close(true)
            return
        end
        ui.Box.Text = tostring(plot:GetAttribute("StandName") or "")
        ui.Status.Text, ui.Save.Text = "", "SAVE"
        ui.Show()
        task.delay(3, function()
            if
                token == version
                and current == sequence
                and not sequence.Closing
                and not sequence.FocusUsed
                and ui.Gui.Enabled
                and valid(sequence)
            then
                ui.Box:CaptureFocus()
            end
        end)
    end)
end

function Controller.Init()
    if initialized then
        return
    end
    initialized = true
    remote = ReplicatedStorage.Shared.Events:WaitForChild("SetStandName") :: RemoteFunction
    ui = Editor.Create(player:WaitForChild("PlayerGui"), function()
        ui.TraceSelection("Save requested")
        local sequence = current
        if not sequence or sequence.Closing or sequence.Saving or not ui.Gui.Enabled then
            return
        end
        local raw = ui.Box.Text
        local text = Config.Normalize(raw)
        if not text then
            ui.Status.Text = string.format("Enter a name of 1–%d characters.", Config.MaxCharacters)
            return
        end
        sequence.Saving = true
        ui.Save.Text = "SAVING…"
        task.spawn(function()
            local ok, success, message = pcall(function()
                return remote:InvokeServer(sequence.Plot, raw, sequence.Context)
            end)
            if current ~= sequence or sequence.Closing then
                return
            end
            sequence.Saving = false
            ui.Save.Text = "SAVE"
            if ok and success then
                if type(message) == "string" then
                    ui.Box.Text = message
                end
                Controller.Close()
            else
                ui.Status.Text = if ok and type(message) == "string" then message else "Could not save. Try again."
            end
        end)
    end, function()
        Controller.Close()
    end)
    ui.Box.Focused:Connect(function()
        if current and ui.Gui.Enabled then
            current.FocusUsed = true
        end
    end)
    UserInputService.InputBegan:Connect(function(input)
        if ui.Gui.Enabled and (input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB) then
            ui.TraceSelection(if input.KeyCode == Enum.KeyCode.Escape then "Escape" else "Button B")
            Controller.Close()
        end
    end)
    local function cancel()
        Controller.Close(true)
    end
    player.CharacterRemoving:Connect(cancel)
    player.CharacterAdded:Connect(cancel)
    player.AncestryChanged:Connect(function()
        if player.Parent == nil then
            cancel()
        end
    end)
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(cancel)
    ui.Gui.AncestryChanged:Connect(function()
        if not ui.Gui:IsDescendantOf(player) then
            cancel()
        end
    end)
    ui.Gui:GetPropertyChangedSignal("Enabled"):Connect(function()
        if current and not current.Closing and not ui.Gui.Enabled then
            Controller.Close()
        end
    end)
    RunService.Heartbeat:Connect(function()
        if current and not valid(current) then
            cancel()
        end
    end)
    local claimed = ReplicatedStorage.Shared.Events:WaitForChild("PlotClaimed") :: RemoteEvent
    claimed.OnClientEvent:Connect(function(plot: Instance, id: string, revision: number)
        Controller.Close(true)
        local token = version
        -- Remote events and replicated attributes can arrive on different frames.
        task.spawn(function()
            local deadline = os.clock() + 3
            repeat
                if token ~= version or not plot:IsDescendantOf(workspace) then
                    return
                end
                if
                    plot:GetAttribute("PlotSessionId") == id
                    and player:GetAttribute("PlotSessionId") == id
                    and plot:GetAttribute("PlotMembershipRevision") == revision
                then
                    Controller.OpenNameEditor(plot)
                    return
                end
                RunService.Heartbeat:Wait()
            until os.clock() >= deadline
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="844">
            <Properties>
              <string name="Name">StashExpansionController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Constants = game:GetService("ReplicatedStorage").Shared.Constants
local Upgrades = require(Constants.Upgrades)
local TextStyle = require(Constants.DialogueTextStyle)
local Style = require(script.Parent.Parent.UI.WorldBillboardStyle)
local Controller = {}
function Controller.Init()
    local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local pads: { [BasePart]: BillboardGui } = {}
    local function bind(object: Instance)
        if
            not object:IsA("BasePart")
            or object.Name ~= "PurchasePoint"
            or not object.Parent
            or object.Parent.Name ~= "UpgradeStash"
            or pads[object]
        then
            return
        end
        local gui = Instance.new("BillboardGui")
        gui.Name, gui.Adornee = "SecondStorageDisplay", object
        -- Preserve this existing overlay/occlusion policy; nearby gameplay feedback must stay readable.
        Style.ApplyBillboard(gui, { WidthStuds = 7.2, HeightStuds = 1.68, MaxDistance = 30 })
        gui.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
        local price =
            tostring(Upgrades.SecondStorage[2].Cost):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        for index, text in { "SECOND STORAGE", "$" .. price } do
            local label = Instance.new("TextLabel")
            Style.ApplyText(label, {})
            TextStyle.Apply(label, 24, gui)
            label.Size, label.Position = UDim2.fromScale(1, 0.5), UDim2.fromScale(0, (index - 1) / 2)
            label.TextScaled = true
            label.Text, label.TextColor3 = text, if index == 1 then TextStyle.White else TextStyle.Gold
            label.Parent = gui
        end
        gui.Enabled = false
        gui.Parent = playerGui
        pads[object] = gui
    end
    workspace.DescendantAdded:Connect(bind)
    for _, object in workspace:GetDescendants() do
        bind(object)
    end
    RunService.Heartbeat:Connect(function()
        for pad, gui in pads do
            if not pad:IsDescendantOf(workspace) then
                gui:Destroy()
                pads[pad] = nil
            else
                gui.Enabled = pad:GetAttribute("SecondStoragePad") == true and pad.CanTouch and pad.Transparency < 1
            end
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="845">
            <Properties>
              <string name="Name">StashPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Style = require(ReplicatedStorage.Shared.Constants.DialogueTextStyle)
local Economy = require(ReplicatedStorage.Shared.Constants.Economy)
local Controller = {}
local started = false

-- Cosmetic availability only; every press is validated against the server ledger.
function Controller.Unavailable(player: Player, slot: Instance, action: string): string?
    local session = player:GetAttribute("PlotSessionId")
    local friendly = session ~= nil and session == slot:GetAttribute("StashSessionId")
    local now = workspace:GetServerTimeNow()
    if not session or not slot:GetAttribute("StashSessionId") then
        return "UNAVAILABLE!"
    end
    if action == "STORE" then
        if not friendly then
            return "PROTECTED!"
        end
        local itemType = player:GetAttribute("HeldItemType")
        if not itemType then
            return "NOTHING TO STORE!"
        end
        local count = slot:GetAttribute("StashCount") or 0
        if
            count >= (slot:GetAttribute("StashCapacity") or 3)
            or (count > 0 and (itemType == "Smoothie" or slot:GetAttribute("StashItemType") == "Smoothie"))
        then
            return "SLOT FULL!"
        end
    else
        if
            not friendly
            and (
                slot:GetAttribute("StashProtected") == true
                or (
                    now >= (slot:GetAttribute("StashRaidEndsAt") or 0)
                    and now < (slot:GetAttribute("StashProtectionEndsAt") or 0)
                )
            )
        then
            return "PROTECTED!"
        end
        if (slot:GetAttribute("StashCount") or 0) == 0 then
            return "SLOT EMPTY!"
        end
        if (player:GetAttribute("CarryCount") or 0) >= (player:GetAttribute("CarryCapacity") or 3) then
            return "CARRY FULL!"
        end
    end
    return nil
end

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui")
        local remote = ReplicatedStorage.Shared:WaitForChild("Events"):WaitForChild("StashAction") :: RemoteFunction
        local gui = Instance.new("ScreenGui")
        gui.Name = "StashActions"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 15
        gui.Enabled = false
        local panel = Instance.new("Frame")
        panel.Name = "Actions"
        panel.AnchorPoint = Vector2.new(0.5, 1)
        -- Center lane avoids the right-hand Jump, Throw and Sprint controls.
        panel.Position = UDim2.fromScale(0.5, 0.72)
        panel.Size = UDim2.fromOffset(284, 112)
        panel.BackgroundTransparency = 1
        panel.Parent = gui
        local title = Instance.new("TextLabel")
        title.Name = "Count"
        title.Size = UDim2.fromOffset(284, 28)
        title.BackgroundTransparency = 1
        Style.Apply(title, 22)
        title.Parent = panel
        local feedback = Instance.new("TextLabel")
        feedback.Name = "Feedback"
        feedback.Position = UDim2.fromOffset(0, 88)
        feedback.Size = UDim2.fromOffset(284, 24)
        feedback.BackgroundTransparency = 1
        Style.Apply(feedback, 18)
        feedback.TextColor3 = Style.Gold
        feedback.Text = ""
        feedback.Parent = panel
        local buttons: { [string]: TextButton } = {}
        local scales: { [string]: UIScale } = {}
        local icons: { [string]: ImageLabel } = {}
        for i, action in { "STORE", "TAKE" } do
            local button = Instance.new("TextButton")
            button.Name = action
            button.Position = UDim2.fromOffset((i - 1) * 146, 30)
            button.Size = UDim2.fromOffset(138, 56)
            button.BackgroundColor3 = Style.Dark
            button.BackgroundTransparency = 0.12
            button.AutoButtonColor = false
            button.Selectable = true
            Style.Apply(button, 20)
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 12)
            corner.Parent = button
            local scale = Instance.new("UIScale")
            scale.Parent = button
            local icon = Instance.new("ImageLabel")
            icon.Name = "InputIcon"
            icon.Position = UDim2.fromOffset(12, 16)
            icon.Size = UDim2.fromOffset(24, 24)
            icon.BackgroundTransparency = 1
            icon.Visible = false
            icon.Parent = button
            icons[action] = icon
            scales[action] = scale
            button.Parent = panel
            buttons[action] = button
        end
        buttons.STORE.NextSelectionRight = buttons.TAKE
        buttons.STORE.NextSelectionLeft = buttons.TAKE
        buttons.TAKE.NextSelectionLeft = buttons.STORE
        buttons.TAKE.NextSelectionRight = buttons.STORE
        gui.Parent = playerGui
        local focusHighlight = Instance.new("Highlight")
        focusHighlight.Name = "StashFocus"
        focusHighlight.FillTransparency = 1
        focusHighlight.OutlineColor = Style.Gold
        focusHighlight.OutlineTransparency = 0.2
        focusHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
        focusHighlight.Enabled = false
        focusHighlight.Parent = workspace
        local focused: ProximityPrompt? = nil
        local pending = false
        local requestId = 0
        local feedbackUntil = 0
        local inputType = Enum.ProximityPromptInputType.Keyboard
        local previousSelection: GuiObject? = nil
        local function ownsSelection(): boolean
            return GuiService.SelectedObject == buttons.STORE or GuiService.SelectedObject == buttons.TAKE
        end
        local function hide()
            focused = nil
            focusHighlight.Enabled = false
            focusHighlight.Adornee = nil
            gui.Enabled = false
            ContextActionService:UnbindAction("StashTAKE")
            if ownsSelection() then
                GuiService.SelectedObject = if previousSelection and previousSelection.Parent
                    then previousSelection
                    else nil
            end
            previousSelection = nil
        end
        local function message(text: string)
            feedback.Text = text
            feedbackUntil = os.clock() + 1.3
        end
        local function refresh()
            local prompt = focused
            local slot = if prompt then prompt.Parent else nil
            if not prompt or not slot then
                return
            end
            title.Text = string.format(
                "STASH %d/%d",
                tonumber(slot:GetAttribute("StashCount")) or 0,
                tonumber(slot:GetAttribute("StashCapacity")) or 3
            )
            for _, action in { "STORE", "TAKE" } do
                local unavailable = Controller.Unavailable(player, slot, action)
                local button = buttons[action]
                button.TextColor3 = if pending or unavailable then Color3.fromRGB(140, 145, 155) else Style.White
                local hint = if inputType == Enum.ProximityPromptInputType.Touch
                    then ""
                    elseif inputType == Enum.ProximityPromptInputType.Gamepad then "[" .. (if action
                            == "STORE"
                        then "X"
                        else "Y") .. "] "
                    else "[" .. (if action == "STORE" then "E" else "R") .. "] "
                local icon = icons[action]
                icon.Visible = inputType == Enum.ProximityPromptInputType.Gamepad
                if icon.Visible then
                    icon.Image = UserInputService:GetImageForKeyCode(
                        if action == "STORE" then Enum.KeyCode.ButtonX else Enum.KeyCode.ButtonY
                    )
                    icon.ImageColor3 = button.TextColor3
                    hint = ""
                end
                button.Text = hint .. action
            end
            if os.clock() >= feedbackUntil then
                feedback.Text = ""
            end
        end
        local function press(action: string)
            local prompt = focused
            if not prompt or not prompt.Parent or pending then
                return
            end
            -- Animation is local; counts and carried items are never predicted.
            scales[action].Scale = 0.94
            task.delay(0.08, function()
                scales[action].Scale = 1
            end)
            local reason = Controller.Unavailable(player, prompt.Parent, action)
            if reason then
                message(reason)
                return
            end
            pending = true
            requestId += 1
            local context = {
                PlotSessionId = player:GetAttribute("PlotSessionId"),
                MembershipRevision = player:GetAttribute("PlotMembershipRevision"),
                TargetSessionId = prompt.Parent:GetAttribute("StashSessionId"),
                RequestId = requestId,
            }
            refresh()
            task.spawn(function()
                local ok, success, rejection = pcall(function()
                    return remote:InvokeServer(prompt, action, context)
                end)
                pending = false
                if focused == prompt then
                    if not ok or not success then
                        message(if ok and type(rejection) == "string" then rejection else "UNAVAILABLE!")
                    end
                    refresh()
                end
            end)
        end
        for _, action in { "STORE", "TAKE" } do
            buttons[action].Activated:Connect(function()
                press(action)
            end)
        end
        ProximityPromptService.PromptShown:Connect(function(prompt, shownInput)
            if prompt:GetAttribute("PlayerStashPrompt") ~= true then
                hide()
                return
            end
            hide()
            focused = prompt
            focusHighlight.Adornee = prompt.Parent
            focusHighlight.Enabled = true
            inputType = shownInput
            gui.Enabled = true
            feedback.Text = ""
            feedbackUntil = 0
            previousSelection = GuiService.SelectedObject
            if inputType == Enum.ProximityPromptInputType.Gamepad then
                GuiService.SelectedObject = buttons.STORE
            end
            ContextActionService:BindAction("StashTAKE", function(_, state)
                if UserInputService:GetFocusedTextBox() or GuiService.MenuIsOpen then
                    return Enum.ContextActionResult.Pass
                end
                if state == Enum.UserInputState.Begin then
                    press("TAKE")
                end
                return Enum.ContextActionResult.Sink
            end, false, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
            refresh()
        end)
        -- E / ButtonX already belong to the native focus prompt. Route its activation
        -- to explicit STORE rather than competing for the same input with CAS.
        ProximityPromptService.PromptTriggered:Connect(function(prompt, actor)
            if
                prompt == focused
                and actor == player
                and not UserInputService:GetFocusedTextBox()
                and not GuiService.MenuIsOpen
            then
                press("STORE")
            end
        end)
        ProximityPromptService.PromptHidden:Connect(function(prompt)
            if focused == prompt then
                hide()
            end
        end)
        UserInputService.LastInputTypeChanged:Connect(function(last)
            inputType = if last == Enum.UserInputType.Touch
                then Enum.ProximityPromptInputType.Touch
                elseif string.find(last.Name, "Gamepad") then Enum.ProximityPromptInputType.Gamepad
                else Enum.ProximityPromptInputType.Keyboard
            if focused and inputType == Enum.ProximityPromptInputType.Gamepad and not ownsSelection() then
                previousSelection = GuiService.SelectedObject
                GuiService.SelectedObject = buttons.STORE
            elseif inputType ~= Enum.ProximityPromptInputType.Gamepad and ownsSelection() then
                GuiService.SelectedObject = nil
            end
            refresh()
        end)
        RunService.Heartbeat:Connect(function()
            local prompt = focused
            if not prompt then
                return
            end
            local slot = prompt.Parent
            local character = player.Character
            local rootPart = if character then character:FindFirstChild("HumanoidRootPart") else nil
            local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
            if
                not slot
                or not slot:IsA("BasePart")
                or not prompt.Enabled
                or not prompt:IsDescendantOf(workspace)
                or not rootPart
                or not rootPart:IsA("BasePart")
                or not humanoid
                or humanoid.Health <= 0
                or (rootPart.Position - slot.Position).Magnitude > Economy.InteractionDistance
                or not player:GetAttribute("PlotSessionId")
            then
                hide()
                return
            end
            refresh()
        end)
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="846">
            <Properties>
              <string name="Name">TurbineCameraController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Controller = {}
local DURATION = 0.3
local BEFORE_CAMERA = "TurbineCameraPrepare"
local AFTER_CAMERA = "TurbineCameraRender"
local cleanup: (() -> ())? = nil
local releaseCamera: (() -> ())? = nil
local suspended = false

function Controller.SetSuspended(value: boolean): boolean
    local previous = suspended
    suspended = value
    return previous
end

function Controller.ReleaseCamera()
    if releaseCamera then
        releaseCamera()
    end
end

type View = {
    Camera: Camera,
    Root: BasePart,
    Humanoid: Humanoid,
    Zone: BasePart,
    Target: BasePart,
    Leaving: boolean,
    Elapsed: number,
    From: CFrame,
    FromFocus: CFrame,
    Normal: CFrame,
    NormalFocus: CFrame,
    RootPosition: Vector3,
    VisibilityReset: boolean,
}

local function inside(zone: BasePart, position: Vector3): boolean
    local point = zone.CFrame:PointToObjectSpace(position)
    local half = zone.Size * 0.5
    return math.abs(point.X) <= half.X and math.abs(point.Y) <= half.Y and math.abs(point.Z) <= half.Z
end

local function makeCharacterLocallyVisible(character: Model)
    for _, descendant in character:GetDescendants() do
        if descendant:IsA("BasePart") then
            descendant.LocalTransparencyModifier = 0
        end
    end
end

function Controller.Destroy()
    if cleanup then
        cleanup()
        cleanup = nil
    end
end

function Controller.Init()
    if cleanup then
        return
    end
    local player = Players.LocalPlayer
    local plot: Instance? = nil
    local view: View? = nil
    local removingCharacter: Model? = nil
    local connections: { RBXScriptConnection } = {}
    local plots: { [Instance]: { RBXScriptConnection } } = {}

    local function humanoid(): Humanoid?
        local character = player.Character
        return if character then character:FindFirstChildOfClass("Humanoid") else nil
    end

    local function restore()
        if suspended then
            return
        end
        local current = view
        if not current then
            return
        end
        view = nil
        current.Camera.CameraType = Enum.CameraType.Custom
        current.Camera.CameraSubject = humanoid()
        current.Camera.CFrame = current.Normal
        current.Camera.Focus = current.NormalFocus
    end

    releaseCamera = restore

    local function resolvePlot()
        local assigned: Instance? = nil
        local session = player:GetAttribute("PlotSessionId")
        if type(session) == "string" then
            for candidate in plots do
                if candidate:IsDescendantOf(workspace) and candidate:GetAttribute("PlotSessionId") == session then
                    assigned = candidate
                    break
                end
            end
        end
        if assigned ~= plot then
            restore()
            plot = assigned
        end
    end

    local function track(candidate: Instance)
        if plots[candidate] then
            return
        end
        plots[candidate] = {
            candidate:GetAttributeChangedSignal("PlotSessionId"):Connect(resolvePlot),
            candidate.AncestryChanged:Connect(resolvePlot),
        }
        resolvePlot()
    end

    table.insert(connections, CollectionService:GetInstanceAddedSignal("PlayerPlot"):Connect(track))
    table.insert(
        connections,
        CollectionService:GetInstanceRemovedSignal("PlayerPlot"):Connect(function(candidate)
            local listeners = plots[candidate]
            if listeners then
                for _, connection in listeners do
                    connection:Disconnect()
                end
                plots[candidate] = nil
            end
            resolvePlot()
        end)
    )
    table.insert(
        connections,
        player:GetAttributeChangedSignal("PlotSessionId"):Connect(function()
            restore()
            resolvePlot()
        end)
    )
    table.insert(
        connections,
        player.CharacterRemoving:Connect(function(character)
            removingCharacter = character
            restore()
        end)
    )
    table.insert(
        connections,
        workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            if suspended then
                return
            end
            if view then
                restore()
                local camera = workspace.CurrentCamera
                if camera then
                    camera.CameraType = Enum.CameraType.Custom
                    camera.CameraSubject = humanoid()
                end
            end
        end)
    )
    for _, candidate in CollectionService:GetTagged("PlayerPlot") do
        track(candidate)
    end

    -- Before Roblox's camera update, restore its unblended view during the exit.
    -- Otherwise our rendered interpolation would feed back into its next update.
    RunService:BindToRenderStep(BEFORE_CAMERA, Enum.RenderPriority.Camera.Value - 1, function()
        if suspended then
            return
        end
        local character = player.Character
        local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
        local subject = humanoid()
        local camera = workspace.CurrentCamera
        if camera and camera:GetAttribute("StandNameEditorActive") then
            return
        end
        local assigned = plot
        local blender = if assigned and assigned:IsDescendantOf(workspace)
            then assigned:FindFirstChild("Blender")
            else nil
        -- Only three direct lookups on the cached plot; also handles streamed/replaced parts.
        local zone = if blender then blender:FindFirstChild("TurbineCameraZone") else nil
        local target = if blender then blender:FindFirstChild("TurbineCamera") else nil
        if
            not character
            or character == removingCharacter
            or not character:IsDescendantOf(workspace)
            or not root
            or not root:IsA("BasePart")
            or not subject
            or subject.Health <= 0
            or not camera
            or not camera:IsDescendantOf(workspace)
            or not zone
            or not zone:IsA("BasePart")
            or not target
            or not target:IsA("BasePart")
        then
            restore()
            return
        end

        local current = view
        if
            current
            and (
                current.Camera ~= camera
                or current.Root ~= root
                or current.Humanoid ~= subject
                or current.Zone ~= zone
                or current.Target ~= target
            )
        then
            restore()
            return
        end

        if inside(zone, root.Position) then
            if not current then
                current = {
                    Camera = camera,
                    Root = root,
                    Humanoid = subject,
                    Zone = zone,
                    Target = target,
                    Leaving = false,
                    Elapsed = 0,
                    From = camera.CFrame,
                    FromFocus = camera.Focus,
                    Normal = camera.CFrame,
                    NormalFocus = camera.Focus,
                    RootPosition = root.Position,
                    VisibilityReset = false,
                }
                view = current
            elseif current.Leaving then
                current.Leaving = false
                current.Elapsed = 0
                current.From = camera.CFrame
                current.FromFocus = camera.Focus
                current.RootPosition = root.Position
                current.VisibilityReset = false
            end
            camera.CameraType = Enum.CameraType.Scriptable
        elseif current and not current.Leaving then
            current.Leaving = true
            current.Elapsed = 0
            current.From = camera.CFrame
            current.FromFocus = camera.Focus
            local displacement = root.Position - current.RootPosition
            current.Normal += displacement
            current.NormalFocus += displacement
            camera.CameraSubject = subject
            camera.CameraType = Enum.CameraType.Custom
        end
        if current and current.Leaving then
            camera.CFrame = current.Normal
            camera.Focus = current.NormalFocus
        end
    end)

    RunService:BindToRenderStep(AFTER_CAMERA, Enum.RenderPriority.Camera.Value + 1, function(dt)
        if suspended then
            return
        end
        local current = view
        if not current then
            return
        end
        if workspace.CurrentCamera ~= current.Camera then
            restore()
            return
        end
        current.Elapsed = math.min(current.Elapsed + dt, DURATION)
        local t = current.Elapsed / DURATION
        local alpha = t * t * (3 - 2 * t)
        local camera = current.Camera
        if current.Leaving then
            -- Sample Roblox's live result, including zoom, orbit and collision handling.
            current.Normal = camera.CFrame
            current.NormalFocus = camera.Focus
            camera.CFrame = current.From:Lerp(current.Normal, alpha)
            camera.Focus = current.FromFocus:Lerp(current.NormalFocus, alpha)
            if t == 1 then
                view = nil
            end
        else
            camera.CFrame = current.From:Lerp(current.Target.CFrame, alpha)
            camera.Focus = current.FromFocus:Lerp(CFrame.new(current.Root.Position), alpha)
            if not current.VisibilityReset then
                current.VisibilityReset = true
                local character = player.Character
                if character then
                    makeCharacterLocallyVisible(character)
                    task.defer(function()
                        if view == current and not current.Leaving and player.Character == character then
                            makeCharacterLocallyVisible(character)
                        end
                    end)
                end
            end
        end
    end)

    cleanup = function()
        RunService:UnbindFromRenderStep(BEFORE_CAMERA)
        RunService:UnbindFromRenderStep(AFTER_CAMERA)
        for _, connection in connections do
            connection:Disconnect()
        end
        for _, listeners in plots do
            for _, connection in listeners do
                connection:Disconnect()
            end
        end
        restore()
    end
    table.insert(connections, script.Destroying:Connect(Controller.Destroy))
end

return Controller
]]></string>
            </Properties>
