services.ProximityPromptService = { PromptShown = signal(), PromptHidden = signal() }
services.RunService.Heartbeat = signal()
local p = instance("Player")
services.Players.LocalPlayer = p
p:SetAttribute("PlotSessionId", "home")
p:SetAttribute("CarryCapacity", 3)
p:SetAttribute("CarryCount", 0)
local slot = instance("Part")
slot:SetAttribute("StashSessionId", "away")
slot:SetAttribute("StashIngredientId", "Banana")
slot:SetAttribute("StashItemType", "Ingredient")
slot:SetAttribute("StashCount", 2)
slot:SetAttribute("StashCapacity", 3)
local prompt = instance("ProximityPrompt")
prompt.Parent = slot
prompt:SetAttribute("PlayerStashPrompt", true)
loadModule("StashPromptController").Init()
services.ProximityPromptService.PromptShown:Fire(prompt)
local function expect(label, message)
    services.RunService.Heartbeat:Fire(0.1)
    check(prompt.ActionText == label, message)
end
expect("TAKE", "enemy exposed slot shows TAKE")
p:SetAttribute("HeldIngredientId", "Milk")
p:SetAttribute("HeldItemType", "Ingredient")
expect("TAKE", "carried item never changes enemy prompt to STORE")
slot:SetAttribute("StashProtected", true)
expect("TAKE", "protected slot keeps concise take label")
slot:SetAttribute("StashProtected", false)
slot:SetAttribute("StashRaidEndsAt", now + 6)
slot:SetAttribute("StashProtectionEndsAt", now + 36)
expect("TAKE", "raid keeps take label")
now += 6
expect("TAKE", "protection keeps take label")
now += 30
expect("TAKE", "protection expiry keeps take label")
p:SetAttribute("CarryCount", 3)
expect("TAKE", "full inventory does not add status text")
p:SetAttribute("CarryCount", 1)
slot:SetAttribute("StashSessionId", "home")
expect("STORE", "teammate with held item sees STORE")
p:SetAttribute("StashDirectionSessionId", "home")
p:SetAttribute("StashDirection", "TAKE")
p:SetAttribute("StashDirectionExpiresAt", now + 1.2)
expect("TAKE", "replicated TAKE wins over held ingredient")
now += 1.2
expect("STORE", "expired friendly intent follows held item")
slot:SetAttribute("StashCount", 3)
expect("STORE", "full slot keeps concise store label")
p:SetAttribute("PlotSessionId", nil)
expect("TAKE", "unassigned player has no store direction")
