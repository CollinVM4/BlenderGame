				<BinaryString name="AttributesSerialize">AwAAAAgAAABGV19Pd25lZAMBBgAAAEZXX1NyYwYAAIC94BrUQQMAAABGV3YGAAAAAAAAPkA=</BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
