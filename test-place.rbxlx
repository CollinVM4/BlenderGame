          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">RareIngredientPresentationController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local remote = events:WaitForChild("RareIngredientSpawned")
        assert(remote:IsA("RemoteEvent"), "RareIngredientSpawned must be a RemoteEvent")
        local gui = Instance.new("ScreenGui")
        gui.Name = "RareIngredientAnnouncement"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = 20
        gui.Parent = playerGui
        local banner = Instance.new("TextLabel")
        banner.AnchorPoint = Vector2.new(0.5, 0)
        banner.Position = UDim2.fromScale(0.5, 0.12)
        banner.Size = UDim2.new(0.8, 0, 0, 64)
        banner.BackgroundColor3 = Color3.fromRGB(35, 28, 55)
        banner.BackgroundTransparency = 0.15
        banner.TextColor3 = Color3.fromRGB(255, 228, 125)
        banner.Font = Enum.Font.GothamBold
        banner.TextSize = 22
        banner.TextWrapped = true
        banner.Visible = false
        banner.Parent = gui
        local version = 0
        remote.OnClientEvent:Connect(function(payload: any)
            if
                typeof(payload) ~= "table"
                or payload.Type ~= "RareIngredientSpawned"
                or typeof(payload.DisplayName) ~= "string"
                or typeof(payload.LocationName) ~= "string"
            then
                return
            end
            version += 1
            local shown = version
            banner.Text = payload.DisplayName .. " appeared at " .. payload.LocationName .. "!"
            banner.Visible = true
            task.delay(8, function()
                if shown == version then
                    banner.Visible = false
                end
            end)
        end)
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">SprintController</string>
              <string name="Source"><![CDATA[--!strict
-- Detects sprint input (keyboard Shift) and requests sprint start/stop from the server
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local getSprintEvent = require(ReplicatedStorage.Shared.Events.SprintEvents)

local SprintController = {}
local started = false
local requested = false
local heldShift: { [Enum.KeyCode]: boolean } = {}

local function requestSprint(sprintEvent: RemoteEvent, wantsToSprint: boolean)
    if requested == wantsToSprint then
        return
    end
    requested = wantsToSprint
    sprintEvent:FireServer(wantsToSprint)
end

function SprintController.Init()
    if started then
        return
    end
    started = true
    local sprintEvent = getSprintEvent()

    UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessedEvent: boolean)
        if gameProcessedEvent then
            return
        end
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = true
            requestSprint(sprintEvent, true)
        end
    end)

    UserInputService.InputEnded:Connect(function(input: InputObject)
        if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
            heldShift[input.KeyCode] = nil
            requestSprint(sprintEvent, next(heldShift) ~= nil)
        end
    end)

    UserInputService.WindowFocusReleased:Connect(function()
        table.clear(heldShift)
        requestSprint(sprintEvent, false)
    end)

    -- TODO: mobile onscreen sprint button and console/gamepad input (e.g. thumbstick click) should
    -- also call requestSprint(sprintEvent, true/false) here once those input modalities are built

    -- Presentation reads the server-replicated StaminaCurrent/StaminaMax/IsSprinting attributes.
end

return SprintController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">StashPromptController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local RunService = game:GetService("RunService")
local Definitions = require(game:GetService("ReplicatedStorage").Shared.Constants.Ingredients)
local Controller = {}
local started = false
function Controller.Init()
    if started then
        return
    end
    started = true
    local visible: { [ProximityPrompt]: boolean } = {}
    local function label(id: string): string
        local definition = Definitions[id]
        return if definition then definition.DisplayName else id
    end
    local function update(prompt: ProximityPrompt)
        local slot = prompt.Parent
        if not slot then
            visible[prompt] = nil
            return
        end
        local player = Players.LocalPlayer
        local held = player:GetAttribute("HeldIngredientId")
        local id = slot:GetAttribute("StashIngredientId")
        local count = slot:GetAttribute("StashCount") or 0
        if slot:GetAttribute("StashOwnerUserId") ~= player.UserId then
            prompt.ActionText = "Owner only"
        elseif held then
            if count >= 5 then
                prompt.ActionText = "Slot full (5/5)"
            elseif id and id ~= held then
                prompt.ActionText = "Different ingredient"
            else
                prompt.ActionText = "Store " .. label(held) .. (if count > 0 then " (" .. count .. "/5)" else "")
            end
        elseif id and count > 0 then
            prompt.ActionText = "Take " .. label(id) .. " (" .. count .. "/5)"
        else
            prompt.ActionText = "Hold an ingredient to store"
        end
    end
    ProximityPromptService.PromptShown:Connect(function(prompt)
        if prompt:GetAttribute("PlayerStashPrompt") then
            visible[prompt] = true
            update(prompt)
        end
    end)
    ProximityPromptService.PromptHidden:Connect(function(prompt)
        visible[prompt] = nil
    end)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed < 0.1 then
            return
        end
        elapsed = 0
        for prompt in visible do
            update(prompt)
        end
    end)
end
return Controller
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[-- Handles customer speech bubbles for smoothie orders 

]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">UpgradesController</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Display = require(script.Parent.Parent.UI.UpgradeDisplay)
local Gui = require(script.Parent.Parent.UI.UpgradesGui)
local Controller = {}
local started = false

function Controller.Init()
    if started then
        return
    end
    started = true
    task.spawn(function()
        local player = Players.LocalPlayer
        local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
        local view = Gui.Create(playerGui)
        local remote: RemoteEvent? = nil
        local pending: string? = nil
        local generation = 0
        local feedback: { [string]: string } = {}
        local feedbackVersion: { [string]: number } = {}
        local serverMax: { [string]: boolean } = {}

        local function numberAttribute(name: string): number?
            local value = player:GetAttribute(name)
            return if typeof(value) == "number" then value else nil
        end
        local function rowState(track: { Id: string, Name: string, Attribute: string })
            return Display.Row(track.Id, numberAttribute(track.Id .. "Level"), numberAttribute(track.Attribute))
        end
        local function refresh()
            local cash = numberAttribute("playerCash")
            view.Cash.Text = if cash then "$ " .. tostring(cash) else "$ —"
            for _, track in Display.Tracks do
                local row = view.Rows[track.Id]
                local state = rowState(track)
                local isMax = serverMax[track.Id] or (state ~= nil and state.Max)
                local enabled = remote ~= nil and pending == nil and state ~= nil and not isMax
                row.Level.Text = if state then "Level " .. tostring(state.Level) else "Loading…"
                row.Stat.Text = if state then state.Stat else "—"
                row.Purchase.Text = if pending == track.Id
                    then "BUYING…"
                    elseif isMax then "MAX"
                    elseif feedback[track.Id] then feedback[track.Id]
                    elseif state and state.Price then "$" .. tostring(state.Price) .. " UPGRADE"
                    else "LOADING…"
                row.Purchase.Interactable = enabled
                row.Purchase.AutoButtonColor = enabled
                row.Purchase.BackgroundColor3 = if enabled
                    then Color3.fromRGB(57, 119, 83)
                    else Color3.fromRGB(66, 76, 90)
            end
        end
        local function showFeedback(id: string, message: string)
            local version = (feedbackVersion[id] or 0) + 1
            feedbackVersion[id] = version
            feedback[id] = message
            task.delay(2, function()
                if feedbackVersion[id] == version then
                    feedback[id] = nil
                    refresh()
                end
            end)
        end
        player:GetAttributeChangedSignal("playerCash"):Connect(refresh)
        for _, track in Display.Tracks do
            player:GetAttributeChangedSignal(track.Id .. "Level"):Connect(function()
                serverMax[track.Id] = nil
                refresh()
            end)
            if track.Attribute ~= track.Id .. "Level" then
                player:GetAttributeChangedSignal(track.Attribute):Connect(refresh)
            end
            view.Rows[track.Id].Purchase.Activated:Connect(function()
                local state = rowState(track)
                local request = remote
                if not request or pending or not state or state.Max or serverMax[track.Id] then
                    return
                end
                pending = track.Id
                generation += 1
                local token = generation
                refresh()
                request:FireServer("PurchaseUpgrade", track.Id)
                -- The shared server throttle can drop a request without a response.
                task.delay(5, function()
                    if generation == token and pending == track.Id then
                        pending = nil
                        showFeedback(track.Id, "PLEASE TRY AGAIN")
                        refresh()
                    end
                end)
            end)
        end
        refresh()
        local events = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Events")
        local request = events:WaitForChild("GameplayRequest")
        assert(request:IsA("RemoteEvent"), "GameplayRequest must be a RemoteEvent")
        request.OnClientEvent:Connect(function(action: any, result: any)
            if action ~= "PurchaseUpgradeResult" or type(result) ~= "table" then
                return
            end
            if result.reason == "InvalidUpgrade" then
                warn("Upgrade purchase rejected: InvalidUpgrade")
            end
            local id = result.upgradeId
            if type(id) ~= "string" or not view.Rows[id] or type(result.success) ~= "boolean" then
                return
            end
            if pending == id then
                pending = nil
                generation += 1
            end
            if result.reason == "MaxLevel" then
                serverMax[id] = true
            end
            showFeedback(id, Display.Feedback(result.success, result.reason))
            -- Response levels never replace replicated player state.
            refresh()
        end)
        remote = request
        refresh()
    end)
end

return Controller
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="60">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">ScreenGuis</string>
              <string name="Source">-- Main HUD

-- TODO: stamina bar synced to Player:GetAttribute("StaminaCurrent"/"StaminaMax"), plus an
-- onscreen sprint button for mobile/console modalities (see SprintController.luau)</string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">UpgradeDisplay</string>
              <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Upgrades = require(Shared.Constants.Upgrades)
local SprintConfig = require(Shared.Constants.SprintConfig)

local Display = {}
Display.Tracks = {
    { Id = "MovementSpeed", Name = "MOVEMENT SPEED", Attribute = "BaseWalkSpeed" },
    { Id = "SprintStamina", Name = "SPRINT STAMINA", Attribute = "StaminaMax" },
    { Id = "Jump", Name = "JUMP", Attribute = "JumpLevel" },
}
local tiers: { [string]: { { Cost: number, Value: number } } } = {
    MovementSpeed = Upgrades.MovementSpeed,
    SprintStamina = Upgrades.SprintStamina,
    Jump = Upgrades.Jump,
}

function Display.Stat(id: string, value: number): string
    if id == "SprintStamina" then
        return string.format("%.0fs", value / SprintConfig.STAMINA_DRAIN_RATE)
    end
    return tostring(value)
end

function Display.Row(
    id: string,
    level: number?,
    current: number?
): { Level: number, Stat: string, Price: number?, Max: boolean }?
    local track = tiers[id]
    if not track or level == nil or level % 1 ~= 0 or not track[level + 1] then
        return nil
    end
    if id == "Jump" then
        current = track[level + 1].Value
    end
    if current == nil then
        return nil
    end
    local nextTier = track[level + 2]
    return {
        Level = level,
        Stat = Display.Stat(id, current) .. (if nextTier then " → " .. Display.Stat(id, nextTier.Value) else ""),
        Price = if nextTier then nextTier.Cost else nil,
        Max = nextTier == nil,
    }
end

function Display.Feedback(success: boolean, reason: string?): string
    if success then
        return "UPGRADED!"
    elseif reason == "InsufficientCash" then
        return "NOT ENOUGH CASH"
    elseif reason == "MaxLevel" then
        return "MAX"
    elseif reason == "InvalidUpgrade" then
        return "UNAVAILABLE"
    end
    return "PLEASE TRY AGAIN"
end

return Display
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">UpgradesGui</string>
              <string name="Source"><![CDATA[--!strict
local Display = require(script.Parent.UpgradeDisplay)
local Gui = {}
local ink = Color3.fromRGB(245, 248, 255)
local muted = Color3.fromRGB(186, 198, 216)
local accent = Color3.fromRGB(57, 119, 83)

local function round(object: GuiObject)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = object
end

local function label(parent: Instance, name: string, text: string, size: number): TextLabel
    local result = Instance.new("TextLabel")
    result.Name = name
    result.BackgroundTransparency = 1
    result.Size = UDim2.new(1, 0, 0, size + 8)
    result.Font = Enum.Font.GothamBold
    result.TextSize = size
    result.TextColor3 = ink
    result.TextXAlignment = Enum.TextXAlignment.Left
    result.Text = text
    result.Parent = parent
    return result
end

local function button(parent: Instance, name: string, text: string): TextButton
    local result = Instance.new("TextButton")
    result.Name = name
    result.Size = UDim2.new(1, 0, 0, 36)
    result.BackgroundColor3 = accent
    result.Font = Enum.Font.GothamBold
    result.TextColor3 = ink
    result.TextSize = 14
    result.Text = text
    result.AutoButtonColor = true
    round(result)
    result.Parent = parent
    return result
end

local function stack(parent: Instance, padding: number)
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, padding)
    layout.Parent = parent
end

local function pad(parent: Instance, amount: number)
    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, amount)
    padding.PaddingBottom = UDim.new(0, amount)
    padding.PaddingLeft = UDim.new(0, amount)
    padding.PaddingRight = UDim.new(0, amount)
    padding.Parent = parent
end

function Gui.Create(playerGui: PlayerGui)
    local screen = Instance.new("ScreenGui")
    screen.Name = "UpgradesGui"
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.DisplayOrder = 10

    local hud = Instance.new("Frame")
    hud.Name = "CashHud"
    hud.AnchorPoint = Vector2.new(1, 0)
    hud.Position = UDim2.new(1, -16, 0, 12)
    hud.Size = UDim2.fromOffset(174, 96)
    hud.BackgroundColor3 = Color3.fromRGB(28, 36, 50)
    round(hud)
    pad(hud, 10)
    stack(hud, 4)
    hud.Parent = screen
    local cash = label(hud, "Cash", "$ —", 24)
    cash.TextScaled = true
    local cashTextBounds = Instance.new("UITextSizeConstraint")
    cashTextBounds.MinTextSize = 12
    cashTextBounds.MaxTextSize = 24
    cashTextBounds.Parent = cash
    cash.LayoutOrder = 1
    local toggle = button(hud, "Toggle", "UPGRADES")
    toggle.LayoutOrder = 2

    local panel = Instance.new("Frame")
    panel.Name = "Panel"
    panel.AnchorPoint = Vector2.new(1, 0)
    panel.Position = UDim2.new(1, -16, 0, 120)
    panel.Size = UDim2.new(1, -32, 1, -136)
    panel.BackgroundColor3 = Color3.fromRGB(28, 36, 50)
    panel.Visible = false
    round(panel)
    local bounds = Instance.new("UISizeConstraint")
    bounds.MaxSize = Vector2.new(352, 490)
    bounds.Parent = panel
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(83, 100, 120)
    stroke.Transparency = 0.4
    stroke.Parent = panel
    pad(panel, 12)
    panel.Parent = screen
    local title = label(panel, "Title", "UPGRADES", 22)
    title.Size = UDim2.new(1, -44, 0, 36)
    local close = button(panel, "Close", "X")
    close.AnchorPoint = Vector2.new(1, 0)
    close.Position = UDim2.fromScale(1, 0)
    close.Size = UDim2.fromOffset(36, 36)

    local list = Instance.new("ScrollingFrame")
    list.Name = "Rows"
    list.Position = UDim2.fromOffset(0, 46)
    list.Size = UDim2.new(1, 0, 1, -46)
    list.BackgroundTransparency = 1
    list.BorderSizePixel = 0
    list.ScrollBarThickness = 4
    list.ScrollingDirection = Enum.ScrollingDirection.Y
    list.AutomaticCanvasSize = Enum.AutomaticSize.Y
    list.CanvasSize = UDim2.new()
    stack(list, 10)
    list.Parent = panel
    local rows: { [string]: { Level: TextLabel, Stat: TextLabel, Purchase: TextButton } } = {}
    for index, track in Display.Tracks do
        local row = Instance.new("Frame")
        row.Name = track.Id
        row.LayoutOrder = index
        row.Size = UDim2.new(1, -8, 0, 132)
        row.BackgroundColor3 = Color3.fromRGB(41, 52, 70)
        round(row)
        pad(row, 10)
        stack(row, 2)
        row.Parent = list
        local name = label(row, "Name", track.Name, 15)
        name.LayoutOrder = 1
        local level = label(row, "Level", "Loading…", 12)
        level.TextColor3 = muted
        level.LayoutOrder = 2
        local stat = label(row, "Stat", "—", 18)
        stat.LayoutOrder = 3
        local purchase = button(row, "Purchase", "LOADING…")
        purchase.LayoutOrder = 4
        rows[track.Id] = { Level = level, Stat = stat, Purchase = purchase }
    end
    toggle.Activated:Connect(function()
        panel.Visible = not panel.Visible
    end)
    close.Activated:Connect(function()
        panel.Visible = false
    end)
    screen.Parent = playerGui
    return { Screen = screen, Cash = cash, Rows = rows }
end

return Gui
]]></string>
            </Properties>
          </Item>
        </Item>
