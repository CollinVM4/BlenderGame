        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">IngredientSpawn</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local IngredientSpawn = {}
local bound: { [Instance]: boolean } = {}

-- Both marker types share the same one-item lifecycle. The callback is output only.
function IngredientSpawn.Bind(services: any, tag: string, onSpawn: ((Instance, string) -> ())?)
    WorldUtil.BindTag(tag, function(station)
        if bound[station] then
            warn("[IngredientSpawn] Use only one spawn tag: " .. station:GetFullName())
            return nil
        end
        if not station:IsA("BasePart") then
            warn("[IngredientSpawn] Tag a BasePart: " .. station:GetFullName())
            return nil
        end
        local id = station:GetAttribute("IngredientId")
        if typeof(id) ~= "string" or not services.IngredientService.GetDefinition(id) then
            warn("[IngredientSpawn] Set a valid IngredientId: " .. station:GetFullName())
            return nil
        end
        local configuredSeconds = station:GetAttribute("RespawnSeconds")
        local seconds: number = 5
        if
            typeof(configuredSeconds) == "number"
            and configuredSeconds == configuredSeconds
            and configuredSeconds > 0
            and configuredSeconds < math.huge
        then
            seconds = configuredSeconds
        end
        local minSeconds = seconds
        local maxSeconds = seconds
        if onSpawn then
            local low = station:GetAttribute("MinRespawnSeconds")
            local high = station:GetAttribute("MaxRespawnSeconds")
            if
                typeof(low) == "number"
                and typeof(high) == "number"
                and low > 0
                and high >= low
                and high < math.huge
            then
                minSeconds = low
                maxSeconds = high
            end
        end

        bound[station] = true
        local stopped = false
        local active: Instance? = nil
        local pending: thread? = nil
        local itemConnections: { RBXScriptConnection } = {}
        local function disconnectItem()
            for _, connection in itemConnections do
                connection:Disconnect()
            end
            table.clear(itemConnections)
        end
        local function spawnItem()
            pending = nil
            if stopped or active or not station:IsDescendantOf(workspace) then
                return
            end
            local item = services.IngredientService.Spawn(
                id,
                station.CFrame * CFrame.new(0, station.Size.Y / 2 + 3, 0),
                nil,
                true
            )
            if not item then
                return
            end
            active = item
            local function removed(destroying: boolean)
                if stopped or active ~= item then
                    return
                end
                active = nil
                disconnectItem()
                -- Retire a reparented item so returning it cannot duplicate station stock.
                if not destroying then
                    item:Destroy()
                end
                pending = task.delay(minSeconds + math.random() * (maxSeconds - minSeconds), spawnItem)
            end
            table.insert(
                itemConnections,
                item.Destroying:Connect(function()
                    removed(true)
                end)
            )
            if onSpawn then
                onSpawn(station, id)
            end
            table.insert(
                itemConnections,
                item.AncestryChanged:Connect(function()
                    if not item:IsDescendantOf(workspace) then
                        removed(false)
                    end
                end)
            )
        end
        local stationConnection: RBXScriptConnection? = nil
        local function cleanup()
            if stopped then
                return
            end
            stopped = true
            bound[station] = nil
            if pending then
                task.cancel(pending)
                pending = nil
            end
            if stationConnection then
                stationConnection:Disconnect()
            end
            disconnectItem()
            local item = active
            active = nil
            if item then
                item:Destroy()
            end
        end
        stationConnection = station.Destroying:Connect(cleanup)
        spawnItem()
        return cleanup
    end)
end

function IngredientSpawn.Init(services: any)
    IngredientSpawn.Bind(services, "IngredientSpawn", nil)
end

return IngredientSpawn
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">MarketPedestal</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local MarketPedestal = {}
function MarketPedestal.Init(services: any)
    WorldUtil.BindTag("MarketPedestal", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[MarketPedestal] Requires a BasePart")
            return nil
        end
        services.MarketService.Register(part)
        return function()
            services.MarketService.Unregister(part)
        end
    end)
    local elapsed = 0
    RunService.Heartbeat:Connect(function(dt)
        elapsed += dt
        if elapsed >= 1 then
            elapsed = 0
            services.MarketService.Step()
        end
    end)
end
return MarketPedestal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Stash</string>
            <string name="Source"><![CDATA[--!strict
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local Presentation = require(script.Parent.StashPresentation)
local Stash = {}
function Stash.Init(services: any)
    WorldUtil.BindTag("PlayerStash", function(object)
        local slots: { [number]: BasePart } = {}
        local counts: { [number]: number } = {}
        for _, part in object:GetDescendants() do
            local index = part:GetAttribute("SlotIndex")
            if part:IsA("BasePart") and type(index) == "number" and index % 1 == 0 and index >= 1 and index <= 5 then
                counts[index] = (counts[index] or 0) + 1
                slots[index] = part
            end
        end
        local prompts = {}
        local connections = {}
        for index, slot in slots do
            if counts[index] ~= 1 then
                warn("[Stash] Duplicate SlotIndex: " .. index)
                slots[index] = nil
                continue
            end
            local prompt = WorldUtil.Prompt(slot, "StashPrompt", "Store ingredient")
            prompt:SetAttribute("PlayerStashPrompt", true)
            prompts[index] = prompt
            table.insert(
                connections,
                prompt.Triggered:Connect(function(player)
                    local owner = services.TycoonService.GetOwner(object)
                    if not owner then
                        return
                    end
                    local id = services.InventoryService.GetHeldIngredientId(player)
                    if id then
                        if owner == player then
                            services.InventoryService.Deposit(player, id, index)
                        end
                    else
                        services.InventoryService.Withdraw(player, index, owner)
                    end
                end)
            )
        end
        local function refresh()
            local owner = services.TycoonService.GetOwner(object)
            local snapshot = owner and services.InventoryService.GetSnapshot(owner)
            for index, slot in slots do
                local state = snapshot and snapshot.Stash[index]
                slot:SetAttribute("StashOwnerUserId", owner and owner.UserId or 0)
                Presentation.Refresh(slot, state, services.IngredientService)
                prompts[index].ObjectText = (if index <= 2 then "Protected slot " else "Slot ") .. index
                prompts[index].ActionText = if state and state.Count > 0
                    then "Take " .. state.IngredientId .. " (" .. state.Count .. "/5)"
                    else "Store ingredient"
            end
        end
        table.insert(
            connections,
            services.InventoryService.StashChanged:Connect(function()
                refresh()
            end)
        )
        -- Plot assignment and release also refresh empty fixtures for their new owner.
        local ancestor = object.Parent
        while ancestor and ancestor ~= workspace do
            table.insert(connections, ancestor:GetAttributeChangedSignal("OwnerUserId"):Connect(refresh))
            ancestor = ancestor.Parent
        end
        refresh()
        return function()
            for _, connection in connections do
                connection:Disconnect()
            end
            for _, prompt in prompts do
                prompt:Destroy()
            end
            for _, slot in slots do
                Presentation.Clear(slot)
                for _, name in { "StashOwnerUserId", "StashIngredientId", "StashCount", "StashProtected" } do
                    slot:SetAttribute(name, nil)
                end
            end
        end
    end)
end
return Stash
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">StashPresentation</string>
            <string name="Source"><![CDATA[--!strict
-- Cosmetic Instances only: never register, spawn, or consume world inventory here.
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Presentation = {}

-- DisplayScale is the item's longest bounding-box dimension relative to the
-- derived display plane's smaller dimension. HeightOffset is clearance in studs.
local DisplayScale = 0.16
local DisplayHeightOffset = 0.12
local DisplaySpacing = 1.08 -- Center-to-center spacing in item-size units.
local DisplayFifthLift = 0.65 -- Fifth item's extra height in item-size units.

-- Temporary: print geometry once for the first occupied Slot3 in Studio.
local DisplayDiagnostics = true
local DiagnosticSlotIndex = 3
local diagnosticPrinted = false

local function displaySurface(slot: BasePart)
    local axes = { slot.CFrame.RightVector, slot.CFrame.UpVector, slot.CFrame.LookVector * -1 }
    local sizes = { slot.Size.X, slot.Size.Y, slot.Size.Z }
    local names = { "X", "Y", "Z" }
    local normalIndex = 1
    for index = 2, 3 do
        if math.abs(axes[index]:Dot(Vector3.yAxis)) > math.abs(axes[normalIndex]:Dot(Vector3.yAxis)) then
            normalIndex = index
        end
    end
    local normal = axes[normalIndex]
    if normal:Dot(Vector3.yAxis) < 0 then
        normal *= -1
    end
    local widthIndex = if normalIndex == 1 then 2 else 1
    local depthIndex = 6 - normalIndex - widthIndex
    local tangent = axes[widthIndex]
    -- Complete a right-handed frame with local Y pointing out of the top face.
    -- The second tangent is the remaining slot axis, with the appropriate sign.
    local depthTangent = tangent:Cross(normal)
    local thickness = sizes[normalIndex]
    local topCenter = slot.Position + normal * (thickness / 2)
    return CFrame.fromMatrix(topCenter, tangent, normal, depthTangent),
        sizes[widthIndex],
        sizes[depthIndex],
        thickness,
        names[normalIndex]
end

-- Display-plane X/Z layouts, centered around their horizontal centroid.
local Layouts = {
    { Vector3.new(0, 0, 0) },
    { Vector3.new(-0.5, 0, 0), Vector3.new(0.5, 0, 0) },
    { Vector3.new(-0.5, 0, 1 / 3), Vector3.new(0.5, 0, 1 / 3), Vector3.new(0, 0, -2 / 3) },
    { Vector3.new(-0.5, 0, -0.5), Vector3.new(0.5, 0, -0.5), Vector3.new(-0.5, 0, 0.5), Vector3.new(0.5, 0, 0.5) },
    -- Move the four lower items forward slightly to balance the raised back item.
    {
        Vector3.new(-0.5, 0, -0.4),
        Vector3.new(0.5, 0, -0.4),
        Vector3.new(-0.5, 0, 0.6),
        Vector3.new(0.5, 0, 0.6),
        Vector3.new(0, 0, -0.4),
    },
}
function Presentation.Clear(slot: BasePart)
    local old = slot:FindFirstChild("StashDisplay")
    if old then
        old:Destroy()
    end
end
function Presentation.Refresh(slot: BasePart, state: any, ingredients: any)
    Presentation.Clear(slot)
    slot:SetAttribute("StashIngredientId", state and state.IngredientId)
    slot:SetAttribute("StashCount", state and state.Count or 0)
    slot:SetAttribute("StashProtected", state and state.Protected or slot:GetAttribute("SlotIndex") <= 2)
    if not state or not state.IngredientId or state.Count == 0 then
        return
    end
    local folder = Instance.new("Folder")
    folder.Name = "StashDisplay"
    folder.Parent = slot
    local surface, width, depth, thickness, normalAxis = displaySurface(slot)
    local itemSize = math.min(width, depth) * DisplayScale
    if
        DisplayDiagnostics
        and not diagnosticPrinted
        and RunService:IsStudio()
        and slot:GetAttribute("SlotIndex") == DiagnosticSlotIndex
    then
        diagnosticPrinted = true
        print(
            string.format(
                "[StashPresentation] %s Size=%s normalAxis=%s thickness=%.3f usableWidth=%.3f usableDepth=%.3f targetItemSize=%.3f topSurfaceCenter=%s",
                slot:GetFullName(),
                tostring(slot.Size),
                normalAxis,
                thickness,
                width,
                depth,
                itemSize,
                tostring(surface.Position)
            )
        )
    end
    local spacing = itemSize * DisplaySpacing
    local layout = Layouts[state.Count]
    for i = 1, state.Count do
        local proxy = ingredients.CreateVisual(state.IngredientId)
        if not proxy then
            continue
        end
        local descendants = proxy:GetDescendants()
        table.insert(descendants, proxy)
        for _, child in descendants do
            for _, tag in CollectionService:GetTags(child) do
                CollectionService:RemoveTag(child, tag)
            end
            child:SetAttribute("SlotIndex", nil)
            child:SetAttribute("WorldItemId", nil)
            child:SetAttribute("IngredientId", nil)
            child:SetAttribute("OwnerUserId", nil)
            if child:IsA("ProximityPrompt") or child:IsA("ClickDetector") or child:IsA("LuaSourceContainer") then
                child:Destroy()
            elseif child:IsA("BasePart") then
                child.PivotOffset = CFrame.new()
                child.Anchored = true
                child.CanCollide = false
                child.CanQuery = false
                child.CanTouch = false
            end
        end
        -- Remove the source pivot's translation/orientation before measuring.
        -- A fresh wrapper with no PrimaryPart gives all templates the same axes.
        local physical = proxy :: any
        physical:PivotTo(CFrame.new())
        local model = Instance.new("Model")
        model.Name = "DisplayIngredient"
        model.WorldPivot = CFrame.new()
        proxy.Parent = model
        local bounds, size = model:GetBoundingBox()
        -- Center the wrapper pivot on actual geometry, independent of authored
        -- pivots. Uniform scaling can enlarge small templates as well as shrink.
        model.WorldPivot = bounds
        model:ScaleTo(itemSize / math.max(size.X, size.Y, size.Z, 0.01))
        local _, scaled = model:GetBoundingBox()
        local offset = layout[i] * spacing
        local lift = if i == 5 then itemSize * DisplayFifthLift else 0
        local target = surface * CFrame.new(offset.X, DisplayHeightOffset + scaled.Y / 2 + lift, offset.Z)
        model:PivotTo(target)
        model.Parent = folder
    end
end
return Presentation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">TurbineWheel</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local WorldUtil = require(script.Parent.Parent.Services.WorldUtil)
local AudioService = require(script.Parent.Parent.Services.AudioService)
local PhysicsService = require(script.Parent.Parent.Services.PhysicsService)
local TurbineWheel = {}
function TurbineWheel.Init(services: any)
    WorldUtil.BindTag("TurbineWheel", function(object)
        local part = WorldUtil.Part(object)
        if not part then
            warn("[TurbineWheel] Requires a blade/stem BasePart")
            return nil
        end
        -- if part:CanSetNetworkOwnership() then
        --     part:SetNetworkOwner(nil)
        -- end
        local audio = AudioService.CreateBlendGroup(part)
        audio.blendSound:Play()
        local particles = Instance.new("ParticleEmitter")
        particles.Rate = 0
        particles.Speed = NumberRange.new(5, 10)
        particles.Parent = part
        local wasComplete = false
        local heartbeat = RunService.Heartbeat:Connect(function(dt)
            local owner = services.TycoonService.GetOwner(part)
            if owner then
                services.BlendService.AddProgress(owner, part, PhysicsService.GetBlendDelta(part, dt))
            end
            local snapshot = owner and services.BlendService.GetSnapshot(owner)
            local state = snapshot and snapshot.State or "EMPTY"
            local strength = if state == "BLENDING" then PhysicsService.GetSpinStrength(part) else 0
            AudioService.UpdateBlendGroup(audio, strength)
            particles.Rate = strength * 2
            if snapshot and snapshot.Result then
                particles.Color = ColorSequence.new(snapshot.Result.Color)
            end
            if state == "COMPLETE" and not wasComplete then
                audio.dingSound:Play()
            end
            wasComplete = state == "COMPLETE"
        end)
        return function()
            heartbeat:Disconnect()
            particles:Destroy()
            for _, sound in audio do
                sound:Destroy()
            end
        end
    end)
end
return TurbineWheel
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">AudioService</string>
            <string name="Source"><![CDATA[--!strict
local AudioService = {}

local DIALOGUE_SOUND_IDS = {
    "rbxassetid://218057428",
    "rbxassetid://218057436",
    "rbxassetid://218057416",
}

function AudioService.ConstructAudioCue(parent: Instance, soundId: string, volume: number, looped: boolean?): Sound
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = volume
    sound.Looped = looped or false
    sound.RollOffMaxDistance = 50
    sound.RollOffMinDistance = 10
    sound.Parent = parent
    return sound
end

function AudioService.CreateBlendGroup(parent: Instance): { [string]: Sound }
    local blendSound = AudioService.ConstructAudioCue(parent, "rbxassetid://365965609", 0, true)
    local dingSound = AudioService.ConstructAudioCue(parent, "rbxassetid://110253665387820", 1, false)
    local pourSound = AudioService.ConstructAudioCue(parent, "rbxassetid://9114612188", 1, false)
    local notReadySound = AudioService.ConstructAudioCue(parent, "rbxassetid://90524619811521", 1, false)
    local customerServeSound = AudioService.ConstructAudioCue(parent, "rbxassetid://135165335432475", 1, false)
    -- randomize dialogue chirp
    local dialogueSoundId = DIALOGUE_SOUND_IDS[math.random(1, #DIALOGUE_SOUND_IDS)]
    local dialogueSound = AudioService.ConstructAudioCue(parent, dialogueSoundId, 1, false)

    return {
        blendSound = blendSound,
        dingSound = dingSound,
        pourSound = pourSound,
        notReadySound = notReadySound,
        customerServeSound = customerServeSound,
        dialogueSound = dialogueSound,
    }
end

-- Dynamically adjust volume based on the blades RPM / blend strength.
function AudioService.UpdateBlendGroup(group: { blendSound: Sound }, blendStrength: number)
    local targetVolume = math.clamp(blendStrength / 20, 0, 1)
    group.blendSound.Volume = targetVolume
    group.blendSound.PlaybackSpeed = 0.5 + (blendStrength / 25)
end

return AudioService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BlendService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local HttpService = game:GetService("HttpService")
local ServerStorage = game:GetService("ServerStorage")
local Economy = require(Shared.Constants.Economy)
local Recipes = require(Shared.Constants.Recipes)
local Types = require(Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local Film = require(script.Parent.FilmingUtil)
local BlendService = {}
local deps: any
local ingredientAccepted = Instance.new("BindableEvent")
local RunService = game:GetService("RunService")
local observers: { RBXScriptConnection } = {}
local nextNotificationToken = 0
local function observerCount(): number
    for index = #observers, 1, -1 do
        if not observers[index].Connected then
            table.remove(observers, index)
        end
    end
    return #observers
end
local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[BlendService] " .. message)
    end
end

-- One canonical color calculation for both the developing liquid and final cup.
local function batchColor(ids: { string }): Color3?
    if #ids == 0 then
        return nil
    end
    local sum = Vector3.zero
    for _, id in ids do
        local color = deps.IngredientService.GetDefinition(id).BlendColor
        sum += Vector3.new(color.R, color.G, color.B)
    end
    sum /= #ids
    return Color3.new(sum.X, sum.Y, sum.Z)
end

type Batch = {
    NotificationToken: number,
    State: Types.BlendState,
    Ingredients: { string },
    Progress: number,
    Result: Types.Smoothie?,
    NextProgressPresentationAt: number,
}
local batches: { [Player]: Batch } = {}
local cups: { [Player]: { Tool: Tool, Result: Types.Smoothie } } = {}

function BlendService.ObserveIngredientAccepted(callback: (Player, string, CFrame, number) -> ()): RBXScriptConnection
    local connection = ingredientAccepted.Event:Connect(function(player, id, at, index, token)
        -- BindableEvents COPY tables. Compare a scalar token, never table identity.
        local batch = batches[player]
        if batch and batch.NotificationToken == token then
            callback(player, id, at, index)
        else
            diagnostic("accepted notify skipped stale batch ingredient=" .. id)
        end
    end)
    table.insert(observers, connection)
    diagnostic("ingredient observer connected observers=" .. tostring(observerCount()))
    return connection
end

local function publish(player: Player)
    local batch = batches[player]
    player:SetAttribute("BlendColor", if batch.Result then batch.Result.Color else batchColor(batch.Ingredients))
    player:SetAttribute("BlendState", batch.State)
    player:SetAttribute("BlendProgress", batch.Progress)
    player:SetAttribute("BlendIngredientCount", #batch.Ingredients)
end
local function copyResult(result: Types.Smoothie): Types.Smoothie
    return {
        BlendId = result.BlendId,
        Ingredients = table.clone(result.Ingredients),
        Tags = table.clone(result.Tags),
        Color = result.Color,
        Discovery = result.Discovery,
    }
end
function BlendService.Init(services)
    deps = services
end
function BlendService.Reset(player: Player)
    nextNotificationToken += 1
    batches[player] = {
        NotificationToken = nextNotificationToken,
        State = "EMPTY",
        Ingredients = {},
        Progress = 0,
        Result = nil,
        NextProgressPresentationAt = 0,
    }
    publish(player)
    Film.Log("Blend", "reset")
end
function BlendService.GetSnapshot(player: Player): {
    State: Types.BlendState,
    Ingredients: { string },
    Progress: number,
    Result: Types.Smoothie?,
}?
    local batch = batches[player]
    if not batch then
        return nil
    end
    return {
        State = batch.State,
        Ingredients = table.clone(batch.Ingredients),
        Progress = batch.Progress,
        Result = if batch.Result then copyResult(batch.Result) else nil,
    }
end
function BlendService.TryInput(player: Player, object: Instance, input: BasePart): boolean
    local batch = batches[player]
    local record = deps.IngredientService.GetRecord(object)
    local part = WorldUtil.Part(object)
    if
        not batch
        or (batch.State ~= "EMPTY" and batch.State ~= "LOADING" and batch.State ~= "READY")
        or #batch.Ingredients >= Economy.MaxIngredients
        or not record
        or (record.Owner ~= nil and record.Owner ~= player)
        or (record.Owner == nil and not record.Claimable)
        or not part
        or deps.TycoonService.GetOwner(input) ~= player
        or deps.TycoonService.GetReference(player, "BlenderInput") ~= input
    then
        return false
    end
    -- Check actual overlap on the server, not only a client-influenced Touched signal.
    local overlaps = false
    for _, touching in workspace:GetPartsInPart(input) do
        if deps.IngredientService.Resolve(touching) == object then
            overlaps = true
            break
        end
    end
    if not overlaps then
        return false
    end
    local acceptedAt = part.CFrame
    local id = deps.IngredientService.Consume(object)
    if not id then
        return false
    end
    table.insert(batch.Ingredients, id)
    Film.Log("Blend", string.format("%s accepted (%d/3)", id, #batch.Ingredients))
    batch.State = if #batch.Ingredients == Economy.MaxIngredients then "READY" else "LOADING"
    publish(player)
    Film.Log("Blend", batch.State)
    diagnostic("accepted notify ingredient=" .. id .. " observers=" .. tostring(observerCount()))
    ingredientAccepted:Fire(player, id, acceptedAt, #batch.Ingredients, batch.NotificationToken)
    return true
end
function BlendService.Ready(player: Player): boolean
    local batch = batches[player]
    if not batch or #batch.Ingredients == 0 or (batch.State ~= "LOADING" and batch.State ~= "READY") then
        return false
    end
    batch.State = "READY"
    publish(player)
    Film.Log("Blend", "READY")
    return true
end
local function makeResult(ids: { string }): Types.Smoothie
    local tags = {}
    for _, id in ids do
        local definition = deps.IngredientService.GetDefinition(id)
        for _, tag in definition.Tags do
            if not table.find(tags, tag) then
                table.insert(tags, tag)
            end
        end
    end
    local sorted = table.clone(ids)
    table.sort(sorted)
    local discovery: string? = nil
    for name, recipe in Recipes do
        local combination = table.clone(recipe.Ingredients)
        table.sort(combination)
        if table.concat(sorted, "|") == table.concat(combination, "|") then
            discovery = name
            break
        end
    end
    return {
        BlendId = HttpService:GenerateGUID(false),
        Ingredients = table.clone(ids),
        Tags = tags,
        Color = batchColor(ids) :: Color3,
        Discovery = discovery,
    }
end
-- Server Heartbeat reports measured physical spin. No progress remote exists.
function BlendService.AddProgress(player: Player, wheel: BasePart, delta: number): boolean
    local batch = batches[player]
    if
        not batch
        or deps.TycoonService.GetOwner(wheel) ~= player
        or delta ~= delta
        or delta <= 0
        or delta == math.huge
    then
        return false
    end
    if batch.State == "LOADING" then
        BlendService.Ready(player)
    end
    if batch.State ~= "READY" and batch.State ~= "BLENDING" then
        return false
    end
    if batch.State == "READY" then
        batch.State = "BLENDING"
        publish(player)
        Film.Emit(player, "BlendStarted", { IngredientIds = table.clone(batch.Ingredients) })
        Film.Log("Blend", "BLENDING")
    end
    local oldProgress = batch.Progress
    batch.Progress = math.min(Economy.RequiredProgress, batch.Progress + delta)
    local now = os.clock()
    if
        batch.Progress > oldProgress
        and (now >= batch.NextProgressPresentationAt or batch.Progress >= Economy.RequiredProgress)
    then
        batch.NextProgressPresentationAt = now + 0.1
        Film.Emit(player, "BlendProgressChanged", { Progress = batch.Progress })
    end
    if math.floor(oldProgress / 10) ~= math.floor(batch.Progress / 10) then
        Film.Log("Blend", string.format("progress %.0f", batch.Progress))
    end
    if batch.Progress >= Economy.RequiredProgress then
        batch.State = "COMPLETE"
        local result = makeResult(batch.Ingredients)
        batch.Result = result
        Film.Emit(player, "BlendCompleted", {
            BlendId = result.BlendId,
            Color = result.Color,
            IngredientIds = table.clone(result.Ingredients),
            RecipeId = result.Discovery,
        })
        Film.Log(
            "Blend",
            string.format("COMPLETE color=(%.3f,%.3f,%.3f)", result.Color.R, result.Color.G, result.Color.B)
        )
        deps.PlayerDataService.IncrementStat(player, "SmoothiesMade")
        if result.Discovery then
            deps.PlayerDataService.RecordDiscovery(player, result.Discovery)
        end
    end
    publish(player)
    return true
end
function BlendService.GetCup(player: Player, requested: Instance?): Types.Smoothie?
    local cup = cups[player]
    if not cup then
        return nil
    end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if
        (requested and requested ~= cup.Tool)
        or not cup.Tool.Parent
        or (cup.Tool.Parent ~= backpack and cup.Tool.Parent ~= player.Character)
    then
        return nil
    end
    return copyResult(cup.Result)
end
function BlendService.ClearCup(player: Player)
    local cup = cups[player]
    cups[player] = nil
    if cup then
        cup.Tool:Destroy()
    end
    player:SetAttribute("HasSmoothie", false)
    player:SetAttribute("CurrentRecipeName", "")
end
function BlendService.ConsumeCup(player: Player): Types.Smoothie?
    local result = BlendService.GetCup(player)
    if result then
        BlendService.ClearCup(player)
    end
    return result
end
function BlendService.Dispense(player: Player, button: BasePart): (boolean, string?)
    local batch = batches[player]
    if not batch or batch.State ~= "COMPLETE" or not batch.Result then
        return false, "Not ready"
    end
    if
        deps.TycoonService.GetOwner(button) ~= player
        or not WorldUtil.Near(player, button, Economy.InteractionDistance)
    then
        return false, "Not your blender or too far"
    end
    if BlendService.GetCup(player) then
        return false, "Serve your existing cup first"
    end
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then
        return false, "No backpack"
    end
    BlendService.ClearCup(player)
    local template = ServerStorage:FindFirstChild("Smoothie")
    local tool: Tool
    if template and template:IsA("Tool") then
        tool = template:Clone()
    else
        tool = Instance.new("Tool")
    end
    tool.Name = "Smoothie"
    tool.CanBeDropped = false
    local handle = tool:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        local part = Instance.new("Part")
        part.Name = "Handle"
        part.Size = Vector3.new(1, 1.5, 1)
        part.Parent = tool
        handle = part
    end
    local cupHandle = handle :: BasePart
    cupHandle.Color = batch.Result.Color
    cupHandle.CanCollide = false
    cupHandle.Anchored = false
    tool:SetAttribute("CupId", HttpService:GenerateGUID(false))
    tool:SetAttribute("BlendId", batch.Result.BlendId)
    tool:SetAttribute("RecipeName", batch.Result.Discovery or "Custom Smoothie")
    tool:SetAttribute("IsFinished", true)
    cups[player] = { Tool = tool, Result = copyResult(batch.Result) }
    tool.Parent = backpack
    player:SetAttribute("HasSmoothie", true)
    player:SetAttribute("CurrentRecipeName", batch.Result.Discovery or "Custom Smoothie")
    Film.Emit(player, "SmoothieDispensed", { BlendId = batch.Result.BlendId, Color = batch.Result.Color, Cup = tool })
    Film.Log("Blend", "DISPENSED blend=" .. tostring(batch.Result.BlendId))
    batch.State = "DISPENSED"
    publish(player)
    task.defer(function()
        if batches[player] == batch then
            BlendService.Reset(player)
        end
    end)
    return true
end
function BlendService.RemovePlayer(player: Player)
    BlendService.ClearCup(player)
    batches[player] = nil
end
return require(script.Parent.StudioServices).Wrap("BlendService", BlendService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local WorldUtil = require(script.Parent.WorldUtil)
local CombatService = {}
local deps: any
local attackAt: { [Player]: number } = {}
local dropAt: { [Player]: number } = {}
local stunAt: { [Player]: number } = {}
local hands: { [Player]: Tool } = {}
function CombatService.Init(services)
    deps = services
end
function CombatService.Slap(player: Player, victim: Player): boolean
    local now = os.clock()
    local hand = hands[player]
    local target = victim.Character
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local targetRoot = target and target:FindFirstChild("HumanoidRootPart")
    local humanoid = target and target:FindFirstChildOfClass("Humanoid")
    if
        player == victim
        or not hand
        or hand.Parent ~= player.Character
        or not root
        or not root:IsA("BasePart")
        or not targetRoot
        or not targetRoot:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0
        or not WorldUtil.Near(player, targetRoot, Economy.SlapRange)
        or now < (attackAt[player] or 0)
        or now < (tonumber(player:GetAttribute("StunnedUntil")) or 0)
    then
        return false
    end
    local direction = targetRoot.Position - root.Position
    if direction.Magnitude < 0.01 or root.CFrame.LookVector:Dot(direction.Unit) < 0 then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character :: Model }
    local obstruction = workspace:Raycast(root.Position, direction, params)
    if obstruction and not obstruction.Instance:IsDescendantOf(target :: Model) then
        return false
    end
    attackAt[player] = now + Economy.SlapCooldown
    local level = Upgrades.Hand[deps.PlayerDataService.GetUpgrade(player, "Hand")]
    local handle = hand:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        handle.Size = Vector3.new(2, 2, 0.5) * level.Size
    end
    humanoid:TakeDamage(level.Damage)
    targetRoot:ApplyImpulse((direction.Unit * level.Knockback + Vector3.new(0, 8, 0)) * targetRoot.AssemblyMass)
    if now >= (stunAt[victim] or 0) then
        victim:SetAttribute("StunnedUntil", now + Economy.StunSeconds)
        stunAt[victim] = now + Economy.StunSeconds + 1
    end
    if now >= (dropAt[victim] or 0) then
        deps.InventoryService.DropOne(victim)
        dropAt[victim] = now + Economy.DropProtection
    end
    deps.PlayerDataService.IncrementStat(player, "PlayersSlapped")
    return true
end
-- Optional server-issued placeholder weapon. No arbitrary Tool name grants attack rights.
function CombatService.GrantHand(player: Player): Tool?
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then
        return nil
    end
    if hands[player] then
        hands[player]:Destroy()
    end
    local tool = Instance.new("Tool")
    tool.Name = "SlapHand"
    tool.CanBeDropped = false
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(2, 2, 0.5)
    handle.Color = Color3.fromRGB(255, 210, 140)
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool
    hands[player] = tool
    tool.Activated:Connect(function()
        local closest: Player? = nil
        local distance = Economy.SlapRange
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") then
            return
        end
        for _, victim in Players:GetPlayers() do
            local target = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart")
            if victim ~= player and target and target:IsA("BasePart") then
                local separation = (target.Position - root.Position).Magnitude
                if separation < distance then
                    distance = separation
                    closest = victim
                end
            end
        end
        if closest then
            CombatService.Slap(player, closest)
        end
    end)
    tool.Parent = backpack
    return tool
end
function CombatService.RemovePlayer(player: Player)
    if hands[player] then
        hands[player]:Destroy()
    end
    hands[player] = nil
    attackAt[player] = nil
    dropAt[player] = nil
    stunAt[player] = nil
end
return require(script.Parent.StudioServices).Wrap("CombatService", CombatService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CustomerService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local Customers = require(Shared.Constants.Customers)
local CustomerRequests = require(Shared.Constants.CustomerRequests)
local Ingredients = require(Shared.Constants.Ingredients)
local RunService = game:GetService("RunService")
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local Types = require(Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local AudioService = require(script.Parent.AudioService)
local Film = require(script.Parent.FilmingUtil)
local CustomerService = {}
local deps: any
local onServed: (Player, Types.Grade) -> ()
local canServe: (Player) -> boolean
local active: { [Player]: any } = {}
local ownedModels: { [Player]: { [Model]: boolean } } = {}
local activeTypingTasks = setmetatable({}, { __mode = "k" })

local function diagnostic(message: string)
    if RunService:IsStudio() then
        print("[CustomerService] " .. message)
    end
end

-- Pure request decision, separate from legacy grading and cosmetic reactions.
-- Read definitions from actual ingredient IDs, never cup attributes or supplied result.Tags.
function CustomerService.ValidateRequest(result: Types.Smoothie, request: CustomerRequests.Request): (boolean, string)
    if #result.Ingredients == 0 or #request.RequiredTags == 0 then
        return false, "Empty smoothie or request"
    end
    local tags: { [string]: boolean } = {}
    for _, id in result.Ingredients do
        local definition = Ingredients[id]
        if not definition then
            return false, "Unknown ingredient: " .. id
        end
        for _, tag in definition.Tags do
            tags[tag] = true
        end
    end
    for _, tag in request.RequiredTags do
        if not tags[tag] then
            return false, "Missing required tag: " .. tag
        end
    end
    return true, "Required tags matched"
end

local function assignRequest(record: any)
    local request = CustomerRequests[math.random(1, #CustomerRequests)]
    record.Request = request
    record.Preference = request.RequiredTags[1]
    record.Model:SetAttribute("Preference", record.Preference)
    record.Model:SetAttribute("RequestId", request.Id)
    diagnostic(
        string.format("assigned owner=%s request=%s", tostring(record.Model:GetAttribute("OwnerUserId")), request.Id)
    )
end

local function ensureCustomerCounterGlow(customerModel: Model): ParticleEmitter?
    local existingGlow = customerModel:FindFirstChild("CustomerCounterGlow")
    if existingGlow and existingGlow:IsA("ParticleEmitter") then
        return existingGlow
    end

    local rootPart = customerModel.PrimaryPart
        or customerModel:FindFirstChild("HumanoidRootPart")
        or customerModel:FindFirstChild("Head")
        or customerModel:FindFirstChild("Torso")

    if not rootPart then
        return nil
    end

    local counterGlow = Instance.new("ParticleEmitter")
    counterGlow.Name = "CustomerCounterGlow"
    counterGlow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    counterGlow.Rate = 0
    counterGlow.Speed = NumberRange.new(0.5, 1)
    counterGlow.Lifetime = NumberRange.new(0.4, 0.7)
    counterGlow.Color = ColorSequence.new(Color3.fromRGB(255, 224, 100))
    counterGlow.Parent = rootPart

    return counterGlow
end

local function typewriterText(textLabel: TextLabel, message: string, dialogueSound: Sound?)
    local currentToken = {}
    activeTypingTasks[textLabel] = currentToken
    local dialogueStep = 3

    if dialogueSound and dialogueSound.Parent then
        dialogueSound:Stop()
    end

    textLabel.Text = ""

    task.spawn(function()
        for index = 1, #message do
            if not textLabel.Parent or activeTypingTasks[textLabel] ~= currentToken then
                return
            end

            local character = string.sub(message, index, index)
            textLabel.Text = string.sub(message, 1, index)

            local shouldPlayDialogueSound = dialogueSound
                and dialogueSound.Parent
                and character ~= " "
                and (index % dialogueStep == 0 or index == #message)

            if shouldPlayDialogueSound and dialogueSound then
                dialogueSound.TimePosition = 0
                dialogueSound.PlaybackSpeed = math.random(90, 120) / 100

                local pitchShift: PitchShiftSoundEffect? = dialogueSound:FindFirstChildOfClass("PitchShiftSoundEffect")
                if not pitchShift then
                    local created = Instance.new("PitchShiftSoundEffect")
                    created.Parent = dialogueSound
                    pitchShift = created
                end

                (pitchShift :: PitchShiftSoundEffect).Octave = math.random(92, 108) / 100
                dialogueSound:Play()
            end

            task.wait(0.04)
        end

        if activeTypingTasks[textLabel] == currentToken then
            activeTypingTasks[textLabel] = nil
        end
    end)
end

function CustomerService.Init(services, servedCallback, servingCallback)
    deps = services
    onServed = servedCallback
    canServe = servingCallback
end

-- Grade and reaction are deliberately independent, pure decision functions.
function CustomerService.CalculateGrade(result: Types.Smoothie, preference: string): Types.Grade
    if preference == "Surprise Me" then
        local unique = {}
        for _, id in result.Ingredients do
            unique[id] = true
        end
        local count = 0
        for _ in unique do
            count += 1
        end
        return if count >= 3 then "A" elseif count == 2 then "B" else "C"
    end
    local matching = 0
    for _, id in result.Ingredients do
        if table.find(deps.IngredientService.GetDefinition(id).Tags, preference) then
            matching += 1
        end
    end
    local ratio = matching / math.max(1, #result.Ingredients)
    return if ratio >= 2 / 3 then "A" elseif ratio >= 1 / 3 then "B" elseif matching > 0 then "C" else "D"
end
function CustomerService.SelectReaction(): string
    local total = 0
    for _, reaction in Customers.Reactions do
        total += reaction.Weight
    end
    local roll = math.random() * total
    for _, reaction in Customers.Reactions do
        roll -= reaction.Weight
        if roll <= 0 then
            return reaction.Id
        end
    end
    return Customers.Reactions[1].Id
end
function CustomerService.CalculatePayout(player: Player, grade: Types.Grade): number
    local upgrade = Upgrades.Payout[deps.PlayerDataService.GetUpgrade(player, "Payout")].Value
    local multiplier = if deps.PlayerDataService.HasEntitlement(player, "DoubleCash") then 2 else 1
    return math.floor(Economy.BasePayout * Economy.GradeMultiplier[grade] * upgrade * multiplier)
end
function CustomerService.CanSpawn(player: Player): (boolean, string?)
    if active[player] then
        return false, "Customer already active"
    end
    for _, name in { "CustomerSpawn", "CustomerCounter", "CustomerExit" } do
        local marker, reason = deps.TycoonService.GetReference(player, name)
        if not marker then
            local message = "Cannot resolve "
                .. name
                .. " in "
                .. player.Name
                .. "'s plot: "
                .. (reason or "Missing marker")
            if RunService:IsStudio() then
                warn("[CustomerService] " .. message)
            end
            return false, message
        end
    end
    return true
end
-- Simple deterministic waypoint movement for the filming skeleton, not pathfinding.
local function move(record: any, destination: CFrame, finished: () -> ())
    local start: CFrame = record.Model:GetPivot()
    local duration = math.max(0.1, (start.Position - destination.Position).Magnitude / 8)
    task.spawn(function()
        local elapsed = 0
        while record.Model.Parent and elapsed < duration do
            elapsed += task.wait()
            record.Model:PivotTo(start:Lerp(destination, math.min(1, elapsed / duration)))
        end
        if record.Model.Parent then
            finished()
        end
    end)
end
function CustomerService.SpawnForPlayer(player: Player): Model?
    if not CustomerService.CanSpawn(player) then
        return nil
    end
    local spawn = deps.TycoonService.GetReference(player, "CustomerSpawn")
    local counter = deps.TycoonService.GetReference(player, "CustomerCounter")
    local exit = deps.TycoonService.GetReference(player, "CustomerExit")
    if not spawn or not counter or not exit then
        return nil
    end
    diagnostic(
        string.format(
            "route owner=%s %s -> %s -> %s",
            player.Name,
            spawn:GetFullName(),
            counter:GetFullName(),
            exit:GetFullName()
        )
    )
    local template = ServerStorage:FindFirstChild("Customer")
    local model: Model
    if template and template:IsA("Model") and WorldUtil.Part(template) then
        model = template:Clone()
    else
        model = Instance.new("Model")
        local torso = Instance.new("Part")
        torso.Name = "Torso"
        torso.Size = Vector3.new(2, 2.5, 1)
        torso.Color = Color3.fromRGB(220, 170, 110)
        torso.Parent = model
        local head = Instance.new("Part")
        head.Name = "Head"
        head.Size = Vector3.new(2, 1, 1)
        head.Position = Vector3.new(0, 2, 0)
        head.Color = Color3.fromRGB(245, 205, 170)
        head.Parent = model
        model.PrimaryPart = torso
    end
    model.Name = "CustomerNPC"
    -- This flow owns customer world-space presentation, including on cloned templates.
    for _, object in model:GetDescendants() do
        if object:IsA("BillboardGui") or object:IsA("SurfaceGui") then
            object:Destroy()
        end
    end
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
        end
    end
    model:PivotTo(spawn.CFrame)
    model.Parent = workspace
    local root = WorldUtil.Part(model) :: BasePart
    model.PrimaryPart = root
    ownedModels[player] = ownedModels[player] or {}
    ownedModels[player][model] = true
    local bubble = Instance.new("BillboardGui")
    bubble.Name = "OrderBubble"
    bubble.Size = UDim2.fromOffset(300, 80)
    bubble.AlwaysOnTop = true
    bubble.MaxDistance = 80
    local head = model:FindFirstChild("Head", true)
    bubble.Adornee = if head and head:IsA("BasePart") then head else root
    bubble.StudsOffset = Vector3.new(0, 2.5, 0)
    bubble.Parent = root
    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.BorderSizePixel = 0
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.TextStrokeTransparency = 0.25
    text.TextColor3 = Color3.new(1, 1, 1)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 24
    text.TextWrapped = true
    text.Text = ""
    text.Parent = bubble
    local audio = AudioService.CreateBlendGroup(root)
    local prompt = WorldUtil.Prompt(root, "ServePrompt", "Serve smoothie")
    prompt.Enabled = false
    local record = {
        Model = model,
        Root = root,
        Preference = "",
        Request = nil,
        Ready = false,
        Text = text,
        Bubble = bubble,
        Audio = audio,
        Prompt = prompt,
        Exit = exit.CFrame,
        ForcedReaction = nil,
    }
    active[player] = record
    model:SetAttribute("OwnerUserId", player.UserId)
    diagnostic("spawned owner=" .. player.Name)
    prompt.Triggered:Connect(function(actor)
        if actor == player then
            CustomerService.Serve(actor)
        end
    end)
    model.Destroying:Connect(function()
        activeTypingTasks[text] = nil
        if ownedModels[player] then
            ownedModels[player][model] = nil
        end
        if active[player] == record then
            active[player] = nil
        end
    end)
    move(record, counter.CFrame, function()
        if active[player] == record then
            assignRequest(record)
            typewriterText(text, record.Request.DisplayText, audio.dialogueSound)
            record.Ready = true
            prompt.Enabled = true
        end
    end)
    return model
end
function CustomerService.GetSnapshot(
    player: Player
): { Preference: string, RequestId: string?, Ready: boolean, Model: Model }?
    local record = active[player]
    if not record then
        return nil
    end
    return {
        Preference = record.Preference,
        RequestId = if record.Request then record.Request.Id else nil,
        Ready = record.Ready,
        Model = record.Model,
    }
end
function CustomerService.Serve(player: Player): (boolean, string?)
    local record = active[player]
    if
        not record
        or not record.Ready
        or not record.Request
        or not canServe(player)
        or not WorldUtil.Near(player, record.Root, Economy.InteractionDistance)
    then
        diagnostic("serve rejected owner=" .. player.Name .. " reason=No customer ready nearby")
        return false, "No customer ready nearby"
    end
    local result = deps.BlendService.ConsumeCup(player)
    if not result then
        diagnostic("serve rejected owner=" .. player.Name .. " reason=No valid cup")
        record.Audio.notReadySound:Play()
        return false, "No valid cup"
    end
    -- No yield between consumption, payout, and removal from active state.
    record.Ready = false
    record.Prompt.Enabled = false
    active[player] = nil
    local success, reason = CustomerService.ValidateRequest(result, record.Request)
    local grade: Types.Grade = if success then "A" else "D"
    local reaction = record.ForcedReaction or (if success then "Smile" else "Disgust")
    local payout = if success then record.Request.BasePayout else 0
    if success then
        deps.PlayerDataService.AddCash(player, payout)
    end
    diagnostic(
        string.format(
            "served owner=%s request=%s blend=%s ingredients=[%s] success=%s reason=%s payout=%d cash=%d",
            player.Name,
            record.Request.Id,
            tostring(result.BlendId),
            table.concat(result.Ingredients, ", "),
            tostring(success),
            reason,
            payout,
            deps.PlayerDataService.GetCash(player)
        )
    )
    deps.PlayerDataService.IncrementStat(player, "CustomersServed")
    player:SetAttribute("CustomerSatisfaction", grade)
    player:SetAttribute("CustomerReaction", reaction)
    record.Model:SetAttribute("Reaction", reaction)
    record.Model:SetAttribute("Grade", grade)
    record.Model:SetAttribute("OrderSucceeded", success)
    record.Model:SetAttribute("RequestId", nil)
    record.Request = nil
    Film.Emit(
        player,
        "CustomerReaction",
        { BlendId = result.BlendId, Customer = record.Model, ReactionId = reaction, Grade = grade, Payout = payout }
    )
    Film.Log(
        "Customer",
        string.format(
            "served blend=%s grade=%s reaction=%s payout=%d",
            tostring(result.BlendId),
            grade,
            reaction,
            payout
        )
    )
    -- The order presentation ends with the transaction; reactions remain in audio/VFX/attributes.
    activeTypingTasks[record.Text] = nil
    record.Bubble:Destroy()
    local glow = ensureCustomerCounterGlow(record.Model)
    if glow and success then
        glow:Emit(20)
    end
    if success then
        record.Audio.customerServeSound:Play()
    else
        record.Audio.notReadySound:Play()
    end
    Debris:AddItem(record.Model, 15)
    task.delay(2, function()
        if record.Model.Parent then
            move(record, record.Exit, function()
                record.Model:Destroy()
            end)
        end
    end)
    onServed(player, grade)
    return true
end
-- Only DevContentService exposes this through its Studio gate; no remote.
function CustomerService.SetForcedReaction(player: Player, reaction: string?): boolean
    if not active[player] then
        return false
    end
    if reaction then
        local valid = false
        for _, definition in Customers.Reactions do
            if definition.Id == reaction then
                valid = true
            end
        end
        if not valid then
            return false
        end
    end
    active[player].ForcedReaction = reaction
    return true
end
-- Legacy colon-call compatibility. Unowned auto-spawns and attribute-based cup checks were removed.
function CustomerService:CreateCustomer(_spawnTarget: any, plotOwner: Player?): Model?
    if not plotOwner then
        warn("[CustomerService] CreateCustomer now requires a plot owner")
        return nil
    end
    return CustomerService.SpawnForPlayer(plotOwner)
end
function CustomerService:ServeCheck(player: Player, item: Instance?): boolean
    return deps.BlendService.GetCup(player, item) ~= nil
end
function CustomerService:GetSatisfaction(player: Player, item: Instance?, preference: string?): string
    local result = deps.BlendService.GetCup(player, item)
    if not result then
        return "D"
    end
    return CustomerService.CalculateGrade(
        result,
        preference or (active[player] and active[player].Preference) or "Surprise Me"
    )
end
function CustomerService:RefreshOrder(model: Model)
    for _, record in active do
        if record.Model == model and record.Ready then
            assignRequest(record)
            typewriterText(record.Text, record.Request.DisplayText, record.Audio.dialogueSound)
        end
    end
end
function CustomerService.RemovePlayer(player: Player)
    local record = active[player]
    active[player] = nil
    if record then
        activeTypingTasks[record.Text] = nil
        record.Model:Destroy()
    end
    local models = ownedModels[player]
    ownedModels[player] = nil
    if models then
        for model in models do
            model:Destroy()
        end
    end
end
return require(script.Parent.StudioServices).Wrap("CustomerService", CustomerService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">DevContentService</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local DevContentService = {}
local deps: any
function DevContentService.Init(services)
    deps = services
end
function DevContentService.IsEnabled(): boolean
    return RunService:IsStudio() and ServerStorage:GetAttribute("EnableDevContent") == true
end
local function allowed(player: Player): boolean
    if not DevContentService.IsEnabled() or player.Parent ~= game:GetService("Players") then
        return false
    end
    return true
end

function DevContentService.ValidatePlot(player: Player): (boolean, { string })
    if not allowed(player) then
        return false, { "Studio and EnableDevContent=true required" }
    end
    local plot = deps.TycoonService.GetPlot(player)
    local lines: { string } = {}
    local valid = true
    local function report(role: string, ok: boolean, detail: string?)
        valid = valid and ok
        table.insert(lines, (if ok then "PASS " else "FAIL ") .. role .. (if detail then " - " .. detail else ""))
    end
    if not plot then
        report("PlayerPlot", false, "No assigned plot in Workspace")
    else
        report(
            "PlayerPlot",
            CollectionService:HasTag(plot, "PlayerPlot")
                and (plot:IsA("Model") or plot:IsA("Folder"))
                and deps.TycoonService.GetOwner(plot) == player,
            "assigned " .. plot:GetFullName()
        )
        for _, other in CollectionService:GetTagged("PlayerPlot") do
            if other ~= plot and (other:IsDescendantOf(plot) or plot:IsDescendantOf(other)) then
                report("PlayerPlot", false, "Nested plot: " .. other:GetFullName())
            end
        end
        local stash: Instance? = nil
        for _, role in
            {
                "BlenderInput",
                "TurbineWheel",
                "DispenseButton",
                "StartDayButton",
                "CustomerSpawn",
                "CustomerCounter",
                "CustomerExit",
                "PlayerStash",
            }
        do
            local fixtures = deps.TycoonService.GetFixtures(plot, role)
            if role == "CustomerSpawn" or role == "CustomerCounter" or role == "CustomerExit" then
                local marker, reason = deps.TycoonService.GetReference(player, role)
                report(
                    role,
                    marker ~= nil,
                    if marker
                        then marker:GetFullName()
                        else "Missing/invalid marker. Must resolve to a BasePart: " .. (reason or role)
                )
            elseif #fixtures == 0 then
                report(role, false, "Missing tag inside assigned plot (tags outside this plot do not count)")
            elseif #fixtures > 1 then
                local paths = {}
                for _, fixture in fixtures do
                    table.insert(paths, fixture:GetFullName())
                end
                table.sort(paths)
                report(role, false, "Duplicate tags: " .. table.concat(paths, ", "))
            else
                local fixture = fixtures[1]
                local part = deps.TycoonService.GetReference(player, role)
                if role == "BlenderInput" and not fixture:IsA("BasePart") then
                    report(role, false, "Tag the InputZone BasePart itself: " .. fixture:GetFullName())
                elseif
                    not part
                    or not part:IsA("BasePart")
                    or not part:IsDescendantOf(plot)
                    or deps.TycoonService.GetOwner(part) ~= player
                then
                    report(role, false, "Must resolve to a BasePart in the assigned plot: " .. fixture:GetFullName())
                elseif role == "BlenderInput" and not part.CanQuery then
                    report(role, false, "CanQuery must be true: " .. part:GetFullName())
                else
                    report(role, true)
                end
                if role == "PlayerStash" then
                    stash = fixture
                end
            end
        end
        local indices: { [number]: { Instance } } = {}
        if stash then
            for _, slot in stash:GetDescendants() do
                local index = slot:GetAttribute("SlotIndex")
                if index ~= nil then
                    if
                        not slot:IsA("BasePart")
                        or type(index) ~= "number"
                        or index ~= index
                        or index % 1 ~= 0
                        or index < 1
                        or index > 10
                    then
                        report(
                            "SlotIndex",
                            false,
                            slot:GetFullName() .. " must be a BasePart with integer SlotIndex 1-10"
                        )
                    else
                        indices[index] = indices[index] or {}
                        table.insert(indices[index], slot)
                    end
                end
            end
        end
        for index = 1, 10 do
            local slots = indices[index] or {}
            if index <= 5 or #slots > 0 then
                report(
                    "SlotIndex " .. index,
                    #slots == 1,
                    if #slots == 0
                        then "Missing BasePart under tagged PlayerStash"
                        elseif #slots > 1 then "Duplicate SlotIndex"
                        else nil
                )
            end
        end
    end
    print("[Plot Validation] " .. (if plot then plot.Name else player.Name))
    for _, line in lines do
        print(line)
    end
    return valid, lines
end

local function stagingFrame(player: Player): CFrame?
    -- GetReference resolves a unique tagged BasePart inside the player's assigned plot.
    local input = deps.TycoonService.GetReference(player, "BlenderInput")
    if not input then
        return nil
    end
    return input.CFrame * CFrame.new(0, 4, 0)
end
function DevContentService.ResetBlender(player: Player): boolean
    if not allowed(player) then
        return false
    end
    deps.BlendService.Reset(player)
    return true
end
function DevContentService.SpawnIngredient(player: Player, id: string): Instance?
    if not allowed(player) then
        return nil
    end
    local at = stagingFrame(player)
    if not at then
        return nil
    end
    if not deps.IngredientService.GetDefinition(id) then
        warn("[DevContentService] Unknown ingredient: " .. tostring(id))
        return nil
    end
    return deps.IngredientService.Spawn(id, at, player)
end
function DevContentService.PrepareCombination(player: Player, ids: { string }): boolean
    if not allowed(player) or #ids < 1 or #ids > Economy.MaxIngredients then
        return false
    end
    for _, id in ids do
        if not deps.IngredientService.GetDefinition(id) then
            return false
        end
    end
    local staging = stagingFrame(player)
    if not staging then
        return false
    end
    deps.InventoryService.ClearHeld(player)
    deps.IngredientService.RemovePlayer(player)
    deps.BlendService.Reset(player)
    for index, id in ids do
        local at = staging * CFrame.new((index - (#ids + 1) / 2) * 3, 0, 0)
        if not deps.IngredientService.Spawn(id, at, player) then
            deps.IngredientService.RemovePlayer(player)
            return false
        end
    end
    return true
end
function DevContentService.SpawnCustomer(player: Player): Model?
    if not allowed(player) then
        return nil
    end
    local existing = deps.CustomerService.GetSnapshot(player)
    if existing then
        return existing.Model
    end
    local ok, reason
    if deps.GameService.IsServing(player) then
        ok = deps.GameService.ResumeDay(player)
    else
        ok, reason = deps.GameService.StartDay(player)
    end
    if not ok then
        warn("[DevContentService] " .. (reason or "Customer spawn failed; check plot markers"))
        return nil
    end
    local customer = deps.CustomerService.GetSnapshot(player)
    return customer and customer.Model
end
function DevContentService.ForceReaction(player: Player, reaction: string?): boolean
    return allowed(player) and deps.CustomerService.SetForcedReaction(player, reaction)
end
function DevContentService.ResetScene(player: Player): boolean
    if not allowed(player) then
        return false
    end
    deps.InventoryService.ClearHeld(player)
    deps.GameService.Reset(player)
    deps.BlendService.Reset(player)
    deps.BlendService.ClearCup(player)
    deps.IngredientService.RemovePlayer(player)
    return true
end
local function movementAllowed(player: Player): boolean
    -- Movement-only tools are safe temporary overrides; no content-spawning opt-in needed.
    if not (RunService:IsStudio() and RunService:IsServer() and RunService:IsRunning()) then
        warn("[Movement debug] Use the SERVER Command Bar during Studio Play")
        return false
    end
    if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= game:GetService("Players") then
        warn("[Movement debug] Expected a connected Player; select a player from Players")
        return false
    end
    return true
end
local function requireMovementRuntime(method: string)
    assert(
        deps and deps.MovementService and type(deps.MovementService[method]) == "function",
        "[Movement debug] Runtime MovementService." .. method .. " is not bound; sync scripts and restart Play"
    )
    assert(
        deps.SprintService and type(deps.SprintService.ResetCharacter) == "function",
        "[Movement debug] Runtime SprintService is not bound; sync scripts and restart Play"
    )
end
local function setMovementLevel(player: Player, track: string, level: number): boolean
    if not movementAllowed(player) then
        return false
    end
    if type(level) ~= "number" or level ~= level or level < 0 or level > 3 or level ~= math.floor(level) then
        warn("[Movement debug] " .. track .. " level must be an integer from 0 to 3; received " .. tostring(level))
        return false
    end
    requireMovementRuntime("SetStudioLevel")
    deps.MovementService.SetStudioLevel(player, track, level)
    if track == "SprintStamina" then
        -- Fresh full-bar timing test; real purchases still use capacity-delta behavior.
        deps.SprintService.ResetCharacter(player)
    end
    return true
end
function DevContentService.SetMovementSpeedLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "MovementSpeed", level)
end
function DevContentService.SetSprintStaminaLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "SprintStamina", level)
end
function DevContentService.SetJumpLevel(player: Player, level: number): boolean
    return setMovementLevel(player, "Jump", level)
end
function DevContentService.ResetMovement(player: Player): boolean
    if not movementAllowed(player) then
        return false
    end
    requireMovementRuntime("ResetStudioOverrides")
    deps.MovementService.ResetStudioOverrides(player)
    deps.SprintService.ResetCharacter(player)
    return true
end
function DevContentService.PrintMovement(player: Player): string?
    if not movementAllowed(player) then
        return nil
    end
    requireMovementRuntime("GetStudioSnapshot")
    local stats, overrides = deps.MovementService.GetStudioSnapshot(player)
    local runtime = deps.SprintService.GetSnapshot(player)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local lines = { "[Movement] " .. player.Name }
    for _, track in { "MovementSpeed", "SprintStamina", "Jump" } do
        local purchased = deps.PlayerDataService.GetUpgrade(player, track) - 1
        local override = overrides[track]
        local effective = if override ~= nil then override else purchased
        table.insert(
            lines,
            string.format(
                "  %sLevel: %d (purchased: %d; Studio override: %s)",
                track,
                effective,
                purchased,
                tostring(override)
            )
        )
    end
    for _, key in { "BaseWalkSpeed", "SprintWalkSpeed", "JumpPower" } do
        table.insert(lines, "  " .. key .. " (resolved): " .. tostring(stats[key]))
    end
    for _, key in { "StaminaCurrent", "StaminaMax", "IsSprinting" } do
        table.insert(lines, "  " .. key .. ": " .. tostring(runtime[key]))
    end
    for _, key in { "WalkSpeed", "JumpPower", "JumpHeight", "UseJumpPower" } do
        table.insert(lines, "  Humanoid." .. key .. ": " .. tostring(if humanoid then (humanoid :: any)[key] else nil))
    end
    table.insert(lines, "  StunnedUntil: " .. tostring(player:GetAttribute("StunnedUntil")))
    local output = table.concat(lines, "\n")
    print(output)
    return output
end

-- Keep legacy names callable; all aliases retain the same Studio/opt-in gate.
DevContentService.ClearBlender = DevContentService.ResetBlender
DevContentService.ResetPlot = DevContentService.ResetScene
return require(script.Parent.StudioServices).Wrap("DevContentService", DevContentService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">FilmingUtil</string>
            <string name="Source"><![CDATA[--!strict
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Events = game:GetService("ReplicatedStorage").Shared.Events
local FilmingUtil = {}
local remote: RemoteEvent?

function FilmingUtil.Init()
    if remote then
        return
    end
    local existing = Events:FindFirstChild("GameplayPresentation")
    if existing then
        assert(existing:IsA("RemoteEvent"), "GameplayPresentation must be a RemoteEvent")
        remote = existing
        return
    end
    local event = Instance.new("RemoteEvent")
    event.Name = "GameplayPresentation"
    event.Parent = Events
    remote = event
end

-- Output only: no OnServerEvent listener, reward requests, or mutable service records.
function FilmingUtil.Emit(player: Player, moment: string, payload: any)
    if remote then
        remote:FireAllClients(moment, player.UserId, payload)
    end
end

function FilmingUtil.Log(scope: string, message: string)
    if RunService:IsStudio() and ServerStorage:GetAttribute("DebugFilmLoop") == true then
        print(string.format("[%s] %s", scope, message))
    end
end

return FilmingUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">GameService</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local GameService = {}
local deps: any
type Session = { State: Types.DayState, Day: number, Grades: { Types.Grade }, Grade: Types.Grade? }
local sessions: { [Player]: Session } = {}
local function publish(player: Player)
    local session = sessions[player]
    player:SetAttribute("DayState", session.State)
    player:SetAttribute("DayNumber", session.Day)
    player:SetAttribute("CustomersServedToday", #session.Grades)
    player:SetAttribute("DayGrade", session.Grade or "")
end
function GameService.Init(services)
    deps = services
end
function GameService.AddPlayer(player: Player)
    sessions[player] = { State = "PREP", Day = 0, Grades = {}, Grade = nil }
    publish(player)
end
function GameService.GetSnapshot(player: Player): Session?
    local session = sessions[player]
    if not session then
        return nil
    end
    return { State = session.State, Day = session.Day, Grades = table.clone(session.Grades), Grade = session.Grade }
end
function GameService.StartDay(player: Player): (boolean, string?)
    local session = sessions[player]
    if not session or session.State == "SERVING" then
        return false, "Day already active"
    end
    deps.TycoonService.AssignPlot(player)
    local button = deps.TycoonService.GetReference(player, "StartDayButton")
        or deps.TycoonService.GetReference(player, "CustomerCounter")
    if not WorldUtil.Near(player, button, Economy.InteractionDistance) then
        return false, "Stand at your counter / Start Day button"
    end
    local ok, reason = deps.CustomerService.CanSpawn(player)
    if not ok then
        return false, reason
    end
    local previous = sessions[player]
    sessions[player] = { State = "SERVING", Day = session.Day + 1, Grades = {}, Grade = nil }
    local customer = deps.CustomerService.SpawnForPlayer(player)
    if not customer then
        sessions[player] = previous
        return false, "Customer spawn failed"
    end
    publish(player)
    return true
end
function GameService.IsServing(player: Player): boolean
    return sessions[player] ~= nil and sessions[player].State == "SERVING"
end
function GameService.FinishDay(player: Player): boolean
    local session = sessions[player]
    if not session or session.State ~= "SERVING" or #session.Grades ~= Economy.CustomersPerDay then
        return false
    end
    local total = 0
    for _, grade in session.Grades do
        total += Economy.GradeScore[grade]
    end
    local mean = total / #session.Grades
    session.Grade = if mean >= 3.5 then "A" elseif mean >= 2.5 then "B" elseif mean >= 1.5 then "C" else "D"
    session.State = "FINISHED"
    publish(player)
    return true
end
-- Called only by the injected customer-served callback, after an authoritative cup transaction.
function GameService.CustomerServed(player: Player, grade: Types.Grade)
    local session = sessions[player]
    if not session or session.State ~= "SERVING" then
        return
    end
    table.insert(session.Grades, grade)
    if #session.Grades == Economy.CustomersPerDay then
        GameService.FinishDay(player)
    else
        publish(player)
        if not deps.CustomerService.SpawnForPlayer(player) then
            warn("[GameService] Next customer unavailable; restore markers and call ResumeDay(player).")
        end
    end
end
function GameService.ResumeDay(player: Player): boolean
    return GameService.IsServing(player) and deps.CustomerService.SpawnForPlayer(player) ~= nil
end
function GameService.Reset(player: Player)
    deps.CustomerService.RemovePlayer(player)
    GameService.AddPlayer(player)
end
function GameService.RemovePlayer(player: Player)
    sessions[player] = nil
end
return require(script.Parent.StudioServices).Wrap("GameService", GameService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">GameplayService</string>
            <string name="Source"><![CDATA[--!strict
-- Narrow request adapter for future inventory UI. No client-supplied state, positions, or awards.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameplayService = {}
local nextRequest: { [Player]: number } = {}
function GameplayService.Init(services: any)
    local remote = Instance.new("RemoteEvent")
    remote.Name = "GameplayRequest"
    remote.Parent = ReplicatedStorage.Shared.Events
    remote.OnServerEvent:Connect(function(player, action, id, slot)
        local now = os.clock()
        if now < (nextRequest[player] or 0) then
            return
        end
        nextRequest[player] = now + 0.15
        if type(action) ~= "string" or #action > 32 then
            return
        end
        local validId = type(id) == "string" and #id <= 64
        local validSlot = type(slot) == "number"
            and slot == slot
            and slot >= 1
            and slot <= 10
            and slot == math.floor(slot)
        if action == "StartDay" then
            services.GameService.StartDay(player)
        elseif action == "ReleaseIngredient" and validId then
            services.InventoryService.ReleaseUnit(player, id)
        elseif action == "Deposit" and validId and validSlot then
            services.InventoryService.Deposit(player, id, slot)
        elseif action == "Withdraw" and validSlot then
            services.InventoryService.Withdraw(player, slot)
        elseif action == "PurchaseUpgrade" then
            local success, reason = false, "InvalidUpgrade"
            if validId then
                success, reason = services.PlayerDataService.PurchaseUpgrade(player, id)
            end
            if success and (id == "MovementSpeed" or id == "Jump" or id == "SprintStamina") then
                services.MovementService.RefreshPlayer(player)
            end
            remote:FireClient(player, "PurchaseUpgradeResult", {
                success = success,
                reason = if success then "Success" else reason,
                upgradeId = if validId then id else nil,
                level = if validId and reason ~= "InvalidUpgrade"
                    then services.PlayerDataService.GetUpgrade(player, id) - 1
                    else nil,
            })
        end
    end)
end
function GameplayService.RemovePlayer(player: Player)
    nextRequest[player] = nil
end
return require(script.Parent.StudioServices).Wrap("GameplayService", GameplayService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">IngredientService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").Shared
local Definitions = require(Shared.Constants.Ingredients)
local Economy = require(Shared.Constants.Economy)
local WorldUtil = require(script.Parent.WorldUtil)
local IngredientService = {}
-- Tags/attributes are presentation metadata, never proof of ownership or validity.
local records: { [Instance]: { Id: string, Owner: Player?, Claimable: boolean } } = {}

function IngredientService.GetDefinition(id: string)
    return (Definitions :: any)[id]
end
function IngredientService.CreateVisual(id: string): Instance?
    local definition = IngredientService.GetDefinition(id)
    if not definition then
        return nil
    end
    local templates = ServerStorage:FindFirstChild("Ingredients")
    local template = templates and templates:FindFirstChild(id)
    local object: Instance
    if template and (template:IsA("Model") or template:IsA("BasePart")) and WorldUtil.Part(template) then
        object = template:Clone()
    else
        local part = Instance.new("Part")
        part.Size = Vector3.new(1.5, 1.5, 1.5)
        part.Color = definition.BlendColor
        object = part
    end
    -- Templates are geometry, not live components. Register only the new world
    -- root after its private record exists; cloned tags must not bind early.
    local descendants = object:GetDescendants()
    table.insert(descendants, object)
    for _, child in descendants do
        for _, tag in CollectionService:GetTags(child) do
            CollectionService:RemoveTag(child, tag)
        end
        if child:IsA("ProximityPrompt") or child:IsA("ClickDetector") or child:IsA("LuaSourceContainer") then
            child:Destroy()
        end
    end
    return object
end
function IngredientService.Spawn(id: string, at: CFrame, owner: Player?, claimable: boolean?): Instance?
    local object = IngredientService.CreateVisual(id)
    if not object then
        return nil
    end
    object.Name = id
    object:SetAttribute("IngredientId", id)
    object:SetAttribute("WorldItemId", HttpService:GenerateGUID(false))
    object:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
    -- An explicit pivot root avoids choosing an arbitrary leaf/stem/mesh. It also
    -- keeps a no-PrimaryPart model's authored pivot unchanged when made physical.
    if object:IsA("Model") and not object.PrimaryPart then
        local root = Instance.new("Part")
        root.Name = "IngredientRoot"
        root.Size = Vector3.new(0.1, 0.1, 0.1)
        root.Transparency = 1
        root.CanCollide = false
        root.CanTouch = false
        root.Massless = true
        root.CFrame = object:GetPivot()
        root.Parent = object
        object.PrimaryPart = root
    end
    local physical = object :: any
    physical:PivotTo(at)
    local root = WorldUtil.Part(object)
    local parts = object:GetDescendants()
    table.insert(parts, object)
    for _, part in parts do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanQuery = true
            if root and part ~= root then
                local weld = Instance.new("WeldConstraint")
                weld.Name = "IngredientAssembly"
                weld.Part0 = root
                weld.Part1 = part
                weld.Parent = part
            end
        end
    end
    object.Parent = workspace
    if root and root:CanSetNetworkOwnership() then
        root:SetNetworkOwner(nil)
    end
    records[object] = { Id = id, Owner = owner, Claimable = claimable ~= false }
    object.Destroying:Connect(function()
        records[object] = nil
    end)
    CollectionService:AddTag(object, "IngredientWorldItem")
    Debris:AddItem(object, Economy.WorldItemLifetime)
    return object
end
function IngredientService.Resolve(hit: Instance): Instance?
    local current: Instance? = hit
    while current and current ~= workspace do
        if records[current] then
            return current
        end
        current = current.Parent
    end
    return nil
end
function IngredientService.GetRecord(object: Instance): { Id: string, Owner: Player?, Claimable: boolean }?
    local record = records[object]
    if not record or not object:IsDescendantOf(workspace) then
        return nil
    end
    return table.clone(record)
end
function IngredientService.Consume(object: Instance): string?
    local record = IngredientService.GetRecord(object)
    if not record then
        return nil
    end
    records[object] = nil
    object:Destroy()
    return record.Id
end
function IngredientService.RemovePlayer(player: Player)
    local remove = {}
    for object, record in records do
        if record.Owner == player then
            table.insert(remove, object)
        end
    end
    for _, object in remove do
        IngredientService.Consume(object)
    end
end
return require(script.Parent.StudioServices).Wrap("IngredientService", IngredientService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local Upgrades = require(Shared.Constants.Upgrades)
local Types = require(Shared.Types)
local WorldUtil = require(script.Parent.WorldUtil)
local InventoryService = {}
local deps: any
local carried: { [Player]: { [string]: number? } } = {}
local stashes: { [Player]: { [number]: Types.StashSlot } } = {}
local stashChanged = Instance.new("BindableEvent")
InventoryService.StashChanged = stashChanged.Event
local releaseAt: { [Player]: number } = {}
type HeldItem = {
    Tool: Tool,
    Id: string,
    Root: BasePart,
    Releasing: boolean,
    Destroying: boolean,
    Connections: { RBXScriptConnection },
}
local held: { [Player]: HeldItem } = {}

-- Authorization for the loose-world pickup context only. Never use this owner rule
-- as a global inventory-transfer policy: stash acquisition must separately validate
-- its server-owned slot/protection state before granting a unit or held reservation.
-- No caller-supplied owner, slot attributes, or "allow stealing" flag grants rights here.
local function getLoosePickupRecord(player: Player, object: Instance)
    local record = deps.IngredientService.GetRecord(object)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not record
        or not record.Claimable
        or (record.Owner ~= nil and record.Owner ~= player)
        or not humanoid
        or humanoid.Health <= 0
        or not WorldUtil.Near(player, object, Economy.InteractionDistance)
    then
        return nil
    end
    return record
end

function InventoryService.ClearHeld(player: Player)
    local record = held[player]
    held[player] = nil
    player:SetAttribute("HeldIngredientId", nil)
    if record then
        for _, connection in record.Connections do
            connection:Disconnect()
        end
        if not record.Destroying then
            record.Tool:Destroy()
        end
    end
end

-- Spawn is synchronous. Keep the reservation until registration succeeds, and
-- block reentrant signals while restoring it. Clear before destroying the visual.
local function releaseHeld(player: Player, throwing: boolean): Instance?
    local record = held[player]
    if not record or record.Releasing then
        return nil
    end
    record.Releasing = true
    -- Retain the original character root for death/removal, even after Character changes.
    local at = record.Root.CFrame
    -- The held[player] reservation is exclusive only while carried. Both drop
    -- and throw release ownership so anyone can claim the loose world unit.
    local object = deps.IngredientService.Spawn(record.Id, at * CFrame.new(0, 2, -3), nil, true)
    if not object then
        record.Releasing = false
        return nil
    end
    InventoryService.ClearHeld(player)
    local part = WorldUtil.Part(object)
    if part and throwing then
        part.AssemblyLinearVelocity = at.LookVector * 25 + Vector3.new(0, 18, 0)
    end
    return object
end

function InventoryService.DropHeld(player: Player): Instance?
    return releaseHeld(player, false)
end

-- The equipped Tool is a reserved inventory unit. Its attributes are never read for contents.
function InventoryService.ThrowHeld(player: Player): Instance?
    local record = held[player]
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if
        not record
        or record.Tool.Parent ~= player.Character
        or not root
        or not root:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0
    then
        return nil
    end
    return releaseHeld(player, true)
end

-- Private synchronous equip path shared by loose pickup and stash withdrawal.
local function equipVisual(player: Player, id: string, visual: Instance): boolean
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if held[player] or not backpack or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
        visual:Destroy()
        return false
    end
    local tool = Instance.new("Tool")
    tool.Name = id .. " (click to throw)"
    tool.CanBeDropped = false
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(1, 1, 1)
    handle.Transparency = 1
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool
    local physical = visual :: any
    physical:PivotTo(handle.CFrame)
    local parts = visual:GetDescendants()
    table.insert(parts, visual)
    for _, part in parts do
        game:GetService("CollectionService"):RemoveTag(part, "IngredientWorldItem")
        if part:IsA("ProximityPrompt") then
            part:Destroy()
        elseif part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = false
            part.CanTouch = false
            part.Massless = true
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = handle
            weld.Part1 = part
            weld.Parent = handle
        end
    end
    visual.Parent = tool
    local reservation: HeldItem = {
        Tool = tool,
        Id = id,
        Root = root,
        Releasing = false,
        Destroying = false,
        Connections = {},
    }
    held[player] = reservation
    player:SetAttribute("HeldIngredientId", id)
    local function dropThisTool()
        -- A queued signal from an old Tool must never drop a newer reservation.
        if held[player] == reservation then
            InventoryService.DropHeld(player)
        end
    end
    table.insert(reservation.Connections, tool.Unequipped:Connect(dropThisTool))
    table.insert(reservation.Connections, humanoid.Died:Connect(dropThisTool))
    table.insert(reservation.Connections, player.CharacterRemoving:Connect(dropThisTool))
    table.insert(
        reservation.Connections,
        tool.Destroying:Connect(function()
            reservation.Destroying = true
            dropThisTool()
        end)
    )
    table.insert(
        reservation.Connections,
        tool.Activated:Connect(function()
            if held[player] == reservation then
                InventoryService.ThrowHeld(player)
            end
        end)
    )
    tool.Parent = backpack
    humanoid:EquipTool(tool)
    return true
end

function InventoryService.CarryWorldItem(player: Player, object: Instance): boolean
    local record = getLoosePickupRecord(player, object)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if
        held[player]
        or not record
        or not backpack
        or not humanoid
        or humanoid.Health <= 0
        or not root
        or not root:IsA("BasePart")
    then
        return false
    end
    -- This claim-to-reservation transaction must not yield. Consume removes the server
    -- identity before another request can claim it; only the visual is cloned for carry.
    local visual = object:Clone()
    if not InventoryService.ClaimWorldItem(player, object) then
        visual:Destroy()
        return false
    end
    InventoryService.RemoveUnit(player, record.Id)
    return equipVisual(player, record.Id, visual)
end

function InventoryService.Init(services)
    deps = services
end
function InventoryService.AddPlayer(player: Player)
    carried[player] = {}
    stashes[player] = {}
    for index = 1, 5 do
        stashes[player][index] =
            { SlotIndex = index, IngredientId = nil, Count = 0, Capacity = 5, Protected = index <= 2 }
    end
    stashChanged:Fire(player)
end
function InventoryService.GetStackCap(player: Player): number
    return Upgrades.StackSize[deps.PlayerDataService.GetUpgrade(player, "StackSize")].Value
end
function InventoryService.GetStashLayout(_player: Player)
    return { Slots = 5, Protected = 2 }
end
function InventoryService.GetHeldIngredientId(player: Player): string?
    local record = held[player]
    return if record and not record.Releasing then record.Id else nil
end
function InventoryService.GetSnapshot(player: Player)
    local stash = {}
    local source = stashes[player]
    if source then
        for index, stack in source do
            stash[index] = table.clone(stack)
        end
    end
    return {
        Carried = table.clone(carried[player] or {}),
        Stash = stash,
        Layout = InventoryService.GetStashLayout(player),
    }
end
function InventoryService.AddUnit(player: Player, id: string): boolean
    if not carried[player] or not deps.IngredientService.GetDefinition(id) then
        return false
    end
    local count = carried[player][id] or 0
    if count >= InventoryService.GetStackCap(player) then
        return false
    end
    carried[player][id] = count + 1
    return true
end
function InventoryService.RemoveUnit(player: Player, id: string): boolean
    local count = carried[player] and carried[player][id] or 0
    if count < 1 then
        return false
    end
    carried[player][id] = if count == 1 then nil else count - 1
    return true
end
function InventoryService.ClaimWorldItem(player: Player, object: Instance): boolean
    local record = getLoosePickupRecord(player, object)
    if not record then
        return false
    end
    if not InventoryService.AddUnit(player, record.Id) then
        return false
    end
    if not deps.IngredientService.Consume(object) then
        InventoryService.RemoveUnit(player, record.Id)
        return false
    end
    return true
end
-- Materialize ONE reserved unit. Caller cannot supply a spawn position or contents.
function InventoryService.ReleaseUnit(player: Player, id: string): Instance?
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local now = os.clock()
    if
        not root
        or not root:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0
        or now < (releaseAt[player] or 0)
        or not InventoryService.RemoveUnit(player, id)
    then
        return nil
    end
    releaseAt[player] = now + 0.25
    local object = deps.IngredientService.Spawn(id, root.CFrame * CFrame.new(0, 2, -3), player)
    if not object then
        InventoryService.AddUnit(player, id)
    end
    local part = WorldUtil.Part(object)
    if part then
        part.AssemblyLinearVelocity = root.CFrame.LookVector * 25 + Vector3.new(0, 18, 0)
    end
    return object
end
function InventoryService.DropOne(player: Player): Instance?
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then
        return nil
    end
    local id = next(carried[player] or {})
    if not id then
        return nil
    end
    InventoryService.RemoveUnit(player, id)
    local object = deps.IngredientService.Spawn(id, root.CFrame * CFrame.new(0, 1, -3), nil)
    if not object then
        InventoryService.AddUnit(player, id)
    end
    return object
end
-- Resolve the unique server-tagged fixture and actual slot, never a client position.
local function getSlotPart(owner: Player, index: number): BasePart?
    if type(index) ~= "number" or index ~= index or index % 1 ~= 0 or index < 1 or index > 5 then
        return nil
    end
    local plot = deps.TycoonService.GetPlot(owner)
    if not plot then
        return nil
    end
    local fixtures = deps.TycoonService.GetFixtures(plot, "PlayerStash")
    if #fixtures ~= 1 or deps.TycoonService.GetOwner(fixtures[1]) ~= owner then
        return nil
    end
    local found: BasePart? = nil
    for _, part in fixtures[1]:GetDescendants() do
        if part:IsA("BasePart") and part:GetAttribute("SlotIndex") == index then
            if found then
                return nil
            end
            found = part
        end
    end
    return found
end
local function accessible(player: Player, owner: Player, index: number): boolean
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil
        and humanoid.Health > 0
        and WorldUtil.Near(player, getSlotPart(owner, index), Economy.InteractionDistance)
end
-- Authorization seam for future stealing. Protection lives in server state even when empty.
function InventoryService.CanWithdraw(player: Player, owner: Player, index: number): boolean
    local slot = stashes[owner] and stashes[owner][index]
    if not slot then
        return false
    end
    if player == owner then
        return true
    end
    if slot.Protected then
        return false
    end
    return false -- Unprotected theft is deliberately disabled in V1.
end
-- Preserve the legacy signature; id is only a match assertion, never a grant of contents.
function InventoryService.Deposit(player: Player, id: string, index: number): boolean
    local record = held[player]
    if
        not record
        or record.Releasing
        or record.Destroying
        or record.Id ~= id
        or record.Tool.Parent ~= player.Character
        or not accessible(player, player, index)
    then
        return false
    end
    local slot = stashes[player] and stashes[player][index]
    if not slot or slot.Count >= slot.Capacity or (slot.Count > 0 and slot.IngredientId ~= record.Id) then
        return false
    end
    slot.IngredientId = record.Id
    slot.Count += 1
    InventoryService.ClearHeld(player)
    stashChanged:Fire(player)
    return true
end
function InventoryService.Withdraw(player: Player, index: number, stashOwner: Player?): boolean
    local owner = stashOwner or player
    if
        held[player]
        or not InventoryService.CanWithdraw(player, owner, index)
        or not accessible(player, owner, index)
    then
        return false
    end
    local slot = stashes[owner][index]
    local id = slot.IngredientId
    if slot.Count < 1 or not id then
        return false
    end
    local visual = deps.IngredientService.CreateVisual(id)
    if not visual then
        return false
    end
    -- No yield between reserving this unit and equipping. Failed equip restores the slot.
    slot.Count -= 1
    if slot.Count == 0 then
        slot.IngredientId = nil
    end
    if not equipVisual(player, id, visual) then
        slot.Count += 1
        slot.IngredientId = id
        return false
    end
    stashChanged:Fire(owner)
    return true
end
function InventoryService.Steal(_player: Player, _owner: Player, _index: number): boolean
    return false
end
function InventoryService.RemovePlayer(player: Player)
    InventoryService.DropHeld(player)
    InventoryService.ClearHeld(player)
    carried[player] = nil
    stashes[player] = nil
    stashChanged:Fire(player)
    releaseAt[player] = nil
end
return require(script.Parent.StudioServices).Wrap("InventoryService", InventoryService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Constants.Economy)
local WorldUtil = require(script.Parent.WorldUtil)
local MarketService = {}
local CollectionService = game:GetService("CollectionService")
local deps: any
local pedestals: { [BasePart]: { Item: Instance?, RespawnAt: number, Id: string, Seconds: number } } = {}
function MarketService.Init(services)
    deps = services
end
function MarketService.Register(pedestal: BasePart)
    if
        CollectionService:HasTag(pedestal, "IngredientSpawn")
        or CollectionService:HasTag(pedestal, "AnnouncedIngredientSpawn")
    then
        warn("[MarketService] Use only one spawn tag: " .. pedestal:GetFullName())
        return
    end
    if not pedestals[pedestal] then
        local id = pedestal:GetAttribute("IngredientId")
        if typeof(id) ~= "string" or not deps.IngredientService.GetDefinition(id) then
            warn("[MarketService] Set an explicit valid IngredientId: " .. pedestal:GetFullName())
            return
        end
        local seconds = pedestal:GetAttribute("RespawnSeconds")
        if typeof(seconds) ~= "number" or seconds ~= seconds or seconds <= 0 or seconds == math.huge then
            seconds = Economy.MarketRespawnSeconds
        end
        pedestals[pedestal] = { Item = nil, RespawnAt = 0, Id = id, Seconds = seconds :: number }
    end
end
function MarketService.Unregister(pedestal: BasePart)
    local state = pedestals[pedestal]
    pedestals[pedestal] = nil
    pedestal:SetAttribute("StockIngredientId", nil)
    if state and state.Item then
        state.Item:Destroy()
    end
end
function MarketService.Step()
    local now = os.clock()
    for pedestal, state in pedestals do
        if state.Item and not deps.IngredientService.GetRecord(state.Item) then
            -- Retire stock moved out of Workspace before allowing a replacement.
            state.Item:Destroy()
            state.Item = nil
            state.RespawnAt = now + state.Seconds
            pedestal:SetAttribute("StockIngredientId", nil)
        end
        if pedestal:IsDescendantOf(workspace) and not state.Item and now >= state.RespawnAt then
            local id = state.Id
            state.Item =
                deps.IngredientService.Spawn(id, pedestal.CFrame * CFrame.new(0, pedestal.Size.Y / 2 + 1, 0), nil, true)
            if state.Item then
                pedestal:SetAttribute("StockIngredientId", id)
            else
                state.RespawnAt = now + state.Seconds
            end
        end
    end
end
function MarketService.Claim(player: Player, pedestal: BasePart): boolean
    local state = pedestals[pedestal]
    if not state or not state.Item or not WorldUtil.Near(player, pedestal, Economy.InteractionDistance) then
        return false
    end
    if not deps.InventoryService.CarryWorldItem(player, state.Item) then
        return false
    end
    state.Item = nil
    state.RespawnAt = os.clock() + state.Seconds
    pedestal:SetAttribute("StockIngredientId", nil)
    return true
end
-- Server-only drop boundary for future ant defeat handlers.
function MarketService.SpawnDrop(at: CFrame, id: string): Instance?
    return deps.IngredientService.Spawn(id, at, nil)
end
return require(script.Parent.StudioServices).Wrap("MarketService", MarketService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">MovementService</string>
            <string name="Source"><![CDATA[--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local RunService = game:GetService("RunService")
local Upgrades = require(Shared.Constants.Upgrades)
local SprintConfig = require(Shared.Constants.SprintConfig)
local MovementService = {}
local data: any
type Stats = { BaseWalkSpeed: number, SprintWalkSpeed: number, MaxStamina: number, JumpPower: number }
local resolved: { [Player]: Stats } = {}
local overrides: { [Player]: { [string]: number? } } = {}
local changed = Instance.new("BindableEvent")
MovementService.Changed = changed.Event

function MovementService.Init(dependencies)
    data = dependencies.PlayerDataService
end

function MovementService.GetBaseWalkSpeed(player: Player): number
    return resolved[player].BaseWalkSpeed
end
function MovementService.GetSprintWalkSpeed(player: Player): number
    return resolved[player].SprintWalkSpeed
end
function MovementService.GetMaxStamina(player: Player): number
    return resolved[player].MaxStamina
end
function MovementService.GetJumpPower(player: Player): number
    return resolved[player].JumpPower
end

local function applyJump(player: Player, humanoid: Humanoid)
    local power = MovementService.GetJumpPower(player)
    if humanoid.UseJumpPower then
        humanoid.JumpPower = power
    else
        humanoid.JumpHeight = power * power / (2 * workspace.Gravity)
    end
end

function MovementService.RefreshPlayer(player: Player)
    local speedIndex = data.GetUpgrade(player, "MovementSpeed")
    local jumpIndex = data.GetUpgrade(player, "Jump")
    local staminaIndex = data.GetUpgrade(player, "SprintStamina")
    local debugLevels: { [string]: number? } = overrides[player] or {}
    local effectiveSpeed = if debugLevels.MovementSpeed ~= nil then debugLevels.MovementSpeed + 1 else speedIndex
    local effectiveJump = if debugLevels.Jump ~= nil then debugLevels.Jump + 1 else jumpIndex
    local effectiveStamina = if debugLevels.SprintStamina ~= nil then debugLevels.SprintStamina + 1 else staminaIndex
    local speed = Upgrades.MovementSpeed[effectiveSpeed].Value
    resolved[player] = {
        BaseWalkSpeed = speed,
        SprintWalkSpeed = speed * SprintConfig.SPRINT_SPEED_MULTIPLIER,
        MaxStamina = Upgrades.SprintStamina[effectiveStamina].Value,
        JumpPower = Upgrades.Jump[effectiveJump].Value,
    }
    player:SetAttribute("MovementSpeedLevel", effectiveSpeed - 1)
    player:SetAttribute("JumpLevel", effectiveJump - 1)
    player:SetAttribute("SprintStaminaLevel", effectiveStamina - 1)
    player:SetAttribute("BaseWalkSpeed", speed)
    player:SetAttribute("SprintWalkSpeed", resolved[player].SprintWalkSpeed)
    player:SetAttribute("StaminaMax", resolved[player].MaxStamina)
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    end
    changed:Fire(player)
end

-- Bootstrap owns the sole CharacterAdded connection. Never block its other resets.
function MovementService.ApplyCharacter(player: Player, character: Model)
    MovementService.RefreshPlayer(player)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        applyJump(player, humanoid)
    else
        task.spawn(function()
            local pending = character:WaitForChild("Humanoid", 5)
            if pending and pending:IsA("Humanoid") and player.Character == character and resolved[player] then
                applyJump(player, pending)
            end
        end)
    end
end

local function assertStudioServer()
    assert(RunService:IsServer() and RunService:IsStudio() and RunService:IsRunning(), "Studio Play server only")
end

function MovementService.SetStudioLevel(player: Player, track: string, level: number?)
    assertStudioServer()
    assert(track == "MovementSpeed" or track == "Jump" or track == "SprintStamina", "Invalid movement track")
    assert(
        level == nil or (type(level) == "number" and level >= 0 and level <= 3 and level == math.floor(level)),
        "Invalid displayed level; expected 0-3"
    )
    assert(resolved[player] ~= nil, "Movement player is not initialized")
    local levels = overrides[player] or {}
    levels[track] = level
    overrides[player] = levels
    if track == "Jump" then
        player:SetAttribute("StudioJumpTier", level)
    end
    MovementService.RefreshPlayer(player)
end

-- Pads and Command Bar commands share one jump override. Last setter wins.
function MovementService.SetStudioJumpTier(player: Player, tier: number?)
    assert(tier == nil or (tier >= 1 and tier <= 3 and tier == math.floor(tier)), "Invalid Studio jump tier")
    MovementService.SetStudioLevel(player, "Jump", tier)
end

function MovementService.ResetStudioOverrides(player: Player)
    assertStudioServer()
    overrides[player] = nil
    player:SetAttribute("StudioJumpTier", nil)
    MovementService.RefreshPlayer(player)
end

function MovementService.GetStudioSnapshot(player: Player)
    assertStudioServer()
    local result = table.clone(resolved[player])
    return result, table.clone(overrides[player] or {})
end

function MovementService.RemovePlayer(player: Player)
    resolved[player] = nil
    overrides[player] = nil
end
return require(script.Parent.StudioServices).Wrap("MovementService", MovementService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PhysicsService</string>
            <string name="Source"><![CDATA[--!strict
local Economy = require(game:GetService("ReplicatedStorage").Shared.Constants.Economy)
local PhysicsService = {}

function PhysicsService.GetSpinStrength(part: BasePart): number
    if not part or not part:IsA("BasePart") then
        return 0
    end

    local angularVelocity = part.AssemblyAngularVelocity
    return angularVelocity.Magnitude
end

function PhysicsService.GetBlendDelta(part: BasePart, deltaTime: number?): number
    -- Preserve the old one-argument API; dt-aware callers no longer depend on framerate.
    return PhysicsService.GetSpinStrength(part) * Economy.BlendProgressScale * (deltaTime or 1 / 60)
end

-- Display/debugging only; gameplay uses angular speed directly.
function PhysicsService.GetRPM(part: BasePart): number
    return PhysicsService.GetSpinStrength(part) * 60 / (2 * math.pi)
end

return PhysicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
local Types = require(game:GetService("ReplicatedStorage").Shared.Types)
local Upgrades = require(game:GetService("ReplicatedStorage").Shared.Constants.Upgrades)
local PlayerDataService = {}
local records: { [Player]: Types.PlayerData } = {}
local entitlements: { [Player]: { [string]: boolean } } = {}

local function data(player: Player): Types.PlayerData
    assert(records[player], "PlayerDataService: player is not initialized")
    return records[player]
end
function PlayerDataService.AddPlayer(player: Player)
    records[player] = {
        Cash = 0,
        Upgrades = {
            Hand = 1,
            StackSize = 1,
            BlendSpeed = 1,
            Payout = 1,
            MovementSpeed = 1,
            Jump = 1,
            SprintStamina = 1,
        },
        Discoveries = {},
        Stats = { CustomersServed = 0, SmoothiesMade = 0, PlayersSlapped = 0, IngredientsStolen = 0 },
    }
    entitlements[player] = { VIPStorage = false, DoubleCash = false }
    player:SetAttribute("playerCash", 0)
    player:SetAttribute("HasSmoothie", false)
    for _, id in { "MovementSpeed", "Jump", "SprintStamina" } do
        player:SetAttribute(id .. "Level", 0)
    end
end
function PlayerDataService.GetSnapshot(player: Player): Types.PlayerData
    local source = data(player)
    return {
        Cash = source.Cash,
        Upgrades = table.clone(source.Upgrades),
        Discoveries = table.clone(source.Discoveries),
        Stats = table.clone(source.Stats),
    }
end
function PlayerDataService.GetCash(player: Player): number
    return data(player).Cash
end
function PlayerDataService.SetCash(player: Player, amount: number): number
    assert(amount == amount and math.abs(amount) < math.huge and amount >= 0, "Invalid cash")
    data(player).Cash = math.floor(amount)
    player:SetAttribute("playerCash", data(player).Cash)
    return data(player).Cash
end
function PlayerDataService.AddCash(player: Player, amount: number): number
    assert(amount >= 0, "Awards cannot subtract cash")
    return PlayerDataService.SetCash(player, data(player).Cash + amount)
end
function PlayerDataService.GetUpgrade(player: Player, id: string): number
    return (data(player).Upgrades :: any)[id] or 1
end
function PlayerDataService.PurchaseUpgrade(player: Player, id: string): (boolean, string?)
    local levels = (Upgrades :: any)[id]
    if not levels then
        return false, "InvalidUpgrade"
    end
    local nextLevel = PlayerDataService.GetUpgrade(player, id) + 1
    local definition = levels[nextLevel]
    if not definition then
        return false, "MaxLevel"
    end
    if data(player).Cash < definition.Cost then
        return false, "InsufficientCash"
    end
    PlayerDataService.SetCash(player, data(player).Cash - definition.Cost)
    local ownedUpgrades = data(player).Upgrades :: any
    ownedUpgrades[id] = nextLevel
    if id == "MovementSpeed" or id == "Jump" or id == "SprintStamina" then
        player:SetAttribute(id .. "Level", nextLevel - 1)
    end
    return true
end
function PlayerDataService.HasEntitlement(player: Player, id: string): boolean
    return entitlements[player] ~= nil and entitlements[player][id] == true
end
-- Server-only boundary for a future verified MarketplaceService entitlement adapter.
function PlayerDataService.SetEntitlement(player: Player, id: string, enabled: boolean)
    assert(id == "VIPStorage" or id == "DoubleCash", "Unknown entitlement")
    entitlements[player][id] = enabled
end
function PlayerDataService.RecordDiscovery(player: Player, id: string)
    data(player).Discoveries[id] = true
end
function PlayerDataService.IncrementStat(player: Player, id: string)
    local stats = data(player).Stats :: any
    assert(stats[id] ~= nil, "Unknown stat")
    stats[id] += 1
end
function PlayerDataService.RemovePlayer(player: Player)
    -- TODO: persist a snapshot before releasing state; no DataStore writes in this skeleton.
    records[player] = nil
    entitlements[player] = nil
end
return require(script.Parent.StudioServices).Wrap("PlayerDataService", PlayerDataService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">SprintService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local SprintConfig = require(ReplicatedStorage.Shared.Constants.SprintConfig)
local getSprintEvent = require(ReplicatedStorage.Shared.Events.SprintEvents)

local SprintService = {}
local movement: any
local started = false

local staminaCurrent: { [Player]: number } = {}
local staminaMax: { [Player]: number } = {}
local isSprinting: { [Player]: boolean } = {}

local function ensurePlayer(player: Player)
    if staminaMax[player] == nil then
        staminaMax[player] = movement.GetMaxStamina(player)
    end
    if staminaCurrent[player] == nil then
        staminaCurrent[player] = staminaMax[player]
    end
    if isSprinting[player] == nil then
        isSprinting[player] = false
    end

    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
end

local function getHumanoid(player: Player): Humanoid?
    local character = player.Character
    if character == nil then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function setSprinting(player: Player, wantsToSprint: boolean)
    ensurePlayer(player)

    if wantsToSprint and staminaCurrent[player] <= 0 then
        wantsToSprint = false
    end

    local humanoid = getHumanoid(player)
    isSprinting[player] = wantsToSprint and humanoid ~= nil and humanoid.Health > 0
end

function SprintService.ApplySpeed(player: Player)
    local humanoid = getHumanoid(player)
    if humanoid then
        humanoid.WalkSpeed = if os.clock() < (tonumber(player:GetAttribute("StunnedUntil")) or 0)
            then 0
            elseif isSprinting[player] then movement.GetSprintWalkSpeed(player)
            else movement.GetBaseWalkSpeed(player)
    end
end

function SprintService.ResetCharacter(player: Player)
    ensurePlayer(player)
    isSprinting[player] = false
    staminaMax[player] = movement.GetMaxStamina(player)
    staminaCurrent[player] = staminaMax[player]
    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
    player:SetAttribute("IsSprinting", false)
    SprintService.ApplySpeed(player)
end

-- Copy authoritative runtime values for server diagnostics; never read UI attributes.
function SprintService.GetSnapshot(player: Player)
    ensurePlayer(player)
    return {
        StaminaCurrent = staminaCurrent[player],
        StaminaMax = staminaMax[player],
        IsSprinting = isSprinting[player],
    }
end

function SprintService.RemovePlayer(player: Player)
    staminaCurrent[player] = nil
    staminaMax[player] = nil
    isSprinting[player] = nil
end

function SprintService.Init(dependencies)
    if started then
        return
    end
    started = true
    movement = dependencies.MovementService
    local sprintEvent = getSprintEvent()
    movement.Changed:Connect(function(player: Player)
        SprintService.SetStaminaMax(player, movement.GetMaxStamina(player))
        SprintService.ApplySpeed(player)
    end)

    sprintEvent.OnServerEvent:Connect(function(player: Player, wantsToSprint: boolean)
        if type(wantsToSprint) ~= "boolean" then
            return
        end
        setSprinting(player, wantsToSprint)
    end)

    RunService.Heartbeat:Connect(function(deltaTime: number)
        for _, player in Players:GetPlayers() do
            ensurePlayer(player)

            local humanoid = getHumanoid(player)
            if not humanoid or humanoid.Health <= 0 then
                isSprinting[player] = false
            end
            if isSprinting[player] then
                staminaCurrent[player] =
                    math.max(0, staminaCurrent[player] - SprintConfig.STAMINA_DRAIN_RATE * deltaTime)
                if staminaCurrent[player] <= 0 then
                    isSprinting[player] = false
                end
            else
                staminaCurrent[player] =
                    math.min(staminaMax[player], staminaCurrent[player] + SprintConfig.STAMINA_REGEN_RATE * deltaTime)
            end

            -- Player attributes replicate authoritative state; SprintRequest is input only.
            player:SetAttribute("StaminaCurrent", staminaCurrent[player])

            player:SetAttribute("IsSprinting", isSprinting[player])
            SprintService.ApplySpeed(player)
        end
    end)
end

-- Extension point for future upgrades that increase a player's stamina capacity
function SprintService.SetStaminaMax(player: Player, newMax: number)
    assert(
        type(newMax) == "number" and newMax == newMax and newMax > 0 and newMax < math.huge,
        "Invalid stamina maximum"
    )
    ensurePlayer(player)
    local increase = math.max(0, newMax - staminaMax[player])
    staminaMax[player] = newMax
    staminaCurrent[player] = math.clamp(staminaCurrent[player] + increase, 0, newMax)
    player:SetAttribute("StaminaMax", staminaMax[player])
    player:SetAttribute("StaminaCurrent", staminaCurrent[player])
end

return require(script.Parent.StudioServices).Wrap("SprintService", SprintService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">StudioJumpTestService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local StudioJumpTestService = {}

local PAD_FOLDER_NAME = "StudioJumpPads"
local PAD_SIZE = Vector3.new(10, 1, 10)
local PAD_SPACING = 13
local PAD_HEIGHT_OFFSET = 0.5
local TOUCH_COOLDOWN_SEC = 0.05
local RESET_PAD_LABEL = "RESET JUMP"

local labelByTier: { [number]: string } = {
    [1] = "JUMP 1",
    [2] = "JUMP 2",
    [3] = "JUMP 3",
}

local colorByTier: { [number]: Color3 } = {
    [1] = Color3.fromRGB(120, 200, 120),
    [2] = Color3.fromRGB(110, 170, 245),
    [3] = Color3.fromRGB(255, 170, 90),
}

local movement: any
local lastTouchTimeByPlayer: { [Player]: number } = {}

local function applyTierToPlayer(player: Player, tier: number)
    movement.SetStudioJumpTier(player, tier)
end
local function resetJumpForPlayer(player: Player)
    movement.SetStudioJumpTier(player, nil)
end

local function getPadAnchorPosition(): Vector3
    local spawn = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    if spawn and spawn:IsA("BasePart") then
        return spawn.Position + Vector3.new(0, PAD_HEIGHT_OFFSET, -26)
    end
    return Vector3.new(0, 6, 0)
end

local function ensureLabel(part: BasePart, text: string)
    local existingSurface = part:FindFirstChild("Label")
    local surface: SurfaceGui
    if existingSurface and existingSurface:IsA("SurfaceGui") then
        surface = existingSurface
    else
        surface = Instance.new("SurfaceGui")
        surface.Name = "Label"
        surface.Face = Enum.NormalId.Top
        surface.AlwaysOnTop = true
        surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surface.PixelsPerStud = 50
        surface.Parent = part
    end

    local existingText = surface:FindFirstChild("Text")
    local textLabel: TextLabel
    if existingText and existingText:IsA("TextLabel") then
        textLabel = existingText
    else
        textLabel = Instance.new("TextLabel")
        textLabel.Name = "Text"
        textLabel.BackgroundTransparency = 1
        textLabel.Size = UDim2.fromScale(1, 1)
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextScaled = true
        textLabel.TextColor3 = Color3.new(1, 1, 1)
        textLabel.TextStrokeTransparency = 0.35
        textLabel.Parent = surface
    end

    textLabel.Text = text
end

local function ensurePad(folder: Folder, tier: number, position: Vector3): BasePart
    local partName = labelByTier[tier]
    local existing = folder:FindFirstChild(partName)
    local pad: BasePart

    if existing and existing:IsA("BasePart") then
        pad = existing
    else
        pad = Instance.new("Part")
        pad.Name = partName
        pad.Parent = folder
    end

    pad.Anchored = true
    pad.CanCollide = true
    pad.Material = Enum.Material.Neon
    pad.Color = colorByTier[tier]
    pad.Size = PAD_SIZE
    pad.Position = position
    pad.TopSurface = Enum.SurfaceType.Smooth
    pad.BottomSurface = Enum.SurfaceType.Smooth

    ensureLabel(pad, partName)

    pad.Touched:Connect(function(hit: BasePart)
        local character = hit.Parent
        if not character then
            return
        end

        local player = Players:GetPlayerFromCharacter(character)
        if not player then
            return
        end

        local now = os.clock()
        local last = lastTouchTimeByPlayer[player]
        if last and (now - last) < TOUCH_COOLDOWN_SEC then
            return
        end
        lastTouchTimeByPlayer[player] = now

        applyTierToPlayer(player, tier)
    end)

    return pad
end

function StudioJumpTestService.Init(dependencies)
    if not (RunService:IsServer() and RunService:IsStudio()) then
        return
    end

    movement = dependencies.MovementService
    local folder = Workspace:FindFirstChild(PAD_FOLDER_NAME)
    if not folder or not folder:IsA("Folder") then
        folder = Instance.new("Folder")
        folder.Name = PAD_FOLDER_NAME
        folder.Parent = Workspace
    end

    local anchor = getPadAnchorPosition()
    for tier = 1, 3 do
        local position = anchor + Vector3.new((tier - 2) * PAD_SPACING, 0, 0)
        ensurePad(folder, tier, position)
    end
    local resetPosition = anchor + Vector3.new(2 * PAD_SPACING, 0, 0)
    local resetPad = folder:FindFirstChild(RESET_PAD_LABEL)
    if not resetPad or not resetPad:IsA("BasePart") then
        resetPad = Instance.new("Part")
        resetPad.Name = RESET_PAD_LABEL
        resetPad.Parent = folder
    end
    resetPad.Anchored = true
    resetPad.CanCollide = true
    resetPad.Material = Enum.Material.Neon
    resetPad.Color = Color3.fromRGB(235, 95, 95)
    resetPad.Size = PAD_SIZE
    resetPad.Position = resetPosition
    resetPad.TopSurface = Enum.SurfaceType.Smooth
    resetPad.BottomSurface = Enum.SurfaceType.Smooth
    ensureLabel(resetPad, RESET_PAD_LABEL)
    resetPad.Touched:Connect(function(hit: BasePart)
        local character = hit.Parent
        if not character then
            return
        end

        local player = Players:GetPlayerFromCharacter(character)
        if not player then
            return
        end

        local now = os.clock()
        local last = lastTouchTimeByPlayer[player]
        if last and (now - last) < TOUCH_COOLDOWN_SEC then
            return
        end
        lastTouchTimeByPlayer[player] = now

        resetJumpForPlayer(player)
    end)

    Players.PlayerRemoving:Connect(function(player: Player)
        lastTouchTimeByPlayer[player] = nil
    end)
end

return StudioJumpTestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">StudioServices</string>
            <string name="Source"><![CDATA[--!strict
-- No service requires here. Bootstrap owns initialization and publishes its live instances.
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local StudioServices = {}
local isRuntime = false
local bridgeName = "StudioServiceCalls"

local function assertStudioServer()
    assert(
        RunService:IsStudio() and RunService:IsServer() and RunService:IsRunning(),
        "[StudioServices] Use the Server Command Bar in Play mode"
    )
end

function StudioServices.BeginBootstrap()
    if RunService:IsStudio() then
        assertStudioServer()
        isRuntime = true
    end
end

function StudioServices.Publish(services: { [string]: any })
    if not RunService:IsStudio() then
        return
    end
    assertStudioServer()
    assert(isRuntime, "[StudioServices] Only server bootstrap can publish services")
    assert(not ServerStorage:FindFirstChild(bridgeName), "[StudioServices] Runtime already published")
    local bridge = Instance.new("BindableFunction")
    bridge.Name = bridgeName
    bridge.OnInvoke = function(serviceName: string, methodName: string, ...: any)
        assertStudioServer()
        assert(methodName ~= "Init", "[StudioServices] Service initialization belongs to bootstrap")
        local service = services[serviceName]
        local method = service and service[methodName]
        assert(type(method) == "function", "[StudioServices] Unknown service method")
        return method(...)
    end
    -- Parent only after the callback is ready; tooling never waits on an unbound callback.
    bridge.Parent = ServerStorage
end

function StudioServices.Wrap(name: string, service: any): any
    if not RunService:IsStudio() or isRuntime then
        return service
    end
    local proxy = {}
    for methodName, method in service do
        if type(method) == "function" then
            proxy[methodName] = function(...: any)
                assertStudioServer()
                assert(methodName ~= "Init", "[StudioServices] Service initialization belongs to bootstrap")
                local bridge = ServerStorage:FindFirstChild(bridgeName)
                assert(
                    bridge and bridge:IsA("BindableFunction"),
                    "[StudioServices] Runtime unavailable; wait for the server initialized message"
                )
                return bridge:Invoke(name, methodName, ...)
            end
        end
    end
    return proxy
end

return StudioServices
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">TycoonService</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local WorldUtil = require(script.Parent.WorldUtil)
local TycoonService = {}
local data: any
local plots: { [Player]: Instance } = {}

function TycoonService.Init(playerDataService)
    data = playerDataService
end
function TycoonService.GetPlot(player: Player): Instance?
    local plot = plots[player]
    if plot and plot:IsDescendantOf(workspace) then
        return plot
    end
    return nil
end
function TycoonService.GetOwner(object: Instance): Player?
    for player, plot in plots do
        if plot:IsDescendantOf(workspace) and (object == plot or object:IsDescendantOf(plot)) then
            return player
        end
    end
    return nil
end
function TycoonService.GetFixtures(plot: Instance, role: string): { Instance }
    local fixtures = {}
    for _, object in CollectionService:GetTagged(role) do
        if object:IsDescendantOf(plot) then
            table.insert(fixtures, object)
        end
    end
    return fixtures
end

-- Compatibility runs before binding. An explicitly tagged role always wins over old names.
function TycoonService.AutoTagLegacyPlot(plot: Instance)
    CollectionService:AddTag(plot, "PlayerPlot")
    for _, role in
        {
            "BlenderInput",
            "IngredientSpawn",
            "DispenseButton",
            "CustomerSpawn",
            "CustomerCounter",
            "CustomerExit",
            "StartDayButton",
            "PlayerStash",
            "TurbineWheel",
        }
    do
        if #TycoonService.GetFixtures(plot, role) == 0 then
            local object = plot:FindFirstChild(role, true)
            if not object and role == "TurbineWheel" then
                local turbine = plot:FindFirstChild("Turbine", true)
                object = turbine
                    and (
                        turbine:FindFirstChild("blade", true)
                        or turbine:FindFirstChild("stem", true)
                        or WorldUtil.Part(turbine)
                    )
            end
            if object then
                CollectionService:AddTag(object, role)
            end
        end
    end
end

local customerRoles = { CustomerSpawn = true, CustomerCounter = true, CustomerExit = true }

-- Customer destinations must be explicit markers, never an arbitrary part of a tagged area.
-- Prefer tagged parts over legacy tagged containers so tagging the actual marker repairs
-- an old area-level tag without making the reference ambiguous.
local function customerReference(fixtures: { Instance }, name: string): (BasePart?, string?)
    local markers: { BasePart } = {}
    for _, fixture in fixtures do
        if fixture:IsA("BasePart") then
            table.insert(markers, fixture)
        end
    end
    if #markers == 0 then
        for _, fixture in fixtures do
            local parts: { BasePart } = {}
            local named: { BasePart } = {}
            for _, child in fixture:GetDescendants() do
                if child:IsA("BasePart") then
                    table.insert(parts, child)
                    if child.Name == name then
                        table.insert(named, child)
                    end
                end
            end
            local marker = if #named == 1 then named[1] elseif #parts == 1 then parts[1] else nil
            if not marker then
                return nil,
                    "Tag the " .. name .. " marker BasePart itself; ambiguous/empty container " .. fixture:GetFullName()
            end
            if not table.find(markers, marker) then
                table.insert(markers, marker)
            end
        end
    end
    if #markers ~= 1 then
        local paths = {}
        for _, fixture in fixtures do
            table.insert(paths, fixture:GetFullName())
        end
        return nil,
            string.format(
                "%s: expected one marker, found %d; tagged objects=[%s]",
                name,
                #markers,
                table.concat(paths, ", ")
            )
    end
    local marker = markers[1]
    if
        CollectionService:HasTag(marker, "StartDayButton")
        or marker.Name == "StartDayButton"
        or marker:FindFirstChild("StartDayPrompt")
    then
        return nil,
            name .. " resolves to Start Day button " .. marker:GetFullName() .. "; tag a separate customer marker"
    end
    return marker
end

function TycoonService.GetReference(player: Player, name: string): (BasePart?, string?)
    local plot = TycoonService.GetPlot(player)
    if not plot then
        return nil, "No assigned plot"
    end
    local fixtures = TycoonService.GetFixtures(plot, name)
    if (customerRoles :: any)[name] then
        return customerReference(fixtures, name)
    end
    if #fixtures ~= 1 then
        return nil
    end
    local fixture = fixtures[1]
    if name == "BlenderInput" and not fixture:IsA("BasePart") then
        return nil
    end
    local part = WorldUtil.Part(fixture)
    if part and (part == fixture or part:IsDescendantOf(fixture)) then
        return part
    end
    return nil
end
function TycoonService.AssignPlot(player: Player): Instance?
    if TycoonService.GetPlot(player) then
        return plots[player]
    end
    local candidates = CollectionService:GetTagged("PlayerPlot")
    local folder = workspace:FindFirstChild("Plots")
    if folder then
        for _, plot in folder:GetChildren() do
            if not table.find(candidates, plot) then
                TycoonService.AutoTagLegacyPlot(plot)
                table.insert(candidates, plot)
            end
        end
    end
    table.sort(candidates, function(a, b)
        return a.Name < b.Name
    end)
    for _, plot in candidates do
        if plot:IsDescendantOf(workspace) and not TycoonService.GetOwner(plot) then
            plots[player] = plot
            plot:SetAttribute("OwnerUserId", player.UserId)
            return plot
        end
    end
    warn("[TycoonService] No free PlayerPlot / workspace.Plots child for " .. player.Name)
    return nil
end
function TycoonService.RemovePlayer(player: Player)
    local plot = plots[player]
    if plot then
        plot:SetAttribute("OwnerUserId", nil)
    end
    plots[player] = nil
end
-- Compatibility with existing server callers; PlayerDataService now owns cash.
function TycoonService.GetCash(player: Player): number
    return data.GetCash(player)
end
function TycoonService.AddCash(player: Player, amount: number): number
    return data.AddCash(player, amount)
end
function TycoonService.SetCash(player: Player, amount: number): number
    return data.SetCash(player, amount)
end
return require(script.Parent.StudioServices).Wrap("TycoonService", TycoonService)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">WorldUtil</string>
            <string name="Source"><![CDATA[--!strict
local CollectionService = game:GetService("CollectionService")
local WorldUtil = {}

function WorldUtil.Part(instance: Instance?): BasePart?
    if not instance then
        return nil
    end
    if instance:IsA("BasePart") then
        return instance
    end
    if instance:IsA("Model") and instance.PrimaryPart then
        return instance.PrimaryPart
    end
    return instance:FindFirstChildWhichIsA("BasePart", true)
end

function WorldUtil.Near(player: Player, target: Instance?, distance: number): boolean
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    local part = WorldUtil.Part(target)
    return root ~= nil
        and root:IsA("BasePart")
        and humanoid ~= nil
        and humanoid.Health > 0
        and part ~= nil
        and part:IsDescendantOf(workspace)
        and (root.Position - part.Position).Magnitude <= distance
end

function WorldUtil.Prompt(part: BasePart, name: string, text: string): ProximityPrompt
    local old = part:FindFirstChild(name)
    if old then
        old:Destroy()
    end
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = name
    prompt.ActionText = text
    prompt.MaxActivationDistance = 10
    prompt.RequiresLineOfSight = false
    prompt.Parent = part
    return prompt
end

function WorldUtil.BindTag(tag: string, attach: (Instance) -> (() -> ())?)
    local cleanups: { [Instance]: () -> () } = {}
    local watches: { [Instance]: RBXScriptConnection } = {}
    local function detach(object: Instance)
        local cleanup = cleanups[object]
        cleanups[object] = nil
        if cleanup then
            cleanup()
        end
    end
    local function update(object: Instance)
        if not object:IsDescendantOf(workspace) then
            detach(object)
            return
        end
        if not cleanups[object] then
            local cleanup = attach(object)
            if cleanup then
                cleanups[object] = cleanup
            end
        end
    end
    local function add(object: Instance)
        if watches[object] then
            return
        end
        watches[object] = object.AncestryChanged:Connect(function()
            update(object)
        end)
        update(object)
    end
    local function remove(object: Instance)
        if watches[object] then
            watches[object]:Disconnect()
            watches[object] = nil
        end
        detach(object)
    end
    for _, object in CollectionService:GetTagged(tag) do
        add(object)
    end
    CollectionService:GetInstanceAddedSignal(tag):Connect(add)
    CollectionService:GetInstanceRemovedSignal(tag):Connect(remove)
    if #CollectionService:GetTagged(tag) == 0 then
        warn("[MVP] No " .. tag .. " objects; add them in Studio when ready.")
    end
end

return WorldUtil
]]></string>
          </Properties>
        </Item>
      </Item>
