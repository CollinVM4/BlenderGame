				<ProtectedString name="Source"><![CDATA[-- Framewisp: menu + tab behavior from your Figma tags (_open/_close/_toggle/_tab).
-- Driven by the FigmaAction attributes on the buttons themselves.
-- Safe to delete: the UI stays, only these interactions stop.
local TweenService = game:GetService("TweenService")
local gui = script.Parent
-- BEGIN BLENDER MAIN MENUS
local blenderMenus = (function()
--!strict
-- Embedded in FramewispActions by tools/prepare_framewisp_ui.py. Main menus
-- use that script's existing wiring path, so no second visibility owner runs.
local Menus = {}
local names: { [string]: boolean } = { Settings = true, Upgrades = true, Shop = true, Index = true }

local function contentOf(instance: Instance): Instance?
    local ancestor: Instance? = instance
    while ancestor do
        if ancestor.Name == "Be a Blender! Desktop" then
            return ancestor:FindFirstChild("Be a Blender! DesktopContent") or ancestor
        end
        ancestor = ancestor.Parent
    end
    return nil
end

local function panelId(instance: Instance): string?
    if not instance:IsA("Frame") then
        return nil
    end
    local id = instance.Name:gsub("_panel$", "")
    if names[id] and instance.Parent == contentOf(instance) then
        return id
    end
    return nil
end

function Menus.Attach(gui: Instance, player: Player)
    local initialized: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
    local wired: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any
    local connections: { RBXScriptConnection } = {}
    local buttons: { [Instance]: RBXScriptConnection } = {}

    local function initialize(instance: Instance)
        if panelId(instance) and not initialized[instance] then
            initialized[instance] = true
            (instance :: Frame).Visible = false
        end
    end
    local function closeAll(content: Instance, selected: Frame?)
        for _, child in content:GetChildren() do
            if panelId(child) then
                (child :: Frame).Visible = child == selected
            end
        end
    end
    local function wire(button: Instance): boolean
        if not button:IsA("GuiButton") then
            return false
        end
        local content = contentOf(button)
        if not content then
            return false
        end
        local close: Frame? = nil
        local ancestor = button.Parent
        while ancestor and ancestor ~= content do
            if panelId(ancestor) then
                close = ancestor :: Frame
                break
            end
            ancestor = ancestor.Parent
        end
        local action = button:GetAttribute("FigmaAction")
        local param = button:GetAttribute("FigmaActionParam")
        local id = if type(param) == "string" then param:gsub("_panel$", "") else button.Name:match("^(%w+)")
        local isClose = close ~= nil and (action == "close" or button.Name:match("^Close") ~= nil)
        local isMenu = close == nil and id ~= nil and names[id] == true
        if not isClose and not isMenu then
            return false
        end
        if wired[button] then
            return true
        end
        wired[button] = true
        buttons[button] = button.Activated:Connect(function()
            if not button:IsDescendantOf(gui) then
                return
            end
            if isClose and close then
                close.Visible = false
                return
            end
            local selected: Frame? = nil
            for _, child in content:GetChildren() do
                if panelId(child) == id then
                    if selected then
                        return -- Do not guess between duplicate imported panels.
                    end
                    selected = child :: Frame
                end
            end
            if selected then
                closeAll(content, if selected.Visible then nil else selected)
            end
        end)
        return true
    end
    local function added(instance: Instance)
        initialize(instance)
        wire(instance)
        -- Also handles a complete subtree inserted in one operation.
        for _, descendant in instance:GetDescendants() do
            initialize(descendant)
            wire(descendant)
        end
    end
    table.insert(connections, gui.DescendantAdded:Connect(added))
    table.insert(
        connections,
        gui.DescendantRemoving:Connect(function(instance)
            for button, connection in buttons do
                if button == instance or button:IsDescendantOf(instance) then
                    connection:Disconnect()
                    buttons[button] = nil
                    wired[button] = nil
                end
            end
        end)
    )
    for _, descendant in gui:GetDescendants() do
        initialize(descendant)
    end
    table.insert(
        connections,
        player.CharacterAdded:Connect(function()
            for _, descendant in gui:GetDescendants() do
                if panelId(descendant) then
                    (descendant :: Frame).Visible = false
                end
            end
        end)
    )
    table.insert(
        connections,
        gui.Destroying:Connect(function()
            for _, connection in buttons do
                connection:Disconnect()
            end
            table.clear(buttons)
            for _, connection in connections do
                connection:Disconnect()
            end
            table.clear(connections)
        end)
    )
    return { Wire = wire }
end

return Menus

end)().Attach(gui, game:GetService("Players").LocalPlayer)
-- END BLENDER MAIN MENUS
local function fwRoots()
	local list = { gui }
	for _, v in ipairs(gui:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "FW_ExtraRoot" and v.Value then
			list[#list + 1] = v.Value
		end
	end
	return list
end
local function fwAll()
	local out = {}
	for _, r in ipairs(fwRoots()) do
		for _, d in ipairs(r:GetDescendants()) do out[#out + 1] = d end
	end
	return out
end
local function fwScaleHost(el) -- Roblox honours ONE UIScale per object
	local sc = el:FindFirstChild("FW_Scale")
	if not sc then
		sc = el:FindFirstChildWhichIsA("UIScale")
		if sc then
			sc.Name = "FW_Scale"
		else
			sc = Instance.new("UIScale")
			sc.Name = "FW_Scale"
			sc:SetAttribute("FW_Owned", true)
			sc.Parent = el
		end
	end
	return sc
end
local function fwScaleApply(host)
	local total = 1
	for _, ch in ipairs(host:GetChildren()) do
		if ch:IsA("NumberValue") then total = total * ch.Value end
	end
	host.Scale = total
end
local function fwChannel(el, key) -- every runtime writes its OWN channel; the product applies once
	local host = fwScaleHost(el)
	local ch = host:FindFirstChild(key)
	if not ch then
		ch = Instance.new("NumberValue")
		ch.Name = key
		ch.Value = 1
		ch:SetAttribute("FW_Owned", true)
		ch.Parent = host
		ch.Changed:Connect(function() fwScaleApply(host) end)
	end
	return ch
end
local function fwRotSet(el, key, deg) -- Rotation is shared by three runtimes too
	local base = el:GetAttribute("FW_RotBase")
	if base == nil then
		base = el.Rotation
		el:SetAttribute("FW_RotBase", base)
	end
	el:SetAttribute(key, deg)
	local total = 0
	for _, k in ipairs({ "r_juice", "r_spin", "r_tl", "r_hover" }) do
		local v = el:GetAttribute(k)
		if type(v) == "number" then total = total + v end
	end
	el.Rotation = base + total
end
local function findRoot()
	local fallback = nil
	for _, child in ipairs(gui:GetChildren()) do
		if child:IsA("BillboardGui") then -- _billboard: the design lives one level deeper
			local inner = child:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("ObjectValue") and child.Name == "FW_ExtraRoot" and child.Value then
			local inner = child.Value:FindFirstChildWhichIsA("GuiObject")
			if inner then return inner end
		end
		if child:IsA("GuiObject") then
			fallback = fallback or child
			if child:GetAttribute("FW_Owned") == true then return child end
		end
	end
	return fallback
end
local root = findRoot()
if not root then return end

local function panelFor(btn)
	local n = btn.Parent
	while n and n ~= gui do
		if n:GetAttribute("FigmaAction") == "panel" then return n end
		n = n.Parent
	end
	return root
end

local function findPanel(name, btn)
	if not name then return nil end
	local want = name:lower()
	local fallback = nil
	for _, d in ipairs(fwAll()) do
		if d:IsA("GuiObject") and d.Name:lower() == want then
			if d:GetAttribute("FigmaAction") == "panel" then return d end
			if not fallback and btn then
				local bad = (d == btn)
				if not bad then -- would this candidate contain the button?
					local n = btn.Parent
					while n and n ~= gui do
						if n == d then bad = true break end
						n = n.Parent
					end
				end
				if not bad then fallback = d end
			elseif not fallback then
				fallback = d
			end
		end
	end
	return fallback
end

local function centrePanel(p)
	if p.AnchorPoint == Vector2.new(0.5, 0.5) then return end
	if p.Parent then
		for _, ch in ipairs(p.Parent:GetChildren()) do
			if ch:IsA("UIListLayout") or ch:IsA("UIGridLayout") or ch:IsA("UITableLayout") or ch:IsA("UIPageLayout") then
				return
			end
		end
	end
	local ap, pos, sz = p.AnchorPoint, p.Position, p.Size
	p.Position = UDim2.new(
		pos.X.Scale + (0.5 - ap.X) * sz.X.Scale,
		pos.X.Offset + (0.5 - ap.X) * sz.X.Offset,
		pos.Y.Scale + (0.5 - ap.Y) * sz.Y.Scale,
		pos.Y.Offset + (0.5 - ap.Y) * sz.Y.Offset
	)
	p.AnchorPoint = Vector2.new(0.5, 0.5)
end

local function scaleOf(p)
	if not p:FindFirstChild("FW_Scale") then centrePanel(p) end
	return fwChannel(p, "k_act") -- the panel shares one UIScale with juice, via channels
end

local TIN_SHOW = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TIN_HIDE = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local hiding = {}
local function showPanel(p)
	local tw = hiding[p]
	if tw then
		hiding[p] = nil
		tw:Cancel()
	elseif p.Visible then
		return
	end
	local s = scaleOf(p)
	if not p.Visible then s.Value = 0 end
	p.Visible = true
	TweenService:Create(s, TIN_SHOW, { Value = 1 }):Play()
end
local function hidePanel(p)
	if not p.Visible or hiding[p] then return end
	local s = scaleOf(p)
	local tw = TweenService:Create(s, TIN_HIDE, { Value = 0 })
	hiding[p] = tw
	tw.Completed:Once(function()
		if hiding[p] ~= tw then return end
		hiding[p] = nil
		p.Visible = false
		s.Value = 1
	end)
	tw:Play()
end

local function tabGroupRoot(btn)
	local n = btn.Parent
	while n and n ~= gui do
		if n:GetAttribute("FigmaAction") == "tabgroup" then return n end
		n = n.Parent
	end
	return findRoot() or gui -- the ScreenGui holds nothing on a billboard import
end

local function setActive(tabBtn, on)
	for _, c in ipairs(tabBtn:GetDescendants()) do
		if c:GetAttribute("FigmaState") == "active" then c.Visible = on end
	end
end

local function selectTab(btn, animate)
	local groot = tabGroupRoot(btn)
	for _, other in ipairs(groot:GetDescendants()) do
		if other:GetAttribute("FigmaAction") == "tab" and tabGroupRoot(other) == groot then
			local ot = findPanel(other:GetAttribute("FigmaActionParam"), other)
			if ot then
				if other == btn then
					if animate then showPanel(ot) else ot.Visible = true end
				else
					if animate then hidePanel(ot) else ot.Visible = false end
				end
			end
			setActive(other, other == btn)
		end
	end
end

local wired = setmetatable({}, { __mode = "k" })
local function wire(btn)
	if blenderMenus.Wire(btn) then return end
	if wired[btn] then return end
	local action = btn:GetAttribute("FigmaAction")
	if not action or action == "panel" or action == "tabgroup" then return end
	if not (btn:IsA("TextButton") or btn:IsA("ImageButton")) then return end
	wired[btn] = true
	local param = btn:GetAttribute("FigmaActionParam")
	btn.Activated:Connect(function()
		if action == "close" then
			hidePanel((param and findPanel(param, btn)) or panelFor(btn))
		elseif action == "open" then
			local p = findPanel(param, btn)
			if p then showPanel(p) end
		elseif action == "toggle" then
			local p = findPanel(param, btn)
			if p then
				if p.Visible and not hiding[p] then hidePanel(p) else showPanel(p) end
			end
		elseif action == "tab" then
			selectTab(btn, true)
		end
	end)
end
for _, d in ipairs(fwAll()) do wire(d) end
for _, r in ipairs(fwRoots()) do r.DescendantAdded:Connect(wire) end

local seenGroup = {}
for _, d in ipairs(fwAll()) do
	if d:GetAttribute("FigmaAction") == "tab" then
		local g = tabGroupRoot(d)
		if not seenGroup[g] then
			seenGroup[g] = true
			selectTab(d, false)
		end
	end
end
